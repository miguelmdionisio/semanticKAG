@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.eionet.europa.eu/gemet/concept/10008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "Economic good that directly satisfies human wants or desires."@en ;
    skos:prefLabel "consumer product"@en .

<http://www.eionet.europa.eu/gemet/concept/1001> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A structure that spans and provides a passage over a road, railway, river, or some other obstacle."@en ;
    skos:prefLabel "bridge"@en .

<http://www.eionet.europa.eu/gemet/concept/10017> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2564> ;
    skos:definition "Noise consequences on human health consist in loss of hearing and psychological effects."@en ;
    skos:prefLabel "health effect of noise"@en .

<http://www.eionet.europa.eu/gemet/concept/10018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The entire physical structure of an human being."@en ;
    skos:prefLabel "human body"@en .

<http://www.eionet.europa.eu/gemet/concept/10024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/23> ;
    skos:definition "The communication or conveyance of data or materials for the purpose of enhancing knowledge from one person, place or position to another."@en ;
    skos:prefLabel "information transfer"@en .

<http://www.eionet.europa.eu/gemet/concept/10031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Study of meteorological elements such as wind speed and direction, air temperature and humidity, atmospheric pressure, precipitation, evaporation, solar radiation, visibility and cloud cover in order to collect data for weather forecast or for specific research purposes."@en ;
    skos:prefLabel "meteorological research"@en .

<http://www.eionet.europa.eu/gemet/concept/10034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11661> ;
    skos:definition "Precautionary measures, actions or installations implemented to avert the probability of harm to humans, property or natural resources posed by conditions or events in the environment neither initiated nor formed by human activity."@en ;
    skos:prefLabel "natural risks prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/10039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "A science dealing with the effects of physical phenomena on chemical properties."@en ;
    skos:prefLabel "physical chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/10040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119>,
        <http://www.eionet.europa.eu/gemet/concept/6467> ;
    skos:definition "The quantitative determination of the presence, extent or type of pollutant substances in the environment using mechanical means, including optical, electrical, acoustical and thermodynamic techniques."@en ;
    skos:prefLabel "physical measurement of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/10044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:prefLabel "plant production"@en .

<http://www.eionet.europa.eu/gemet/concept/10055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The study of the behavior of foundations and structures relative to seismic ground motion, and the attempt to mitigate the effect of earthquakes on structures."@en ;
    skos:prefLabel "seismic engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/10066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8797> ;
    skos:definition "That part of a town or city in which the principal public and historic buildings are located."@en ;
    skos:prefLabel "historic centre"@en .

<http://www.eionet.europa.eu/gemet/concept/10067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8571> ;
    skos:definition "Any activity that encourages or supports the buying, selling or exchanging of goods or services with other countries, which could include marketing, diplomatic pressure or the provision of export incentives such as credits and guarantees, government subsidies, training and consultation or advice."@en ;
    skos:prefLabel "promotion of trade and industry"@en .

<http://www.eionet.europa.eu/gemet/concept/10068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1033> ;
    skos:definition "A construction of stone or similar materials such as concrete or brick."@en ;
    skos:prefLabel "masonry"@en .

<http://www.eionet.europa.eu/gemet/concept/1007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2642> ;
    skos:definition "A pungent dark red volatile liquid element of the halogen series that occurs in brine and is used in the production of chemicals."@en ;
    skos:prefLabel "bromine"@en .

<http://www.eionet.europa.eu/gemet/concept/10071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "A sandy tidal flat barren of vegetation. A tidal flat is an extensive, nearly horizontal, marshy or barren tract of land that is alternately covered and uncovered by the tide, and consisting of unconsolidated sediment (mostly mud and sand). It may form the top surface of a deltaic deposit."@en ;
    skos:prefLabel "sand flat"@en .

<http://www.eionet.europa.eu/gemet/concept/10074> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species belonging to the plant kingdom."@en ;
    skos:prefLabel "plant species"@en .

<http://www.eionet.europa.eu/gemet/concept/10078> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "The common beliefs, practices, customs and other cultural elements of an ethnic or social group that are rooted in the past, but are persisting into the present due to means such as arts and crafts, songs and music, dance, foods, drama, storytelling and certain forms of oral communication."@en ;
    skos:prefLabel "folk tradition"@en .

<http://www.eionet.europa.eu/gemet/concept/10087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:definition "The quantitative determination of the presence, extent or type of pollutant substances in the environment by studying the actions or reactions of known chemicals to those pollutants."@en ;
    skos:prefLabel "chemical measurement of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/10089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The process of cumulative reactive change following the introduction of a pollutant into the environment."@en ;
    skos:prefLabel "pollutant evolution"@en .

<http://www.eionet.europa.eu/gemet/concept/10092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise emitted from various sources in an urban environment."@en ;
    skos:prefLabel "urban noise"@en .

<http://www.eionet.europa.eu/gemet/concept/10097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4126> ;
    skos:definition "The state of being clean and keeping healthy conditions."@en ;
    skos:prefLabel "cleanliness (hygiene)"@en .

<http://www.eionet.europa.eu/gemet/concept/10102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Probability of harm to human health, property or the environment posed by any aspect of the physical world other than human activity."@en ;
    skos:prefLabel "natural risk"@en .

<http://www.eionet.europa.eu/gemet/concept/10103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "Analysis of the probability of occurrence, within a specific period of time in a given area, of a potentially damaging phenomenon of nature."@en ;
    skos:prefLabel "natural risk analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/10104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "The high probability that a given hazard or situation will yield a significant amount of lives lost, persons injured, damage to property , disruption of economic activity or harm to the environment; or any product of the probability of occurrence and the expected magnitude of damage beyond a maximum acceptable level."@en ;
    skos:prefLabel "major risk"@en .

<http://www.eionet.europa.eu/gemet/concept/10106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10054> ;
    skos:definition "Any series of procedures and devices used by trained personnel to provide immediate assistance to persons who are in danger or injured."@en ;
    skos:prefLabel "rescue system"@en .

<http://www.eionet.europa.eu/gemet/concept/10107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "The technique, practice or science of handling or controlling situations of acute difficulty, danger or instability; or the total of measures taken to provide a solution for political, economic, environmental or other similar dangers and conflicts."@en ;
    skos:prefLabel "crisis management"@en .

<http://www.eionet.europa.eu/gemet/concept/10120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:definition "A co-ordinated body of methods or plan of procedures for levying compulsory charges for the purpose of raising revenue."@en ;
    skos:prefLabel "tax system"@en .

<http://www.eionet.europa.eu/gemet/concept/10126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "The development at any level of a general notion of the surrounding ecosystem, its foundational relationship to human life and the need to preserve its integrity."@en ;
    skos:prefLabel "concept of environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The science that deals with the relationship of forest trees to their environment, to one another, and to other plants and to animals in the forest."@en ;
    skos:prefLabel "forest ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/10130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "Concept derived from biology: the city is viewed as a total environment, as a life-supporting system for the large number of people concentrated there, and within this people organize themselves and adapt to a constantly changing environment. Regarded as the same as human ecology."@en ;
    skos:prefLabel "urban ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/10131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "A broad geographic area in which there are distinctive climate patterns, ocean conditions, types of landscapes and species of plants and animals."@en ;
    skos:prefLabel "ecozone"@en .

<http://www.eionet.europa.eu/gemet/concept/10133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "Branch of engineering concerned with the environment and its proper management. The major environmental engineering disciplines regard water supply, wastewater, stormwater, solid waste, hazardous waste, noise radiology, industrial hygiene, oceanography and the like."@en ;
    skos:prefLabel "environmental engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/10135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The application of ecological concepts to fossil and sedimentary evidence to study the interactions of Earth surface, atmosphere, and biosphere in former times."@en ;
    skos:prefLabel "palaeoecology"@en .

<http://www.eionet.europa.eu/gemet/concept/10136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:definition "The inheritance and preservation of the earth's or a particular region's balanced, integrated functionality as a natural habitat, with special concern for the water resources necessary to maintain the ecosystem."@en ;
    skos:prefLabel "biological heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/1014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10548> ;
    skos:definition "To incubate eggs or cover the young for warmth."@en ;
    skos:prefLabel "brooding"@en .

<http://www.eionet.europa.eu/gemet/concept/10140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition """1) In general, a term used to describe a topographic eminence.
2) A specific altitude or height above a given level. 
3) In surveying, the term refers to the angle between the horizontal and a point at a higher level."""@en ;
    skos:prefLabel "altitude"@en .

<http://www.eionet.europa.eu/gemet/concept/10142> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:definition """1) A deep recess hollow, or nook in a cliff or steep mountainside, or a small, straight valley extending into a mountain or down a mountainside.
2) A valley or portion of lowland that penetrates into a plateau or mountain front."""@en ;
    skos:prefLabel "cove"@en .

<http://www.eionet.europa.eu/gemet/concept/10143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8887> ;
    skos:definition "A long deep, relatively narrow steep-sided valley confined between lofty and precipitous walls in a plateau or mountainous area, often with a stream at the bottom; similar to, but largest than, a gorge. It is characteristic of an arid or semiarid area (such as western U.S.) where stream downcutting greatly exceeds weathering."@en ;
    skos:prefLabel "canyon"@en .

<http://www.eionet.europa.eu/gemet/concept/10144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:definition "A cape or promontory jutting seawards from a coastline, usually with a significant sea cliff."@en ;
    skos:prefLabel "headland (geography)"@en .

<http://www.eionet.europa.eu/gemet/concept/10146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "A deep steep-walled half-bowl-like recess or hollow, variously described as horseshoe- or crescent-shaped or semi-circular in plan, situated high on the side of a mountain and commonly at the head of a glacial valley and produced by the erosive activity of a mountain glacier. It often contains a small round lake, and it may or may not be occupied by ice or snow."@en ;
    skos:prefLabel "geographic circque"@en .

<http://www.eionet.europa.eu/gemet/concept/10148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1757> ;
    skos:definition "A protuberance of the earth's crustal shell, with an area of several million square miles and sufficient elevation so that much of it above sea level."@en ;
    skos:prefLabel "continent"@en .

<http://www.eionet.europa.eu/gemet/concept/10149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/751> ;
    skos:definition "An elongated sand or shingle bank which lies parallel to the coastline and is not submerged by the tide. If it is high enough to permit dune growth it is termed a barrier island."@en ;
    skos:prefLabel "barrier beach"@en .

<http://www.eionet.europa.eu/gemet/concept/1015> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9161> ;
    skos:definition "A small stream or rivulet, commonly swiftly flowing in rugged terrain, of lesser length and volume than a creek; especially a stream that issues directly from the ground, as from a spring or seep, or that is produced by heavy rainfall or melting snow."@en ;
    skos:prefLabel "brook"@en .

<http://www.eionet.europa.eu/gemet/concept/10152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3800> ;
    skos:definition "A narrow inlet or bay, especially of the sea."@en ;
    skos:prefLabel "creek"@en .

<http://www.eionet.europa.eu/gemet/concept/10154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2400> ;
    skos:definition "A fracture or a zone of fractures along which there has been displacement of the sides relative to one another parallel to the fracture."@en ;
    skos:prefLabel "fault"@en .

<http://www.eionet.europa.eu/gemet/concept/10155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:definition "A steep coastal declivity which may or may not be precipitous, the slope angle being dependent partly on the jointing, bedding and hardness of the materials from which the cliff has been formed, and partly on the erosional processes at work. Where wave attack is dominant the cliff-foot will be rapidly eroded and cliff retreat will take place, especially in unconsolidated materials such as clays, sands, etc., frequently leaving behind an abrasion platform at the foot of the cliff."@en ;
    skos:prefLabel "cliff"@en .

<http://www.eionet.europa.eu/gemet/concept/10158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7495> ;
    skos:definition "The high seas lying outside the exclusive economic zones of states. All states have equal rights to navigate, to overfly, to lay submarine cables, to construct artificial islands, to fish, and to conduct scientific research within the high seas."@en ;
    skos:prefLabel "open sea"@en .

<http://www.eionet.europa.eu/gemet/concept/10160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4589> ;
    skos:definition "A coastal stretch of shallow saltwater virtually cut off from the open sea by a coral reef."@en ;
    skos:prefLabel "coral reef lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/10161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "The channel containing or formerly containing the water of a river."@en ;
    skos:prefLabel "river bed"@en .

<http://www.eionet.europa.eu/gemet/concept/10170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6276> ;
    skos:definition "A level or gently sloping tract or a slightly undulating land surface produced by extensive deposition of alluvium, usually adjacent to a river that periodically overflows its banks; it may be situated on a flood plain, a delta, or an alluvial fan."@en ;
    skos:prefLabel "alluvial plain"@en .

<http://www.eionet.europa.eu/gemet/concept/10175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7034> ;
    skos:definition "An elongated accumulation of coral lying at low-tide level parallel to the coast but separated from it by a wide and deep lagoon or strait. The coral is thought to have formed initially on a flat surface: then as the sea-level rose in post-glacial times, thereby submerging the irregular wave-cut platform, the coral growth kept pace with the rising ocean level, so creating the great thickness witnessed today in such places as the Great Barrier Reef off the East coast of Queensland, Australia. This stretches for more than 1900 km and varies in width from about 30 km to 150 km."@en ;
    skos:prefLabel "barrier reef"@en .

<http://www.eionet.europa.eu/gemet/concept/10176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:definition "The physical shape, configuration or general unevenness of a part of the Earth's surface, considered with reference to variation of height and slope or to irregularities of the land surface; the elevation or difference in elevation, considered collectively, of a land surface."@en ;
    skos:prefLabel "relief (land)"@en .

<http://www.eionet.europa.eu/gemet/concept/10189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "An ordinance or decree regarding an area of ecological habitat that is characterized by a high degree of uniformity in its environmental conditions and in its distribution of plants and animals."@en ;
    skos:prefLabel "biotope order"@en .

<http://www.eionet.europa.eu/gemet/concept/10190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7603> ;
    skos:definition "Terrestrial or aquatic area or other fragile natural setting with unique or highly-valued environmental features."@en ;
    skos:prefLabel "sensitive natural area"@en .

<http://www.eionet.europa.eu/gemet/concept/10191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:prefLabel "environmental analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/10193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10166> ;
    skos:definition "The non-living components of the environment (rocks, minerals, soil, water and climate)."@en ;
    skos:prefLabel "abiotic environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "Waters, including wetlands, that serve as habitat for interrelated and interacting communities and populations of plants and animals."@en ;
    skos:prefLabel "aquatic environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Any parcel of land, large or small, under public or private control, that already has, or with remedial action could achieve, desirable environmental attributes. These attributes contribute to the retention and/or creation of wildlife habitat, soils stability, water retention or recharge, vegetative cover, and similar vital ecological functions. Environmentally sensitive areas range in size from small patches to extensive landscape features. They can include rare or common habitats, plants and animals."@en ;
    skos:prefLabel "sensitive environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "The continental as distinct from the marine and atmospheric environments. It is the environment in which terrestrial organisms live."@en ;
    skos:prefLabel "terrestrial environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10212> ;
    skos:definition "A permanent reservation on the seabed for the conservation of species."@en ;
    skos:prefLabel "marine park"@en .

<http://www.eionet.europa.eu/gemet/concept/10200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:definition "A park operated and managed by a region."@en ;
    skos:prefLabel "regional natural park"@en .

<http://www.eionet.europa.eu/gemet/concept/10202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7137> ;
    skos:definition "An area of land and/or of water designated as having protected status for purposes of preserving certain biological features. Reserves are managed primarily to safeguard these features and provide opportunities for research into the problems underlying the management of natural sites and of vegetation and animal populations. Regulations are normally imposed controlling public access and disturbance."@en ;
    skos:prefLabel "state biological reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3435> ;
    skos:definition "Forest areas which are protected and guarded from deforestation because of the fragility of its ecosystems, and because they provide habitats for hundreds of species of plants and animals."@en ;
    skos:prefLabel "forest biological reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5545> ;
    skos:definition "Area of national interest which is protected under the responsibility of its owner in order to safeguard wildlife, archeological and geological sites."@en ;
    skos:prefLabel "voluntary natural reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:definition "The core area of a park or of a reserve where there can be no interference with the natural ecosystem."@en ;
    skos:prefLabel "central park area"@en .

<http://www.eionet.europa.eu/gemet/concept/10214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5513> ;
    skos:definition "A zone of the park where scientific research is allowed. Beyond this there is a buffer zone which protects the whole reserve from agricultural, industrial and urban development."@en ;
    skos:prefLabel "peripheral park area"@en .

<http://www.eionet.europa.eu/gemet/concept/10215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The selection and detailed layout of public transport routes in the light of construction, operation, service, technology, and economic criteria."@en ;
    skos:prefLabel "alignment"@en .

<http://www.eionet.europa.eu/gemet/concept/10217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/204> ;
    skos:definition "The wooded countryside characteristic of northern France, with small irregular-shaped fields and many hedges and copses. In the French language the word bocage refers both to the hedge itself and to a landscape consisting of hedges. Bocage landscapes usually have a slightly rolling landform, and are found mainly in maritime climates. Being a small-scale, enclosed landscape, the bocage offers much variations in biotopes, with habitats for birds, small mammals, amphibians, reptiles and butterflies."@en ;
    skos:prefLabel "bocage"@en .

<http://www.eionet.europa.eu/gemet/concept/10225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:prefLabel "French formal garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:definition "A plot of ground consisting of an orderly and balanced arrangement of masses of flowers, shrubs and trees, following British traditions or style."@en ;
    skos:prefLabel "English garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:prefLabel "terraced garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "Landscape resulting from the method of cultivating land by cutting terraces or benches into slopes to create areas of flat land. The practice is common in mountainous areas where land is scarce and rainfall uncertain."@en ;
    skos:prefLabel "terraced landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/10236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:prefLabel "mountain protection"@en .

<http://www.eionet.europa.eu/gemet/concept/10237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the environmental integrity of a physical area or location."@en ;
    skos:prefLabel "site protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4233> ;
    skos:definition "EPA policy that allows a plant complex with several facilities to decrease pollution from some facilities while increasing it from others, so long as total results are equal to or better than previous limits. Facilities where this is done are treated as if they exist in a bubble in which total emissions are averaged out."@en ;
    skos:prefLabel "bubble policy (emissions trading)"@en .

<http://www.eionet.europa.eu/gemet/concept/10240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7091> ;
    skos:definition "The restoration of the ecological quality of an area or location."@en ;
    skos:prefLabel "site rehabilitation"@en .

<http://www.eionet.europa.eu/gemet/concept/10243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10244> ;
    skos:definition "Site which is declared protected because of its natural, landscape, artistic or archeological features in order to guarantee its conservation, maintenance and restoration."@en ;
    skos:prefLabel "classified site"@en .

<http://www.eionet.europa.eu/gemet/concept/10251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:definition "A graphic representation of a city area or other densely populated region, portraying the location of groups or select types of people in their environment through various geographic techniques."@en ;
    skos:prefLabel "urban ecology charter"@en .

<http://www.eionet.europa.eu/gemet/concept/10255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:definition "The state, character or behavior of a person viewed as a member of the ecosystem with attendant rights and responsibilities, especially the responsibility to maintain ecological integrity and the right to exist in a healthy environment."@en ;
    skos:prefLabel "environmental citizenship"@en .

<http://www.eionet.europa.eu/gemet/concept/10256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877>,
        <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "Unified, combined and coordinated management of environmental problems which correlates relevant organisations, groups, individuals and disciplines by bringing the parts together for a complete approach."@en ;
    skos:prefLabel "integrated management"@en .

<http://www.eionet.europa.eu/gemet/concept/10260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13242> ;
    skos:definition "A person, firm, organization, etc. that provides or pledges money for an undertaking or event."@en ;
    skos:prefLabel "sponsorship"@en .

<http://www.eionet.europa.eu/gemet/concept/10263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for the management of a city or town's natural or ecological resources."@en ;
    skos:prefLabel "municipal environment plan"@en .

<http://www.eionet.europa.eu/gemet/concept/10274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "An organized, systematic effort through various communications media to alert the general population of a given area to anything of significant interest or concern."@en ;
    skos:prefLabel "public awareness campaign"@en .

<http://www.eionet.europa.eu/gemet/concept/1028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "Any of the suborder Heteroctera, having piercing and sucking mouthparts, specialized as a beak."@en ;
    skos:prefLabel "bug"@en .

<http://www.eionet.europa.eu/gemet/concept/10305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3252> ;
    skos:definition "Fishes that migrate in a body, often between breeding places and winter feeding grounds."@en ;
    skos:prefLabel "migratory fish"@en .

<http://www.eionet.europa.eu/gemet/concept/1031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1041> ;
    skos:definition "Land and other places on, under, in or through which the temporary and permanent works are to be executed and any other lands or places needed for the purposes of construction."@en ;
    skos:prefLabel "building area"@en .

<http://www.eionet.europa.eu/gemet/concept/10381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "Predatory mammal, including cats, lions, leopards, tigers, jaguars, and cheetahs, typically having a round head and retractile claws."@en ;
    skos:prefLabel "felid"@en .

<http://www.eionet.europa.eu/gemet/concept/1039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "The art and technique of building houses."@en ;
    skos:prefLabel "building industry"@en .

<http://www.eionet.europa.eu/gemet/concept/10421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/503>,
        <http://www.eionet.europa.eu/gemet/concept/5043>,
        <http://www.eionet.europa.eu/gemet/concept/508> ;
    skos:definition "Mammals which have adapted to live in the sea, such as whales, dolphins, porpoises, etc."@en ;
    skos:prefLabel "marine mammal"@en .

<http://www.eionet.europa.eu/gemet/concept/10444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "Horned ruminant mammals raised in many breeds for wool, edible flesh, or skin."@en ;
    skos:prefLabel "ovine"@en .

<http://www.eionet.europa.eu/gemet/concept/1046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4635> ;
    skos:definition "The activity of designing, organizing or preparing for future construction or reconstruction of edifices and facilities."@en ;
    skos:prefLabel "building planning"@en .

<http://www.eionet.europa.eu/gemet/concept/10495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "Cover or protection, as from weather or danger; place of refuge."@en ;
    skos:prefLabel "shelter"@en .

<http://www.eionet.europa.eu/gemet/concept/10496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/544> ;
    skos:definition "A place where birds gather to lay eggs."@en ;
    skos:prefLabel "nesting area"@en .

<http://www.eionet.europa.eu/gemet/concept/105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An authoritative decree, sanction or order issued from an office with executive or managerial authority, without necessarily having the force of law or its equivalent."@en ;
    skos:prefLabel "administrative fiat"@en .

<http://www.eionet.europa.eu/gemet/concept/10510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Line corridors (roads, paths, and hedgerows) which lack interior habitat but may serve as movement groups for organisms. Corridors may also provide an efficient migratory pathway for animals. The presence or absence of breaks in a corridor may be a very important factor in determining the effectiveness of its conduit and barrier functions."@en ;
    skos:prefLabel "animal corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/10511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Harm caused to the environment by animals as, for instance, in the case of overgrazing, trampling, etc. Overgrazing damage is reduced by properly located watering facilities to decrease daily travel by livestock. Rotation of grazing areas allows time for recovery of grass. Some land can be easily restored if grazing is allowed only during one season. Animals may cause damage to crops when agriculture land borders on virgin territory or game reserves. In addition wild animals may bring disease in valuable domestic herds. Cattle overstocking has caused serious degradation of habitat, and cattle raising is thus, to some extent, counterproductive."@en ;
    skos:prefLabel "animal damage"@en .

<http://www.eionet.europa.eu/gemet/concept/10512> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "The habit of many animal species of moving inside their habitats or of travelling, during migrations, to different biotopes, often considerable distances apart; in aquatic environments displacements can occur horizontally or vertically while in terrestrial environments animal populations that breed in the alpine or subalpine zones in summer, move to lower levels in winter; animal displacements usually follow circadian rhythms and are related to the necessity of finding breeding, resting and feeding areas."@en ;
    skos:prefLabel "animal displacement"@en .

<http://www.eionet.europa.eu/gemet/concept/1052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1041> ;
    skos:definition "A piece of land on which a house or other building is being built."@en ;
    skos:prefLabel "building site"@en .

<http://www.eionet.europa.eu/gemet/concept/10521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:definition "Area of water where fish come each year to produce their eggs."@en ;
    skos:prefLabel "spawning ground"@en .

<http://www.eionet.europa.eu/gemet/concept/10523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3808> ;
    skos:definition "The locality in which an animal naturally grows or lives. It can be either the geographical area over which it extends, or the particular station in which an animal is found."@en ;
    skos:prefLabel "animal habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/10535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/415> ;
    skos:definition "The building of nests for egg laying and rearing of offspring."@en ;
    skos:prefLabel "nesting"@en .

<http://www.eionet.europa.eu/gemet/concept/10539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6519> ;
    skos:definition "A group of animals inhabiting a given area."@en ;
    skos:prefLabel "animal population"@en .

<http://www.eionet.europa.eu/gemet/concept/1054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "building site preparation"@en .

<http://www.eionet.europa.eu/gemet/concept/10554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "The act or fact of surviving or condition of having survived."@en ;
    skos:prefLabel "survival"@en .

<http://www.eionet.europa.eu/gemet/concept/10562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species native to, and restricted to, a particular geographical region."@en ;
    skos:prefLabel "endemic species"@en .

<http://www.eionet.europa.eu/gemet/concept/10568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:definition "Deciduous tree which has wide leaves, as opposed to the needles on conifers."@en ;
    skos:prefLabel "broad-leaved tree"@en .

<http://www.eionet.europa.eu/gemet/concept/10574> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6299> ;
    skos:definition "Seaweeds communities formed by green, brown and red macroscopic algae and by sea phanerogams such as Posidonia oceanica and Zostera noltii, etc."@en ;
    skos:prefLabel "sea grass bed"@en .

<http://www.eionet.europa.eu/gemet/concept/10575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "A large macroscopic plant, used especially of aquatic forms such as kelp (variety of large brown seaweed which is a source of iodine and potash)."@en ;
    skos:prefLabel "macrophyte"@en .

<http://www.eionet.europa.eu/gemet/concept/1058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1728> ;
    skos:prefLabel "building technology"@en .

<http://www.eionet.europa.eu/gemet/concept/10593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8925> ;
    skos:definition "Plants growing in areas adjacent to rivers and streams."@en ;
    skos:prefLabel "riverside vegetation"@en .

<http://www.eionet.europa.eu/gemet/concept/10605> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "Any north temperate fagaceous tree of the genus Castanea, such as Castanea sativa, which produce flowers in long catkins and nuts in a prickly bur."@en ;
    skos:prefLabel "chestnut"@en .

<http://www.eionet.europa.eu/gemet/concept/1061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Collection of open and/or closed drains, together with structures and pumps used to collect and dispose of excess surface or subsurface water."@en ;
    skos:prefLabel "built drainage system"@en .

<http://www.eionet.europa.eu/gemet/concept/10612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "A very large family of plants including cereals such as wheat, maize, etc."@en ;
    skos:prefLabel "graminaceous plant"@en .

<http://www.eionet.europa.eu/gemet/concept/10617> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "Plant with elongated, planar, green leaves which measure up to 1,5 m. The flowers come out in the autumn but not every year. The fruits are dark balls, which one often finds washed up on beaches after storms. The same happens with the leaves which wilt and separate from the plant at the end of summer. It grows on sandy substrates, and has a rhizome from which several plants grow. The compact form of its growths retains the sediments pulled by the currents along the sea bed. Neptunegrass forms extensive prairies, always on the continental shelf. The plant's presence, apart from constituting an excellent refuge and food reserve for many species, gives an indication of the maturity and good condition of the whole marine ecosystem."@en ;
    skos:prefLabel "posidonia"@en .

<http://www.eionet.europa.eu/gemet/concept/10626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8922> ;
    skos:definition "A subdivision of vegetation characteristic of a certain altitude above sea level at a given latitude."@en ;
    skos:prefLabel "vegetation level"@en .

<http://www.eionet.europa.eu/gemet/concept/10633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6519> ;
    skos:definition "The number of plants in an area."@en ;
    skos:prefLabel "plant population"@en .

<http://www.eionet.europa.eu/gemet/concept/10640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8922> ;
    skos:definition "Collection of trees from different parts of the world, grown for scientific study."@en ;
    skos:prefLabel "arboretum"@en .

<http://www.eionet.europa.eu/gemet/concept/10644> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The study of the causal relations between geographical phenomena occurring within a particular region."@en ;
    skos:prefLabel "chorology"@en .

<http://www.eionet.europa.eu/gemet/concept/10646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2282> ;
    skos:definition "Assemblage of cultivated plants that are distinguished by any characteristics (morphology, physiology, etc.) significant for purposes of horticulture, agriculture or forestry."@en ;
    skos:prefLabel "variety collection"@en .

<http://www.eionet.europa.eu/gemet/concept/10651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Areas for the conservation of rare or endangered animal species."@en ;
    skos:prefLabel "animal conservatory"@en .

<http://www.eionet.europa.eu/gemet/concept/10652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Gardens for the conservation of rare species of plants."@en ;
    skos:prefLabel "botanical conservatory"@en .

<http://www.eionet.europa.eu/gemet/concept/10666> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:definition "The sum of the earth's or a particular region's non-human, non-vegetable, multicellular organisms viewed as the inheritance of the present generation, especially animal species deemed worthy of preservation and protection from extinction."@en ;
    skos:prefLabel "animal heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/10667> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5507> ;
    skos:definition "The sum of the earth's or a particular region's herb, vegetable, shrub and tree life viewed as the inheritance of the present generation, especially plant species deemed worthy of preservation and protection from extinction."@en ;
    skos:prefLabel "plant heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/1067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "The cultivation of flower bulb is divided into two sectors: for forcing (flower bulbs used by professional growers for the production of cut flowers and potted plants) and for dry sales (flower bulbs for garden planting, flower pots, landscaping and parks)."@en ;
    skos:prefLabel "bulb cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/10671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7986> ;
    skos:definition "Attempts made to prevent the extinction of threatened species and populations by reintroducing them in their natural habitat. The reintroduction of species in a region requires a preliminary study to establish the reasons of their disappearance and the modifications that might have occurred in the biotopes."@en ;
    skos:prefLabel "animal species reintroduction"@en .

<http://www.eionet.europa.eu/gemet/concept/10672> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7986> ;
    skos:definition "Reintroducing wild plant species to their natural habitat. The reintroduction of species in a region requires a preliminary study to establish the reasons of their disappearance and the modifications that might have occurred in the biotopes."@en ;
    skos:prefLabel "plant species reintroduction"@en .

<http://www.eionet.europa.eu/gemet/concept/10683> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/167> ;
    skos:definition "The planting of trees in an area, or the management of an area to allow trees to regenerate or colonize naturally, in order to produce a forest."@en ;
    skos:prefLabel "local afforestation"@en .

<http://www.eionet.europa.eu/gemet/concept/10685> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:definition """1) Falling of old trees in a forest caused by a storm or strong wind. It plays an important role in the spontaneous regeneration of forest ecosystems.
2) A plot of land covered with trees blown down by the wind."""@en ;
    skos:prefLabel "windfall"@en .

<http://www.eionet.europa.eu/gemet/concept/10691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The cutting off or removal of dead or living parts or branches of a plant to improve shape or growth."@en ;
    skos:prefLabel "pruning"@en .

<http://www.eionet.europa.eu/gemet/concept/10692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "Forests have been exploited over the centuries as a source of wood and for obtaining land for agricultural use. The mismanagement of forest lands and forest resources has led to a situation where the forest is now in rapid retreat. The main aspects of the situation are: serious shortages in the supply of industrial wood; the catastrophic erosion and floods accompanying the stripping of forests from mountainous land; the acute shortages of fuel wood in much of the developing world; the spread of desert conditions at an alarming rate in the arid and semi-arid regions of the world; and the many environmental effects of the destruction of tropical rainforests."@en ;
    skos:prefLabel "forest exploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/10693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "An extensive area of woodland that is found at natural elevations usually higher than 2000 feet."@en ;
    skos:prefLabel "mountain forest"@en .

<http://www.eionet.europa.eu/gemet/concept/10694> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3435> ;
    skos:definition "Forest owned and managed by the State."@en ;
    skos:prefLabel "state forest"@en .

<http://www.eionet.europa.eu/gemet/concept/10695> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8361> ;
    skos:definition "Type of forest found in the Mediterranean area comprising mainly xerophilous evergreen trees."@en ;
    skos:prefLabel "Mediterranean forest"@en .

<http://www.eionet.europa.eu/gemet/concept/10696> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3435> ;
    skos:prefLabel "private forest"@en .

<http://www.eionet.europa.eu/gemet/concept/10698> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "Forest whose trees are all in the adult stage and have reached the reproductive period."@en ;
    skos:prefLabel "timber forest"@en .

<http://www.eionet.europa.eu/gemet/concept/10699> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1020> ;
    skos:definition "A low evergreen shrub formation, usually found on siliceous soils in the Mediterranean lands where winter rainfall and summer drought are the characteristic climate features. It consists of a profusion of aromatic species, such as lavender, myrtle, oleander and rosemary and often includes abundant spiny shrubs. It has been suggested that the maquis is a secondary vegetation, occupying the lands cleared of their natural evergreen oak forests by human activity."@en ;
    skos:prefLabel "maquis"@en .

<http://www.eionet.europa.eu/gemet/concept/107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4541> ;
    skos:definition "The extent, power or territory in which an office with executive or managerial authority administers justice or declares judgments."@en ;
    skos:prefLabel "administrative jurisdiction"@en .

<http://www.eionet.europa.eu/gemet/concept/10703> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13117> ;
    skos:prefLabel "dry lawn"@en .

<http://www.eionet.europa.eu/gemet/concept/10706> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "Branch of forestry concerned with the prevention and control of damage to forests arising from the action of people or livestock, of pests and abiotic agents."@en ;
    skos:prefLabel "forest protection"@en .

<http://www.eionet.europa.eu/gemet/concept/10707> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "The replacement by an organism of tissues or organs which have been lost or severely injured."@en ;
    skos:prefLabel "natural regeneration"@en .

<http://www.eionet.europa.eu/gemet/concept/10708> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:definition "Plants yielding or producing resin."@en ;
    skos:prefLabel "resinous plant"@en .

<http://www.eionet.europa.eu/gemet/concept/10711> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1793> ;
    skos:definition "A traditional system of woodland management whereby timber trees are grown above a coppiced woodland. It is used in particular as a method of exploiting oakwoods, in which all the trees except a rather open network of tall, well-formed oaks - the standards at about fifty per hectare - are felled, leaving plenty of space for hazels and other underwood to grow and be coppiced at intervals of ten to fifteen years."@en ;
    skos:prefLabel "coppice with standards"@en .

<http://www.eionet.europa.eu/gemet/concept/10721> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "An amusement or pastime; diversion."@en ;
    skos:prefLabel "game (play)"@en .

<http://www.eionet.europa.eu/gemet/concept/10726> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3553> ;
    skos:definition "Large wild animals that weigh typically more than 30 lb when fully grown, hunted for food, sport or profit."@en ;
    skos:prefLabel "big game"@en .

<http://www.eionet.europa.eu/gemet/concept/10744> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:definition "Raising of shellfish in inland waters, estuaries or coastal waters, for commercial purposes. All commercial shellfish beds producing bivalve molluscs must be monitored for microbial contamination. Samples of water and shellfish flesh must be tested for the presence of algal toxins. Periodic monitoring of fish and shellfish must be carried out to check for the presence of contaminants."@en ;
    skos:prefLabel "shellfish farming"@en .

<http://www.eionet.europa.eu/gemet/concept/1075> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The multiplication of or concentration of power in administrators and administrative offices in an organization, usually resulting in an extension into and regimentation of certain areas of social life."@en ;
    skos:prefLabel "bureaucratisation"@en .

<http://www.eionet.europa.eu/gemet/concept/10753> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5450> ;
    skos:definition "There are two types of oyster farming: suspension culture, in which oysters are grown off bottom, in floating trays, is a labor-intensive form of cultivation that requires continuous tending and cleaning of both gear and shellfish, and bottom culture, which is similar to conventional crop farming on land; it involves selecting areas of the sea floor that provide a natural food supply, necessary currents, minimum exposure to predators, and proper temperature and then \"seeding\" the bottom with shellfish stock that are left to grow to market size. Then they are harvested with a bottom drag from a boat. Both suspension culture and bottom culture depend on natural food supplies for growing the shellfish being raised."@en ;
    skos:prefLabel "oyster farming"@en .

<http://www.eionet.europa.eu/gemet/concept/10758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Such fisheries belong to one of two groups: one catching demersal (bottom-living) fish, e.g. cod, haddock, plaice, sole; the other catching pelagic (surface-living) fish, e.g. anchovy, tuna, herring."@en ;
    skos:prefLabel "commercial fishery"@en .

<http://www.eionet.europa.eu/gemet/concept/10760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3263> ;
    skos:definition "Limited portion of a water body belonging to the State where angling is allowed."@en ;
    skos:prefLabel "national fishing reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10767> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Instruction or events designed to offer learning or cultural experiences to populations without access to traditional educational institutions due to social or economic barriers."@en ;
    skos:prefLabel "socioeducational activity"@en .

<http://www.eionet.europa.eu/gemet/concept/10773> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "A test given to a candidate for a certificate or a position and concerned typically with problems to be solved, skills to be demonstrated, or tasks to be performed."@en ;
    skos:prefLabel "competitive examination"@en .

<http://www.eionet.europa.eu/gemet/concept/10778> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Various forms, methods, and processes of formal and informal education for the continued learning of all ages and categories of the general public. Oriented toward the continued learning/developmental processes of the individual throughout life."@en ;
    skos:prefLabel "continuing education"@en .

<http://www.eionet.europa.eu/gemet/concept/10780> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8607> ;
    skos:definition "Any education, instruction or discipline occurring at the beginning of an activity, task, occupation or life span."@en ;
    skos:prefLabel "initial training"@en .

<http://www.eionet.europa.eu/gemet/concept/10785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The principles, practice, or profession of teaching."@en ;
    skos:prefLabel "pedagogy"@en .

<http://www.eionet.europa.eu/gemet/concept/108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "Body of law created by administrative agencies in the form of rules, regulations, orders and decisions to carry out regulatory powers and duties of such agencies."@en ;
    skos:prefLabel "administrative law"@en .

<http://www.eionet.europa.eu/gemet/concept/10818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10076> ;
    skos:definition "Gainful employment or job-related activity pertaining to ecological concerns, including the preservation of natural resources and the integrity of the ecosystem."@en ;
    skos:prefLabel "environmental occupation"@en .

<http://www.eionet.europa.eu/gemet/concept/1082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6821> ;
    skos:definition "A large, long-bodied motor vehicle equipped with seating for passengers, usually operating as part of a scheduled service."@en ;
    skos:prefLabel "bus"@en .

<http://www.eionet.europa.eu/gemet/concept/10860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10905> ;
    skos:definition "Part of the road or a special path for the use of people riding bicycles."@en ;
    skos:prefLabel "cycle path"@en .

<http://www.eionet.europa.eu/gemet/concept/10861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8014> ;
    skos:definition "A trail, slope, or course for skiing."@en ;
    skos:prefLabel "ski run"@en .

<http://www.eionet.europa.eu/gemet/concept/10884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7319> ;
    skos:definition "An established or selected course for travel consisting, typically, of secondary roads with significant scenic, cultural, historic, geological or natural features and including vistas, rest areas, and interpretive sites matching the scenic characteristics of the course."@en ;
    skos:prefLabel "touristic route"@en .

<http://www.eionet.europa.eu/gemet/concept/10890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5444> ;
    skos:definition "A private, non-profit facility where plants and animals can be viewed in a natural outdoor setting."@en ;
    skos:prefLabel "ecomuseum"@en .

<http://www.eionet.europa.eu/gemet/concept/10891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "The traditional and common beliefs, practices and customs of a people, which are passed on as a shared way of life, often through oral traditions such as folktales, legends, anecdotes, proverbs, jokes and other forms of communication."@en ;
    skos:prefLabel "folklore"@en .

<http://www.eionet.europa.eu/gemet/concept/10892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8075> ;
    skos:prefLabel "public attendance"@en .

<http://www.eionet.europa.eu/gemet/concept/10893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8075> ;
    skos:prefLabel "tourist attendance"@en .

<http://www.eionet.europa.eu/gemet/concept/10895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "A small house or a hut located in the countryside."@en ;
    skos:prefLabel "country lodge"@en .

<http://www.eionet.europa.eu/gemet/concept/10904> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8299> ;
    skos:definition "The community or people in general or a part or section of the community grouped because of a common interest or activity."@en ;
    skos:prefLabel "public"@en .

<http://www.eionet.europa.eu/gemet/concept/10906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10905> ;
    skos:definition "A route or track running along the coast."@en ;
    skos:prefLabel "seaside footpath"@en .

<http://www.eionet.europa.eu/gemet/concept/10907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10905> ;
    skos:definition "A guided trail, designed to explain to children a piece of countryside, the type of soil, flora, fauna, etc. Such trails may be self-guiding, using either explanatory notices set up at intervals or numbered boards referring to a printed leaflet: in other cases parties may be led by a demonstrator or warden."@en ;
    skos:prefLabel "educational path"@en .

<http://www.eionet.europa.eu/gemet/concept/10909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "A place near the sea where people spend their holidays and enjoy themselves."@en ;
    skos:prefLabel "seaside resort"@en .

<http://www.eionet.europa.eu/gemet/concept/1091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4777> ;
    skos:definition "Any diurnal insect of the order Lepidoptera that has a slender body with clubbed antennae and typically rests with the wings (which are often brightly coloured) closed over the back."@en ;
    skos:prefLabel "butterfly"@en .

<http://www.eionet.europa.eu/gemet/concept/10910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "A place in the mountains where people spend their holidays and enjoy themselves."@en ;
    skos:prefLabel "mountain resort"@en .

<http://www.eionet.europa.eu/gemet/concept/10911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "Resort where sports held in the open air on snow or ice, especially skiing are practiced."@en ;
    skos:prefLabel "winter sports resort"@en .

<http://www.eionet.europa.eu/gemet/concept/10914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:prefLabel "touristic unit"@en .

<http://www.eionet.europa.eu/gemet/concept/10915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "A land carriage so constructed that it can be used on any kind of road or rough terrain and can be operated for many purposes, such as carrying goods, transporting the injured, conveying passengers, etc."@en ;
    skos:prefLabel "all-terrain vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/10918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The number of people relative to the space occupied by them."@en ;
    skos:prefLabel "population density"@en .

<http://www.eionet.europa.eu/gemet/concept/10919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:prefLabel "young"@en .

<http://www.eionet.europa.eu/gemet/concept/1092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/745> ;
    skos:definition "A tiny, circular battery made for a watch or for other microelectric applications."@en ;
    skos:prefLabel "button-cell battery"@en .

<http://www.eionet.europa.eu/gemet/concept/10922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5004> ;
    skos:definition "The number of people available and eligible for employment within a given enterprise, region or nation."@en ;
    skos:prefLabel "active population"@en .

<http://www.eionet.europa.eu/gemet/concept/10925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4808> ;
    skos:definition "The act of assigning various hours of one's day, week or year to particular activities, especially those falling within the categories of work and leisure."@en ;
    skos:prefLabel "time allocation"@en .

<http://www.eionet.europa.eu/gemet/concept/10927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "Goods which have a reasonably long life and which are not generally consumed in use: e.g. refrigerator."@en ;
    skos:prefLabel "durable goods"@en .

<http://www.eionet.europa.eu/gemet/concept/10929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "A good bought by consumers that tends to last for less than a year. Common examples are food and clothing. The notable thing about nondurable goods is that consumers tend to continue buying them regardless of the ups and downs of the business cycle."@en ;
    skos:prefLabel "non-durable goods"@en .

<http://www.eionet.europa.eu/gemet/concept/1093> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Incidental taking of non-commercial species in drift nets, trawling operations and long line fishing; it is responsible for the death of large marine animals and one factor in the threatened extinction of some species."@en ;
    skos:prefLabel "by-catch"@en .

<http://www.eionet.europa.eu/gemet/concept/10932> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1743> ;
    skos:definition "Determining or planning for allotment of time in hours, days, weeks, etc."@en ;
    skos:prefLabel "time budget"@en .

<http://www.eionet.europa.eu/gemet/concept/10933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "External conditions or surroundings in which people live or work."@en ;
    skos:prefLabel "living environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5090> ;
    skos:definition "A product life cycle includes the following phases: acquisition of raw materials, production, packaging, distribution, use, recyling, and disposal."@en ;
    skos:prefLabel "product life cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/10938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11612> ;
    skos:definition "The formal assertion in writing that a commodity, service or other product has attained a recognized and relatively high grade or level of excellence."@en ;
    skos:prefLabel "quality certification"@en .

<http://www.eionet.europa.eu/gemet/concept/10939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "A measurement of the development level in a country or community, gauged by factors such as personal income, education, life expectancy, food consumption, health care, technology and the use of natural resources."@en ;
    skos:prefLabel "living standard"@en .

<http://www.eionet.europa.eu/gemet/concept/1094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "A product from a manufacturing process that is not considered the principal material."@en ;
    skos:prefLabel "by-product"@en .

<http://www.eionet.europa.eu/gemet/concept/10959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "Any imbalance or disparity among inhabitants of the same living environment deemed inappropriate, unjust or detrimental to that environment's integrity."@en ;
    skos:prefLabel "ecological inequality"@en .

<http://www.eionet.europa.eu/gemet/concept/10960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7791> ;
    skos:definition "Unequal rewards or opportunities for different individuals within a group or groups within a society. If equality is judged in terms of legal equality, equality of opportunity, or equality of outcome, then inequality is a constant feature of the human condition."@en ;
    skos:prefLabel "social inequality"@en .

<http://www.eionet.europa.eu/gemet/concept/10964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "A traditional or legendary story, usually dealing with supernatural beings, ancestors, heroes or events, that is with or without determinable basis of fact or a natural explanation, but is used to explain some practice, rite or phenomenon of nature, or to justify the existence of a social institution."@en ;
    skos:prefLabel "myth"@en .

<http://www.eionet.europa.eu/gemet/concept/10968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:definition "Not In My BackYard: phrase used to describe people who encourage the development of agriculture land for building houses or factories, provided it is not near where they themselves are living."@en ;
    skos:prefLabel "NIMBY aptitude"@en .

<http://www.eionet.europa.eu/gemet/concept/10971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10057> ;
    skos:definition "Study of the effects of social structure on cognition and behavior, of processes of face-to-face interaction, and of the negotiation of social order."@en ;
    skos:prefLabel "social psychology"@en .

<http://www.eionet.europa.eu/gemet/concept/10972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7817> ;
    skos:definition "A system of values, ideas and practices established to orient individuals in their community and culture and to provide them with naming, classification and communication codes."@en ;
    skos:prefLabel "social representation"@en .

<http://www.eionet.europa.eu/gemet/concept/10976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "A consciousness, sensibility or sympathetic perception of the physical world and its scenery in their uncultivated state."@en ;
    skos:prefLabel "feeling for nature"@en .

<http://www.eionet.europa.eu/gemet/concept/10977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10057> ;
    skos:definition "Economic and social structure of communities, tax rates, characteristic types of development."@en ;
    skos:prefLabel "socioeconomics"@en .

<http://www.eionet.europa.eu/gemet/concept/1098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Strands of insulated electrical conductors laid together, usually around a central core, and wrapped in a heavy insulation."@en ;
    skos:prefLabel "cable"@en .

<http://www.eionet.europa.eu/gemet/concept/10980> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The legal right of access to administrative documents or the opportunity to avail oneself of the same."@en ;
    skos:prefLabel "access to administrative documents"@en .

<http://www.eionet.europa.eu/gemet/concept/10981> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "Any formal and legitimate step taken or decision made on matters of policy by a chief or other top-level officer within an organization."@en ;
    skos:prefLabel "administrative deed"@en .

<http://www.eionet.europa.eu/gemet/concept/10985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3455> ;
    skos:definition "An administrative body or system in which political direction or control is exercised over a designated area or an administrative division of a city, county or larger geographical area."@en ;
    skos:prefLabel "territorial government"@en .

<http://www.eionet.europa.eu/gemet/concept/10986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2009> ;
    skos:prefLabel "decision making support"@en .

<http://www.eionet.europa.eu/gemet/concept/10988> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "The skill, knowledge, qualification, capacity or authority associated with the chief of an administrative department or other high ranking official selected by the head of state."@en ;
    skos:prefLabel "minister competence"@en .

<http://www.eionet.europa.eu/gemet/concept/10991> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "A native or naturalized member of a state or nation who owes allegiance, bears responsibilities and obtains rights, including protection, from the government."@en ;
    skos:prefLabel "citizen"@en .

<http://www.eionet.europa.eu/gemet/concept/10992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3455> ;
    skos:definition "An administrative body or system in which political direction and control is exercised over the community of a city, town or small district."@en ;
    skos:prefLabel "local government"@en .

<http://www.eionet.europa.eu/gemet/concept/10993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "An infrastructure, body of people or homogenous constituency that is physically situated in a localized exurban area."@en ;
    skos:prefLabel "territorial community"@en .

<http://www.eionet.europa.eu/gemet/concept/10999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13293> ;
    skos:definition "Formal discussion or dispute on a particular matter among the members of the parliament."@en ;
    skos:prefLabel "parliamentary debate"@en .

<http://www.eionet.europa.eu/gemet/concept/1100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "One of the toxic heavy metal which has caused deaths and permanent illnesses in a series of major pollution incidents around the world. Cadmium has no useful biological purpose. However, it has wide industrial applications. It has been used for decades in metal plating to prevent corrosion, in rechargeable batteries and as a pigment in certain plastics and paints. Special care is taken in the industrial smelting of ores and subsequent handling of cadmium, because occupational exposure is known to have caused heart, chest and kidney disorders. Environmental health problems have come from exposure to various sources of pollution."@en ;
    skos:prefLabel "cadmium"@en .

<http://www.eionet.europa.eu/gemet/concept/11007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The underlying reason or cause, a psychological or social factor, that incites or stimulates managers, executives or supervisors to complete tasks that achieve organizational or company goals."@en ;
    skos:prefLabel "motivation of administrative acts"@en .

<http://www.eionet.europa.eu/gemet/concept/1101> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11676> ;
    skos:definition "The release and presence in the air, water and soil of cadmium, a toxic, metallic element, from sources such as the burning of coal and tobacco and improper disposal of cadmium-containing waste."@en ;
    skos:prefLabel "cadmium contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/11016> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2498> ;
    skos:definition "A design, scheme or project pertaining to the production, distribution and use of income, wealth and commodities."@en ;
    skos:prefLabel "economic plan"@en .

<http://www.eionet.europa.eu/gemet/concept/11018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13302> ;
    skos:definition "The fundamental doctrine or tenet that policy making decisions should be made at the most decentralized level, in which a centralized governing body would not take action unless it it is more effective than action taken at a lower government level."@en ;
    skos:prefLabel "subsidiary principle"@en .

<http://www.eionet.europa.eu/gemet/concept/1103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2636> ;
    skos:definition "A soft silvery-white and highly reactive metal belonging to the alkali group of metals. It is a radiation hazard, because it can occur in two radioactive forms. Caesium-134 is produced in nuclear reactors, not directly by fission, but by the reaction. It emits beta- and gamma-radiation and has a half-life of 2.06 years. Caesium-137 is a fission product of uranium and occurs in the fallout from nuclear weapons. It emits beta- and gamma-rays and has a half-life of 30 years. Caesium-137 was the principal product released into the atmosphere, and hence the food chain, from atmospheric testing of nuclear weapons and from the Windscale fire and Chernobyl nuclear accidents. After the Chernobyl accident, which spread a radiation cloud across Europe, the European Commission proposed new and more restrictive limits on levels of caesium in food and drinking water."@en ;
    skos:prefLabel "caesium"@en .

<http://www.eionet.europa.eu/gemet/concept/11030> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13302> ;
    skos:definition "The transfer of funds from developed to underdeveloped countries."@en ;
    skos:prefLabel "financial aid"@en .

<http://www.eionet.europa.eu/gemet/concept/11031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "Economic, military, technical or financial aid or support given to nations or countries in need, often from other governments or international or intergovernmental organizations."@en ;
    skos:prefLabel "international assistance"@en .

<http://www.eionet.europa.eu/gemet/concept/11032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13238> ;
    skos:definition "Government aid in the form of monies or food stamps to the poor, disabled, aged or to dependent children."@en ;
    skos:prefLabel "public aid"@en .

<http://www.eionet.europa.eu/gemet/concept/11035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "A separate financial record or statement that discloses financial activity in a particular area and supplements existing financial records."@en ;
    skos:prefLabel "satellite account"@en .

<http://www.eionet.europa.eu/gemet/concept/11038> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3049> ;
    skos:definition "Any spending done by a person living alone or by a group of people living together in shared accommodation and with common domestic expenses."@en ;
    skos:prefLabel "household expenditure"@en .

<http://www.eionet.europa.eu/gemet/concept/11039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3049> ;
    skos:definition "Spending by national or local government, government-owned firms or quasi-autonomous non-government organizations."@en ;
    skos:prefLabel "public expenditure"@en .

<http://www.eionet.europa.eu/gemet/concept/11043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11044> ;
    skos:definition "Money or financial resources set aside to interpose or interfere in any business affair in order to affect an outcome."@en ;
    skos:prefLabel "intervention fund"@en .

<http://www.eionet.europa.eu/gemet/concept/11045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "Fund organized by the European Monetary System in which members of the European Community deposit reserves to provide a pool of resources to stabilize exchange rates and to finance balance of payments in support of the pending full European Monetary Union."@en ;
    skos:prefLabel "European Monetary Fund"@en .

<http://www.eionet.europa.eu/gemet/concept/11046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:definition "An international organization established in 1944, affiliated with the United Nations that acts as an international bank facilitating the exchange of national currencies and providing loans to member nations. It also evaluates the performance of the economies of the world's countries."@en ;
    skos:prefLabel "International Monetary Fund"@en .

<http://www.eionet.europa.eu/gemet/concept/11047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13238> ;
    skos:definition "Rewards or penalties offered by government or management to induce an economic sector, company or group of workers to act in such a way as to produce results that plan objectives or policy goals."@en ;
    skos:prefLabel "economic incentive"@en .

<http://www.eionet.europa.eu/gemet/concept/11048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:prefLabel "incentive tax"@en .

<http://www.eionet.europa.eu/gemet/concept/11050> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11034> ;
    skos:definition "The total output of goods and services produced by a national economy in a given period, usually a year, valued at market prices. It is gross, since no allowance is made, for the value of replacement capital goods."@en ;
    skos:prefLabel "gross domestic product"@en .

<http://www.eionet.europa.eu/gemet/concept/11051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Compulsory charges levied by a government unit in special or unique instances for the purpose of raising revenue to pay for services or improvements for the general public benefit."@en ;
    skos:prefLabel "exceptional tax"@en .

<http://www.eionet.europa.eu/gemet/concept/11055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:prefLabel "process analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/11057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "The periodic or continuous verification of the accounts, assets and liabilities of a company or other organization, often to confirm compliance with legal and professional standards."@en ;
    skos:prefLabel "audit"@en .

<http://www.eionet.europa.eu/gemet/concept/11061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Evaluation of the natural structures, resources and landscapes to ensure their careful management and preservation."@en ;
    skos:prefLabel "natural heritage assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/11063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "The value or the amount of money exchanged for the production and sustained supply of water."@en ;
    skos:prefLabel "water cost"@en .

<http://www.eionet.europa.eu/gemet/concept/11065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The buying, selling, advertising, shipping, and storing of goods in compliance with ecological principles."@en ;
    skos:prefLabel "ecomarketing"@en .

<http://www.eionet.europa.eu/gemet/concept/11069> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "A type of leadership and management style attempting to gain the loyalty and support of subordinates by excessively providing for their needs and interests."@en ;
    skos:prefLabel "patrimonial management"@en .

<http://www.eionet.europa.eu/gemet/concept/11070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2856> ;
    skos:definition "Securities held for the production of income in the form of interest and dividends with the aim of controlling or reducing pollution or substances in the environment deemed harmful to human health and natural resources."@en ;
    skos:prefLabel "pollution control investment"@en .

<http://www.eionet.europa.eu/gemet/concept/11071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:prefLabel "environment market"@en .

<http://www.eionet.europa.eu/gemet/concept/11073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/483> ;
    skos:definition "A prize or bonus given as an inducement or reward for efforts to reduce the presence of pollution or substances in the environment deemed harmful to human health or natural resources."@en ;
    skos:prefLabel "antipollution premium"@en .

<http://www.eionet.europa.eu/gemet/concept/11082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "Applying a monetary rate or value at which water can be bought or sold."@en ;
    skos:prefLabel "water pricing"@en .

<http://www.eionet.europa.eu/gemet/concept/11087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7702> ;
    skos:definition "A structured simulation or explanation based on observation, experimentation and reasoning that seeks to demonstrate, characterize or explain the actions and interactions of the total surrounding conditions of a given system."@en ;
    skos:prefLabel "theory of the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/11089> a skos:Concept ;
    skos:prefLabel "trade activity"@en .

<http://www.eionet.europa.eu/gemet/concept/11095> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7790> ;
    skos:definition "A stage of growth or advancement in any aspect of a community that is defined by or restricted to a particular and usually small district or area."@en ;
    skos:prefLabel "local development"@en .

<http://www.eionet.europa.eu/gemet/concept/11097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "The gathering and studying of data to determine the projection of demand for an item or service."@en ;
    skos:prefLabel "market study"@en .

<http://www.eionet.europa.eu/gemet/concept/11100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "Trade which is unimpeded by tariffs, import and export quotas and other measures which obstruct the free movement of goods and services between states."@en ;
    skos:prefLabel "free trade"@en .

<http://www.eionet.europa.eu/gemet/concept/11103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8078> ;
    skos:definition "One of the world's poorest nations, typically small in area and population, with low per capita incomes, literacy levels and medical standards, subsistence agriculture and a lack of exploitable minerals and competitive industries."@en ;
    skos:prefLabel "less developed country"@en .

<http://www.eionet.europa.eu/gemet/concept/11106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7832> ;
    skos:definition "The connections, associations or involvement of developed nations, found predominantly in the Northern Hemisphere, with developing nations, found predominantly in the Southern Hemisphere."@en ;
    skos:prefLabel "North-South relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/1111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:definition "A malleable silvery-white metallic element of the alkaline hearth group; the fifth most abundant element in the earth crust, occurring especially as forms of calcium carbonate. It is an essential constituent of bones and teeth and is used as a deoxidizer in steel."@en ;
    skos:prefLabel "calcium"@en .

<http://www.eionet.europa.eu/gemet/concept/11113> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "The act, process or result of calculating."@en ;
    skos:prefLabel "calculation"@en .

<http://www.eionet.europa.eu/gemet/concept/11116> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The mass of unit volume of a substance."@en ;
    skos:prefLabel "density"@en .

<http://www.eionet.europa.eu/gemet/concept/11118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:definition "A distribution or set of geographic observations representing the values of behaviour of a particular phenomenon or characteristic across many locations on the surface of the Earth."@en ;
    skos:prefLabel "spatial distribution"@en .

<http://www.eionet.europa.eu/gemet/concept/11119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:prefLabel "economic data"@en .

<http://www.eionet.europa.eu/gemet/concept/1112> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "Amount of calcium contained in a solution."@en ;
    skos:prefLabel "calcium content"@en .

<http://www.eionet.europa.eu/gemet/concept/11125> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "An official periodic count of a population including such information as sex, age, occupation, etc."@en ;
    skos:prefLabel "census survey"@en .

<http://www.eionet.europa.eu/gemet/concept/11127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8075> ;
    skos:definition "An ordered sequence of data samples in numerical form used to predict or demonstrate trends through time and space."@en ;
    skos:prefLabel "statistical series"@en .

<http://www.eionet.europa.eu/gemet/concept/11128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8240> ;
    skos:definition "The canvassing of a representative sample of a large group of people on some question in order to determine the general opinion of a group."@en ;
    skos:prefLabel "opinion survey"@en .

<http://www.eionet.europa.eu/gemet/concept/1113> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088> ;
    skos:prefLabel "calculation method"@en .

<http://www.eionet.europa.eu/gemet/concept/11130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The amount of change in some quantity during a time interval divided by the length of the time interval."@en ;
    skos:prefLabel "rate"@en .

<http://www.eionet.europa.eu/gemet/concept/11133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "In time series, that part of the movement which is assigned to the effect of the seasons on the year."@en ;
    skos:prefLabel "seasonal variation"@en .

<http://www.eionet.europa.eu/gemet/concept/11134> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "An organized group of persons elected or appointed to discuss scientific matters."@en ;
    skos:prefLabel "scientific committee"@en .

<http://www.eionet.europa.eu/gemet/concept/11135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:prefLabel "scientific dispute"@en .

<http://www.eionet.europa.eu/gemet/concept/11146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Research directed toward using knowledge gained by basic research to make things or to create situations that will serve a practical or utilitarian purpose."@en ;
    skos:prefLabel "applied research"@en .

<http://www.eionet.europa.eu/gemet/concept/1115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1114> ;
    skos:definition "The determination or rectification of, according to an accepted standard, the graduation of any instrument giving quantitative measurements."@en ;
    skos:prefLabel "calibration of measuring equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/11152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496> ;
    skos:definition "The principles and procedures of soil management and of field crop and special-purpose plant improvement, management, and production."@en ;
    skos:prefLabel "agronomy"@en .

<http://www.eionet.europa.eu/gemet/concept/11153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13207> ;
    skos:definition "Ecosystem dominated by the continuous agricultural intervention of man."@en ;
    skos:prefLabel "agrosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/11157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4052> ;
    skos:definition "Violent, sudden and destructive change in the environment either affecting or caused by land cultivation or the raising of crops or livestock."@en ;
    skos:prefLabel "agricultural disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/11158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11234> ;
    skos:definition "The underrating or diminishing in value of agricultural or farming goods and services."@en ;
    skos:prefLabel "agricultural undervaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/11159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/213> ;
    skos:definition "Any course destined to promote economic growth, modernization, increase in agricultural production and the creation of a framework in which to fulfill primary needs, such as education, health and supply of water in the rural areas. The attainment of such objectives depends in general on the type of administrative systems proposed for the various programmes and on the national political situation as regards, for instance land tenure, agrarian reform, the disbursement of assistance and food policy."@en ;
    skos:prefLabel "rural development"@en .

<http://www.eionet.europa.eu/gemet/concept/11165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496> ;
    skos:definition "Science and technology involved in the management of water resources, in the control of erosion and in the removal of unwanted water."@en ;
    skos:prefLabel "agricultural hydraulics"@en .

<http://www.eionet.europa.eu/gemet/concept/11177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13207> ;
    skos:definition "Cultivation of crops for consumption by livestock."@en ;
    skos:prefLabel "forage crop"@en .

<http://www.eionet.europa.eu/gemet/concept/11178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The business of growing fruit and vegetables on a commercial scale."@en ;
    skos:prefLabel "market gardening"@en .

<http://www.eionet.europa.eu/gemet/concept/11184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "A fertilized ovule containing an embryo which forms a new plant upon germination."@en ;
    skos:prefLabel "seed (product)"@en .

<http://www.eionet.europa.eu/gemet/concept/11186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Use of chemicals in order to avoid damage of crops by insects or weeds."@en ;
    skos:prefLabel "crop treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/11187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Removal of heavy metals from water by the employment of plants or treatment by which plant organisms act to degrade hazardous organic contaminants or transform hazardous inorganic contaminants to environmentally safe levels in soils, subsurface materials, water, sludges, and residues."@en ;
    skos:prefLabel "phytosanitary treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/11199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "The seasonal migration of livestock to suitable grazing grounds."@en ;
    skos:prefLabel "transhumance"@en .

<http://www.eionet.europa.eu/gemet/concept/112> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7411> ;
    skos:definition "Generally, any formal official imposition of penalty or fine; destruction, taking, seizure, or withholding of property; assessment of damages, reimbursement, restitution, compensation, costs, charges or fees; requirement, revocation or suspension of license; and taking other compulsory or restrictive action by organization, agency or its representative."@en ;
    skos:prefLabel "administrative sanction"@en .

<http://www.eionet.europa.eu/gemet/concept/11201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "Any naturally occurring inorganic substances with a definite chemical composition and usually of crystalline structure, such as rocks, which are used to stabilize soil, improving its resistance to erosion, texture and permeability."@en ;
    skos:prefLabel "mineral conditioner"@en .

<http://www.eionet.europa.eu/gemet/concept/11204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The removal of water from a marshy area by artificial means, e.g. the introduction of drains."@en ;
    skos:prefLabel "draining"@en .

<http://www.eionet.europa.eu/gemet/concept/11206> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13207> ;
    skos:definition "A traditional farming system that has been used by generations of farmers in tropical forests and the savannah of north and east Africa. It is known to be an ecologically sound form of cultivation, and because the soil is poor in tropical rain forests it is a sustainable method of farming. It is still practised today, primarily in the developing countries. Small areas of bush or forests are cleared and the smaller trees burned. This unlocks the nutrients in the vegetation and gives the soil fertilizer that is easily taken up by plants. A few years later the soil is degraded and the farmer moves on to do the same at another site. The original ground is left fallow for anything up to 20 years so that the forest can regenerate. With the growth in population and in the subsequent need for more farming land to produce food, the method is increasingly being used today to clear large areas of tropical forests for cattle ranching, and in most cases the ground is not left fallow for long enough and, with modern mechanized farming systems, not enough tree stumps or suitable habitats for plant life are left to start the regeneration process."@en ;
    skos:prefLabel "slash and burn culture"@en .

<http://www.eionet.europa.eu/gemet/concept/11207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5675> ;
    skos:definition "A soft, pure, earthy, fine-textured, usually white to light gray or buff limestone of marine origin, consisting almost wholly (90-99%) of calcite, formed mainly by shallow-water accumulation of calcareous tests of floating microorganisms (chiefly foraminifers) and of comminuted remains of calcareous algae (such as cocoliths and rhabdoliths), set in a structureless matrix of very finely crystalline calcite. The rock is porous, somewhat friable, and only slightly coherent. It may include the remains of bottom-dwelling forms (e.g. ammonites, echinoderms, and pelecypods), and nodules of chert and pyrite. The best known and most widespread chalks are of Cretaceous age, such as those exposed in cliffs on both sides of the English Channel."@en ;
    skos:prefLabel "chalk"@en .

<http://www.eionet.europa.eu/gemet/concept/11209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4345> ;
    skos:definition "Fertilizer materials, natural or synthesized, containing nitrogen available for fixation by vegetation, such as potassium nitrate or ammonium nitrate."@en ;
    skos:prefLabel "nitrogenous fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/1121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "Guarded area equipped with sanitary facilities where holiday-makers may pitch a tent and camp by paying a daily rate."@en ;
    skos:prefLabel "camping"@en .

<http://www.eionet.europa.eu/gemet/concept/11211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4345> ;
    skos:definition "Fertilizer compound or mixture containing available (soluble) phosphate; examples are phosphate rock (phosphorite), superphosphates or triple superphosphates, nitrophosphate, potassium phosphate, or N-P-K mixtures."@en ;
    skos:prefLabel "phosphatic fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/11212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4345> ;
    skos:definition "A chemical fertilizer containing potassium. Potassium (K) is required by all plant and animal life. Plants require potassium for photosynthesis, osmotic regulation and the activation of enzyme systems."@en ;
    skos:prefLabel "potassium fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/11214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "The act or process in which a section of the ground is freed from pollution or any type of contamination, often through natural processes."@en ;
    skos:prefLabel "purification through the soil"@en .

<http://www.eionet.europa.eu/gemet/concept/11224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "The removal of water or any soluble constituents from the soil. Leaching often occurs with soil constituents such as nitrate fertilizers with the result that nitrates end up in potable waters."@en ;
    skos:prefLabel "soil leaching"@en .

<http://www.eionet.europa.eu/gemet/concept/11226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7882> ;
    skos:definition "Inorganic materials having a distinct chemical composition, characteristic crystalline structure, colour, and hardness."@en ;
    skos:prefLabel "mineral matter"@en .

<http://www.eionet.europa.eu/gemet/concept/1123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "A piece of land where people on holiday can stay in tents, usually with toilets and places for washing."@en ;
    skos:prefLabel "camping site"@en .

<http://www.eionet.europa.eu/gemet/concept/11232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "A system of man-made channels for supplying water to land to allow plants to grow."@en ;
    skos:prefLabel "irrigation system"@en .

<http://www.eionet.europa.eu/gemet/concept/11233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "Measurement of the quantity of mineral salts found in a soil. Many semi-arid and arid areas are naturally salty. By definition they are areas of substantial water deficit where evapotranspiration exceeds precipitation. Thus, whereas in humid areas there is sufficient water to percolate through the soil and to leach soluble materials from the soil and the rocks into the rivers and hence into the sea, in deserts this is not the case. Salts therefore tend to accumulate."@en ;
    skos:prefLabel "soil salinity"@en .

<http://www.eionet.europa.eu/gemet/concept/11237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:prefLabel "mountain management"@en .

<http://www.eionet.europa.eu/gemet/concept/11243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/213> ;
    skos:definition "The activity or process of overseeing and preparing for the future physical arrangement and condition of any agricultural or pastoral area, which may involve protecting and developing natural and human resources that affect an area's economic vitality."@en ;
    skos:prefLabel "rural management and planning"@en .

<http://www.eionet.europa.eu/gemet/concept/11244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The administration, promotion, organization and planning for the business or industry of providing information, transportation, entertainment, accommodations and other services to travelers or visitors."@en ;
    skos:prefLabel "touristic activity management"@en .

<http://www.eionet.europa.eu/gemet/concept/11246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "Any entity or group of individuals involved with the creation, management and conservation of an extensive area of woodland, often to produce products and benefits such as timber, clean water, biodiversity and recreation."@en ;
    skos:prefLabel "forestry unit"@en .

<http://www.eionet.europa.eu/gemet/concept/11248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for the supply of material necessities such as tools, gear, provisions or furnishings."@en ;
    skos:prefLabel "equipment plan"@en .

<http://www.eionet.europa.eu/gemet/concept/11259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "The way or means of entry or access."@en ;
    skos:prefLabel "approach"@en .

<http://www.eionet.europa.eu/gemet/concept/11269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8073> ;
    skos:definition "A place along a route or line at which a train stops to pick up or let off passengers or goods, especially with ancillary buildings and services."@en ;
    skos:prefLabel "railway station"@en .

<http://www.eionet.europa.eu/gemet/concept/11270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8073> ;
    skos:definition "A place along a route or line at which a bus stops for fuel or to pick up or let off passengers or goods, especially with ancillary buildings and services."@en ;
    skos:prefLabel "bus station"@en .

<http://www.eionet.europa.eu/gemet/concept/11271> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "The aggregation of components used for building streets, highways and other routes, such as asphalt, concrete, brick, sand and gravel."@en ;
    skos:prefLabel "road construction material"@en .

<http://www.eionet.europa.eu/gemet/concept/11272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "engineering work"@en .

<http://www.eionet.europa.eu/gemet/concept/11294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11289> ;
    skos:definition "Transportation of persons and goods by means of ships travelling along fixed navigation routes."@en ;
    skos:prefLabel "merchant shipping"@en .

<http://www.eionet.europa.eu/gemet/concept/11296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13233> ;
    skos:definition "Transport in which more than one carrier is used, e.g. road, rail and sea."@en ;
    skos:prefLabel "combined transport"@en .

<http://www.eionet.europa.eu/gemet/concept/1130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "Any malignant cellular tumour including carcinoma and sarcoma. It encompasses a group of neoplastic diseases in which there is a transformation of normal body cells into malignant ones, probably involving some change in the genetic material of the cells, possibly as a result of faulty repair of damage to the cell caused by carcinogenic agents or ionizing radiation."@en ;
    skos:prefLabel "cancer"@en .

<http://www.eionet.europa.eu/gemet/concept/11307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "Body of people living in a town or city."@en ;
    skos:prefLabel "urban community"@en .

<http://www.eionet.europa.eu/gemet/concept/11308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A written or printed text furnishing proposals or procedures for the improvement of living conditions, especially housing, for the inhabitants of a city or densely populated area."@en ;
    skos:prefLabel "urban development document"@en .

<http://www.eionet.europa.eu/gemet/concept/11309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "Any expanse of land or region located on the outskirts of a city or town."@en ;
    skos:prefLabel "periurban space"@en .

<http://www.eionet.europa.eu/gemet/concept/11312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13100> ;
    skos:definition "An unattached dwelling unit inhabited by an adult person plus one or more related persons."@en ;
    skos:prefLabel "single family dwelling"@en .

<http://www.eionet.europa.eu/gemet/concept/11321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "The key element of a comprehensive plan; describes the recommended location and intensity of development for public and private land uses, such as residential, commercial, industrial, recreational and agricultural."@en ;
    skos:prefLabel "land use plan"@en .

<http://www.eionet.europa.eu/gemet/concept/11322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8829> ;
    skos:definition "The activity or process of preparing for the future arrangement and condition of an urban center, particularly the development of its physical lay-out, which would include the construction, reconstruction, conversion, alteration or enlargement of buildings and other structures, and the extension or use of undeveloped land."@en ;
    skos:prefLabel "urban planning and development"@en .

<http://www.eionet.europa.eu/gemet/concept/11323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13102> ;
    skos:definition "Relation existing between the landowner and the tenant farmer who cultivates the land."@en ;
    skos:prefLabel "land use regime"@en .

<http://www.eionet.europa.eu/gemet/concept/1133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15198>,
        <http://www.eionet.europa.eu/gemet/concept/3872>,
        <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "The probability that exposure to some agent or substance will adversely transform cells to replicate and form a malignant tumor."@en ;
    skos:prefLabel "cancer risk"@en .

<http://www.eionet.europa.eu/gemet/concept/11332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1421> ;
    skos:definition "Any of several recent urban developments that constitute small and essentially self-sufficient cities with a planned ordering of residential, industrial, and commercial development."@en ;
    skos:prefLabel "new town"@en .

<http://www.eionet.europa.eu/gemet/concept/11333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Areas that are subject to the pre-emption right which is a privilege accorded by the government to the actual settler upon a certain limited portion of the public domain, to purchase such tract at a fixed price to the exclusion of all other applicants."@en ;
    skos:prefLabel "pre-emption zone"@en .

<http://www.eionet.europa.eu/gemet/concept/11334> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Any expanse of land which requires a person or agency with authority to interpose or interfere in how it is used or administrated."@en ;
    skos:prefLabel "land-management intervention area"@en .

<http://www.eionet.europa.eu/gemet/concept/11344> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/538> ;
    skos:prefLabel "rural architecture"@en .

<http://www.eionet.europa.eu/gemet/concept/11345> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/538> ;
    skos:prefLabel "traditional architecture"@en .

<http://www.eionet.europa.eu/gemet/concept/11355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1731> ;
    skos:definition "The tearing down of buildings by mechanical means."@en ;
    skos:prefLabel "building destruction"@en .

<http://www.eionet.europa.eu/gemet/concept/11359> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "Branch of engineering dealing with the form and functions of urban areas."@en ;
    skos:prefLabel "municipal engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/11375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4040> ;
    skos:definition "The accurate reestablishment of the form and details of a building, its artifacts, and the site on which it is located, usually as it appeared at a particular time."@en ;
    skos:prefLabel "building restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/11427> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A declaration made in a prescribed form before a justice of the peace, notary public, or other person authorized to administer an oath."@en ;
    skos:prefLabel "statutory declaration"@en .

<http://www.eionet.europa.eu/gemet/concept/11430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "A standard which has been approved pursuant to the statutes of the standards bodies with which the Community has concluded agreements."@en ;
    skos:prefLabel "European standard"@en .

<http://www.eionet.europa.eu/gemet/concept/11431> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "Documented agreements containing technical specifications or other precise criteria to be used consistently as rules, guidelines, or definitions of characteristics, to ensure that materials, products, processes and services are fit for their purpose."@en ;
    skos:prefLabel "ISO standard"@en .

<http://www.eionet.europa.eu/gemet/concept/11466> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "The process of collecting and arranging systematically, usually by subject, the laws of a state or country, or the rules and regulations covering a particular area or subject of law or practice."@en ;
    skos:prefLabel "codification"@en .

<http://www.eionet.europa.eu/gemet/concept/11468> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "A rule, principle, theory, or tenet of the law, as the doctrine of merger, the doctrine of relation, etc."@en ;
    skos:prefLabel "doctrine (law)"@en .

<http://www.eionet.europa.eu/gemet/concept/11476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/206> ;
    skos:definition "A binding rule or body of rules prescribed by a government pertaining to matters of importance to residents of sparsely populated regions, especially agricultural and other economic issues."@en ;
    skos:prefLabel "rural law"@en .

<http://www.eionet.europa.eu/gemet/concept/11478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4060> ;
    skos:definition "The moral, legal or ethical claims of posterity on present people, based on the recognition that the young and unborn are vulnerable to contemporary decision-making, especially decisions having long-term effect on the societies and environment they inherit."@en ;
    skos:prefLabel "rights of future generations"@en .

<http://www.eionet.europa.eu/gemet/concept/11479> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4060> ;
    skos:definition "Rights recognized and protected by law, pertaining to the members of a state."@en ;
    skos:prefLabel "citizen rights"@en .

<http://www.eionet.europa.eu/gemet/concept/11489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "Factual information, advice or a written warning communicated to a person by an authorized source, often conveyed because of a legal or administrative rule requiring transmission of such information to all concerned parties."@en ;
    skos:prefLabel "notice"@en .

<http://www.eionet.europa.eu/gemet/concept/11490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A memorandum, letter or notice in either paper or electronic format distributed widely throughout an organization or to a general list of interested parties."@en ;
    skos:prefLabel "circular mail"@en .

<http://www.eionet.europa.eu/gemet/concept/11493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2534> ;
    skos:prefLabel "Community ruling"@en .

<http://www.eionet.europa.eu/gemet/concept/11497> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Education in the theories and practices of managing an office, business or organization."@en ;
    skos:prefLabel "administrative instructions"@en .

<http://www.eionet.europa.eu/gemet/concept/11498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "The education, instruction, or discipline pertaining to or connected with the mechanical or industrial arts and the applied sciences."@en ;
    skos:prefLabel "technical instruction"@en .

<http://www.eionet.europa.eu/gemet/concept/11502> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Official permission granted to individuals or commercial enterprises allowing and regulating by time, location, species, size or amount the wild animals or game that can be killed and taken from lands within a particular jurisdiction."@en ;
    skos:prefLabel "hunting licence"@en .

<http://www.eionet.europa.eu/gemet/concept/11506> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Official permission granted to individuals or commercial enterprises allowing and regulating by time, location, species, size or amount the fish that can be caught from rivers, lakes or ocean waters within a particular jurisdiction."@en ;
    skos:prefLabel "fishing licence"@en .

<http://www.eionet.europa.eu/gemet/concept/11508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13290> ;
    skos:definition "The form in which proposed statutes, resolutions or special acts are introduced into a legislative body, before they are enacted or passed."@en ;
    skos:prefLabel "law draft"@en .

<http://www.eionet.europa.eu/gemet/concept/11517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:prefLabel "transposition of directive"@en .

<http://www.eionet.europa.eu/gemet/concept/11521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Any rebate, abatement, voluntary grant of or a yielding to a demand or claim, typically made by a government or controlling authority to an individual or organization."@en ;
    skos:prefLabel "concession"@en .

<http://www.eionet.europa.eu/gemet/concept/11522> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5880> ;
    skos:definition "Consideration, commentary by argument or informal debate on some issue that is open and of concern to the general populace."@en ;
    skos:prefLabel "public discussion"@en .

<http://www.eionet.europa.eu/gemet/concept/11523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Administrative Act giving the right to take private property for public use."@en ;
    skos:prefLabel "declaration of public utility"@en .

<http://www.eionet.europa.eu/gemet/concept/11524> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6802> ;
    skos:definition "Generally, land and water owned by individuals or corporations as opposed to the state; in French civil law, any government property capable of being owned by non-public entities, which cannot be seized and which is restricted to the stipulated ownership and use."@en ;
    skos:prefLabel "private domain"@en .

<http://www.eionet.europa.eu/gemet/concept/11525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6802> ;
    skos:definition "Rivers, canals and lakes owned by the state as opposed to individuals or corporations."@en ;
    skos:prefLabel "public waterways domain"@en .

<http://www.eionet.europa.eu/gemet/concept/11526> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6802> ;
    skos:definition "eas or ocean areas owned by the state as opposed to individuals or corporations."@en ;
    skos:prefLabel "public maritime domain"@en .

<http://www.eionet.europa.eu/gemet/concept/11530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11531> ;
    skos:definition "An investigation, especially a formal one conducted into a matter of public utility by a body constituted for that purpose by a government, local authority, or other organization."@en ;
    skos:prefLabel "public benefit inquiry"@en .

<http://www.eionet.europa.eu/gemet/concept/11532> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13291> ;
    skos:definition "The process of assigning or transferring authority, decision making or a specific administrative function from one entity to another."@en ;
    skos:prefLabel "delegated management"@en .

<http://www.eionet.europa.eu/gemet/concept/11535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "The power or authority of a government to regulate or command industry, organizations, programs, initiatives and individuals."@en ;
    skos:prefLabel "state control"@en .

<http://www.eionet.europa.eu/gemet/concept/11536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5971> ;
    skos:definition "The rights of use over the property of another; a burden on a piece of land causing the owner to suffer access by another."@en ;
    skos:prefLabel "easement"@en .

<http://www.eionet.europa.eu/gemet/concept/11548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:prefLabel "police power"@en .

<http://www.eionet.europa.eu/gemet/concept/11549> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "The rules of law governing the procedure by which crimes are investigated, prosecuted, adjudicated, and punish."@en ;
    skos:prefLabel "criminal law procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/11556> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "The official and authentic decision of a court of justice upon the respective rights and claims of the parties to an action or suit therein litigated and submitted to its determination. The final decision of the court resolving the dispute and determining the rights and obligations of the parties. The law's last word in a judicial controversy, it being the final determination by a court of the rights of the parties upon matters submitted to it in an action or proceeding."@en ;
    skos:prefLabel "judgement (sentence)"@en .

<http://www.eionet.europa.eu/gemet/concept/11559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A state of opposition or disagreement between ideas, interests, etc."@en ;
    skos:prefLabel "conflict"@en .

<http://www.eionet.europa.eu/gemet/concept/11563> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A judicial contest, a judicial controversy, a suit at law."@en ;
    skos:prefLabel "litigation"@en .

<http://www.eionet.europa.eu/gemet/concept/11568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11594> ;
    skos:definition "An independent, specialized judicial tribunal in which judges or officials are authorized by a government agency to conduct hearings and render decisions in proceedings between the government agency and the persons, businesses or other organizations that it regulates."@en ;
    skos:prefLabel "administrative court (administration)"@en .

<http://www.eionet.europa.eu/gemet/concept/11571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "Institution set up under Treaty of Rome to ensure that in interpretation and application of the Treaty the law is observed. It consists of judges from each member state, appointed for 6-year periods, assisted by three Advocates General. It sits in Luxembourg, expressing itself in judgements when called upon to do so in proceedings initiated by member states, institutions of the EC and natural or legal persons. Procedures are generally inquisitorial."@en ;
    skos:prefLabel "Court of Justice of the European Communities"@en .

<http://www.eionet.europa.eu/gemet/concept/11587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A judicial examination and determination of issues between parties to action; whether they need issues of law or of fact. A judicial examination, in accordance with law of the land, of a cause, either civil or criminal, of the issues between the parties, whether of law or fact, before a court that has proper jurisdiction."@en ;
    skos:prefLabel "trial"@en .

<http://www.eionet.europa.eu/gemet/concept/11611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4032> ;
    skos:definition "Any agreement which gives rise to relationship of landlord and tenant (real property) or lessor and lessee (real or personal property). Contract for exclusive possession of lands or tenements for determinate period. Contract for possession and profits of lands and tenements either for life, or for certain period of time, or during the pleasure of the parties."@en ;
    skos:prefLabel "lease"@en .

<http://www.eionet.europa.eu/gemet/concept/11618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "The approval given by the judge of certain acts and agreements for the purpose of rendering them more binding and executory."@en ;
    skos:prefLabel "homologation"@en .

<http://www.eionet.europa.eu/gemet/concept/11623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "The right of first refusal to purchase land in the event that the grantor of the right should decide to sell."@en ;
    skos:prefLabel "pre-emption"@en .

<http://www.eionet.europa.eu/gemet/concept/11624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Acquisition of a personal right to use a way, water, light and air by reason of continuous usage. Prescription is a peremptory and perpetual bar to every species of action, real or personal, when creditor has been silent for a certain time without urging his claim."@en ;
    skos:prefLabel "prescription"@en .

<http://www.eionet.europa.eu/gemet/concept/11627> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The act, as by power or authority, of arresting or inhibiting the communication of ideas or facts as expressed in a practice, movement, publication or piece of evidence in a court proceeding."@en ;
    skos:prefLabel "repression"@en .

<http://www.eionet.europa.eu/gemet/concept/11632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The act of assigning or entrusting authority, powers or functions to another as deputy or agent, typically to a subordinate in the administrative structure of an organization or institution."@en ;
    skos:prefLabel "devolution"@en .

<http://www.eionet.europa.eu/gemet/concept/11633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6428> ;
    skos:definition "The forward continuous motion or diffusion of polluting substances, or the rate or quantity in which polluting substances move from one place to another."@en ;
    skos:prefLabel "pollutant flow"@en .

<http://www.eionet.europa.eu/gemet/concept/11635> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/290> ;
    skos:definition "The sea and the atmosphere are fluids in contact with one another, but in different energy states - the liquid and the gaseous. The free surface boundary between them inhibits, but by no means totally prevents, exchange of mass and energy between the two. Almost all interchanges across this boundary occur most effectively when turbulent conditions prevail. A roughened sea surface, large differences in properties between the water and the air, or an unstable air column that facilitates the transport of air volumes from sea surface to high in the atmosphere. Both heat and water (vapor) tend to migrate across the boundary in the direction from sea to air. Heat is exchanged by three processes: radiation, conduction, and evaporation. The largest net exchange is through evaporation, the process of transferring water from sea to air by vaporization of the water."@en ;
    skos:prefLabel "ocean-air interface"@en .

<http://www.eionet.europa.eu/gemet/concept/11636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6428> ;
    skos:definition "Uncontrolled movement, caused by percolation or other processes, of liquid or gaseous polluting materials from an original source area into other parts of an ecosystem."@en ;
    skos:prefLabel "pollutant migration"@en .

<http://www.eionet.europa.eu/gemet/concept/11638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution caused by oil spills, by the accidental release of radioactive substances, by the immission in water bodies or in the atmosphere of chemical substances deriving from industrial activities."@en ;
    skos:prefLabel "incidental pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Contamination of water, soil and air with pathogen bacteria."@en ;
    skos:prefLabel "bacteriological pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/1164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/833> ;
    skos:definition "The cycle of carbon in the biosphere, in which plants convert carbon dioxide to organic compounds that are consumed by plants and animals, and the carbon is returned to the biosphere in inorganic form by processes of respiration and decay."@en ;
    skos:prefLabel "carbon cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/11641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution from widespread activities with no one discrete source, e.g. acid rain, pesticides, urban run-off etc."@en ;
    skos:prefLabel "diffuse pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11642> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:prefLabel "domestic pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11643> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution deriving from all classes of mining operations and having an adverse effect on aquatic life, water supplies and the recreational use of waters."@en ;
    skos:prefLabel "mineral pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11644> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution caused by animal or plant material derived from living and dead organisms that may contain pathogenic bacteria and negatively influences the environment."@en ;
    skos:prefLabel "organic pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11645> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1319> ;
    skos:definition "Air pollution containing ozone and other reactive chemical compounds formed by the action of sunlight on nitrogen oxides and hydrocarbons, especially those in automobile exhaust."@en ;
    skos:prefLabel "photochemical pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:prefLabel "land-based marine pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11647> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution by toxic substances that produce a harmful effect on living organisms by physical contact, ingestion, or inhalation."@en ;
    skos:prefLabel "toxic pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/11648> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "Discharge of solid, liquid or gaseous waste into a river."@en ;
    skos:prefLabel "river disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/11649> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2372> ;
    skos:definition "The discharge, dumping or emission of wastes below the surface of the soil."@en ;
    skos:prefLabel "underground disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/11651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:prefLabel "urban pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/11671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/47> ;
    skos:definition "High degree of ionization of an acid in water solution."@en ;
    skos:prefLabel "strong acidity"@en .

<http://www.eionet.europa.eu/gemet/concept/11672> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5056> ;
    skos:definition "A normal metabolite that, when present in abnormal concentrations in certain body fluids, can indicate the presence of a particular disease or toxicological condition."@en ;
    skos:prefLabel "biomarker"@en .

<http://www.eionet.europa.eu/gemet/concept/11675> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1752> ;
    skos:definition "The presence in the environment of living organisms or agents derived by viruses, bacteria, fungi, and mammal and bird antigens that can cause many health effects."@en ;
    skos:prefLabel "biological contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/11686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "That quality of a process that precludes a prior state from being attained again."@en ;
    skos:prefLabel "irreversibility of the phenomenon"@en .

<http://www.eionet.europa.eu/gemet/concept/11691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11429> ;
    skos:definition "Any goal or target established for a product, service or endeavor that aspires to attain a relatively high grade or level of excellence."@en ;
    skos:prefLabel "quality objective"@en .

<http://www.eionet.europa.eu/gemet/concept/11692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6052> ;
    skos:definition "Any tiny or very small mass of material that has a definite volume and shape and resists forces that would alter its volume or shape."@en ;
    skos:prefLabel "solid particle"@en .

<http://www.eionet.europa.eu/gemet/concept/11693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Regenerative capacity of a system, of soils, water, etc."@en ;
    skos:prefLabel "purifying power"@en .

<http://www.eionet.europa.eu/gemet/concept/1170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Compulsory charges levied on fuels to reduce the output of carbon dioxide (CO2), which is a colourless and odourless gas substance that is incombustible."@en ;
    skos:prefLabel "carbon dioxide tax"@en .

<http://www.eionet.europa.eu/gemet/concept/11700> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5349> ;
    skos:definition "The generic name for a device that senses either the absolute value or a change in a physical quantity such as temperature, pressure, flow rate, or pH, or the intensity of light, sound, or ratio waves and converts that change into a useful input signal for an information-gathering system."@en ;
    skos:prefLabel "sensor"@en .

<http://www.eionet.europa.eu/gemet/concept/11701> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Designing, manufacturing, and utilizing physical instruments or instrument systems for detection, observation, measurement, automatic control, automatic computation, communication, or data processing."@en ;
    skos:prefLabel "instrumentation"@en .

<http://www.eionet.europa.eu/gemet/concept/11702> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The science of measurement."@en ;
    skos:prefLabel "metrology"@en .

<http://www.eionet.europa.eu/gemet/concept/11713> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8673> ;
    skos:definition "Herbicide belonging to the triazine group, widely employed and particularly in maize crops. It is highly toxic for phytoplancton and freshwater algae and, being highly soluble in water, it easily contaminates aquifers."@en ;
    skos:prefLabel "atrazine"@en .

<http://www.eionet.europa.eu/gemet/concept/11718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "A substance containing halogen atoms."@en ;
    skos:prefLabel "halogenated compound"@en .

<http://www.eionet.europa.eu/gemet/concept/1173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Colorless, odourless, tasteless, non-corrosive, highly poisonous gas of about the same density as that of air. Very flammable, burning in air with bright blue flame. Although each molecule of CO has one carbon atom and one oxygen atom, it has a shape similar to that of an oxygen molecule (two atoms of oxygen), which is important with regard to it's lethality."@en ;
    skos:prefLabel "carbon monoxide"@en .

<http://www.eionet.europa.eu/gemet/concept/11734> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8204> ;
    skos:definition "A gas at ordinary temperatures; produces an orange-red deposit when cooled to temperatures of liquid air; prepared by passing an electric discharge through a mixture of sulfur vapor and sulfur dioxide at low temperature."@en ;
    skos:prefLabel "sulphur monoxide"@en .

<http://www.eionet.europa.eu/gemet/concept/11745> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6485> ;
    skos:definition "Chemical compound belonging to the polychlorinated biphenyls family, used in the production of electrical equipment which requires dielectric fluid such as power transformers and capacitors, as well as in hydraulic machinery, vacuum pumps, compressors and heat-exchanger fluids."@en ;
    skos:prefLabel "pyralene"@en .

<http://www.eionet.europa.eu/gemet/concept/11752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5781> ;
    skos:definition "A non-malignant progressive, irreversible, lung disease, characterized by diffuse fibrosis, resulting from the inhalation of asbestos fibers."@en ;
    skos:prefLabel "asbestosis"@en .

<http://www.eionet.europa.eu/gemet/concept/11762> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:prefLabel "genotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/11763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6359> ;
    skos:definition "The state of being poisoned; the condition produced by a poison which may be swallowed, inhaled, injected, or absorbed through the skin."@en ;
    skos:prefLabel "intoxication"@en .

<http://www.eionet.europa.eu/gemet/concept/1177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "The disposal of slaughtered animals, other dead animal bodies and animal body parts after removal of the offal products."@en ;
    skos:prefLabel "carcass disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/11771> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "The laboratory determination of the effects of substances upon specific living organisms."@en ;
    skos:prefLabel "biological test"@en .

<http://www.eionet.europa.eu/gemet/concept/11779> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5892> ;
    skos:definition "The amount of carbon covalently bound in organic compounds in a water sample."@en ;
    skos:prefLabel "total organic carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/11781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2040> ;
    skos:definition "The act or process of simplifying or breaking down a molecule into smaller parts, either naturally or artificially."@en ;
    skos:prefLabel "chemical degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/11782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "Tests, examinations or evaluations performed in a laboratory."@en ;
    skos:prefLabel "laboratory test"@en .

<http://www.eionet.europa.eu/gemet/concept/11786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11124> ;
    skos:definition "Scale for showing the quality of an environment by indicating the types of organisms present in it (e.g. how clean a river is)."@en ;
    skos:prefLabel "biotic index"@en .

<http://www.eionet.europa.eu/gemet/concept/11787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Substance that can undergo a chemical reaction with oxygen."@en ;
    skos:prefLabel "oxidisable material"@en .

<http://www.eionet.europa.eu/gemet/concept/11788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "The amount of oxygen dissolved in a stream, river or lake is an indication of the degree of health of the stream and its ability to support a balanced aquatic ecosystem. The oxygen comes from the atmosphere by solution and from photosynthesis of water plants. The maximum amount of oxygen that can be held in solution in a stream is termed the saturation concentration and, as it is a function of temperature, the greater the temperature, the less the saturation amount. The discharge of an organic waste to a stream imposes an oxygen demand on the stream. If there is an excessive amount of organic matter, the oxidation of waste by microorganisms will consume oxygen more rapidly than it can be replenished. When this happens, the dissolved oxygen is depleted and results in the death of the higher forms of life."@en ;
    skos:prefLabel "dissolved oxygen"@en .

<http://www.eionet.europa.eu/gemet/concept/11789> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6201> ;
    skos:definition "The capability of being decomposed by prolonged exposure to light."@en ;
    skos:prefLabel "photodegradation"@en .

<http://www.eionet.europa.eu/gemet/concept/11791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Substance incapable of forming a solution, especially in water."@en ;
    skos:prefLabel "insoluble substance"@en .

<http://www.eionet.europa.eu/gemet/concept/11792> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Substance that is not capable of changing from a solid or liquid form to a vapour."@en ;
    skos:prefLabel "non-volatile substance"@en .

<http://www.eionet.europa.eu/gemet/concept/11793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "A substance that is not easily converted to another, usually less complex compound."@en ;
    skos:prefLabel "weakly degradable substance"@en .

<http://www.eionet.europa.eu/gemet/concept/11795> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The tendency of a metal to wear away another by chemical attack."@en ;
    skos:prefLabel "chemical corrosivity"@en .

<http://www.eionet.europa.eu/gemet/concept/1180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3872> ;
    skos:definition "The ability or tendency of a substance or physical agent to cause or produce cancer."@en ;
    skos:prefLabel "carcinogenicity"@en .

<http://www.eionet.europa.eu/gemet/concept/11807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Study based on experimentation."@en ;
    skos:prefLabel "experimental study"@en .

<http://www.eionet.europa.eu/gemet/concept/11809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11798>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition """1) The determination of the different grain size in a granular material.
2) The proportion by weight of particles of different sizes in granular material."""@en ;
    skos:prefLabel "granulometry"@en .

<http://www.eionet.europa.eu/gemet/concept/1181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "Test for assessing if a chemical or physical agent increases the risk of cancer. The three major ways of testing for carcinogens are animals tests, epidemiological studies and bacterial tests."@en ;
    skos:prefLabel "carcinogenicity test"@en .

<http://www.eionet.europa.eu/gemet/concept/11812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:definition "To cause to discharge from an abscess or wound or to obtain a sample of tissue or organic liquid for examination."@en ;
    skos:prefLabel "drawing"@en .

<http://www.eionet.europa.eu/gemet/concept/11814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3854> ;
    skos:definition "Material having the ability to generate a sufficient concentration of combustible vapors to produce a flame, if ignited."@en ;
    skos:prefLabel "flammable product"@en .

<http://www.eionet.europa.eu/gemet/concept/1182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "A substance that causes cancer in humans and animals."@en ;
    skos:prefLabel "carcinogen"@en .

<http://www.eionet.europa.eu/gemet/concept/11835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The system that is concerned with the perception of sound, is mediated through the organ of Corti of the ear in mammals or through corresponding sensory receptors of the lagena in lower vertebrates, is normally sensitive in man to sound vibrations between 16 and 27.000 cycles per second but most receptive to those between 2.000 and 5.000 cycles per second, is conducted centrally by the cochlear branch of the auditory nerve, and is coordinated especially in the medial geniculate body."@en ;
    skos:prefLabel "hearing system"@en .

<http://www.eionet.europa.eu/gemet/concept/11836> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "Those structures, including the heart and blood vessels, which provide channels for the flow of blood."@en ;
    skos:prefLabel "cardiovascular system"@en .

<http://www.eionet.europa.eu/gemet/concept/1184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The study of the heart."@en ;
    skos:prefLabel "cardiology"@en .

<http://www.eionet.europa.eu/gemet/concept/1185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "cardiovascular disease"@en .

<http://www.eionet.europa.eu/gemet/concept/11852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233>,
        <http://www.eionet.europa.eu/gemet/concept/8976> ;
    skos:definition "Any of a subgroup of the picornaviruses infecting the gastrointestinal tract and discharged in feces, including coxsackieviruses, echoviruses, and polioviruses; may be involved in respiratory disease, meningitis, and neurological disease."@en ;
    skos:prefLabel "enterovirus"@en .

<http://www.eionet.europa.eu/gemet/concept/11868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The scientific study of the natural processes of animals."@en ;
    skos:prefLabel "animal biology"@en .

<http://www.eionet.europa.eu/gemet/concept/11869> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The scientific study of the natural processes of plants."@en ;
    skos:prefLabel "plant biology"@en .

<http://www.eionet.europa.eu/gemet/concept/11875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3620> ;
    skos:definition "The total number of genes or the amount of genetic information possessed by all the reproductive members of a population of sexually reproducing organisms."@en ;
    skos:prefLabel "genetic pool"@en .

<http://www.eionet.europa.eu/gemet/concept/11879> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3887> ;
    skos:definition "Effectiveness of hearing."@en ;
    skos:prefLabel "hearing acuity"@en .

<http://www.eionet.europa.eu/gemet/concept/11889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:definition "A unit used to express relative difference on power, usually between acoustic or electric signals, equal to ten times the common logarithm of the ratio of the two level."@en ;
    skos:prefLabel "decibel"@en .

<http://www.eionet.europa.eu/gemet/concept/11896> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The characteristics of a confined space that determines its ability to enable music and speech to be heard clearly within it."@en ;
    skos:prefLabel "acoustical quality"@en .

<http://www.eionet.europa.eu/gemet/concept/1190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:definition "A geographical region bordered on the south by South America and Panama, and on the west by Central America, and consisting of the West Indian, and nearby, islands and the Caribbean Sea, a part of the western Atlantic Ocean."@en ;
    skos:prefLabel "Caribbean Area"@en .

<http://www.eionet.europa.eu/gemet/concept/11909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803>,
        <http://www.eionet.europa.eu/gemet/concept/5624> ;
    skos:definition "The range of frequencies occurring in the noise emitted by a source."@en ;
    skos:prefLabel "noise spectrum"@en .

<http://www.eionet.europa.eu/gemet/concept/11912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8959> ;
    skos:definition "A motion, usually unintentional and often undesirable, of parts of machines and structures."@en ;
    skos:prefLabel "mechanical vibration"@en .

<http://www.eionet.europa.eu/gemet/concept/11921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Noise coming from source other than the noise source being monitored."@en ;
    skos:prefLabel "background noise"@en .

<http://www.eionet.europa.eu/gemet/concept/11922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Deeply resounding, reverberating noise caused by the friction between car tyres and road surfaces."@en ;
    skos:prefLabel "rolling noise"@en .

<http://www.eionet.europa.eu/gemet/concept/11923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "General noise from a local source (such as the noise of a factory) which is disturbing to people living in the area."@en ;
    skos:prefLabel "neighbourhood noise"@en .

<http://www.eionet.europa.eu/gemet/concept/11927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3877> ;
    skos:prefLabel "acoustic comfort"@en .

<http://www.eionet.europa.eu/gemet/concept/11930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method to prevent the effects of being subjected to loud or harsh sounds."@en ;
    skos:prefLabel "noise exposure plan"@en .

<http://www.eionet.europa.eu/gemet/concept/11958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power station where the generation of power is provided by the ebb and flow of the tides. The principle is that water collected at high tide behind a barrage is released at low tide to turn a turbine that, in turn, drives a generator."@en ;
    skos:prefLabel "tidal power station"@en .

<http://www.eionet.europa.eu/gemet/concept/11967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/4122> ;
    skos:definition "The free renewable source of energy provided by falling water that drives the turbines. Hydropower is the most important of the regenerable energy sources because of its highest efficiency at the energy conversion. There are two types of hydroelectric power plants: a) run-of-river power plants for the use of affluent water; b) storage power plants (power stations with reservoir) where the influx can be regulated with the help of a reservoir. Mostly greater differences in altitudes are being used, like mountain creeks. Power stations with reservoirs are generally marked by barrages with earth fill dam or concrete dams. Though hydropower generally can be called environmentally acceptable, there exist also some problems: a) change of groundwater level and fill up of the river bed with rubble. b) Risk of dam breaks. c) Great demand for land space for the reservoir. d) Diminution, but partly also increase of value of recreation areas. As the hydropowers of the world are limited, the world energy demand however is rising, finally the share of hydropower will decrease."@en ;
    skos:prefLabel "hydroelectric energy"@en .

<http://www.eionet.europa.eu/gemet/concept/11974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power station of small size for the generation of energy at local level."@en ;
    skos:prefLabel "small power station"@en .

<http://www.eionet.europa.eu/gemet/concept/11975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5258> ;
    skos:definition "A mill whose power is provided by a large wheel which is turned by moving water, especially a river."@en ;
    skos:prefLabel "water mill"@en .

<http://www.eionet.europa.eu/gemet/concept/1199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6459> ;
    skos:definition "Effect caused by the successive passages of polluting substances through the different organisms of a food chain."@en ;
    skos:prefLabel "carry-over effect"@en .

<http://www.eionet.europa.eu/gemet/concept/11990> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4040>,
        <http://www.eionet.europa.eu/gemet/concept/7185> ;
    skos:definition "The process by which a power plant is finally taken out of operation."@en ;
    skos:prefLabel "power station derating"@en .

<http://www.eionet.europa.eu/gemet/concept/120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7930> ;
    skos:definition "The physical or chemical bonding of molecules of gas, liquid or a dissolved substance to the external surface of a solid or the internal surface, if the material is porous, in a very thin layer."@en ;
    skos:prefLabel "adsorption"@en .

<http://www.eionet.europa.eu/gemet/concept/1200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The making of maps and charts for the purpose of visualizing spatial distributions over various areas of the earth."@en ;
    skos:prefLabel "cartography"@en .

<http://www.eionet.europa.eu/gemet/concept/12006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5742> ;
    skos:definition "Nuclear reactor which produces more fissile material than it consumes, using fast-moving neutrons and making plutonium-239 from uranium-238, thereby increasing the reactor's efficiency."@en ;
    skos:prefLabel "fast reactor"@en .

<http://www.eionet.europa.eu/gemet/concept/12007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12783> ;
    skos:definition "Any site or region that is damaged, harmed or made unfit for use by the introduction of unwanted substances, particularly microorganisms, chemicals, toxic and radioactive materials and wastes."@en ;
    skos:prefLabel "contaminated area"@en .

<http://www.eionet.europa.eu/gemet/concept/1201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8731> ;
    skos:definition "A rubber ring placed over the rim of a wheel of a road vehicle to provide traction and reduce road shocks, especially a hollow inflated ring consisting of a reinforced outer casing enclosing an inner tube."@en ;
    skos:prefLabel "car tyre"@en .

<http://www.eionet.europa.eu/gemet/concept/12017> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/298> ;
    skos:definition "A colorless liquid, miscible with water, used as a reagent and solvent. Also known as alcohol; ethyl alcohol; grain alcohol."@en ;
    skos:prefLabel "ethanol"@en .

<http://www.eionet.europa.eu/gemet/concept/12022> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution caused by gases vented to the atmosphere by internal-combustion-engine driven vehicles."@en ;
    skos:prefLabel "motor vehicle pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/12026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3110> ;
    skos:definition "The sedimentation of dust or fine particles from the atmosphere."@en ;
    skos:prefLabel "atmospheric fallout"@en .

<http://www.eionet.europa.eu/gemet/concept/12027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1148> ;
    skos:definition "Vehicles that function without emitting pollutants in the atmosphere."@en ;
    skos:prefLabel "clean air car"@en .

<http://www.eionet.europa.eu/gemet/concept/1203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:definition "Crops that are grown for sale in the town markets or for export. They include coffee, cocoa, sugar, vegetables, peanuts and non-foods, like tobacco and cotton. Huge areas of countries in the developing world have been turned over to cash crops. Those countries with no mineral or oil resources depend on cash crops for foreign money, so that they can import materials do develop roads, for construction, or to buy Western consumer goods and, indeed, food. However, critics argue that cash crops are planted on land that would otherwise be used to grow food for the local community and say this is a cause of world famine. Cash crops, such as peanuts, can ruin the land if it is not left fallow after six years of harvests. Moreover, if the best agricultural land is used for cash crops, local farmers are forced to use marginal land to grow food for local consumption, and this has a further dramatic effect on the environment."@en ;
    skos:prefLabel "cash crop"@en .

<http://www.eionet.europa.eu/gemet/concept/12045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1479> ;
    skos:definition "The study of paleoclimates throughout geologic time, and of the causes of their variations, on either a local or a worldwide basis. It involves the interpretation of glacial deposits, fossils and sedimentologic and other types of data."@en ;
    skos:prefLabel "palaeoclimatology"@en .

<http://www.eionet.europa.eu/gemet/concept/12061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "A climate type which is characterized by insufficient moisture to support appreciable plant life; that is, a climate of extreme aridity."@en ;
    skos:prefLabel "desert climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "Climate characterized by constant temperatures, abundant rainfall and a very short dry season."@en ;
    skos:prefLabel "equatorial climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12066> ;
    skos:definition "A type of climate characterized by hot, dry, sunny summers and a winter rainy season; basically, this is the opposite of a monsoon climate. Also known as etesian climate."@en ;
    skos:prefLabel "Mediterranean climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12060> ;
    skos:definition "Very generally, the climate of relatively high elevations; mountain climates are distinguished by the departure of their characteristics from those of surrounding lowlands, and the one common basis for this distinction is that of atmospheric rarefaction; aside from this, great variety is introduced by differences in latitude, elevation, and exposure to the sun; thus, there exists no single, clearly defined, mountain climate. Also known as highland climate."@en ;
    skos:prefLabel "mountain climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "A regional climate which is under the predominant influence of the sea, that is, a climate characterized by oceanity; the antithesis of a continental climate."@en ;
    skos:prefLabel "oceanic climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "A climate which is typical of equatorial and tropical regions, that is, one with continually high temperatures and with considerable precipitation, at least during part of the year."@en ;
    skos:prefLabel "tropical climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A temperature inversion in the atmosphere in which the temperature, instead of falling, increases with height above the ground. With the colder and heavier air below, there is no tendency to form upward currents and turbulence is suppressed. Inversions are often formed in the late afternoon when the radiation emitted from the ground exceeds that received from the sinking sun. Inversions are also caused by katabatic winds, that is cold winds flowing down the hillside into a valley, and by anticyclones. In inversion layers, both vertical and horizontal diffusion is inhibited and pollutants become trapped, sometimes for long periods. Low-level discharges of pollutants are more readily trapped by inversions than high level dischargers, hence the case for high stacks. Furthermore, high level discharges into an inversion tend to remain at a high level because of the absence of vertical mixing."@en ;
    skos:prefLabel "atmospheric inversion"@en .

<http://www.eionet.europa.eu/gemet/concept/12084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8115> ;
    skos:definition "A storm caused by strong rising air currents and characterized by thunder and lightning and usually heavy rain or hail."@en ;
    skos:prefLabel "thunderstorm"@en .

<http://www.eionet.europa.eu/gemet/concept/1209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "A phenomenon in which a relatively small amount of substance augments the rate of a chemical reaction without itself being consumed."@en ;
    skos:prefLabel "catalysis"@en .

<http://www.eionet.europa.eu/gemet/concept/12091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A coating of ice, generally clear and smooth but usually containing some air pockets, formed on exposed objects by the freezing of a film of supercooled water deposited by rain, drizzle, or fog, or possibly condensed from supercooled water vapour."@en ;
    skos:prefLabel "glaze"@en .

<http://www.eionet.europa.eu/gemet/concept/12096> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7172> ;
    skos:definition "The process of extracting underground water from a source."@en ;
    skos:prefLabel "exploitation of underground water"@en .

<http://www.eionet.europa.eu/gemet/concept/12098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4291> ;
    skos:definition "The movement of surface water into soil or rock through cracks and pores."@en ;
    skos:prefLabel "water infiltration into the ground"@en .

<http://www.eionet.europa.eu/gemet/concept/121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:definition "A person who is fully grown, developed or of a specified age."@en ;
    skos:prefLabel "adult"@en .

<http://www.eionet.europa.eu/gemet/concept/12104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:definition "Water that occupies pores, cavities, cracks and other spaces in the crustal rocks. It includes water precipitated from the atmosphere which has percolated through the soil, water that has risen from deep magmatic sources liberated during igneous activity and fossil water retained in sedimentary rocks since their formation. The presence of groundwater is necessary for virtually all weathering processes to operate. Phreatic water is synonymous with groundwater and is the most important source of any water supply."@en ;
    skos:prefLabel "water table"@en .

<http://www.eionet.europa.eu/gemet/concept/12108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12107> ;
    skos:definition "Water table is inherently susceptible to contamination from landuse activities. Remediation is very expensive and often impractical. Prevention of contamination is therefore critical in effective groundwater management."@en ;
    skos:prefLabel "water table protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1210> ;
    skos:definition "Catalytic converters are designed to clean up the exhaust fumes from petrol-driven vehicles, which are otherwise the major threat to air quality standards in congested urban streets and on motorways. Converters remove carbon monoxide, the unburned hydrocarbons and the oxides of nitrogen. These compounds are damaging to human health and the environment in a variety of ways. The converter is attached to the vehicle' s exhaust near the engine. Exhaust gases pass through the cellular ceramic substrate, a honeycomb-like filter. While compact, the intricate honeycomb structure provides a surface area of 23.000 square metres. This is coated with a thin layer of platinum, palladium and rhodium metals, which act as catalysts that simulate a reaction to changes in the chemical composition of the gases. Platinum and palladium convert hydrocarbons and carbon monoxide into carbon dioxide and water vapour. Rhodium changes nitrogen oxides and hydrocarbons into nitrogen and water, which are harmless."@en ;
    skos:prefLabel "catalytic converter"@en .

<http://www.eionet.europa.eu/gemet/concept/12122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "The total quantity of water flowing from the catchment during the period of the flood."@en ;
    skos:prefLabel "flood runoff"@en .

<http://www.eionet.europa.eu/gemet/concept/12123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The filling or partial filling with silt of a reservoir that receives fine-grained sediment brought in by streams and surface runoff."@en ;
    skos:prefLabel "silting up"@en .

<http://www.eionet.europa.eu/gemet/concept/12128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9231> ;
    skos:definition "The science and technology of measuring specific gravities, particularly of liquids."@en ;
    skos:prefLabel "hydrometry"@en .

<http://www.eionet.europa.eu/gemet/concept/12131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "The hydrological processes generating river floods have been studied extensively and several modelling concepts have been proposed. The standard procedure for flood forecasting consists of calibrating the parameters of the model of a particular river basin on a representative set of historical hydrometric data and subsequently applying this calibrated model in a real-time environment."@en ;
    skos:prefLabel "flood forecast"@en .

<http://www.eionet.europa.eu/gemet/concept/12135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The configuration or arrangement in plan view of the natural stream courses in an area. It is related to local geologic and geomorphologic features and history. Synonym: drainage pattern."@en ;
    skos:prefLabel "hydrographic network"@en .

<http://www.eionet.europa.eu/gemet/concept/12139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The scientific study of sedimentary rocks and of the processes by which they were formed; the description, classification, origin, and interpretation of sediments."@en ;
    skos:prefLabel "sedimentology"@en .

<http://www.eionet.europa.eu/gemet/concept/1215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145> ;
    skos:definition """1) An area from which surface runoff is carried away by a single drainage system.
2) The area of land bounded by watersheds draining into a river, basin or reservoir."""@en ;
    skos:prefLabel "catchment area"@en .

<http://www.eionet.europa.eu/gemet/concept/12151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/740> ;
    skos:definition "Freshwater in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters."@en ;
    skos:prefLabel "bathing freshwater"@en .

<http://www.eionet.europa.eu/gemet/concept/12152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "A body of water that is owned and maintained by a national governmental body or agency."@en ;
    skos:prefLabel "demesnial water"@en .

<http://www.eionet.europa.eu/gemet/concept/12153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "A body of water that is owned and maintained by an individual or entity other than the national government."@en ;
    skos:prefLabel "non-demesnial water"@en .

<http://www.eionet.europa.eu/gemet/concept/12161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "A commonly used term in Scotland and Ireland for a stretch waterlogged, spongy ground, chiefly composed of decaying vegetable matter, especially of rushes, cotton grass, and sphagnum moss."@en ;
    skos:prefLabel "bog"@en .

<http://www.eionet.europa.eu/gemet/concept/12166> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/740> ;
    skos:definition "Sea waters in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters."@en ;
    skos:prefLabel "bathing seawater"@en .

<http://www.eionet.europa.eu/gemet/concept/12170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8766> ;
    skos:definition "The mouth or outlet of a river, drain, sewer or any other place at which drainage or wastewater is discharged into a body of oceanic water."@en ;
    skos:prefLabel "ocean outfall"@en .

<http://www.eionet.europa.eu/gemet/concept/12174> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7502> ;
    skos:definition "A regular movement of marine waves created by wind stress in the open ocean which travels considerable distances away from the generating field and into another wind field. The waves are characterized by relatively smooth, generally unbroken, crests and a fairly regular wavelength, but swell increases in wavelength and decreases in wave height as it moves away from the generating area. Local wind waves may be superimposed upon swell waves as they approach a coastline, thereby creating sharper crests and a choppy sea."@en ;
    skos:prefLabel "swell"@en .

<http://www.eionet.europa.eu/gemet/concept/12183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1523> ;
    skos:definition "Contamination of the generally broad portion of a stream near its outlet which is influenced by the tide of the water body into which it flows. Many estuaries have become badly contaminated by wastes that have been generated from heavily populated areas."@en ;
    skos:prefLabel "estuary pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/12189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10058> ;
    skos:definition "The administration or handling of a waterway or a stream of flowing water."@en ;
    skos:prefLabel "river management"@en .

<http://www.eionet.europa.eu/gemet/concept/12198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Removing lodged deposits of rock fragments and other debris by water flow at high velocity; used to clean water conduits and drilled boreholes."@en ;
    skos:prefLabel "flushing"@en .

<http://www.eionet.europa.eu/gemet/concept/12199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9254> ;
    skos:definition "A chamber with gates on both ends connecting two sections of a canal or other waterway, to raise or lower the water level in each section."@en ;
    skos:prefLabel "canal lock"@en .

<http://www.eionet.europa.eu/gemet/concept/122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Any instruction or training, informal or formal, which is geared to persons of mature age, regardless of previous education, and typically offered by university extension programs, employers, correspondence courses or community groups."@en ;
    skos:prefLabel "adult education"@en .

<http://www.eionet.europa.eu/gemet/concept/1220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "The yield obtained from a given fishery; fishery catches should be strictly controlled so that the fish population can have a sufficient breeding mass and thus give a sustained yield for future generations."@en ;
    skos:prefLabel "catch yield"@en .

<http://www.eionet.europa.eu/gemet/concept/12202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "Cutting down by scythe or machine at intervals the vegetation growth and grasses on banks and berms of irrigation and drainage channels or cropped areas."@en ;
    skos:prefLabel "water weed cutting"@en .

<http://www.eionet.europa.eu/gemet/concept/12204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10238> ;
    skos:definition "Engineering work which aims at the protection of banks of a river, or slopes of embankments along it, from erosion by the current of flow, from floods, etc."@en ;
    skos:prefLabel "bank protection"@en .

<http://www.eionet.europa.eu/gemet/concept/12210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7138> ;
    skos:definition "Basin used to hold water in storage."@en ;
    skos:prefLabel "retaining reservoir"@en .

<http://www.eionet.europa.eu/gemet/concept/12213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The drawing of water from a reservoir by means of draining pipes located at the bottom of the basin and controlled by a system of sluices which ensure, if necessary, the emptying of the basin in a given period of time in respect of downstream conditions."@en ;
    skos:prefLabel "dam draining"@en .

<http://www.eionet.europa.eu/gemet/concept/12214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Complex series of reactions between the water and metal surfaces and materials in which the water is stored or transported. The corrosion process is an oxidation/reduction reaction that returns refined or processed metal to their more stable ore state. With respect to the corrosion potential of drinking water, the primary concerns include the potential presence of toxic metals , such as lead and copper."@en ;
    skos:prefLabel "water corrosivity"@en .

<http://www.eionet.europa.eu/gemet/concept/12215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9216> ;
    skos:definition "Progress in, or betterment of, the environmental condition and integrity of water."@en ;
    skos:prefLabel "water quality improvement"@en .

<http://www.eionet.europa.eu/gemet/concept/12216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11816> ;
    skos:definition "Taste in water can be caused by foreign matter, such as organic compounds, inorganic salts or dissolved gases. These materials may come from domestic, agricultural or natural sources. Some substances found naturally in groundwater, while not necessarily harmful, may impart a disagreeable taste or undesirable property to the water. Magnesium sulphate, sodium sulphate, and sodium chloride are but a few of these. Acceptable waters should be free from any objectionable taste at point of use."@en ;
    skos:prefLabel "water taste"@en .

<http://www.eionet.europa.eu/gemet/concept/12219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/303> ;
    skos:definition "A proliferation of a marine green plankton toxic and often fatal to fish, perhaps stimulated by the addition of nutrients."@en ;
    skos:prefLabel "green tide"@en .

<http://www.eionet.europa.eu/gemet/concept/12220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition "Matter suspended in a fluid by the upward components of turbulent currents or by colloidal suspension."@en ;
    skos:prefLabel "suspended matter"@en .

<http://www.eionet.europa.eu/gemet/concept/12226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7390> ;
    skos:definition "The degree of dissolved salts in water measured by weight in parts per thousand."@en ;
    skos:prefLabel "water salinity"@en .

<http://www.eionet.europa.eu/gemet/concept/12231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "A structure in which water is collected."@en ;
    skos:prefLabel "catchment"@en .

<http://www.eionet.europa.eu/gemet/concept/1224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4493> ;
    skos:definition "A positively charged atom or group of atoms, or a radical which moves to the negative pole (cathode) during electrolysis."@en ;
    skos:prefLabel "cation"@en .

<http://www.eionet.europa.eu/gemet/concept/12240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "A stream of water that is forced up into the air through a small hole, especially for decorative effect or the structure in a lake or pool from which this flows."@en ;
    skos:prefLabel "fountain"@en .

<http://www.eionet.europa.eu/gemet/concept/12248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124>,
        <http://www.eionet.europa.eu/gemet/concept/9232> ;
    skos:definition "Artificial or natural area of water, used for storing water for domestic or industrial use."@en ;
    skos:prefLabel "water reservoir"@en .

<http://www.eionet.europa.eu/gemet/concept/12254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "The removal of minerals from water by chemical, ion-exchange, or distillation procedures."@en ;
    skos:prefLabel "water demineralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/12259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "A process in which used or spent water is treated at the point of origin or where it was produced, by using a septic tank or some other system to remove or reduce  the impact of constituent wastes on human health and the environment."@en ;
    skos:prefLabel "on-site waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:prefLabel "collective waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Basin used to hold water which falls as rain during a storm."@en ;
    skos:prefLabel "storm water basin"@en .

<http://www.eionet.europa.eu/gemet/concept/12273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:definition "Channels for clearing away rain water."@en ;
    skos:prefLabel "rain water sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:definition "Sewer system having distinct pipes for collecting superficial water and sewage water."@en ;
    skos:prefLabel "separate sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7641> ;
    skos:definition "A sewer intended to serve as a sanitary sewer and a storm sewer, or as an industrial sewer and a storm sewer."@en ;
    skos:prefLabel "combined sewer system"@en .

<http://www.eionet.europa.eu/gemet/concept/12277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/132>,
        <http://www.eionet.europa.eu/gemet/concept/9143>,
        <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "Addition of air to sewage or water so as to raise its dissolved oxygen level."@en ;
    skos:prefLabel "water aeration"@en .

<http://www.eionet.europa.eu/gemet/concept/12278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "The process of using a natural system or mechanical device to collect, treat and discharge or reclaim wastewater from an individual dwelling without the use of community-wide sewers or a centralised treatment facility."@en ;
    skos:prefLabel "individual waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "A basin in which suspended matter is removed either by quiescent settlement or by continuous flow at high velocity and extended retention time to allow deposition."@en ;
    skos:prefLabel "sedimentation basin"@en .

<http://www.eionet.europa.eu/gemet/concept/12280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3184> ;
    skos:definition "A system of secondary sewage treatment which is similar to self-purification action of streams; it is more accurately a biological oxidizing bed; the effluent is placed on the stones in the bed and microorganisms present consume the solids as a food supply."@en ;
    skos:prefLabel "trickling filter"@en .

<http://www.eionet.europa.eu/gemet/concept/12283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Wastewater or utilized water from a home, community, farm or industry, which is often discharged after utilization."@en ;
    skos:prefLabel "used water"@en .

<http://www.eionet.europa.eu/gemet/concept/12285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2571> ;
    skos:definition "Partially or completely treated water or waste water flowing out of a waste treatment plant."@en ;
    skos:prefLabel "waste treatment effluent"@en .

<http://www.eionet.europa.eu/gemet/concept/12287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "Types of wastewater treatment in which biochemical or bacterial action is intensified to oxidize and stabilize the unstable organic matter present. Examples of this type of treatment use intermittent sand filters, trickling filters, and activated sludge processes and sludge digestion."@en ;
    skos:prefLabel "biological waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The process in which sunlight, bacterial action and oxygen cause self-purification in waste water, Usually taking place in a shallow pond, or system of such ponds."@en ;
    skos:prefLabel "lagooning"@en .

<http://www.eionet.europa.eu/gemet/concept/1229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6623> ;
    skos:definition "Principle connected with the precautionary principle: it means that, if there are strong reasons for expecting serious or irreversible damage to the environment following a given project, lack of full scientific certainty should not be used as a reason for postponing cost-effective measures to prevent environmental degradation. Critics of this approach are concerned about large commitments of resources to deal with vaguely defined problems."@en ;
    skos:prefLabel "cause for concern principle"@en .

<http://www.eionet.europa.eu/gemet/concept/12293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143>,
        <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "A process in which naturally occurring microorganisms, plants, trees or geophysical processes break down, degrade or filter out hazardous substances or pollutants from a body of water, cleansing and treating contaminated water without human intervention."@en ;
    skos:prefLabel "water regeneration"@en .

<http://www.eionet.europa.eu/gemet/concept/12301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "Measures and activities concerning the supply of water, the improvement of efficiency in its use, the reduction of losses and waste, water-saving practices to reduce costs and to slow the depletion of the water supply to ensure future water availability."@en ;
    skos:prefLabel "water resources management"@en .

<http://www.eionet.europa.eu/gemet/concept/1231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition """1) An underground hollow with access from the ground surface or from the sea, often found in limestone areas and on rocky coastlines.
2) A natural cavity, chamber or recess which leads beneath the surface of the earth, generally in a horizontal or obliquely inclined direction. It may be in the form of a passage or a gallery, its shape depending in part on the joint pattern or structure of the rock and partly on the type of process involved in its excavation. Thus, caves worn by subterranean rivers may be different in character from, and of considerably greater extent than, a sea-cave eroded by marine waves.
3) A natural underground open space, generally with a connection to the surface and large enough for a person to enter. The most common type of cave is formed in a limestone by dissolution."""@en ;
    skos:prefLabel "cave"@en .

<http://www.eionet.europa.eu/gemet/concept/12318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "Centralized recycling centres to which waste materials are brought and where they are separated."@en ;
    skos:prefLabel "waste sorting unit"@en .

<http://www.eionet.europa.eu/gemet/concept/12321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Area where waste material, especially metal, is dumped."@en ;
    skos:prefLabel "scrap dump"@en .

<http://www.eionet.europa.eu/gemet/concept/12325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the transformation of solid waste into useful products."@en ;
    skos:prefLabel "reclamation industry"@en .

<http://www.eionet.europa.eu/gemet/concept/12341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9125> ;
    skos:prefLabel "use of waste as energy source"@en .

<http://www.eionet.europa.eu/gemet/concept/12342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9125> ;
    skos:prefLabel "use of waste as material"@en .

<http://www.eionet.europa.eu/gemet/concept/12349> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13722> ;
    skos:definition "The process of removing dirt, litter or other unsightly materials from shore line property or surrounding areas."@en ;
    skos:prefLabel "beach cleansing"@en .

<http://www.eionet.europa.eu/gemet/concept/12357> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Large items of waste material, such as appliances, furniture, large auto parts, trees, branches, stumps, etc."@en ;
    skos:prefLabel "bulky waste"@en .

<http://www.eionet.europa.eu/gemet/concept/12366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/745> ;
    skos:definition "A primary cell that uses an alkaline electrolyte, usually potassium hydroxide, and delivers about 1.5 volts at much higher current rates than the common carbon-zinc cell. Also known as alkaline-manganese cell."@en ;
    skos:prefLabel "alkaline battery"@en .

<http://www.eionet.europa.eu/gemet/concept/12367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/745> ;
    skos:definition "A direct-current voltage source made up of one or more units that convert chemical, thermal, nuclear, or solar energy into electrical energy."@en ;
    skos:prefLabel "electric battery"@en .

<http://www.eionet.europa.eu/gemet/concept/12381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4273> ;
    skos:definition "Discarded material produced in any industrial process for which there is no specified mode of disposal."@en ;
    skos:prefLabel "special industrial waste"@en .

<http://www.eionet.europa.eu/gemet/concept/12382> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Metal material discarded during manufacturing or processing operations which cannot be directly fed back into the operation; Worn or discarded metal materials removed from service at the end of its useful life."@en ;
    skos:prefLabel "metal waste"@en .

<http://www.eionet.europa.eu/gemet/concept/12383> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste material resulting from ore extraction that is usually left on the soil surface."@en ;
    skos:prefLabel "mineral waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The microscopic functional and structural unit of all living organisms, consisting of a nucleus, cytoplasm, and a limiting membrane."@en ;
    skos:prefLabel "cell (biology)"@en .

<http://www.eionet.europa.eu/gemet/concept/12390> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "The hulk of a wrecked or stranded ship; a ship dashed against rocks or land and broken or otherwise rendered useless."@en ;
    skos:prefLabel "wreck"@en .

<http://www.eionet.europa.eu/gemet/concept/12394> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4934> ;
    skos:definition "Oil which derives from petroleum and is made up of hydrocarbons."@en ;
    skos:prefLabel "mineral oil"@en .

<http://www.eionet.europa.eu/gemet/concept/12395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4845> ;
    skos:definition "The watery liquid that separates from the curd when the milk is clotted, as in making cheese."@en ;
    skos:prefLabel "whey"@en .

<http://www.eionet.europa.eu/gemet/concept/1242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/745> ;
    skos:definition "The basic building block of a battery. It is an electrochemical device consisting of an anode and a cathode in a common electrolyte kept apart with a separator. This assembly may be used in its own container as a single cell battery or be combined and interconnected with other cells in a container to form a multicelled battery."@en ;
    skos:prefLabel "cell (energy)"@en .

<http://www.eionet.europa.eu/gemet/concept/12429> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7156> ;
    skos:definition "Dust or other residue left after reducing a material to very small particles."@en ;
    skos:prefLabel "residue of grinding"@en .

<http://www.eionet.europa.eu/gemet/concept/12430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7156> ;
    skos:definition "Material left over from the treatment of any type of waste."@en ;
    skos:prefLabel "treatment residue"@en .

<http://www.eionet.europa.eu/gemet/concept/12431> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15323>,
        <http://www.eionet.europa.eu/gemet/concept/15325>,
        <http://www.eionet.europa.eu/gemet/concept/1584> ;
    skos:definition "Any material, solid or semisolid, left after processing in a device designed to reduce waste volume by combustion."@en ;
    skos:prefLabel "incineration residue"@en .

<http://www.eionet.europa.eu/gemet/concept/12435> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:prefLabel "clearing sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/12436> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:definition "Sludge whose water content has been reduced by physical means."@en ;
    skos:prefLabel "dehydrated sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/1244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9358> ;
    skos:definition "The main polysaccharide in living plants, forming the skeletal structure of the plant cell wall; a polymer of beta-D-glucose linked together with the elimination of water to form chains of 2000-4000 units."@en ;
    skos:prefLabel "cellulose"@en .

<http://www.eionet.europa.eu/gemet/concept/12441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:definition "The excess, unusable semi-solids or sediment resulting from a wastewater treatment or industrial process."@en ;
    skos:prefLabel "residual waste sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/12444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7740> ;
    skos:definition "Any process beyond gravity sedimentation that increases the concentration of solids in sludge with or without the use of chemical flocculants."@en ;
    skos:prefLabel "thickening"@en .

<http://www.eionet.europa.eu/gemet/concept/12446> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7740> ;
    skos:definition "Usually anaerobic sludge digestion, a treatment that stabilizes raw sludge. Fully digested sludge has little readily biodegradable organic matter. It is not smelly and about 50% of the solids are inorganic. Sludge can also be digested aerobically."@en ;
    skos:prefLabel "sludge stabilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8486> ;
    skos:prefLabel "cellulose industry"@en .

<http://www.eionet.europa.eu/gemet/concept/12450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10099> ;
    skos:definition "Operations, functions and processes involved in industrial production."@en ;
    skos:prefLabel "industrial activity"@en .

<http://www.eionet.europa.eu/gemet/concept/12456> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4213> ;
    skos:definition "Area of land which is no longer usable for cultivation or for any other purpose after having been the site of an industrial plant."@en ;
    skos:prefLabel "industrial wasteland"@en .

<http://www.eionet.europa.eu/gemet/concept/12459> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "Facility that is forbidden to be disclosed outside a specified ring of secrecy for reasons of national security."@en ;
    skos:prefLabel "classified facility"@en .

<http://www.eionet.europa.eu/gemet/concept/12471> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The act of dismembering the carcass of an animal with the production of organic waste which if improperly disposed cause problems of pollution and fawl smells."@en ;
    skos:prefLabel "quartering"@en .

<http://www.eionet.europa.eu/gemet/concept/12476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8037> ;
    skos:definition "A place where pigs are kept and reared."@en ;
    skos:prefLabel "piggery"@en .

<http://www.eionet.europa.eu/gemet/concept/12482> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The petroleum industry is a complex industry utilizing complex combination of interdependent operations engaged in the storage and transportation, separation of crude molecular constituents, molecular cracking, molecular rebuilding and solvent finishing to produce petrochemical products. Treatment may involve oil separation, precipitation, adsorption, and biological treatment. The refining operations can be divided into four major steps: separation, conversion, treating, and blending. The crude oil is first separated into selected fractions (gasoline, kerosine, fuel oil, etc.). Some of the less valuable products such as heavy naphtha, are converted to products with a greater sale value such as gasoline. The final step is the blending of the refined base stocks with each other and various additive to meet final product specifications. The major pollutants emitted are sulphur oxides, nitrogen oxides, hydrocarbons, carbon monoxide, and malodorous materials."@en ;
    skos:prefLabel "oil production (chain)"@en .

<http://www.eionet.europa.eu/gemet/concept/12485> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3516> ;
    skos:definition "A container or a reservoir for the storage of hydrocarbons."@en ;
    skos:prefLabel "hydrocarbon storage tank"@en .

<http://www.eionet.europa.eu/gemet/concept/1249> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1248> ;
    skos:definition "Cement is produced by heating a mixture of clay or shale plus chalk or lime in a rotary kiln up to 250 m long per 8 m diameter rotating at 1 rpm. The process can be wet, semi-dry or dry and the fuel can be pulverized coal, oil or gas. As the coal ash is similar in composition to the clay or shale, it can stay in the cement clinker. As one of the kiln operator's major costs is fuel and even a modest sized kiln can consume 8-10 tons of coal per hour, the cement kiln could, therefore, solve a disposal problem and also benefit the cement manufacturer by reducing fuel costs."@en ;
    skos:prefLabel "cement manufacture"@en .

<http://www.eionet.europa.eu/gemet/concept/12511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "Extraction of crushed rock or gravel screened to sizes for use in road surfaces, concretes, or bituminous mixes."@en ;
    skos:prefLabel "aggregate extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/12525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "All interrelated steps of the lumber manufacturing process including tree felling, the removal of tops, branches and bark, the piling and sawing of logs, and the transportation and loading of finished boards or other products."@en ;
    skos:prefLabel "timber producing chain"@en .

<http://www.eionet.europa.eu/gemet/concept/12528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "packing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/1255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:definition "A geographic region of the African continent close to the equator that includes Cameroon, Chad, Equatorial Guinea, Gabon, the Central African Republic and the Democratic Republic of Congo."@en ;
    skos:prefLabel "Central Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/1256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:definition "A narrow continental region of the Western hemisphere, existing as a bridge between North and South America, often considered to be the southern portion of North America, and including countries such as Guatemala, Belize, El Salvador, Honduras, Nicaragua, Costa Rica and Panama."@en ;
    skos:prefLabel "Central America"@en .

<http://www.eionet.europa.eu/gemet/concept/1257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:definition "A geographic region of the Asian continent between the Caspian Sea on the west and China on the east, extending northward into the central region of Russia and southward to the northern borders of Iran and Afghanistan, and comprised of independent former republics of the Soviet Union, including Kazakstan, Uzbekistan, Turkmenistan, Kyrgyzstan and Tajikistan."@en ;
    skos:prefLabel "Central Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/12576> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12601> ;
    skos:definition "The distribution of settled sewage on a bed of inert granular material through which it is allowed to percolate. In doing so, the effluent is aerated thus allowing aerobic bacteria and fungi to reduce its biochemical oxygen demand."@en ;
    skos:prefLabel "biofiltration"@en .

<http://www.eionet.europa.eu/gemet/concept/12583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1336> ;
    skos:definition "Removal of chlorine from a substance."@en ;
    skos:prefLabel "dechlorination"@en .

<http://www.eionet.europa.eu/gemet/concept/12587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3599> ;
    skos:definition "The process of deriving methane from any source, including livestock manure, landfills, coal mines, etc."@en ;
    skos:prefLabel "methanisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3455> ;
    skos:definition "A system in which a governing or administrative body has a certain degree of power or authority to prevail in the management of local, national and international matters."@en ;
    skos:prefLabel "central government"@en .

<http://www.eionet.europa.eu/gemet/concept/12599> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/879> ;
    skos:definition "The introduction of air into sewage so as to provide aerobic biochemical stabilization during a detention period."@en ;
    skos:prefLabel "aerobic treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/879> ;
    skos:definition "Breakdown of organic material without the presence of oxygen, a treatment which permanently removes the unpleasant odour of many organic wastes so that they can be used on agricultural land."@en ;
    skos:prefLabel "anaerobic treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:definition "Removal of floating solids and suspended solids, both fine and coarse, from raw sewage."@en ;
    skos:prefLabel "primary treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12608> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:definition "Stage of the process of waste water treatment: following primary treatment by sedimentation, the second step in most wastewater systems in which biological organisms decompose most of the organic matter into a innocuous, stable form."@en ;
    skos:prefLabel "secondary treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/12609> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:definition "The process which remove pollutants not adequately removed by secondary treatment, particularly nitrogen and phosphorus; accomplished by means of sand filters, microstraining, or other methods (referring to wastewater treatment)."@en ;
    skos:prefLabel "tertiary treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/1261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:prefLabel "centralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/12611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Formation of a glassy or noncrystalline material."@en ;
    skos:prefLabel "vitrification"@en .

<http://www.eionet.europa.eu/gemet/concept/1262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Separation of particles from a suspension in a centrifuge: balanced tubes containing the suspension are attached to the opposite ends of arms rotating rapidly about a central point; the suspended particles are forced outwards, and collect at the bottoms of the tubes."@en ;
    skos:prefLabel "centrifugation"@en .

<http://www.eionet.europa.eu/gemet/concept/1265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5339> ;
    skos:definition "Exclusively marine animals constituting the most advanced class of the Mollusca, including squid, octopuses, and Nautilus."@en ;
    skos:prefLabel "cephalopod"@en .

<http://www.eionet.europa.eu/gemet/concept/12656> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6867> ;
    skos:definition "Quarry located below the surface of the earth."@en ;
    skos:prefLabel "underground quarry"@en .

<http://www.eionet.europa.eu/gemet/concept/1266> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "The art and techniques of producing articles of clay, porcelain, etc."@en ;
    skos:prefLabel "ceramics"@en .

<http://www.eionet.europa.eu/gemet/concept/12665> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "The application of scientific methods and engineering principles to civil engineering problems through acquiring, interpreting, and using knowledge of materials of the crust of the earth."@en ;
    skos:prefLabel "geotechnics"@en .

<http://www.eionet.europa.eu/gemet/concept/12666> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The theoretical and applied science of the physical behavior of rocks, representing a \"branch of mechanics concerned with the response of rock to the force fields of its physical environment\"."@en ;
    skos:prefLabel "rock mechanics"@en .

<http://www.eionet.europa.eu/gemet/concept/1267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Manufacturing plant producing ceramic items."@en ;
    skos:prefLabel "ceramics industry"@en .

<http://www.eionet.europa.eu/gemet/concept/12676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The removal of brush using mechanical means, either by cutting manually or by using machinery for crushing, rolling, flailing, or chipping it, or by chemical means or a combination of these."@en ;
    skos:prefLabel "bush clearing"@en .

<http://www.eionet.europa.eu/gemet/concept/12677> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3218> ;
    skos:definition "Precautionary actions, measures or installations implemented to avert the possibility of an unexpected conflagration of any large wooded area having a thick growth of trees and plants."@en ;
    skos:prefLabel "prevention of forest fires"@en .

<http://www.eionet.europa.eu/gemet/concept/12687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:definition "Precautionary measures, equipment or structures implemented to guard or defend people, property and lands from an unusual accumulation of water above the ground."@en ;
    skos:prefLabel "flood protection"@en .

<http://www.eionet.europa.eu/gemet/concept/12711> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4646> ;
    skos:definition "Measures adopted to control erosion and degradation phenomena in the mountain regions caused by the loss of forest cover due to acid rain, uncontrolled forest cutting, winter skiing resorts construction, etc."@en ;
    skos:prefLabel "land restoration in mountain areas"@en .

<http://www.eionet.europa.eu/gemet/concept/12717> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7848> ;
    skos:definition "Soil stability depends on its shear strength, its compressibility and its tendency to absorb water. Stabilization methods include physical compaction and treatment with cement, lime, and bitumen."@en ;
    skos:prefLabel "soil stability"@en .

<http://www.eionet.europa.eu/gemet/concept/12721> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "The branch of geology that deals with volcanism."@en ;
    skos:prefLabel "volcanology"@en .

<http://www.eionet.europa.eu/gemet/concept/12746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1049> ;
    skos:definition "Rules for minimizing or containing the risks deriving from earthquakes."@en ;
    skos:prefLabel "antiseismic regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/12763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Actions and measures undertaken, often at a local level, to ensure that citizens of a community are secure from harm, injury, danger or risk."@en ;
    skos:prefLabel "civil safety"@en .

<http://www.eionet.europa.eu/gemet/concept/12764> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures or techniques implemented to reduce the risk of injury, loss and danger to persons, property or the environment in any facility or place involving the manufacturing, producing and processing of goods or merchandise."@en ;
    skos:prefLabel "industrial safety"@en .

<http://www.eionet.europa.eu/gemet/concept/12778> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The situation or set of circumstances where the probability of harm to an area or its population increases beyond a normal level."@en ;
    skos:prefLabel "risk exposure"@en .

<http://www.eionet.europa.eu/gemet/concept/12784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25>,
        <http://www.eionet.europa.eu/gemet/concept/4052> ;
    skos:definition "An unexpected incident, failure or loss occurring through the application of practical or mechanical sciences to industry or commerce that poses potential harm to persons, property or the environment."@en ;
    skos:prefLabel "technological accident"@en .

<http://www.eionet.europa.eu/gemet/concept/1279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9426> ;
    skos:definition "A form of trypanosomiasis found in South America, caused by the protozoan Trypanosoma cruzi, characterized by fever and often inflammation of the hearth muscle."@en ;
    skos:prefLabel "Chagas' disease"@en .

<http://www.eionet.europa.eu/gemet/concept/12790> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1213> ;
    skos:definition "A sudden, widespread disaster or calamity causing extensive damage to the environment that threatens the quality of life for people living in the affected area or region, potentially leading to many deaths."@en ;
    skos:prefLabel "ecocatastrophe"@en .

<http://www.eionet.europa.eu/gemet/concept/1280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The administration, organization and planning for the flow of materials or merchandise through various stages of production and distribution, involving a network of vendors, suppliers, manufacturers, distributors, retailers and other trading partners."@en ;
    skos:prefLabel "chain management"@en .

<http://www.eionet.europa.eu/gemet/concept/12807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "Installations whose functioning involves the possibility of major hazards such as chemical plants, nuclear, coal and oil power production plants, etc."@en ;
    skos:prefLabel "major risk installation"@en .

<http://www.eionet.europa.eu/gemet/concept/12808> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "Installations whose functioning involves the possibility of major hazards such as chemical plants, nuclear, coal and oil power production plants, etc."@en ;
    skos:prefLabel "dangerous installation"@en .

<http://www.eionet.europa.eu/gemet/concept/12814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8334> ;
    skos:definition "A danger to humans, animals or the environment posed by the application of advanced biological techniques in the manufacture of industrial products, such as the risk or harm that results from exposure to infectious bacteria, viruses or fungi."@en ;
    skos:prefLabel "biotechnological hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/12816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "A risk connected to the functioning of nuclear power plants, by the storage or transportation of radioactive materials and involving the release of potentially dangerous levels of radioactive materials into the environment."@en ;
    skos:prefLabel "nuclear risk"@en .

<http://www.eionet.europa.eu/gemet/concept/12819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3481> ;
    skos:definition "Type of transport regulated by special safety rules."@en ;
    skos:prefLabel "dangerous materials transport"@en .

<http://www.eionet.europa.eu/gemet/concept/12849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "Zone that has been stricken by a disaster and where measures must be taken to reduce the severity of the human and material damage caused by it."@en ;
    skos:prefLabel "disaster zone"@en .

<http://www.eionet.europa.eu/gemet/concept/1286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:prefLabel "change in value"@en .

<http://www.eionet.europa.eu/gemet/concept/12861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The process of evaluating the scale and probability of harm caused by any hazard to persons, property or the environment."@en ;
    skos:prefLabel "danger analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/12866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11661> ;
    skos:definition "Data communicated or received concerning the recommended means of averting risk of an accident, disaster or other undesirable and avoidable incident."@en ;
    skos:prefLabel "preventive information"@en .

<http://www.eionet.europa.eu/gemet/concept/12872> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2656> ;
    skos:definition "A scheme or method of acting that takes effect if the probability of harm to an area or its population increases beyond a normal level."@en ;
    skos:prefLabel "risk exposure plan"@en .

<http://www.eionet.europa.eu/gemet/concept/12889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4374> ;
    skos:definition "A commercial agreement which provides protection against the risks, or a particular risk, associated with pollution, toxic waste disposal or related concerns."@en ;
    skos:prefLabel "pollution insurance"@en .

<http://www.eionet.europa.eu/gemet/concept/12893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Water damage can be caused by flooding, severe storms, tidal waves, seismic seawaves, storm surges, etc."@en ;
    skos:prefLabel "water damage"@en .

<http://www.eionet.europa.eu/gemet/concept/12898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "The evaluation or determination of losses, harm and injuries to persons, property or the environment."@en ;
    skos:prefLabel "damage assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/126> ;
    skos:definition "The creation and dissemination of paid announcements or public notices to draw attention to goods, services or events offered by some entity, usually for purchase."@en ;
    skos:prefLabel "product advertising"@en .

<http://www.eionet.europa.eu/gemet/concept/1290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1500> ;
    skos:definition "A porous solid product containing 85-98% carbon and produced by heating carbonaceous materials such as cellulose, wood or peat at 500-600 C° in the absence of air."@en ;
    skos:prefLabel "charcoal"@en .

<http://www.eionet.europa.eu/gemet/concept/12900> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12887> ;
    skos:definition "An expert or official valuation."@en ;
    skos:prefLabel "appraisal"@en .

<http://www.eionet.europa.eu/gemet/concept/12905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12887> ;
    skos:definition "Equivalent in money or other form for a loss sustained for an injury, for property taken, etc."@en ;
    skos:prefLabel "compensation for damage"@en .

<http://www.eionet.europa.eu/gemet/concept/1291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:prefLabel "negotiable charge"@en .

<http://www.eionet.europa.eu/gemet/concept/12914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12912> ;
    skos:definition "Public institution for the management of industrial and commercial issues."@en ;
    skos:prefLabel "public institution of industrial and commercial nature"@en .

<http://www.eionet.europa.eu/gemet/concept/1292> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:definition "A map, generally designed for navigation or other particular purposes, in which essential map information is combined with various other data critical to the intended use."@en ;
    skos:prefLabel "map chart"@en .

<http://www.eionet.europa.eu/gemet/concept/12923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The position or practice of a qualified person paid for advice or services."@en ;
    skos:prefLabel "consultancy"@en .

<http://www.eionet.europa.eu/gemet/concept/12977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "A grant of right to exclude others from making, using or selling one's invention and includes right to license others to make, use or sell it."@en ;
    skos:prefLabel "patent"@en .

<http://www.eionet.europa.eu/gemet/concept/1298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The complex of operations aiming to determine the kinds of constituents of a given substance."@en ;
    skos:prefLabel "chemical analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/12982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "An official statement or announcement distributed to members of the media by a public relations firm, government agency or some other organization, often to supplement or replace an oral presentation."@en ;
    skos:prefLabel "press release"@en .

<http://www.eionet.europa.eu/gemet/concept/12985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5079> ;
    skos:definition "An address or form of oral communication in which a speaker makes his thoughts and emotions known before an audience, often for a given purpose."@en ;
    skos:prefLabel "speech"@en .

<http://www.eionet.europa.eu/gemet/concept/12994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2917> ;
    skos:definition "A document submitted by an applicant in support of an undertaking which identifies the environmental impacts of the proposed undertaking and its alternatives."@en ;
    skos:prefLabel "environmental study"@en .

<http://www.eionet.europa.eu/gemet/concept/13> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6359> ;
    skos:definition "The taking in of fluids or other substances by cells or tissues."@en ;
    skos:prefLabel "absorption (exposure)"@en .

<http://www.eionet.europa.eu/gemet/concept/13000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3183> ;
    skos:definition "Any motion picture of a story, drama, episode or event, often considered as an art form or used as a medium for entertainment."@en ;
    skos:prefLabel "cinematographic film"@en .

<http://www.eionet.europa.eu/gemet/concept/13001> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3183> ;
    skos:definition "Any motion picture or movie in which an actual event, era or life story is presented factually, with little or no fiction."@en ;
    skos:prefLabel "documentary film"@en .

<http://www.eionet.europa.eu/gemet/concept/13002> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A work systematically describing the flora of a particular region, listed by species and considered as a whole."@en ;
    skos:prefLabel "flora (document)"@en .

<http://www.eionet.europa.eu/gemet/concept/13017> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A written account or statement describing in detail observations or the results of an inquiry into an event or situation and presented to any person appointed or elected to a high-level position within some political entity."@en ;
    skos:prefLabel "report to the minister"@en .

<http://www.eionet.europa.eu/gemet/concept/13021> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A written account describing in detail observations or the results of an inquiry into an event or situation and presented to an official, deliberative body with legislative powers."@en ;
    skos:prefLabel "parliamentary report"@en .

<http://www.eionet.europa.eu/gemet/concept/13025> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A document or a portion thereof expressing an official enactment of a legislative body, with emphasis on the document's precise wording or language."@en ;
    skos:prefLabel "statutory text"@en .

<http://www.eionet.europa.eu/gemet/concept/13026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A dissertation on a particular subject, in which original research has been done, usually by a candidate for a diploma or degree, or a proposition put forward for consideration, to be discussed and proved or maintained against objections."@en ;
    skos:prefLabel "thesis"@en .

<http://www.eionet.europa.eu/gemet/concept/1303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2015> ;
    skos:definition "Removal of chemical substances from a building, a watercourse, a person's clothes, etc."@en ;
    skos:prefLabel "chemical decontamination"@en .

<http://www.eionet.europa.eu/gemet/concept/13040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2284> ;
    skos:definition "A compact disc on which a large amount of digitalised read-only data can be stored."@en ;
    skos:prefLabel "CD-ROM"@en .

<http://www.eionet.europa.eu/gemet/concept/13041> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Any facility devoted to the collection, maintenance and distribution of materials or data compiled to convey knowledge on some subject, often with trained staff persons available to answer questions."@en ;
    skos:prefLabel "information centre"@en .

<http://www.eionet.europa.eu/gemet/concept/1305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The branch of engineering concerned with industrial manufacture of chemical products. It is a discipline in which the principles of mathematical, physical and natural sciences are used to solve problems in applied chemistry. Chemical engineers design, develop, and optimise processes and plants, operate them, manage personnel and capital, and conduct research necessary for new developments. Through their efforts, new petroleum products, plastics, agricultural chemicals, house-hold products, pharmaceuticals, electronic and advanced materials, photographic materials, chemical and biological compounds, various food and other products evolve."@en ;
    skos:prefLabel "chemical engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/13053> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Factual data, knowledge or instructions relating to scientific research or the development, testing, evaluation, production, use or maintenance of equipment."@en ;
    skos:prefLabel "technical information"@en .

<http://www.eionet.europa.eu/gemet/concept/1306> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3110> ;
    skos:definition "The sedimentation of chemical substances accumulated in the atmosphere as a result of industrial emissions."@en ;
    skos:prefLabel "chemical fallout"@en .

<http://www.eionet.europa.eu/gemet/concept/13101> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3138> ;
    skos:definition "Not domesticated animals living independently of man."@en ;
    skos:prefLabel "wild fauna"@en .

<http://www.eionet.europa.eu/gemet/concept/13104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7353> ;
    skos:definition "The biotopes located in areas where agriculture is practiced."@en ;
    skos:prefLabel "rural habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/13106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9214> ;
    skos:definition "Groundwater accounts for over 95% of the earth's useable fresh-water resources; over half the world's population depends on groundwater for drinking-water supplies. This invisible resource is vulnerable to pollution and over-exploitation. Effective conservation of groundwater supplies requires the integration of land-use and water management."@en ;
    skos:prefLabel "groundwater quality"@en .

<http://www.eionet.europa.eu/gemet/concept/13107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2893> ;
    skos:definition "Establishing or determining environmental goals or objectives."@en ;
    skos:prefLabel "target setting"@en .

<http://www.eionet.europa.eu/gemet/concept/1311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "Building where chemicals are manufactured."@en ;
    skos:prefLabel "chemical installation"@en .

<http://www.eionet.europa.eu/gemet/concept/13111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7120> ;
    skos:definition "The entire sequence of events involved in the development of an individual organism."@en ;
    skos:prefLabel "ontogenesis"@en .

<http://www.eionet.europa.eu/gemet/concept/13115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Property tax. A tax laid upon the legal or beneficial owner of real property, and apportioned upon the assessed value of his land."@en ;
    skos:prefLabel "land tax"@en .

<http://www.eionet.europa.eu/gemet/concept/13118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4802> ;
    skos:definition "A series of transformations or biological events which follow one after the other one, reaching at the end of the cycle the initial conditions, as in the life cycle of many animal and plant organisms."@en ;
    skos:prefLabel "biological cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/1312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5797> ;
    skos:prefLabel "chemical oceanography"@en .

<http://www.eionet.europa.eu/gemet/concept/13120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "Any of the conditions in which people live. Also all human settlements in villages, towns or major cities, which require environmental management to provide water, public spaces, remove public wastes, etc."@en ;
    skos:prefLabel "human habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/13121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "A process in which an increasing proportion of a country's population is concentrated in urban areas."@en ;
    skos:prefLabel "urban concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/13122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3559> ;
    skos:definition "A plot of cultivated ground adjacent to a dwelling and usually devoted in whole or in part to the growing of herbs, fruits, flowers, or vegetables for household use."@en ;
    skos:prefLabel "home garden"@en .

<http://www.eionet.europa.eu/gemet/concept/13124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:prefLabel "bottle cap"@en .

<http://www.eionet.europa.eu/gemet/concept/13127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7486> ;
    skos:definition "Waste pieces or disused articles of wrought iron (wrought-iron scrap) suitable for reworking for rolling or forging."@en ;
    skos:prefLabel "iron scrap"@en .

<http://www.eionet.europa.eu/gemet/concept/13135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6380> ;
    skos:definition "The act of formally expressing an opinion or choice in some matter or for some candidate, usually by voice or  ballot."@en ;
    skos:prefLabel "voting"@en .

<http://www.eionet.europa.eu/gemet/concept/13137> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1025> ;
    skos:definition "The programmatic use of a government's spending and revenue-generating activities to influence the economy and achieve specific objectives."@en ;
    skos:prefLabel "budget policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1314> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6139> ;
    skos:definition "Control of plants and animals classified as pests by means of chemical compounds."@en ;
    skos:prefLabel "chemical pest control"@en .

<http://www.eionet.europa.eu/gemet/concept/13142> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Political course of action aiming at establishing trade agreements among the states."@en ;
    skos:prefLabel "co-operation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The unrestrained flow of cash, funds, and other means of wealth between countries with different currencies."@en ;
    skos:prefLabel "free movement of capital"@en .

<http://www.eionet.europa.eu/gemet/concept/13154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7817> ;
    skos:definition "The underlying structure that connects and supports the various members and parts of a community or human organization."@en ;
    skos:prefLabel "social framework"@en .

<http://www.eionet.europa.eu/gemet/concept/13157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8319> ;
    skos:definition "A group or association of persons united to address the concerns, methods and professional status of instructors or educators."@en ;
    skos:prefLabel "organisation of teaching"@en .

<http://www.eionet.europa.eu/gemet/concept/1316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Plants where basic raw materials are chemically converted into a variety of products."@en ;
    skos:prefLabel "chemical plant"@en .

<http://www.eionet.europa.eu/gemet/concept/13165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:prefLabel "means of agricultural production"@en .

<http://www.eionet.europa.eu/gemet/concept/13167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/220> ;
    skos:prefLabel "processed agricultural produce"@en .

<http://www.eionet.europa.eu/gemet/concept/13168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:definition "Industry dealing with the production, processing, and supply of agricultural food products."@en ;
    skos:prefLabel "agri-foodstuff"@en .

<http://www.eionet.europa.eu/gemet/concept/1317> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:prefLabel "chemical policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The geography of people making a living, dealing with the spatial patterns of production, distribution and consumption of goods and services. The development of economic geography over the past three decades has witnessed the substitution of analysis for description, leading to an identification of the factors and an understanding of the processes affecting the spatial differentiation of economic activities over the earth's surface."@en ;
    skos:prefLabel "economic geography"@en .

<http://www.eionet.europa.eu/gemet/concept/13178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:definition "The quality or state of being free, especially to enjoy political and civil liberties."@en ;
    skos:prefLabel "freedom"@en .

<http://www.eionet.europa.eu/gemet/concept/13182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8102> ;
    skos:definition "Stored products ready for sale."@en ;
    skos:prefLabel "stock (trade)"@en .

<http://www.eionet.europa.eu/gemet/concept/13183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3119> ;
    skos:definition "Procedure by which a human or other animal is made incapable of reproduction."@en ;
    skos:prefLabel "sterilisation (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/13184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The use of financial resources for the purpose of incorporating ecological principles in the operations of businesses and companies."@en ;
    skos:prefLabel "environmental economics of firms"@en .

<http://www.eionet.europa.eu/gemet/concept/13186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:definition "The accumulated volume or biomass remaining from gross production after accounting for losses due to respiration during production, herbivory, litterfall, and other factors that decrease the remaining available biomass."@en ;
    skos:prefLabel "yield (agricultural)"@en .

<http://www.eionet.europa.eu/gemet/concept/13188> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants used to feed livestock."@en ;
    skos:prefLabel "fodder plant"@en .

<http://www.eionet.europa.eu/gemet/concept/13189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants employed in industry, e.g. cotton, flax, hemp, peanuts, etc."@en ;
    skos:prefLabel "industrial plant (organism)"@en .

<http://www.eionet.europa.eu/gemet/concept/13190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plant producing material suitable to be made into cloths."@en ;
    skos:prefLabel "textile plant"@en .

<http://www.eionet.europa.eu/gemet/concept/13191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants growing in tropical areas in conditions of constant rain and high temperature."@en ;
    skos:prefLabel "tropical plant"@en .

<http://www.eionet.europa.eu/gemet/concept/13192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3130> ;
    skos:definition "Property of agricultural land and anything permanently affixed to the land, such as buildings, fences, etc."@en ;
    skos:prefLabel "agricultural real estate"@en .

<http://www.eionet.europa.eu/gemet/concept/13194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13193> ;
    skos:definition "The manner in which land is owned and possessed, i.e. of title to its use."@en ;
    skos:prefLabel "type of tenure"@en .

<http://www.eionet.europa.eu/gemet/concept/13195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "The physical earth and its surroundings, consisting of the oceans and inland waters, lower and upper atmosphere, space, land masses and land forms."@en ;
    skos:prefLabel "geophysical environment"@en .

<http://www.eionet.europa.eu/gemet/concept/13196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Chemicals manufactured from the products of oil refineries, based largely on ethylene, propylene and butylene produced in the cracking of petrol fractions."@en ;
    skos:prefLabel "petrochemical"@en .

<http://www.eionet.europa.eu/gemet/concept/13197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Various fine chemical products like glue, adhesives, resins, rubber, plastic compounds, selective herbicide, etc."@en ;
    skos:prefLabel "speciality chemical"@en .

<http://www.eionet.europa.eu/gemet/concept/13198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:prefLabel "protein product"@en .

<http://www.eionet.europa.eu/gemet/concept/13200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13199> ;
    skos:definition "Food so prepared and presented as to be easily and quickly ready for consumption."@en ;
    skos:prefLabel "convenience food"@en .

<http://www.eionet.europa.eu/gemet/concept/13202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:prefLabel "mining product"@en .

<http://www.eionet.europa.eu/gemet/concept/13205> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/220> ;
    skos:definition "Plants which store edible material in a root, corm or tuber; root crops used as food vegetables or fodder include carrots, parsnips, swedes and turnips; starchy root crops include potatoes, cassavas and yams."@en ;
    skos:prefLabel "root crop"@en .

<http://www.eionet.europa.eu/gemet/concept/13209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:definition "The act or process of yielding produce from farmland, for livestock or human consumption."@en ;
    skos:prefLabel "crop production"@en .

<http://www.eionet.europa.eu/gemet/concept/13211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Area of sea or freshwater where fish are caught."@en ;
    skos:prefLabel "fishing ground"@en .

<http://www.eionet.europa.eu/gemet/concept/13212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3090> ;
    skos:definition "Industry related with the technical and mechanical activity of removing coal from the earth and preparing it for market."@en ;
    skos:prefLabel "coal industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "communication industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the design, manufacture and marketing of electronic machines designed to accept information or data that is easily manipulated for some result based on a program or some set of instructions, and the technology or materials used with these machines, such as storage devices, terminals and peripheral equipment."@en ;
    skos:prefLabel "information technology industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "vacuum industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The containment, protection, handling and presentation of goods for the market."@en ;
    skos:prefLabel "preparation for market"@en .

<http://www.eionet.europa.eu/gemet/concept/13218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586>,
        <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Research and development, design, manufacture and measurement of high accuracy components and systems. It is related to mechanical, electronic, optical and production engineering, physics, chemistry, and computer and materials science."@en ;
    skos:prefLabel "precision engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/13219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Any technical means or equipment used for the production and optimization of material goods that consist of any of a diverse range of properties, either alone or in combination, such as glass, metal, plastics and ceramics."@en ;
    skos:prefLabel "materials technology"@en .

<http://www.eionet.europa.eu/gemet/concept/13220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Equipment necessary to the performance of military activities, either combat or noncombat."@en ;
    skos:prefLabel "military equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/13221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2633> ;
    skos:definition "Equipment designed to aid in learning and teaching by making use of both hearing and sight."@en ;
    skos:prefLabel "audiovisual equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/13223> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Machines and tools employed in manual and mechanical labour."@en ;
    skos:prefLabel "mechanical equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/13224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "Equipment operating with an internal pressure greater than atmospheric."@en ;
    skos:prefLabel "pressure equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/13226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "To make or process (a raw material) into a finished product, especially by means of a large-scale industrial operation."@en ;
    skos:prefLabel "industrial manufacturing"@en .

<http://www.eionet.europa.eu/gemet/concept/13227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:prefLabel "size of business"@en .

<http://www.eionet.europa.eu/gemet/concept/13228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "Any profit-seeking undertaking or venture that involves the production, sale and purchase of goods or services."@en ;
    skos:prefLabel "business activity"@en .

<http://www.eionet.europa.eu/gemet/concept/13229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "A specialized division of a business or other organization."@en ;
    skos:prefLabel "branch of activity"@en .

<http://www.eionet.europa.eu/gemet/concept/13231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10076> ;
    skos:prefLabel "administrative occupation"@en .

<http://www.eionet.europa.eu/gemet/concept/13232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6824> ;
    skos:definition "The aggregation of services, including construction, development, maintenance and leasing, performed for human-occupied properties, such as office buildings and apartment houses."@en ;
    skos:prefLabel "building service"@en .

<http://www.eionet.europa.eu/gemet/concept/13234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "The targeted place to which persons, materials or commodities are conveyed over land, water or through the air."@en ;
    skos:prefLabel "destination of transport"@en .

<http://www.eionet.europa.eu/gemet/concept/13237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13145> ;
    skos:definition "A schedule of revenues and expenditures for a specific time period that is devised by the European Community, a body of people organized into a political unity."@en ;
    skos:prefLabel "Community budget"@en .

<http://www.eionet.europa.eu/gemet/concept/13239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The system of setting up, maintaining, and auditing the books of a firm and of analyzing its financial status and operating results."@en ;
    skos:prefLabel "accounting system"@en .

<http://www.eionet.europa.eu/gemet/concept/13240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "The production of estimates of future financial and commercial trends, based on econometric models or surveys."@en ;
    skos:prefLabel "economic forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/13241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8301> ;
    skos:definition "An official list or schedule setting forth the duties imposed by a government on imported or exported goods."@en ;
    skos:prefLabel "customs tariff"@en .

<http://www.eionet.europa.eu/gemet/concept/13244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3149> ;
    skos:definition "A course of action or procedure regarding compensation or recompensation for work done or services rendered."@en ;
    skos:prefLabel "pay policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13150> ;
    skos:definition "An organization established in Europe in 1979 to coordinate financial policy and exchange rates for the continent by running the Exchange Rate Mechanism (ERM) and assisting movement toward a common European currency and a central European bank."@en ;
    skos:prefLabel "European Monetary System"@en .

<http://www.eionet.europa.eu/gemet/concept/13246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13151> ;
    skos:definition "A financial market that trades Treasury bills, commercial paper and other short-term financial instruments. This market is often used by businesses when they need short-term funds to bridge the gap between paying operating costs and collecting revenue from product sales. As such, the term \"money\" in money market indicates that businesses are using highly liquid instruments to raise the money need for operating expenses."@en ;
    skos:prefLabel "money market"@en .

<http://www.eionet.europa.eu/gemet/concept/13247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13151> ;
    skos:definition "Course of action or procedure by government, business, or an individual concerning trade activities."@en ;
    skos:prefLabel "exchange policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13177> ;
    skos:definition "An official course of action adopted by a business, financial institution or state to regulate, restrict or increase deferred payment arrangements for goods, services or money."@en ;
    skos:prefLabel "credit policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13249> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2000> ;
    skos:definition "The total amount of all government securities outstanding. This is also frequently termed government debt."@en ;
    skos:prefLabel "public debt"@en .

<http://www.eionet.europa.eu/gemet/concept/13250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8307> ;
    skos:definition "A sum of money demanded from businesses by a government, usually based on a percentage of total sales of select goods and services, and generally passed on to consumers with each individual purchase."@en ;
    skos:prefLabel "tax on consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/13251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8307> ;
    skos:definition "A government imposed levy on the wealth or assets gained by an individual, firm, or corporation for the purpose of raising revenue to pay for services or improvements for the general public benefit."@en ;
    skos:prefLabel "tax on capital"@en .

<http://www.eionet.europa.eu/gemet/concept/13252> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8307> ;
    skos:definition "A tax on the annual profits arising from property, business pursuits, professions, trades or offices."@en ;
    skos:prefLabel "income tax"@en .

<http://www.eionet.europa.eu/gemet/concept/13254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "The amount of money or monetary rate at which agricultural goods and services can be bought or sold."@en ;
    skos:prefLabel "farm price"@en .

<http://www.eionet.europa.eu/gemet/concept/13255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "The price actually given in current market dealings; the actual price at which given stock or commodity is currently sold in the usual and ordinary course of trade and competition between sellers and buyers."@en ;
    skos:prefLabel "market price"@en .

<http://www.eionet.europa.eu/gemet/concept/13256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "The outlay or expenditure involved in moving goods from one place to another."@en ;
    skos:prefLabel "transport cost"@en .

<http://www.eionet.europa.eu/gemet/concept/13258> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13159> ;
    skos:definition "The extent to which a market is taken up by producers within a given industry."@en ;
    skos:prefLabel "economic concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/13259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13159> ;
    skos:definition "The type of organization of a company. Three kinds of structure are usually recognized: centralized, formal or hierarchical."@en ;
    skos:prefLabel "company structure"@en .

<http://www.eionet.europa.eu/gemet/concept/1326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Probability of harm to human health, property or the environment posed by contact with any substance of a defined molecular composition."@en ;
    skos:prefLabel "chemical risk"@en .

<http://www.eionet.europa.eu/gemet/concept/13264> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4430> ;
    skos:definition "The part of the national law of a country that establishes rules for dealing with cases involving a foreign element."@en ;
    skos:prefLabel "private international law"@en .

<http://www.eionet.europa.eu/gemet/concept/13265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4430> ;
    skos:definition "The general rules and principles pertaining to the conduct of nations and of international organizations and with the relations among them."@en ;
    skos:prefLabel "public international law"@en .

<http://www.eionet.europa.eu/gemet/concept/13266> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4430> ;
    skos:definition "The recognized rules guiding the commercial relations of at least two sovereign states or private parties involved in cross-border transactions, including regulations for trade, finance and intellectual property."@en ;
    skos:prefLabel "international economic law"@en .

<http://www.eionet.europa.eu/gemet/concept/13268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1862> ;
    skos:prefLabel "criminal liability"@en .

<http://www.eionet.europa.eu/gemet/concept/13270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1590> ;
    skos:definition "A body of rules or orders generally issued by the executive authority of a government to establish and direct the taxes, duties or tariffs payable upon merchandise exported or imported."@en ;
    skos:prefLabel "customs regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/13271> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "Branch of specialty of law, also denominated \"domestic relations\" law, concerned with such subjects as adoption, annulment, divorce, separation, paternity, custody, support and child care."@en ;
    skos:prefLabel "family law"@en .

<http://www.eionet.europa.eu/gemet/concept/13273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by government, management or an international organization or treaty pertaining to the cultivation of land, raising crops, or feeding, breeding and raising livestock."@en ;
    skos:prefLabel "regulation of agricultural production"@en .

<http://www.eionet.europa.eu/gemet/concept/13274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1862> ;
    skos:definition "Binding rules and regulations pertaining to the construction, use and operation of jails, penitentiaries and other places of legal confinement and punishment."@en ;
    skos:prefLabel "law relating to prisons"@en .

<http://www.eionet.europa.eu/gemet/concept/13275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10898> ;
    skos:definition "The service provided by an owner agreeing to grant the temporary possession of specific housing in return for the payment of rent from the tenant."@en ;
    skos:prefLabel "estate rental"@en .

<http://www.eionet.europa.eu/gemet/concept/13276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:prefLabel "data processing law"@en .

<http://www.eionet.europa.eu/gemet/concept/13277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "That part of the law dealing with matters such as those arising from monopolies and mergers, restrictive trading agreements, resale price maintenance and agreements involving distortion of competition affected by EU rules."@en ;
    skos:prefLabel "competition law"@en .

<http://www.eionet.europa.eu/gemet/concept/13278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8573> ;
    skos:definition "Business operation or action that confines or limits the free exchange of goods and services within a country or between countries, which may include discrimination, exclusive dealings, collusion agreements or price fixing."@en ;
    skos:prefLabel "restrictive trade practice"@en .

<http://www.eionet.europa.eu/gemet/concept/13279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8663> ;
    skos:prefLabel "EC Treaty"@en .

<http://www.eionet.europa.eu/gemet/concept/1328> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10026> ;
    skos:prefLabel "chemicals act"@en .

<http://www.eionet.europa.eu/gemet/concept/13280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A rule or order prescribed by government or management for the safe and orderly conveyance of persons, materials or commodities over land, water or through the air."@en ;
    skos:prefLabel "transport regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/13281> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1616> ;
    skos:definition "The directly applicable legislation of the European Community regulating the relations of member states."@en ;
    skos:prefLabel "Community legal system"@en .

<http://www.eionet.europa.eu/gemet/concept/13282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1616> ;
    skos:prefLabel "Community act"@en .

<http://www.eionet.europa.eu/gemet/concept/13285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11583> ;
    skos:definition "The right of citizens to access to the organs of the governments where justice is administered."@en ;
    skos:prefLabel "access to the courts"@en .

<http://www.eionet.europa.eu/gemet/concept/13286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13161> ;
    skos:definition "Term used in commercial law, including a corporation, government or governmental subdivision or agency, business trust, estate, trust, partnership or association, two or more persons having a joint or common interest, or any other legal or commercial entity."@en ;
    skos:prefLabel "organisation (law)"@en .

<http://www.eionet.europa.eu/gemet/concept/13287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13146> ;
    skos:definition "A body of persons whose occupation is concerned with advising clients in matters of law, representing them in court or assisting them through the judicial process, including, in the first instance, lawyers and, by extension, judges, legal assistants and court employees."@en ;
    skos:prefLabel "legal profession"@en .

<http://www.eionet.europa.eu/gemet/concept/13294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:definition "The set of uniform trade principles or practices established by an European Community customs union, which implements common tariff rates, tariff and trade agreements with non-member countries, import and export policies, and export promotion."@en ;
    skos:prefLabel "common commercial policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:definition "A course of action adopted and pursued by member countries, in which it is agreed to impose a system of duties or tax charges on imports from non-member countries."@en ;
    skos:prefLabel "common tariff policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7480> ;
    skos:prefLabel "research policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13297> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which plans or organizes for the maintenance, development and erection of houses, offices, bridges or other building structures."@en ;
    skos:prefLabel "construction policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Measures and practices adopted by governments relating to the management of communication media."@en ;
    skos:prefLabel "communication policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Measures and activities promoted by governments aiming at the structural definition of the productive apparatus."@en ;
    skos:prefLabel "production policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6409> ;
    skos:definition "The presence in the environment of any solid, liquid or gaseous material discharged from a process and that may pose substantial hazard to human health and the environment."@en ;
    skos:prefLabel "chemical in the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/13300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government or some other organization, which seeks to support research and the exploration of planets, asteroids and other elements in the region beyond earth's atmosphere or beyond the solar system."@en ;
    skos:prefLabel "space policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8398> ;
    skos:definition "A district or an administrative division of a city or territory that is designed according to some material, distributive or productive criteria."@en ;
    skos:prefLabel "economic region"@en .

<http://www.eionet.europa.eu/gemet/concept/13303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13302> ;
    skos:definition "The support or relief given to save human lives or to alleviate suffering, including public health efforts and the provision of financial resources and food, often when governmental authorities are unable or unwilling to provide for such assistance."@en ;
    skos:prefLabel "humanitarian aid"@en .

<http://www.eionet.europa.eu/gemet/concept/13304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13143> ;
    skos:definition "A controversy, disagreement, quarrel or warfare between or among two or more nations or countries, often requiring involvement or monitoring by other members of the global community."@en ;
    skos:prefLabel "international conflict"@en .

<http://www.eionet.europa.eu/gemet/concept/13305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13143> ;
    skos:definition "The activities to prevent, contain, moderate and/or terminate the hostilities between or within States, through the medium of an impartial third party intervention, organised and directed internationally. This intervention is conducted using military forces, police and civilians with the consent of the main belligerents, to complement the diplomatic conflict resolution process and, to restore and maintain peace."@en ;
    skos:prefLabel "peacekeeping"@en .

<http://www.eionet.europa.eu/gemet/concept/13306> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Procedure or course of action taken to curb or reduce human-made or human-alteration of the physical, biological, chemical and radiological integrity of air, water and other media."@en ;
    skos:prefLabel "pollution control measure"@en .

<http://www.eionet.europa.eu/gemet/concept/13308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Informal learning or formal instruction with broad application to human existence beyond the domain of any particular subject or discipline, often equated with liberal arts in the university setting and contrasted to courses required for a specific major or program."@en ;
    skos:prefLabel "general education"@en .

<http://www.eionet.europa.eu/gemet/concept/13309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2175> ;
    skos:definition "The material studied in or for an educational institution, comprising homework and work done in the classroom."@en ;
    skos:prefLabel "schoolwork"@en .

<http://www.eionet.europa.eu/gemet/concept/13310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2175> ;
    skos:definition "Any part or the sum of experiences had while attending an instructional institution, or the amount of time spent in such a program."@en ;
    skos:prefLabel "school life"@en .

<http://www.eionet.europa.eu/gemet/concept/13311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2175> ;
    skos:definition "An article or device used to facilitate the learning process in an instructional setting."@en ;
    skos:prefLabel "teaching material"@en .

<http://www.eionet.europa.eu/gemet/concept/13312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources providing written, printed or digitized items that furnish or substantiate information or evidence."@en ;
    skos:prefLabel "documentary system"@en .

<http://www.eionet.europa.eu/gemet/concept/13314> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources designed to exchange information and data by means of mutually understood symbols."@en ;
    skos:prefLabel "communication system"@en .

<http://www.eionet.europa.eu/gemet/concept/13317> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:prefLabel "social analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/13319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:prefLabel "health care profession"@en .

<http://www.eionet.europa.eu/gemet/concept/1332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "The determination of the efficacy and the toxicity of chemical products."@en ;
    skos:prefLabel "testing of chemicals"@en .

<http://www.eionet.europa.eu/gemet/concept/13320> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:prefLabel "artificial reproductive technique"@en .

<http://www.eionet.europa.eu/gemet/concept/13321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:prefLabel "animal health"@en .

<http://www.eionet.europa.eu/gemet/concept/13324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9028> ;
    skos:definition "A person that suffers from the destructive action undertaken as a result of an armed conflict between two or more parties, particularly death, injury, hardship, loss of property or dislocation."@en ;
    skos:prefLabel "war victim"@en .

<http://www.eionet.europa.eu/gemet/concept/13325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5236> ;
    skos:definition "A population shift occurring within national or territorial boundaries, often characterized by persons seeking labor opportunities in more advantageous areas."@en ;
    skos:prefLabel "internal migration"@en .

<http://www.eionet.europa.eu/gemet/concept/13326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6517> ;
    skos:definition "The number of inhabitants in or spread across designated subdivisions of an area, region, city or country."@en ;
    skos:prefLabel "geographical distribution of population"@en .

<http://www.eionet.europa.eu/gemet/concept/13327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The constituent groupings and proportions of the total inhabitants of a given nation, area, region or city, as seen from various perspectives."@en ;
    skos:prefLabel "composition of population"@en .

<http://www.eionet.europa.eu/gemet/concept/13329> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4060> ;
    skos:definition "Just claims, legal guarantees or moral principles accorded to each and every member of a group or state, including the freedom to do certain things and the freedom from certain intrusions imposed by the collective body."@en ;
    skos:prefLabel "rights of the individual"@en .

<http://www.eionet.europa.eu/gemet/concept/1333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The arrangement of atoms in a molecule of a chemical compound."@en ;
    skos:prefLabel "chemical structure"@en .

<http://www.eionet.europa.eu/gemet/concept/13330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:definition "The just claims and legal guarantees to access, participate in and profit from the production, distribution and use of property, intellectual property, income and wealth."@en ;
    skos:prefLabel "economic rights"@en .

<http://www.eionet.europa.eu/gemet/concept/13333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5880> ;
    skos:definition "The general movement, drift or direction of change in a viewpoint collectively and purportedly held by a significant number of people."@en ;
    skos:prefLabel "trend of opinion"@en .

<http://www.eionet.europa.eu/gemet/concept/13335> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7832> ;
    skos:definition "A belief system that explains and justifies a preferred economic and governmental order for society, offers strategies for its maintenance or attainment and helps give meaning to public events, personalities and policies."@en ;
    skos:prefLabel "political ideology"@en .

<http://www.eionet.europa.eu/gemet/concept/13336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "The standing of an individual with regard to a legally recognized conjugal relationship, either in the present or past."@en ;
    skos:prefLabel "marital status"@en .

<http://www.eionet.europa.eu/gemet/concept/13337> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A collection of people who interact and share a sense of unity on account of a common ethnic, ancestral, generational or regional identity."@en ;
    skos:prefLabel "socio-cultural group"@en .

<http://www.eionet.europa.eu/gemet/concept/13338> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "The organization and proportions of the various job types and skill levels in an enterprise or economy."@en ;
    skos:prefLabel "employment structure"@en .

<http://www.eionet.europa.eu/gemet/concept/13339> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:prefLabel "occupational status"@en .

<http://www.eionet.europa.eu/gemet/concept/13340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "The act or instrument by which the binding force of a contract is terminated, irrespective of whether the contract is carried out to the full extent contemplated or is broken off before complete execution."@en ;
    skos:prefLabel "termination of employment"@en .

<http://www.eionet.europa.eu/gemet/concept/13341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4581> ;
    skos:definition "The number of a particular region or nation's working population gainfully employed or otherwise occupied with the production of crops, livestock or poultry."@en ;
    skos:prefLabel "working population engaged in agriculture"@en .

<http://www.eionet.europa.eu/gemet/concept/13342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10837> ;
    skos:prefLabel "leave on social grounds"@en .

<http://www.eionet.europa.eu/gemet/concept/1337> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:prefLabel "chemical treatment of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any by-product of a chemical process, including manufacturing processes. Often this by-product is considered a toxic or polluting substance."@en ;
    skos:prefLabel "chemical waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9267> ;
    skos:definition "Chemical agents of warfare include all gaseous, liquid or solid chemical substances which might be employed because of their direct toxic effects on man and animals. Chemical weapons also include the chemical's precursors, the munitions and devices designed to deliver them, and any equipment specifically designed for their use in warfare. Nerve agents (chemicals of the same family as organophosphorous insecticides) are the most lethal of the classical chemical warfare agents, killing by poisoning the nervous system and disrupting bodily functions. Other chemical weapons include blister agents, vesicants, choking agents, etc."@en ;
    skos:prefLabel "chemical weapon"@en .

<http://www.eionet.europa.eu/gemet/concept/1347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7930> ;
    skos:definition "The process of chemical adsorption."@en ;
    skos:prefLabel "chemisorption"@en .

<http://www.eionet.europa.eu/gemet/concept/135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6205> ;
    skos:definition "An image of the ground surface made on a light-sensitive material and taken at a high altitude from an aircraft, spacecraft or rocket."@en ;
    skos:prefLabel "aerial photograph"@en .

<http://www.eionet.europa.eu/gemet/concept/1355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1033> ;
    skos:definition "A vertical structure of brick, masonry, or steel that carries smoke or steam away from a fire, engine, etc."@en ;
    skos:prefLabel "chimney"@en .

<http://www.eionet.europa.eu/gemet/concept/13552> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "The sloping side of any hollow in the ground, especially when bordering a river."@en ;
    skos:prefLabel "bank (land)"@en .

<http://www.eionet.europa.eu/gemet/concept/13553> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "The process of removing forest produce, particularly timber, fuelwood and bamboos, from its place of growth to some permanent or major delivery point, either for further transport or further manufacture, i.e. secondary conversion, or both."@en ;
    skos:prefLabel "wood hauling"@en .

<http://www.eionet.europa.eu/gemet/concept/13555> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:definition "Compensation for the use of a person's property, based on an agreed percentage of the income arising from its use."@en ;
    skos:prefLabel "royalty"@en .

<http://www.eionet.europa.eu/gemet/concept/13556> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A formal written record of transactions, proceedings, etc., as of a society, committee, or legislative body."@en ;
    skos:prefLabel "chart (act)"@en .

<http://www.eionet.europa.eu/gemet/concept/13557> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/453> ;
    skos:definition "Waste matter discharged from the body of an animal."@en ;
    skos:prefLabel "animal excrement"@en .

<http://www.eionet.europa.eu/gemet/concept/13561> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The upkeep of industrial facilities and equipment."@en ;
    skos:prefLabel "maintenance (technical)"@en .

<http://www.eionet.europa.eu/gemet/concept/13562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "A portion of space within a commercial establishment that is used for applying coloring substances to certain products or materials, providing a decorative or protective coating."@en ;
    skos:prefLabel "paint room"@en .

<http://www.eionet.europa.eu/gemet/concept/13567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1513> ;
    skos:definition "A place where crystalline salt deposits are formed or found, such as a salt flat or pan, a salada, or a salt lick."@en ;
    skos:prefLabel "salina"@en .

<http://www.eionet.europa.eu/gemet/concept/13568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10905> ;
    skos:definition "A trail in the country along which one can walk, usually for pleasure or exercise."@en ;
    skos:prefLabel "hiking trail"@en .

<http://www.eionet.europa.eu/gemet/concept/13570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1955> ;
    skos:definition "Any device or structure that conducts excess water or sewage from a conduit or container."@en ;
    skos:prefLabel "overflow (outlet)"@en .

<http://www.eionet.europa.eu/gemet/concept/13572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "In plant propagation, young shoots or stems removed for the purpose of growing new plants by vegetatively rooting the cuttings."@en ;
    skos:prefLabel "cutting (vegetative propagation)"@en .

<http://www.eionet.europa.eu/gemet/concept/13576> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "An eco-balance refers to the consumption of energy and resources and the pollution caused by the production cycle of a given product. The product is followed throughout its entire life cycle, from the extraction of the raw materials, manufacturing and use, right through to recycling and final handling of waste."@en ;
    skos:prefLabel "eco-balance"@en .

<http://www.eionet.europa.eu/gemet/concept/13577> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5613> ;
    skos:definition "A colorless gas that, at room temperature, reacts with oxygen to form nitrogen dioxide; may be used to form other compounds."@en ;
    skos:prefLabel "nitrogen oxide"@en .

<http://www.eionet.europa.eu/gemet/concept/13613> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "An enclosed heated compartment usually lined with a refractory material used for drying substances, firing ceramics, heat-treating, etc."@en ;
    skos:prefLabel "oven"@en .

<http://www.eionet.europa.eu/gemet/concept/1362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Order of placental mammals comprising the bats having the front limbs modified as wings."@en ;
    skos:prefLabel "chiropteran"@en .

<http://www.eionet.europa.eu/gemet/concept/13639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/977> ;
    skos:prefLabel "bovine"@en .

<http://www.eionet.europa.eu/gemet/concept/1366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A compound which is derived from hydrochloric acid and contains the chlorine atom in the -1 oxidation state."@en ;
    skos:prefLabel "chloride"@en .

<http://www.eionet.europa.eu/gemet/concept/13697> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "approval"@en .

<http://www.eionet.europa.eu/gemet/concept/1371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "The application of chlorine to water, sewage or industrial wastes for disinfection or other biological or chemical purposes."@en ;
    skos:prefLabel "chlorination"@en .

<http://www.eionet.europa.eu/gemet/concept/1373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2642> ;
    skos:definition "A very reactive and highly toxic green, gaseous element, belonging to the halogen family of substances. It is one of the most widespread elements, as it occurs naturally in sea-water, salt lakes and underground deposits, but usually occurs in a safe form as common salt (NaCl). Commercially it is used in large quantities by the chemical industry both as an element to produce chlorinated organic solvents, like polychlorinated biphenyls (PCBs), and for the manufacture of polyvinyl chloride plastics, thermoplastic and hypochlorite bleaches. Chlorine was the basis for the organochlorine pesticides, like DDT and other agricultural chemicals that have killed wildlife. The reactivity of chlorine has proved disastrous for the ozone layer and has been the cause of the creation of the ozone hole, which was first detected in the Southern Hemisphere over Antarctica and then over the Northern Hemisphere."@en ;
    skos:prefLabel "chlorine"@en .

<http://www.eionet.europa.eu/gemet/concept/13748> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1422> ;
    skos:definition """1) Part of a city at or near the centre, especially a slum area where poor people live in bad housing.
2) City centres of many industrialized countries which exhibit environmental degradation. The numerous and highly competitive activities entailing land use overwhelm the limited space and create a situation of overcrowding, functional incompatibility and cultural degradation. Inner city areas have a high level of commercial specialization, a large number of offices and a sizeable daytime population. At the same time, city centres generally remain a sort of ghetto for a permanent, low-income population living in run-down housing and enjoying little in the way of public services and civic amenities. The concentration of service industries inevitably entails the replacement of traditional housing and shops by office blocks, the provision of basic utilities at the expense of civic amenities and the provision of major access roads which eat up urban space. Structures of historic origin are often unable to meet modern requirements and, notwithstanding their value, frequently face demolition."""@en ;
    skos:prefLabel "inner city"@en .

<http://www.eionet.europa.eu/gemet/concept/13781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7742> ;
    skos:definition "A valve or gate fitted to a sluice to control the rate of flow of water."@en ;
    skos:prefLabel "sluice-gate"@en .

<http://www.eionet.europa.eu/gemet/concept/1384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6709> ;
    skos:definition "An interdiction on the manufacture or use of products that discharge chlorofluorocarbons and bromine-containing compounds into the atmosphere, thereby contributing to the depletion of the ozone layer."@en ;
    skos:prefLabel "CFC and halons prohibition"@en .

<http://www.eionet.europa.eu/gemet/concept/1385> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1381> ;
    skos:definition "Hydrocarbons whose hydrogen atoms have been partially substituted with chlorine and fluorine. They are used in refrigeration, air conditioning, packaging, insulation, or as solvents and aerosol propellants. Because they are not destroyed in the lower atmosphere they drift into the upper atmosphere where their chlorine components destroy ozone."@en ;
    skos:prefLabel "partially halogenated chlorofluorohydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/1391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "A green pigment, present in algae and higher plants, that absorbs light energy and thus plays a vital role in photosynthesis. Except in Cyanophyta (blue-green algae), chlorophyll is confined to chloroplasts. There are several types of chlorophyll, but all contain magnesium and iron. Some plants (e.g., brown algae, red algae, copper beech trees) contain additional pigments that masks the green of their chlorophyll."@en ;
    skos:prefLabel "chlorophyll"@en .

<http://www.eionet.europa.eu/gemet/concept/13921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9349> ;
    skos:prefLabel "deciduous wood"@en .

<http://www.eionet.europa.eu/gemet/concept/13922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9349> ;
    skos:prefLabel "mixed woodland"@en .

<http://www.eionet.europa.eu/gemet/concept/1393> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6304> ;
    skos:definition "A disease condition of green plants seen as yellowing of green parts of the plants."@en ;
    skos:prefLabel "chlorosis"@en .

<http://www.eionet.europa.eu/gemet/concept/13937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7411> ;
    skos:definition "Punishment for the commission of a specific crime, such as fines, restitution, probation and imprisonment."@en ;
    skos:prefLabel "penal sanction"@en .

<http://www.eionet.europa.eu/gemet/concept/13976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:prefLabel "coniferous tree"@en .

<http://www.eionet.europa.eu/gemet/concept/1399> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The analysis of chemical substances that are poured into a vertical glass tube containing an adsorbent where the various components of the substance move through the adsorbent at different rates of speed according to their degree of attraction to it, thereby producing bands of color at different levels of the adsorption column."@en ;
    skos:prefLabel "chromatographic analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/1401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A hard grey metallic element that takes a high polish, occurring principally in chromite: used in steel alloys and electroplating to increase hardness and corrosion-resistance."@en ;
    skos:prefLabel "chromium"@en .

<http://www.eionet.europa.eu/gemet/concept/14082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10898> ;
    skos:definition "Housing or dwelling space provided for victims of a sudden, urgent and usually unexpected occurrence, especially when harm has been done to human life, property or the environment."@en ;
    skos:prefLabel "emergency lodging"@en .

<http://www.eionet.europa.eu/gemet/concept/14098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9116> ;
    skos:definition "The classification and separation of solid waste, according to type, at the location where it is generated."@en ;
    skos:prefLabel "sorting at source"@en .

<http://www.eionet.europa.eu/gemet/concept/1410> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A building for religious activities."@en ;
    skos:prefLabel "church"@en .

<http://www.eionet.europa.eu/gemet/concept/14146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4614> ;
    skos:definition "Measures by way of planning, prior approval of works, prohibition of some activities, physical structures, and restoration efforts to protect the coastline against the ravages of nature and haphazard and unplanned developments."@en ;
    skos:prefLabel "coastal management"@en .

<http://www.eionet.europa.eu/gemet/concept/14163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5686> ;
    skos:definition "Any structure or edifice occupied by a body of top government administrators or other high ranking public officials selected or appointed by a head of state to manage certain aspects of a state's affairs."@en ;
    skos:prefLabel "ministry building"@en .

<http://www.eionet.europa.eu/gemet/concept/14165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13123> ;
    skos:prefLabel "aerial photography"@en .

<http://www.eionet.europa.eu/gemet/concept/14236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1746> ;
    skos:definition "Container whose return from the consumer or final user is assured by specific means (separate collection, deposits, etc.), independently on its final destination, in order to be reused, recovered or subjected to specific waste management operations."@en ;
    skos:prefLabel "returnable container"@en .

<http://www.eionet.europa.eu/gemet/concept/14243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6407> ;
    skos:definition "The process of breaking up and producing a diffuse distribution of the unusable aeriform fluid or suspension of fine particles in air resulting from a manufacturing process or the burning of a substance in an enclosed area."@en ;
    skos:prefLabel "waste gas dispersion"@en .

<http://www.eionet.europa.eu/gemet/concept/14245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Product that has undergone a partial processing and is used as raw material in a successive productive step."@en ;
    skos:prefLabel "intermediate product"@en .

<http://www.eionet.europa.eu/gemet/concept/14254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Agents that induce a permanent change in the genetic material."@en ;
    skos:prefLabel "mutagenic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/1426> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "Place where a town's refuse is disposed of after it has been collected."@en ;
    skos:prefLabel "municipal dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Life common to the majority of animal and plants species requiring the presence of oxygen."@en ;
    skos:prefLabel "aerobic condition"@en .

<http://www.eionet.europa.eu/gemet/concept/1431> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/282> ;
    skos:definition "Air traffic pertaining to or serving the general public, as distinguished from military air traffic."@en ;
    skos:prefLabel "civil air traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/14330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Substances capable of causing abnormal development of the embryo and congenital malformations."@en ;
    skos:prefLabel "teratogenic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/1434> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The planning, design, construction, and maintenance of fixed structures and ground facilities for industry, transportation, use and control of water or occupancy."@en ;
    skos:prefLabel "civil engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/1436> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:definition "The organization and measures, usually under governmental or other authority depending on the country, aimed at preventing, abating or fighting major emergencies for the protection of the civilian population and property, particularly in wartime."@en ;
    skos:prefLabel "civilian protection"@en .

<http://www.eionet.europa.eu/gemet/concept/14418> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "System of heating all houses in a urban district from a central source (as from hot springs in Iceland or by cooling water from a power station)."@en ;
    skos:prefLabel "municipal heating network"@en .

<http://www.eionet.europa.eu/gemet/concept/1445> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A legal remedy in which a person or party may demand or assert the right to be restored to a former or original position prior to loss, damage or injury."@en ;
    skos:prefLabel "claim for restitution"@en .

<http://www.eionet.europa.eu/gemet/concept/1446> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6637> ;
    skos:definition "Legal action initiated by a single person or a few people on behalf of a group with similar claim or claims."@en ;
    skos:prefLabel "class action suits law"@en .

<http://www.eionet.europa.eu/gemet/concept/1449> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7298> ;
    skos:definition "A loose, earthy, extremely fine-grained, natural sediment or soft rock composed primarily of clay-size or colloidal particles and characterized by high plasticity and by a considerable content of clay mineral and subordinate amounts of finely divided quartz, decomposed feldspar, carbonates, ferruginous matter, and other impurities; it forms a plastic, moldable mass when finely ground and mixed with water, retains its shape on drying, and becomes firm, rocklike and permanently hard on heating or firing."@en ;
    skos:prefLabel "clay"@en .

<http://www.eionet.europa.eu/gemet/concept/14499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8307> ;
    skos:prefLabel "excise"@en .

<http://www.eionet.europa.eu/gemet/concept/14507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:prefLabel "dipteran"@en .

<http://www.eionet.europa.eu/gemet/concept/14543> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9349> ;
    skos:prefLabel "coniferous wood"@en .

<http://www.eionet.europa.eu/gemet/concept/1456> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The process of bringing desert, marsh, sea coast or other waste or unproductive land into use or cultivation."@en ;
    skos:prefLabel "cleaning up"@en .

<http://www.eionet.europa.eu/gemet/concept/1457> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5428> ;
    skos:definition "A division, usually within municipal government, responsible for providing services that remove dirt, litter or other unsightly materials from city or town property."@en ;
    skos:prefLabel "cleansing department"@en .

<http://www.eionet.europa.eu/gemet/concept/14581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6942> ;
    skos:definition "An electric passenger railway operated in underground tunnels."@en ;
    skos:prefLabel "underground railway"@en .

<http://www.eionet.europa.eu/gemet/concept/14588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13269> ;
    skos:prefLabel "government contracting"@en .

<http://www.eionet.europa.eu/gemet/concept/146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/812> ;
    skos:definition "A process requiring the presence of oxygen."@en ;
    skos:prefLabel "aerobic process"@en .

<http://www.eionet.europa.eu/gemet/concept/1460> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Industrial process which causes little or no pollution."@en ;
    skos:prefLabel "clean technology"@en .

<http://www.eionet.europa.eu/gemet/concept/14602> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "An organism that has undergone external processes by which its basic set of genes has been altered."@en ;
    skos:prefLabel "genetically modified organism"@en .

<http://www.eionet.europa.eu/gemet/concept/14615> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8598> ;
    skos:definition "The activity of rowing, sailing or using a boat over a particular region of water, for amusement or enjoyment."@en ;
    skos:prefLabel "pleasure cruising"@en .

<http://www.eionet.europa.eu/gemet/concept/14619> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Any soluble substance composed of two or more unlike atoms held together by chemical bonds that reduces interfacial tension between liquids or a liquid and a solid, often used as detergents, wetting agents and emulsifiers."@en ;
    skos:prefLabel "surface active compound"@en .

<http://www.eionet.europa.eu/gemet/concept/14636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/48> ;
    skos:prefLabel "pH-value"@en .

<http://www.eionet.europa.eu/gemet/concept/14651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1850> ;
    skos:prefLabel "craft industry"@en .

<http://www.eionet.europa.eu/gemet/concept/14652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/453> ;
    skos:definition "Any substances or components left over from animal life, including body parts and, later, decomposed materials."@en ;
    skos:prefLabel "animal remain"@en .

<http://www.eionet.europa.eu/gemet/concept/14663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:definition "A map for navigation that delineates a portion of the sea, indicating the outline of the coasts and the position of rocks, sandbanks and other parts of a sea."@en ;
    skos:prefLabel "chart (nautical)"@en .

<http://www.eionet.europa.eu/gemet/concept/1467> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:prefLabel "climate resource"@en .

<http://www.eionet.europa.eu/gemet/concept/14671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6376> ;
    skos:prefLabel "nature conservation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1464> ;
    skos:definition "The slow variation of climatic characteristics over time at a given place. This may be indicated by the geological record in the long term, by changes in the landforms in the intermediate term, and by vegetation changes in the short term."@en ;
    skos:prefLabel "climate alteration"@en .

<http://www.eionet.europa.eu/gemet/concept/1473> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7702> ;
    skos:definition "Experiments conducted to estimate future climatic conditions employing modelling of the physical processes underlying climatic change and variability; also, assessments are required of uncertain future man-made inputs such as increasing atmospheric carbon dioxide and other green-house gases."@en ;
    skos:prefLabel "climate experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The study of the atmospheric dispersal of airborne fungus spores, pollen grains, and microorganisms; and, more broadly, of airborne propagules of algae and protozoans, minute insects such as aphids, and pollution gases and particles which exert specific biologic effects."@en ;
    skos:prefLabel "aerobiology"@en .

<http://www.eionet.europa.eu/gemet/concept/1480> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "A botanical term referring to the terminal community said to be achieved when a sere (a sequential development of a plant community or group of plant communities on the same site over a period of time) achieves dynamic equilibrium with its environment and in particular with its prevailing climate. Each of the world's major vegetation climaxes is equivalent to a biome. Many botanists believe that climate is the master factor in a plant environment and that even if several types of plant succession occur in an area they will all tend to converge towards a climax form of vegetation."@en ;
    skos:prefLabel "climax"@en .

<http://www.eionet.europa.eu/gemet/concept/1481> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "A plant that lacks rigidity and grows upwards by twining, scrambling, or clinging with tendrils and suckers."@en ;
    skos:prefLabel "climbing plant (wall)"@en .

<http://www.eionet.europa.eu/gemet/concept/1482> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232>,
        <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:definition "Any objective evidence of disease or of a patient's condition founded on clinical observation."@en ;
    skos:prefLabel "clinical symptom"@en .

<http://www.eionet.europa.eu/gemet/concept/14835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:prefLabel "green fiscal instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/1484> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "The production of genetically identical individuals from a single parent. Cloning plants usually involves plant cell culture. Cloning animals is more difficult and relays on some manipulation of their normal reproductive cycle. A clone is a group of organisms of identical genetic constitution, unless mutation occurs, produced from a single individual by asexual reproduction, parthenogenesis or apomixis."@en ;
    skos:prefLabel "cloning"@en .

<http://www.eionet.europa.eu/gemet/concept/14842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2413> ;
    skos:prefLabel "Black Sea"@en .

<http://www.eionet.europa.eu/gemet/concept/14843> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9294> ;
    skos:prefLabel "Caspian Sea"@en .

<http://www.eionet.europa.eu/gemet/concept/14844> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5145> ;
    skos:definition "The largest inland sea between Europe, Africa and Asia, linked to the Atlantic Ocean at its western end by the Strait of Gibraltar, including the Tyrrhenian, Adriatic, Aegean and Ionian seas, and major islands such as Sicily, Sardina, Corsica, Crete, Malta and Cyprus."@en ;
    skos:prefLabel "Mediterranean Sea"@en .

<http://www.eionet.europa.eu/gemet/concept/14845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8579> ;
    skos:definition "Local knowledge that is unique to a given culture or society, which is the basis for local-level decision making in agriculture, health care, education and other matters of concern in rural communities."@en ;
    skos:prefLabel "indigenous knowledge"@en .

<http://www.eionet.europa.eu/gemet/concept/14847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "A group of persons engaged in the same profession, business, trade or craft that is organized or formally structured to attain common ends."@en ;
    skos:prefLabel "professional society"@en .

<http://www.eionet.europa.eu/gemet/concept/14849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5902> ;
    skos:definition "Organic pollutants that do not break down chemically and remain in the environment. Pollutants with higher persistence may produce more harmful environmental effects."@en ;
    skos:prefLabel "persistant organic pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/14850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3488> ;
    skos:definition "The transport or setting in motion by wind or water of insoluble particulate matter."@en ;
    skos:prefLabel "sediment mobilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/14852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:prefLabel "land-based activity"@en .

<http://www.eionet.europa.eu/gemet/concept/14854> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:prefLabel "sectoral assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/14857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Data delimiting a given object, either physical or conceptual, in terms of its spatial relationship to the land, usually consisting of points, lines, areas or volumes defined in terms of some coordinate system."@en ;
    skos:prefLabel "geo-referenced information"@en .

<http://www.eionet.europa.eu/gemet/concept/14858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2285> ;
    skos:definition "An organization established primarily to acquire, analyze, process, store, retrieve, and disseminate one or more types of data."@en ;
    skos:prefLabel "data centre"@en .

<http://www.eionet.europa.eu/gemet/concept/14859> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14940> ;
    skos:definition "A business or organization that supplies connections to a part of the Internet, often through telephone lines."@en ;
    skos:prefLabel "internet service provider"@en .

<http://www.eionet.europa.eu/gemet/concept/14860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13060> ;
    skos:definition "A system of interrelated computer and telecommunications devices linked to permit the exchange of data in digital or analog signals."@en ;
    skos:prefLabel "electronic information network"@en .

<http://www.eionet.europa.eu/gemet/concept/14861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13060> ;
    skos:definition "A system of interrelated computer and telecommunications devices linking two or more computers separated by a great distance for the exchange of electronic data."@en ;
    skos:prefLabel "wide area network"@en .

<http://www.eionet.europa.eu/gemet/concept/14863> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "A graphical, interactive, hypertext information system that is cross-platform and can be run locally or over the global Internet. The Web consists of Web servers offering pages of information to Web browsers who view and interact with the pages. Pages can contain formatted text, background colors, graphics, as well as audio and video clips. Simple links in a Web page can cause the browser to jump to a different part of the same page or to a page on a Web server halfway around the world. Web pages can be used to send mail, read news, and download files. A Web address is called a URL."@en ;
    skos:prefLabel "World Wide Web"@en .

<http://www.eionet.europa.eu/gemet/concept/14864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "The preset document that is displayed after starting a World Wide Web browser, or the main World Wide Web document in a series of related documents."@en ;
    skos:prefLabel "homepage"@en .

<http://www.eionet.europa.eu/gemet/concept/14865> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "The organization of information units typically containing visible links that users can select or click with a mouse pointer or some other computer device to automatically retrieve or display other documents."@en ;
    skos:prefLabel "hypertext"@en .

<http://www.eionet.europa.eu/gemet/concept/14866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "An assemblage of computer hardware and software that can be linked by computer modem dialing for the purpose of sharing or exchanging messages or other files."@en ;
    skos:prefLabel "bulletin board system"@en .

<http://www.eionet.europa.eu/gemet/concept/14867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "A discussion group on a specific topic maintained on a computer network, frequently on the Internet."@en ;
    skos:prefLabel "newsgroup"@en .

<http://www.eionet.europa.eu/gemet/concept/14868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14862> ;
    skos:definition "Information or computer stored messages that are transmitted or exchanged from one computer terminal to another, through telecommunication."@en ;
    skos:prefLabel "electronic mail"@en .

<http://www.eionet.europa.eu/gemet/concept/14869> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4313> ;
    skos:definition "Any technical means used to combine text, sound, still or animated images and video in computers and electronic products, often allowing audience interactivity."@en ;
    skos:prefLabel "multimedia technology"@en .

<http://www.eionet.europa.eu/gemet/concept/1487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1486> ;
    skos:definition "The termination or shutdown, temporary or permanent, of a corporation, factory or some other business organization."@en ;
    skos:prefLabel "closing down of firm"@en .

<http://www.eionet.europa.eu/gemet/concept/14870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/658> ;
    skos:definition "An exhibition, performance, demonstration or lecture utilizing communication media directed at both the sense of sight and the sense of hearing."@en ;
    skos:prefLabel "audio-visual presentation"@en .

<http://www.eionet.europa.eu/gemet/concept/14871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13313> ;
    skos:definition "A set or collection of materials compiled to convey knowledge on some subject and usually placed in some type of container."@en ;
    skos:prefLabel "information kit"@en .

<http://www.eionet.europa.eu/gemet/concept/14872> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7679> ;
    skos:definition "A display of an object or collection of objects for general dissemination of information, aesthetic value or entertainment."@en ;
    skos:prefLabel "exhibit"@en .

<http://www.eionet.europa.eu/gemet/concept/14873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A printed periodical bulletin circulated to members of a group."@en ;
    skos:prefLabel "newsletter"@en .

<http://www.eionet.europa.eu/gemet/concept/14874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6901> ;
    skos:definition "A performance or production transmitted in sound signals with electromagnetic waves."@en ;
    skos:prefLabel "radio programme"@en .

<http://www.eionet.europa.eu/gemet/concept/14875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8353> ;
    skos:definition "A performance or production transmitted in audiovisual signals with electromagnetic waves."@en ;
    skos:prefLabel "television programme"@en .

<http://www.eionet.europa.eu/gemet/concept/14876> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "The methods and activities employed by an individual, organization, corporation, or government to promote a favourable relationship with the public."@en ;
    skos:prefLabel "public relations"@en .

<http://www.eionet.europa.eu/gemet/concept/14878> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources organized for the exchange of data pertaining to the history, physical description, comparison, and classification of books and other works."@en ;
    skos:prefLabel "bibliographic information system"@en .

<http://www.eionet.europa.eu/gemet/concept/14879> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Data pertaining to the history, physical description, comparison, and classification of books and other works."@en ;
    skos:prefLabel "bibliographic information"@en .

<http://www.eionet.europa.eu/gemet/concept/14880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources organized to provide directions leading people to sources known to provide knowledge or assistance on a specified topic or request."@en ;
    skos:prefLabel "referral information system"@en .

<http://www.eionet.europa.eu/gemet/concept/14881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Directions leading someone to another source that is known to provide knowledge or assistance on the specified topic or request."@en ;
    skos:prefLabel "referral information"@en .

<http://www.eionet.europa.eu/gemet/concept/14882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources enabling the exchange of numerical data that has been collected, classified or interpreted for analysis."@en ;
    skos:prefLabel "statistical information system"@en .

<http://www.eionet.europa.eu/gemet/concept/14883> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Knowledge pertaining to the collection, classification, analysis and interpretation of numerical data."@en ;
    skos:prefLabel "statistical information"@en .

<http://www.eionet.europa.eu/gemet/concept/14885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The provision of aid by library staff trained to interpret library materials and library organizational structures to meet the informational, educational, cultural, recreational or research needs of the library's clients."@en ;
    skos:prefLabel "reference service"@en .

<http://www.eionet.europa.eu/gemet/concept/14886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "A service which creates a special contents list, containing titles, authors, abstracts, subject headings and other information, to describe a large number of publications and to be used in searchable, machine-readable (or printed) look-up tables."@en ;
    skos:prefLabel "indexing of documentation"@en .

<http://www.eionet.europa.eu/gemet/concept/14887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The service provided by a library in which the library's clients are temporarily allowed to use books and other printed materials outside the library."@en ;
    skos:prefLabel "document lending"@en .

<http://www.eionet.europa.eu/gemet/concept/14888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The service provided by one library in which a second library's clients are temporarily allowed to use books and other printed materials belonging to the first library; and consequently the system providing rules and infrastructure for this service to a group of libraries."@en ;
    skos:prefLabel "inter-library loan"@en .

<http://www.eionet.europa.eu/gemet/concept/14889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14896> ;
    skos:definition "A service provided by a library or other agency that periodically notifies users of new publications, report literature or other data sources in subjects in which the user has specified an interest."@en ;
    skos:prefLabel "selective dissemination of information"@en .

<http://www.eionet.europa.eu/gemet/concept/1489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Clothes considered as a group."@en ;
    skos:prefLabel "clothing"@en .

<http://www.eionet.europa.eu/gemet/concept/14890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The provision of special aid by library staff trained to query bibliographic or other information contained on an electronic storage medium, usually to meet the research needs of the library's clients."@en ;
    skos:prefLabel "CD-ROM search service"@en .

<http://www.eionet.europa.eu/gemet/concept/14891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14884> ;
    skos:definition "The provision of special aid by library staff trained to query bibliographic or other information contained on the Internet, a large distributed electronic system, usually to meet the research needs of the library's clients."@en ;
    skos:prefLabel "internet search service"@en .

<http://www.eionet.europa.eu/gemet/concept/14892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4310> ;
    skos:definition "A central institution or agency for the collection, maintenance, and distribution of materials or data compiled to convey knowledge on some subject."@en ;
    skos:prefLabel "information clearing-house"@en .

<http://www.eionet.europa.eu/gemet/concept/14893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources that analyzes, typically, business data and presents it so that users can make business decisions more easily."@en ;
    skos:prefLabel "decision-support system"@en .

<http://www.eionet.europa.eu/gemet/concept/14894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4340> ;
    skos:prefLabel "software development"@en .

<http://www.eionet.europa.eu/gemet/concept/14897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1979> ;
    skos:definition "A collection of digital information items organized as a set of formally described tables from which the information can be accessed or reassembled in different ways without reorganizing the tables."@en ;
    skos:prefLabel "relational database"@en .

<http://www.eionet.europa.eu/gemet/concept/14898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A remote sensing term referring to a scanning radiometer that simultaneously acquires images in various wavebands at the same time. A multispectral scanner can be carried aboard an aircraft or satellite. The Landsat multispectral scanner records images in four wavebands of visible and near infrared electromagnetic radiation to enable objects with different reflectance properties to be distinguished."@en ;
    skos:prefLabel "multispectral scanner"@en .

<http://www.eionet.europa.eu/gemet/concept/14899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A remote sensing term which has three separate applications: a) spatial resolution, which refers to the ability of a sensor to distinguish between objects that are spatially close to each other. It is a measure of the smallest angular or linear separation between two objects. b) Spectral resolution which refers to the ability of a sensor to distinguish between objects which are spectrally similar. It is a measure of both the discreteness of wavebands and the sensitivity of the sensor to distinguish between electromagnetic radiation intensity levels. c) Thermal resolution which refers to the ability of a sensor to distinguish between objects with a similar temperature."@en ;
    skos:prefLabel "resolution (parameter)"@en .

<http://www.eionet.europa.eu/gemet/concept/1490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "clothing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/14900> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A contraction of the words 'picture element'. The smallest unit of information in an image or raster map. Referred to as a resolution cell in an image or grid."@en ;
    skos:prefLabel "pixel"@en .

<http://www.eionet.europa.eu/gemet/concept/14901> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Closely grouped bands of lines characteristic of molecular gases of chemical compounds (spectroscopy)."@en ;
    skos:prefLabel "spectral band"@en .

<http://www.eionet.europa.eu/gemet/concept/14902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A numeric string which uniquely identifies an image component of a geographical information system database."@en ;
    skos:prefLabel "scene identification"@en .

<http://www.eionet.europa.eu/gemet/concept/14903> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3645> ;
    skos:definition "A coordinated assemblage of computer devices designed to capture and manipulate pictures stored as data in discrete, quantized units or digits."@en ;
    skos:prefLabel "image processing digital system"@en .

<http://www.eionet.europa.eu/gemet/concept/14905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A remote sensing term referring to an automated process through which unidentified patterns can be classified into a limited number of discrete classes through comparison with other class-defining patterns or characteristics. Pattern recognition is an essential part of the classification of remotely sensed images and is used as an aid to image interpretation."@en ;
    skos:prefLabel "pattern recognition"@en .

<http://www.eionet.europa.eu/gemet/concept/14906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6205> ;
    skos:definition "A composite photograph consisting of separate aerial photographs of overlapping surface areas, producing an overall image of a surface area too large to be depicted in a single aerial photograph."@en ;
    skos:prefLabel "mosaic"@en .

<http://www.eionet.europa.eu/gemet/concept/14907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "A remote sensing term related to image enhancement that refers to the removal of a spatial component of electromagnetic radiation."@en ;
    skos:prefLabel "image filtering"@en .

<http://www.eionet.europa.eu/gemet/concept/14908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "In remote sensing, the filtering of data and other processes to manipulate pixels to produce an image that accentuates features of interest or visual interpretation."@en ;
    skos:prefLabel "image enhancement"@en .

<http://www.eionet.europa.eu/gemet/concept/14909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14904> ;
    skos:definition "A remote sensing term referring to the adjustment of an image for geometric errors."@en ;
    skos:prefLabel "geometric correction"@en .

<http://www.eionet.europa.eu/gemet/concept/1491> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "Suspensions of minute water droplets or ice crystals produced by the condensation of water vapour."@en ;
    skos:prefLabel "cloud"@en .

<http://www.eionet.europa.eu/gemet/concept/14910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "The process of linking map coordinates to control points with known earth-surface coordinates. Related term: coordinate systems."@en ;
    skos:prefLabel "image registration"@en .

<http://www.eionet.europa.eu/gemet/concept/14912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14911> ;
    skos:definition "A graphical representation processing technique by which an analyst selects groups of pixels, determines their spectral response signature and trains a computer system to recognize pixels based on this spectral response pattern."@en ;
    skos:prefLabel "supervised image classification"@en .

<http://www.eionet.europa.eu/gemet/concept/14913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14911> ;
    skos:definition "Unsupervised classification is a kind of classification which takes place with minimum input from the operator; no training sample is available and subdivision of the feature space is achieved by identifying natural groupings of the measurement vectors."@en ;
    skos:prefLabel "unsupervised image classification"@en .

<http://www.eionet.europa.eu/gemet/concept/14914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A remote-sensing term referring to the process of assigning different colours to different spectral bands. The colour picture formed by this process is called a \"colour composite\" (a colour image produced through optical combination of multiband images by projection through filters) and is produced by assigning a colour to an image of the Earth's surface recorded in a particular waveband. For a Landsat colour composite, the green waveband is coloured blue, the red waveband is coloured green and the infrared waveband is coloured red. This produces an image closely approximating a false colour photograph. Colour composite images are easier to interpret than separate images recording different wavebands. US national experimental crop inventories are based upon visual interpretation of Landsat colour composites."@en ;
    skos:prefLabel "colour composition"@en .

<http://www.eionet.europa.eu/gemet/concept/14915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "The removal from the remotely sensed data of the atmospheric effects caused by the scattering and absorption of sunlight by particles; the removal of these effects improves not only the quality of the observed earth surface imaging but also the accuracy of classification of the ground objects."@en ;
    skos:prefLabel "atmospheric correction"@en .

<http://www.eionet.europa.eu/gemet/concept/14916> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3645> ;
    skos:definition "An organized collection of computer hardware, software, geographic data, and personnel designed to efficiently capture, store, update, manipulate, analyze, and display all forms of geographically referenced information that can be drawn from different sources, both statistical and mapped."@en ;
    skos:prefLabel "GIS digital system"@en .

<http://www.eionet.europa.eu/gemet/concept/14917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14933> ;
    skos:definition "The digital form of data collected by remote sensing."@en ;
    skos:prefLabel "GIS digital format"@en .

<http://www.eionet.europa.eu/gemet/concept/14918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "One of the two major types of internal data organization used in GIS. Vector systems are based primarily on coordinate geometry and take advantage of the convenient division of spatial data into point, line, and polygon types. Vector structures are especially suited to storing definitions of spatial objects for which sharp boundaries exist or can be imposed."@en ;
    skos:prefLabel "vector"@en .

<http://www.eionet.europa.eu/gemet/concept/14919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A position on a reference system determined by a survey."@en ;
    skos:prefLabel "point"@en .

<http://www.eionet.europa.eu/gemet/concept/14920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Term used in GIS technologies in the vector type of internal data organization: spatial data are divided into point, line and polygon types. In most cases, point entities (nodes) are specified directly as coordinate pairs, with lines (arcs or edges) represented as chains of points. Regions are similarly defined in terms of the lines which form their boundaries. Some vector GIS store information in the form of points, line segments and point pairs; others maintain closed lists of points defining polygon regions. Vector structures are especially suited to storing definitions of spatial objects for which sharp boundaries exist or can be imposed."@en ;
    skos:prefLabel "line"@en .

<http://www.eionet.europa.eu/gemet/concept/14921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "In the vector type of GIS internal data organization spatial data are conveniently divided into point, line and polygon types. Some vector GIS store information in the form of points, line segments and point pairs; others maintain close lists of points defining polygon regions."@en ;
    skos:prefLabel "polygon"@en .

<http://www.eionet.europa.eu/gemet/concept/14922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "One of the two major types of internal data organization used in GIS. Raster systems superimpose a regular grid over the area of interest and associate each cell-or pixel, to use the image term- with one or more data records. The values associated with each grid cell may represent either real values or any scalar or nominal data values associated with the cell coordinates. Among the strengths of the raster method is its ability to accept data directly from remote sensing systems and to represent transitional information. Raster systems tend to be relatively storage-intensive and this imposes practical limits on the area of coverage, the resolution, or both of these. Capacity constraints are, however, becoming less significant as computer memory and storage become more powerful and as data compression techniques become more readily available."@en ;
    skos:prefLabel "raster"@en .

<http://www.eionet.europa.eu/gemet/concept/14923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A distinctive feature of an object. In mapping and GIS applications, the objects are points, lines, or polygons that represent features such as sampling locations, section corners (points); roads and streams (lines); lakes, forest and soil types (polygons). These attributes can be further divided into classes such as tree species Douglas-fir and ponderosa pine) for forest types and paved and gravel for road types. Multiple attributes are generally associated with objects that are located on a single map layer."@en ;
    skos:prefLabel "attribute"@en .

<http://www.eionet.europa.eu/gemet/concept/14925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A process used to estimate an intermediate value of one (dependent) variable which is a function of a second (independent) variable when values of the dependent variable corresponding to several discrete values of the independent variable are known."@en ;
    skos:prefLabel "interpolation"@en .

<http://www.eionet.europa.eu/gemet/concept/14926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "A system of uniformly spaced perpendicular lines and horizontal lines running north and south, and east and west on a map, chart, or aerial photograph; used in locating points."@en ;
    skos:prefLabel "gridding"@en .

<http://www.eionet.europa.eu/gemet/concept/14927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "Methods to convert remotely sensed raster data to vector format. A number of raster-to-vector and vector-to-raster conversion procedures have been developed and introduced to current releases of many GIS packages."@en ;
    skos:prefLabel "raster to vector"@en .

<http://www.eionet.europa.eu/gemet/concept/14928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "Methods to convert remotely sensed raster data to vector format. A number of vector-to-raster and raster-to-vector conversion procedures have been developed and introduced to current releases of many GIS packages."@en ;
    skos:prefLabel "vector to raster"@en .

<http://www.eionet.europa.eu/gemet/concept/14932> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14931> ;
    skos:definition "A limit or border of a geographic area under the jurisdiction of some governmental or managerial entity."@en ;
    skos:prefLabel "administrative boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/14936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14935> ;
    skos:definition "An angular distance in degrees north or south of the equator (latitude 0°), equal to the angle subtended at the centre of the globe by the meridian between the equator and the point in question."@en ;
    skos:prefLabel "latitude"@en .

<http://www.eionet.europa.eu/gemet/concept/14937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14935> ;
    skos:definition "Distance in degrees east or west of the prime meridian at 0° measured by the angle between the plane of the prime meridian and that of the meridian through the point in question, or by the corresponding time difference."@en ;
    skos:prefLabel "longitude"@en .

<http://www.eionet.europa.eu/gemet/concept/14938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7129> ;
    skos:definition "Centre where remote sensing data are stored, handled and analyzed."@en ;
    skos:prefLabel "remote sensing centre"@en .

<http://www.eionet.europa.eu/gemet/concept/14939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4567> ;
    skos:definition "A laboratory where GIS data drawn from different sources are stored, handled, analyzed and updated."@en ;
    skos:prefLabel "GIS laboratory"@en .

<http://www.eionet.europa.eu/gemet/concept/14947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Any subterranean or below-ground site in which solid, or other, waste is deposited without environmental controls."@en ;
    skos:prefLabel "underground dump"@en .

<http://www.eionet.europa.eu/gemet/concept/14949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The art of purchasing and selling goods from an economics perspective or a perspective involving the scientific study of the production, distribution, and consumption of goods and services."@en ;
    skos:prefLabel "business economics"@en .

<http://www.eionet.europa.eu/gemet/concept/14951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Abandoned or disused dumps and refuse tips, stockpiles and landfill sites, disused petrol service stations, closed-down coking plants and former industrial and commercial premises, etc., from which considerable risks not only to the soil and to the groundwater, but also to humans and nature, can arise."@en ;
    skos:prefLabel "old hazardous site"@en .

<http://www.eionet.europa.eu/gemet/concept/14955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "Area out of closed settlements or building."@en ;
    skos:prefLabel "outer space (allocation plan)"@en .

<http://www.eionet.europa.eu/gemet/concept/14956> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "The most valuable of the marine mineral resources is petroleum. About 15% of the world's oil is produced offshore, and extraction capabilities are advancing. One of the largest environmental impacts of deep sea mining are discharged sediment plumes which disperse with ocean currents and thus may negatively influence the marine ecosystem. Coal deposits known as extensions of land deposits , are mined under the sea floor in Japan and England."@en ;
    skos:prefLabel "deep sea mining"@en .

<http://www.eionet.europa.eu/gemet/concept/14957> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:prefLabel "semi-liquid manure"@en .

<http://www.eionet.europa.eu/gemet/concept/14959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2587> ;
    skos:definition "Economic activity for manufacturing electric material and devices."@en ;
    skos:prefLabel "electrical goods industry"@en .

<http://www.eionet.europa.eu/gemet/concept/14962> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "Any treatment process in which contaminated water is cleansed or corrected, particularly by use of a pump-and-treat approach."@en ;
    skos:prefLabel "restoration of water"@en .

<http://www.eionet.europa.eu/gemet/concept/14964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "A person or business that specializes in the shipment and receiving of goods."@en ;
    skos:prefLabel "forwarding agent"@en .

<http://www.eionet.europa.eu/gemet/concept/14965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9008> ;
    skos:definition "All measures by which production and consumption processes are caused to generate less (or no waste), or to generate only those wastes that can be treated without causing problems."@en ;
    skos:prefLabel "waste avoidance"@en .

<http://www.eionet.europa.eu/gemet/concept/14966> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "The inviolable, moral claim of non-human organisms and their habitats to exist unharmed or unchanged by human activity as postulated by certain environmental ethicists."@en ;
    skos:prefLabel "natural independence law"@en .

<http://www.eionet.europa.eu/gemet/concept/14967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:definition "Unlawful acts against the environment, such as water contamination, hazardous waste disposal, air contamination, unpermitted installation of plants, oil spills, etc."@en ;
    skos:prefLabel "offence against the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/14968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:prefLabel "provincial/regional law (D)"@en .

<http://www.eionet.europa.eu/gemet/concept/14970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a government agency or its administrators to administer and implement laws and government policies applicable to a specific political subdivision or geographical area within the state."@en ;
    skos:prefLabel "provincial/regional authority (D)"@en .

<http://www.eionet.europa.eu/gemet/concept/14971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "Any agreement or act involving two or more countries in which  business dealings, negotiations or other affairs are settled or concluded."@en ;
    skos:prefLabel "international transaction"@en .

<http://www.eionet.europa.eu/gemet/concept/14972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7320> ;
    skos:definition "The establishing of boulevards, turnpikes, highways and other routes on land."@en ;
    skos:prefLabel "road setting"@en .

<http://www.eionet.europa.eu/gemet/concept/14973> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/631> ;
    skos:definition "Regular checking and recording of air quality in a given area. The following pollutants must be considered: carbon monoxide, benzene, butadiene, lead, sulphur dioxide, nitrogen dioxide, and particulates."@en ;
    skos:prefLabel "air quality monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/14974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/77> ;
    skos:prefLabel "citizen initiative"@en .

<http://www.eionet.europa.eu/gemet/concept/14975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12783> ;
    skos:definition "Areas that are flooded by rising number of tourists or other kinds of pressure and suffer from insufficient or inappropriate planning and management. Damage frequently arises from a lack of understanding or interest of the value of such sites."@en ;
    skos:prefLabel "area under stress"@en .

<http://www.eionet.europa.eu/gemet/concept/14982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "Any shelter or protection from distress or danger located in a predominantly mountainous area."@en ;
    skos:prefLabel "mountain refuge"@en .

<http://www.eionet.europa.eu/gemet/concept/14983> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Research involving studies of all aspects of environmental conditions beyond the atmosphere of the earth."@en ;
    skos:prefLabel "space research"@en .

<http://www.eionet.europa.eu/gemet/concept/14985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2917> ;
    skos:definition "The series of publications produced by the International Union for the Conservation of Nature and Natural Resources (IUCN). They provide an inventory on the threat to rare plants and animal species. Information includes status, geographical distribution, population size, habitat and breeding rate. The books also contain the conservation measures, if any, that have been taken to protect the species. There are five categories of rarity status: endangered species; vulnerable organisms, which are those unlikely to adapt to major environmental effects; rare organisms, which are those at risk because there are few of them in the world, such as plants which only grow on mountain peaks or on islands; out of danger species, which were formerly in the above categories, but have had the threat removed because of conservation actions; and indeterminate species, which are the plants and animals probably at risk, although not enough is known about them to assess their status."@en ;
    skos:prefLabel "red list"@en .

<http://www.eionet.europa.eu/gemet/concept/1499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A separation or precipitation from a dispersed state of suspensoid particles resulting from their growth; may result from prolonged heating, addition of an electrolyte, or from a condensation reaction between solute and solvent."@en ;
    skos:prefLabel "coagulation"@en .

<http://www.eionet.europa.eu/gemet/concept/1502> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1777> ;
    skos:definition "Power generated by the steam raised by burning coal in fire-tube or water-tube boilers."@en ;
    skos:prefLabel "coal-based energy"@en .

<http://www.eionet.europa.eu/gemet/concept/15027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Sizing or classifying particulate matter by suspension in a fluid (liquid or gas), the larger particulates tending to separate by sinking."@en ;
    skos:prefLabel "decantation"@en .

<http://www.eionet.europa.eu/gemet/concept/15028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3438> ;
    skos:prefLabel "wood resource"@en .

<http://www.eionet.europa.eu/gemet/concept/15029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13210> ;
    skos:prefLabel "fishing fleet"@en .

<http://www.eionet.europa.eu/gemet/concept/1503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power plant which is fuelled by coal."@en ;
    skos:prefLabel "coal-fired power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/15030> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:prefLabel "emission to air"@en .

<http://www.eionet.europa.eu/gemet/concept/15031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/270> ;
    skos:prefLabel "air quality impact"@en .

<http://www.eionet.europa.eu/gemet/concept/15032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1471> ;
    skos:prefLabel "climate change mitigation"@en .

<http://www.eionet.europa.eu/gemet/concept/15034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:prefLabel "alternative fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/15036> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1743> ;
    skos:prefLabel "material flow"@en .

<http://www.eionet.europa.eu/gemet/concept/15038> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:prefLabel "non-mineral waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2914> ;
    skos:prefLabel "waste prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/15040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:prefLabel "other waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15041> ;
    skos:definition "oven-dry weight of net annual increment (s.b) of a tree, stand or forest plus oven-dry weight of annual growth of branches, twigs, foliage, top and stump"@en ;
    skos:prefLabel "above-ground biomass growth"@en .

<http://www.eionet.europa.eu/gemet/concept/15043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "all living matter above-ground excluding trees with trees defined as generally five cm or greater diameter at breast height (4.3 feet above ground)"@en ;
    skos:prefLabel "above-ground non-tree biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15041>,
        <http://www.eionet.europa.eu/gemet/concept/15069>,
        <http://www.eionet.europa.eu/gemet/concept/15313>,
        <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "all living matter composed of trees defined as generally five cm or greater diameter at breast height (4.3 feet above ground)"@en ;
    skos:prefLabel "above-ground tree biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1466> ;
    skos:definition "The process of adjustment to actual or expected climate and its effects. In human systems, adaptation seeks to moderate or avoid harm or exploit beneficial opportunities. In some natural systems, human intervention may facilitate adjustment to expected climate and its effects."@en ;
    skos:prefLabel "adaptation strategy"@en .

<http://www.eionet.europa.eu/gemet/concept/15048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15248>,
        <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "any substance added to a fertiliser, soil improver or growing medium to improve the agronomic efficacy of the final product, or modify the environmental fate of the nutrients released by the fertilisers"@en ;
    skos:prefLabel "agronomic fertiliser additive"@en .

<http://www.eionet.europa.eu/gemet/concept/15049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15183>,
        <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition "joint EMEP/EEA guidebook supporting the reporting of emissions data, under the UNECE Convention on Long-range Transboundary Air Pollution (CLRTAP) and the EU National Emission Ceilings Directive, in providing expert guidance on how to compile an atmospheric emissions inventory"@en ;
    skos:prefLabel "air pollutant emission inventory guidebook"@en .

<http://www.eionet.europa.eu/gemet/concept/1505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3581> ;
    skos:definition "Process of conversion of coal to a gaseous product which is used as fuel in electric power stations."@en ;
    skos:prefLabel "coal gasification"@en .

<http://www.eionet.europa.eu/gemet/concept/15050> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "Directive that define the legislative basis for the assessment and management of air quality in Member States"@en ;
    skos:prefLabel "air quality directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7912> ;
    skos:definition "Ratio of the radiation (radiant or luminous energy) reflected by a surface to that incident on it."@en ;
    skos:prefLabel "albedo"@en .

<http://www.eionet.europa.eu/gemet/concept/15052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12011> ;
    skos:definition "any algae-based biofuel"@en ;
    skos:prefLabel "algae-based biofuel production"@en .

<http://www.eionet.europa.eu/gemet/concept/15053> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/270> ;
    skos:definition "The quality of outdoor air in our surrounding environment. It is typically measured near ground level, away from direct sources of pollution."@en ;
    skos:prefLabel "ambient air quality"@en .

<http://www.eionet.europa.eu/gemet/concept/15054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/394> ;
    skos:definition """A naturally occurring biochemical process in which organic
material is broken down by bacteria in an oxygen-free environment."""@en ;
    skos:prefLabel "anaerobic digestion"@en .

<http://www.eionet.europa.eu/gemet/concept/15056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "proper handling, storage, and utilization of wastes generated from animal confinement operations, including means of collecting, scraping, or washing wastes from confinement areas into appropriate waste storage structures"@en ;
    skos:prefLabel "animal waste management"@en .

<http://www.eionet.europa.eu/gemet/concept/15057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition """combination of structural and nonstructural practices
serving a feedlot that provides for the collection, treatment, storage or land applications of animal waste"""@en ;
    skos:prefLabel "animal waste management systems"@en .

<http://www.eionet.europa.eu/gemet/concept/15059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:definition "group of interacting organisms dependent on one another and their water environment for nutrients (e.g., nitrogen and phosphorus) and shelter"@en ;
    skos:prefLabel "aquatic system"@en .

<http://www.eionet.europa.eu/gemet/concept/1506> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The process of preparing a liquid mixture of hydrocarbons by destructive distillation of coal."@en ;
    skos:prefLabel "coal liquefaction"@en .

<http://www.eionet.europa.eu/gemet/concept/15060> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15204>,
        <http://www.eionet.europa.eu/gemet/concept/542> ;
    skos:definition ""@en ;
    skos:prefLabel "Arctic sea ice loss"@en .

<http://www.eionet.europa.eu/gemet/concept/15061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "total of built-up areas plus artificial non-built-up areas"@en ;
    skos:prefLabel "artificial land"@en .

<http://www.eionet.europa.eu/gemet/concept/15062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12008> ;
    skos:definition "suspensions of solids and/or liquid particles in the air that we breathe, as dust, smoke and haze, measured by the mass concentration of aerosol particles or by an optical measure"@en ;
    skos:prefLabel "atmospheric aerosol loading"@en .

<http://www.eionet.europa.eu/gemet/concept/15063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1168> ;
    skos:definition "primary source of carbon in life on Earth and its concentration in Earth's pre-industrial atmosphere since late in the Precambrian was regulated by photosynthetic organisms and geological phenomena"@en ;
    skos:prefLabel "atmospheric carbon dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/15064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15240>,
        <http://www.eionet.europa.eu/gemet/concept/5605> ;
    skos:definition "Atmospheric deposition or flux of total reactive nitrogen (N) to the Earth’s surface, calculated for example as kilograms N per hectare and year (kg N ha-1 yr-1). Reactive N from the atmosphere can be deposited as gases (= dry deposition) and in precipitation (= wet deposition). Total reactive N includes oxidised N compounds as well as reduced N compounds. Oxidised compounds are here mainly nitrogen oxides (NOx; gases) and nitrate (NO3-; in precipitation). The main reduced compounds are ammonia (NH3; gas) and ammonium (NH4+; in precipitation)"@en ;
    skos:prefLabel "atmospheric nitrogen load"@en .

<http://www.eionet.europa.eu/gemet/concept/15065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/543> ;
    skos:definition "area between Novaya Zemlia, in the east, and the line Norway–Bear Island–South Spitsbergen, in the west  area"@en ;
    skos:prefLabel "Barents Sea"@en .

<http://www.eionet.europa.eu/gemet/concept/15066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "rules laid down by the European Union (EU) for the monitoring, assessment and management of the quality of bathing water, and for the provision of information on that quality to reduce and prevent the pollution of bathing water and to inform European citizens of the degree of pollution"@en ;
    skos:prefLabel "bathing water directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15331>,
        <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "European legislation aimed at safeguarding public health and protecting the aquatic environment in coastal and inland areas from pollution"@en ;
    skos:prefLabel "bathing water legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/1507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "The technical and mechanical job of removing coal from the earth and preparing it for market."@en ;
    skos:prefLabel "coal mining"@en .

<http://www.eionet.europa.eu/gemet/concept/15070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15069>,
        <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "Growth in below-ground biomass including coarse roots and root collar"@en ;
    skos:prefLabel "below-ground biomass growth"@en .

<http://www.eionet.europa.eu/gemet/concept/15071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182>,
        <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition "ambient temperature under mild reaction conditions and use of special aerobic anaerobic microorganisms"@en ;
    skos:prefLabel "bio desulfurization"@en .

<http://www.eionet.europa.eu/gemet/concept/15072> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1198> ;
    skos:definition "The capacity of ecosystems to regenerate what people demand from those surfaces. The biocapacity of a particular surface represents its ability to renew what people demand. Biocapacity is therefore the ecosystems' capacity to produce biological materials used by people and to absorb waste material generated by humans, under current management schemes and extraction technologies. Biocapacity can change from year to year due to climate, management, and also what portions are considered useful inputs to the human economy."@en ;
    skos:prefLabel "biocapacity"@en .

<http://www.eionet.europa.eu/gemet/concept/15073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Planned management (i.e. preservation, maintenance, sustainable use, recovery, enhancement) of a natural resources or of a particular ecosystem to halt, reverse or slow-down the loss of biodiversity from impacts of exploitation, pollution etc. to ensure the future usability of the resource, resilience of communities, and ecosystem integrity."@en ;
    skos:prefLabel "biodiversity conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/15074> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "Long term or permanent qualitative or quantitative reduction in components of biodiversity and their potential to provide goods and services, to be measured at global, regional and national levels"@en ;
    skos:prefLabel "biodiversity loss"@en .

<http://www.eionet.europa.eu/gemet/concept/15075> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "conserving the resilience and vitality of natural ecosystems both for their intrinsic value and also for the benefits that they provide to human society as healthy ecosystems constitute our best defence against the worst extremes of weather associated with climate change"@en ;
    skos:prefLabel "biodiversity protection"@en .

<http://www.eionet.europa.eu/gemet/concept/15078> a skos:Concept ;
    skos:definition "The variability among living organisms from all sources including, inter alia, terrestrial, marine and other aquatic ecosystems and the ecological complexes of which they are part; this includes diversity within species, between species and of ecosystems"@en ;
    skos:prefLabel "biological diversity"@en .

<http://www.eionet.europa.eu/gemet/concept/15079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any organic matter in waste which can be broken down into carbon dioxide, water, methane or simple organic molecules by micro-organisms and other living things using composting, aerobic digestion, anaerobic digestion or similar processes"@en ;
    skos:prefLabel "Biologically degradable waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15080> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "Biomass burning is the burning of living and dead vegetation"@en ;
    skos:prefLabel "biomass burning"@en .

<http://www.eionet.europa.eu/gemet/concept/15081> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "Plant and algal materials used to derive fuels like ethanol, butanol, biodiesel, and other hydrocarbon fuels"@en ;
    skos:prefLabel "biomass feedstock"@en .

<http://www.eionet.europa.eu/gemet/concept/15082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/899> ;
    skos:definition "effects that the organisms in a community have on one another that are fundamental to the survival of that organism and the functioning of the ecosystem as a whole"@en ;
    skos:prefLabel "biotic interactions"@en .

<http://www.eionet.europa.eu/gemet/concept/15083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1160> ;
    skos:definition "Carbon captured by the world's oceans and coastal ecosystems.The carbon captured by living organisms in oceans is stored in the form of biomass and sediments from mangroves, salt marshes, seagrasses and potentially algae."@en ;
    skos:prefLabel "blue carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/15084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2159> ;
    skos:definition "long-term EU strategy to support growth in the maritime sector as a whole"@en ;
    skos:prefLabel "blue growth"@en .

<http://www.eionet.europa.eu/gemet/concept/15085> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12013>,
        <http://www.eionet.europa.eu/gemet/concept/3414> ;
    skos:definition "phenomena of a stand of trees losing health and dying without an obvious cause"@en ;
    skos:prefLabel "boreal forest dieback"@en .

<http://www.eionet.europa.eu/gemet/concept/15088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "gas that contributes to the greenhouse effect by absorbing infrared radiation"@en ;
    skos:prefLabel "carbon emission"@en .

<http://www.eionet.europa.eu/gemet/concept/15089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15092>,
        <http://www.eionet.europa.eu/gemet/concept/4731> ;
    skos:definition "The situation that may occur if, for reasons of costs related to climate policies, businesses were to transfer production to other countries with laxer emission constraints. This could lead to an increase in their total emissions. The risk of carbon leakage may be higher in certain energy-intensive industries."@en ;
    skos:prefLabel "carbon leakage"@en .

<http://www.eionet.europa.eu/gemet/concept/1509> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The processing of coal to remove impurities."@en ;
    skos:prefLabel "coal refining"@en .

<http://www.eionet.europa.eu/gemet/concept/15090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1160>,
        <http://www.eionet.europa.eu/gemet/concept/15086> ;
    skos:definition "total of carbon emissions and carbon sequestration over a period of time for a defined area, project or sector"@en ;
    skos:prefLabel "carbon mass balance"@en .

<http://www.eionet.europa.eu/gemet/concept/15091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15092>,
        <http://www.eionet.europa.eu/gemet/concept/7616> ;
    skos:definition "biological process that absorbs carbon dioxide from the atmosphere and contains it in living organic matter, soil, or aquatic ecosystems"@en ;
    skos:prefLabel "carbon sequestration"@en .

<http://www.eionet.europa.eu/gemet/concept/15094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "waste arising from any trade or business, industrial or commercial activities"@en ;
    skos:prefLabel "chemical commercial waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15095> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "An economy in which the value of products, materials and resources is maintained in the economy for as long as possible, and the generation of waste minimised"@en ;
    skos:prefLabel "circular economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462>,
        <http://www.eionet.europa.eu/gemet/concept/15097> ;
    skos:definition "Influence of land cover and biological mediated processes that regulate atmospheric processes and weather patterns which in turn create the microclimate in which different plants and animals (including humans) live and function"@en ;
    skos:prefLabel "climate regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/15099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "any of the eight principal zones, roughly demarcated by lines of latitude, into which the earth can be divided on the basis of climate"@en ;
    skos:prefLabel "climate zone"@en .

<http://www.eionet.europa.eu/gemet/concept/151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Acoustic noise caused by turbulent airflow over the surface of a body."@en ;
    skos:prefLabel "aerodynamic noise"@en .

<http://www.eionet.europa.eu/gemet/concept/15100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "any waste that consists wholly or partly of Human or animal tissue, Blood or bodily fluids, Excretions, Drugs or other pharmaceutical products, Swabs or dressings, Syringes, needles or other sharp instruments which, unless rendered safe, may prove hazardous to any person coming into contact with it"@en ;
    skos:prefLabel "clinical waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15101> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182>,
        <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition ""@en ;
    skos:prefLabel "coal gas desulfurization"@en .

<http://www.eionet.europa.eu/gemet/concept/15102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3301> ;
    skos:definition "Flooding of normally dry, low-lying coastal land, primarily caused by severe weather events along the coast, estuaries, and adjoining rivers."@en ;
    skos:prefLabel "coastal flooding"@en .

<http://www.eionet.europa.eu/gemet/concept/15103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "ways that allow consumers to obtain products or services more effectively and resource-efficiently, involving fundamentally changing the ways that consumer demands are met, including shifting from individual decisions to organised or collective demand"@en ;
    skos:prefLabel "collaborative consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste from premises used mainly for the purposes of a trade or business or for the purpose of sport, recreation, education or entertainment, but excluding household, agricultural or industrial waste"@en ;
    skos:prefLabel "commercial waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "mineral materials occurring in the process of demolition, renovation and alteration works on edifices and building parts"@en ;
    skos:prefLabel "construction waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15055> ;
    skos:definition """Anaerobic lagoon covered with a flexible membrane to
capture methane produced during the digestion process"""@en ;
    skos:prefLabel "covered anaerobic lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/15108> a skos:Concept ;
    skos:definition "Materials left in an agricultural field or orchard after the crop has been harvested. These residues include stalks and stubble (stems), leaves, and seed pods. The residue can be ploughed directly into the ground, or burned first. Good management of field residues can increase efficiency of irrigation and control of erosion."@en ;
    skos:prefLabel "crop residue"@en .

<http://www.eionet.europa.eu/gemet/concept/15109> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/208> ;
    skos:definition "any activity resulting from a system of practices applicable to land on which agricultural crops are grown and on land that is set aside or temporarily not being used for crop production"@en ;
    skos:prefLabel "cropland management"@en .

<http://www.eionet.europa.eu/gemet/concept/1511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2747> ;
    skos:definition "The processing of coal to make gaseous and liquid fuels."@en ;
    skos:prefLabel "coal technology"@en .

<http://www.eionet.europa.eu/gemet/concept/15110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species in which the evolutionary process has been influenced by humans to meet their needs"@en ;
    skos:prefLabel "cultivated species"@en .

<http://www.eionet.europa.eu/gemet/concept/15111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15138>,
        <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "Non-material benefits people obtain from ecosystems through spiritual enrichment, cognitive development, reflection, recreation and aesthetic experience"@en ;
    skos:prefLabel "cultural ecosystem services"@en .

<http://www.eionet.europa.eu/gemet/concept/15112> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11227> ;
    skos:definition "matter composed of organic compounds that has come from the remains of organisms such as plants and animals and their waste products in the environment"@en ;
    skos:prefLabel "dead organic matter"@en .

<http://www.eionet.europa.eu/gemet/concept/15113> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13302> ;
    skos:definition "The use of less resources per unit of economic output and reducing the environmental impact of any resources that are used or economic activities that are undertaken"@en ;
    skos:prefLabel "decoupling"@en .

<http://www.eionet.europa.eu/gemet/concept/15114> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6336> ;
    skos:definition """waste designed to degrade under environmental conditions
or in municipal and industrial biological waste treatment
facilities"""@en ;
    skos:prefLabel "degradable plastic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15117> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15192>,
        <http://www.eionet.europa.eu/gemet/concept/6413> ;
    skos:definition "Emissions from sources that are owned or controlled by the reporting entity"@en ;
    skos:prefLabel "direct greenhouse gas emissions"@en .

<http://www.eionet.europa.eu/gemet/concept/15119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5605> ;
    skos:definition "The sum of nitrate, nitrite, and ammonium"@en ;
    skos:prefLabel "dissolved inorganic nitrogen"@en .

<http://www.eionet.europa.eu/gemet/concept/15120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8566> ;
    skos:definition "total amount of materials directly used in the economy minus the materials that are exported"@en ;
    skos:prefLabel "domestic material consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species in which the evolutionary process has been influenced by humans to meet their needs"@en ;
    skos:prefLabel "domesticated species"@en .

<http://www.eionet.europa.eu/gemet/concept/15122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15221>,
        <http://www.eionet.europa.eu/gemet/concept/5007> ;
    skos:definition "solid storage, dry feedlots, deep pit stacks, and daily spreading of the manure, as well as unmanaged manure from animals grazing on pasture"@en ;
    skos:prefLabel "dry manure management system"@en .

<http://www.eionet.europa.eu/gemet/concept/15123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15204> ;
    skos:definition "ice sheet disintegration via sliding towards the sea accelerated by warming and precipitaion increase amounts"@en ;
    skos:prefLabel "dynamical ice loss"@en .

<http://www.eionet.europa.eu/gemet/concept/15124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11706> ;
    skos:definition "gathering of information about planet Earth’s physical, chemical and biological systems via remote sensing technologies, usually involving satellites carrying imaging devices"@en ;
    skos:prefLabel "earth observation"@en .

<http://www.eionet.europa.eu/gemet/concept/15126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "balancing economic development and the protection of nature"@en ;
    skos:prefLabel "ecological civilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/15127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "A corridor as a narrow, linear (or near-linear) piece of habitat that connects two larger patches of habitat that are surrounded by a nonhabitat matrix, thereby facilitating movements of animals and dispersal of plants and other organsisms."@en ;
    skos:prefLabel "ecological corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/15128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "area of productive land and water ecosystems required to produce the resources that the population consumes and assimilate the wastes that the population produces, wherever on Earth the land and water is located"@en ;
    skos:prefLabel "ecological footprint"@en .

<http://www.eionet.europa.eu/gemet/concept/15129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1198>,
        <http://www.eionet.europa.eu/gemet/concept/15125>,
        <http://www.eionet.europa.eu/gemet/concept/15275> ;
    skos:definition "ability of an ecological or socio-ecological system and its components to anticipate, reduce, accommodate, or recover from the effects of a hazardous event or trend in a timely and efficient manner"@en ;
    skos:prefLabel "ecological resilience"@en .

<http://www.eionet.europa.eu/gemet/concept/15131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15275>,
        <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Ability of an economy to withstand or recover from the effects of exogeneous shocks"@en ;
    skos:prefLabel "economic resilience"@en .

<http://www.eionet.europa.eu/gemet/concept/15135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "integrated process to conserve and improve ecosystem health that sustains ecosystem services"@en ;
    skos:prefLabel "ecosystem management"@en .

<http://www.eionet.europa.eu/gemet/concept/15136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15134>,
        <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "intrinsic ecosystem characteristic whereby an ecosystem maintains its integrity"@en ;
    skos:prefLabel "ecosystem process"@en .

<http://www.eionet.europa.eu/gemet/concept/15137> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15275>,
        <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "capacity of an ecosystem to tolerate disturbance without collapsing into a qualitatively or quantitatively different state that is controlled by a different set of processes"@en ;
    skos:prefLabel "ecosystem resilience"@en .

<http://www.eionet.europa.eu/gemet/concept/15139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "system's ability to minimize dynamic fluctuation and to defy change focusing on the ability to resist exotic species, temporal stability, resistance and resilience"@en ;
    skos:prefLabel "ecosystem stability"@en .

<http://www.eionet.europa.eu/gemet/concept/15141> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3291> ;
    skos:definition "strategy for the integrated management of land, water, and living resources that promotes conservation and sustainable use based on the application of appropriate scientific methods focused on levels of biological organization, which encompass the essential structure, processes, functions, and interactions among organisms and their environment"@en ;
    skos:prefLabel "ecosystem-based approach"@en .

<http://www.eionet.europa.eu/gemet/concept/15142> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "approach to maintaining or restoring the composition, structure, function, and delivery of services of natural and modified ecosystems for the goal of achieving sustainability, based on an adaptive, collaboratively developed vision of desired future conditions that integrates ecological, socioeconomic, and institutional perspectives, applied within a geographic framework, and defined primarily by natural ecological boundaries"@en ;
    skos:prefLabel "ecosystem-based management"@en .

<http://www.eionet.europa.eu/gemet/concept/15143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3012> ;
    skos:definition "comparing the effects of a measure, its outcomes and/or impacts, to its explicitly stated objectives"@en ;
    skos:prefLabel "effectiveness evaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/15144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8250> ;
    skos:definition "providing material services with less material through recyclability, element reusability and waste reduction"@en ;
    skos:prefLabel "efficient material use"@en .

<http://www.eionet.europa.eu/gemet/concept/15146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13560>,
        <http://www.eionet.europa.eu/gemet/concept/15145> ;
    skos:definition "Tradable-permit system in which a greenhouse gases emitter (firm or country under obligation to limit its total air pollution emissions to a specified level) can buy/sell permission to emit a certain amount of emissions from/to other emitters (who are below/above their limit)"@en ;
    skos:prefLabel "emission allowance trading"@en .

<http://www.eionet.europa.eu/gemet/concept/15147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "the process of calculating emissions and/or removals"@en ;
    skos:prefLabel "emission estimation"@en .

<http://www.eionet.europa.eu/gemet/concept/15148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition """quantified emission limitation or reduction commitments, expressed in tonnes of carbon dioxide
equivalent, for the purpose of determining the emission levels allocated to the Community and its Member States subject to Article 4 of the Kyoto Protocol"""@en ;
    skos:prefLabel "emission levels"@en .

<http://www.eionet.europa.eu/gemet/concept/15149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "key policy tool to ensure that Europe and other countries reach their greenhouse reduction targets, with the least cost, by changing pricing systems, essential for triggering the resource‑efficient green economy transformation process with the EU Emissions Trading Scheme(EU ETS) as the pillar of the future global carbon market"@en ;
    skos:prefLabel "emissions trading scheme"@en .

<http://www.eionet.europa.eu/gemet/concept/1515> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "Concentration of human settlements, infrastructures and economical activities along the coasts, being these areas very favourable for trade, communication and marine resources exploitation; the impact of the accelerated population growth and of the industrial and touristic development in these areas has caused the disruption of the ecological integrity of the coastal zones."@en ;
    skos:prefLabel "coastal development"@en .

<http://www.eionet.europa.eu/gemet/concept/15150> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "total number of calories taken in daily whether ingested or by parenteral routes"@en ;
    skos:prefLabel "energy intake"@en .

<http://www.eionet.europa.eu/gemet/concept/15151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "programme which provides the framework for European Union action in the field of the environment"@en ;
    skos:prefLabel "environment action programme"@en .

<http://www.eionet.europa.eu/gemet/concept/15152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7116> ;
    skos:definition "presentation of unbiased scientific data and information relating to the environment, providing insights into the state of the environment, to provide the basis for informed decision making so that individuals and policy-makers can take positive action"@en ;
    skos:prefLabel "environment reporting"@en .

<http://www.eionet.europa.eu/gemet/concept/15153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "any activity affecting the environment or any consequence of such activity which, exclusively or simultaneously, has caused or continues to cause environmental pollution, environmental risk or the use of a natural asset"@en ;
    skos:prefLabel "environmental burden"@en .

<http://www.eionet.europa.eu/gemet/concept/15156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:definition "rules, processes and behaviour that affect the way powers are exercised at European level in the field of environmental policies, particularly as regards openness, participation, accountability, effectiveness and coherence"@en ;
    skos:prefLabel "environmental governance"@en .

<http://www.eionet.europa.eu/gemet/concept/15157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15198>,
        <http://www.eionet.europa.eu/gemet/concept/2824> ;
    skos:definition "any environmental factor that might give rise to the damage of human or animal health"@en ;
    skos:prefLabel "environmental health risks"@en .

<http://www.eionet.europa.eu/gemet/concept/15158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15161> ;
    skos:definition "EU law Directive on enforcement of claims to improve the environment"@en ;
    skos:prefLabel "environmental liability regulations"@en .

<http://www.eionet.europa.eu/gemet/concept/15159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Set of processes and practices that enable an organization to reduce its environmental impacts and increase its operating efficiency"@en ;
    skos:prefLabel "environmental management system"@en .

<http://www.eionet.europa.eu/gemet/concept/1516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:definition "Marine environments bounded by the coastal land margin (seashore) and the continental shelf 100-200 m below sea level. Ecologically, the coastal and nearshore zones grade from shallow water depths, influenced by the adjacent landmass and input from coastal rivers and estuaries, to the continental shelf break, where oceanic processes predominate. Among the unique marine ecosystems associated with coastal and nearshore waterbodies are seaweed-dominated communities, coral reefs and upwellings."@en ;
    skos:prefLabel "coastal ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/15160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Pressures resulting from human activities which bring about changes in the state of the environment"@en ;
    skos:prefLabel "environmental pressure"@en .

<http://www.eionet.europa.eu/gemet/concept/15162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "quantity of energy, water, land, non-renewable raw materials and wood used in a sustainable fashion"@en ;
    skos:prefLabel "environmental space"@en .

<http://www.eionet.europa.eu/gemet/concept/15163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6624> ;
    skos:definition "A state in which the demands placed on the environment can be met without reducing its capacity to allow all people to live well, now and in the future."@en ;
    skos:prefLabel "environmental sustainability"@en .

<http://www.eionet.europa.eu/gemet/concept/15164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "largest cap-and-trade scheme in the world and the core instrument for Kyoto compliance in the EU, launched in January 2005"@en ;
    skos:prefLabel "EU emissions trading scheme"@en .

<http://www.eionet.europa.eu/gemet/concept/15165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2852> ;
    skos:definition "partnership network of the European Environment Agency (EEA) and its member and cooperating countries aiming to provide timely and quality-assured data, information and expertise for assessing the state of the environment in Europe and the pressures acting upon it by enabling policy-makers to decide on appropriate measures for protecting the environment at national and European level and to monitor the effectiveness of policies and measures implemented"@en ;
    skos:prefLabel "European Environmental Information and Observation Network"@en .

<http://www.eionet.europa.eu/gemet/concept/15166> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7983> ;
    skos:definition "Conservation of components of biological diversity outside their natural habitats"@en ;
    skos:prefLabel "ex-situ conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/15167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1471> ;
    skos:definition "vicious or virtuous circle accelerating or decelerating a warming trend in climate change"@en ;
    skos:prefLabel "feedback loop"@en .

<http://www.eionet.europa.eu/gemet/concept/15168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "Sum of nitrogen (N), phosphate (P2O5) and potash (K2O) used in agriculture"@en ;
    skos:prefLabel "fertiliser consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3256> ;
    skos:definition "income from catching, taking or harvesting of fish"@en ;
    skos:prefLabel "fishing revenue"@en .

<http://www.eionet.europa.eu/gemet/concept/1517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "The areas where the land masses meet the seas. Coastal environments include tidal wetlands, estuaries, bays, shallow near-shore waters, mangrove swamps, and in-shore reef systems. The critical habitats of these zones are: feeding, breeding, nursery, and resting areas. Coastal areas throughout the world are under enormous environmental stress, which is caused by a wide range of factors, including pollution and the destruction and deterioration of marine habitats."@en ;
    skos:prefLabel "coastal environment"@en .

<http://www.eionet.europa.eu/gemet/concept/15170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "A flood of short duration with a relatively high peak discharge usually having less than 6 hours between the occurrence of the rainfall and the peak."@en ;
    skos:prefLabel "flash flood"@en .

<http://www.eionet.europa.eu/gemet/concept/15171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "combination of the probability of flooding and  corresponding exposure characteristics such as flood depth, velocity, duration, rise rate, period of occurrence and water quality"@en ;
    skos:prefLabel "flood hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/15172> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "preventing damage caused by floods by avoiding the construction of houses and industries in present and future flood-prone areas, as well as by adapting future developments to the risk of flooding and by promoting appropriate land-use, agricultural and forestry practices"@en ;
    skos:prefLabel "flood prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/15173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10053> ;
    skos:definition "continuous and holistic societal analysis, assessment and reduction of flood risk"@en ;
    skos:prefLabel "flood risk management"@en .

<http://www.eionet.europa.eu/gemet/concept/15175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/827> ;
    skos:definition "all life forms found within forested areas and the ecological roles they perform"@en ;
    skos:prefLabel "forest biodiversity"@en .

<http://www.eionet.europa.eu/gemet/concept/15176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "under cultivated land or non-cultivated stands of trees of a size of more than 0.5 hectares with crown cover of more than 10 per cent and on which trees are able to grow to a height of 5 metes or more at maturity"@en ;
    skos:prefLabel "forested land"@en .

<http://www.eionet.europa.eu/gemet/concept/15177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3462> ;
    skos:definition "total of the petroleum, coal and natural gas consumption"@en ;
    skos:prefLabel "fossil fuel consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3462> ;
    skos:definition ""@en ;
    skos:prefLabel "fossil fuel gas"@en .

<http://www.eionet.europa.eu/gemet/concept/15179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9214> ;
    skos:definition "Set of parameters considered to characterize the chemical, physical, and biological properties of freshwater"@en ;
    skos:prefLabel "freshwater quality"@en .

<http://www.eionet.europa.eu/gemet/concept/15180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "any one of a number of fuels that under ordinary conditions are gaseous"@en ;
    skos:prefLabel "fuel gas"@en .

<http://www.eionet.europa.eu/gemet/concept/15181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3354> ;
    skos:definition "food that is taken as part of the usual diet and has beneficial effects that go beyond traditional nutritional effects"@en ;
    skos:prefLabel "functional food"@en .

<http://www.eionet.europa.eu/gemet/concept/15186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15188>,
        <http://www.eionet.europa.eu/gemet/concept/8366> ;
    skos:definition "Gradual increase in global surface temperature, observed or projected, as one of the consequences of radiative forcing caused by anthropogenic emissions."@en ;
    skos:prefLabel "global mean temperature increase"@en .

<http://www.eionet.europa.eu/gemet/concept/15187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15229>,
        <http://www.eionet.europa.eu/gemet/concept/15339>,
        <http://www.eionet.europa.eu/gemet/concept/8671> ;
    skos:definition "a widespread and long-term social, economic, environmental, political or technological change, occurring at the global scale, that is slow to form but has a major impact once in place"@en ;
    skos:prefLabel "global megatrends"@en .

<http://www.eionet.europa.eu/gemet/concept/15189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2440> ;
    skos:definition "the chemical status required to meet the environmental objectives for surface waters established in Article 4(1)(a), that is the chemical status achieved by a body of surface water in which concentrations of pollutants do not exceed the environmental quality standards established in Annex IX and under Article 16(7), and under other relevant Community legislation setting environmental quality standards at Community level."@en ;
    skos:prefLabel "good chemical status"@en .

<http://www.eionet.europa.eu/gemet/concept/1519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2963> ;
    skos:definition "The gradual wearing away of material from a coast by the action of sea water."@en ;
    skos:prefLabel "coastal erosion"@en .

<http://www.eionet.europa.eu/gemet/concept/15190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15130>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Status, when the values of the biological quality elements for the surface water body type show low levels of distortion resulting from human activity, but deviate only slightly from those normally associated with the surface water body type under undisturbed conditions."@en ;
    skos:prefLabel "good ecological status"@en .

<http://www.eionet.europa.eu/gemet/concept/15193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6758> ;
    skos:definition "international accounting tool for government and business leaders to understand, quantify, and manage greenhouse gas emissions"@en ;
    skos:prefLabel "greenhouse gas protocol"@en .

<http://www.eionet.europa.eu/gemet/concept/15194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "All living biomass above the soil including stem, stump, branches, bark, seeds and foliage."@en ;
    skos:prefLabel "ground biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5991> ;
    skos:definition "Ozone in the lowermost part of the troposphere"@en ;
    skos:prefLabel "ground-level ozone"@en .

<http://www.eionet.europa.eu/gemet/concept/15196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14851> ;
    skos:definition "loss of suitable habitat for a given species such that the particular species no longer occurs in that area"@en ;
    skos:prefLabel "habitat loss"@en .

<http://www.eionet.europa.eu/gemet/concept/15197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Council Directive 92/43/EEC of 21 May 1992 on the conservation of natural habitats and of wild fauna and flora that ensures the conservation of a wide range of rare, threatened or endemic animal and plant species, as well as  rare and characteristic habitat types for conservation in their own right"@en ;
    skos:prefLabel "habitats directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6593> ;
    skos:definition "condition in which crop performance or survival is compromised by periods of exposure to high temperatures"@en ;
    skos:prefLabel "heat stress"@en .

<http://www.eionet.europa.eu/gemet/concept/1520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5035> ;
    skos:definition "Fishing in an area of the sea next to the shoreline."@en ;
    skos:prefLabel "coastal fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/15202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182>,
        <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition "any process that removes sulphur compounds by converting them to hydrogen sulphide, which is then easily extrated and destroyed"@en ;
    skos:prefLabel "hydrodesulphurisation"@en .

<http://www.eionet.europa.eu/gemet/concept/15203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3673> ;
    skos:definition """dome-shaped glacier with radial flow, usually covering
a highland area."""@en ;
    skos:prefLabel "ice cap"@en .

<http://www.eionet.europa.eu/gemet/concept/15206> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15205> ;
    skos:definition "speed of ice loss and most important indicator of ice sheet change"@en ;
    skos:prefLabel "ice sheet mass balance"@en .

<http://www.eionet.europa.eu/gemet/concept/15207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "assessment method useful for synthesizing information and assessing progress towards quantified targets taking into account positive, negative, neutral qualification of an indicator based on the comparison between its observed evolution and/or status, and the desired evolution set for the indicator by means of a frame of reference"@en ;
    skos:prefLabel "indicator-based assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15192>,
        <http://www.eionet.europa.eu/gemet/concept/6413> ;
    skos:definition "emissions that are a consequence of the activities of the reporting entity, but occur at sources owned or controlled by another entity"@en ;
    skos:prefLabel "indirect greenhouse gas emissions"@en .

<http://www.eionet.europa.eu/gemet/concept/15209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/270> ;
    skos:definition "nature of air that affects the health and well-being of the individuals or beings occupying a particular space"@en ;
    skos:prefLabel "indoor air quality"@en .

<http://www.eionet.europa.eu/gemet/concept/15210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "treatment of water discharged after being used in, or produced by, industrial processes and which is of no further immediate value to these processes"@en ;
    skos:prefLabel "industrial waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/15211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9053> ;
    skos:definition "waste that poses a ‘known or suspected’ risk of infection, regardless of the level of infection posed"@en ;
    skos:prefLabel "infectious waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "interdisciplinary process of identification, analysis and appraisal of all the relevant natural and human processes and their interactions which determine both the current and future state of environmental quality, and resources, on appropriate spatial and temporal scales, thus facilitating the framing and implementation of policies and strategies"@en ;
    skos:prefLabel "integrated environmental assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4545> ;
    skos:definition "terrains with a complex geology and very special hydrological characteristics"@en ;
    skos:prefLabel "karst area"@en .

<http://www.eionet.europa.eu/gemet/concept/15215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "directive that defines the different categories of waste (municipal waste, hazardous waste, non-hazardous waste and inert waste) and applies to all landfills whose aim is to prevent or reduce negative effects on the environment, in particular on surface water, groundwater, soil, air, and on human health by introducing stringent technical requirements for waste and landfills"@en ;
    skos:prefLabel "landfill directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "traditional economy model based on a 'take-make-consume-throw away' approach of resources"@en ;
    skos:prefLabel "linear economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15221>,
        <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "uses water to facilitate manure handling, including tanks and lagoons which store manure until it is applied to cropland, and creates the ideal anaerobic environment for methane production"@en ;
    skos:prefLabel "liquid manure management system"@en .

<http://www.eionet.europa.eu/gemet/concept/15218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15311> ;
    skos:definition "Multi-dimensional and fundamental process that requires a move away from the current economic models as well as profound changes in institutions, practices, technologies, policies, lifestyles and thinking"@en ;
    skos:prefLabel "long-term transition"@en .

<http://www.eionet.europa.eu/gemet/concept/15219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15087>,
        <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "economy based on low carbon power sources that has a minimal output of greenhouse gas emissions into the environment biosphere, but specifically refers to the greenhouse gas carbon dioxide"@en ;
    skos:prefLabel "low carbon economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "tbc"@en ;
    skos:prefLabel "low carbon society"@en .

<http://www.eionet.europa.eu/gemet/concept/15222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/827> ;
    skos:definition "number of species types in a particular ecosystem in the world's oceans and seas"@en ;
    skos:prefLabel "marine biodiversity"@en .

<http://www.eionet.europa.eu/gemet/concept/15223> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5043> ;
    skos:definition "organisms living in either the pelagic environment (plankton and nekton) or the benthic environment (benthos)"@en ;
    skos:prefLabel "marine biota"@en .

<http://www.eionet.europa.eu/gemet/concept/15224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "any marine fuel as defined for DMB grade in Table I of ISO 8217 with the exception of the reference to the sulphur content"@en ;
    skos:prefLabel "marine diesel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/15226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15225>,
        <http://www.eionet.europa.eu/gemet/concept/15299>,
        <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "mixture of marine-gas-oil and residual fuel oil"@en ;
    skos:prefLabel "marine fuel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/15227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "obtained from the atmospheric distillate of crude and designed to be used in diesel engines which operate under high performance conditions in altitudes under 2000 meters above sea level to generate electric and mechanical power in burners, furnaces, boilers and marine engines"@en ;
    skos:prefLabel "marine gas oil"@en .

<http://www.eionet.europa.eu/gemet/concept/15228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "EU Directive with the aim to contribute to coherence between, and  to ensure the integration of environmental concerns into, the different policies, agreements and legislative measures which have an impact on the marine environment"@en ;
    skos:prefLabel "Marine Strategy Framework Directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15183>,
        <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition "total gas from coal seam and dropping coal (rocks) pouring into the wind in unit time"@en ;
    skos:prefLabel "mine gas emission"@en .

<http://www.eionet.europa.eu/gemet/concept/15232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5437> ;
    skos:definition "waste collected by or on behalf of municipalities, originating mostly from households, although waste from commerce and trade, office buildings, institutions and small businesses is also included"@en ;
    skos:prefLabel "municipal waste generation"@en .

<http://www.eionet.europa.eu/gemet/concept/15233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "wastewater collected by or on behalf of municipalities originating mostly from  households"@en ;
    skos:prefLabel "municipal waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/15235> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15234>,
        <http://www.eionet.europa.eu/gemet/concept/2926> ;
    skos:definition "detailed statistics for better management of the economy, like accounts for the sectoral inputs of water and energy and outputs of pollution needed to model green growth scenarios."@en ;
    skos:prefLabel "natural capital accounts"@en .

<http://www.eionet.europa.eu/gemet/concept/15236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "total consumption of natural gas (industrial, residential/service and production of electricity) and most important means of reducing CO2 and other greenhouse gases (GHG) emissions"@en ;
    skos:prefLabel "natural gas consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8247> ;
    skos:definition "pursuit of a better quality of life for both present and future generations by linking economic development, protection of the environment and social justice"@en ;
    skos:prefLabel "natural sustainable development"@en .

<http://www.eionet.europa.eu/gemet/concept/15238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5624> ;
    skos:definition "environmental noise occurring during the night period with a harmful effect, expressed in decibels (dB)"@en ;
    skos:prefLabel "night noise"@en .

<http://www.eionet.europa.eu/gemet/concept/15239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive prescribing the maximum amounts of nitrogen that can be applied to land in the form of animal manure in order to prevent further nitrate pollution"@en ;
    skos:prefLabel "nitrate directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "total consumption of fossil fuels as feedstock in the chemical industry, refinery and coke oven products consumed in various economic sectors, as well as the use of solid carbon for the production of metals and inorganic chemicals"@en ;
    skos:prefLabel "non-energy use"@en .

<http://www.eionet.europa.eu/gemet/concept/15242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "lands not qualifying as forested, such as those which are primarily rock, ice or water"@en ;
    skos:prefLabel "non-forested land"@en .

<http://www.eionet.europa.eu/gemet/concept/15244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4988> ;
    skos:definition "resource that does not renew itself at a sufficient rate for sustainable economic extraction in meaningful human time-frames"@en ;
    skos:prefLabel "non-renewable natural resource"@en .

<http://www.eionet.europa.eu/gemet/concept/15245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15201>,
        <http://www.eionet.europa.eu/gemet/concept/7822> ;
    skos:definition "factors such as wealth, health and employment, which are associated with a good life"@en ;
    skos:prefLabel "objective well-being"@en .

<http://www.eionet.europa.eu/gemet/concept/15246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/44>,
        <http://www.eionet.europa.eu/gemet/concept/470> ;
    skos:definition "input of anthropogenic CO2 to surface oceans from the atmosphere, leading to shifts in carbon chemistry that can cause changes to rates and fates of primary production and calcification of marine organisms and communities"@en ;
    skos:prefLabel "ocean acidification"@en .

<http://www.eionet.europa.eu/gemet/concept/15247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11612> ;
    skos:definition "certification process for producers of organic food and other organic agricultural products"@en ;
    skos:prefLabel "organic certification"@en .

<http://www.eionet.europa.eu/gemet/concept/15249> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5500> ;
    skos:definition "substance containing carbonaceous materials designed to increase the content of organic matter in soil"@en ;
    skos:prefLabel "organic soil improver"@en .

<http://www.eionet.europa.eu/gemet/concept/15251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088>,
        <http://www.eionet.europa.eu/gemet/concept/15250> ;
    skos:definition "general method to measure and communicate the potential life cycle environmental impact of an organisation"@en ;
    skos:prefLabel "organisation environmental footprint method"@en .

<http://www.eionet.europa.eu/gemet/concept/15252> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15231>,
        <http://www.eionet.europa.eu/gemet/concept/15248>,
        <http://www.eionet.europa.eu/gemet/concept/5500> ;
    skos:definition "fertiliser obtained by combining inorganic fertilisers and organic fertilisers or soil improvers"@en ;
    skos:prefLabel "organo-mineral fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/15253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:definition "disease affecting a small patient population (less than 1 in 2,000 citizens) for which it is not commercially viable to develop treatments"@en ;
    skos:prefLabel "orphan disease"@en .

<http://www.eionet.europa.eu/gemet/concept/15254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/265> ;
    skos:definition "release of several substances, called air pollutants, into the atmosphere, in concentrations that threaten the wellbeing of living organisms or disrupt the function of the environment as a system leading to human health damages in various ways"@en ;
    skos:prefLabel "outdoor air pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/15256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5991> ;
    skos:definition "Substances which contribute to the formation of ground-level ozone"@en ;
    skos:prefLabel "ozone precursor"@en .

<http://www.eionet.europa.eu/gemet/concept/15257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2947> ;
    skos:definition "epidemic so widely spread that vast numbers of people in different countries are affected"@en ;
    skos:prefLabel "pandemics"@en .

<http://www.eionet.europa.eu/gemet/concept/15258> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "biodegradable green waste from parks, gardens including water and wood (lignocellulosis, grass clippings, bush and tree cuttings, leaves, flowers)"@en ;
    skos:prefLabel "park waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14853> ;
    skos:definition "change in the normal function of a living organism"@en ;
    skos:prefLabel "physiological change"@en .

<http://www.eionet.europa.eu/gemet/concept/1526> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7402> ;
    skos:definition "Coastal waters are typically characterized by a shallow continental shelf, gently sloping seaward to a continental slope, which drops relatively abruptly to the deep ocean. The proximity of coastal water to land also influences the water circulation. In the vicinity of freshwater inflows, the nearshore circulation is altered by the presence of density-driven motions. Coastal waters are under enormous environmental stress, caused by a wide range of factors including pollution and the destruction and deterioration of marine habitats."@en ;
    skos:prefLabel "coastal water"@en .

<http://www.eionet.europa.eu/gemet/concept/15260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "material which contains substances and/or microorganisms whose function when applied to plants or the rhizosphere is to stimulate natural processes to benefit nutrient uptake, nutrient efficiency, tolerance to abiotic stress, and/or crop quality, independently of its nutrient content"@en ;
    skos:prefLabel "plant biostimulant"@en .

<http://www.eionet.europa.eu/gemet/concept/15261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition """Any introduction of pollutants into the environment from a specific industrial facility or location, 
as a result of any human activity, whether deliberate
or accidental, routine or non-routine, including spilling,
emitting, discharging, injecting, disposing or dumping, or
through sewer systems without final waste-water treatment;"""@en ;
    skos:prefLabel "plant-specific release"@en .

<http://www.eionet.europa.eu/gemet/concept/15262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:definition "evidence and longer-term objectives agreed and implemented in cooperation with relevant stakeholders established in a single policy document or in a set of inter-linked policy documents"@en ;
    skos:prefLabel "policy framework"@en .

<http://www.eionet.europa.eu/gemet/concept/15263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "process whereby programmes are carried out, thereby putting plans into practice"@en ;
    skos:prefLabel "policy implementation"@en .

<http://www.eionet.europa.eu/gemet/concept/15264> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "lowering of pollutant releases into the environment measured on the basis of validated information subsequently published in a pollutant release inventory"@en ;
    skos:prefLabel "pollution reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/15265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12008> ;
    skos:definition "Fine particulate and/or aerosol matter directly emitted to the atmosphere"@en ;
    skos:prefLabel "primary atmospheric aerosol"@en .

<http://www.eionet.europa.eu/gemet/concept/15268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088>,
        <http://www.eionet.europa.eu/gemet/concept/15250>,
        <http://www.eionet.europa.eu/gemet/concept/15267> ;
    skos:definition "general method to measure and communicate the potential environmental impact of the lifecycle of a product"@en ;
    skos:prefLabel "product environmental footprint method"@en .

<http://www.eionet.europa.eu/gemet/concept/15269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1736>,
        <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "type of collaborative consumption that reduces the distinction between producer and consumer"@en ;
    skos:prefLabel "prosumerism"@en .

<http://www.eionet.europa.eu/gemet/concept/1527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4635> ;
    skos:definition "The objective of coastal management and planning is the preservation of coastal resources whilst simultaneously satisfying the sometimes conflicting interests and requirements of protection, development, usage and conservation."@en ;
    skos:prefLabel "coastal zone planning"@en .

<http://www.eionet.europa.eu/gemet/concept/15270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2638> ;
    skos:definition "one of a set of seventeen chemical elements in the periodic table, specifically the fifteen lanthanides plus scandium and yttrium"@en ;
    skos:prefLabel "rare earth"@en .

<http://www.eionet.europa.eu/gemet/concept/15272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "legislation establishing an overall policy for the production and promotion of energy from renewable sources in the EU, requiring Member States to submit national renewable energy Action Plans with detailed roadmaps of how each Member State expects to reach its legally binding 2020 target for the share of renewable energy in their final energy consumption"@en ;
    skos:prefLabel "renewable energy directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4988> ;
    skos:definition "Renewable natural resources are natural resources that, after exploitation, can return to their previous stock levels by natural processes of growth or replenishment."@en ;
    skos:prefLabel "renewable natural resource"@en .

<http://www.eionet.europa.eu/gemet/concept/15276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "supply-side measures that tackle inefficiencies across supply chains; overuse of resources and waste when products and services are produced. Being more material resource efficient means using less to produce the same level of output"@en ;
    skos:prefLabel "resource efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/15277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "ratio between gross domestic product (GDP) and domestic material consumption (DMC)"@en ;
    skos:prefLabel "resource productivity"@en .

<http://www.eionet.europa.eu/gemet/concept/1528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/558> ;
    skos:definition "A maritime force which aids shipping, saves lives at sea, prevents smuggling, etc. It also responds to emergencies involving oil spills and other discharges at sea and takes the lead in enforcing the law, including assessing penalties for environmental violations."@en ;
    skos:prefLabel "coastguard"@en .

<http://www.eionet.europa.eu/gemet/concept/15280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "an economy which creates more with less, delivering greater value with less input, using resources in a sustainable way and minimising their impacts on the environment."@en ;
    skos:prefLabel "resource-efficient economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5624>,
        <http://www.eionet.europa.eu/gemet/concept/7293> ;
    skos:definition "environmental noise generated from vehicles using roads and highways caused by rolling and propulsion"@en ;
    skos:prefLabel "road traffic noise"@en .

<http://www.eionet.europa.eu/gemet/concept/15284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15116>,
        <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "The policy that is targeted to help the rural areas of the EU to meet the wide range of economic, environmental and social challenges of the 21st century."@en ;
    skos:prefLabel "rural development policy"@en .

<http://www.eionet.europa.eu/gemet/concept/15285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7495> ;
    skos:definition "Flowering plants which grow in marine, fully saline environments."@en ;
    skos:prefLabel "seagrass"@en .

<http://www.eionet.europa.eu/gemet/concept/15286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7516> ;
    skos:definition "land covered with impermeable materials as a result of urban development, infrastructure construction or change in the nature of the soil, leading to impermeability, loss of agricultural or forestry areas and ecological soil functions severely impaired or prevented (e.g. soil working as a buffer and filter)"@en ;
    skos:prefLabel "sealed area"@en .

<http://www.eionet.europa.eu/gemet/concept/15287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12011>,
        <http://www.eionet.europa.eu/gemet/concept/15077> ;
    skos:definition "any liquid fuel which is derived by or from qualified feedstocks and meets the registration requirements for fuels and fuel additives"@en ;
    skos:prefLabel "second generation biofuel production"@en .

<http://www.eionet.europa.eu/gemet/concept/15288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12008> ;
    skos:definition "Fine particulate and/or aerosol matter that is formed in the atmosphere following the emission of precursor gases"@en ;
    skos:prefLabel "secondary atmospheric aerosol"@en .

<http://www.eionet.europa.eu/gemet/concept/15289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "semi-natural and natural ecosystems that are sensitive to both natural and human influence and activities because of the diversity of species they support"@en ;
    skos:prefLabel "sensitive ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/15290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3566> ;
    skos:definition "natural gas from shale formations"@en ;
    skos:prefLabel "shale gas"@en .

<http://www.eionet.europa.eu/gemet/concept/15291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3425> ;
    skos:definition "art and science of controlling the establishment, growth, composition, health, and quality of forest and woodlands to meet the diverse needs and values of landowners and society on a sustainable basis"@en ;
    skos:prefLabel "silviculture"@en .

<http://www.eionet.europa.eu/gemet/concept/15292> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3026> ;
    skos:definition "series of physiological changes where juvenile salmonid fish adapt from living in fresh water to living in seawater"@en ;
    skos:prefLabel "smoltification"@en .

<http://www.eionet.europa.eu/gemet/concept/15293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781>,
        <http://www.eionet.europa.eu/gemet/concept/7817> ;
    skos:definition "capacity of a society to ensure the welfare of all its members, minimising disparities and avoiding polarisation"@en ;
    skos:prefLabel "social cohesion"@en .

<http://www.eionet.europa.eu/gemet/concept/15294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10057> ;
    skos:definition "means ensuring that all communities are treated fairly and are given equal opportunity to participate in the planning and decision-making process, with an emphasis on ensuring that traditionally disadvantaged groups are not left behind"@en ;
    skos:prefLabel "social equity"@en .

<http://www.eionet.europa.eu/gemet/concept/15295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2748> ;
    skos:definition "renewable and environmentally safe energy"@en ;
    skos:prefLabel "soft energy"@en .

<http://www.eionet.europa.eu/gemet/concept/15297> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7876> ;
    skos:definition "complex communities of organisms that play fundamental roles in soil formation and contribute, directly or indirectly, to many processes such as nutrient cycling, waste decomposition, soil structure formation and pollination"@en ;
    skos:prefLabel "soil biota"@en .

<http://www.eionet.europa.eu/gemet/concept/15298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1752> ;
    skos:definition "occurrence of pollutants in soil above a certain level, causing a deterioration or loss of one or more soil functions"@en ;
    skos:prefLabel "soil contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/1530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A material applied onto or impregnated into a substrate for protective, decorative, or functional purposes. Such materials include, but are not limited to, paints, varnishes, sealers, adhesives, thinners, diluents, and inks."@en ;
    skos:prefLabel "coating"@en .

<http://www.eionet.europa.eu/gemet/concept/15300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3081> ;
    skos:definition "natural and irrevocable process leading to the death of a species without leaving any progeny and causing complete loss of genetic diversity"@en ;
    skos:prefLabel "species extinction"@en .

<http://www.eionet.europa.eu/gemet/concept/15301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15076>,
        <http://www.eionet.europa.eu/gemet/concept/2735> ;
    skos:definition "use of biomass as an energy resource that contributes to climate change mitigation, energy security, and economic development goals, results in minimal environmental and social impacts, and attains economic self-sufficiency"@en ;
    skos:prefLabel "sustainable bioenergy production"@en .

<http://www.eionet.europa.eu/gemet/concept/15303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8247> ;
    skos:definition "integrated and indivisible goals, defined by the United Nations 2030 Agenda for Sustainable Development, that are global in nature and universally applicable, taking into account different national realities, capacities and levels of development and respecting national policies and priorities"@en ;
    skos:prefLabel "sustainable development goals"@en .

<http://www.eionet.europa.eu/gemet/concept/15304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3238> ;
    skos:definition "sustainable exploitation of the fisheries stock wich will not prejudice the future exploitation or the marine eco-systems"@en ;
    skos:prefLabel "sustainable fisheries"@en .

<http://www.eionet.europa.eu/gemet/concept/15305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15307>,
        <http://www.eionet.europa.eu/gemet/concept/3425> ;
    skos:definition "stewardship and use of forests and forest lands in a way, and at a rate, that maintains their biodiversity, productivity, regeneration capacity, vitality and their potential to fulfil, now and in the future, relevant ecological, economic and social functions, at local, national and global levels, and that does not cause damage to other ecosystems"@en ;
    skos:prefLabel "sustainable forest management"@en .

<http://www.eionet.europa.eu/gemet/concept/15306> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8247> ;
    skos:definition "increase in per capita real income or real GNP which can be sustained in the long term (i.e. while maintaining macroeconomic stability and keeping pace with demographic changes)"@en ;
    skos:prefLabel "sustainable growth"@en .

<http://www.eionet.europa.eu/gemet/concept/15308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15279>,
        <http://www.eionet.europa.eu/gemet/concept/8250> ;
    skos:definition "use of natural resources in a way and at a rate that does not lead to the long-term decline of biological diversity, thereby maintaining its potential to meet the needs and aspirations of present and future generations"@en ;
    skos:prefLabel "sustainable resource use"@en .

<http://www.eionet.europa.eu/gemet/concept/15309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8522> ;
    skos:definition "Tourism that takes full account of its current and future economic, social and environmental impacts, addressing the needs of visitors, the industry, the environment and host communities"@en ;
    skos:prefLabel "sustainable tourism"@en .

<http://www.eionet.europa.eu/gemet/concept/15310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12011>,
        <http://www.eionet.europa.eu/gemet/concept/15077> ;
    skos:definition "treatment of animal by-products under the following conditions"@en ;
    skos:prefLabel "thermo-mechanical biofuel production"@en .

<http://www.eionet.europa.eu/gemet/concept/15312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "waters between the land and sea, including fjords, estuaries, lagoons, deltas and rias"@en ;
    skos:prefLabel "transitional waters"@en .

<http://www.eionet.europa.eu/gemet/concept/15314> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/157> ;
    skos:definition "composed of various chemical species"@en ;
    skos:prefLabel "troposheric aerosol"@en .

<http://www.eionet.europa.eu/gemet/concept/15315> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2525> ;
    skos:definition "habitats of underground living species buffered from profound climatic modifications and thus retaining a broad diversity of living relicts, the great majority of which being represented by terrestrial, troglobitic species, with a reduced mobility"@en ;
    skos:prefLabel "underground ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/15316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "areas inaccessible to human intervention due to the remoteness of the locations, lands with essentially no development interest or protection due to limited personal, commercial or social value, as well as lands which are potentially of economic value but remain unmanaged due to low population density, remoteness, etc."@en ;
    skos:prefLabel "unmanaged land"@en .

<http://www.eionet.europa.eu/gemet/concept/15317> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/827> ;
    skos:definition "variety and richness of living organisms, including genetic variation and habitat diversity, found in and on the edge of human settlements"@en ;
    skos:prefLabel "urban biodiversity"@en .

<http://www.eionet.europa.eu/gemet/concept/15319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8794> ;
    skos:definition "set of transportation and circulation policies and measures which seek to provide ample and democratic access to the urban space, through prioritization of mass transit means of transportation"@en ;
    skos:prefLabel "urban mobility"@en .

<http://www.eionet.europa.eu/gemet/concept/1532> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A metallic element used chiefly in alloys."@en ;
    skos:prefLabel "cobalt"@en .

<http://www.eionet.europa.eu/gemet/concept/15320> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "EU directive aiming to protect the environment from the adverse effects of discharges of waste water from urban areas and industry"@en ;
    skos:prefLabel "Urban Waste Water Treatment Directive"@en .

<http://www.eionet.europa.eu/gemet/concept/15321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12284> ;
    skos:definition "treatment of wastewater in urban wastewater plants, usually operated by public authorities or private companies mandated by public authorities"@en ;
    skos:prefLabel "urban waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/15322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "analysis of the expected impacts, risks and the adaptive capacity of a region or sector to the effects of climate change"@en ;
    skos:prefLabel "vulnerability assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9077> ;
    skos:definition "processes in which the gas emissions from waste disposal are converted into harmless substances by means of chemical reactions"@en ;
    skos:prefLabel "waste gas treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/15326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "system developed for the collection, transport, recovery and disposal of waste, including the supervision of such operations and the after-care of disposal sites"@en ;
    skos:prefLabel "waste management system"@en .

<http://www.eionet.europa.eu/gemet/concept/15328> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15327>,
        <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "infrastructure providing a series of treatment processes aiming to reduce the level of pollution of wastewater received to an acceptable level before discharge into the receiving waters"@en ;
    skos:prefLabel "waste water treatment plant"@en .

<http://www.eionet.europa.eu/gemet/concept/15329> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "the output over time of a given major sector per volume of (net) water withdrawn"@en ;
    skos:prefLabel "water efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/1533> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5945> ;
    skos:definition "The most primitive of the living winged insects. It is thought they have been unchanged for more than 300 million years, and are among the oldest fossil insects. Cockroaches are usually found in tropical climates, but a few species, out of the total 3.500 known species, have become pests. They are common household pests in many countries, imported by ship and carried home in grocery bags. Cockroaches eat plant and animal products, including food, paper, clothing and soiled hospital waste, fouling everything they touch with their droppings and unpleasant odour, to which many people are allergic. They are a major health hazard and carry harmful bacteria, protozoan parasites and faunal pathogens, including those that cause typhoid, leprosy and salmonella. Conventional insecticides make little or no impact on the cockroaches population."@en ;
    skos:prefLabel "cockroach"@en .

<http://www.eionet.europa.eu/gemet/concept/15332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15096>,
        <http://www.eionet.europa.eu/gemet/concept/15278>,
        <http://www.eionet.europa.eu/gemet/concept/9160> ;
    skos:definition "situation in which water demand exceeds the water resources exploitable under sustainable conditions"@en ;
    skos:prefLabel "water scarcity"@en .

<http://www.eionet.europa.eu/gemet/concept/15333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15096>,
        <http://www.eionet.europa.eu/gemet/concept/15334>,
        <http://www.eionet.europa.eu/gemet/concept/6593> ;
    skos:definition "sub-optimal disponibility of water which makes impossible to meet human and ecological demand"@en ;
    skos:prefLabel "water stress"@en .

<http://www.eionet.europa.eu/gemet/concept/15335> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "relatively untouched natural areas that have not been significantly modified by human activity, including core areas for nature on land or at sea where nature and wildlife thrive"@en ;
    skos:prefLabel "wilderness"@en .

<http://www.eionet.europa.eu/gemet/concept/15336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4873> ;
    skos:definition "The global capacity of ecosystems to regenerate what people demand from those surfarces"@en ;
    skos:prefLabel "world biocapacity"@en .

<http://www.eionet.europa.eu/gemet/concept/15337> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8776> ;
    skos:definition "international organisation, directing and coordinating authority for health within the United Nations which supports member states in coordinating funds, foundations, civil society organisations and the private sector to meet health objectives and support national health policies and strategies"@en ;
    skos:prefLabel "World Health Organization"@en .

<http://www.eionet.europa.eu/gemet/concept/15338> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15339> ;
    skos:definition "Forward-looking approach that aims to help decision-makers explore and anticipate in a participatory way what might happen, as well as prepare for a range of possible future scenarios, influence them and shape the futures. Foresight typically involves systematic, participatory, future-intelligence-gathering and medium-to-long-term vision-building processes to uncover a range of possible alternative future visions. Key foresight methods include horizon scanning and scenario building."@en ;
    skos:prefLabel "foresight"@en .

<http://www.eionet.europa.eu/gemet/concept/15340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15339> ;
    skos:definition "Written story lines (based on a literature review and on creative and logical thinking of the authors) used as parts of a horizon scan or a scenario study.  A story line consists of a coherent description of several possible or desirable future developments and/or events which can lead to a possible or desirable future."@en ;
    skos:prefLabel "futures essay"@en .

<http://www.eionet.europa.eu/gemet/concept/15341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15339> ;
    skos:definition "Forward-looking approach aimed at exploring and predicting a surprise-free future. On the basis of assumed continuity or expected events, trends are projected and extrapolated from the past into the future.  Key forecasting methods are trend-extrapolation techniques and modeling."@en ;
    skos:prefLabel "forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/15342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "waste from accommodation used purely for living purposes and which is disposed of via the normal mixed domestic refuse collection"@en ;
    skos:prefLabel "household waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7761> ;
    skos:definition "air pollution that contains a range of health-damaging pollutants, such as small particles and carbon monoxide (CO), and levels of particulate pollutants that can many times be higher than accepted guideline values for indoor spaces"@en ;
    skos:prefLabel "indoor smoke"@en .

<http://www.eionet.europa.eu/gemet/concept/15344> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive establishing an infrastructure for spatial information in Europe to support Community environmental policies and policies or activities which may have an impact on the environment."@en ;
    skos:prefLabel "Infrastructure for spatial information in Europe"@en .

<http://www.eionet.europa.eu/gemet/concept/15346> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15345> ;
    skos:definition "waste which is deposited in landfill, characterised according to the European Waste Catalogue, and which adds to the inventory of landfill already in place,  covering commercial, industrial and household sources, and excluding fractions already recovered for re-use, recycling or incineration"@en ;
    skos:prefLabel "landfill waste flows"@en .

<http://www.eionet.europa.eu/gemet/concept/15347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "organic biodegradable wastewater containing organic pollutants, such as sewage, industrial wastewater and the like"@en ;
    skos:prefLabel "organic waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/15348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "use of particular policy instruments, in such a way as to increase the chance to achieve the defined policy target"@en ;
    skos:prefLabel "policy effectiveness"@en .

<http://www.eionet.europa.eu/gemet/concept/15349> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8366> ;
    skos:definition "change to the global average temperature that can lead to climate change"@en ;
    skos:prefLabel "temperature change"@en .

<http://www.eionet.europa.eu/gemet/concept/15350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15182> ;
    skos:definition "abatement end-of-pipe technology, which is fitted to large combustion plants such as power plants"@en ;
    skos:prefLabel "flue gas desulphurisation"@en .

<http://www.eionet.europa.eu/gemet/concept/15351> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "mechanism by which contaminants are moving through the media until they escape the system, namely via the movement of a mass of fluid (air, ocean current) or the transport of pollutants or plankton by such movement"@en ;
    skos:prefLabel "advection"@en .

<http://www.eionet.europa.eu/gemet/concept/15352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "resulting from or produced by human activities"@en ;
    skos:prefLabel "anthropogenic"@en .

<http://www.eionet.europa.eu/gemet/concept/15353> a skos:Concept ;
    skos:definition "animal and plant life of a particular region, habitat or geological period"@en ;
    skos:prefLabel "biota"@en .

<http://www.eionet.europa.eu/gemet/concept/15354> a skos:Concept ;
    skos:definition "water network that supports native species, maintains natural ecological processes, prevents flooding, sustains air and water resources and contributes to the health and quality of life of local communities"@en ;
    skos:prefLabel "blue infrastructure"@en .

<http://www.eionet.europa.eu/gemet/concept/15355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "non-sustainable financing and investments which support the fossil fuel industry or carbon intensive activities"@en ;
    skos:prefLabel "brown finance"@en .

<http://www.eionet.europa.eu/gemet/concept/15356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "physical financial asset with direct or indirect exposure to high levels of greenhouse gas (GHG) emissions, such as assets in the fossil fuel industry, or that are heavily reliant on fossil fuels"@en ;
    skos:prefLabel "carbon-intensive asset"@en .

<http://www.eionet.europa.eu/gemet/concept/15357> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9108> ;
    skos:definition "recycling, reuse, refurbishment and remanufacturing to reduce the generation of waste as well as the economy's dependence on extraction and imports of raw materials"@en ;
    skos:prefLabel "circular material use"@en .

<http://www.eionet.europa.eu/gemet/concept/15358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition """scientific work undertaken by members of the general public, often
in collaboration with or under the direction of professional scientists and scientific
institutions"""@en ;
    skos:prefLabel "citizen science"@en .

<http://www.eionet.europa.eu/gemet/concept/15359> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3199> ;
    skos:definition "bonds whose issue is linked to projects with a positive impact on the environment, such as energy efficiency, the production of energy from renewable sources and sustainable land use"@en ;
    skos:prefLabel "Climate Action Bonds"@en .

<http://www.eionet.europa.eu/gemet/concept/1536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The quantity of oxygen used in biological and non-biological oxidation of materials in water; a measure of water quality."@en ;
    skos:prefLabel "chemical oxygen demand"@en .

<http://www.eionet.europa.eu/gemet/concept/15360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2856> ;
    skos:definition "investment benchmark that incorporates, next to financial investment objectives, specific objectives related to greenhouse gas emission reductions and the transition to a low-carbon economy through the selection and weighting of underlying benchmark constituents"@en ;
    skos:prefLabel "climate benchmark"@en .

<http://www.eionet.europa.eu/gemet/concept/15361> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "human activities which  result in no net effect on the climate system by balancing residual emissions with emission (carbon dioxide) removal as well as accounting for regional or local biogeophysical effects of human activities that affect surface albedo or local climate"@en ;
    skos:prefLabel "climate-neutral economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "levy on imported goods to counter carbon leakage, in order to avoid industries in countries with stricter rules being penalised"@en ;
    skos:prefLabel "CO2 border tax"@en .

<http://www.eionet.europa.eu/gemet/concept/15363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1736> ;
    skos:definition "combination of the perceived variables visual attractiveness, perceived usefulness, perceived ease of use and perceived risk of a product or service"@en ;
    skos:prefLabel "consumer acceptance"@en .

<http://www.eionet.europa.eu/gemet/concept/15364> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "movement to disinvest from coal, oil and gas companies, with the intention of combating climate change by reducing the amount of greenhouse gases released into the atmosphere, and holding the oil, gas and coal companies responsible for their role in climate change"@en ;
    skos:prefLabel "disinvestment"@en .

<http://www.eionet.europa.eu/gemet/concept/15365> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2830> ;
    skos:definition "framework for integrated assessments where social and economic developments exert pressure on the environment by changing the state of the environment and impacting  human health, ecosystems and materials"@en ;
    skos:prefLabel "DPSIR framework"@en .

<http://www.eionet.europa.eu/gemet/concept/15366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11612> ;
    skos:definition "form of environmental regulation and development where a company can voluntarily choose to comply with predefined processes or objectives set forth by the certification service"@en ;
    skos:prefLabel "environmental certification"@en .

<http://www.eionet.europa.eu/gemet/concept/15367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2856> ;
    skos:definition "any type of listed or unlisted bond or capital market debt instrument issued by a European or international issuer that is aligned with the EU GBS"@en ;
    skos:prefLabel "EU Green Bond label"@en .

<http://www.eionet.europa.eu/gemet/concept/15368> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2856> ;
    skos:definition "proposed voluntary framework, based on the association with the EU sustainability taxonomy, of core components for EU Green Bonds to enhance the effectiveness, transparency, accountability, comparability and credibility of the green bond market and to increase the flow of finance towards green and sustainable projects"@en ;
    skos:prefLabel "EU Green Bond Standard"@en .

<http://www.eionet.europa.eu/gemet/concept/15369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15302> ;
    skos:definition "component of the EU strategy for sustainable food aiming to keep food safe, nutritious and of high quality by enhancing the environmental sustainability of the food system, involving all actors along the value chain"@en ;
    skos:prefLabel "Farm to Fork"@en .

<http://www.eionet.europa.eu/gemet/concept/15370> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "area next to a river bed which is more or less frequently covered with water in times of high water discharges from adjacent rivers"@en ;
    skos:prefLabel "floodplain"@en .

<http://www.eionet.europa.eu/gemet/concept/15371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3673> ;
    skos:definition "uphill retraction of the lowest point of a glacier because ice melts or ablates more quickly than snowfall can accumulate and form new glacial ice"@en ;
    skos:prefLabel "glacial retreat"@en .

<http://www.eionet.europa.eu/gemet/concept/15372> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15191> ;
    skos:definition "activity producing goods and services to measure, prevent, limit, minimise or correct environmental damage to water, air and soil, as well as problems related to waste, noise and eco-systems, including technologies, products and services that reduce environmental risk, minimise pollution and resources"@en ;
    skos:prefLabel "green activity"@en .

<http://www.eionet.europa.eu/gemet/concept/15373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "incorporation of climate risks into banks' risk management policies by supporting financial institutions that contribute to funding sustainable projects"@en ;
    skos:prefLabel "green supporting factor"@en .

<http://www.eionet.europa.eu/gemet/concept/15374> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4566> ;
    skos:definition "sustainable product designed to minimise its environmental impact during the whole life-cycle, and even after it is of no use, to reduce waste and maximise resource efficiency"@en ;
    skos:prefLabel "green-labelled product"@en .

<http://www.eionet.europa.eu/gemet/concept/15375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "benefit-making resource with economic value that is negatively related to the risk of global warming and carbon emissions"@en ;
    skos:prefLabel "grey asset"@en .

<http://www.eionet.europa.eu/gemet/concept/15376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9270> ;
    skos:definition "period of abnormally hot weather"@en ;
    skos:prefLabel "heat wave"@en .

<http://www.eionet.europa.eu/gemet/concept/15377> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15087> ;
    skos:definition "process or change  towards a low carbon economy and society, through concrete steps, policies and legislation aimed to deliver major reductions in greenhouse gas emission across all economic sectors and activities in a way that maximises economic opportunities, is socially fair and protects the most vulnerable"@en ;
    skos:prefLabel "low-carbon transition"@en .

<http://www.eionet.europa.eu/gemet/concept/15378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2569> ;
    skos:definition "efficient, sustainable use of resources by minimising the impact on the environment,  creating more with less throughout the entire lifecycle, from material extraction, resource use and maintenance to material recovery"@en ;
    skos:prefLabel "material resource efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/15379> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3291> ;
    skos:definition "cost-effective approach that uses nature to deliver a range of critical services (wetlands for flood mitigation, carbon sequestration, improved air quality) that provides environmental, social and economic benefits, helping to build resilience by bringing more natural features and processes into the cities, landscapes and seascapes through locally adapted, resource-efficient and systemic interventions"@en ;
    skos:prefLabel "nature-based solution"@en .

<http://www.eionet.europa.eu/gemet/concept/15380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15086> ;
    skos:definition "globally balanced anthropogenic CO2 emissions through anthropogenic CO2 removals over a specified period"@en ;
    skos:prefLabel "net zero carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/15381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5648> ;
    skos:definition "visual presentation of the distribution of sound-pressure levels due to given noise sources across a geographic area and for a defined time period"@en ;
    skos:prefLabel "noise map"@en .

<http://www.eionet.europa.eu/gemet/concept/15382> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15106> ;
    skos:definition "excessive consumption or use of goods and services (energy, land, water or materials) that cause harm or detrimental effects to humans and/or the environment, namely by exceeding the carrying capacity and life supporting systems of the planet and its ecosystems"@en ;
    skos:prefLabel "overconsumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15383> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5624> ;
    skos:definition "area with a pleasant soundscape and in which noise, i.e. unwanted sound, is absent or at least not dominant"@en ;
    skos:prefLabel "quiet area"@en .

<http://www.eionet.europa.eu/gemet/concept/15384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10053> ;
    skos:definition "change based on the identification, evaluation and prioritisation of the risks involved, followed by the application of resources to minimise, monitor and control the probability/impact of events or to maximise the realisation of opportunities"@en ;
    skos:prefLabel "risk-based change"@en .

<http://www.eionet.europa.eu/gemet/concept/15385> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3199> ;
    skos:definition "any type of bond instrument where the proceeds will be exclusively applied to finance, refinance or raise funds in part or in full for new and existing projects with positive social outcomes"@en ;
    skos:prefLabel "social bond"@en .

<http://www.eionet.europa.eu/gemet/concept/15386> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "identifying and analysing potential events that may negatively impact sustainability and evaluating that risk"@en ;
    skos:prefLabel "sustainability risk assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6624> ;
    skos:definition "initial analysis of the potential positive or negative contribution of a proposal to sustainability"@en ;
    skos:prefLabel "sustainability screening"@en .

<http://www.eionet.europa.eu/gemet/concept/15388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/716> ;
    skos:definition "integration of environmental, social and governance criteria into traditional banking operational and business activities"@en ;
    skos:prefLabel "sustainable banking"@en .

<http://www.eionet.europa.eu/gemet/concept/15389> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "process of taking due account of environmental and social considerations in investment decision-making, leading to increased investments in longer-term and sustainable activities"@en ;
    skos:prefLabel "sustainable finance"@en .

<http://www.eionet.europa.eu/gemet/concept/15390> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3690> ;
    skos:definition "system viewed in a holistic manner by examining the linkages and interactions between the elements that comprise the whole of the system"@en ;
    skos:prefLabel "system thinking"@en .

<http://www.eionet.europa.eu/gemet/concept/15391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15068> ;
    skos:definition "change required when efforts to change one aspect of a system fail to fix the problem and the whole system needs to be transformed, namely the fundamental qualities of the system itself, through innovation, experimentation, constant learning and adaptation"@en ;
    skos:prefLabel "systemic change"@en .

<http://www.eionet.europa.eu/gemet/concept/15392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "framework to facilitate sustainable investment by establishing an EU-wide classification system to provide firms and investors with a common framework for identifying to what degree economic activities can be considered to be 'environmentally sustainable'"@en ;
    skos:prefLabel "Taxonomy Regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/15393> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "systematic long-term risk mispricing and reduction of the diversity of investments between issuers of securities (mostly long-term), intermediaries (mostly short-term) and beneficiaries (mostly long-term) that leads to a short-term focus on risk metrics and incentives, amplifying the mispricing of actual risk and opportunities"@en ;
    skos:prefLabel "time-horizon mismatch"@en .

<http://www.eionet.europa.eu/gemet/concept/15394> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9169> ;
    skos:definition "removal or diversion of water from the water environment"@en ;
    skos:prefLabel "water abstraction"@en .

<http://www.eionet.europa.eu/gemet/concept/1541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1542> ;
    skos:definition "A systematic collection of procedures outlining the established method of application of all relevant laws, rules or regulations to a specific endeavor."@en ;
    skos:prefLabel "code of practice"@en .

<http://www.eionet.europa.eu/gemet/concept/1550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "Usually the generation of heat in the form of steam, and the generation of power in the form of electricity. Combined heat and power plants are able to convert a much higher proportion of the energy in fuel into final output. The steam produced may be used through heat exchangers in a district heating scheme, while the electricity provides lighting and power."@en ;
    skos:prefLabel "cogeneration"@en .

<http://www.eionet.europa.eu/gemet/concept/1553> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4182> ;
    skos:definition "Joint incineration of hazardous waste, in any form, with refuse and/or sludge."@en ;
    skos:prefLabel "co-incineration"@en .

<http://www.eionet.europa.eu/gemet/concept/1554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1500> ;
    skos:definition "A coherent, cellular, solid residue remaining from the dry distillation of a coking coal or of pitch, petroleum, petroleum residue, or other carbonaceous materials; contains carbon as its principal constituent."@en ;
    skos:prefLabel "coke"@en .

<http://www.eionet.europa.eu/gemet/concept/1556> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:prefLabel "cold"@en .

<http://www.eionet.europa.eu/gemet/concept/1567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1568> ;
    skos:definition "An intimate mixture of two substances, one of which, called the dispersed phase, is uniformly distributed in a finely divided state through the second substance, called the dispersion medium."@en ;
    skos:prefLabel "colloid"@en .

<http://www.eionet.europa.eu/gemet/concept/1569> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "The successful invasion of a new habitat by a species."@en ;
    skos:prefLabel "colonisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "Any technique by which an unknown colour is evaluated in terms of standard colours; the technique may be visual, photoelectric or indirect by means of spectrophotometry."@en ;
    skos:prefLabel "colourimetry"@en .

<http://www.eionet.europa.eu/gemet/concept/1571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "An attribute of things that results from the light they reflect, transmit, or emit in so far as this light causes a visual sensation that depends on its wavelengths."@en ;
    skos:prefLabel "colour"@en .

<http://www.eionet.europa.eu/gemet/concept/1574> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "A combined effect of two or more substances or organisms which is greater than the sum of the individual effect of each."@en ;
    skos:prefLabel "combination effect"@en .

<http://www.eionet.europa.eu/gemet/concept/1575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "This type of plant is flexible in response and can be built in the 100-600 MW capacity range. It produces electrical power from both a gas turbine (ca. 1300°C gas inlet temperature), fuelled by natural gas or oil plus a steam turbine supplied with the steam generated by the 500°C exhaust gases from the gas turbine. The thermal efficiency of these stations is ca. 50 per cent compared with a maximum of 40 per cent from steam turbine coal fired power stations. This type of plant can be built in two years compared with six years for a coal-fired station and 10-15 years for nuclear."@en ;
    skos:prefLabel "combined cycle-power station"@en .

<http://www.eionet.europa.eu/gemet/concept/1576> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "A mixture of domestic or industrial wastewater and surface runoff."@en ;
    skos:prefLabel "combined waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/1578> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The property of a substance of being capable of igniting and burning."@en ;
    skos:prefLabel "combustibility"@en .

<http://www.eionet.europa.eu/gemet/concept/1588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13149> ;
    skos:definition "Holding or displaying for sale, offering for sale, selling, delivering or placing on the market in any other form."@en ;
    skos:prefLabel "commercialisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1591> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise emitted from commercial activities."@en ;
    skos:prefLabel "commercial noise"@en .

<http://www.eionet.europa.eu/gemet/concept/1594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "The operations and movements related to the transportation and exchange of goods."@en ;
    skos:prefLabel "commercial traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/1595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "Vehicle designed and equipped for the transportation of goods."@en ;
    skos:prefLabel "commercial vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/1596> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "All types of waste generated by offices, restaurants, shops, warehouses and other such non-manufacturing sources, and non-processing waste generated at manufacturing facilities such as office and packaging waste."@en ;
    skos:prefLabel "trade waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2533> ;
    skos:definition "The set of regulations and practices adopted by member countries of the European Community that consolidates efforts in promoting or ensuring reasonable pricing, fair standards of living, stable markets, increased farm productivity and methods for dealing with food supply or surplus."@en ;
    skos:prefLabel "common agricultural policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A system of law established by following earlier judicial decisions and customs, rather than statutory or legislatively enacted law."@en ;
    skos:prefLabel "common agreement"@en .

<http://www.eionet.europa.eu/gemet/concept/1618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/77> ;
    skos:definition "Involvement in public or private actions, as members or as a member of a particular ethnic, political or social group, with the purpose of exerting influence."@en ;
    skos:prefLabel "community participation"@en .

<http://www.eionet.europa.eu/gemet/concept/1619> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4752> ;
    skos:definition "A tenet of environmental policy, according to which the costs of ecological challenges, environmental quality improvements and the removal of environmental hazards are allotted to community groups or local corporations and, thereby, to the general public."@en ;
    skos:prefLabel "community-pays principle"@en .

<http://www.eionet.europa.eu/gemet/concept/1622> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Traffic caused by people travelling regularly over some distance, as between a suburb and a city and back, between their place of residence and their place of work."@en ;
    skos:prefLabel "commuter traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/1625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "Reduction of the bulk of solid waste by rolling and tamping."@en ;
    skos:prefLabel "compaction"@en .

<http://www.eionet.europa.eu/gemet/concept/1628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:definition "Official guidelines or set of guidelines adopted by a company for the management of its activity."@en ;
    skos:prefLabel "company policy"@en .

<http://www.eionet.europa.eu/gemet/concept/163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6187> ;
    skos:definition "Considerations, values, and judgements pertaining to the quality of the human perceptual experience (including sight, sound, smell, touch, taste, and movement) evoked by phenomena or components of the environment."@en ;
    skos:prefLabel "aesthetics"@en .

<http://www.eionet.europa.eu/gemet/concept/1630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "The study of the principles of legal science by the comparison of various systems of law."@en ;
    skos:prefLabel "comparative law"@en .

<http://www.eionet.europa.eu/gemet/concept/1631> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "Tests conducted to determine whether one procedure is better than another."@en ;
    skos:prefLabel "comparative test"@en .

<http://www.eionet.europa.eu/gemet/concept/1632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:definition "The placing together or juxtaposing of two or more items to ascertain, bring into relief, or establish their similarities and dissimilarities."@en ;
    skos:prefLabel "comparison"@en .

<http://www.eionet.europa.eu/gemet/concept/1633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13291> ;
    skos:definition "Equivalent in money for a loss sustained; equivalent given for property taken or for an injury done to another; recompense or reward for some loss, injury or service."@en ;
    skos:prefLabel "compensation"@en .

<http://www.eionet.europa.eu/gemet/concept/1636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "Any administrative or legislative action, procedure or enactment designed to redress disruptions of ecological integrity or damage to the supply of natural resources."@en ;
    skos:prefLabel "compensatory measure"@en .

<http://www.eionet.europa.eu/gemet/concept/1637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Compulsory charge levied by a government for the purpose of redressing or countervailing economic disparity."@en ;
    skos:prefLabel "compensatory tax"@en .

<http://www.eionet.europa.eu/gemet/concept/1638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "The simultaneous demand by two or more organisms or species for an essential common resource that is actually or potentially in limited supply."@en ;
    skos:prefLabel "competition (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/1641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13262> ;
    skos:definition "The ability of a firm to strive in the market with rivals in the production and sale of commodities or services and, analogously, the ability of a country to maintain a relatively high standard of living for its citizens through trade in international markets."@en ;
    skos:prefLabel "competitiveness"@en .

<http://www.eionet.europa.eu/gemet/concept/1645> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Formation of a complex compound. Also known as complexing or complexation."@en ;
    skos:prefLabel "complex formation"@en .

<http://www.eionet.europa.eu/gemet/concept/1646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A substance capable of forming a complex compound with another material in solution."@en ;
    skos:prefLabel "complexing agent"@en .

<http://www.eionet.europa.eu/gemet/concept/1647> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Emissions of ozone-degrading gases (CFCs, halons); emissions of greenhouse gases (carbon dioxide, methane, CFCs, nitrous oxides, halons); emissions of acidifying gases (sulfur oxides, nitrogen oxides); emissions of substances that contribute to eutrophication (phosphate and nitrogen-containing materials); emissions of toxic materials (pesticides, radioactive substances, priority toxic substances); solid wastes returned to the environment."@en ;
    skos:prefLabel "composite pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/1653> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1652> ;
    skos:prefLabel "composting by producer"@en .

<http://www.eionet.europa.eu/gemet/concept/1659> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Reduction in the volume of a substance due to pressure."@en ;
    skos:prefLabel "compression"@en .

<http://www.eionet.europa.eu/gemet/concept/1660> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A mechanical device a) to provide the desired pressure for chemical and physical reactions, b) to control boiling points of fluids, as in gas separation, refrigeration, and evaporation, c) to evacuate enclosed volumes, d) to transport gases or vapors, e) to store compressible fluids as gases or liquids under pressure and assist in recovering them from storage or tank cars, and f) to convert mechanical energy to fluid energy for operating instruments, air agitation, fluidization, solid transport, blowcases, air tools, and motors."@en ;
    skos:prefLabel "compressor"@en .

<http://www.eionet.europa.eu/gemet/concept/1663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:prefLabel "compulsory use"@en .

<http://www.eionet.europa.eu/gemet/concept/1669> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The collective body that resulted in 1967 from the merger of the administrative networks of the European Atomic Energy Community (EURATOM), the European Coal and Steel Community (ECSC), and the European Economic Community (EEC). The singular term has also been widely used."@en ;
    skos:prefLabel "European Communities"@en .

<http://www.eionet.europa.eu/gemet/concept/1674> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process of increasing the quantity of a component in a solution. The opposite of dilution."@en ;
    skos:prefLabel "concentration (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/1677> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1247> ;
    skos:definition "A mixture of aggregate, water, and a binder, usually Portland cement; it hardens to stonelike condition when dry."@en ;
    skos:prefLabel "concrete"@en .

<http://www.eionet.europa.eu/gemet/concept/1679> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1044> ;
    skos:prefLabel "concrete products industry"@en .

<http://www.eionet.europa.eu/gemet/concept/1681> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Transformation from a gas to a liquid."@en ;
    skos:prefLabel "condensation (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/1686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The ratio of the electric current density to the electric field in a material. Also known as electrical conductivity."@en ;
    skos:prefLabel "conductivity"@en .

<http://www.eionet.europa.eu/gemet/concept/1688> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:prefLabel "conflicting use"@en .

<http://www.eionet.europa.eu/gemet/concept/1689> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:prefLabel "conflict of aims"@en .

<http://www.eionet.europa.eu/gemet/concept/1690> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "Clash between public interest and the private pecuniary interest of the individual concerned. A situation in which regard for one duty tends to lead to disregard of another."@en ;
    skos:prefLabel "conflict of interests"@en .

<http://www.eionet.europa.eu/gemet/concept/1691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1605> ;
    skos:definition "A formal meeting, often consisting of representatives of various organizations, that is assembled to promote, discuss or make arrangements regarding a particular subject or some matter of common interest."@en ;
    skos:prefLabel "congress"@en .

<http://www.eionet.europa.eu/gemet/concept/1692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3805> ;
    skos:definition "An order of conebearing plants which includes nearly all the present day Gymnospermae. Most are tall evergreen trees with needle-like (e.g., pines), linear (e.g. firs) or scale-like (e.g., cedars) leaves. They are characteristic of temperate zones and the main forest trees of colder regions. They provide timber, resins, tars, turpentine and pulp for paper."@en ;
    skos:prefLabel "conifer"@en .

<http://www.eionet.europa.eu/gemet/concept/1694> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A forest type characterized by cone-bearing, needle-leaved trees. They are generally, but not necessarily, evergreen and relatively shallow-rooted. Since they grow more rapidly than most broad-leaved trees, conifers are extensively planted as a source of softwood timber and pulp. They are tolerant of wide-ranging climatic conditions, of many different types of soil and of considerable differences in terrain. Thus, they are found from the polar latitudes to the tropics, on most types of soils (especially, thin acid soils) and from mountain summits to coastal environments."@en ;
    skos:prefLabel "coniferous forest"@en .

<http://www.eionet.europa.eu/gemet/concept/1700> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/1704> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9159> ;
    skos:definition "Controlled utilization, protection or improvement of a natural body of water that does not contain significant amounts of dissolved salts and minerals, such as a lake or river."@en ;
    skos:prefLabel "freshwater conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/1706> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:definition "Controlled utilization, protection and development of the gene pool of natural and cultivated organisms to ensure variety and variability and for current and potential value to human welfare."@en ;
    skos:prefLabel "conservation of genetic resources"@en .

<http://www.eionet.europa.eu/gemet/concept/1708> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Measures adopted for the protection and the maintenance of hystorical and art monuments."@en ;
    skos:prefLabel "conservation of monuments"@en .

<http://www.eionet.europa.eu/gemet/concept/171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "An afterburner is a gadget fitted to the exhaust flues of furnaces and also to the exhaust systems of motor vehicles. They remove polluting gases and particles, which are the result of incompletely combusted fuel, by incineration and break down other chemical molecules associated with combustion into inert chemicals."@en ;
    skos:prefLabel "afterburning"@en .

<http://www.eionet.europa.eu/gemet/concept/1712> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "That branch of the public law of a nation or state which treats of the organization, powers and frame of government, the distribution of political and governmental authorities and functions, the fundamental principles which are to regulate the relations of government and citizen and which prescribes generally the plan and method according to which the public affairs of the nation or state are to be administered."@en ;
    skos:prefLabel "constitutional law"@en .

<http://www.eionet.europa.eu/gemet/concept/1718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Heavy power machines which perform specific construction or demolition functions."@en ;
    skos:prefLabel "construction equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/1724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise resulting from construction activities such as site preparation, site clearance, demolition of existing buildings, piling, concreting, erection of structures, etc."@en ;
    skos:prefLabel "construction noise"@en .

<http://www.eionet.europa.eu/gemet/concept/1725> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1731> ;
    skos:prefLabel "construction of installations"@en .

<http://www.eionet.europa.eu/gemet/concept/1730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1731> ;
    skos:definition "Construction with waste product used as raw material."@en ;
    skos:prefLabel "construction with recycled material"@en .

<http://www.eionet.europa.eu/gemet/concept/1732> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "Any meeting or inquiry of concerned persons or advisors for the purpose of deliberation, discussion or decision on some matter or action."@en ;
    skos:prefLabel "consultation"@en .

<http://www.eionet.europa.eu/gemet/concept/1737> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "Manufactured products intended primarily for personal use by individuals or families and classified as either durables or non-durables, depending on length of use."@en ;
    skos:prefLabel "consumer goods"@en .

<http://www.eionet.europa.eu/gemet/concept/1738> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A collection of persons united to address concerns regarding the purchase and use of specific commodities or services."@en ;
    skos:prefLabel "consumer group"@en .

<http://www.eionet.europa.eu/gemet/concept/1740> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13156> ;
    skos:definition "Information disseminated or measures and programs established to prevent and reduce damage, injury or loss to users of specific commodities and services."@en ;
    skos:prefLabel "consumer protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Materials purchased, used and discarded by the buyer, or consumer, as opposed to those discarded in a manufacturing process."@en ;
    skos:prefLabel "consumer waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1748> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The reinforced steel or concrete vessel that encloses a nuclear reactor. It is designed to withstand minor explosions in the core, to keep radionuclides from escaping into the environment, and to be safe against terrorist attack."@en ;
    skos:prefLabel "containment (nuclear industry)"@en .

<http://www.eionet.europa.eu/gemet/concept/1751> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7851> ;
    skos:definition "Soil which because of its previous or current use has substances under, on or in it which, depending upon their concentration and/or quantity, may represent a direct potential or indirect hazard to man or to the environment."@en ;
    skos:prefLabel "contaminated soil"@en .

<http://www.eionet.europa.eu/gemet/concept/1759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "The amount or quantity of polluting material found in a transporting agent that flows at a steady rate, in contrast to a sudden or dramatic influx."@en ;
    skos:prefLabel "continuous load"@en .

<http://www.eionet.europa.eu/gemet/concept/1761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "The performing of cultivations along lines connecting points of equal elevation so reducing the loss of top soil by erosion, increasing the capacity of the soil to retain water and reducing the pollution of water by soil."@en ;
    skos:prefLabel "contour farming"@en .

<http://www.eionet.europa.eu/gemet/concept/1763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13722> ;
    skos:definition "A commercial service provider, usually bound by a written agreement, responsible for the removal of dirt, litter or other unsightly materials from any property."@en ;
    skos:prefLabel "contract cleaner"@en .

<http://www.eionet.europa.eu/gemet/concept/1769> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The planned use of carefully controlled fire to accomplish predetermined management goals. The burn is set under a combination of weather, fuel moisture, soil moisture, and fuel arrangement conditions that allow the management objectives to be attained, and yet confine the fire to the planned area."@en ;
    skos:prefLabel "controlled burning"@en .

<http://www.eionet.europa.eu/gemet/concept/1772> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "An administered geographic area in which the pursuit, capture and killing of wild animals for food or sport, is allowed, often with certain restrictions or regulations."@en ;
    skos:prefLabel "controlled hunting zone"@en .

<http://www.eionet.europa.eu/gemet/concept/1773> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a person or an organized assemblage of persons to manage, direct, superintend, restrict, regulate, govern, administer or oversee."@en ;
    skos:prefLabel "controlling authority"@en .

<http://www.eionet.europa.eu/gemet/concept/1774> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2795> ;
    skos:prefLabel "control measure"@en .

<http://www.eionet.europa.eu/gemet/concept/1775> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition """1) A large densely populated urban sprawl formed by the growth and coalescence of individual towns or cities.
2) Large area covered with buildings (houses or factories or public building, etc.)
3) A large area occupied by urban development, which may contain isolated rural areas, and formed by the merging together of expanding towns that formerly were separate."""@en ;
    skos:prefLabel "conurbation"@en .

<http://www.eionet.europa.eu/gemet/concept/1781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Setting aside a highly radioactive material until the radioactivity has diminished to a desired level."@en ;
    skos:prefLabel "cooling"@en .

<http://www.eionet.europa.eu/gemet/concept/1782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Oil used as a cooling agent, either with forced circulation or with natural circulation."@en ;
    skos:prefLabel "cooling oil"@en .

<http://www.eionet.europa.eu/gemet/concept/1784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A device that aids in heat removal from water used as a coolant in electric power generating plants."@en ;
    skos:prefLabel "cooling tower"@en .

<http://www.eionet.europa.eu/gemet/concept/1786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9180> ;
    skos:definition "Water used to make something less hot, such as the irradiated elements from a nuclear reactor or the engine of a machine."@en ;
    skos:prefLabel "cooling water"@en .

<http://www.eionet.europa.eu/gemet/concept/1788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:prefLabel "co-operation principle"@en .

<http://www.eionet.europa.eu/gemet/concept/1791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "co-ordination"@en .

<http://www.eionet.europa.eu/gemet/concept/1792> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A chemical element; one of the most important nonferrous metals; a ductile and malleable metal found in various ores and used in industry, engineering, and the arts in both pure and alloyed form."@en ;
    skos:prefLabel "copper"@en .

<http://www.eionet.europa.eu/gemet/concept/1794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1548> ;
    skos:definition "The skeleton of certain solitary and colonial anthozoan coelenterates; composed chiefly of calcium carbonate."@en ;
    skos:prefLabel "coral"@en .

<http://www.eionet.europa.eu/gemet/concept/1796> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7034> ;
    skos:definition "Coral reefs have been built up from the skeletons of reef-building coral a small primitive marine animal, and other marine animals and algae over thousands of years. They occur in clear, shallow and sunlit seas. Coral reefs are one of the most productive and diverse ecosystems and are estimated to yield about 12% of the world's fish catch. They are very vulnerable to any change in their environment, especially pollution, because it makes the water opaque. They must have light in order that photosyntesis by the algae can take place. Like trees, corals reflect the environmental conditions in which they grow, indicating marine pollution, sea-surface temperature and other aquatic conditions."@en ;
    skos:prefLabel "coral reef"@en .

<http://www.eionet.europa.eu/gemet/concept/1799> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5708> ;
    skos:definition "An accidental overheating of the part of the nuclear reactor where fission takes place, causing fuel elements and other parts of the reactor to melt, potentially leading to catastrophic consequences in which dangerous levels of radioactive materials would be released into the environment."@en ;
    skos:prefLabel "core meltdown"@en .

<http://www.eionet.europa.eu/gemet/concept/1800> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3432> ;
    skos:definition "The thick light porous outer bark of the cork oak, used widely as an insulator and for stoppers for bottles, casks, etc."@en ;
    skos:prefLabel "cork"@en .

<http://www.eionet.europa.eu/gemet/concept/1807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A physical linkage, connecting two areas of habitat and differing from the habitat on either side. Corridors are used by organisms to move around without having to leave the preferred habitat."@en ;
    skos:prefLabel "corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/1808> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A process in which a solid, especially a metal, is eaten away and changed by a chemical action."@en ;
    skos:prefLabel "corrosion"@en .

<http://www.eionet.europa.eu/gemet/concept/1813> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1310> ;
    skos:definition "Industry for the production of substances for improving the appearance of the body."@en ;
    skos:prefLabel "cosmetic industry"@en .

<http://www.eionet.europa.eu/gemet/concept/1814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Radiations consisting of atomic nuclei, especially protons, of very high energy that reach the earth from outer space. Some cosmic radiations are very energetic and are able to penetrate a mile or more into the Earth."@en ;
    skos:prefLabel "cosmic radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/1818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1817> ;
    skos:definition "The attempt to assess, compare and frequently justify the total price or loss represented by a certain activity or expenditure with the advantage or service it provides."@en ;
    skos:prefLabel "cost-benefit analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "The coming together in accord of two minds on a given proposition. In law, a concord of understanding and intention between two or more parties with respect to the effect upon their relative rights and duties, of certain past or future facts or performances. The consent of two or more persons concerning respecting the transmission of some property, right, or benefits, with the view of contracting an obligation, a mutual obligation."@en ;
    skos:prefLabel "agreement (legal)"@en .

<http://www.eionet.europa.eu/gemet/concept/1820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13261> ;
    skos:definition "The augmentation or rise in the amount of money incurred or asked for in the exchange of goods and services."@en ;
    skos:prefLabel "cost increase"@en .

<http://www.eionet.europa.eu/gemet/concept/1822> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "A standard used to provide reimbursement to individuals or organizations for any incurred expense or provided service."@en ;
    skos:prefLabel "cost recovery basis"@en .

<http://www.eionet.europa.eu/gemet/concept/1823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13261> ;
    skos:definition "The lessening or lowering in the amount of money incurred or asked for in the exchange of goods and services."@en ;
    skos:prefLabel "cost reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/1825> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2796> ;
    skos:definition "The amount of money incurred as a result of human-made or human-induced alteration of the physical, biological, chemical, and radiological integrity of air, water, and other media."@en ;
    skos:prefLabel "pollution cost"@en .

<http://www.eionet.europa.eu/gemet/concept/1826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "The amount of money incurred as a result of the financial management of a nation's financial resources."@en ;
    skos:prefLabel "national economic costs"@en .

<http://www.eionet.europa.eu/gemet/concept/1827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6325> ;
    skos:definition "The most economical natural fiber, obtained from plants of the genus Gossypium, used in making fabrics, cordage, and padding and for producing artificial fibers and cellulose."@en ;
    skos:prefLabel "cotton"@en .

<http://www.eionet.europa.eu/gemet/concept/183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13242> ;
    skos:definition "An agreement, convention, or promise of two or more parties, by deed in writing, signed, and delivered, by which either of the parties pledges himself to the other that something is either done, or shall be done, or shall not be done, or stipulates for the truth of certain facts."@en ;
    skos:prefLabel "agreement (contract)"@en .

<http://www.eionet.europa.eu/gemet/concept/1837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8062> ;
    skos:definition "An area comprising more than one city and whose boundaries have been designed according to some biological, political, administrative, economic, demographic criteria."@en ;
    skos:prefLabel "county"@en .

<http://www.eionet.europa.eu/gemet/concept/1842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11594> ;
    skos:definition "A tribunal having jurisdiction of appeal and review, including the ability to overturn decisions of lower courts or courts of first instance."@en ;
    skos:prefLabel "court of justice"@en .

<http://www.eionet.europa.eu/gemet/concept/1846> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "covering"@en .

<http://www.eionet.europa.eu/gemet/concept/185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/898> ;
    skos:prefLabel "agricultural biotechnology"@en .

<http://www.eionet.europa.eu/gemet/concept/1854> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3205> ;
    skos:definition "The help and support from banks and other financial institutions in providing money or goods without requiring present payment."@en ;
    skos:prefLabel "credit assistance"@en .

<http://www.eionet.europa.eu/gemet/concept/1865> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1864> ;
    skos:definition "The maximum load that a given system can tolerate before failing."@en ;
    skos:prefLabel "critical load"@en .

<http://www.eionet.europa.eu/gemet/concept/1870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7124> ;
    skos:definition "Any large tropical reptile of the family Crocodylidae: order Crocodylia. They have a broad head, tapering snout, massive jaws, and a thick outer covering of bony plates."@en ;
    skos:prefLabel "crocodile"@en .

<http://www.eionet.europa.eu/gemet/concept/1875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "An agricultural technique in which, season after season, each field is sown with crop plants in a regular rotation, each crop being repeated at intervals of several years. Crop rotation minimizes the risks of depleting the soil of particular nutrients. In rotation systems, a grain crop is often grown the first year, followed by a leafy-vegetable crop in the second year, and a pasture crop in the third. The last usually contains legumes; such plants can restore nitrogen to the soil. Notwithstanding, high yields tend to depend upon the continued addition of chemical fertilizers to the soil."@en ;
    skos:prefLabel "crop rotation"@en .

<http://www.eionet.europa.eu/gemet/concept/1877> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/229> ;
    skos:definition "Any unusable portion of plant matter left in a field after harvest."@en ;
    skos:prefLabel "crop waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1880> ;
    skos:definition "Bridges and tunnels provided for animals for crossing roads and railways. Railway and road infrastructures represent an hindrance to wildlife migration."@en ;
    skos:prefLabel "crossing place for animals"@en .

<http://www.eionet.europa.eu/gemet/concept/1885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6161> ;
    skos:definition "A comparatively volatile liquid bitumen composed principally of hydrocarbon, with traces of sulphur, nitrogen or oxygen compounds; can be removed from the earth in a liquid state."@en ;
    skos:prefLabel "crude oil"@en .

<http://www.eionet.europa.eu/gemet/concept/1888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8598> ;
    skos:definition "Travelling by sea in a liner for pleasure, usually calling at a number of ports."@en ;
    skos:prefLabel "cruising"@en .

<http://www.eionet.europa.eu/gemet/concept/1891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The formation of crystalline substances from solutions or melts."@en ;
    skos:prefLabel "crystallisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5270> ;
    skos:definition "The branch of science that deals with the geometric description of crystals and their internal arrangement."@en ;
    skos:prefLabel "crystallography"@en .

<http://www.eionet.europa.eu/gemet/concept/1898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants specially bred or improved by cultivation."@en ;
    skos:prefLabel "cultivated plant"@en .

<http://www.eionet.europa.eu/gemet/concept/1909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/23> ;
    skos:definition "The process whereby the capabilities or possibilities inherent in a people's beliefs, customs, artistic activity and knowledge are brought out or made more effective."@en ;
    skos:prefLabel "cultural development"@en .

<http://www.eionet.europa.eu/gemet/concept/191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:prefLabel "agricultural ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/1915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:definition "Cultural indicators give information about societies, which may be interesting even when one is not trying to evaluate the cultures of these societies from any normative point of view. Cultural indicators may also have an evaluative purpose involving explicit or implicit normative criteria."@en ;
    skos:prefLabel "cultural indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/1917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:prefLabel "cultural policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "The aggregate of courses of study provided in a particular school, college, university, adult education program, technical institution or some other educational program."@en ;
    skos:prefLabel "curriculum"@en .

<http://www.eionet.europa.eu/gemet/concept/1928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4808> ;
    skos:definition "A group pattern of habitual activity usually transmitted across generations and, in some instances, having the force of law."@en ;
    skos:prefLabel "custom and usage"@en .

<http://www.eionet.europa.eu/gemet/concept/1929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1590> ;
    skos:definition "Duties charged upon commodities on their importation into, or exportation out of, a country."@en ;
    skos:prefLabel "customs"@en .

<http://www.eionet.europa.eu/gemet/concept/1930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3444> ;
    skos:definition "The act or process of felling or uprooting standing trees, in order to produce timber products."@en ;
    skos:prefLabel "cutting (forestry)"@en .

<http://www.eionet.europa.eu/gemet/concept/1931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "A salt or ester of cyanic acid containing the radical OCN."@en ;
    skos:prefLabel "cyanate"@en .

<http://www.eionet.europa.eu/gemet/concept/1933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Any of a group of compounds containing the CN group and derived from hydrogen cyanide, HCN."@en ;
    skos:prefLabel "cyanide"@en .

<http://www.eionet.europa.eu/gemet/concept/194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2571> ;
    skos:definition "Any solid, liquid or gas that enters the environment as a by-product of agricultural activities."@en ;
    skos:prefLabel "agricultural effluent"@en .

<http://www.eionet.europa.eu/gemet/concept/1941> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A storm characterized by the converging and rising giratory movement of the wind around a zone of low pressure (the eye) towards which it is violently pulled from a zone of high pressure. Its circulation is counterclockwise round the center in the northern hemisphere, clockwise in the southern hemisphere."@en ;
    skos:prefLabel "cyclone"@en .

<http://www.eionet.europa.eu/gemet/concept/1945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "A branch of the biological sciences which deals with the structure, behaviour, growth, and reproduction of cells and the functions and chemistry of cell components."@en ;
    skos:prefLabel "cytology"@en .

<http://www.eionet.europa.eu/gemet/concept/1946> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:definition "The degree to which an agent possesses a specific destructive action on certain cells or the possession of such action; used particularly in referring to the lysis of cells by immune phenomena and to antineoplastic drugs that selectively kill dividing cells."@en ;
    skos:prefLabel "cytotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "A discipline concerned with developing and improving the means for providing food and fiber for mankind's needs."@en ;
    skos:prefLabel "agricultural engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/1950> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1951> ;
    skos:definition "A commercial establishment for processing or selling milk and milk products."@en ;
    skos:prefLabel "dairy farm"@en .

<http://www.eionet.europa.eu/gemet/concept/1956> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1437> ;
    skos:definition "An injury or harm impairing the function or condition of a person or thing."@en ;
    skos:prefLabel "damage"@en .

<http://www.eionet.europa.eu/gemet/concept/1958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5243> ;
    skos:definition "Injury or harm resulting from the planned movement of armed forces or from the tactical exercises simulating war operations that is carried out for training and evaluation purposes."@en ;
    skos:prefLabel "damage from military manoeuvres"@en .

<http://www.eionet.europa.eu/gemet/concept/1959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11661> ;
    skos:definition "The aggregate of approaches and measures to ensure that human action or natural phenomena do not cause damage. It implies the formulation and implementation of long-range policies and programmes to eliminate or prevent the damages caused by disasters."@en ;
    skos:prefLabel "damage prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/1968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3063> ;
    skos:definition "Transporting substances capable of producing adverse health effects, fires or explosions to other countries or areas for the conduct of foreign trade."@en ;
    skos:prefLabel "hazardous chemical export"@en .

<http://www.eionet.europa.eu/gemet/concept/1969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "Goods or products that are full of hazards or risks when used, transported, etc."@en ;
    skos:prefLabel "dangerous goods"@en .

<http://www.eionet.europa.eu/gemet/concept/197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Machines utilized for tillage, planting, cultivation, and harvesting of crops."@en ;
    skos:prefLabel "agricultural equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/1970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:prefLabel "dangerous goods law"@en .

<http://www.eionet.europa.eu/gemet/concept/1971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "Rules on the handling of articles or substances capable of posing a significant risk to health, safety, or property, and that ordinarily require special attention when being transported."@en ;
    skos:prefLabel "dangerous goods regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/1974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803>,
        <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "The act of collecting and gathering individual facts, statistics or other items of information."@en ;
    skos:prefLabel "data acquisition"@en .

<http://www.eionet.europa.eu/gemet/concept/1975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The evaluation of digital data, i.e. data represented by a sequence of code characters."@en ;
    skos:prefLabel "data analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/1988> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "Policies, procedures or devices designed to maintain the integrity or security of informational elements in storage or in transmission."@en ;
    skos:prefLabel "data protection"@en .

<http://www.eionet.europa.eu/gemet/concept/199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:prefLabel "agricultural exploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/1992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "Any of several techniques such as radioactive dating, dendrochronology, or varve dating, for establishing the age of rocks, palaeontological or archaeological specimens, etc."@en ;
    skos:prefLabel "dating"@en .

<http://www.eionet.europa.eu/gemet/concept/1993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2042> ;
    skos:definition "An isotope formed by the radioactive decay of some other isotope. This newly formed isotope possesses physical and chemical properties that are different from those of its parent isotope, and may also be radioactive."@en ;
    skos:prefLabel "decay product"@en .

<http://www.eionet.europa.eu/gemet/concept/1996> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1378> ;
    skos:definition "A persistent organochlorine insecticide, also known as dichlorodiphenyltrichloroethane, that was introduced in the 1940s and used widely because of its persistence (meaning repeated applications were unnecessary), its low toxicity to mammals and its simplicity and cheapness of manufacture. It became dispersed all over the world and, with other organochlorines, had a disruptive effect on species high in food chains, especially on the breeding success of certain predatory birds. DDT is very stable, relatively insoluble in water, but highly soluble in fats. Health effects on humans are not clear, but it is less toxic than related compounds. It is poisonous to other vertebrates, especially fish, and is stored in the fatty tissue of animals as sublethal amounts of the less toxic DDE. Because of its effects on wildlife its use in most countries is now forbidden or strictly limited."@en ;
    skos:prefLabel "DDT"@en .

<http://www.eionet.europa.eu/gemet/concept/20> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Level of risk judged to be outweighed by corresponding benefits or one that is of such a degree that it is considered to pose minimal potential for adverse effects."@en ;
    skos:prefLabel "acceptable risk level"@en .

<http://www.eionet.europa.eu/gemet/concept/2001> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3205> ;
    skos:definition "The fees or amount of money necessary to pay interest on an outstanding debt, the principal of maturing serial bonds, and the required contributions to an amortization or sinking fund for term bonds."@en ;
    skos:prefLabel "debt service"@en .

<http://www.eionet.europa.eu/gemet/concept/2002> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The mechanical dewatering of a wet solid by pouring off the liquid without disturbing the underlying sediment or precipitate."@en ;
    skos:prefLabel "racking"@en .

<http://www.eionet.europa.eu/gemet/concept/2003> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "Basic organizational leadership concept and process of shifting and delegating power and authority from a higher level to subordinate levels within the administrative/managerial hierarchy in order to promote independence, responsibility, and quicker decision-making in applying or interpreting policies and procedures to the needs of these levels."@en ;
    skos:prefLabel "decentralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/2004> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "The temperate forests comprised of trees that seasonally shed their leaves, located in the east of the USA, in Western Europe from the Alps to Scandinavia, and in the eastern Asia. The hardwood of these forests have been exploited since the 16th century. The trees of deciduous forests usually produce nuts and winged seeds."@en ;
    skos:prefLabel "deciduous forest"@en .

<http://www.eionet.europa.eu/gemet/concept/2005> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:definition "Tree losing its leaves in autumn and growing new ones in the spring."@en ;
    skos:prefLabel "deciduous tree"@en .

<http://www.eionet.europa.eu/gemet/concept/2006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Means the exercise of agency authority at any stage of an undertaking where alterations might be made in the undertaking to modify its impact upon historic and cultural properties."@en ;
    skos:prefLabel "decision"@en .

<http://www.eionet.europa.eu/gemet/concept/2014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The more or less permanent breakdown of a molecule into simpler molecules or atoms."@en ;
    skos:prefLabel "decomposition"@en .

<http://www.eionet.europa.eu/gemet/concept/202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "Land used primarily for the production of plant or animal crops, including arable agriculture, dairying, pasturage, apiaries, horticulture, floriculture, viticulture, animal husbandry and the necessary lands and structures needed for packing, processing, treating, or storing the produce."@en ;
    skos:prefLabel "agricultural land"@en .

<http://www.eionet.europa.eu/gemet/concept/2022> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7495> ;
    skos:definition "Region of open ocean beyond the continental shelf."@en ;
    skos:prefLabel "deep sea"@en .

<http://www.eionet.europa.eu/gemet/concept/2023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5264> ;
    skos:prefLabel "deep sea deposit"@en .

<http://www.eionet.europa.eu/gemet/concept/2024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12417> ;
    skos:definition "The disposal of solid waste or sludge by carrying the wastes out to sea, usually in a barge, and dumping into deep water."@en ;
    skos:prefLabel "deep-sea disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/2025> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5035> ;
    skos:definition "Fishing in the deepest parts of the sea."@en ;
    skos:prefLabel "deep sea fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/2029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "The common name for 41 species of even-toed ungulates that compose the family Cervidae in the order Artiodactyla; males have antlers."@en ;
    skos:prefLabel "deer"@en .

<http://www.eionet.europa.eu/gemet/concept/2031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "The act or process of protecting citizens or any geographical area by preparing for or by using military means to resist the attack of an enemy."@en ;
    skos:prefLabel "defence"@en .

<http://www.eionet.europa.eu/gemet/concept/2035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6459> ;
    skos:definition """1) The drop of foliage from plants caused by herbicides such as Agent Orange, diuron, triazines, all of which interfere with photosynthesis. The use of defoliants, as in Vietnam or in jungle clearance for agriculture, can permanently destroy tropical forests. Once the tree cover is removed, the soil is subjected to erosion and precious nutrients are rapidly leached away.
2) Destroying (an area of jungle, forest, etc.) as by chemical sprays or incendiary bombs, in order to give enemy troops or guerilla forces no place of concealment."""@en ;
    skos:prefLabel "defoliation"@en .

<http://www.eionet.europa.eu/gemet/concept/2041> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15154>,
        <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "The result of the cumulative activities of farmers, households, and industries, all trying to improve their socio-economic well being. These activities tend to be counterproductive for several reasons. People may not completely understand the long-term consequences of their activities on the natural resource base. The most important ways in which human activity is interfering with the global ecosystem are: a) fossil fuel burning which may double the atmospheric carbon dioxide concentration by the middle of the next century, as well as further increasing the emissions of sulphur and nitrogen very significantly; b) expanding agriculture and forestry and the associated use of fertilizers (nitrogen and phosphorous) are significantly altering the natural circulation of these nutrients; c) increased exploitation of the freshwater system both for irrigation in agriculture and industry and for waste disposal."@en ;
    skos:prefLabel "degradation of natural resources"@en .

<http://www.eionet.europa.eu/gemet/concept/2044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320>,
        <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition """1) Removing grease from wool with chemicals.
2) Removing grease from hides or skins in tanning by tumbling them in solvents. 
3) Removing grease, oil, or fatty material from a metal surface with fumes from a hot solvent."""@en ;
    skos:prefLabel "degreasing"@en .

<http://www.eionet.europa.eu/gemet/concept/2048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "Series of processes by which various types of printing inks are removed from paper fibre pulp during the pre-processing and recycling of recovered paper products. Particularly necessary where high quality and whiteness of the finished product are required."@en ;
    skos:prefLabel "de-inking"@en .

<http://www.eionet.europa.eu/gemet/concept/2052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7244> ;
    skos:definition "A delta is a vast, fan-shaped creation of land, or low-lying plain, formed from successive layers of sediment washed from uplands to the mouth of some rivers, such as the Nile, the Mississippi and the Ganges. The nutrient-rich sediment is deposited by rivers at the point where, or before which, the river flows into the sea. Deltas are formed when rivers supply and deposit sediments more quickly that they can be removed by waves of ocean currents. The importance of deltas was first discovered by prehistoric man, who was attracted to them because of their abundant animal and plant life. Connecting waterways through the deltas later provided natural routes for navigation and trade, and opened up access to the interior. Deltas are highly fertile and often highly populated areas. They would be under serious threat of flooding from any sea-level rise."@en ;
    skos:prefLabel "delta"@en .

<http://www.eionet.europa.eu/gemet/concept/2053> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "The desire, ability and willingness of an individual to purchase a good or service. The consumer must have the funds or the ability to obtain funds in order to convert the desire into demand. The demand of a buyer for a certain good is a schedule of the quantities of that good which the individual would buy at possible alternative prices at a given moment in time."@en ;
    skos:prefLabel "demand"@en .

<http://www.eionet.europa.eu/gemet/concept/2054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6384> ;
    skos:definition "A system of governance in which ultimate authority power is vested in the people and exercised directly by them or by their freely elected agents."@en ;
    skos:prefLabel "democracy"@en .

<http://www.eionet.europa.eu/gemet/concept/2062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6824> ;
    skos:definition "The activity of reducing buildings or other structures to rubble."@en ;
    skos:prefLabel "demolition business"@en .

<http://www.eionet.europa.eu/gemet/concept/2064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1059> ;
    skos:definition "Masonry or rubble wastes arising from the demolition of buildings or other civil engineering structures."@en ;
    skos:prefLabel "demolition waste"@en .

<http://www.eionet.europa.eu/gemet/concept/2066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:prefLabel "demonstrability"@en .

<http://www.eionet.europa.eu/gemet/concept/2069> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/971> ;
    skos:definition "The science of dating the age of a tree by studying annual growth rings. It is also employed to interpret previous environments and climatic variations by examining certain kinds of trees. It is based on the theory that the width of the growth ring reflects the amount of rainfall and the temperature of the year in which it was formed."@en ;
    skos:prefLabel "dendrochronology"@en .

<http://www.eionet.europa.eu/gemet/concept/207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13222> ;
    skos:definition "Machines utilized for tillage, planting, cultivation and harvesting of crops. Despite its benefits in increasing yields, mechanisation has clearly had some adverse environmental effects: deep ploughing exposes more soil to wind and water erosion; crop residues can be removed as opposed to ploughing back into the soil; removal of residues can lead to a serious loss of organic content in the soil, which may increase the risk of soil erosion."@en ;
    skos:prefLabel "agricultural machinery"@en .

<http://www.eionet.europa.eu/gemet/concept/2070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "The measuring of the diameter of standing trees from the ground with a dendrometer that can also be used to measure tree heights."@en ;
    skos:prefLabel "dendrometry"@en .

<http://www.eionet.europa.eu/gemet/concept/2071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7103> ;
    skos:definition """1) The loss of nitrogen from soil by biological or chemical means. It is a gaseous loss, unrelated to loss by physical processes such as through leachates. 
2) The breakdown of nitrates by soil bacteria, resulting in the release of free nitrogen. This process takes place under anaerobic conditions, such as are found in water-logged soil, and it reduces soil fertility."""@en ;
    skos:prefLabel "denitrification"@en .

<http://www.eionet.europa.eu/gemet/concept/2072> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9043> ;
    skos:definition "Current methods for controlling NOx emissions in motor vehicles include retardation of spark timing, increasing the air/fuel ratio, injecting water into the cylinders, decreasing the compression ratio, and recirculating exhaust gas. For stationary sources, one abatement method is to use a lower NOx producing fuel or to modify the combustion process by injecting steam into the combustion chamber."@en ;
    skos:prefLabel "denitrification of waste gas"@en .

<http://www.eionet.europa.eu/gemet/concept/2083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/633> ;
    skos:prefLabel "deposited particulate matter"@en .

<http://www.eionet.europa.eu/gemet/concept/2088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2498> ;
    skos:definition "The removal or relaxation of government control over the economic activities of some commercial entity, industry or economic sector."@en ;
    skos:prefLabel "deregulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2093> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:prefLabel "dermapteran"@en .

<http://www.eionet.europa.eu/gemet/concept/2099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition """1) Plants for the extraction of fresh water from saltwater by the removal of salts, usually by distilling.
2) Parts of the world with severe water shortages are looking to desalination plants to solve their problems. Desalination of water is still nearly four times more expensive than obtaining water from conventional sources. However technology is improving and costs are likely to decrease slightly in the future. There is now more interest in building distillation plants beside electric installations so that the waste heat from power generation can be used to drive the desalination process."""@en ;
    skos:prefLabel "desalination plant"@en .

<http://www.eionet.europa.eu/gemet/concept/21> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A coming together of minds; a coming together in opinion or determination; the coming together in accord of two minds on a given proposition. In law, a concord of understanding and intention between two or more parties with respect to the effect upon their relative rights and duties, of certain past or future facts or performances. The consent of two or more persons concerning respecting the transmission of some property, right, or benefits, with the view of contracting an obligation, a mutual obligation. The union of two or more minds in a thing done or to be done; a mutual assent to do a thing."@en ;
    skos:prefLabel "agreement (administrative)"@en .

<http://www.eionet.europa.eu/gemet/concept/2103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/552> ;
    skos:definition "A wide, open, comparatively barren tract of land with few forms of life and little rainfall."@en ;
    skos:prefLabel "desert"@en .

<http://www.eionet.europa.eu/gemet/concept/2105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition """1) The development of desert conditions as a result of human activity or climatic changes.
2) The process of land damage which allows the soil to spread like a desert in arid and semi-arid regions. There is a loss of vegetative cover and the soil deteriorates in texture, nutrient content and fertility. Desertification affects the lives of three-quarters of the world's population, 70% of all drylands and one quarter of the total land area of the planet. There are many reasons for desertification, but the majority are caused by human activities, overgrazing, deforestation, poor land management and over-exploitation. Agenda 21 states that the priority in combating desertification should be establishing preventive measures for lands that are not yet, or are only slightly, degraded."""@en ;
    skos:prefLabel "desertification"@en .

<http://www.eionet.europa.eu/gemet/concept/2109> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2795> ;
    skos:definition "Remedial and preventive actions adopted against desertification include irrigation, planting of trees and grasses, the erection of fences to secure sand dunes, and a careful management of water resources."@en ;
    skos:prefLabel "desertification control"@en .

<http://www.eionet.europa.eu/gemet/concept/2111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3732> ;
    skos:prefLabel "desert locust"@en .

<http://www.eionet.europa.eu/gemet/concept/2117> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:prefLabel "desk study"@en .

<http://www.eionet.europa.eu/gemet/concept/2119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process of removing a sorbed substance by the reverse of adsorption or absorption."@en ;
    skos:prefLabel "desorption"@en .

<http://www.eionet.europa.eu/gemet/concept/2125> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1336> ;
    skos:definition "Removal of sulfur from fossil fuels (or removal of sulfur dioxide from combustion fuel gases) to reduce pollution."@en ;
    skos:prefLabel "desulphurisation of fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/2127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The act or process of discovering evidence or proof of governmental, legal or ethical violations."@en ;
    skos:prefLabel "detection"@en .

<http://www.eionet.europa.eu/gemet/concept/2129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5349> ;
    skos:definition "A mechanical, electrical, or chemical device that automatically identifies and records or registers a stimulus, such as an environmental change in pressure or temperature, an electrical signal, or radiation from a radioactive material."@en ;
    skos:prefLabel "detector"@en .

<http://www.eionet.europa.eu/gemet/concept/2139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088> ;
    skos:definition "Method employed in the assessment or in the evaluation of a quantity, a quality, a fact, an event, etc."@en ;
    skos:prefLabel "determination method"@en .

<http://www.eionet.europa.eu/gemet/concept/2140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14950> ;
    skos:definition "Any measure, implement or policy designed to discourage or restrain the actions or advance of another agent, organization or state."@en ;
    skos:prefLabel "deterrent"@en .

<http://www.eionet.europa.eu/gemet/concept/2143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3877> ;
    skos:definition "The act or process of removing a poison or the toxic properties of a substance in the body."@en ;
    skos:prefLabel "detoxification"@en .

<http://www.eionet.europa.eu/gemet/concept/2147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8078> ;
    skos:definition "A nation possessing a relatively high degree of industrialization, infrastructure and other capital investment, sophisticated technology, widespread literacy and advanced living standards among its populations as a whole."@en ;
    skos:prefLabel "developed country"@en .

<http://www.eionet.europa.eu/gemet/concept/215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted by government or some other organization that determines how to deal with matters involving the cultivation of land; raising crops; feeding, breeding and raising livestock or poultry; and other farming issues."@en ;
    skos:prefLabel "agricultural policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2000> ;
    skos:prefLabel "developing countries debt"@en .

<http://www.eionet.europa.eu/gemet/concept/2152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8078> ;
    skos:definition "A country whose people are beginning to utilize available resources in order to bring about a sustained increase in per capita production of goods and services."@en ;
    skos:prefLabel "developing country"@en .

<http://www.eionet.europa.eu/gemet/concept/2155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13302> ;
    skos:definition "The economic assistance or other types of support provided to developing countries to promote or encourage advancement in living standards, institutions, infrastructure, agricultural practices and other aspects of an economy, and to resolve problems typically  associated with developing countries."@en ;
    skos:prefLabel "development aid"@en .

<http://www.eionet.europa.eu/gemet/concept/2156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Area which has been given special help from a government to encourage business and factories to be set up there."@en ;
    skos:prefLabel "development area"@en .

<http://www.eionet.europa.eu/gemet/concept/2157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1787> ;
    skos:prefLabel "development co-operation"@en .

<http://www.eionet.europa.eu/gemet/concept/2158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2490> ;
    skos:definition "A description, representation, or conception of the economic advancement process of a region or people."@en ;
    skos:prefLabel "development model"@en .

<http://www.eionet.europa.eu/gemet/concept/216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "The liquid or solid wastes from farming, including: runoff from pesticides, fertilizers, and feedlots; erosion and dust from plowing; animal manure and carcasses, crop residues, and debris."@en ;
    skos:prefLabel "agricultural pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/2160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The act or process of formulating a course of action that promotes the economic advancement of a region or people, particularly in countries known to have low levels of economic productivity and technological sophistication."@en ;
    skos:prefLabel "development planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "The statement of local planning policies that each local planning authority is required by statute to maintain, and which can only be made or altered by following the procedures prescribed for that purpose, which include obligations to consult widely and to hold a public local inquiry into objections. The development plan includes: 1) the structure plan for the area (normally prepared by the country council); 2) an area-wide development plan for each district council area."@en ;
    skos:prefLabel "development plan"@en .

<http://www.eionet.europa.eu/gemet/concept/2167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A process of selective diffusion through a membrane; usually used to separate low-molecular-weight solutes which diffuse through the membrane from the colloidal and high-molecular-weight solutes which do not."@en ;
    skos:prefLabel "dialysis"@en .

<http://www.eionet.europa.eu/gemet/concept/2168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1406> ;
    skos:definition "Unicellular algae, some of which are colonial, green or brownish in colour (but all contain chlorophyll) and with siliceous and often highly sculptured cell walls. Diatoms make up much of the producer level in marine and freshwater food chains, and they have contributed to the formation of oil reserves. Deposits of diatomaceous earths were formed by the accumulation of diatom cell walls."@en ;
    skos:prefLabel "diatom"@en .

<http://www.eionet.europa.eu/gemet/concept/2173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A reference book containing an explanatory alphabetical list of words, as a book listing a comprehensive or restricted selection of the words of a language; identifying usually, the phonetic, grammatical, and semantic value of each word, often with etymology, citations, and usage guidance and other information."@en ;
    skos:prefLabel "dictionary"@en .

<http://www.eionet.europa.eu/gemet/concept/2177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1582> ;
    skos:definition "An internal combustion engine operating on a thermodynamic cycle in which the ratio of compression of the air charge is sufficiently high to ignite the fuel subsequently injected into the combustion chamber."@en ;
    skos:prefLabel "diesel engine"@en .

<http://www.eionet.europa.eu/gemet/concept/2179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15200>,
        <http://www.eionet.europa.eu/gemet/concept/15274>,
        <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "Heavy oil residue used as fuel for certain types of diesel engines."@en ;
    skos:prefLabel "diesel fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/2182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The development of cells so that they are capable of performing specialized functions in the organs and tissues of the organisms to which they belong."@en ;
    skos:prefLabel "differentiation"@en .

<http://www.eionet.europa.eu/gemet/concept/2185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:definition "Pollution which arises from various activities with no discrete source."@en ;
    skos:prefLabel "diffuse source"@en .

<http://www.eionet.europa.eu/gemet/concept/2186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The spontaneous movement and scattering of particles (atoms and molecules), of liquid, gases, and solids."@en ;
    skos:prefLabel "diffusion"@en .

<http://www.eionet.europa.eu/gemet/concept/2187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:definition "Sludge or thickened mixture of sewage solids with water that has been decomposed by anaerobic bacteria."@en ;
    skos:prefLabel "digested sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/2188> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "Machine which takes refuse and produces gas such as methane from it."@en ;
    skos:prefLabel "digester"@en .

<http://www.eionet.europa.eu/gemet/concept/2190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The reduction in volume and the decomposition of highly putrescible organic matter to relatively stable or inert organic and inorganic compounds. Sludge digestion is usually done by aerobic organisms in the absence of free oxygen."@en ;
    skos:prefLabel "digestion (sewage)"@en .

<http://www.eionet.europa.eu/gemet/concept/2195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5325> ;
    skos:definition "A representation of a surface's topography stored in a numerical format. Each pixel has been assigned coordinates and an altitude."@en ;
    skos:prefLabel "digital land model"@en .

<http://www.eionet.europa.eu/gemet/concept/2196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "The process of converting data to a form used in computers, transmitted or stored with digital technology and expressed as a string of 0's and 1's."@en ;
    skos:prefLabel "digitising"@en .

<http://www.eionet.europa.eu/gemet/concept/22> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "Any street or narrow stretch of paved surface that leads to a specific destination, such as a main highway."@en ;
    skos:prefLabel "access road"@en .

<http://www.eionet.europa.eu/gemet/concept/2200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/52> ;
    skos:definition "A less concentrated acid."@en ;
    skos:prefLabel "diluted acid"@en .

<http://www.eionet.europa.eu/gemet/concept/2211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "Factories and industrial concerns which do not discharge their sewage directly into public sewers, but directly into a waterway."@en ;
    skos:prefLabel "direct discharger"@en .

<http://www.eionet.europa.eu/gemet/concept/2213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5303> ;
    skos:definition "Person lacking one or more physical power, such as the ability to walk or to coordinate one's movements, as from the effects of a disease or accident, or through mental impairment."@en ;
    skos:prefLabel "disabled person"@en .

<http://www.eionet.europa.eu/gemet/concept/2216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2222> ;
    skos:definition "A course or procedure of activity designed to clear the debris or remove harmful substances left by an ecological calamity, natural or human in origin, in a given area."@en ;
    skos:prefLabel "disaster cleanup operation"@en .

<http://www.eionet.europa.eu/gemet/concept/2219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2222> ;
    skos:definition "Work done or agency established to analyze, plan, assign and coordinate available resources in order to prepare for, respond to, mitigate and recover from damage caused by an ecological calamity, natural or human in origin."@en ;
    skos:prefLabel "disaster control service"@en .

<http://www.eionet.europa.eu/gemet/concept/2220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The aggregate of measures to be taken in view of disasters, consisting of plans and action programmes designed to minimize loss of life and damage, to organize and facilitate effective rescue and relief, and to rehabilitate after disaster. Preparedness requires the necessary legislation and means to cope with disaster or similar emergency situations. It is also concerned with forecasting and warning, the education and training of the public, organization and management, including plans, training of personnel, the stockpiling of supplies and ensuring the needed funds and other resources."@en ;
    skos:prefLabel "disaster preparedness"@en .

<http://www.eionet.europa.eu/gemet/concept/2221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11661> ;
    skos:definition "The aggregate of approaches and measures to ensure that human action or natural phenomena do not cause or result in disaster or similar emergency. It implies the formulation and implementation of long-range policies and programmes to eliminate or prevent the occurrence of disasters."@en ;
    skos:prefLabel "disaster prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/2226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9091> ;
    skos:prefLabel "discharge legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4115> ;
    skos:definition "The rate of flow of a river at a particular moment in time, related to its volume and its velocity."@en ;
    skos:prefLabel "discharge regime"@en .

<http://www.eionet.europa.eu/gemet/concept/2237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "An agent, such as heat, radiation, or a chemical, that disinfects by destroying, neutralizing, or inhibiting the growth of disease-carrying microorganisms."@en ;
    skos:prefLabel "disinfectant"@en .

<http://www.eionet.europa.eu/gemet/concept/2238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6798> ;
    skos:definition "The complex of physical, chemical or mechanical operations undertaken to destroy pathogenic germs."@en ;
    skos:prefLabel "disinfection"@en .

<http://www.eionet.europa.eu/gemet/concept/224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Any deposit or holdings of farm products, fertilizers, grains, feed and other related supplies in facilities or containers, often to prevent contamination or for times when production cannot meet demand."@en ;
    skos:prefLabel "agricultural storage"@en .

<http://www.eionet.europa.eu/gemet/concept/2242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:prefLabel "dispatch note"@en .

<http://www.eionet.europa.eu/gemet/concept/2245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A distribution of finely divided particles in a medium."@en ;
    skos:prefLabel "dispersion"@en .

<http://www.eionet.europa.eu/gemet/concept/2246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:definition "The calculation of pollutant dispersion is based on the use of air dispersion models that mathematically simulate atmospheric conditions and behaviour. Dispersion models can provide concentration or deposition estimates and can be used to evaluate both existing and hypothetical emissions scenarios."@en ;
    skos:prefLabel "dispersion calculation"@en .

<http://www.eionet.europa.eu/gemet/concept/2247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "Persons who, for different reasons or circumstances, have been compelled to leave their homes."@en ;
    skos:prefLabel "displaced person"@en .

<http://www.eionet.europa.eu/gemet/concept/2253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:prefLabel "disposal of the dead"@en .

<http://www.eionet.europa.eu/gemet/concept/2254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "Disposal of the material remnants of war, which can seriously impede development and cause injuries and the loss of lives and property. The disposal of warfare waste is problematic because it can be highly dangerous, toxic, long-living and requires the utilization of specific and sophisticated technologies, particularly in the case of mines and unexploded bombs which have been left on the war territories."@en ;
    skos:prefLabel "disposal of warfare materials"@en .

<http://www.eionet.europa.eu/gemet/concept/2257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "Dissolving of a material."@en ;
    skos:prefLabel "dissolution"@en .

<http://www.eionet.europa.eu/gemet/concept/2259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5892> ;
    skos:definition "The fraction of total organic carbon (all carbon atoms covalently bonded in organic molecules) in water that passes through a 0.45 micron pore-diameter filter."@en ;
    skos:prefLabel "dissolved organic carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/2260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process of producing a gas or vapour from a liquid by heating the liquid in a vessel and collecting and condensing the vapours into liquids."@en ;
    skos:prefLabel "distillation"@en .

<http://www.eionet.europa.eu/gemet/concept/2262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/783> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and marketing of alcoholic beverages made by a distillation process of vaporization and condensation, such as vodka, rum, whiskey and other related beverages."@en ;
    skos:prefLabel "distilling industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1639> ;
    skos:definition "Article 85(1) of the EEC Treaty prohibits all agreements between undertakings, decisions by associations of undertakings and concerted practices which may affect trade between member states and which have as their object or effect the prevention, restriction or distortion of competition within the common market. All such arrangements are automatically null and void under Article 85(2), unless exempted by the Commission pursuant to Article 85(3). The text of Article 85 is as follows: \"1. The following shall be prohibited as incompatible with the common market: all agreements between undertakings, decisions by associations of undertakings and concerted practices which may affect trade between member states and which have as their object or effect the prevention, restriction or distortion of competition within the common market, and in particular those which: (a) directly or indirectly fix purchase or selling prices or any other trading conditions; (b) limit or control production, markets, technical development, or investment; (c) share markets or sources of supply; (d) apply dissimilar conditions to equivalent transactions with other trading parties, thereby placing them at a competitive disadvantage; (e) make the conclusion of contracts subject to acceptance by the other parties of supplementary obligations which, by their nature or according to commercial usage, have no connection with the subject of such contracts."@en ;
    skos:prefLabel "distortion of competition"@en .

<http://www.eionet.europa.eu/gemet/concept/2264> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "In an environmental context, the term refers to the dispersion of air pollutants and depends on the type of pollution source (point source, line source, diffuse source), the wind velocity and the wind direction. Distribution can be active or passive."@en ;
    skos:prefLabel "distribution"@en .

<http://www.eionet.europa.eu/gemet/concept/2269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3907> ;
    skos:definition "The supply of heat, either in the form of steam or hot water, from a central source to a group of buildings."@en ;
    skos:prefLabel "district heating"@en .

<http://www.eionet.europa.eu/gemet/concept/2270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3900> ;
    skos:definition "Plant for heating all houses in a district; it consists of a large, efficient, centralized boiler plant or \"waste\" steam from a power station. The heat is distributed by means of low-pressure steam or high-temperature water to the consumers."@en ;
    skos:prefLabel "district heating plant"@en .

<http://www.eionet.europa.eu/gemet/concept/2275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666>,
        <http://www.eionet.europa.eu/gemet/concept/7> ;
    skos:definition "Military site where all activity has ceased. Such areas, being extremely well sheltered against outside disturbances and in many ways less affected by human landuse than many other open landscapes, can contain significant natural habitats and rare or endangered wildlife. Abandoned military territories constitute an important source of natural landscapes to be managed and restored in an environmentally sound way."@en ;
    skos:prefLabel "disused military site"@en .

<http://www.eionet.europa.eu/gemet/concept/2276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8887> ;
    skos:definition "A long, narrow excavation artificially dug in the ground; especially an open and usually unpaved waterway, channel, or trench for conveying water for drainage or irrigation, and usually smaller than a canal. Some ditches may be natural watercourses."@en ;
    skos:prefLabel "ditch"@en .

<http://www.eionet.europa.eu/gemet/concept/2279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3628> ;
    skos:definition "The principal material of inheritance. It is found in chromosomes and consists of molecules that are long unbranched chains made up of many nucleotides. Each nucleotide is a combination of phosphoric acid, the monosaccharide deoxyribose and one of four nitrogenous bases: thymine, cytosine, adenine or guanine. The number of possible arrangements of nucleotides along the DNA chain is immense. Usually two DNA strands are linked together in parallel by specific base-pairing and are helically coiled. Replication of DNA molecules is accomplished by separation of the two strands, followed by the building up of matching strands by means of base-pairing, using the two halves as templates. By a mechanism involving RNA, the structure of DNA is translated into the structure of proteins during their synthesis from amino acids."@en ;
    skos:prefLabel "DNA"@en .

<http://www.eionet.europa.eu/gemet/concept/2287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1134> ;
    skos:definition "A common four-legged animal, especially kept by people as a pet or to hunt or guard things."@en ;
    skos:prefLabel "dog"@en .

<http://www.eionet.europa.eu/gemet/concept/2293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Fuels obtained from different sources that are used for domestic heating."@en ;
    skos:prefLabel "domestic fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/2294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3512> ;
    skos:definition "Liquid petroleum product used in domestic heaters."@en ;
    skos:prefLabel "domestic fuel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/2298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise caused by domestic facilities and activities."@en ;
    skos:prefLabel "domestic noise"@en .

<http://www.eionet.europa.eu/gemet/concept/2300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "Trade wholly carried on at home; as distinguished from foreign commerce."@en ;
    skos:prefLabel "domestic trade"@en .

<http://www.eionet.europa.eu/gemet/concept/2301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12377> ;
    skos:definition "Waste generated by residential households and comprised of any material no longer wanted or needed."@en ;
    skos:prefLabel "domestic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/2304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Site for the disposal of wastes arising from domestic activities."@en ;
    skos:prefLabel "domestic waste landfill"@en .

<http://www.eionet.europa.eu/gemet/concept/2305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Wastewater principally derived from households, business buildings, institutions, etc., which may or may not contain surface runoff, groundwater or storm water."@en ;
    skos:prefLabel "domestic waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/2307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2308> ;
    skos:definition "The amount of a substance required to produce an effect."@en ;
    skos:prefLabel "dosage"@en .

<http://www.eionet.europa.eu/gemet/concept/2309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2308> ;
    skos:definition "The relation between the quantity of a given substance and a measurable or observable effect."@en ;
    skos:prefLabel "dose-effect relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/2315> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "An initial unsigned agreement, treaty, or piece of legislation which is not yet in force."@en ;
    skos:prefLabel "draft legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5802> ;
    skos:definition "Any of the insects composing six families of the suborder Anisoptera and having four large, membranous wings and compound eyes that provide keen vision."@en ;
    skos:prefLabel "dragonfly"@en .

<http://www.eionet.europa.eu/gemet/concept/2323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Incidental surface waters from diverse sources such as rainfall, snow melt or permafrost melt."@en ;
    skos:prefLabel "drainage water"@en .

<http://www.eionet.europa.eu/gemet/concept/2324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3122> ;
    skos:prefLabel "draught animal"@en .

<http://www.eionet.europa.eu/gemet/concept/2326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Unconsolidated material removed from rivers, streams, and shallow seas with machines such as the bucket-ladder dredge, dragline dredge, or suction dredge."@en ;
    skos:prefLabel "dredged material"@en .

<http://www.eionet.europa.eu/gemet/concept/2327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Removing solid matter from the bottom of a water area."@en ;
    skos:prefLabel "dredging"@en .

<http://www.eionet.europa.eu/gemet/concept/2330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Aqueous residue deriving from the process of oil extraction from olives; it is composed of the olive-combined water and of the water used in the extraction and washing processes. It also contains a certain percentage of mineral compounds and of organic substances that are only partially biodegradable."@en ;
    skos:prefLabel "olive oil mill waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/2332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5035> ;
    skos:definition "The use of fishing nets of great length and depth, aptly described as \"walls of death\" because of the huge numbers of marine mammals, birds, and turtles that became ensnared in them. The Tarawa Declaration of 1989 formulated at the 20th South Pacific Forum, aimed at banning drift netting in the South Pacific. In June 1992 the UN banned drift netting in all the world's oceans."@en ;
    skos:prefLabel "drift net fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/2336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "The structural base upon which the drill rig and associated equipment is mounted during the drilling operation."@en ;
    skos:prefLabel "drilling installation"@en .

<http://www.eionet.europa.eu/gemet/concept/2339> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water that is agreeable to drink, does not present health hazards and whose quality is normally regulated by legislation."@en ;
    skos:prefLabel "drinking water"@en .

<http://www.eionet.europa.eu/gemet/concept/2340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6747> ;
    skos:definition "Area surrounding a water recovery plant in which certain forms of soil utilization are restricted or prohibited in order to protect the groundwater."@en ;
    skos:prefLabel "drinking water protection area"@en .

<http://www.eionet.europa.eu/gemet/concept/2343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9244> ;
    skos:definition "The provision and storage of potable water, or the amount of potable water stored, for the use of a municipality, or other potable water user."@en ;
    skos:prefLabel "drinking water supply"@en .

<http://www.eionet.europa.eu/gemet/concept/2347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A period of abnormally dry weather sufficiently prolonged so that the lack of water causes a serious hydrologic imbalance (such as crop damage, water supply shortage) in the affected area."@en ;
    skos:prefLabel "drought"@en .

<http://www.eionet.europa.eu/gemet/concept/235> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for the management of soil, crops and livestock."@en ;
    skos:prefLabel "agriculture framework plan"@en .

<http://www.eionet.europa.eu/gemet/concept/2350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures taken to prevent, mitigate or eliminate damage caused to the ecosystem, especially crops, by a sustained period of dry weather."@en ;
    skos:prefLabel "drought control"@en .

<http://www.eionet.europa.eu/gemet/concept/2352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2564> ;
    skos:prefLabel "drug abuse"@en .

<http://www.eionet.europa.eu/gemet/concept/2358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4702> ;
    skos:definition "To clean fabrics etc. with a solvent other than water."@en ;
    skos:prefLabel "dry cleaning"@en .

<http://www.eionet.europa.eu/gemet/concept/2359> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3110> ;
    skos:definition "The accumulation of both particles and gases as they come into contact with soil, water or vegetation on the earth's surfaces."@en ;
    skos:prefLabel "dry deposition"@en .

<http://www.eionet.europa.eu/gemet/concept/2360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "A system of extensive agriculture allowing the production of crops without irrigation in areas of limited rainfall. Dry farming involves conserving soil moisture through mulching, frequent fallowing, maintenance of a fine tilth by cross-ploughing, repeated working of the soil after rainfall and removal of any weeds that would take up some of the moisture."@en ;
    skos:prefLabel "dry farming"@en .

<http://www.eionet.europa.eu/gemet/concept/2363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2361> ;
    skos:definition "Removal of water from any substance."@en ;
    skos:prefLabel "drying out"@en .

<http://www.eionet.europa.eu/gemet/concept/2364> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2508> ;
    skos:definition "An economy based upon two separate/distinct economic systems which co-exist in the same geographical space. Dualism is characteristic of many developing countries in which some parts of a country resemble advanced economies while other parts resemble traditional economies, i.e. there are circuits of production and exchange."@en ;
    skos:prefLabel "dual economy"@en .

<http://www.eionet.europa.eu/gemet/concept/2365> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "To reduce the quantity of packaging waste, and thereby of overall MSW, Germany introduced a far-reaching legislation to reduce waste, based on the producer's responsibility principle. Industry was given the option to set up a third party organization which would carry out the collection and sorting of sales packaging for care of manufacturers and retailers. Thus, Some 600 companies created \"Duales System Deutschland\" in 1990 (\"Dual\" because it meant creating a second collection system in parallel to the existing waste collection system of the local authorities). Duales System Deutschland (DSD), now has overall responsibility for the separate collection and recycling of packaging. At present, the Dual System is the only nationwide system for the collection and sorting of sales packaging. Packaging participating in this collection system is marked with the Green Dot."@en ;
    skos:prefLabel "dual waste management"@en .

<http://www.eionet.europa.eu/gemet/concept/2380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7912> ;
    skos:definition "Period of the day during which the sun is shining."@en ;
    skos:prefLabel "duration of sunshine"@en .

<http://www.eionet.europa.eu/gemet/concept/2381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7919> ;
    skos:definition "Any kind of solid material divided in particles of very small size."@en ;
    skos:prefLabel "dust"@en .

<http://www.eionet.europa.eu/gemet/concept/2383> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4146> ;
    skos:prefLabel "dust immission"@en .

<http://www.eionet.europa.eu/gemet/concept/2384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "The removal of dust from air by ventilation or exhaust systems."@en ;
    skos:prefLabel "dust removal"@en .

<http://www.eionet.europa.eu/gemet/concept/2386> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:definition "The duty to formally enroll with a government agency or an authority in order to be granted certain rights, particularly trademark or copyright privileges, or the  permission to sell and distribute a product."@en ;
    skos:prefLabel "registration obligation"@en .

<http://www.eionet.europa.eu/gemet/concept/2387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7144> ;
    skos:definition "Any enclosed space wholly or partially used or intended to be used for living, sleeping, cooking, and eating."@en ;
    skos:prefLabel "dwelling"@en .

<http://www.eionet.europa.eu/gemet/concept/239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "The interplanting of farm crops and trees, especially leguminous species. In semiarid regions and on denuded hillsides, agroforestry helps control erosion and restores soil fertility, as well as supplying valuable food and commodities at the same time."@en ;
    skos:prefLabel "agroforestry"@en .

<http://www.eionet.europa.eu/gemet/concept/2393> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4082> ;
    skos:definition "An artificial wall, embankment, ridge, or mound, usually of earth or rock fill, built around a relatively flat, low-lying area to protect it from flooding; a levee. A dyke may be also be constructed on the shore or border of a lake to prevent inflow of undesirable water."@en ;
    skos:prefLabel "dyke"@en .

<http://www.eionet.europa.eu/gemet/concept/2394> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/9236> ;
    skos:definition "The addition of material to strengthen the structure of the dykes."@en ;
    skos:prefLabel "dyke reinforcement"@en .

<http://www.eionet.europa.eu/gemet/concept/2398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9035> ;
    skos:definition "Any series of procedures and devices designed to detect sudden or potential threats to persons, property or the environment at the first sign of danger; especially a system utilizing radar technology."@en ;
    skos:prefLabel "early warning system"@en .

<http://www.eionet.europa.eu/gemet/concept/24> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11527> ;
    skos:prefLabel "access to the sea"@en .

<http://www.eionet.europa.eu/gemet/concept/240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry dealing with the supply, processing and distribution of farm products."@en ;
    skos:prefLabel "agroindustry"@en .

<http://www.eionet.europa.eu/gemet/concept/2402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7575> ;
    skos:definition "The violent shaking of the ground produced by deep seismic waves, beneath the epicentre, generated by a sudden decrease or release in a volume of rock of elastic strain accumulated over a long time in regions of seismic activity (tectonic earthquake). The magnitude of an earthquake is represented by the Richter scale; the intensity by the Mercalli scale."@en ;
    skos:prefLabel "earthquake"@en .

<http://www.eionet.europa.eu/gemet/concept/2408> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/456> ;
    skos:definition "Any of numerous oligochaete worms of the genera Lumbricus, Allolobophora, Eisenia, etc., which burrow in the soil and help aerate and break up the ground."@en ;
    skos:prefLabel "earthworm"@en .

<http://www.eionet.europa.eu/gemet/concept/2409> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "Any of various insects of the order Dermaptera, especially Forficula auricularia, which typically have an elongated body with small leathery forewings, semicircular membranous hindwings, and curved forceps at the tip of the abdomen."@en ;
    skos:prefLabel "earwig"@en .

<http://www.eionet.europa.eu/gemet/concept/241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5197> ;
    skos:definition "The study of the interaction between meteorological and hydrological factors, on the one hand, and agriculture in the widest sense, including horticulture, animal husbandry and forestry, on the other."@en ;
    skos:prefLabel "agrometeorology"@en .

<http://www.eionet.europa.eu/gemet/concept/2411> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:definition "A geographic region of the African continent that includes Burundi, Kenya, Rwanda, Tanzania, Uganda, Ethiopia and Somalia, and also Mt. Kilimanjaro and Lake Victoria."@en ;
    skos:prefLabel "East Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/2412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:definition "A geographic region of the Asian continent bordered by the Pacific Ocean in the east that includes China, Japan, Korea, Macao, Taiwan and Siberia."@en ;
    skos:prefLabel "Eastern Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/2414> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:prefLabel "East-West relations"@en .

<http://www.eionet.europa.eu/gemet/concept/2415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4444> ;
    skos:definition "Trade between countries and companies of the Western hemisphere with those of the Eastern hemisphere (usually referring to former Communist countries of Eastern Europe)."@en ;
    skos:prefLabel "East-West trade"@en .

<http://www.eionet.europa.eu/gemet/concept/2419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The organ of the EU that is primarily concerned with the formulation of policy and the adoption of Community legislation. The Council consists of one member of government of each of the member states of the Community, and its presidency is held by each state in turn for periods of six months."@en ;
    skos:prefLabel "EC Council of Ministers"@en .

<http://www.eionet.europa.eu/gemet/concept/2423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive regulating the placing of biocidal products on the market."@en ;
    skos:prefLabel "EC directive on biocides"@en .

<http://www.eionet.europa.eu/gemet/concept/2424> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "EC Directive proposed on 15 July 1992 aiming at harmonizing national measures concerning the management of packaging and packaging waste; the directive covers all packaging placed on the market."@en ;
    skos:prefLabel "EC directive on packaging"@en .

<http://www.eionet.europa.eu/gemet/concept/2425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "EC Directive whose main object concerns waste prevention, recycling and transformation into alternative energy sources."@en ;
    skos:prefLabel "EC directive on waste disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/2426> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15330>,
        <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive concerning the use and management of water resources for a rational economical and social development and the protection of the related environmental features."@en ;
    skos:prefLabel "EC directive on water protection"@en .

<http://www.eionet.europa.eu/gemet/concept/2427> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10936> ;
    skos:definition "The European Community (EC) initiative to encourage the promotion of environmentally friendly products. The scheme came into operation in late 1992 and was designed to identify products which are less harmful to the environment than equivalent brands. For example, eco-labels will be awarded to products that do not contain chlorofluorocarbons (CFCs) which damage ozone layer, to those products that can be, or are, recycled, and to those that are energy efficient. The labels are awarded on environmental criteria set by the EC. These cover the whole life cycle of a product, from the extraction of raw materials, through manufacture, distribution, use and disposal of the product. The first products to carry the EC eco-labels were washing machines, paper towels, writing paper, light bulbs and hairsprays."@en ;
    skos:prefLabel "EC ecolabel"@en .

<http://www.eionet.europa.eu/gemet/concept/2428> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "Marine coelomate animals distinguished from all others by an internal skeleton composed of calcite plates, and a water-vascular system to serve the needs of locomotion, respiration, nutrition or perception."@en ;
    skos:prefLabel "echinoderm"@en .

<http://www.eionet.europa.eu/gemet/concept/243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "The acquired immunodeficiency syndrome is caused by HIV-virus manifested by opportunistic infections and/or malignancies, and the mortality rate is very high. The syndrome results from a breakdown of the body's disease-fighting mechanism that leaves it defenceless against infections, such as pulmonary tuberculosis, Pneumocystis pneumonia, certain blood infections, candidiasis, invasive cervical cancer, Kaposi's sarcoma or any of over 20 other indicator diseases. No effective treatment is available. A striking feature of AIDS is the wide spectrum and frequency of infections with life-threatening pathogens seldom seen in normal hosts. The illness may begin with insidious signs and symptoms, and the process may be more diffuse than when the same conditions are seen in other immune-compromised patients. Four patterns of disease occur in AIDS patients. The pulmonary pattern, the central nervous system pattern, the gastrointestinal pattern, and the pattern of fever of unknown origin. Most patients who recover from a given opportunistic infection subsequently either have a relapse or develop a new type of infection. Many patients continue to have a wasting syndrome and experience such infections as oral thrush. Feelings of depression and isolation are common among AIDS patients and can be intensified if health care workers display fear of the syndrome."@en ;
    skos:prefLabel "AIDS"@en .

<http://www.eionet.europa.eu/gemet/concept/2434> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2805> ;
    skos:definition """1) Conservative development based on long term optimization of biosphere resources.
2)An approach to development through rational use of natural resources by means of appropriate technology and system of production which take into account and provide for the conservation of nature."""@en ;
    skos:prefLabel "ecodevelopment"@en .

<http://www.eionet.europa.eu/gemet/concept/2435> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4566> ;
    skos:definition "The European Community's initiative to encourage the promotion of environmentally friendly products. The scheme came into operation in late 1992 and was designed to identify products which are less harmful to the environment than equivalent brands. It was hoped that by buying labelled goods, consumers would be able to put pressure on manufacturers and retailers both to make and to stock \"greener\" products. This includes the effects they have on the environment at all stages. The labels are awarded on environmental criteria set by the EC."@en ;
    skos:prefLabel "ecolabelling"@en .

<http://www.eionet.europa.eu/gemet/concept/2437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Number of individual specimens of an animal or plant seen over a certain period of time in a certain place."@en ;
    skos:prefLabel "ecological abundance"@en .

<http://www.eionet.europa.eu/gemet/concept/2442> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The systematic accounting or recordkeeping of a company's impact on the environment or its progress towards environmentally sound business practices."@en ;
    skos:prefLabel "ecological bookkeeping"@en .

<http://www.eionet.europa.eu/gemet/concept/2456> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition """1) The space occupied by a species, which includes both the physical space as well as the functional role of the species.
2) Ecological niche refers to the characteristics of an environment that provides all the essential food and protection for the continued survival of a particular species of flora or fauna. In addition to food and shelter, there is no long-term threat to existence in that place from potential predators, parasites and competitors. The concept of the ecological niche goes a long way beyond the idea of the species habitat."""@en ;
    skos:prefLabel "ecological niche"@en .

<http://www.eionet.europa.eu/gemet/concept/2461> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7603> ;
    skos:definition "Area where it is likely that a change in some parts of the system will produce a recognizable response."@en ;
    skos:prefLabel "ecologically sensitive area"@en .

<http://www.eionet.europa.eu/gemet/concept/2469> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7805> ;
    skos:definition "Grouping of individuals and organizations dedicated to the protection of the environment."@en ;
    skos:prefLabel "ecologist movement"@en .

<http://www.eionet.europa.eu/gemet/concept/2474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The study of the feeding relationships of organisms in communities and ecosystems. Trophic links between populations represent flows of organisms, organic energy and nutrients. Trophic transfers are important in population dynamics, biogeochemistry, and ecosystem energetics."@en ;
    skos:prefLabel "trophic ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/2477> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The competency in performance in business matters involving the relation between financial and environmental principles."@en ;
    skos:prefLabel "economical-ecological efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/2484> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2490> ;
    skos:definition "The state of nations and the historical processes of change experienced by them, the extent to which the resources of a nation are brought into productive use; the concept of development subsumes associated social, cultural and political changes as well as welfare measures."@en ;
    skos:prefLabel "economic development"@en .

<http://www.eionet.europa.eu/gemet/concept/2494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2493> ;
    skos:definition "A tool or method used by any organization in the management of developmental processes used in the production of, or in the regulation of, material resources."@en ;
    skos:prefLabel "economic management instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "A system or process for controlling the temperature and sometimes the humidity and purity of the air in a house, etc."@en ;
    skos:prefLabel "air conditioning"@en .

<http://www.eionet.europa.eu/gemet/concept/2505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2476> ;
    skos:definition "The complex of elements which, in a given period, characterize the condition or state of a country or region's ability to produce goods, services and other resources with exchange value."@en ;
    skos:prefLabel "economic situation"@en .

<http://www.eionet.europa.eu/gemet/concept/2512> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "Capability of developing and surviving as a relatively independent social, economic or political unit."@en ;
    skos:prefLabel "economic viability"@en .

<http://www.eionet.europa.eu/gemet/concept/2514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9417> ;
    skos:definition "A land-use planning design or control where specific types of businesses or private sector investment are encouraged within designated boundaries."@en ;
    skos:prefLabel "economic zoning"@en .

<http://www.eionet.europa.eu/gemet/concept/2517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "Branch of medical science concerning the study and the therapy of children diseases caused by environmental factors."@en ;
    skos:prefLabel "eco-paediatrics"@en .

<http://www.eionet.europa.eu/gemet/concept/2518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6240> ;
    skos:definition "The study of biophysical, biochemical and physiological processes used by animals to cope with factors of their physical environment, or employed during ecological interactions with other organisms."@en ;
    skos:prefLabel "ecophysiology"@en .

<http://www.eionet.europa.eu/gemet/concept/2520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "Detailed study of an ecosystem carried out to ascertain its features from the point of view of its soil composition, energy flux, biogeochemical cycles, biomass, organisms and their relationship with the environment."@en ;
    skos:prefLabel "ecosystem analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/2523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2918> ;
    skos:definition "Study of the ways in which plants, animals, and microbes interact with each other and with their physical environment and of the processes involving the circulation, transformation and accumulation of both matter, especially nutrient materials, and energy."@en ;
    skos:prefLabel "ecosystem research"@en .

<http://www.eionet.europa.eu/gemet/concept/2527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8522> ;
    skos:definition "Excursions to relatively untouched lands, which for the tourist promise the chance to observe unusual wildlife and indigenous inhabitants. The travel industry, in an attempt to market adventure and authenticity to those travellers weary of \"civilisation\" promote travel to environments free of modern technology. Ecotourism's inherent contradiction is the promotion of untouched lands, which immediately become touched by the hands of tourism."@en ;
    skos:prefLabel "ecotourism"@en .

<http://www.eionet.europa.eu/gemet/concept/2528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:definition "Quality of some substances or preparations which present or may present immediate or delayed risks for one or more sectors of the environment."@en ;
    skos:prefLabel "ecotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/2529> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8541> ;
    skos:definition "Evaluation of the adverse effects of chemicals, physical agents, and natural products on population and communities and plants, animals and human beings."@en ;
    skos:prefLabel "ecotoxicological evaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "Any structure, machine, or contrivance, especially a vehicle, designed to be supported by the air, either by the dynamic action of the air upon the surfaces of the structure or object or by its own buoyancy."@en ;
    skos:prefLabel "aircraft"@en .

<http://www.eionet.europa.eu/gemet/concept/2530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8543> ;
    skos:definition "The science dealing with the adverse effects of chemical, physical agents, and natural products on populations and communities of plants, animals and human beings."@en ;
    skos:prefLabel "ecotoxicology"@en .

<http://www.eionet.europa.eu/gemet/concept/2531> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "Species that has special characteristics which allow it to live in a certain habitat."@en ;
    skos:prefLabel "ecotype"@en .

<http://www.eionet.europa.eu/gemet/concept/2535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2534> ;
    skos:prefLabel "EC regulation on eco-management and audit"@en .

<http://www.eionet.europa.eu/gemet/concept/2536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2534> ;
    skos:definition "Regulation designed to identify and control of risks deriving from existing chemicals. According to this program the main goal is the collection of basic information about existing chemicals including their uses and characteristics, environmental fate and pathways, toxicity and ecotoxicity."@en ;
    skos:prefLabel "EC regulation on existing chemicals"@en .

<http://www.eionet.europa.eu/gemet/concept/2539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:definition "The study of the relationships between soil and organisms, including the use made of land by mankind."@en ;
    skos:prefLabel "edaphology"@en .

<http://www.eionet.europa.eu/gemet/concept/2542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "An oil that can be eaten as a food or food accessory."@en ;
    skos:prefLabel "edible fat"@en .

<http://www.eionet.europa.eu/gemet/concept/255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5391> ;
    skos:definition "The formation and discharge of gaseous and particulate pollutants into the environment, especially the stratosphere, chiefly from airplanes, helicopters and other high-altitude aircrafts."@en ;
    skos:prefLabel "aircraft engine emission"@en .

<http://www.eionet.europa.eu/gemet/concept/2551> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12912> ;
    skos:definition "An organization or establishment devoted to the act or process of imparting or acquiring knowledge or skills."@en ;
    skos:prefLabel "educational institution"@en .

<http://www.eionet.europa.eu/gemet/concept/2554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The process of making arrangements or preparations to facilitate the training, instruction or study that leads to the acquisition of skills or knowledge, or the development of reasoning and judgment."@en ;
    skos:prefLabel "educational planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2555> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government or some other organization, which promotes or determines the goals, methods and programs to be used for training, instruction or study that leads to the acquisition of skills or knowledge, or the development of reasoning and judgment."@en ;
    skos:prefLabel "education policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2557> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2175> ;
    skos:definition "Any formulated, regular or special organization of instruction, training or knowledge disclosure, especially the institutional structures supporting that endeavor."@en ;
    skos:prefLabel "educational system"@en .

<http://www.eionet.europa.eu/gemet/concept/256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Effective sound output of the various sources of noise associated with aircraft operation, such as propeller and engine exhaust, jet noise, and sonic boom."@en ;
    skos:prefLabel "aircraft noise"@en .

<http://www.eionet.europa.eu/gemet/concept/2565> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:prefLabel "effect on man"@en .

<http://www.eionet.europa.eu/gemet/concept/2568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Investigation carried out to assess the results deriving from an action or condition; general term applying to many different fields."@en ;
    skos:prefLabel "research of the effects"@en .

<http://www.eionet.europa.eu/gemet/concept/2570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The ratio of output to input, usually given as a percentage."@en ;
    skos:prefLabel "efficiency level"@en .

<http://www.eionet.europa.eu/gemet/concept/2573> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2654> ;
    skos:definition "A large, female sex cell enclosed in a porous, calcareous or leathery shell, produced by birds and reptiles."@en ;
    skos:prefLabel "egg"@en .

<http://www.eionet.europa.eu/gemet/concept/2578> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "Council Directive of 27 June 1985 on the assessment of the effects of certain public and private projects on the environment (85/337/EEC). The Directive applies to projects which are likely to have significant effects on the environment by virtue of their nature, size or location."@en ;
    skos:prefLabel "EIA directive"@en .

<http://www.eionet.europa.eu/gemet/concept/2579> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "Law concerning the assessment of the effects of certain public and private projects on the environment, based on the EC Directive n. 85/337."@en ;
    skos:prefLabel "EIA law"@en .

<http://www.eionet.europa.eu/gemet/concept/2580> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2830> ;
    skos:definition "The identification, evaluation and appraisal of the ecological consequences of a proposed project or development in a city, town or region, and the measures needed to minimize adverse effects."@en ;
    skos:prefLabel "EIA (local)"@en .

<http://www.eionet.europa.eu/gemet/concept/2582> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "Ability of a material to return to original dimensions after deformation."@en ;
    skos:prefLabel "elasticity"@en .

<http://www.eionet.europa.eu/gemet/concept/2584> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:definition "Someone who has reached the later stage of life or who has attained a specified age within that stage."@en ;
    skos:prefLabel "elderly person"@en .

<http://www.eionet.europa.eu/gemet/concept/2586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "Engineering that deals with practical applications of electricity; generally restricted to applications involving current flow through conductors, as in motors and generators."@en ;
    skos:prefLabel "electrical engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/2592> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A general term used for all phenomena caused by electric charge whether static or in motion."@en ;
    skos:prefLabel "electricity"@en .

<http://www.eionet.europa.eu/gemet/concept/2593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13213> ;
    skos:definition "Company which is responsible for the supply and distribution of electric energy to a given area."@en ;
    skos:prefLabel "electricity company"@en .

<http://www.eionet.europa.eu/gemet/concept/2594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Amount of electricity consumed by an apparatus."@en ;
    skos:prefLabel "electricity consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/2595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2735> ;
    skos:definition "The act or process of transforming other forms of energy into electric energy."@en ;
    skos:prefLabel "electricity generation"@en .

<http://www.eionet.europa.eu/gemet/concept/2596> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "The value or amount of money exchanged for the production and sustained supply of charged ion current used as a power source."@en ;
    skos:prefLabel "electricity generation cost"@en .

<http://www.eionet.europa.eu/gemet/concept/2597> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13213> ;
    skos:definition "Industry for the supply and distribution of electric power."@en ;
    skos:prefLabel "electricity supply industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1777> ;
    skos:definition "The rate at which electric energy is converted to other forms of energy, equal to the product of the current and the voltage drop."@en ;
    skos:prefLabel "electric power"@en .

<http://www.eionet.europa.eu/gemet/concept/2608> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2746> ;
    skos:prefLabel "electric power supply"@en .

<http://www.eionet.europa.eu/gemet/concept/2612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "Vehicle driven by an electric motor and characterized by being silent and less polluting."@en ;
    skos:prefLabel "electric vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/2617> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The study of the motion of electric charges, especially of steady currents in electric circuits, and of the motion of electrified particles in electric or magnetic fields."@en ;
    skos:prefLabel "electrokinetics"@en .

<http://www.eionet.europa.eu/gemet/concept/2618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The production of a chemical reaction by passing an electric current through an electrolyte. In electrolysis, positive ions migrate to the cathode and negative ions to the anode."@en ;
    skos:prefLabel "electrolysis"@en .

<http://www.eionet.europa.eu/gemet/concept/262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/639> ;
    skos:definition "Air movements within the Earth's atmospheric circulation; also called planetary winds. Two main components are recognized: first, the latitudinal meridional component due to the Coriolis force (a deflecting motion or force discussed by G.G. de Coriolis in 1835. The rotation of the Earth causes a body moving across its surface to be deflected to the right in the N hemisphere and to the left in the S hemisphere); and secondly, the longitudinal component and the vertical movement, resulting largely from varying pressure distributions due to differential heating and cooling of the Earth's surface."@en ;
    skos:prefLabel "air movement"@en .

<http://www.eionet.europa.eu/gemet/concept/2625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7483>,
        <http://www.eionet.europa.eu/gemet/concept/7981> ;
    skos:definition "Any material from electronic devices and systems, generated as a waste stream in a processing operation or discarded after service."@en ;
    skos:prefLabel "electronic scrap"@en .

<http://www.eionet.europa.eu/gemet/concept/2626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "Government or management prescribed rule for the disposal and recycling of electric parts, circuits and systems, especially computer devices."@en ;
    skos:prefLabel "electronic scrap regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3209> ;
    skos:definition "Pollution caused by electric and magnetic fields generated by power lines, electrical equipment, mobile and cordless phones, radar, electrical household appliances, microwave ovens, radios, computers, electric clocks, etc."@en ;
    skos:prefLabel "electrosmog"@en .

<http://www.eionet.europa.eu/gemet/concept/2634> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the design, manufacture and marketing of machinery, apparatus and supplies for the generation, storage and utilization of electrical energy, such as household appliances, radio and television receiving equipment, and lighting and wiring equipment."@en ;
    skos:prefLabel "electrotechnical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2653> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2654> ;
    skos:definition "An early stage of development in multicellular organisms."@en ;
    skos:prefLabel "embryo"@en .

<http://www.eionet.europa.eu/gemet/concept/2658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2657> ;
    skos:prefLabel "emergency relief measure"@en .

<http://www.eionet.europa.eu/gemet/concept/2661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "Shelter given to persons who are deprived of the essential needs of life following a disaster."@en ;
    skos:prefLabel "emergency shelter"@en .

<http://www.eionet.europa.eu/gemet/concept/2666> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5348> ;
    skos:definition "Data concerning pollutants released into the environment from a permanent or mobile installation or from products."@en ;
    skos:prefLabel "emission data"@en .

<http://www.eionet.europa.eu/gemet/concept/2668> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "The final step in a clean air plan is to predict future air quality to demonstrate that we can (if we can) meet the health standards by implementing the measures proposed in the plan. This is done by first projecting the emission inventory into the future, taking into account changes in population, housing, employment in specific business sectors, and vehicle miles traveled. These data are obtained from various sources and the resulting emissions are adjusted to account for regulations and control measures scheduled for implementation during the same time period. Additional adjustments are made to reflect large facilities that are expected to start up, modify, or shut down. The resulting inventory is an emission forecast, and is usually expressed in tons per day of particular pollutants for a given year. Additional steps may be required to determine how the forecasted quantities of air pollution will affect the overall air quality. One way to accomplish this is through computer modeling. A computer model simulates how pollutants disperse, react, and move in the air. The inputs to such a computer model are complex. They include weather patterns, terrain, and the chemical nature of air pollutants."@en ;
    skos:prefLabel "emission forecast"@en .

<http://www.eionet.europa.eu/gemet/concept/267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A landing and taking-off area for civil aircraft, usually with surfaced runways and aircraft maintenance and passenger facilities."@en ;
    skos:prefLabel "airport"@en .

<http://www.eionet.europa.eu/gemet/concept/2671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/716> ;
    skos:definition "A system for recording qualified air emission reductions for later use in bubble, offset, or netting transactions. Plant complexes that reduce emissions substantially may \"bank\" their \"credits\" or sell them to other industries."@en ;
    skos:prefLabel "emission reduction banking"@en .

<http://www.eionet.europa.eu/gemet/concept/2672> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4466> ;
    skos:definition "A listing, by source, of the amounts of air pollutants discharged in the atmosphere of a community daily."@en ;
    skos:prefLabel "emission register"@en .

<http://www.eionet.europa.eu/gemet/concept/2673> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:prefLabel "emission situation"@en .

<http://www.eionet.europa.eu/gemet/concept/2674> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:definition "A chemical process, building, furnace, plant or other entity responsible for the discharge of pollutants or contaminants into the environment."@en ;
    skos:prefLabel "emission source"@en .

<http://www.eionet.europa.eu/gemet/concept/2677> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "The maximum amount of discharge legally allowed from a single source, mobile or stationary."@en ;
    skos:prefLabel "emission standard"@en .

<http://www.eionet.europa.eu/gemet/concept/2679> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "The discharge of solid, liquid or gaseous pollutants or contaminants into a body of water."@en ;
    skos:prefLabel "emission to water"@en .

<http://www.eionet.europa.eu/gemet/concept/2684> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "Issues or initiatives pertaining to the inter-relationship between ecological concerns and the economics of employment, including sustained, environmentally safe development; the effect of environmental activism on jobs; and the creation of environmental occupations."@en ;
    skos:prefLabel "employment and environment"@en .

<http://www.eionet.europa.eu/gemet/concept/2687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "The result or impact of a specific policy, action or event upon the number of working-age persons holding jobs in a specific region, nation or sector of the economy."@en ;
    skos:prefLabel "employment level effect"@en .

<http://www.eionet.europa.eu/gemet/concept/2689> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process of dispersing one liquid in a second immiscible liquid."@en ;
    skos:prefLabel "emulsification"@en .

<http://www.eionet.europa.eu/gemet/concept/2691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4844> ;
    skos:definition "A stable dispersion of one liquid in a second immiscible liquid, such as milk (oil dispersed in water)."@en ;
    skos:prefLabel "emulsion"@en .

<http://www.eionet.europa.eu/gemet/concept/2693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The enclosure of any polluting product with a material that prevents its release in the environment."@en ;
    skos:prefLabel "encapsulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2696> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A comprehensive, often multivolume, reference work containing articles on a wide rage of subjects or on various aspects of a particular field, usually, alphabetically arranged."@en ;
    skos:prefLabel "encyclopaedia"@en .

<http://www.eionet.europa.eu/gemet/concept/2697> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2702> ;
    skos:definition "Animals, birds, fish or other living organisms threatened with extinction by natural or human-induced changes in their environment."@en ;
    skos:prefLabel "endangered animal species"@en .

<http://www.eionet.europa.eu/gemet/concept/2700> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2702> ;
    skos:definition "The plants threatened with extinction by human or natural changes in the environment."@en ;
    skos:prefLabel "endangered plant species"@en .

<http://www.eionet.europa.eu/gemet/concept/2704> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9166> ;
    skos:definition "Threat to the quality and quantity of groundwater by activities related to the use of land. As some activities (e.g. landfill) present a particular risk of pollution, the closer an activity is to a well or borehole, the greater the risk of the pumped water being polluted. The type of soil, the geology, the rainfall and the amount of water pumped out of the ground must all be taken into consideration."@en ;
    skos:prefLabel "groundwater endangering"@en .

<http://www.eionet.europa.eu/gemet/concept/2705> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The chemical coordinating system in animals, that is, the endocrine glands that produce hormones."@en ;
    skos:prefLabel "endocrine system"@en .

<http://www.eionet.europa.eu/gemet/concept/2706> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The study of the endocrine glands and the hormones that they synthesize and secrete."@en ;
    skos:prefLabel "endocrinology"@en .

<http://www.eionet.europa.eu/gemet/concept/2707> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "An approach to pollution control which concentrates upon effluent treatment or filtration prior to discharge into the environment, as opposed to making changes in the process giving rise to the wastes."@en ;
    skos:prefLabel "end-of-pipe technology"@en .

<http://www.eionet.europa.eu/gemet/concept/2713> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The energetic state of a system at any given time."@en ;
    skos:prefLabel "energy balance"@en .

<http://www.eionet.europa.eu/gemet/concept/2714> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2733> ;
    skos:definition "The strategy for reducing energy requirements per unit of industrial output or individual well-being without affecting the progress of socio-economic development or causing disruption in life style. In temperate developed countries most energy is used in heating and lighting industrial and domestic buildings. Industrial processes, transport and agriculture are the other main users. During the 1970s it was demonstrated that substantial savings could be achieved through appropriate building technologies and the use of energy-efficient equipment for heating, air-conditioning and lighting. Most goods could and should be both manufactured and made to work more efficiently."@en ;
    skos:prefLabel "energy conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/2716> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2734> ;
    skos:definition "The process of changing energy from one form to another."@en ;
    skos:prefLabel "energy conversion"@en .

<http://www.eionet.europa.eu/gemet/concept/2718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745>,
        <http://www.eionet.europa.eu/gemet/concept/2730> ;
    skos:prefLabel "energy demand"@en .

<http://www.eionet.europa.eu/gemet/concept/272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/631> ;
    skos:definition "The measurement of ambient air-pollution concentrations in order to determine whether there is a problem in a given region."@en ;
    skos:prefLabel "air quality control"@en .

<http://www.eionet.europa.eu/gemet/concept/2720> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Any loss of energy, generally by conversion into heat."@en ;
    skos:prefLabel "energy dissipation"@en .

<http://www.eionet.europa.eu/gemet/concept/2723> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The production, distribution, and consumption of usable power such as fossil fuel, electricity, or solar radiation."@en ;
    skos:prefLabel "energy economics"@en .

<http://www.eionet.europa.eu/gemet/concept/2724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Refers to actions to save fuels by better building design, the modification of production processes, better selection of road vehicles and transport policies, the adoption of district heating schemes in conjunction with electrical power generation, and the use of domestic insulation and double glazing in homes."@en ;
    skos:prefLabel "energy efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/2731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5058> ;
    skos:definition "The trade or traffic of energy sources treated as a commodity (such as fossil fuel, electricity, or solar radiation)."@en ;
    skos:prefLabel "energy market"@en .

<http://www.eionet.europa.eu/gemet/concept/2736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "A form of resource recovery in which the organic fraction of waste is converted to some form of usable energy. Recovery may be achieved through the combustion of processed or raw refuse to produce steam through the pyrolysis of refuse to produce oil or gas; and through the anaerobic digestion of organic wastes to produce methane gas."@en ;
    skos:prefLabel "energy recovery"@en .

<http://www.eionet.europa.eu/gemet/concept/2738> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7168> ;
    skos:definition "Potential supplies of energy which have not yet been used (such as coal lying in the ground, solar heat, wind power, geothermal power, etc.)."@en ;
    skos:prefLabel "energy resource"@en .

<http://www.eionet.europa.eu/gemet/concept/274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Regulate and plan and work toward the accomplishment of completion of stated goals, objectives and mission pertaining to air quality."@en ;
    skos:prefLabel "air quality management"@en .

<http://www.eionet.europa.eu/gemet/concept/2740> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2730> ;
    skos:definition "Avoiding wasting energy."@en ;
    skos:prefLabel "energy saving"@en .

<http://www.eionet.europa.eu/gemet/concept/2742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2741> ;
    skos:definition "Sources from which energy can be obtained to provide heat, light, and power. Energy resources, including fossil and nuclear fuels as well as solar, water, tidal and geothermal energy, may be captured or recovered and converted into other energy forms for a variety of household, commercial, transportation, and industrial applications."@en ;
    skos:prefLabel "energy source material"@en .

<http://www.eionet.europa.eu/gemet/concept/2751> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:prefLabel "energy utilisation pattern"@en .

<http://www.eionet.europa.eu/gemet/concept/2755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4436> ;
    skos:prefLabel "enlargement policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2756> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2897> ;
    skos:prefLabel "enlargement programme"@en .

<http://www.eionet.europa.eu/gemet/concept/2758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5724> ;
    skos:definition "Uranium whose concentration of uranium-235, which is able to sustain a nuclear chain reaction, is increased by removing uranium-238."@en ;
    skos:prefLabel "enriched uranium"@en .

<http://www.eionet.europa.eu/gemet/concept/2759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The process of increasing the abundance of a specified isotope in a mixture of isotopes. It is usually applied to an increase in the proportion of U-235, or the addition of Pu-239 to natural uranium for use in a nuclear reactor or weapon."@en ;
    skos:prefLabel "enrichment"@en .

<http://www.eionet.europa.eu/gemet/concept/2760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/495> ;
    skos:definition "A quantity of nutriments that meets fundamental nutritional requirements and is provided to a person, group or community on a continuing basis."@en ;
    skos:prefLabel "adequate food supply"@en .

<http://www.eionet.europa.eu/gemet/concept/2769> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/130> ;
    skos:definition "Consultations or recommendations given as a guide of action regarding the preservation of ecological integrity and the defense or shelter of natural  resources."@en ;
    skos:prefLabel "environmental protection advice"@en .

<http://www.eionet.europa.eu/gemet/concept/277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Any measure, technique or design intended to reduce the risk of harm posed by either moving vehicles or projectiles above the earth's surface or pollutants to the earth's atmosphere."@en ;
    skos:prefLabel "air safety"@en .

<http://www.eionet.europa.eu/gemet/concept/2771> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6775> ;
    skos:prefLabel "environmental anxiety"@en .

<http://www.eionet.europa.eu/gemet/concept/2772> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/538> ;
    skos:definition "Environmentally friendly architecture is based on the following five principles: 1) healthful interior environment; 2) energy efficiency; 3) ecologically benign materials; 4) environmental form; 5) good design."@en ;
    skos:prefLabel "environmental sustainable architecture"@en .

<http://www.eionet.europa.eu/gemet/concept/2773> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Human settlements have an adverse impact on many ecosystems and on themselves by the addition of toxic or harmful substances to the outer lithosphere, hydrosphere, and atmosphere. The major types of environmental pollutants are sewage, trace metals, petroleum hydrocarbons, synthetic organic compounds, and gaseous emissions. Most, if not all, of the additions of potentially harmful substances to the environment are result of the population growth and the technological advances of industrial societies."@en ;
    skos:prefLabel "environmental aspect of human settlements"@en .

<http://www.eionet.europa.eu/gemet/concept/2779> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Final part of the environmental impact study and assessment which compares environmental costs and benefits on the basis of homogeneous criteria."@en ;
    skos:prefLabel "environmental balance"@en .

<http://www.eionet.europa.eu/gemet/concept/2783> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:prefLabel "environmental chemicals legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "Science dealing with the physical, chemical and biochemical processes that polluting substances undergo when introduced in the environment."@en ;
    skos:prefLabel "environmental chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/2786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Condition of products or projects of having a reduced impact or burden on the natural environment."@en ;
    skos:prefLabel "environmental compatibility"@en .

<http://www.eionet.europa.eu/gemet/concept/2789> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "Resultant of natural or man-made perturbations of the physical, chemical or biological components making up the environment."@en ;
    skos:prefLabel "environmental consequence"@en .

<http://www.eionet.europa.eu/gemet/concept/279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8648> ;
    skos:definition "The activity of organizing or preparing for transportation through the atmosphere above earth's surface."@en ;
    skos:prefLabel "airspace planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2218> ;
    skos:definition "The production of an organized, programmatic and coordinated course of action to be followed in the case of some accident, disaster or occurrence threatening an ecosystem and the human health or natural resources within it."@en ;
    skos:prefLabel "environmental contingency planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2797> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:definition "Unlawful acts against the environment, such as water contamination, hazardous waste disposal, air contamination, unpermitted installation of plants, oil spills, etc."@en ;
    skos:prefLabel "environmental crime"@en .

<http://www.eionet.europa.eu/gemet/concept/2798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1862> ;
    skos:definition "The aggregate of statutory enactments pertaining to actions or instances of ecological negligence deemed injurious to public welfare or government interests and legally prohibited."@en ;
    skos:prefLabel "environmental criminal law"@en .

<http://www.eionet.europa.eu/gemet/concept/28> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7097> ;
    skos:definition "Genetically engineered organisms that are released in the environment by mistake; once released they may exhibit some previously unknown pathogenicity, might take over from some naturally occurring bacteria (possibly having other positive functions which thus are lost) or pass on some unwanted trait to such indigenous bacteria. There is also concern that an uncontrolled genetic mutation could produce a form with hazardous consequences for the environment."@en ;
    skos:prefLabel "accidental release of organisms"@en .

<http://www.eionet.europa.eu/gemet/concept/2801> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1921>,
        <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "The total of learned behavior, attitudes, practices and knowledge that a society has with respect to maintaining or protecting its natural resources, the ecosystem and all other external conditions affecting human life."@en ;
    skos:prefLabel "environmental culture"@en .

<http://www.eionet.europa.eu/gemet/concept/281> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1474> ;
    skos:definition "The temperature of the atmosphere which represents the average kinetic energy of the molecular motion in a small region and is defined in terms of a standard or calibrated thermometer in thermal equilibrium with the air."@en ;
    skos:prefLabel "air temperature"@en .

<http://www.eionet.europa.eu/gemet/concept/2811> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2501> ;
    skos:definition "A recognized field of specialization in the discipline of Economics that embraces the issues of pollution control and environment protection, in which costs and benefits are difficult or impossible to estimate, much of the subject matter falling outside the competitive market system. Yet, it is an area in which immense common property resources need to be allocated sensibly to the overall public good. The subject is also very much concerned with ways and means to achieve this sensible allocation such as emission and effluent charges, user charges for the treatment or disposal of waste, environmental taxes, product charges, deposit refunds, tradeable pollution rights, performance bonds, natural resource accounting, and the economic implications of sustainable development."@en ;
    skos:prefLabel "environmental economics"@en .

<http://www.eionet.europa.eu/gemet/concept/2814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "The educational process that deals with the human interrelationships with the environment and that utilizes an interdisciplinary problem-solving approach with value clarification. Concerned with education progress of knowledge, understanding, attitudes, skills, and commitment for environmental problems and considerations. The need for environmental education is continuous, because each new generation needs to learn conservation for itself."@en ;
    skos:prefLabel "environmental education"@en .

<http://www.eionet.europa.eu/gemet/concept/2817> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2849> ;
    skos:definition "Organisations that are specialized in providing advice on environmental matters, for example investigation and remediation of potentially polluted land, water and air, and in the evaluation of environmental impacts; they employ professionals with the qualifications of engineering, geology, chemistry, hydrogeology, landscaping, environmental economics, etc."@en ;
    skos:prefLabel "environmental enterprise"@en .

<http://www.eionet.europa.eu/gemet/concept/2821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "Financial resources set aside for measures involving ecological maintenance or the protection, defense, or shelter of natural resources."@en ;
    skos:prefLabel "environmental fund"@en .

<http://www.eionet.europa.eu/gemet/concept/2823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:definition "A physical or chemical agent capable of causing harm to the ecosystem or natural resources."@en ;
    skos:prefLabel "environmental hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/2825> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3872> ;
    skos:definition "Any physical, chemical or other agent capable of causing harm to the interrelationship between humans and the surrounding external conditions, threatening both human well-being and ecological integrity."@en ;
    skos:prefLabel "environmental health hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/2826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4159> ;
    skos:definition "Assessment of impacts caused by an action on the health conditions of a population."@en ;
    skos:prefLabel "environmental health impact assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/2827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3877> ;
    skos:definition "Measures or devices designed to reduce the risk of harm to human health posed by pollutants or other threatening conditions in the ecosystem."@en ;
    skos:prefLabel "environmental health protection"@en .

<http://www.eionet.europa.eu/gemet/concept/2828> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2851> ;
    skos:definition "A systematic and chronological account of past events and conditions relating to the ecosystem, its natural resources or, more generally, the external factors surrounding and affecting human life."@en ;
    skos:prefLabel "environmental history"@en .

<http://www.eionet.europa.eu/gemet/concept/2831> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Agricultural activities have significant impacts on water quality, including increases in stream sedimentation from erosion, and increases in nutrients, pesticides, and salt concentrations in runoff. In certain regions, the misuse of pesticides has led to the development of pesticide-resistant strains of pests, destroyed natural predators, killed local wildlife, and contaminated human water supplies. Improper application of fertilizers has changed the types of vegetation and fish types inhabiting nearby waterways and rivers."@en ;
    skos:prefLabel "environmental impact of agriculture"@en .

<http://www.eionet.europa.eu/gemet/concept/2832> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Fish farming pollutes the water with nutrients, methane and hydrogen sulphide which threaten both farmed fish and other marine life. Dangerous pesticides have been used to treat infestations of sea lice."@en ;
    skos:prefLabel "environmental impact of aquaculture"@en .

<http://www.eionet.europa.eu/gemet/concept/2833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Energy and environmental problems are closely related, since it is nearly impossible to produce, transport, or consume energy without significant environmental impact. The environmental problems directly related to energy production and consumption include air pollution, water pollution, thermal pollution, and solid waste disposal. The emission of air pollutants from fossil fuel combustion is the major cause of urban air pollution. Diverse water pollution problems are associated with energy usage. One major problem is oil spills. In all petroleum-handling operations, there is a finite probability of spilling oil either on the earth or in a body of water. Coal mining can also pollute water. Changes in groundwater flow produced by mining operations often bring otherwise unpolluted waters into contact with certain mineral materials which are leached from the soil and produce an acid mine drainage. Solid waste is also a by-product of some forms of energy usage. Coal mining requires the removal of large quantities of earth as well as coal. In general, environmental problems increase with energy use and this combined with the limited energy resource base is the crux of the energy crisis. An energy impact assessment should compare these costs with the benefits to be derived from energy use."@en ;
    skos:prefLabel "environmental impact of energy"@en .

<http://www.eionet.europa.eu/gemet/concept/2834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Fishing may have various negative effects on the environment: effluent and waste from fish farms may damage wild fish, seals, and shellfish. Fish farmers use tiny quantities of highly toxic chemicals to kill lice: one overdose could be devastating. So-called by-catches, or the incidental taking of non-commercial species in drift nets, trawling operations and long line fishing is responsible for the death of large marine animals and one factor in the threatened extinction of some species. Some fishing techniques, like the drift nets, yield not only tons of fish but kill millions of birds, whales and seals and catch millions of fish not intended. Small net holes often capture juvenile fish who never have a chance to reproduce. Some forms of equipment destroy natural habitats, for example bottom trawling may destroy natural reefs. Other destructive techniques are illegal dynamite and cyanide fishing."@en ;
    skos:prefLabel "environmental impact of fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/2835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "The world's forestry resources are shrinking at an alarming rate. The need for foreign exchange encourages many developing countries to cut timber faster than forests can be regenerated. This overcutting not only depletes the resource that underpins the world timber trade, it causes loss of forest-based livelihoods, increases soil erosion and downstream flooding, and accelerates the loss of species and genetic resources."@en ;
    skos:prefLabel "environmental impact of forestry"@en .

<http://www.eionet.europa.eu/gemet/concept/2836> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Household impacts on the environment include domestic heating emissions (hot air, carbon dioxide, carbon monoxide, water vapour and oxide of nitrogen, sulphur and other trace gases); domestic sewage consisting of human bodily discharges, water from kitchens, bathrooms and laundries; the dumping of bulky wastes such as old washing machines, refrigerators, cars and other objects that will not fit into the standard dustbin and which are often dumped about the countryside, etc."@en ;
    skos:prefLabel "environmental impact of households"@en .

<http://www.eionet.europa.eu/gemet/concept/2837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "The effects on the environment connected with industrial activities are mainly related to the production of industrial wastes that can be divided into various types: solid waste, such as dust particles or slag from coal; liquid wastes from various processes, including radioactive coolants from power stations; and gas wastes, largely produced by the chemical industry."@en ;
    skos:prefLabel "environmental impact of industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2838> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Recreation and tourism are often accompanied by extensive damage to the environment. Aquatic ecosystems are particularly vulnerable to the effects of an increased tourist trade and the resultant building of hotel accommodations, sewage disposal works, roads, car parks and landing jetties on banks and coastlines; and the increased angling, swimming, water skiing, shooting or use of motor-boats in the water body. These all produce direct deleterious effects when conducted on a massive scale, including shore damage, chemical changes in the water, and sediments and biological changes in the plant and animal communities."@en ;
    skos:prefLabel "environmental impact of recreation"@en .

<http://www.eionet.europa.eu/gemet/concept/2839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Extensive damage to the environment caused by recreation and tourism, including despoiling of coastlines by construction of tourist facilities; pollution of the sea; loss of historic buildings to make way for tourist facilities; loss of agricultural land for airport development, etc."@en ;
    skos:prefLabel "environmental impact of tourism"@en .

<http://www.eionet.europa.eu/gemet/concept/2840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Impact of transportation-related activities on the environment, in particular, those impacts dealing with air pollution, noise, displacement of people and businesses, disruption of wildlife habitats, and overall growth-inducing effects."@en ;
    skos:prefLabel "environmental impact of transport"@en .

<http://www.eionet.europa.eu/gemet/concept/2841> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4159> ;
    skos:definition "A detailed statement which, to the fullest extent possible, identifies and analyses, among other things, the anticipated environmental impact of a proposed action and discusses how the adverse effects will be mitigated."@en ;
    skos:prefLabel "environmental impact statement"@en .

<http://www.eionet.europa.eu/gemet/concept/2848> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11124> ;
    skos:definition "An index of available environmental articles from 1972 to present; also known as Environmental Abstract Annual."@en ;
    skos:prefLabel "environmental index"@en .

<http://www.eionet.europa.eu/gemet/concept/285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/685> ;
    skos:definition "International rules and conventions relating to air transportation."@en ;
    skos:prefLabel "air traffic law"@en .

<http://www.eionet.europa.eu/gemet/concept/2850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "Science and techniques of data elaboration and of computer processing of information concerning ecosystems and ecology."@en ;
    skos:prefLabel "environmental informatics"@en .

<http://www.eionet.europa.eu/gemet/concept/2853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "A coordinated assemblage of people, devices or other resources designed to exchange data or knowledge concerning any aspect of the ecosystem, the natural resources within or, more generally, the external factors surrounding and affecting human life."@en ;
    skos:prefLabel "environmental information system"@en .

<http://www.eionet.europa.eu/gemet/concept/2857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:definition """1) Concern for the environment and its protection. 
2) Theory emphasizing the primary influence of the environment on the development of groups or individuals. It stresses the importance of the physical, biological, psychological, or cultural environment as a factor influencing the structure or behaviour of animals, including humans. In politics, this has given rise in many countries to Green Parties, which aim to " Preserve the planet and its people"."""@en ;
    skos:prefLabel "environmentalism"@en .

<http://www.eionet.europa.eu/gemet/concept/2859> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "A wide spectrum of options from binding \"hard\" laws, such as international treaties and national legislation, to \"soft\" laws, covering guiding principles, recommended practices and procedures, and standards. Environmental law also attempts to reconcile international considerations with concerns that focus on very specific problems such as soil degradation, marine pollution or the depletion of non-renewable resources."@en ;
    skos:prefLabel "environmental law"@en .

<http://www.eionet.europa.eu/gemet/concept/286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13272> ;
    skos:prefLabel "air traffic regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4710> ;
    skos:definition "Any variety of activities associated with promoting compliance and obedience to those binding rules of a state that have been promulgated to safeguard ecological integrity, preserve natural resources and protect human health."@en ;
    skos:prefLabel "environmental law enforcement"@en .

<http://www.eionet.europa.eu/gemet/concept/2863> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate any aspect of farm and livestock production that poses a threat to ecological integrity and human health, especially the use of pesticides, fertilizers and land."@en ;
    skos:prefLabel "environmental legislation on agriculture"@en .

<http://www.eionet.europa.eu/gemet/concept/2864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14208> ;
    skos:definition "The systematic course of proceedings in which a bill that would preserve or protect ecological resources may be enacted as a law."@en ;
    skos:prefLabel "environmental legislative process"@en .

<http://www.eionet.europa.eu/gemet/concept/2865> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition "The penalty to be paid by an organization for the damage caused by pollution and restoration necessary as a result of that damage, whether by accidental spillages from tankers, industrial waste discharges into waterways or land, or deliberate or accidental release of radioactive materials."@en ;
    skos:prefLabel "environmental liability"@en .

<http://www.eionet.europa.eu/gemet/concept/2866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "A governmental license or grant that allows and regulates an enterprise's discharge of air pollutants, typically from a commercial or industrial plant."@en ;
    skos:prefLabel "environmental licence"@en .

<http://www.eionet.europa.eu/gemet/concept/2869> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3854> ;
    skos:definition "Substance that causes undesirable change in the physical, chemical, or biological characteristics of the air, water, or land that can harmfully affect the health, survival, or activities of human or other living organisms."@en ;
    skos:prefLabel "environmentally dangerous substance"@en .

<http://www.eionet.europa.eu/gemet/concept/2870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The process of obtaining products and services which are favorably disposed toward the environment."@en ;
    skos:prefLabel "environmental friendly procurement"@en .

<http://www.eionet.europa.eu/gemet/concept/2871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Product that is not harmful to the environment."@en ;
    skos:prefLabel "environmentally friendly product"@en .

<http://www.eionet.europa.eu/gemet/concept/2872> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Adoption of integrated and preventative management practices aiming at reducing the impacts of industrial and trade activities on the environment; these practices include, among others, life-cycle analysis in the product development cycle, the introduction of clean process technology and measures of waste minimisation."@en ;
    skos:prefLabel "environmentally friendly management"@en .

<http://www.eionet.europa.eu/gemet/concept/2873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "environmentally related disease"@en .

<http://www.eionet.europa.eu/gemet/concept/2874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:prefLabel "environmentally responsible behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/2876> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "Firms that do not comply with environmental regulations for the disposal of noxious wastes generated during the production cycle."@en ;
    skos:prefLabel "environmentally unfriendly firm"@en .

<http://www.eionet.europa.eu/gemet/concept/2880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:definition "The art and science of the protection of good health, the promotion of aesthetic values, the prevention of disease and injury through the control of positive environmental factors, and the reduction of potential physical, biological, chemical, and radiological hazards."@en ;
    skos:prefLabel "environmental medicine"@en .

<http://www.eionet.europa.eu/gemet/concept/2881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:prefLabel "environmental misconduct"@en .

<http://www.eionet.europa.eu/gemet/concept/2882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "Periodic and/or continued measuring, evaluating, and determining environmental parameters and/or pollution levels in order to prevent negative and damaging effects to the environment. Also include the forecasting of possible changes in ecosystem and/or the biosphere as a whole."@en ;
    skos:prefLabel "environmental monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/2886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778> ;
    skos:definition "An intuitive recognition or understanding of the ecosystem and its natural resources, often based on human experiences or cultural attitudes or beliefs."@en ;
    skos:prefLabel "environmental perception"@en .

<http://www.eionet.europa.eu/gemet/concept/2887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2776> ;
    skos:prefLabel "environmental performance"@en .

<http://www.eionet.europa.eu/gemet/concept/289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "The use of aircraft, predominantly airplanes, to move passengers and cargo."@en ;
    skos:prefLabel "air transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/2890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for the protection of natural or ecological resources."@en ;
    skos:prefLabel "environmental plan"@en .

<http://www.eionet.europa.eu/gemet/concept/2896> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:prefLabel "environmental priority"@en .

<http://www.eionet.europa.eu/gemet/concept/2901> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10012> ;
    skos:definition "EPA is the US Government's watchdog agency responsible for controlling the pollution of air and water, pesticides, radiation hazards and noise pollution. The agency is also involved in research to examine the effects of pollution."@en ;
    skos:prefLabel "environmental protection agency"@en .

<http://www.eionet.europa.eu/gemet/concept/2902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/607> ;
    skos:definition "Associations whose object resides in the protection of natural environment."@en ;
    skos:prefLabel "environmental protection association"@en .

<http://www.eionet.europa.eu/gemet/concept/2903> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2796> ;
    skos:definition "The amount of money incurred in the preservation, defense, or shelter of natural resources."@en ;
    skos:prefLabel "environmental protection cost"@en .

<http://www.eionet.europa.eu/gemet/concept/2905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Precautionary actions, procedures or installations undertaken by non-governmental, business or industrial entities to prevent or reduce harm to the ecosystem and human health."@en ;
    skos:prefLabel "environmental protection in the enterprise"@en .

<http://www.eionet.europa.eu/gemet/concept/2907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11494> ;
    skos:prefLabel "environmental protection order"@en .

<http://www.eionet.europa.eu/gemet/concept/2908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10012> ;
    skos:definition "A government agency, committee or group that is responsible for preserving and safeguarding ecological or natural resources."@en ;
    skos:prefLabel "environmental protection organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/2909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A government or management prescribed rule for the preservation of natural resources and the prevention of damage or degradation of the ecosystem."@en ;
    skos:prefLabel "environmental protection regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Technologies that meet environmental objectives by incorporating pollution prevention concepts in their design. Environmental control strategies introduced in the early design stages of a process, rather than an end-of-pipe control option introduced in the later stages, improve the technical and economic performance of a process."@en ;
    skos:prefLabel "environmental protection technology"@en .

<http://www.eionet.europa.eu/gemet/concept/2911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6776> ;
    skos:definition "A branch of experimental psychology which studies the relationships between behavior and the environmental context in which it occurs. Environmental psychology's primary focus is the influence of the physical environment and, therefore, much of the research in this area deals with the influences of noise, air pollution, climatic changes, etc."@en ;
    skos:prefLabel "environmental psychology"@en .

<http://www.eionet.europa.eu/gemet/concept/2913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Criteria followed in establishing standards for exposure to pollutants and noise, in respect of pesticides, detergents, composition of effluents, discharge of trade wastes, etc."@en ;
    skos:prefLabel "environmental quality criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/2915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11429> ;
    skos:definition "Normative documents and guidelines for determining the degree of environmental conditions and requirements to avoid negative and damaging effects, influences, and consequences."@en ;
    skos:prefLabel "environmental quality standard"@en .

<http://www.eionet.europa.eu/gemet/concept/2920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774>,
        <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "Qualitative and quantitative evaluation of the risk posed to the environment by the actual or potential presence and/or use of specific pollutants."@en ;
    skos:prefLabel "environmental risk assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/2922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The interdisciplinary study of environmental problems, within the framework of established physical and biological principles, i.e. oriented toward a scientific approach."@en ;
    skos:prefLabel "environmental science"@en .

<http://www.eionet.europa.eu/gemet/concept/2923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures taken or policies instituted to protect and promote the safety of external conditions affecting the life, development and survival of an organism."@en ;
    skos:prefLabel "environmental security"@en .

<http://www.eionet.europa.eu/gemet/concept/2924> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:definition "Places in which selected specimens (fish, mussels, milk, soil sample and human tissue, etc.) are stored without being allowed to decompose."@en ;
    skos:prefLabel "environmental specimen bank"@en .

<http://www.eionet.europa.eu/gemet/concept/2925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2776> ;
    skos:definition "Assessment made by a company or organization of the financial benefits and disadvantages to be derived from adopting a more environmentally sound policy."@en ;
    skos:prefLabel "environmental statement (eco-audit)"@en .

<http://www.eionet.europa.eu/gemet/concept/2927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The buying, selling, or exchanging of ecological commodities."@en ;
    skos:prefLabel "environmental stock exchange"@en .

<http://www.eionet.europa.eu/gemet/concept/2928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2845> ;
    skos:definition "Payment by a government to assist or improve performance regarding ecological maintenance or the protection, defense, or shelter of natural resources."@en ;
    skos:prefLabel "environmental subsidy"@en .

<http://www.eionet.europa.eu/gemet/concept/293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9035> ;
    skos:definition "Signalling an impending danger in order to call attention to some event or condition."@en ;
    skos:prefLabel "alarm"@en .

<http://www.eionet.europa.eu/gemet/concept/2931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8319> ;
    skos:definition "Instruction, training or the imparting of knowledge about the external conditions affecting the life, development and survival of organisms, including potential dangers to the ecosystem and the means to maintain its integrity."@en ;
    skos:prefLabel "environmental teaching"@en .

<http://www.eionet.europa.eu/gemet/concept/2934> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8380> ;
    skos:definition "The vocabulary of technical terms and usage appropriate to community, corporate, governmental and other groups concerned with protecting natural resources, preserving the integrity of the ecosystem and safeguarding human health."@en ;
    skos:prefLabel "environmental terminology"@en .

<http://www.eionet.europa.eu/gemet/concept/2936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8607> ;
    skos:definition "Teaching of specialists and qualified workers who acquire knowledge and skills necessary to solve environmental problems."@en ;
    skos:prefLabel "environmental training"@en .

<http://www.eionet.europa.eu/gemet/concept/2938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "The assessment, evaluation, or appraisal of business performance in matters involving ecology and finances."@en ;
    skos:prefLabel "environmental economic valuation"@en .

<http://www.eionet.europa.eu/gemet/concept/2940> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8894> ;
    skos:prefLabel "environmental vandalism"@en .

<http://www.eionet.europa.eu/gemet/concept/2941> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9028> ;
    skos:definition "The direct manipulation or destruction of ecological resources as either a political threat or for actual military advantage."@en ;
    skos:prefLabel "environmental warfare"@en .

<http://www.eionet.europa.eu/gemet/concept/2943> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5241> ;
    skos:definition "Human activities, enterprises or products that reinforce rather than undermine the integrity of the ecosystem."@en ;
    skos:prefLabel "environment friendly"@en .

<http://www.eionet.europa.eu/gemet/concept/2945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "Any of a group of catalytic proteins that are produced by living cells and that mediate and promote the chemical processes of life without themselves being altered or destroyed."@en ;
    skos:prefLabel "enzyme"@en .

<http://www.eionet.europa.eu/gemet/concept/2949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition """1) The study of the mass aspects of disease.
2) The study of the occurrence and distribution of disease and injury specified by person, place, and time."""@en ;
    skos:prefLabel "epidemiology"@en .

<http://www.eionet.europa.eu/gemet/concept/2958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2308> ;
    skos:definition "A quantity used in radiation protection, expressing all radiation on a common scale for calculating the effective absorbed dose. The unit of dose equivalent is the rem. which is numerically equal to the absorbed dose in rads multiplied by certain modifying factors such as the quality factor, the distribution factor, etc."@en ;
    skos:prefLabel "equivalent dose"@en .

<http://www.eionet.europa.eu/gemet/concept/2960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496> ;
    skos:definition "The study of human capability and psychology in relation to the working environment and the equipment operated by the worker."@en ;
    skos:prefLabel "ergonomics"@en .

<http://www.eionet.europa.eu/gemet/concept/2964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2795> ;
    skos:definition "Practices used during construction or other land disturbing activities to reduce or prevent soil erosion. Typical practices include planting of trees and quick growing grass on disturbed areas and other means to slow the movement of water across a disturbed site and trap the soil that does get transported by runoff."@en ;
    skos:prefLabel "erosion control"@en .

<http://www.eionet.europa.eu/gemet/concept/2969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The scientific study or the characteristic life processes of living organisms found in a semi-enclosed coastal body of water which has a free connection with the open sea and within which sea water is measurably diluted with freshwater."@en ;
    skos:prefLabel "estuarine biology"@en .

<http://www.eionet.europa.eu/gemet/concept/2970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Estuarine area which has been reserved by legislation to protect part or all of the enclosed environment for conservation, scientific, educational and/or recreational purposes."@en ;
    skos:prefLabel "estuarine conservation area"@en .

<http://www.eionet.europa.eu/gemet/concept/2972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:prefLabel "estuarine ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/2973> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5797> ;
    skos:definition "The study of the physical, chemical, biological and geological characteristics of a semi-enclosed coastal body of water which has a free connection with the open sea and within which sea water is measurably diluted with fresh water."@en ;
    skos:prefLabel "estuarine oceanography"@en .

<http://www.eionet.europa.eu/gemet/concept/2974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7244> ;
    skos:definition "Area at the mouth of a river where it broadens into the sea, and where fresh and sea water intermingle to produce brackish water. The estuarine environment is very rich in wildlife, particularly aquatic, but it is very vulnerable to damage as a result of the actions of humans."@en ;
    skos:prefLabel "estuary"@en .

<http://www.eionet.europa.eu/gemet/concept/2977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1336> ;
    skos:definition "The incision of lines on a plate of metal, glass, or other material by covering it with an acid-resistant coating, scratching through the coating, and then permitting an acid bath to erode exposed parts of the plate."@en ;
    skos:prefLabel "etching"@en .

<http://www.eionet.europa.eu/gemet/concept/2978> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Substance capable of wearing away the surface of a metal, glass, etc. by chemical action."@en ;
    skos:prefLabel "etching substance"@en .

<http://www.eionet.europa.eu/gemet/concept/2979> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5929> ;
    skos:definition "A colorless liquid, slightly soluble in water; used as a reagent, intermediate, anesthetic, and solvent."@en ;
    skos:prefLabel "ether"@en .

<http://www.eionet.europa.eu/gemet/concept/2982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The science that deals with the study of the origin, distribution, and relations of races or ethnic groups of mankind."@en ;
    skos:prefLabel "ethnology"@en .

<http://www.eionet.europa.eu/gemet/concept/2984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13318> ;
    skos:definition "The study of animal behaviour in a natural context."@en ;
    skos:prefLabel "ethology"@en .

<http://www.eionet.europa.eu/gemet/concept/2989> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The Council of the European Union is an institution which exercises legislative and decision-making powers. At the same time, it is the forum in which the representatives of the Governments of the 15 Member States can assert their interests and try to reach compromises. The Council ensures general coordination of the activities of the European Community, the main objective of which is the establishment of an internal market, i.e. an area without internal frontiers guaranteeing four freedoms of movement - for goods, persons, services and capital - to which should soon be added a single currency. In addition, the Council is responsible for intergovernmental cooperation, in common foreign and security policy (CFSP) and in the areas of justice and home affairs (JHA), including for example matters of immigration and asylum, combating terrorism and drugs and judicial cooperation."@en ;
    skos:prefLabel "EU Council"@en .

<http://www.eionet.europa.eu/gemet/concept/2991> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "A precursor to the European Community, the European Atomic Energy Community was founded in 1958 by the European Common Market to conduct research, develop nuclear energy, create a common market for nuclear fuels and supervise the nuclear industry so as to prevent abuse and protect health."@en ;
    skos:prefLabel "Euratom"@en .

<http://www.eionet.europa.eu/gemet/concept/2993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The European Union's administrative body, composed of twenty independent members appointed by the Member States for five-year terms and vested with powers of initiative, implementation, management and control according to the mandates established in EU Treaties or handed down by the EU Council."@en ;
    skos:prefLabel "European Commission"@en .

<http://www.eionet.europa.eu/gemet/concept/2996> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The supreme court of The European Union which oversees the application of the EU treaties, decides upon the validity and the meaning of Community legislation and determines whether any act or omission by the European Commission, the Council of Minister or any member state constitutes a breach of Community law."@en ;
    skos:prefLabel "European Court of Justice"@en .

<http://www.eionet.europa.eu/gemet/concept/2997> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "The EEA is being set up to provide the European Community and its member states with objective, reliable and standardized information on the environment. It will assess the success of existing environmental policies and the data will be used to develop new policies for environmental protection measures. It will gather information covering the present, and foreseeable, state of the environment. The priority area are: air quality and emissions; water quality, pollutants and resources; soil quality, flora and fauna, and biotopes; land use and natural resources; waste management; noise pollution; chemicals; and protection of coastal areas. The Agency will also take into account the socio-economics dimension, cover transboundary and international matters, and avoid the duplication of the activities of other bodies."@en ;
    skos:prefLabel "European Environment Agency"@en .

<http://www.eionet.europa.eu/gemet/concept/2998> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:prefLabel "European Environmental Council"@en .

<http://www.eionet.europa.eu/gemet/concept/3000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5545> ;
    skos:prefLabel "European nature reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/3002> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3006> ;
    skos:definition "Formerly the \"Assembly\" of EEC. Comprises some 520 \"representatives of the peoples\" of European Community states, directly elected, and based in Strasbourg. Exercises advisory and supervisory powers; debates and passes resolutions and may veto admission of new member states."@en ;
    skos:prefLabel "European Parliament"@en .

<http://www.eionet.europa.eu/gemet/concept/3014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:prefLabel "evaluation of technology"@en .

<http://www.eionet.europa.eu/gemet/concept/3019> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Conversion from a liquid or solid state to a vapour."@en ;
    skos:prefLabel "evaporation"@en .

<http://www.eionet.europa.eu/gemet/concept/3022> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10043> ;
    skos:definition "Discharge of water from the earth's surface to the atmosphere by evaporation from lakes, streams and soil surfaces and by transpiration from plants. Also known as fly-off."@en ;
    skos:prefLabel "evapotranspiration"@en .

<http://www.eionet.europa.eu/gemet/concept/3027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "Mathematics and other sciences based on calculation."@en ;
    skos:prefLabel "exact science"@en .

<http://www.eionet.europa.eu/gemet/concept/3028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3032> ;
    skos:definition "A pit, cavity, or other uncovered cutting produced by excavation."@en ;
    skos:prefLabel "excavated hole"@en .

<http://www.eionet.europa.eu/gemet/concept/3029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The removal of earth from its natural position."@en ;
    skos:prefLabel "excavation (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/3031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1059> ;
    skos:definition "Residue in form of a heap, consisting of earth or other material, produced by excavation."@en ;
    skos:prefLabel "excavation heap"@en .

<http://www.eionet.europa.eu/gemet/concept/3033> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1356> ;
    skos:prefLabel "excessive height of chimney stacks"@en .

<http://www.eionet.europa.eu/gemet/concept/3040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11494> ;
    skos:definition "An order or regulation issued by the president or some administrative authority under his direction for the purpose of interpreting, implementing or giving administrative effect to a provision of the constitution or of some law or treaty."@en ;
    skos:prefLabel "executive order"@en .

<http://www.eionet.europa.eu/gemet/concept/3044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition """1) A duct or pipe through which waste material is emitted.
2) A combination of components which provides for enclosed flow of exhaust gas from engine parts to the atmosphere."""@en ;
    skos:prefLabel "exhaust device"@en .

<http://www.eionet.europa.eu/gemet/concept/3047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Chemical products existing before 18-09-1981."@en ;
    skos:prefLabel "existing chemical"@en .

<http://www.eionet.europa.eu/gemet/concept/3048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Plants, animals or microorganisms which are introduced by humans into areas where they are not native. Exotics are often associated with negative ecological consequences for native species and the ecosystems."@en ;
    skos:prefLabel "exotic species"@en .

<http://www.eionet.europa.eu/gemet/concept/305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "Any substance or chemical applied to kill or control algal growth."@en ;
    skos:prefLabel "algicide"@en .

<http://www.eionet.europa.eu/gemet/concept/3054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13316> ;
    skos:definition "A computer configuration of hardware and software that simulates the judgment and behavior of a human or an organization with extensive knowledge in a particular field, often by giving answers, solutions or diagnoses."@en ;
    skos:prefLabel "expert system"@en .

<http://www.eionet.europa.eu/gemet/concept/3057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "The search for economic deposits of minerals, ore, gas, oil, or coal by geological surveys, geophysical prospecting, boreholes and trial pits, or surface or underground headings, drifts, or tunnels."@en ;
    skos:prefLabel "exploration"@en .

<http://www.eionet.europa.eu/gemet/concept/3058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2766> ;
    skos:definition "A violent, sudden release of energy resulting from powders or gases undergoing instantaneous ignition or from some other means of detonation, often accompanied by a force producing great amounts of heat, major structural damages, shock waves and flying shrapnel."@en ;
    skos:prefLabel "explosion"@en .

<http://www.eionet.europa.eu/gemet/concept/3061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A substance, such as trinitrotoluene, or a mixture, such as gunpowder, that is characterized by chemical stability but may be made to undergo rapid chemical change without an outside source of oxygen, whereupon it produces a large quantity of energy generally accompanied by the evolution of hot gases."@en ;
    skos:prefLabel "explosive"@en .

<http://www.eionet.europa.eu/gemet/concept/3064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Permission from a government to carry or send abroad and sell a product manufactured within its borders."@en ;
    skos:prefLabel "export licence"@en .

<http://www.eionet.europa.eu/gemet/concept/3065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9073> ;
    skos:definition "Transporting by-products of society that possesses at least one of four characteristics (ignitability, corrosivity, reactivity, or toxicity) to other countries or areas for the conduct of foreign trade."@en ;
    skos:prefLabel "export of hazardous wastes"@en .

<http://www.eionet.europa.eu/gemet/concept/3067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The time for which a material is illuminated or irradiated."@en ;
    skos:prefLabel "exposure"@en .

<http://www.eionet.europa.eu/gemet/concept/3071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5971> ;
    skos:definition "To deprive an owner of property, especially by taking it for public use."@en ;
    skos:prefLabel "expropriation"@en .

<http://www.eionet.europa.eu/gemet/concept/3073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "Farming system practiced in very large farms, characterized by low levels of inputs per unit area of land; in such situations the stocking rate, the number of livestock units per area , is low."@en ;
    skos:prefLabel "extensive cattle farming"@en .

<http://www.eionet.europa.eu/gemet/concept/3079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5476> ;
    skos:definition "Discrepancies between private costs and social costs or private advantages and social advantages; the basic concept of externality is interdependence without compensation."@en ;
    skos:prefLabel "externality"@en .

<http://www.eionet.europa.eu/gemet/concept/3084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Animal or plant species which have completely disappeared from the planet."@en ;
    skos:prefLabel "extinct species  (IUCN)"@en .

<http://www.eionet.europa.eu/gemet/concept/309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/308> ;
    skos:definition "A class of organic compounds containing only carbon and hydrogen atoms joined to form one or more rings and having the properties of both aliphatic and cyclic substances."@en ;
    skos:prefLabel "alicyclic hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/3097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8422> ;
    skos:definition "Any cloth made from yarn or fibres by weaving, knitting, felting, etc."@en ;
    skos:prefLabel "fabric"@en .

<http://www.eionet.europa.eu/gemet/concept/3099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5058> ;
    skos:definition "Significant elements or reasons for an outcome in the buying, selling, and trading of particular goods or services."@en ;
    skos:prefLabel "factor market"@en .

<http://www.eionet.europa.eu/gemet/concept/3103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "The technique of capital intensive animal-raising in an artificial environment, used for chicken, egg, turkey, beef, veal and pork production. Animals are restrained in a controlled indoor environment and their food is brought to them. The building take on the appearance of industrial units."@en ;
    skos:prefLabel "factory farming"@en .

<http://www.eionet.europa.eu/gemet/concept/3106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/698> ;
    skos:definition "Bacteria contained in human and animal faeces."@en ;
    skos:prefLabel "faecal bacterium"@en .

<http://www.eionet.europa.eu/gemet/concept/3113> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3115> ;
    skos:definition "Land area normally used for crop production but left unsown for one or more growing seasons."@en ;
    skos:prefLabel "fallow area"@en .

<http://www.eionet.europa.eu/gemet/concept/3117> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A group comprising parents, offsprings and others closely related or associated with them."@en ;
    skos:prefLabel "family"@en .

<http://www.eionet.europa.eu/gemet/concept/312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/311> ;
    skos:definition "Hydrocarbons having an open chain of carbon atoms, whether normal or forked, saturated or unsaturated."@en ;
    skos:prefLabel "aliphatic hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/3120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562>,
        <http://www.eionet.europa.eu/gemet/concept/6551> ;
    skos:definition "A severe shortage of food, as through crop failure or over population. It may be due to poor harvests following drought, floods, earthquake, war, social conflict, etc."@en ;
    skos:prefLabel "famine"@en .

<http://www.eionet.europa.eu/gemet/concept/3123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3130> ;
    skos:definition "The dwelling on a farm as distinguished from utility buildings as a barn, corncrib, milk house."@en ;
    skos:prefLabel "farm building"@en .

<http://www.eionet.europa.eu/gemet/concept/313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/319> ;
    skos:definition "Any geomorphic area, often a level lake-like plain, with soil containing a high percentage of mineral salts, located especially in arid regions."@en ;
    skos:prefLabel "alkali land"@en .

<http://www.eionet.europa.eu/gemet/concept/3133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:prefLabel "fast traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/3143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a central government agency or its administrators to carry out the terms of the law creating the agency as well as to administer and implement regulations, laws and government policies."@en ;
    skos:prefLabel "federal authority"@en .

<http://www.eionet.europa.eu/gemet/concept/3144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3455> ;
    skos:definition "A system in which a country or nation formed by a union or confederation of independent states is governed by a central authority or organization."@en ;
    skos:prefLabel "federal government"@en .

<http://www.eionet.europa.eu/gemet/concept/3147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "A binding rule or body of rules established by a government that has been constituted as a union of independent political units or states."@en ;
    skos:prefLabel "federal law"@en .

<http://www.eionet.europa.eu/gemet/concept/3151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "The act and effect of supplying animals with food."@en ;
    skos:prefLabel "feeding of animals"@en .

<http://www.eionet.europa.eu/gemet/concept/3154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "Waterlogged, spongy ground containing alkaline decaying vegetation, characterized by reeds, that may develop into peat. It sometimes occurs in the sinkholes of karst region."@en ;
    skos:prefLabel "fen"@en .

<http://www.eionet.europa.eu/gemet/concept/3159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/812> ;
    skos:definition "Any enzymatic transformation of organic substrates, especially carbohydrates, generally accompanied by the evolution of gas; a physiological counterpart of oxidation, permitting certain organisms to live and grow in the absence of air; used in various industrial processes for the manufacture of products, such as alcohols, acids, and cheese by the action of yeasts, molds, and bacteria; alcoholic fermentation is the best-known example. Also known as zymosis."@en ;
    skos:prefLabel "fermentation"@en .

<http://www.eionet.europa.eu/gemet/concept/3162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8559> ;
    skos:definition "Any of a large number of vascular plants composing the division Polypodiophyta, without flowers and fruits."@en ;
    skos:prefLabel "fern"@en .

<http://www.eionet.europa.eu/gemet/concept/3171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/206> ;
    skos:prefLabel "fertiliser law"@en .

<http://www.eionet.europa.eu/gemet/concept/3175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5267> ;
    skos:definition "A material made from small fibres of glass twisted together, which is used for keeping buildings warm, or a plastic strengthened by these fibres and used for making structures such as the outsides of cars and boats."@en ;
    skos:prefLabel "fibreglass"@en .

<http://www.eionet.europa.eu/gemet/concept/3176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "A limited area of land with grass or crops growing on it, which is usually surrounded by fences or closely planted bushes when it is part of a farm."@en ;
    skos:prefLabel "field"@en .

<http://www.eionet.europa.eu/gemet/concept/3177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "A decline in the productivity of an area of land or in its ability to support natural ecosystems or types of agriculture. Degradation may be caused by a variety of factors, including inappropriate land management techniques, soil erosion, salinity, flooding, clearing, pests, pollution, climatic factors, or progressive urbanization."@en ;
    skos:prefLabel "field damage"@en .

<http://www.eionet.europa.eu/gemet/concept/3178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050> ;
    skos:definition "Experiment carried out on a substance or on an organism in the open air as opposed to in a laboratory."@en ;
    skos:prefLabel "field experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/3179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Scientific study made in the open air to collect information that can not be obtained in a laboratory."@en ;
    skos:prefLabel "field study"@en .

<http://www.eionet.europa.eu/gemet/concept/3181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Any substance used to fill the holes and irregularities in planed or sanded surfaces so as to decrease the porosity of the surface for finish coatings."@en ;
    skos:prefLabel "filling material"@en .

<http://www.eionet.europa.eu/gemet/concept/3182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A place where petrol and other supplies for motorists are sold."@en ;
    skos:prefLabel "filling station"@en .

<http://www.eionet.europa.eu/gemet/concept/3186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Accumulated solids, wet or dry, generated by any filtration process, including accumulation on fabric filters in air filtering processes, or accumulation of wet solids in liquid filtering processes."@en ;
    skos:prefLabel "filter cake"@en .

<http://www.eionet.europa.eu/gemet/concept/3192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "A system where inert materials, which are not to be mobilized by natural processes even for long time periods, are confined by three barriers: the natural impermeable surroundings, an artificial barrier (such as liner) which can be controlled and, most important, the inert material itself. The concept of final storage includes the possibility to mine the materials in the future if such materials are sufficiently \"clean\" (mono-landfills) and if it becomes economic to mine such ores."@en ;
    skos:prefLabel "final storage"@en .

<http://www.eionet.europa.eu/gemet/concept/3196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13260> ;
    skos:definition "The financial reparations that a claimant seeks or a court awards for injuries sustained or property harmed by another."@en ;
    skos:prefLabel "financial compensation"@en .

<http://www.eionet.europa.eu/gemet/concept/3197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3201> ;
    skos:definition "Something given, including any form of income or price support; individual investor's monetary offering or contribution to common fund or stock; government agency's or lending aid agency's subsidy, grant, or other contribution to help bolster an economy."@en ;
    skos:prefLabel "financial contribution"@en .

<http://www.eionet.europa.eu/gemet/concept/3207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6103> ;
    skos:definition "A pecuniary punishment or penalty imposed by lawful tribunal upon person convicted of crime or misdemeanor."@en ;
    skos:prefLabel "fine"@en .

<http://www.eionet.europa.eu/gemet/concept/3219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A chemical used as a coating for or a component of a combustible material to reduce or eliminate a tendency to burn; used with textiles, plastics, rubbers, paints, and other materials."@en ;
    skos:prefLabel "fireproofing agent"@en .

<http://www.eionet.europa.eu/gemet/concept/3225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3220> ;
    skos:definition "Rules to be followed and safety systems to be adopted for preventing or fighting fire."@en ;
    skos:prefLabel "fire safety requirement"@en .

<http://www.eionet.europa.eu/gemet/concept/3226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6822> ;
    skos:definition "Technical organisation with trained personnel for dealing with fires and other incidents and for co-operating in their prevention."@en ;
    skos:prefLabel "fire service"@en .

<http://www.eionet.europa.eu/gemet/concept/3229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The process of applying fire or heat, as in the hardening or glazing of ceramics."@en ;
    skos:prefLabel "firing"@en .

<http://www.eionet.europa.eu/gemet/concept/3236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/417> ;
    skos:prefLabel "fish disease"@en .

<http://www.eionet.europa.eu/gemet/concept/3243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The production, distribution, and consumption of fish and seafood and all financial aspects of the fishing and seafood industry."@en ;
    skos:prefLabel "fishery economics"@en .

<http://www.eionet.europa.eu/gemet/concept/3246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Common Fisheries Policy which covers all fishing activities, the farming of living aquatic resources, and their processing and marketing, on the legal basis of Article 39 of the Treaty of Rome. It was agreed between members of the European Community in 1983. It lays down annual catch limits for major species of fish, a 12-mile exclusive fishing zone for each state, and an equal-access zone of 200 nautical miles from its coast within which any member state is allowed to fish."@en ;
    skos:prefLabel "fishery policy"@en .

<http://www.eionet.europa.eu/gemet/concept/3254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:definition "Raising of fish in inland waters, estuaries or coastal waters."@en ;
    skos:prefLabel "fish farming"@en .

<http://www.eionet.europa.eu/gemet/concept/326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Compound containing one or more alkyl radicals."@en ;
    skos:prefLabel "alkyl compound"@en .

<http://www.eionet.europa.eu/gemet/concept/3260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the handling, processing, and packing of fish or shellfish for market or shipment."@en ;
    skos:prefLabel "fishing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Rules concerning fishing activities; in international law the matter is ruled by the 1958 Geneva Convention."@en ;
    skos:prefLabel "fishing law"@en .

<http://www.eionet.europa.eu/gemet/concept/3266> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7654> ;
    skos:prefLabel "fishing vessel"@en .

<http://www.eionet.europa.eu/gemet/concept/3269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "Fish diseases observed in the past three decades and which have been attributed to pollution include: haemorrhages; tumours; fin rot; deformed fins; and missing scales and tails. In industrialized countries, increasing numbers of fish are deemed inedible. Many small kills are not noticed or are not reported, and large kills are often not included because of insufficient information to determine whether the kills were caused by pollution or by natural factors. Low dissolved oxygen levels resulting from excessive sewage is one of the leading causes. The second most common cause is pesticides."@en ;
    skos:prefLabel "fish kill"@en .

<http://www.eionet.europa.eu/gemet/concept/3273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3241> ;
    skos:definition "Quantity of fish held for future use."@en ;
    skos:prefLabel "fish stock"@en .

<http://www.eionet.europa.eu/gemet/concept/3274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:prefLabel "fish toxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/3277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Plumbing equipment in a building."@en ;
    skos:prefLabel "fitting (plumbing)"@en .

<http://www.eionet.europa.eu/gemet/concept/3278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:prefLabel "fixed schedule of charges"@en .

<http://www.eionet.europa.eu/gemet/concept/3281> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5051> ;
    skos:definition "Practice of registering a merchant vessel with a country that has favourable (i.e. less restrictive ) safety requirements, registration fees, etc."@en ;
    skos:prefLabel "flag of convenience"@en .

<http://www.eionet.europa.eu/gemet/concept/3282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition """1) Flares use open flames during normal and/or emergency operations to combust hazardous gaseous. The system has no special features to control temperature or time of combustion; however, supplemental fuel may be required to sustain the combustion. Historically, flares have been used to dispose of waste gases in the oil and gas industry and at wastewater treatment plants having anaerobic digestors. Regulation for thermal destruction of hazardous wastes limit the practical use of flaring to combustion of relatively simple hydrocarbons, such as methane from digesters or landfill gas collection systems. 
2) A control device that burns hazardous materials to prevent their release into the environment; may operate continuously or intermittently, usually on top a stack."""@en ;
    skos:prefLabel "flaring"@en .

<http://www.eionet.europa.eu/gemet/concept/3283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Tests performed in the medical field whose results are available very quickly."@en ;
    skos:prefLabel "rapid test"@en .

<http://www.eionet.europa.eu/gemet/concept/3287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/564> ;
    skos:definition "A substance, such as an extract or a spice, that imparts flavor."@en ;
    skos:prefLabel "flavouring"@en .

<http://www.eionet.europa.eu/gemet/concept/3288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "Any of the wingless insects composing the order Siphonaptera; most are ectoparasites of mammals and birds."@en ;
    skos:prefLabel "flea"@en .

<http://www.eionet.europa.eu/gemet/concept/329> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "Any antigen, such as pollen, a drug, or food, that induces an allergic state in humans or animals."@en ;
    skos:prefLabel "allergen"@en .

<http://www.eionet.europa.eu/gemet/concept/3294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A reagent added to a dispersion of solids in a liquid to bring together the fine particles to form flocs."@en ;
    skos:prefLabel "flocculant"@en .

<http://www.eionet.europa.eu/gemet/concept/3295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A process of contact and adhesion whereby the particles of a dispersed substance form large clusters or the aggregation of particles in a colloid to form small lumps, which then settle out."@en ;
    skos:prefLabel "flocculation"@en .

<http://www.eionet.europa.eu/gemet/concept/3300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures taken to prevent or reduce harm caused by an unusual accumulation of water above the ground, often involving the construction of reservoirs and channeling structures."@en ;
    skos:prefLabel "flood control"@en .

<http://www.eionet.europa.eu/gemet/concept/3305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "The plant life characterizing a specific geographic region or environment."@en ;
    skos:prefLabel "flora (biology)"@en .

<http://www.eionet.europa.eu/gemet/concept/3307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6999> ;
    skos:definition "The process of returning plant ecosystems and habitats to their original conditions."@en ;
    skos:prefLabel "flora restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/3308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A process used to separate particulate solids by causing one group of particles to float; utilizes differences in surface chemical properties of the particles, some of which are entirely wetted by water, others are not."@en ;
    skos:prefLabel "flotation"@en .

<http://www.eionet.europa.eu/gemet/concept/3312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "The reproductive structure of angiosperm plants, consisting of stamens and carpels surrounded by petals and sepals all borne on the receptacle."@en ;
    skos:prefLabel "flower"@en .

<http://www.eionet.europa.eu/gemet/concept/3315> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The velocity and the density of a fluid as functions of position and time."@en ;
    skos:prefLabel "flow field"@en .

<http://www.eionet.europa.eu/gemet/concept/3316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:definition "Moving waters like rivers and streams."@en ;
    skos:prefLabel "flowing water"@en .

<http://www.eionet.europa.eu/gemet/concept/3319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1583> ;
    skos:definition "The gaseous combustion product generated by a furnace and often exhausted through a chimney (flue)."@en ;
    skos:prefLabel "flue gas"@en .

<http://www.eionet.europa.eu/gemet/concept/332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A condition of abnormal sensitivity in certain individuals to contact with substances such as proteins, pollens, bacteria, and certain foods. This contact may result in exaggerated physiologic responses such as hay fever, asthma, and in severe enough situations, anaphylactic shock."@en ;
    skos:prefLabel "allergy"@en .

<http://www.eionet.europa.eu/gemet/concept/3322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "A control technology that employs fluid dynamic phenomena to perform sensing, control, information, processing, and actuation functions without the use of moving mechanical parts."@en ;
    skos:prefLabel "fluidics"@en .

<http://www.eionet.europa.eu/gemet/concept/3325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3324> ;
    skos:definition """1) A system for burning solid carbonaceous fuel efficiently and at a relatively low temperature, thus minimizing the emission of pollutants. The fuel is crushed to very small particles or a powder and mixed with particles of an inert material. The mixture is fed into a bed through which air is pumped vertically upwards, agitating the particles so they behave like a fluid. The forced circulation of air and the small size and separation of fuel particles ensures efficient burning.
2) A bed of finely divided solid through which air or a gas is blown in a controlled manner so that it behaves as a liquid."""@en ;
    skos:prefLabel "fluidised bed"@en .

<http://www.eionet.europa.eu/gemet/concept/3328> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2344> ;
    skos:definition "The addition of the fluorine ion to municipal water supplies in a final concentration of 0.8-1.6 ppm (parts per million) to help prevent dental caries in children."@en ;
    skos:prefLabel "fluoridation"@en .

<http://www.eionet.europa.eu/gemet/concept/3334> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2642> ;
    skos:definition "A gaseous or liquid chemical element; a member of the halide family, it is the most electronegative element and the most chemically energetic of the nonmetallic elements; highly toxic, corrosive, and flammable; used in rocket fuels and as a chemical intermediate."@en ;
    skos:prefLabel "fluorine"@en .

<http://www.eionet.europa.eu/gemet/concept/3340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3494> ;
    skos:definition "Any source of supply derived from a river, particularly its water, which is collected, stored and treated, then distributed for domestic, industrial, farm and other uses."@en ;
    skos:prefLabel "fluvial resource"@en .

<http://www.eionet.europa.eu/gemet/concept/3341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4336> ;
    skos:definition "Transportation of goods or persons by means of ships travelling on rivers."@en ;
    skos:prefLabel "river transport"@en .

<http://www.eionet.europa.eu/gemet/concept/3342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Finely divided particles of ash that are entrained in flue gases resulting from the combustion of fuel or other material. The particles of ash may contain incompletely burned fuel and other pollutants."@en ;
    skos:prefLabel "fly ash"@en .

<http://www.eionet.europa.eu/gemet/concept/3343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Substances which make it possible to form a homogenous dispersion of a gaseous phase in a liquid or solid medium."@en ;
    skos:prefLabel "foaming agent"@en .

<http://www.eionet.europa.eu/gemet/concept/3345> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/423> ;
    skos:definition "Bulk feed for livestock, especially hay, straw, etc."@en ;
    skos:prefLabel "fodder"@en .

<http://www.eionet.europa.eu/gemet/concept/3347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "Water droplets or, rarely, ice crystals suspended in the air in sufficient concentration to reduce visibility appreciably."@en ;
    skos:prefLabel "fog"@en .

<http://www.eionet.europa.eu/gemet/concept/3348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "Fine water droplets suspended in the air, which reduce visibility. Usually mists form at night, when the temperature falls because the sky is clear. If visibility falls below 1,000 metres, the mist becomes a fog."@en ;
    skos:prefLabel "mist"@en .

<http://www.eionet.europa.eu/gemet/concept/335> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2498> ;
    skos:definition "The assignment or allotment of resources to various uses in accord with a stated goal or policy."@en ;
    skos:prefLabel "allocation"@en .

<http://www.eionet.europa.eu/gemet/concept/3350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "The green leaves of a plant."@en ;
    skos:prefLabel "foliage"@en .

<http://www.eionet.europa.eu/gemet/concept/336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "The formulation and application of such measures as laws, economic plans, urbanism, etc., to ensure a balance between the population's needs and the country's resources."@en ;
    skos:prefLabel "allocation plan"@en .

<http://www.eionet.europa.eu/gemet/concept/3360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2389> ;
    skos:definition "Any digestible substance, usually a synthetic dye, which manufacturers add to food to give it color and enhance its appearance."@en ;
    skos:prefLabel "food colourant"@en .

<http://www.eionet.europa.eu/gemet/concept/3362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "An interchange of any food commodity or related food products, usually on a large scale."@en ;
    skos:prefLabel "food commerce"@en .

<http://www.eionet.europa.eu/gemet/concept/3365> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3380> ;
    skos:prefLabel "food contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/3367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4126> ;
    skos:definition "That part of the science of hygiene that deals with the principles and methods of sanitation applied to the quality of foodstuffs, to their processing, preparation, conservation and consumption by man."@en ;
    skos:prefLabel "food hygiene"@en .

<http://www.eionet.europa.eu/gemet/concept/3370> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3375> ;
    skos:definition "The most recent addition to food preservation technologies is the use of ionizing radiation, which has some distinct advantages over conventional methods. With irradiation, foods can be treated after packaging, thus eliminating post-processing contamination. In addition, foods are preserved in a fresh state and can be kept longer without noticeable loss of quality. Food irradiation leaves no residues, and changes in nutritional value due to irradiation are comparable with those produced by other processes. Irradiation is the process of applying high energy to a material, such as food, to sterilize or extend its shelf-life by killing microorganisms, insects and other pests residing on it. Sources of ionizing radiation that have been used include gamma rays, electron beams and X-rays. Gamma rays are produced by radioactive isotopes such as Cobalt-60. Electron beams are produced by linear accelerators, which themselves are powered by electricity. The dose applied to a product is the most important factor of the process. At high doses, food is essentially sterilized, just as occurs in canning. Products so treated can be stored at room temperature almost indefinitely. Controversial and banned in some countries."@en ;
    skos:prefLabel "food irradiation"@en .

<http://www.eionet.europa.eu/gemet/concept/3372> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Potentially harmful substances in any food consumed by humans, or other animals, including inorganic and organic chemicals, viruses and bacteria."@en ;
    skos:prefLabel "food pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/3376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:definition "A commercial establishment in which food is manufactured or packaged for human consumption."@en ;
    skos:prefLabel "food processing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:prefLabel "food production (agriculture)"@en .

<http://www.eionet.europa.eu/gemet/concept/3384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The applied science which deals with the chemical, biochemical, physical, physiochemical, and biological properties of foods."@en ;
    skos:prefLabel "food science"@en .

<http://www.eionet.europa.eu/gemet/concept/3387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Stock of food kept in storage as a national measure to provide security against fluctuations in food supply."@en ;
    skos:prefLabel "food storage"@en .

<http://www.eionet.europa.eu/gemet/concept/3392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3481> ;
    skos:prefLabel "food transport"@en .

<http://www.eionet.europa.eu/gemet/concept/3395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10905> ;
    skos:definition "A narrow path for walkers only."@en ;
    skos:prefLabel "footpath"@en .

<http://www.eionet.europa.eu/gemet/concept/3396> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1752> ;
    skos:definition "Introduction of hazardous or poisonous substances such as arsenic or lead into, or onto, fodder for animals. The animals consume the contaminated feed and can become sick and may die."@en ;
    skos:prefLabel "forage contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/3397> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/206> ;
    skos:prefLabel "forage law"@en .

<http://www.eionet.europa.eu/gemet/concept/3401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "To shut out, to bar, to destroy an equity of redemption. A termination of all rights of the mortgagor or his grantee in the property covered by the mortgage. The process by which a mortgagor of real or personal property, or other owner of property subject to a lien, is deprived of his interest therein. Procedure by which mortgaged property is sold on default of mortgagor in satisfaction of mortgage debt. In common usage, refers to enforcement of lien, trust deed, or mortgage in any method provided by law."@en ;
    skos:prefLabel "foreclosure"@en .

<http://www.eionet.europa.eu/gemet/concept/3402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Dealing in economic or monetary matters with foreign countries."@en ;
    skos:prefLabel "foreign economic relations"@en .

<http://www.eionet.europa.eu/gemet/concept/3404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "The diplomatic policy of a nation in its interactions with other nations."@en ;
    skos:prefLabel "foreign policy"@en .

<http://www.eionet.europa.eu/gemet/concept/341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition "An overflowing; an inundation or flood, especially when the water is charged with much suspended material."@en ;
    skos:prefLabel "alluvion"@en .

<http://www.eionet.europa.eu/gemet/concept/3410> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:prefLabel "forest conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/3411> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:definition "Destruction of forests is carried out in many countries in order to provide new land for agricultural or livestock purposes. It is often done without factors such as climate and topography having been sufficiently studied and on lands where slope nature of the soil or other physiographic characteristics clearly indicate that the land involved is suitable only for forest. Although these practices may lead to a temporary increase in productivity, there are also many indications that in the long run there is usually a decrease in productivity per unit of surface and that erosion and irreversible soil deterioration often accompany this process. Many factors contribute to forest cover destruction: timber production, clearance for agriculture, cutting for firewood and charcoal, fires, droughts, strip mining, pollution, urban development, population pressures, and warfare."@en ;
    skos:prefLabel "forest cover destruction"@en .

<http://www.eionet.europa.eu/gemet/concept/3416> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "Any forest environment, in which plants and animals interact with the chemical and physical features of the environment, in which they live."@en ;
    skos:prefLabel "forest ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/3419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3212> ;
    skos:definition "A conflagration in or destroying large wooded areas having a thick growth of trees and plants."@en ;
    skos:prefLabel "forest fire"@en .

<http://www.eionet.europa.eu/gemet/concept/342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:definition "A stream of alpha particles which are ejected from many radioactive substances having a penetrating power of a few cm in air but can be stopped by a thin piece of paper."@en ;
    skos:prefLabel "alpha radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/3423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of establishments is engaged in the management of an extensive area of woodland, often to produce products and benefits such as timber, wildlife habitat, clean water, biodiversity and recreation."@en ;
    skos:prefLabel "forest industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3426> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6138> ;
    skos:definition "Organisms that damage trees."@en ;
    skos:prefLabel "forest pest"@en .

<http://www.eionet.europa.eu/gemet/concept/3430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government or some other organization, which seeks to preserve or protect an extensive area of woodland, often to produce products and benefits such as timber, wildlife habitat, clean water, biodiversity and recreation."@en ;
    skos:prefLabel "forest policy"@en .

<http://www.eionet.europa.eu/gemet/concept/3431> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "Forests produce a range of products including firewood and charcoal, lumber, paper, and crops such as coffee, oil palm, and rubber. With careful planning of growth and harvesting, wood and other forest products are, in principle, renewable resources. But achieving renewability takes time - often decades, sometimes centuries. Without careful management, pressure for short-term exploitation can lead to tree removal, soil degradation, and conversion of woodland to other uses. Consumption of forest resources can lead to environmental problems as well as loss of critical habitat and species."@en ;
    skos:prefLabel "forest production"@en .

<http://www.eionet.europa.eu/gemet/concept/3437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7169> ;
    skos:prefLabel "forest resource assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/3440> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The production, distribution, and consumption of goods and services from the industry involved with the process of establishing and managing forests."@en ;
    skos:prefLabel "forestry economics"@en .

<http://www.eionet.europa.eu/gemet/concept/3441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3442> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate any extensive area of woodland, for the protection and preservation of game, timber and other forest resources."@en ;
    skos:prefLabel "forestry law"@en .

<http://www.eionet.europa.eu/gemet/concept/3460> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3026> ;
    skos:definition "Any remains, trace, or imprint of a plant or animal that has been preserved in the Earth's crust since some past geologic or prehistoric time."@en ;
    skos:prefLabel "fossil"@en .

<http://www.eionet.europa.eu/gemet/concept/3465> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7976> ;
    skos:definition "The adhesion of different marine organisms to the underwater parts of ships, causing the ships to loose speed."@en ;
    skos:prefLabel "fouling growth"@en .

<http://www.eionet.europa.eu/gemet/concept/3474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "A body of rules prescribed by a government, often composed in a series of inter-related parts, to establish or lay the foundation for a new project, agency or organizational structure."@en ;
    skos:prefLabel "framework legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/3477> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/23> ;
    skos:definition "The ability, right and permission to approach and use, or the general availability of resources that convey knowledge."@en ;
    skos:prefLabel "access to information"@en .

<http://www.eionet.europa.eu/gemet/concept/3483> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1381> ;
    skos:definition "Trade name for a group of polyhalogenated hydrocarbons containing fluorine and chlorine; an example is trichlorofluoromethane."@en ;
    skos:prefLabel "freon"@en .

<http://www.eionet.europa.eu/gemet/concept/3487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The scientific study or the characteristic life processes of living organisms found in a natural body of water that does not contain significant amounts of dissolved salts and minerals, such as a lake or river."@en ;
    skos:prefLabel "freshwater biology"@en .

<http://www.eionet.europa.eu/gemet/concept/3489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:definition "The living organisms and nonliving materials of an inland aquatic environment."@en ;
    skos:prefLabel "freshwater ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/349> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Materials employed in the place of others which are more dangerous for the environment, such as phosphate substitutes in detergents."@en ;
    skos:prefLabel "alternative material"@en .

<http://www.eionet.europa.eu/gemet/concept/3491> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9196> ;
    skos:prefLabel "freshwater monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/3492> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/511> ;
    skos:definition "Organisms which live in freshwater."@en ;
    skos:prefLabel "freshwater organism"@en .

<http://www.eionet.europa.eu/gemet/concept/3495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/387> ;
    skos:definition "Any insectivorous anuran amphibian of the family Ranidae, such as Rana temporaria of Europe, having a short squat tailless body with a moist smooth skin and very long hind legs specialized for hopping."@en ;
    skos:prefLabel "frog"@en .

<http://www.eionet.europa.eu/gemet/concept/3496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A deposit of interlocking ice crystals formed by direct sublimation on objects."@en ;
    skos:prefLabel "frost"@en .

<http://www.eionet.europa.eu/gemet/concept/3498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "A fully matured plant ovary with or without other floral or shoot parts united with it at maturity."@en ;
    skos:prefLabel "fruit"@en .

<http://www.eionet.europa.eu/gemet/concept/3499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Cultivation of fruit trees for home consumption or on a commercial basis."@en ;
    skos:prefLabel "fruit cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/3502> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8664> ;
    skos:definition "Any tree that bears edible fruit."@en ;
    skos:prefLabel "fruit tree"@en .

<http://www.eionet.europa.eu/gemet/concept/3506> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/88> ;
    skos:definition "Substance (such as tetraethyl lead) which is added to petrol to prevent knocking."@en ;
    skos:prefLabel "fuel additive"@en .

<http://www.eionet.europa.eu/gemet/concept/3507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "Alternative source of energy for motor vehicles. It is produced by fermentation of sugar cane by the yeast Saccharomyces cerevisiae."@en ;
    skos:prefLabel "fuel alcohol"@en .

<http://www.eionet.europa.eu/gemet/concept/3509> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1299> ;
    skos:prefLabel "fuel composition"@en .

<http://www.eionet.europa.eu/gemet/concept/351> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Technology that, as an alternative to resource-intensive and wasteful industry, aims to utilize resources sparingly, with minimum damage to the environment, at affordable cost and with a possible degree of control over the processes."@en ;
    skos:prefLabel "alternative technology"@en .

<http://www.eionet.europa.eu/gemet/concept/3510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "The amount of fuel utilized."@en ;
    skos:prefLabel "fuel consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/3517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Wood used for heating."@en ;
    skos:prefLabel "fuel wood"@en .

<http://www.eionet.europa.eu/gemet/concept/352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5887> ;
    skos:definition "A natural or synthetic oxide of aluminum widely distributed in nature, often found as a constituent part of clays, feldspars, micas and other minerals, and as a major component of bauxite."@en ;
    skos:prefLabel "alumina"@en .

<http://www.eionet.europa.eu/gemet/concept/3521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "The use of a chemical compound in a gaseous state to kill insects, nematodes, arachnids, rodents, weeds, and fungi in confined or inaccessible locations; also used to control weeds, nematodes, and insects in the field."@en ;
    skos:prefLabel "fumigation"@en .

<http://www.eionet.europa.eu/gemet/concept/3522> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "A substance from the point of view of its function or purpose, for example a painting agent or a preserving substance."@en ;
    skos:prefLabel "functional substance"@en .

<http://www.eionet.europa.eu/gemet/concept/3524> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "The main soil function is participation in the material transformation and migrating processes occurring in the natural environment on which the functioning of ecosystems depends. The most active participants in the occurring processes are microorganisms and invertebrates, whose activity, different variety, complex structure, and abundance accurately reflect the soil type and its characteristics: so they are important indicators of ecological stability. The variety of soil organisms determine its self-regulatory and self-cleaning capacity."@en ;
    skos:prefLabel "soil function"@en .

<http://www.eionet.europa.eu/gemet/concept/353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2638> ;
    skos:definition "A light white metal, ductile and malleable, and a good conductor of electricity. It occurs widely in nature in clays and is the third most abundant element in the Earth's crust. It is extracted mainly from bauxite by electrolysis of a molten mixture of purified bauxite and cryolite. The metal and its alloys are used for aircraft, cooking utensils, electrical apparatus, and for many other purposes where its light weight is an advantage. Aluminium became implicated as an environmental health hazard in the 1980s on two counts. Biomedical scientists looking for possible causes of Alzheimer's disease, the premature senility indicated by loss of memory and confusion, found a circumstantial link with aluminium. The theory is a controversial one."@en ;
    skos:prefLabel "aluminium"@en .

<http://www.eionet.europa.eu/gemet/concept/3530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "Chemicals used to kill or halt the development of fungi that cause plant disease, such as: storage rot; seedling diseases; root rots; vascular wilts; leaf blights, rusts, smuts and mildews, and viral diseases. These can be controlled by the early and continued application of selected fungicides that either kill the pathogens or restrict their development."@en ;
    skos:prefLabel "fungicide"@en .

<http://www.eionet.europa.eu/gemet/concept/3533> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/442> ;
    skos:definition "The hair-covered, dressed pelt of such a mammal, used in the making of garments and as trimming or decoration."@en ;
    skos:prefLabel "fur"@en .

<http://www.eionet.europa.eu/gemet/concept/3535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Animals bred and slaughtered for their fur."@en ;
    skos:prefLabel "fur animal"@en .

<http://www.eionet.europa.eu/gemet/concept/3539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "The movable articles in a room or an establishment that make it fit for living or working."@en ;
    skos:prefLabel "furniture"@en .

<http://www.eionet.europa.eu/gemet/concept/354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1746> ;
    skos:definition "A can or box made of aluminium in which material is held or carried."@en ;
    skos:prefLabel "aluminium container"@en .

<http://www.eionet.europa.eu/gemet/concept/3540> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "furniture industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The business or trade of dressed furs and garments made from the coats of certain animals."@en ;
    skos:prefLabel "furriery"@en .

<http://www.eionet.europa.eu/gemet/concept/3548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "The order of birds that includes grouse, ptarmigan, capercaillie, partridges, pheasants, quails, turkeys and peacocks. These are mainly grain-eating, heavy-bodied, ground-nesting birds, capable of only short, rapid flights. The cocks are usually more colourful than the hens."@en ;
    skos:prefLabel "gallinacean"@en .

<http://www.eionet.europa.eu/gemet/concept/355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "Amount of aluminium contained in a solution."@en ;
    skos:prefLabel "aluminium content"@en .

<http://www.eionet.europa.eu/gemet/concept/3550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The act of coating iron or steel with zinc, either by immersion in a bath of molten zinc or by deposition from a solution of zinc sulphate, to give protection against corrosion."@en ;
    skos:prefLabel "galvanisation"@en .

<http://www.eionet.europa.eu/gemet/concept/3554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:definition "Radiation of gamma rays."@en ;
    skos:prefLabel "gamma radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5175> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the mining and processing of aluminum."@en ;
    skos:prefLabel "aluminium industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1651> ;
    skos:definition "Natural organic matter discarded from gardens and yards including leaves, grass clippings, prunings, brush and stumps."@en ;
    skos:prefLabel "garden waste"@en .

<http://www.eionet.europa.eu/gemet/concept/3564> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Mediterranean bush consisting of low evergreen shrubs and abundant herbaceous plants."@en ;
    skos:prefLabel "garrigue"@en .

<http://www.eionet.europa.eu/gemet/concept/3567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1400> ;
    skos:definition "A separation technique involving passage of a gaseous moving phase through a column containing a fixed phase; it is used principally as a quantitative analytical technique for volatile compounds."@en ;
    skos:prefLabel "gas chromatography"@en .

<http://www.eionet.europa.eu/gemet/concept/3570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Company charged with the production and distribution of gas for domestic use."@en ;
    skos:prefLabel "gas company"@en .

<http://www.eionet.europa.eu/gemet/concept/3571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3469> ;
    skos:definition "An internal combustion engine that uses gaseous fuel."@en ;
    skos:prefLabel "gas engine"@en .

<http://www.eionet.europa.eu/gemet/concept/3582> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3578> ;
    skos:definition "Conversion of a gas to the liquid phase by cooling or compression."@en ;
    skos:prefLabel "gas liquefaction"@en .

<http://www.eionet.europa.eu/gemet/concept/3585> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3577> ;
    skos:prefLabel "gas mixture"@en .

<http://www.eionet.europa.eu/gemet/concept/3587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "A mixture of 80% or 90% petrol with 20% or 10% ethyl alcohol, for use as a fuel in internal combustion engines."@en ;
    skos:prefLabel "gasohol"@en .

<http://www.eionet.europa.eu/gemet/concept/3589> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3469> ;
    skos:definition "An internal combustion engine that uses a mixture of air and gasoline vapour as a fuel."@en ;
    skos:prefLabel "gasoline engine"@en .

<http://www.eionet.europa.eu/gemet/concept/3591> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3586> ;
    skos:definition "A long pipe, especially underground, used to transport gas over long distances."@en ;
    skos:prefLabel "gas pipeline"@en .

<http://www.eionet.europa.eu/gemet/concept/3593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power station which burns gas, as opposed to a coal-fired station or nuclear power station."@en ;
    skos:prefLabel "gas powered plant"@en .

<http://www.eionet.europa.eu/gemet/concept/3594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3578> ;
    skos:definition "Removal of pollutants or contaminants from waste incineration or other combustion processes."@en ;
    skos:prefLabel "gas purification"@en .

<http://www.eionet.europa.eu/gemet/concept/3595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3578> ;
    skos:definition "Gas feedback device: while refuelling gasoline vapors are sucked off and led back again into the storage tank."@en ;
    skos:prefLabel "vapour recovery system"@en .

<http://www.eionet.europa.eu/gemet/concept/3596> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3586> ;
    skos:definition "Large tank for storing coal gas or natural gas."@en ;
    skos:prefLabel "gas reservoir"@en .

<http://www.eionet.europa.eu/gemet/concept/36> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4049> ;
    skos:prefLabel "accumulation in body tissues"@en .

<http://www.eionet.europa.eu/gemet/concept/360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7181> ;
    skos:definition "A tiny, thin-walled, capillary-rich sac in the lungs where the exchange of oxygen and carbon dioxide takes place. Also called air sac."@en ;
    skos:prefLabel "alveolus"@en .

<http://www.eionet.europa.eu/gemet/concept/3600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5339> ;
    skos:definition "Any mollusc of the class Gastropoda, typically having a flattened muscular foot for locomotion and a head that bears stalked eyes."@en ;
    skos:prefLabel "gastropod"@en .

<http://www.eionet.europa.eu/gemet/concept/3604> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Place where gas, especially coal gas, is made."@en ;
    skos:prefLabel "gaswork"@en .

<http://www.eionet.europa.eu/gemet/concept/3613> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "Storehouses of seeds or vegetative tissue, kept in low humidity and temperature, to help maintain genetic diversity. Sometimes known as seed banks or germ plasm banks. their contents mostly originate from a wide range of primitive strains and wild crop varieties. The International Board for Plant Genetic Resources (IBPGR), which was established in 1974, promotes the collection, documentation, evaluation, conservation and eventual use of genetic resources of significant plant species. Gene banks are the subject of international controversy because they contain seeds that have mostly been acquired from the developing countries by the industrially rich countries, where they have been used in breeding programmes to develop new strains. Instead of taking decades over a traditional plant breeding programme by fertilization, it is now possible to manipulate directly the genes of plants, creating genetically modified organisms (GMOs), which are plants modified to give a higher resistance to disease and improved growth and yields and, therefore, increase the profit of the plant breeder and farmer."@en ;
    skos:prefLabel "gene bank"@en .

<http://www.eionet.europa.eu/gemet/concept/3614> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11494> ;
    skos:definition "An administrative mandate outlining the process by which a concept, plan, decree or law is to be put into actual practice by a specific organization or government agency."@en ;
    skos:prefLabel "general administrative order"@en .

<http://www.eionet.europa.eu/gemet/concept/3615> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "The study of the elements and the compounds they form."@en ;
    skos:prefLabel "general chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/3617> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15184>,
        <http://www.eionet.europa.eu/gemet/concept/3628> ;
    skos:definition "A unit of heredity composed of DNA occupying a fixed position on a chromosome. A gene may determine a characteristic of an individual by specifying a polypeptide chain that forms a protein or part of a protein (structural gene); or repress such operation (repressor gene)."@en ;
    skos:prefLabel "gene"@en .

<http://www.eionet.europa.eu/gemet/concept/3621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/849> ;
    skos:definition "Inheritable change, chiefly mutations produced by chemical substances, herbicides, radiations, etc."@en ;
    skos:prefLabel "genetic effect"@en .

<http://www.eionet.europa.eu/gemet/concept/3625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:prefLabel "genetic engineering legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327>,
        <http://www.eionet.europa.eu/gemet/concept/340> ;
    skos:definition "A solution of a metal in mercury."@en ;
    skos:prefLabel "amalgam"@en .

<http://www.eionet.europa.eu/gemet/concept/3630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "Inheritable changes produced by ionizing radiation, exposure to certain chemicals, ingestion of some medication and from other causes."@en ;
    skos:prefLabel "genetic modification"@en .

<http://www.eionet.europa.eu/gemet/concept/3632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/873> ;
    skos:definition "The gene pool in natural and cultivated stocks of organisms that are available for human exploitation. It is desirable to maintain as diverse a range of organisms as possible, particularly of domesticated cultivars and their ancestors, in order to maintain a wide genetic base. The wider the genetic base, the greater the capacity for adaptation to particular environmental conditions."@en ;
    skos:prefLabel "genetic resource"@en .

<http://www.eionet.europa.eu/gemet/concept/3634> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Change in one or more phenotypic characteristics, due to gene mutation or rearrangement, environmental effects, etc."@en ;
    skos:prefLabel "genetic variation"@en .

<http://www.eionet.europa.eu/gemet/concept/3638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "A subdivision of geophysics which includes determination of the size and shape of the earth, the earth's gravitational field, and the location of points fixed to the earth's crust in an earth-referred coordinate system."@en ;
    skos:prefLabel "geodesy"@en .

<http://www.eionet.europa.eu/gemet/concept/3640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11> ;
    skos:definition "Geogenic factors are those which originate in the soil, as opposed to those of anthropic origin (anthropogenic)."@en ;
    skos:prefLabel "geogenic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/3647> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5496> ;
    skos:definition "Disasters caused by movements and deformation of the earth's crust."@en ;
    skos:prefLabel "geological disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/3654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The study of the classification, description, nature, origin, and development of present landforms and their relationships to underlying structures, and of the history of geologic changes as recorded by these surface features."@en ;
    skos:prefLabel "geomorphology"@en .

<http://www.eionet.europa.eu/gemet/concept/3655> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The physics of the earth and its environment, that is, earth, air and space."@en ;
    skos:prefLabel "geophysics"@en .

<http://www.eionet.europa.eu/gemet/concept/3657> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The application of scientific methods and engineering techniques to the exploitation and use of natural resources."@en ;
    skos:prefLabel "geotechnology"@en .

<http://www.eionet.europa.eu/gemet/concept/3658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "An energy produced by tapping the earth's internal heat. At present, the only available technologies to do this are those that extract heat from hydrothermal convection systems, where water or steam transfer the heat from the deeper part of the earth to the areas where the energy can be tapped. The amount of pollutants found in geothermal vary from area to area but may contain arsenic, boron, selenium, lead, cadmium, and fluorides. They also may contain hydrogen sulphide, mercury, ammonia, radon, carbon dioxide, and methane."@en ;
    skos:prefLabel "geothermal energy"@en .

<http://www.eionet.europa.eu/gemet/concept/3661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition """1) A pathogenic micro-organism.
2) Living substance capable of developing into an organ, part, or organism as a whole; a primordium."""@en ;
    skos:prefLabel "germ"@en .

<http://www.eionet.europa.eu/gemet/concept/3663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The beginning or the process of development of a spore or seed."@en ;
    skos:prefLabel "germination"@en .

<http://www.eionet.europa.eu/gemet/concept/3664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3628> ;
    skos:definition "The hereditary material transmitted to the offspring via the gametes."@en ;
    skos:prefLabel "germ plasm"@en .

<http://www.eionet.europa.eu/gemet/concept/3676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition """1) The study of all aspects of snow and ice; the science that treats quantitatively the whole range of processes associated with all forms of solid existing water. 
2) The study of existing glaciers and ice sheets, and of their physical properties."""@en ;
    skos:prefLabel "glaciology"@en .

<http://www.eionet.europa.eu/gemet/concept/3678> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "A hard, amorphous, inorganic, usually transparent, brittle substance made by fusing silicates, sometimes borates and phosphates, with certain basic oxides and then rapidly cooling to prevent crystallization."@en ;
    skos:prefLabel "glass"@en .

<http://www.eionet.europa.eu/gemet/concept/3681> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the production of glassware."@en ;
    skos:prefLabel "glass industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Aspects concerning the whole world considered as being closely connected by modern telecommunications and as being interdependent economically, socially and politically."@en ;
    skos:prefLabel "global aspect"@en .

<http://www.eionet.europa.eu/gemet/concept/3687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4420> ;
    skos:definition "A worldwide assembly of national, political party or organizational delegates, or the pact or the agreement that arises from such an assembly that forms, often, the preliminary to an international treaty."@en ;
    skos:prefLabel "global convention"@en .

<http://www.eionet.europa.eu/gemet/concept/3688> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "An international organization established in 1990 to provide practical assistance to governments in achieving environmental improvements. The GEF is managed by the World Bank, which contributes 2/3 of its funds, the remaining 1/3 being controlled by the United Nations Development Programme."@en ;
    skos:prefLabel "Global Environment Facility"@en .

<http://www.eionet.europa.eu/gemet/concept/3694> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "An alphabetical list of terms concerned with a particular subject, field or area of usage that includes accompanying definitions."@en ;
    skos:prefLabel "glossary"@en .

<http://www.eionet.europa.eu/gemet/concept/3695> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A crude, impure, amber-colored form of commercial gelatin of unknown detailed composition produced by the hydrolysis of animal collagen; gelatinizes in aqueous solutions and dries to form a strong, adhesive layer."@en ;
    skos:prefLabel "glue"@en .

<http://www.eionet.europa.eu/gemet/concept/370> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "A bioassay developed by Bruce N. Ames in 1974, performed on bacteria to assess the capability of environmental chemicals to cause mutations."@en ;
    skos:prefLabel "Ames test"@en .

<http://www.eionet.europa.eu/gemet/concept/3701> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8008> ;
    skos:definition "A game played on a large open course, the object of which is to hit a ball using clubs, with as few strokes as possible, into each of usually 18 holes."@en ;
    skos:prefLabel "golf"@en .

<http://www.eionet.europa.eu/gemet/concept/3705> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The competent, skillful and successful process of planning, leading and working toward the accomplishment or completion of goals, objectives and mission of an organization or institution."@en ;
    skos:prefLabel "good management"@en .

<http://www.eionet.europa.eu/gemet/concept/3712> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3715> ;
    skos:prefLabel "government advisory body"@en .

<http://www.eionet.europa.eu/gemet/concept/3714> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5686> ;
    skos:definition "Building for the offices of the main departments of government."@en ;
    skos:prefLabel "government building"@en .

<http://www.eionet.europa.eu/gemet/concept/3716> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3049> ;
    skos:prefLabel "government environmental expenditure"@en .

<http://www.eionet.europa.eu/gemet/concept/3717> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "A public body's debt or other legal obligation arising out of transactions in the past which must be liquidated, renewed or refunded at some future date."@en ;
    skos:prefLabel "government liability"@en .

<http://www.eionet.europa.eu/gemet/concept/3721> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Edible, starchy seeds of the grass family (Graminae) usable as food by man and his livestock."@en ;
    skos:prefLabel "grain"@en .

<http://www.eionet.europa.eu/gemet/concept/3729> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "A very large and widespread family of Monocotyledoneae, with more than 10.000 species, most of which are herbaceous, but a few are woody. The stems are jointed, the long, narrow leaves originating at the nodes. The flowers are inconspicuous, with a much reduced perianth, and are wind-pollinated or cleistogamous. The fruit in single-seeded, usually a caryopsis. Grasses are the most important of all plants for food."@en ;
    skos:prefLabel "grass"@en .

<http://www.eionet.europa.eu/gemet/concept/373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5928>,
        <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "Organic compounds containing a carboxyl group (-COOH) and an amino group (-NH2). About 30 amino acids are known. They are fundamental constituents of living matter because protein molecules are made up of many amino acid molecules combined together. Amino acids are synthesized by green plants and some bacteria, but some (arginine, histidine, lysine. threonine, methionine, isoleucine, leucine, valine, phenylalanine, tryptophane) cannot be synthesized by animals and therefore are essential constituents of their diet. Proteins from specific plants may lack certain amino acids, so a vegetarian diet must include a wide range of plant products."@en ;
    skos:prefLabel "amino acid"@en .

<http://www.eionet.europa.eu/gemet/concept/3730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3212> ;
    skos:definition "A conflagration in or destroying large areas of any vegetation in the Gramineae family as found in fields, meadows, savannas or other grasslands."@en ;
    skos:prefLabel "grass fire"@en .

<http://www.eionet.europa.eu/gemet/concept/3734> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of the biological communities located in biomes characterized by the dominance of indigenous grasses, grasslike plants and forbs, and their non-living environmental surroundings."@en ;
    skos:prefLabel "grassland ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/3738> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7298> ;
    skos:definition "A mixture of rock fragments and pebbles that is coarser than sand."@en ;
    skos:prefLabel "gravel"@en .

<http://www.eionet.europa.eu/gemet/concept/3739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Obtaining a mixture of coarse sand and small water- worn or pounded stones, (used for paths and roads and as an aggregate) from the earth."@en ;
    skos:prefLabel "gravel extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/3742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5286> ;
    skos:definition "A place where gravel is dug out of the ground."@en ;
    skos:prefLabel "gravel pit"@en .

<http://www.eionet.europa.eu/gemet/concept/3748> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "The vegetation on pastures that is available for livestock to feed upon."@en ;
    skos:prefLabel "grazing"@en .

<http://www.eionet.europa.eu/gemet/concept/375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A colorless gaseous alkaline compound that is very soluble in water, has a characteristic pungent odour, is lighter than air, and is formed as a result of the decomposition of most nitrogenous organic material."@en ;
    skos:prefLabel "ammonia"@en .

<http://www.eionet.europa.eu/gemet/concept/3754> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8815> ;
    skos:definition """1) An area of land, not necessarily continuous, near to and sometimes surrounding a large built-up area. The area is kept open by permanent and severe restriction on building. 
2) An irrigated, landscaped, and regularly maintained fuelbreak, usually put to some additional use, such as a golf course, park, or playground. 
3) A planning designation that mandates the setting aside of otherwise developable lands for the purpose of creating natural or semi-natural open spaces. Greenbelts are usually linear parkways, tracts, or belts of land running through or around urban conurbations.
4) An area or zone of open, semi-rural, low-density land surrounding existing major urban areas, but not necessarily continuous. The zone is to be kept open by permanent and severe restrictions on new development."""@en ;
    skos:prefLabel "greenbelt"@en .

<http://www.eionet.europa.eu/gemet/concept/3755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "The self-contained dwelling where man simulates the ways of ecosystems, i.e. his wastes are converted to fuel by anaerobic digestion for methane production and the residues from the digestion are used for growing food. The food residues are composted and/or used for methane production. Solar energy is trapped by the greenhouse effect and used for house, crop and water heating. A windmill would be used for electricity. Thus, given sufficient space, sunshine, rainfall and wind, the ecohouse is in theory a self-contained system recycling its own wastes and using the sun as its energy input."@en ;
    skos:prefLabel "green building"@en .

<http://www.eionet.europa.eu/gemet/concept/3756> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Avenues along which wide-ranging animals can travel, plants can propagate, genetic interchange can occur, populations can move in response to environmental changes and natural disasters, and threatened species can be replenished from other areas."@en ;
    skos:prefLabel "green corridor"@en .

<http://www.eionet.europa.eu/gemet/concept/3760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "Cultivation of plants, especially of out-of-season plants, in glass-enclosed, climate-controlled structures."@en ;
    skos:prefLabel "greenhouse cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/3761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3692> ;
    skos:definition "The warming of the Earth's atmosphere caused by the increasing concentration of atmospheric gases, such as water vapour and carbon dioxide. These gases absorb radiation emitted by the Earth, thus slowing down the loss of radiant energy from the Earth back to space."@en ;
    skos:prefLabel "greenhouse effect"@en .

<http://www.eionet.europa.eu/gemet/concept/3766> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5007> ;
    skos:definition "Herbaceous plant material plowed into the soil while still green."@en ;
    skos:prefLabel "green manure"@en .

<http://www.eionet.europa.eu/gemet/concept/3768> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:definition "The name given to the widespread development of high-yield strains of wheat, corn and rice during the 1960s and early 1970s. It was more formally known as the Indicative World Plan for Agricultural Development. The revolution came after the Food and Agricultural Organization held the World Food Congress in 1963. A \"Freedom from Hunger\" campaign was set up with the goal of increasing food supplies and solving the world's hunger problems."@en ;
    skos:prefLabel "green revolution"@en .

<http://www.eionet.europa.eu/gemet/concept/3771> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8920> ;
    skos:definition "A vegetable having the edible parts rich in chlorophyll and forming an important source of vitamins and micronutrients."@en ;
    skos:prefLabel "green vegetable"@en .

<http://www.eionet.europa.eu/gemet/concept/3774> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "To reduce to powder or small fragments."@en ;
    skos:prefLabel "grinding"@en .

<http://www.eionet.europa.eu/gemet/concept/3777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11034> ;
    skos:definition "Gross domestic product adjusted for foreign transactions, i.e. to the figure for Gross Domestic Product must be added any income accruing to residents of the country arising from investment and other factor earnings abroad and from it must be deducted any income earned in the domestic market by factors owned by foreigners abroad."@en ;
    skos:prefLabel "gross national product"@en .

<http://www.eionet.europa.eu/gemet/concept/378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Addition of ammonia or ammonia compounds, especially to the soil."@en ;
    skos:prefLabel "ammonification"@en .

<http://www.eionet.europa.eu/gemet/concept/3780> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9232> ;
    skos:definition "Water that occupies pores and crevices in rock and soil, below the surface and above a layer of impermeable material. It is free to move gravitationally, either downwards towards the impermeable layer or by following a gradient."@en ;
    skos:prefLabel "groundwater"@en .

<http://www.eionet.europa.eu/gemet/concept/3781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9169> ;
    skos:definition "The process, deliberate or inadvertent, of extracting ground water from a source at a rate so in excess of the replenishment that the ground water level declines persistently, threatening exhaustion of the supply or at least a decline of pumping levels to uneconomic depths."@en ;
    skos:prefLabel "groundwater extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/3784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3493> ;
    skos:definition "Contamination of any water found under the earth's surface by any leaching pollutants, such as inorganic compounds (chlorides, nitrates, heavy metals, etc.), synthetic organic chemicals (pesticides, fertilizers, etc.) and pathogens (bacteria, parasites, etc.)."@en ;
    skos:prefLabel "groundwater pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/3785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9206> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the environmental integrity of fresh water found beneath the earth's surface, usually in aquifers, which supply wells and springs."@en ;
    skos:prefLabel "groundwater protection"@en .

<http://www.eionet.europa.eu/gemet/concept/379> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "The radical NH4+."@en ;
    skos:prefLabel "ammonium"@en .

<http://www.eionet.europa.eu/gemet/concept/38> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2588> ;
    skos:definition "A rechargeable device for storing electrical energy in the form of chemical energy, consisting of one or more separate secondary cells."@en ;
    skos:prefLabel "accumulator"@en .

<http://www.eionet.europa.eu/gemet/concept/3806> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "A colourless or white mineral used in the building industry and in the manufacture of cement, rubber, paper and plaster of Paris."@en ;
    skos:prefLabel "gypsum"@en .

<http://www.eionet.europa.eu/gemet/concept/3810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The branch of medical science concerned with diseases of the blood."@en ;
    skos:prefLabel "haematology"@en .

<http://www.eionet.europa.eu/gemet/concept/3812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "Precipitation in the form of balls or irregular lumps of ice, always produced by convective clouds, nearly always cumulonimbus."@en ;
    skos:prefLabel "hail"@en .

<http://www.eionet.europa.eu/gemet/concept/3815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The time required for one-half the atoms of a given amount of radioactive material to undergo radioactive decay."@en ;
    skos:prefLabel "half-life"@en .

<http://www.eionet.europa.eu/gemet/concept/3817> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A haloalkane, containing three halogen atoms, e.g. iodoform, CHI3; a haloform reaction is a reaction to produce haloforms from a ketone. For example, if propanone is treated with bleaching powder, the chlorinated ketone so formed reacts to form chloroform."@en ;
    skos:prefLabel "haloform"@en .

<http://www.eionet.europa.eu/gemet/concept/3822> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5902> ;
    skos:definition "An organic compound bonded with one of the five halogen elements (astatine, bromine, chlorine, fluorine, and iodine). Several of these compounds contribute to reductions in the concentration of ozone in the stratosphere."@en ;
    skos:prefLabel "halogenated pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/3828> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3830> ;
    skos:definition "The profession, commercial firm or trade involving the production and distribution of articles that are made through the skilled use of one's hands."@en ;
    skos:prefLabel "handicraft business"@en .

<http://www.eionet.europa.eu/gemet/concept/3837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "Resistance of a solid to indentation, scratching, abrasion or cutting."@en ;
    skos:prefLabel "hardness"@en .

<http://www.eionet.europa.eu/gemet/concept/3838> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded material, often hazardous or in large volume, for which there is no obvious disposal route."@en ;
    skos:prefLabel "hard-to-dispose-of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/3842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "The impairment of the quality of some medium due to the introduction of spent or used water from a community or industry."@en ;
    skos:prefLabel "waste water pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/3847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13290> ;
    skos:definition "The process by which two or more states, sometimes under the auspices of an interstate or international organization, change their legislation relevant to some area of common concern to conform their statutes and to facilitate compliance and enforcement across borders."@en ;
    skos:prefLabel "harmonisation of law"@en .

<http://www.eionet.europa.eu/gemet/concept/3849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:definition "The amount or measure of the crop gathered in a season."@en ;
    skos:prefLabel "harvest"@en .

<http://www.eionet.europa.eu/gemet/concept/3855> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4247> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the production, use or clean-up of materials that pose a threat to human health and the environment, particularly materials that are toxic, corrosive, ignitable, explosive or chemically reactive."@en ;
    skos:prefLabel "hazardous substances legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/3857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Disposal facilities where hazardous waste is placed in or on land. Properly designed and operated landfills are lined to prevent leakage and contain systems to collect potentially contaminated surface water run-off."@en ;
    skos:prefLabel "hazardous waste dump"@en .

<http://www.eionet.europa.eu/gemet/concept/3858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any waste or combination of wastes with the potential to damage human health, living organisms or the environment. Hazardous wastes usually require special handling and disposal procedures which are regulated by national and international laws."@en ;
    skos:prefLabel "hazardous waste"@en .

<http://www.eionet.europa.eu/gemet/concept/3859> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3854> ;
    skos:definition "A poison, corrosive agent, flammable substance, explosive, radioactive chemical, or any other material which can endanger human health or well-being if handled improperly."@en ;
    skos:prefLabel "hazardous working material"@en .

<http://www.eionet.europa.eu/gemet/concept/3860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "Reduced visibility in the air as a result of condensed water vapour, dust, etc., in the atmosphere."@en ;
    skos:prefLabel "haze"@en .

<http://www.eionet.europa.eu/gemet/concept/3864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "A strip of land left at the end of a furrow in a field in order to facilitate the turning of the plough."@en ;
    skos:prefLabel "headland (farm)"@en .

<http://www.eionet.europa.eu/gemet/concept/3878> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by government or management to promote or protect the soundness of human bodies and minds in the workplace, at home or in the general environment."@en ;
    skos:prefLabel "health regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition "An open-air entertainment area consisting of stalls, side shows etc."@en ;
    skos:prefLabel "amusement park"@en .

<http://www.eionet.europa.eu/gemet/concept/3880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/898> ;
    skos:definition "Health-related biotechnologies are concerned with large-molecule protein pharmaceuticals, genetic engineering, etc."@en ;
    skos:prefLabel "health-related biotechnology"@en .

<http://www.eionet.europa.eu/gemet/concept/3881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The supply of health care to the public."@en ;
    skos:prefLabel "health service"@en .

<http://www.eionet.europa.eu/gemet/concept/3884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4325> ;
    skos:definition "A decrease in strength or any abnormality or partial or complete loss of hearing or of the function of ear, or hearing system, due directly  or secondarily to pathology or injury; it may be either temporary or permanent."@en ;
    skos:prefLabel "hearing impairment"@en .

<http://www.eionet.europa.eu/gemet/concept/3885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "Any prescribed course or mode of action governing the preliminary examination by a magistrate of basic evidence and charges to determine whether criminal proceedings, a trial or other judicial actions are justified."@en ;
    skos:prefLabel "hearing procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/3886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6753> ;
    skos:definition "The total of measures and devices implemented to preserve persons from harm to the faculty of perceiving sound."@en ;
    skos:prefLabel "hearing protection"@en .

<http://www.eionet.europa.eu/gemet/concept/3890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A form of energy that is transferred by a difference in temperature: it is equal to the total kinetic energy of the atoms or molecules of a system."@en ;
    skos:prefLabel "heat (physics)"@en .

<http://www.eionet.europa.eu/gemet/concept/3891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Power station which produces both electricity and hot water for the local population. A CHP (Combined Heat and Power Station) plant may operate on almost any fuel, including refuse."@en ;
    skos:prefLabel "heat and power station"@en .

<http://www.eionet.europa.eu/gemet/concept/3892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "An apparatus that heats or provides heat."@en ;
    skos:prefLabel "heater"@en .

<http://www.eionet.europa.eu/gemet/concept/3893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "An area with poor acid soil, typically dominated by ling (Calluna) or heaths (Erica)."@en ;
    skos:prefLabel "heathland"@en .

<http://www.eionet.europa.eu/gemet/concept/3894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "A system for supplying heat, especially central heating, to a building."@en ;
    skos:prefLabel "heating"@en .

<http://www.eionet.europa.eu/gemet/concept/3904> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "A device which transfers heat from a cooler reservoir to a hotter one, expending mechanical energy in the process, especially when the main purpose is to heat the hot reservoir rather than refrigerate the cold one."@en ;
    skos:prefLabel "heat pump"@en .

<http://www.eionet.europa.eu/gemet/concept/3906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2744> ;
    skos:definition "Keeping heat created during a period of low consumption until a peak period when it is needed."@en ;
    skos:prefLabel "heat storage"@en .

<http://www.eionet.europa.eu/gemet/concept/391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "A mode of life carried on in the absence of molecular oxygen."@en ;
    skos:prefLabel "anaerobic condition"@en .

<http://www.eionet.europa.eu/gemet/concept/3911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3481> ;
    skos:definition "Traffic of large motor vehicles designed to carry heavy loads."@en ;
    skos:prefLabel "heavy goods vehicle traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/3914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "The amount of stress put on an ecosystem by heavy metal pollution released into it."@en ;
    skos:prefLabel "heavy metal load"@en .

<http://www.eionet.europa.eu/gemet/concept/3915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5184> ;
    skos:definition "A metal whose specific gravity is approximately 5.0 or higher."@en ;
    skos:prefLabel "heavy metal"@en .

<http://www.eionet.europa.eu/gemet/concept/3917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8815> ;
    skos:definition "A line of closely planted bushes or shrubs, marking the boundaries of a field. The type of hedge varies between parts of the country, and its age can be dated from the number of species of tree and shrub present. Over the last thirty years hedge-row removal has had a marked visual effect on lowland agricultural landscapes. From the farmer's point of view, in areas of predominant arable or intensively managed grazing, there is little or no economic justification for retaining hedges."@en ;
    skos:prefLabel "hedge"@en .

<http://www.eionet.europa.eu/gemet/concept/3933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "A chemical that controls or destroys undesirable plants."@en ;
    skos:prefLabel "herbicide"@en .

<http://www.eionet.europa.eu/gemet/concept/3935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8683> ;
    skos:definition "An animal that feeds on grass and other plants."@en ;
    skos:prefLabel "herbivore"@en .

<http://www.eionet.europa.eu/gemet/concept/3945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Study beyond secondary school at an institution that offers programs terminating in undergraduate and graduate degrees."@en ;
    skos:prefLabel "higher education"@en .

<http://www.eionet.europa.eu/gemet/concept/3947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting systems of the biological communities and their non-living surroundings in regions of relatively high elevation, typically characterized by decreased air pressure and temperature, reduced oxygen availability and increased isolation."@en ;
    skos:prefLabel "highland ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/3949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5401> ;
    skos:prefLabel "high mountain"@en .

<http://www.eionet.europa.eu/gemet/concept/3953> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5765> ;
    skos:prefLabel "high protein food"@en .

<http://www.eionet.europa.eu/gemet/concept/3954> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "Any tall, multistoried structure or edifice that is equipped with elevators."@en ;
    skos:prefLabel "high-rise building"@en .

<http://www.eionet.europa.eu/gemet/concept/3955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6942> ;
    skos:definition "The term \"high-speed traffic\" encompasses all trains running at speeds over 200 km/h but also trains running at 200 km/h if the terrain, population density or economic reasons do not justify higher speeds."@en ;
    skos:prefLabel "high-speed railway"@en .

<http://www.eionet.europa.eu/gemet/concept/3956> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8606> ;
    skos:definition "Trains travelling at maximum speeds of 300kmh on special high-speed rail lines."@en ;
    skos:prefLabel "high-speed train"@en .

<http://www.eionet.europa.eu/gemet/concept/3958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8478> ;
    skos:definition "The level of water when the tide is at its highest level."@en ;
    skos:prefLabel "high tide water"@en .

<http://www.eionet.europa.eu/gemet/concept/3960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2599> ;
    skos:definition "An electric line with a voltage on the order of thousands of volts."@en ;
    skos:prefLabel "high voltage line"@en .

<http://www.eionet.europa.eu/gemet/concept/3963> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "A public road especially an important road that joins cities or towns together."@en ;
    skos:prefLabel "highway"@en .

<http://www.eionet.europa.eu/gemet/concept/3966> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:definition "A natural elevation of the land surface, rising rather prominently above the surrounding land, usually of limited extent and having a well-defined outline, rounded rather than peaked or rugged, with no specific definition of absolute elevation."@en ;
    skos:prefLabel "hill"@en .

<http://www.eionet.europa.eu/gemet/concept/3971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "The process by which small but cumulative changes in the learned, nonrandom, systematic behavior and knowledge of a people occur from generation to generation."@en ;
    skos:prefLabel "historical evolution"@en .

<http://www.eionet.europa.eu/gemet/concept/3974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Monument built in memory of an historical event."@en ;
    skos:prefLabel "historical monument"@en .

<http://www.eionet.europa.eu/gemet/concept/3975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "The study of events in relation to their development over time."@en ;
    skos:prefLabel "historical research"@en .

<http://www.eionet.europa.eu/gemet/concept/3977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Place where significant historical events occurred and which is important to an indigenous culture or a community."@en ;
    skos:prefLabel "historical site"@en .

<http://www.eionet.europa.eu/gemet/concept/398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:prefLabel "analysis programme"@en .

<http://www.eionet.europa.eu/gemet/concept/3983> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "A systematic written account comprising a chronological record of events (as affecting a city, state, nation, institution, science, or art) and usually including a philosophical explanation of the cause and origin of such events."@en ;
    skos:prefLabel "history"@en .

<http://www.eionet.europa.eu/gemet/concept/3984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13550> ;
    skos:definition "A place providing accommodation, recreational facilities, etc. for holiday-makers."@en ;
    skos:prefLabel "holiday camp"@en .

<http://www.eionet.europa.eu/gemet/concept/3986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition """1) A period in which a break is taken from work or studies for rest, travel or recreation
2) A day on which work is suspended by law or custom, such as a religious festival, bank holiday, etc."""@en ;
    skos:prefLabel "holiday"@en .

<http://www.eionet.europa.eu/gemet/concept/399> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "The branch of chemistry dealing with techniques which yield any type of information about chemical systems."@en ;
    skos:prefLabel "analytical chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/3995> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2955> ;
    skos:definition "A large animal with four legs which people ride on or use for carrying things or pulling vehicles."@en ;
    skos:prefLabel "horse"@en .

<http://www.eionet.europa.eu/gemet/concept/3998> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "The art and science of growing plants."@en ;
    skos:prefLabel "horticulture"@en .

<http://www.eionet.europa.eu/gemet/concept/3999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3871> ;
    skos:definition "A place where people who are ill or injured are treated and taken care of by doctors and nurses."@en ;
    skos:prefLabel "hospital"@en .

<http://www.eionet.europa.eu/gemet/concept/4008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14960> ;
    skos:definition "The industry related with the provision of lodging and usually meals and other services for travelers and other paying guests."@en ;
    skos:prefLabel "hotel industry"@en .

<http://www.eionet.europa.eu/gemet/concept/4009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:prefLabel "hot water"@en .

<http://www.eionet.europa.eu/gemet/concept/4015> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:definition "A group of persons sharing a home or living space, who aggregate and share their incomes, as evidenced by the fact that they regularly take meals together."@en ;
    skos:prefLabel "household"@en .

<http://www.eionet.europa.eu/gemet/concept/4016> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:prefLabel "household chemical"@en .

<http://www.eionet.europa.eu/gemet/concept/4018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "Goods needed for living in a household."@en ;
    skos:prefLabel "household goods"@en .

<http://www.eionet.europa.eu/gemet/concept/402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088> ;
    skos:prefLabel "analytical method"@en .

<http://www.eionet.europa.eu/gemet/concept/4027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "The number of dwelling units or the residential population of a given geographic area."@en ;
    skos:prefLabel "housing density"@en .

<http://www.eionet.europa.eu/gemet/concept/4029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3205> ;
    skos:prefLabel "housing finance"@en .

<http://www.eionet.europa.eu/gemet/concept/4030> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4022> ;
    skos:definition "An addition, renovation or repair to a place of residence that increases its aesthetic, functional or financial value."@en ;
    skos:prefLabel "housing improvement"@en .

<http://www.eionet.europa.eu/gemet/concept/4034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5555> ;
    skos:prefLabel "housing need"@en .

<http://www.eionet.europa.eu/gemet/concept/4037> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8794> ;
    skos:definition "A planned system of projects, services or activities intended to support individuals or families in need of shelter, including transitional or permanent housing and safe havens for low-income, elderly or homeless populations."@en ;
    skos:prefLabel "housing programme"@en .

<http://www.eionet.europa.eu/gemet/concept/4039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11429> ;
    skos:definition "A norm or measure applicable in legal cases and considered to reflect a relatively high grade or level of excellence in the construction, maintenance, operation, occupancy, use or appearance of dwelling units."@en ;
    skos:prefLabel "housing quality standard"@en .

<http://www.eionet.europa.eu/gemet/concept/404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "A family of waterfowl, including ducks, gees, mergansers, pochards and swans, in the order Anseriformes."@en ;
    skos:prefLabel "swans, geese and ducks"@en .

<http://www.eionet.europa.eu/gemet/concept/4045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The study of human life and character."@en ;
    skos:prefLabel "human biology"@en .

<http://www.eionet.europa.eu/gemet/concept/4047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The study of the growth, distribution, and organization of human communities relative to their interrelationships with other humans and other species and with their environment."@en ;
    skos:prefLabel "human ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/4051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:definition "The avoidance of disease and injury and the promotion of normalcy through efficient use of the environment, a properly functioning society, and an inner sense of well-being."@en ;
    skos:prefLabel "human health"@en .

<http://www.eionet.europa.eu/gemet/concept/4054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6066> ;
    skos:definition "Branch of medicine concerned with the cause, origin, and nature of disease, including the changes occurring as a result of disease."@en ;
    skos:prefLabel "human pathology"@en .

<http://www.eionet.europa.eu/gemet/concept/4055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6240> ;
    skos:definition "A branch of biological sciences that studies the functions of organs and tissues in human beings."@en ;
    skos:prefLabel "human physiology"@en .

<http://www.eionet.europa.eu/gemet/concept/4070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7866> ;
    skos:definition "The more or less decomposed organic matter in the soil. Besides being the source of most of the mineral salts needed by plants, humus improves the texture of the soil and holds water, so reducing the loss of nutrients by leaching."@en ;
    skos:prefLabel "humus"@en .

<http://www.eionet.europa.eu/gemet/concept/4072> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "The pursuit and killing or capture of wild animals, regarded as a sport."@en ;
    skos:prefLabel "hunting"@en .

<http://www.eionet.europa.eu/gemet/concept/4073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7003> ;
    skos:definition "Area of land where the pursuit and killing or capture of game and wild animals is permitted."@en ;
    skos:prefLabel "hunting reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/4077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A tropical cyclone of great intensity; any wind reaching a speed of more than 73 miles per hour (117 kilometers per hour) is said to have hurricane force."@en ;
    skos:prefLabel "hurricane"@en .

<http://www.eionet.europa.eu/gemet/concept/4080> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7120> ;
    skos:definition "The act or process of producing hybrids that is an animal or plant resulting from a cross between genetically unlike individuals. Hybrids between different species are usually sterile."@en ;
    skos:prefLabel "hybridisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "A branch of civil engineering concerned with the design, erection, and construction of sewage disposal plants, waterworks, dams, water-operated power plants and such."@en ;
    skos:prefLabel "hydraulic engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/4085> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The branch of science and technology concerned with the mechanics of fluids, especially liquids."@en ;
    skos:prefLabel "hydraulics"@en .

<http://www.eionet.europa.eu/gemet/concept/4088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "Study of organisms living in water."@en ;
    skos:prefLabel "hydrobiology"@en .

<http://www.eionet.europa.eu/gemet/concept/4094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350>,
        <http://www.eionet.europa.eu/gemet/concept/52> ;
    skos:definition "A solution of hydrogen chloride gas in water; a poisonous, pungent liquid forming a constant-boiling mixture at 20% concentration in water; widely used as a reagent, in organic synthesis, in acidizing oil wells, ore reduction, food processing, and metal cleaning and pickling. Also known as muriatic acid."@en ;
    skos:prefLabel "hydrochloric acid"@en .

<http://www.eionet.europa.eu/gemet/concept/4095> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Growing plants without soil but in sand or vermiculite or other granular material, using a liquid solution of nutrients to feed them."@en ;
    skos:prefLabel "hydroculture"@en .

<http://www.eionet.europa.eu/gemet/concept/4098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power station which operates with the free renewable source of energy provided by falling water."@en ;
    skos:prefLabel "hydroelectric power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/4107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8192> ;
    skos:definition "Flammable, poisonous gas with characteristic odour of rotten eggs, perceptible in air in a dilution of 0.002 mg/l. It is used as a reagent in chemical analysis; extremely hazardous; collapse, coma and death from respiratory failure may come within a few seconds after one or two inspirations; low concentrations produce irritation of conjunctiva and mucous membranes. Headache, dizziness, nausea, lassitude may appear after exposure."@en ;
    skos:prefLabel "hydrogen sulphide"@en .

<http://www.eionet.europa.eu/gemet/concept/4108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "The science dealing with the occurrence of surface and ground water, its utilization, and its functions in modifying the earth, primarily by erosion and deposition."@en ;
    skos:prefLabel "hydrogeology"@en .

<http://www.eionet.europa.eu/gemet/concept/4109> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "Science which deals with the measurement and description of the physical features of the oceans, lakes, rivers, and their adjoining coastal areas, with particular reference to their control and utilization."@en ;
    skos:prefLabel "hydrography"@en .

<http://www.eionet.europa.eu/gemet/concept/4111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5496> ;
    skos:definition "Violent, sudden and destructive change either in the quality of the earth's water or in the distribution or movement of water on land, below the surface or in the atmosphere."@en ;
    skos:prefLabel "hydrologic disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/4118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9231> ;
    skos:definition "The science that treats the occurrence, circulation, distribution, and properties of the waters of the earth, and their reaction with the environment."@en ;
    skos:prefLabel "hydrology"@en .

<http://www.eionet.europa.eu/gemet/concept/4119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition """1) Decomposition or alteration of a chemical substance by water. 
2) In aqueous solutions of electrolytes, the reactions of cations with water to produce a weak base or of anions to produce a weak acid."""@en ;
    skos:prefLabel "hydrolysis"@en .

<http://www.eionet.europa.eu/gemet/concept/412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3256> ;
    skos:definition "The art or sport of catching fish with a rod and line and a baited hook or other lure, such as a fly."@en ;
    skos:prefLabel "angling"@en .

<http://www.eionet.europa.eu/gemet/concept/4120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5197> ;
    skos:definition "That part of meteorology of direct concern to hydrologic problems, particularly to flood control, hydroelectric power, irrigation, and similar fields of engineering and water resource."@en ;
    skos:prefLabel "hydrometeorology"@en .

<http://www.eionet.europa.eu/gemet/concept/4131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:definition "The dense substance formed by the freezing of water to the solid state; it commonly occurs in the form of hexagonal crystals."@en ;
    skos:prefLabel "ice"@en .

<http://www.eionet.europa.eu/gemet/concept/4132> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4133> ;
    skos:definition "A large mass of detached land ice floating in the sea or stranded in shallow water."@en ;
    skos:prefLabel "iceberg"@en .

<http://www.eionet.europa.eu/gemet/concept/4136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6425> ;
    skos:definition "The determination of the specific substance or substances that are causing pollution."@en ;
    skos:prefLabel "identification of pollutants"@en .

<http://www.eionet.europa.eu/gemet/concept/4137> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "A body of ideas that reflects the beliefs and interest of a nation, political system, etc. and underlies political action."@en ;
    skos:prefLabel "ideology"@en .

<http://www.eionet.europa.eu/gemet/concept/4141> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1542> ;
    skos:definition "Codes published by Intergovernmental Maritime Consultative Organisation (IMCO) relating to international shipping, particularly regarding safety and marine pollution."@en ;
    skos:prefLabel "IMCO code"@en .

<http://www.eionet.europa.eu/gemet/concept/4143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10660> ;
    skos:definition "One of the possible consequences of the introduction of animal species in an area where they are not indigenous. Such translocation of species always involves an element of risk if not of serious danger. Newly arrived species may be highly competitive with or otherwise adversely affect native species and communities."@en ;
    skos:prefLabel "bastardisation of fauna"@en .

<http://www.eionet.europa.eu/gemet/concept/4144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10661> ;
    skos:definition "One of the possible consequences of the introduction of plant species in an area where they are not indigenous."@en ;
    skos:prefLabel "bastardisation of flora"@en .

<http://www.eionet.europa.eu/gemet/concept/4147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2795> ;
    skos:definition "Legislative and administrative procedures aimed at reducing the damage caused by emissions. Pollution control programmes are normally based on human-oriented acceptable dose limits. A very important measure concerns the organisation of an emission inventory."@en ;
    skos:prefLabel "immission control"@en .

<http://www.eionet.europa.eu/gemet/concept/4148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4752> ;
    skos:prefLabel "immission control law"@en .

<http://www.eionet.europa.eu/gemet/concept/4149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Damage caused by pollution from a distinct source of emission."@en ;
    skos:prefLabel "immission damage"@en .

<http://www.eionet.europa.eu/gemet/concept/4150> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "The prediction of immissions is calculated on the basis of the pollutant load, the source height, the wind speed and the dispersion coefficient."@en ;
    skos:prefLabel "immission forecast"@en .

<http://www.eionet.europa.eu/gemet/concept/4151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Maximum levels of selected pollutants which would lead to unacceptable air quality."@en ;
    skos:prefLabel "immission limit"@en .

<http://www.eionet.europa.eu/gemet/concept/4152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "The total amount of immissions introduced in a given environment."@en ;
    skos:prefLabel "immission load"@en .

<http://www.eionet.europa.eu/gemet/concept/4155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:definition "The ability of an organism to resist disease or toxins by natural or artificial means."@en ;
    skos:prefLabel "immunity"@en .

<http://www.eionet.europa.eu/gemet/concept/4156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13077> ;
    skos:definition "Any of several methods for the quantitative determination of chemical substances such as hormones, drugs, and certain proteins that utilize the highly specific binding between an antigen and an antibody."@en ;
    skos:prefLabel "immunoassay"@en .

<http://www.eionet.europa.eu/gemet/concept/4157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "The disruption of the complex system of interacting cells, cell products and cell-forming tissues that protects the body from pathogens, destroys infected and malignant cells and removes cellular debris."@en ;
    skos:prefLabel "immunological disease"@en .

<http://www.eionet.europa.eu/gemet/concept/4158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "A branch of biological science concerned with the native or acquired resistance of higher animal forms and humans to infection with microorganisms."@en ;
    skos:prefLabel "immunology"@en .

<http://www.eionet.europa.eu/gemet/concept/4161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/401> ;
    skos:definition "Instrument which samples atmospheric suspensoids by impaction; such instruments consist of a housing which constrains the air flow past a sensitized sampling plate."@en ;
    skos:prefLabel "impactor"@en .

<http://www.eionet.europa.eu/gemet/concept/4162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2914> ;
    skos:definition "Precautionary measures, actions or installations implemented to avert negative effects on the environment."@en ;
    skos:prefLabel "impact prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/4164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1590> ;
    skos:prefLabel "implementation law"@en .

<http://www.eionet.europa.eu/gemet/concept/4167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "The act of bringing goods and merchandise into a country from a foreign country."@en ;
    skos:prefLabel "import"@en .

<http://www.eionet.europa.eu/gemet/concept/4171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:prefLabel "impoverishment"@en .

<http://www.eionet.europa.eu/gemet/concept/4172> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A material used to fill holes in wood, plaster, or other surfaces before applying a coating such as paint or varnish."@en ;
    skos:prefLabel "impregnating agent"@en .

<http://www.eionet.europa.eu/gemet/concept/4173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The forcing of a liquid substance into the spaces of a porous solid in order to change its properties, as the impregnation of wood with creosote to preserve its integrity against water damage."@en ;
    skos:prefLabel "impregnation (materials)"@en .

<http://www.eionet.europa.eu/gemet/concept/4176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13291> ;
    skos:definition "The beneficial development or progress in the volume of output that is achieved in terms of productivity and input, or in getting the maximum possible output from given or allocated resources."@en ;
    skos:prefLabel "improvement of efficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/4177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228>,
        <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "Sudden immission in considerable amount of one or more pollutants in the atmosphere, in a water body or in the soil."@en ;
    skos:prefLabel "sudden load"@en .

<http://www.eionet.europa.eu/gemet/concept/4178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Noise characterized by transient short-duration disturbances distributed essentially uniformly over the useful passband of a transmission system."@en ;
    skos:prefLabel "impulsive noise"@en .

<http://www.eionet.europa.eu/gemet/concept/4186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "The inclined surface of any part of the Earth's surface, as a hillslope; also, a broad part of a continent descending toward an ocean, as the Pacific slope."@en ;
    skos:prefLabel "slope"@en .

<http://www.eionet.europa.eu/gemet/concept/4189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "incorporation"@en .

<http://www.eionet.europa.eu/gemet/concept/419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Excrement from animals that may be dried and burned to generate energy or converted to liquid or gaseous fuels, such as methane, through chemical processes."@en ;
    skos:prefLabel "animal dung as fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/4194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "Financial compensation, reimbursement or security for damages or loss offered by a government, insurance policy or contractual agreement under specified conditions and for specific casualties."@en ;
    skos:prefLabel "indemnity"@en .

<http://www.eionet.europa.eu/gemet/concept/4195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "A body of water between the continents of Africa, Antarctica, Asia and Australia including the Bay of Bengal in the east and the Arabian Sea (with the Red Sea, the Gulf of Aden and the Persian Gulf) in the west, and containing several islands and island chains, such as the Andaman, Nicobar and Seychelles."@en ;
    skos:prefLabel "Indian Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/42> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2084> ;
    skos:definition "A type of pollution which washes out of the atmosphere as dilute sulphuric and nitric acids. It tends to be a regional rather than a global phenomenon, linked to particular industrial activities and meteorological conditions. It includes rain, more than normally acidic snow, mist, sleet, fog, gas and dry particles. It upsets the balance of nature, disrupting ecosystems, and destroys forests and woodlands, plants and crops; kills aquatic life by altering the chemical balance of lakes and rivers and corrodes building materials and fabrics. The pollutants are caused principally by discharges from power station chimneys of sulphur dioxide and nitrogen oxides released by burning fossil fuels, coal and oil."@en ;
    skos:prefLabel "acid deposition"@en .

<http://www.eionet.europa.eu/gemet/concept/420> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "A study of the relationships of animals to their environment."@en ;
    skos:prefLabel "animal ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/4200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:prefLabel "indicator of environmental management"@en .

<http://www.eionet.europa.eu/gemet/concept/4202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2847> ;
    skos:definition "Qualitative or quantitative parameter used as a measure of an environmental condition, e.g. of air or water quality."@en ;
    skos:prefLabel "indicator of environmental quality"@en .

<http://www.eionet.europa.eu/gemet/concept/4204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "Forests which are native to a given area."@en ;
    skos:prefLabel "indigenous forest"@en .

<http://www.eionet.europa.eu/gemet/concept/4205> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Technologies employed by the native inhabitants of a country and which constitute an important part of its cultural heritage and should therefore be protected against exploitation by industrialized countries; the problem of indigenous knowledge has been discussed during the Rio Conference but it does not receive much protection under the Biodiversity Convention. Article 8 mandates that parties \"respect, preserve and maintain knowledge, innovations and practices of indigenous and local communities embodying traditional life styles... and promote their wider application with the approval and involvement of holders of such knowledge, innovations and practices and encourage the equitable sharing of benefits arising from them\"."@en ;
    skos:prefLabel "indigenous technology"@en .

<http://www.eionet.europa.eu/gemet/concept/4206> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A non-domestic source introducing pollutants into a publicly owned waste-treatment system. Indirect dischargers can be commercial or industrial facilities whose wastes enter local sewers."@en ;
    skos:prefLabel "indirect discharger"@en .

<http://www.eionet.europa.eu/gemet/concept/4209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/265> ;
    skos:definition "Chemical, physical or biological contaminants in the air inside buildings and other enclosed spaces occupied by humans. This pollution can arise from tobacco smoke, pesticides, cleaning agents, gases released from building materials, rugs, household products, etc."@en ;
    skos:prefLabel "indoor air pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4571> ;
    skos:definition "Investigation carried out in animals for research purposes."@en ;
    skos:prefLabel "animal experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/4211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Environment situated in the inside of a house or other building."@en ;
    skos:prefLabel "indoor environment"@en .

<http://www.eionet.europa.eu/gemet/concept/4216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/607> ;
    skos:prefLabel "industrial association"@en .

<http://www.eionet.europa.eu/gemet/concept/4217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "A building directly used in manufacturing or technically productive enterprises. Industrial buildings are not generally or typically accessible to other than workers. Industrial buildings include buildings used directly in the production of power, the manufacture of products, the mining of raw materials, and the storage of textiles, petroleum products, wood and paper products, chemicals, plastics, and metals."@en ;
    skos:prefLabel "industrial building"@en .

<http://www.eionet.europa.eu/gemet/concept/4224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/219> ;
    skos:definition "Any crop that provides materials for industrial processes and products such as soybeans, cotton (lint and seed), flax, and tobacco."@en ;
    skos:prefLabel "industrial crop"@en .

<http://www.eionet.europa.eu/gemet/concept/4226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4253> ;
    skos:prefLabel "industrial development"@en .

<http://www.eionet.europa.eu/gemet/concept/4227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "The disposal of any waste generated by a manufacturing or processing process by the agency or body which produced it."@en ;
    skos:prefLabel "industrial dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/4228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The production, distribution, and consumption of goods and services resulting from all manufacturing business."@en ;
    skos:prefLabel "industrial economics"@en .

<http://www.eionet.europa.eu/gemet/concept/4229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2571> ;
    skos:definition "Materials generally discarded from industrial operations or derived from manufacturing processes."@en ;
    skos:prefLabel "industrial effluent"@en .

<http://www.eionet.europa.eu/gemet/concept/4231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "Gas-borne pollutants discharged into the atmosphere from smokestacks of industrial plants."@en ;
    skos:prefLabel "industrial emission"@en .

<http://www.eionet.europa.eu/gemet/concept/4238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3518> ;
    skos:definition "Any smokelike or vaporous exhalation from matters or substances, especially of an odorous or harmful nature, which result from trading, commercial or manufacturing processes."@en ;
    skos:prefLabel "industrial fume"@en .

<http://www.eionet.europa.eu/gemet/concept/4244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4253> ;
    skos:definition "The process whereby manufacturing industry comes to occupy the predominant position in a national or regional economy."@en ;
    skos:prefLabel "industrialisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4249> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:prefLabel "industrial material"@en .

<http://www.eionet.europa.eu/gemet/concept/425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3633> ;
    skos:definition "The scientific study of the hereditary material of animals for theoretical and practical applications such as increased population, conservation and disease research."@en ;
    skos:prefLabel "animal genetics"@en .

<http://www.eionet.europa.eu/gemet/concept/4251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise produced by industrial plants activities."@en ;
    skos:prefLabel "industrial noise"@en .

<http://www.eionet.europa.eu/gemet/concept/4256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution as a result of industrial processes and manufacturing."@en ;
    skos:prefLabel "industrial pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/4258> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10099> ;
    skos:definition "Any process of converting or transforming raw materials and other resources into goods or services which have value."@en ;
    skos:prefLabel "industrial production"@en .

<http://www.eionet.europa.eu/gemet/concept/4259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:prefLabel "industrial production statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/4262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A justifiable claim granted by government or some other authority that offers protection or excludes others from making, using or selling an invention, a unique design of an article of manufacture or some other creation or discovery."@en ;
    skos:prefLabel "industrial property right"@en .

<http://www.eionet.europa.eu/gemet/concept/4268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:definition "Sludge produced as a result of industrial production processes or manufacturing."@en ;
    skos:prefLabel "industrial sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/4269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "A large-scale community with diverse manufacturing sectors and an infrastructure and economy based on the science, technology and instrumental rationality of the modern West."@en ;
    skos:prefLabel "industrial society"@en .

<http://www.eionet.europa.eu/gemet/concept/4274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9077> ;
    skos:definition "Waste gases resulting from manufacturing and other industrial processes which may be treated and released, treated and reused or released without treatment."@en ;
    skos:prefLabel "industrial waste gas"@en .

<http://www.eionet.europa.eu/gemet/concept/4276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Waste water that results from industrial processes and manufacturing. It may either be disposed of separately or become part of the sanitary or combined sewage."@en ;
    skos:prefLabel "industrial waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/4278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9417> ;
    skos:definition "A system of land use planning that forms zones or boundaries to be used only by manufacturing or business enterprises."@en ;
    skos:prefLabel "industrial zoning"@en .

<http://www.eionet.europa.eu/gemet/concept/428> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "Any kind of shelter, refuge affording protection to animals."@en ;
    skos:prefLabel "animal housing"@en .

<http://www.eionet.europa.eu/gemet/concept/4282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The process of waste inertisation includes solidification and stabilisation; stabilisation is the process used for reduction of hazard potential of the waste by converting the contaminants into their least soluble, least immobile, or least toxic form. Solidification physically binds or encapsulates the waste in a monolithic solid of high structural integrity. Thus solidification may be used for powders, liquids or gases."@en ;
    skos:prefLabel "inertisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Wastes that do not undergo any significant physical, chemical, or biological transformations when deposited in a landfill."@en ;
    skos:prefLabel "inert waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5371> ;
    skos:definition "The rate of deaths occurring in the first year of life for a given population."@en ;
    skos:prefLabel "infant mortality"@en .

<http://www.eionet.europa.eu/gemet/concept/4286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:definition "The entry and development or multiplication of an infectious agent in the body of a living organism."@en ;
    skos:prefLabel "infection"@en .

<http://www.eionet.europa.eu/gemet/concept/4289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "Invasion of crop by parasites. Among vertebrate animals, many crop pests are mammals, especially in the order of rodents and birds. Among invertebrates, certain species of gastropods and a large number of roundworms from the class of nematodes harm crops. The most varied and numerous species of crop pests are arthropods-insects, arachnids and some species of millipedes and crustaceans. Diseases vary from viral, bacterial, and nutritional to fungal, environmental and non-specific. The FAO has estimated that annual worldwide losses done by plant pests and diseases amount to approximately 20-25% of the potential worldwide yield of food crops."@en ;
    skos:prefLabel "infestation of crops"@en .

<http://www.eionet.europa.eu/gemet/concept/4290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "Food that has been contaminated and deteriorated by some kind of pest."@en ;
    skos:prefLabel "infestation of food"@en .

<http://www.eionet.europa.eu/gemet/concept/4296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Substance liable to catch fire."@en ;
    skos:prefLabel "inflammable substance"@en .

<http://www.eionet.europa.eu/gemet/concept/4300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3311> ;
    skos:definition """1) Water other than wastewater that enters a sewer system (including sewer service connections) from sources such as, but not limited to, roof leaders, cellars drains, yard drains, area drains, drains from springs and swampy areas, manhole covers, cross connections between storm sewers and sanitary sewers, catch basins, cooling towers, storm waters, surface runoff, street wash waters, or drainage. Inflow does not include, and is distinguished from, infiltration. 
2) Action of flowing in; an inflow of effluent into a river."""@en ;
    skos:prefLabel "inflow"@en .

<http://www.eionet.europa.eu/gemet/concept/4301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "informal negotiation"@en .

<http://www.eionet.europa.eu/gemet/concept/4309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1605> ;
    skos:definition "An organized system of providing assistance or aid to individuals who are seeking information, such as by using databases and other information sources to communicate or supply knowledge or factual data."@en ;
    skos:prefLabel "information service"@en .

<http://www.eionet.europa.eu/gemet/concept/4315> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:definition "A breach, violation, or infringement; as of a law, a contract, a right or duty."@en ;
    skos:prefLabel "infraction"@en .

<http://www.eionet.europa.eu/gemet/concept/4317> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5674>,
        <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Electron magnetic radiation whose wavelengths lie in the range from 0.75 or 0.8 micrometer to 1000 micrometers."@en ;
    skos:prefLabel "infrared radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/432> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5007> ;
    skos:definition "Animal excreta collected from stables and barnyards with or without litter; used to enrich the soil."@en ;
    skos:prefLabel "animal manure"@en .

<http://www.eionet.europa.eu/gemet/concept/4320> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7933> ;
    skos:definition "Vibrations of the air at frequencies too low to be perceived as sound by the human ear, below about 15 hertz."@en ;
    skos:prefLabel "infrasound"@en .

<http://www.eionet.europa.eu/gemet/concept/4323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "A person occupying a region, town, house, country, etc."@en ;
    skos:prefLabel "inhabitant"@en .

<http://www.eionet.europa.eu/gemet/concept/4326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A dispersion of a pigment or a solution of a dye in a carrier vehicle, yielding a fluid, paste, or powder to be applied to and dried on a substrate; writing, marking, drawing, and printing inks are applied by several methods to paper, metal, plastic, wood, glass, fabric, or other substrate."@en ;
    skos:prefLabel "ink"@en .

<http://www.eionet.europa.eu/gemet/concept/4329> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Fishing grounds located in lakes, streams, etc."@en ;
    skos:prefLabel "inland fishery"@en .

<http://www.eionet.europa.eu/gemet/concept/4331> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11289> ;
    skos:definition "The navigation of inland waterways, i.e. navigable rivers, canals, sounds, lakes, inlets, etc."@en ;
    skos:prefLabel "inland navigation"@en .

<http://www.eionet.europa.eu/gemet/concept/4333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "A lake, river, or other body of water wholly within the boundaries of a state."@en ;
    skos:prefLabel "inland water"@en .

<http://www.eionet.europa.eu/gemet/concept/434> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise caused by animals such as dogs kept in kennels or in private homes as pets."@en ;
    skos:prefLabel "animal noise"@en .

<http://www.eionet.europa.eu/gemet/concept/4342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "A branch of chemistry dealing with the chemical reactions and properties of all inorganic matter."@en ;
    skos:prefLabel "inorganic chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/4347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1318> ;
    skos:definition "A pollutant of mineral origin and not of basically carbon structure."@en ;
    skos:prefLabel "inorganic pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/435> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5765> ;
    skos:definition "Ingestion, digestion and/or assimilation of food by animals."@en ;
    skos:prefLabel "animal nutrition"@en .

<http://www.eionet.europa.eu/gemet/concept/4354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "Any chemical agent used to destroy invertebrate pests."@en ;
    skos:prefLabel "insecticide"@en .

<http://www.eionet.europa.eu/gemet/concept/4356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Any placental mammal of the order Insectivora, being typically small, with simple teeth, and feeding on invertebrates. The group includes shrews, moles, and hedgehogs."@en ;
    skos:prefLabel "insectivore"@en .

<http://www.eionet.europa.eu/gemet/concept/4359> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14848>,
        <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "In the natural or normal place."@en ;
    skos:prefLabel "in situ"@en .

<http://www.eionet.europa.eu/gemet/concept/4361> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4360> ;
    skos:prefLabel "inspection of records"@en .

<http://www.eionet.europa.eu/gemet/concept/4362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "An organization designated to look into, supervise and report upon, the staff members and workings of some institution or department, or the conforming to laws and regulations by a segment of society or other group."@en ;
    skos:prefLabel "inspection service"@en .

<http://www.eionet.europa.eu/gemet/concept/4363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11504> ;
    skos:definition "The official authorization needed to assemble and place into position any apparatus, facility, military post or machinery."@en ;
    skos:prefLabel "installation requiring approval"@en .

<http://www.eionet.europa.eu/gemet/concept/4365> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "The establishment and normalization of a law, custom, usage, practice, system or regulative principle in the activity or purpose of a group or organization."@en ;
    skos:prefLabel "institutionalisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5005> ;
    skos:prefLabel "instrument manufacture"@en .

<http://www.eionet.europa.eu/gemet/concept/437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6240> ;
    skos:definition "Study of the normal processes and metabolic functions of animal organisms."@en ;
    skos:prefLabel "animal physiology"@en .

<http://www.eionet.europa.eu/gemet/concept/4371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15020> ;
    skos:definition "Material used to reduce the transmission of sound to or from a body, device, room, etc."@en ;
    skos:prefLabel "sound insulation material"@en .

<http://www.eionet.europa.eu/gemet/concept/4375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4374> ;
    skos:definition "A commercial service which provides a guarantee against most losses or harm to a person, property or a firm in return for premiums paid."@en ;
    skos:prefLabel "insurance business"@en .

<http://www.eionet.europa.eu/gemet/concept/4376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4374> ;
    skos:definition "The protection provided against risks or a risk, often as specified by the type of protection or the item being protected."@en ;
    skos:prefLabel "insurance coverage"@en .

<http://www.eionet.europa.eu/gemet/concept/4378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5545> ;
    skos:definition "Areas allocated to preserve and protect certain animals and plants, or both. They differ from national parks, which are largely a place for public recreation, because they are provided exclusively to protect species for their own sake. Endangered species are increasingly being kept in nature reserves to prevent them from extinction. Nature reserves also serve as a place for more plentiful species to rest, breed or winter."@en ;
    skos:prefLabel "integral natural reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/4382> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Technologies that meet environmental objectives by incorporating pollution prevention concepts in their design. Integrated environmental control strategies introduced in the early design stages of a process, rather than an end-of-pipe control option introduced in the later stages, improve the technical and economic performance of a process."@en ;
    skos:prefLabel "integrated environmental protection technology"@en .

<http://www.eionet.europa.eu/gemet/concept/4383> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6139> ;
    skos:definition "A systematic, comprehensive approach to pest control that uses the insect's or rodent's own biology and behaviour to find the least toxic control methods at the lowest cost."@en ;
    skos:prefLabel "integrated pest control"@en .

<http://www.eionet.europa.eu/gemet/concept/4386> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6451> ;
    skos:definition "A procedure whereby all major emissions to land, air, and water are considered simultaneously and not in isolation to avoid situations in which one control measure for one medium adversely affects another."@en ;
    skos:prefLabel "integrated pollution control"@en .

<http://www.eionet.europa.eu/gemet/concept/4390> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "Specialized system of breeding animals where the livestock are kept indoors and fed on concentrated foodstuffs, with frequent use of drugs to control diseases which are a constant threat under these conditions."@en ;
    skos:prefLabel "intensive animal husbandry"@en .

<http://www.eionet.europa.eu/gemet/concept/4391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Farming in which as much use is made of the land as possible by growing crops close together or by growing several crops in a year or by using large amounts of fertilizers."@en ;
    skos:prefLabel "intensive farming"@en .

<http://www.eionet.europa.eu/gemet/concept/4395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/766> ;
    skos:definition "The enhancement of activity of pesticides when they are used in combination with others."@en ;
    skos:prefLabel "interaction of pesticides"@en .

<http://www.eionet.europa.eu/gemet/concept/4398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1984> ;
    skos:definition "A transference of binary coded information items between two or more computers across any communications channel capable of carrying electromagnetic signals."@en ;
    skos:prefLabel "interchange of electronic data"@en .

<http://www.eionet.europa.eu/gemet/concept/4400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "The utilisation, combination and coordination of two or more appropriate disciplines, technologies and humanities in an integrated approach toward environmental problems."@en ;
    skos:prefLabel "interdisciplinary research"@en .

<http://www.eionet.europa.eu/gemet/concept/4401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13177> ;
    skos:definition "A sum paid or charged for the use of money or for borrowing money over a given time period."@en ;
    skos:prefLabel "interest"@en .

<http://www.eionet.europa.eu/gemet/concept/4402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6594> ;
    skos:definition "A group of people who share common traits, attitudes, beliefs or objectives and who have formed a formal organization to serve specific concerns of the membership."@en ;
    skos:prefLabel "interest group"@en .

<http://www.eionet.europa.eu/gemet/concept/4404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:prefLabel "interim decision"@en .

<http://www.eionet.europa.eu/gemet/concept/4408> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Tests performed at the same time in different laboratories to validate the quality of the results."@en ;
    skos:prefLabel "interlaboratory comparison"@en .

<http://www.eionet.europa.eu/gemet/concept/441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/429> ;
    skos:prefLabel "animal production"@en .

<http://www.eionet.europa.eu/gemet/concept/4410> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "Partly finished goods or products that re-enter into production elsewhere."@en ;
    skos:prefLabel "intermediate goods"@en .

<http://www.eionet.europa.eu/gemet/concept/4412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Noise occurring at regular or irregular intervals."@en ;
    skos:prefLabel "intermittent noise"@en .

<http://www.eionet.europa.eu/gemet/concept/4414> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5058> ;
    skos:prefLabel "internal European market"@en .

<http://www.eionet.europa.eu/gemet/concept/4415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2796> ;
    skos:prefLabel "internalisation of environmental costs"@en .

<http://www.eionet.europa.eu/gemet/concept/4419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13262> ;
    skos:definition "The ability of firms to strive with rivals in the production and sale of commodities in worldwide markets."@en ;
    skos:prefLabel "international competitiveness"@en .

<http://www.eionet.europa.eu/gemet/concept/4421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "The collaboration between governments, businesses or individuals in which it is agreed to work together on similar objectives or strategies, particularly in research or in setting industrial standards."@en ;
    skos:prefLabel "international co-operation"@en .

<http://www.eionet.europa.eu/gemet/concept/4422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:definition "Judicial arm of the United Nations. It has jurisdiction to give advisory opinions on matters of law and treaty construction when requested by the General Assembly, Security Council or any other international agency authorised by the General Assembly to petition for such opinion. It has jurisdiction, also, to settle legal disputes between nations when voluntarily submitted to it."@en ;
    skos:prefLabel "International Court of Justice"@en .

<http://www.eionet.europa.eu/gemet/concept/4423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13148> ;
    skos:definition "The worldwide allocating of resources or dispersing of goods."@en ;
    skos:prefLabel "international distribution"@en .

<http://www.eionet.europa.eu/gemet/concept/4424> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4584> ;
    skos:prefLabel "international division of labour"@en .

<http://www.eionet.europa.eu/gemet/concept/4427> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "The political or diplomatic interaction or dealings between independent nations that pertain to ecological concerns."@en ;
    skos:prefLabel "international environmental relations"@en .

<http://www.eionet.europa.eu/gemet/concept/4429> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "Harmonisation of the interrelationship of sovereign states by the application of general principles recognized by civilized nations."@en ;
    skos:prefLabel "international harmonisation"@en .

<http://www.eionet.europa.eu/gemet/concept/443> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11477> ;
    skos:definition "Precautionary actions or procedures taken to prevent or reduce the harm to sentient, non-human species, posed, in most cases, by humans."@en ;
    skos:prefLabel "animal protection"@en .

<http://www.eionet.europa.eu/gemet/concept/4432> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2525> ;
    skos:definition "Ecosystems whose importance is recognised at international level and which are, in some cases, protected by international conventions."@en ;
    skos:prefLabel "internationally important ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/4440> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145>,
        <http://www.eionet.europa.eu/gemet/concept/15281>,
        <http://www.eionet.europa.eu/gemet/concept/15282>,
        <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "Land area drained by a river and its tributaries whose waters are situated in and utilized by two or more countries."@en ;
    skos:prefLabel "international river basin"@en .

<http://www.eionet.europa.eu/gemet/concept/4442> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8048> ;
    skos:definition "The process of establishing or conforming something to a norm or measure that is recognized beyond the boundaries of a single country or nation."@en ;
    skos:prefLabel "international standardisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4448> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "Portions of a geographical area which constitutes a hydrogeological unit as the catchment area for a single river which are under the jurisdiction of two or more countries."@en ;
    skos:prefLabel "international watercourse"@en .

<http://www.eionet.europa.eu/gemet/concept/445> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/873> ;
    skos:prefLabel "animal resource"@en .

<http://www.eionet.europa.eu/gemet/concept/4451> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3013> ;
    skos:definition "Method employed in the assessment of the meaning and significance of data, results, facts, etc."@en ;
    skos:prefLabel "interpretation method"@en .

<http://www.eionet.europa.eu/gemet/concept/4454> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1513> ;
    skos:definition """1) The area between land and sea which is regularly exposed to the air by the tidal movement of the sea. Marine organisms that inhabit the intertidal zones have to adapt to periods of exposure to air and to the waves created by wind, which makes it the most physically demanding of the marine habitats. 
2) The shore zone between the highest and lowest tides."""@en ;
    skos:prefLabel "intertidal zone"@en .

<http://www.eionet.europa.eu/gemet/concept/4468> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4466> ;
    skos:definition "Survey of a forest area to determine forest depletion. The aim of the inventory is to give an overview of the forest conditions. Especially should the inventory aim to detect any changes in the forest conditions, but it should also provide the distribution of the forest damages and find out any relation with site and stand conditions."@en ;
    skos:prefLabel "inventory of forest damage"@en .

<http://www.eionet.europa.eu/gemet/concept/4473> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A reversal in the usual direction of a process, as in the change of density of water at 4° C."@en ;
    skos:prefLabel "inversion"@en .

<http://www.eionet.europa.eu/gemet/concept/4474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/627> ;
    skos:definition "The atmosphere layer through which an inversion occurs."@en ;
    skos:prefLabel "inversion layer"@en .

<http://www.eionet.europa.eu/gemet/concept/4478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "Any item of value purchased for profitable return, as income, interest or capital appreciation."@en ;
    skos:prefLabel "investment"@en .

<http://www.eionet.europa.eu/gemet/concept/448> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4862> ;
    skos:definition "Animals bred and killed for the production of food."@en ;
    skos:prefLabel "animal for slaughter"@en .

<http://www.eionet.europa.eu/gemet/concept/4480> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "Assay taking place in an artificial environment."@en ;
    skos:prefLabel "in vitro assay"@en .

<http://www.eionet.europa.eu/gemet/concept/4481> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "Experiments that are carried out in the living organism."@en ;
    skos:prefLabel "in vivo assay"@en .

<http://www.eionet.europa.eu/gemet/concept/4483> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2642> ;
    skos:definition "A nonmetallic halogen element; the poisonous, corrosive dark plates or granules are readily sublimed; insoluble in water, soluble in common solvents; used as germicide and antiseptic, in dyes, tinctures, and pharmaceuticals, in engraving lithography, and as a catalyst and analytical reagent."@en ;
    skos:prefLabel "iodine"@en .

<http://www.eionet.europa.eu/gemet/concept/4485> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process in which ions are exchanged between a solution and an insoluble solid, usually a resin."@en ;
    skos:prefLabel "ion exchange"@en .

<http://www.eionet.europa.eu/gemet/concept/4487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A permanent insoluble material (usually a synthetic resin) which contains ions that will exchange reversibly with other ions in a surrounding solution. Both cation and anion exchangers are used in water conditioning. The volume of an ion exchanger is measured in cubic liters of exchanger after the exchanger bed has been backwashed and drained, and has settled into place."@en ;
    skos:prefLabel "ion exchanger"@en .

<http://www.eionet.europa.eu/gemet/concept/449> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A protection providing housing for animals in bad weather."@en ;
    skos:prefLabel "animal shelter"@en .

<http://www.eionet.europa.eu/gemet/concept/4492> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/641> ;
    skos:definition "A region of the earth's atmosphere, extending from about 60 to 1000 kilometers above the earth's surface, in which there is a high concentration of free electrons formed as a result of ionizing radiation entering the atmosphere from space."@en ;
    skos:prefLabel "ionosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/4498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A malleable ductile silvery-white ferromagnetic metallic element occurring principally in haematite and magnetite. It is widely used for structural and engineering purposes."@en ;
    skos:prefLabel "iron"@en .

<http://www.eionet.europa.eu/gemet/concept/4501> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13098> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the extraction and refinement of iron ore to produce cast iron, wrought iron and steel."@en ;
    skos:prefLabel "iron industry"@en .

<http://www.eionet.europa.eu/gemet/concept/4503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5181> ;
    skos:definition "Industry for the production of iron articles."@en ;
    skos:prefLabel "ironwork industry"@en .

<http://www.eionet.europa.eu/gemet/concept/4504> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "To subject to or treat with light or other electromagnetic radiation or with beams of particles."@en ;
    skos:prefLabel "irradiation"@en .

<http://www.eionet.europa.eu/gemet/concept/4507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1126> ;
    skos:definition "A permanent irrigation conduit constructed to convey water from the source of supply to one or more farms."@en ;
    skos:prefLabel "irrigation canal"@en .

<http://www.eionet.europa.eu/gemet/concept/4509> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Farming based on the artificial distribution and application of water to arable land to initiate and maintain plant growth."@en ;
    skos:prefLabel "irrigation farming"@en .

<http://www.eionet.europa.eu/gemet/concept/4515> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "Unique but fragile and vulnerable ecosystems due to the fact that the evolution of their flora and fauna has taken place in relative isolation. Many remote islands have some of the most unique flora in the world; some have species of plants and animals that are not found anywhere else, which have evolved in a specialized way, sheltered from the fierce competition that species face on mainland."@en ;
    skos:prefLabel "island ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/4519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition """1) Two or more compounds having the same molecular formula, but a different arrangement of atoms within the molecule.
2) One of two or more chemical substances having the same elementary percentage composition and molecular weight but differing in structure, and therefore in properties; there are many ways in which such structural differences occur."""@en ;
    skos:prefLabel "isomer"@en .

<http://www.eionet.europa.eu/gemet/concept/452> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The process or act of exchanging, buying or selling animals, especially livestock."@en ;
    skos:prefLabel "animal trade"@en .

<http://www.eionet.europa.eu/gemet/concept/4523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "One or two or more atoms with the same atomic number that contain different numbers of neutrons."@en ;
    skos:prefLabel "isotope"@en .

<http://www.eionet.europa.eu/gemet/concept/4524> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/442> ;
    skos:definition "The fine-grained creamy-white dentine forming the tusks of elephants, and the teeth or tusks of certain other large animals such as the walrus; it has long been esteemed for a wide variety of ornamental articles."@en ;
    skos:prefLabel "ivory"@en .

<http://www.eionet.europa.eu/gemet/concept/4530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "Persons united in a joint liability or indebtedness. Two or more persons jointly liable for the same debt."@en ;
    skos:prefLabel "joint debtor"@en .

<http://www.eionet.europa.eu/gemet/concept/4531> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6376> ;
    skos:prefLabel "joint implementation (Rio Conference)"@en .

<http://www.eionet.europa.eu/gemet/concept/4534> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A program sponsored or administered by a government to guide through and represent in court proceedings persons who are in financial need and cannot afford private counsel."@en ;
    skos:prefLabel "judicial assistance"@en .

<http://www.eionet.europa.eu/gemet/concept/4538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Specific norms, regulations and precedents governing the conduct, procedure and arrangement of a judicial system, its various divisions and its officers."@en ;
    skos:prefLabel "judiciary rule"@en .

<http://www.eionet.europa.eu/gemet/concept/454> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4493> ;
    skos:definition "An ion that is negatively charged."@en ;
    skos:prefLabel "anion"@en .

<http://www.eionet.europa.eu/gemet/concept/4543> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The science or philosophy of law."@en ;
    skos:prefLabel "jurisprudence"@en .

<http://www.eionet.europa.eu/gemet/concept/4548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "To keep a supply accumulated for future use."@en ;
    skos:prefLabel "stocking"@en .

<http://www.eionet.europa.eu/gemet/concept/4550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "A thin oil distilled from petroleum or shale oil, used as a fuel for heating and cooking, in lamps, and as a denaturant for alcohol."@en ;
    skos:prefLabel "kerosene"@en .

<http://www.eionet.europa.eu/gemet/concept/4573> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "Research carried out in a laboratory for testing chemical substances, growing tissues in cultures, or performing microbiological, biochemical, hematological, microscopical, immunological, parasitological tests, etc."@en ;
    skos:prefLabel "laboratory research"@en .

<http://www.eionet.europa.eu/gemet/concept/4575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded materials produced by analytical and research activities in a laboratory."@en ;
    skos:prefLabel "laboratory waste"@en .

<http://www.eionet.europa.eu/gemet/concept/458> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The situation in which two chemicals upon interaction interfere in such a way that the action of one partially or completely inhibits the effects of the other."@en ;
    skos:prefLabel "antagonism"@en .

<http://www.eionet.europa.eu/gemet/concept/4580> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "The branch of the legal system which lays down the rules governing employment relationships, trade union relations, and state intervention to provide protection against particular situations of need for citizens who are workers."@en ;
    skos:prefLabel "labour law"@en .

<http://www.eionet.europa.eu/gemet/concept/4586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A material which contains a substantial quantity of a cellulose derivative, most commonly nitrocellulose but sometimes a cellulose ester, such as cellulose acetate or cellulose butyrate, or a cellulose ether such as ethyl cellulose; used to give a glossy finish, especially on brass and other bright metals."@en ;
    skos:prefLabel "lacquer"@en .

<http://www.eionet.europa.eu/gemet/concept/4590> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition """1) The depression in the Earth's surface occupied or formerly occupied by a lake and containing its shore features. 
2) The area from which a lake receives drainage."""@en ;
    skos:prefLabel "lake basin"@en .

<http://www.eionet.europa.eu/gemet/concept/4593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3493> ;
    skos:definition "The direct or indirect human alteration of the biological, physical, chemical or radiological integrity of lake water, or a lake ecosystem."@en ;
    skos:prefLabel "lake pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/4594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124> ;
    skos:definition "An enclosed body of water, usually but not necessarily fresh water, from which the sea is excluded."@en ;
    skos:prefLabel "lake"@en .

<http://www.eionet.europa.eu/gemet/concept/4597> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A device that produces light, such as an electric lamp."@en ;
    skos:prefLabel "lamp"@en .

<http://www.eionet.europa.eu/gemet/concept/460> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11678> ;
    skos:prefLabel "antagonistic effect of toxic substances"@en .

<http://www.eionet.europa.eu/gemet/concept/4602> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4635> ;
    skos:definition "Procedure by which big land properties are divided in parcels of smaller size."@en ;
    skos:prefLabel "land allotment"@en .

<http://www.eionet.europa.eu/gemet/concept/4607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7848> ;
    skos:definition "The maximum extent to which ground or soil area may be exploited without degradation or depletion."@en ;
    skos:prefLabel "land carrying capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/4609> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9373> ;
    skos:definition "Removal of trees, undergrowth, etc. in preparation for ploughing, building, etc."@en ;
    skos:prefLabel "land clearing"@en .

<http://www.eionet.europa.eu/gemet/concept/461> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "A continent lying chiefly within the Antarctic Circle and asymmetrically centered on the South Pole: it consists of an ice-covered plateau (some 95 percent of Antarctica is covered by an icecap averaging 1,6 km in thickness), 1800-3000 m above sea level, and mountains ranges rising to 4500 m with some volcanic peaks; average temperatures all below freezing and human settlement is confined to research station."@en ;
    skos:prefLabel "Antarctica"@en .

<http://www.eionet.europa.eu/gemet/concept/4610> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "The care, preservation and re-use of solid areas of the earth's surface, especially soil regions valued as a natural resource or utilized as an agricultural resource."@en ;
    skos:prefLabel "land conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/4611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Joining small plots of land together to form larger farms or large fields."@en ;
    skos:prefLabel "land consolidation"@en .

<http://www.eionet.europa.eu/gemet/concept/4615> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "Study of the relationship between terrestrial organisms and their environment."@en ;
    skos:prefLabel "land ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/4623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The protective shielding, consisting of soil or some other material, that encloses disposal sites for compacted, non-hazardous solid waste, or secures disposal sites for hazardous waste to minimize the chance of releasing hazardous substances into the environment."@en ;
    skos:prefLabel "landfill covering"@en .

<http://www.eionet.europa.eu/gemet/concept/4624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Landfill gas is highly dangerous as methane is highly explosive; therefore it must be controlled at all operational landfill sites, whether by active or passive ventilation or both especially in the case of deep sites. There exist venting systems for shallow and deep sites respectively."@en ;
    skos:prefLabel "landfill degasification"@en .

<http://www.eionet.europa.eu/gemet/concept/4625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3572> ;
    skos:definition "Landfill gas is generated in landfill sites by the anaerobic decomposition of domestic refuse (municipal solid waste). It consists of a mixture of gases and is colourless with an offensive odour due to the traces of organosulphur compounds. Aside for its unpleasantness, it is highly dangerous as methane is explosive in concentrations in air between 5 per cent, the Lower Explosive Limit (LEL), and the Upper Explosive Limit (UEL) of 15 per cent. Landfill gas must be controlled at all operational landfill sites, whether actively or passively vented or both especially in the case of deep sites."@en ;
    skos:prefLabel "landfill gas"@en .

<http://www.eionet.europa.eu/gemet/concept/4626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Liquid that has seeped through solid waste in a landfill and has extracted soluble dissolved or suspended materials in the process."@en ;
    skos:prefLabel "landfill leachate"@en .

<http://www.eionet.europa.eu/gemet/concept/4628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:prefLabel "land forming"@en .

<http://www.eionet.europa.eu/gemet/concept/463> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6362> ;
    skos:prefLabel "Antarctic ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/4632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:prefLabel "land mammal"@en .

<http://www.eionet.europa.eu/gemet/concept/4633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "The use, settlement or possession of solid areas of the earth's surface."@en ;
    skos:prefLabel "land occupation"@en .

<http://www.eionet.europa.eu/gemet/concept/464> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The waters, including ice shelves, that surround the continent of Antarctica, which comprise the southernmost parts of the Pacific, Atlantic and Indian oceans, and also the Ross, Amundsen, Bellingshausen and Weddell seas."@en ;
    skos:prefLabel "Antarctic Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/4641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Making land capable of more intensive use by changing its general character, as by drainage of excessively wet land; irrigation of arid or semiarid land; or recovery of submerged land from seas, lakes and rivers."@en ;
    skos:prefLabel "land reclamation"@en .

<http://www.eionet.europa.eu/gemet/concept/4644> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4603> ;
    skos:definition "A register or survey of land, containing information on the surface of properties, tenants' names, commencing with the earliest owners through successive ownership and partitions, and such like."@en ;
    skos:prefLabel "land register"@en .

<http://www.eionet.europa.eu/gemet/concept/4649> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "The process of mining disfigures the surface of the land, and in the absence of reclamation leads to permanent scars. The process spoils the vital topsoil, disrupts drainage patterns, destroys the productive capacity of agricultural and forest land and impairs their aesthetic and social value."@en ;
    skos:prefLabel "landscape after mining"@en .

<http://www.eionet.europa.eu/gemet/concept/465> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6364> ;
    skos:definition "An area within the Antarctic Circle that includes the fifth largest continent and its surrounding waters, consisting mostly of thick ice shelves."@en ;
    skos:prefLabel "Antarctic region"@en .

<http://www.eionet.europa.eu/gemet/concept/4651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/538> ;
    skos:definition "The creation, development, and decorative planting of gardens, grounds, parks, and other outdoor spaces. Landscape gardening is used to enhance nature helping to create a natural setting for individual residences and buildings, and even towns, particularly where special approaches and central settings are required."@en ;
    skos:prefLabel "landscape architecture"@en .

<http://www.eionet.europa.eu/gemet/concept/4652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "In visual assessment work, landscapes can be divided into four major elements. a) Form is the perceived mass or shape of an object that appears unified, and which provides a consciousness of its distinction and relation of a whole to the component parts. b) Line is the real or imagined path, border, boundary, or intersection of two planes, such as a silhouette, that the eye follows when perceiving abrupt differences in form, colour or texture. c) Colour is a visual perception that enables the eye to differenciate otherwise identical objects based on the wavelengths of reflected light. d) Texture is the visual feel of a landscape."@en ;
    skos:prefLabel "landscape component"@en .

<http://www.eionet.europa.eu/gemet/concept/4653> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "The safeguarding, for public enjoyment, of landscape and of opportunities for outdoor recreation, tourism and similar activities; the concept includes the preservation and enhancement not only of what has been inherited but the provision of new amenities and facilities."@en ;
    skos:prefLabel "landscape conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/4654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6376> ;
    skos:prefLabel "landscape conservation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/4657> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The study of landscapes taking account of the ecology of their biological populations. The subjects thus embraces geomorphology and ecology and is applied to the design and architecture of landscapes."@en ;
    skos:prefLabel "landscape ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/4658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Measures aiming at preserving landscape or controlling its transformations caused by anthropic activities or natural events."@en ;
    skos:prefLabel "landscape management"@en .

<http://www.eionet.europa.eu/gemet/concept/4659> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6225> ;
    skos:definition "The aspect of the land use planning process that deals with physical, biological, aesthetic, cultural, and historical values and with the relationships and planning between these values, land uses, and the environment."@en ;
    skos:prefLabel "landscape planning"@en .

<http://www.eionet.europa.eu/gemet/concept/4660> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "Elaboration and implementation of strategies and measures for the conservation, preservation, suitable use, and renewal of natural resources and nature or man-made components of landscape, in particular wildlife and natural systems of various standing."@en ;
    skos:prefLabel "landscape protection"@en .

<http://www.eionet.europa.eu/gemet/concept/4661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6743> ;
    skos:definition "Area where landscape is protected for its particular features in order to maintain its role in contributing to the wider enjoyment of the countryside."@en ;
    skos:prefLabel "landscape protection area"@en .

<http://www.eionet.europa.eu/gemet/concept/4662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4663> ;
    skos:definition "Using parts of landscape in a way that heavily modifies its features."@en ;
    skos:prefLabel "landscape consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/4668> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3652> ;
    skos:definition "Mass-movement landforms and processes involving the downslope transport, under gravitationary influence of soil and rock material en masse."@en ;
    skos:prefLabel "landslide"@en .

<http://www.eionet.europa.eu/gemet/concept/4678> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "The term land use deals with the spatial aspects of all human activities on the land and with the way in which the land surface is adapted, or could be adapted, to serve human needs."@en ;
    skos:prefLabel "land use"@en .

<http://www.eionet.europa.eu/gemet/concept/4680> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1447> ;
    skos:definition "The arrangement of land units into a variety of categories based on the properties of the land or its suitability for a particular purpose. It has become an important tool in rural land-resource planning."@en ;
    skos:prefLabel "land use classification"@en .

<http://www.eionet.europa.eu/gemet/concept/4682> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4635> ;
    skos:definition "The interdisciplinary process of evaluating, organising, and controlling the present and the future development and use of lands and their resources in terms of their suitability on sustained yield basis. Includes an overall ecological evaluation in terms of specific kinds of uses as well as evaluations of social, economic, and physical contexts to the land concerned."@en ;
    skos:prefLabel "land use planning"@en .

<http://www.eionet.europa.eu/gemet/concept/4684> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13102> ;
    skos:definition "Type of management and utilization of the soil."@en ;
    skos:prefLabel "soil use regime"@en .

<http://www.eionet.europa.eu/gemet/concept/4686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/193> ;
    skos:definition "The monetary or material worth in commerce or trade of an area of ground considered as property."@en ;
    skos:prefLabel "land value"@en .

<http://www.eionet.europa.eu/gemet/concept/4691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Any sizable building which relies on machinery that converts energy released from the rapid burning of a fuel-air mixture into mechanical energy."@en ;
    skos:prefLabel "large combustion plant"@en .

<http://www.eionet.europa.eu/gemet/concept/4698> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Acronym for Light Amplification by Stimulated Emission of Radiation; a device that produces a powerful, highly directional, monochromatic, coherent beam of light. Laser consist of a transparent cylinder with a reflecting surface at one end and a partially reflecting surface at the other. Light waves are reflected back and forth, some of them emerging at the partially reflecting end. The light source may be a ruby, whose chromium atoms are excited by a flash lamp so that they emit pulses of highly coherent light, or a mixture of inert gases that produce a continuos beam, or a cube of treated gallium arsenide which emits infrared radiation when an electric current passes through it."@en ;
    skos:prefLabel "laser"@en .

<http://www.eionet.europa.eu/gemet/concept/4708> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13290> ;
    skos:definition "An alteration of or addition to any statute with legal force that, if approved by the appropriate legislative authority, supersedes the original statute."@en ;
    skos:prefLabel "law amendment"@en .

<http://www.eionet.europa.eu/gemet/concept/471> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Area of protection of the life style of societies where traditional human activities are still maintained and the exploitation of natural resources is still carried out without compromising the future availability."@en ;
    skos:prefLabel "anthropologic reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/4715> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6290> ;
    skos:definition "A binding rule or body of rules prescribed by a government to protect human health and the environment, manage growth and development or enhance the quality of life in small geographical and social areas within cities where residents share values and concerns and interact with one another on a daily basis."@en ;
    skos:prefLabel "neighbourhood law"@en .

<http://www.eionet.europa.eu/gemet/concept/4719> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "Complex of rules fixed by law or custom which regulate social relations."@en ;
    skos:prefLabel "law (science)"@en .

<http://www.eionet.europa.eu/gemet/concept/4722> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition """1) The process of separating a liquid from a solid (as in waste liquid by percolation into the surrounding soil. 
2) Extraction of soluble components of a solid mixture by percolating a solvent through it.
3) To lose or cause to lose soluble substances by the action of a percolating liquid."""@en ;
    skos:prefLabel "leaching"@en .

<http://www.eionet.europa.eu/gemet/concept/4723> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2639> ;
    skos:definition "A heavy toxic bluish-white metallic element that is highly malleable; occurs principally as galena and is used in alloys, accumulators, cable sheaths, paints, and as a radiation shield."@en ;
    skos:prefLabel "lead"@en .

<http://www.eionet.europa.eu/gemet/concept/4724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Lead compounds are present as gasoline additives, in paint, ceramic products, roofing, caulking, electrical applications, tubes, or containers. Lead exposure may be due to air, water, food, or soil. Lead in the air is primarily due to lead-based fuels and the combustion of solid waste, coal, oils, and emissions from alkyl lead manufacturers, wind blown dust volcanoes, the burning of lead-painted surfaces, and cigarette smoke. Lead in drinking water comes from leaching from lead pipes, connectors, and solder in both the distribution system and household plumbing."@en ;
    skos:prefLabel "lead compound"@en .

<http://www.eionet.europa.eu/gemet/concept/4725> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11676> ;
    skos:definition "The presence and release into the air, water and soil, of lead, a toxic metal used in plumbing, gasoline and lead-acid batteries."@en ;
    skos:prefLabel "lead contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/4727> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4247> ;
    skos:definition "A binding rule or body of rules prescribed by a government to reduce or eliminate the lead content in petroleum fuels used in vehicular and other engines that pollute the air with lead-carrying exhaust."@en ;
    skos:prefLabel "lead-in-petrol law"@en .

<http://www.eionet.europa.eu/gemet/concept/4728> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6359> ;
    skos:definition "A measure of the amount of lead or lead salts absorbed by the body as a possible sign of acute or chronic lead poisoning, which can affect the nervous, digestive or muscular systems."@en ;
    skos:prefLabel "lead level in blood"@en .

<http://www.eionet.europa.eu/gemet/concept/473> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2354> ;
    skos:definition "A chemical substance, produced by microorganisms and synthetically, that has the capacity to inhibit the growth of, and even to destroy, bacteria and other microorganisms."@en ;
    skos:prefLabel "antibiotic"@en .

<http://www.eionet.europa.eu/gemet/concept/4730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "The main organ of photosynthesis and transpiration in higher plants, usually consisting of a flat green blade attached to the stem directly or by a stalk."@en ;
    skos:prefLabel "leaf"@en .

<http://www.eionet.europa.eu/gemet/concept/4735> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/442> ;
    skos:definition "The dressed or tanned hide of an animal, usually with the hair removed."@en ;
    skos:prefLabel "leather"@en .

<http://www.eionet.europa.eu/gemet/concept/4738> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the production of leather goods such as garments, bags, etc."@en ;
    skos:prefLabel "leather industry"@en .

<http://www.eionet.europa.eu/gemet/concept/4739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13288> ;
    skos:definition "The fundamental law or judicial precedent that warrants or supports a subsequent decision or action by any governmental, corporate or private entity."@en ;
    skos:prefLabel "legal basis"@en .

<http://www.eionet.europa.eu/gemet/concept/474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4154> ;
    skos:definition "A complex protein that is produced in response to the introduction of a specific antigen into an animal. Antibodies belong to a class of proteins called immunoglobins, which are formed by plasma cells in the blood as a defence mechanism against invasion by parasites, notably bacteria and viruses, either by killing them or rendering them harmless."@en ;
    skos:prefLabel "antibody"@en .

<http://www.eionet.europa.eu/gemet/concept/4741> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A justifiable claim to have or obtain something or to act in a certain way, which is supported by law and is covered or shielded from the danger of being revoked or repealed."@en ;
    skos:prefLabel "legally protected right"@en .

<http://www.eionet.europa.eu/gemet/concept/4743> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "Any order or rule issued by a government stipulating its procedures for the creation, execution or adjudication of laws."@en ;
    skos:prefLabel "legal regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/4744> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13288> ;
    skos:definition "The means by which a right is enforced or the violation of a right is prevented, redressed, or compensated."@en ;
    skos:prefLabel "legal remedy"@en .

<http://www.eionet.europa.eu/gemet/concept/4746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13288> ;
    skos:definition "The exact wording or language of a law or other document in conformity with the law or having the authority of law."@en ;
    skos:prefLabel "legal text"@en .

<http://www.eionet.europa.eu/gemet/concept/475> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The act of foreseeing, expecting and taking measures against possible future exposure to harm, death or a thing that causes these."@en ;
    skos:prefLabel "anticipation of danger"@en .

<http://www.eionet.europa.eu/gemet/concept/4758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "A binding rule or body of rules prescribed by a government to manage and protect an area's natural water supply and waterways."@en ;
    skos:prefLabel "water resources legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/4759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a deliberative assembly of persons or delegates to bring a bill, resolution or special act to an official, legally binding status."@en ;
    skos:prefLabel "legislative authority"@en .

<http://www.eionet.europa.eu/gemet/concept/4760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "The skill, knowledge, qualification, capacity or authority to make, give or enact rules with binding force upon a population or jurisdiction."@en ;
    skos:prefLabel "legislative competence"@en .

<http://www.eionet.europa.eu/gemet/concept/4762> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "Knowledge or a service providing knowledge concerning actual and proposed laws, including approval status, the history and content of deliberative proceedings and the specific language of those laws."@en ;
    skos:prefLabel "legislative information"@en .

<http://www.eionet.europa.eu/gemet/concept/4764> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The department, assembly, or body of persons that makes statutory laws for a state or nation."@en ;
    skos:prefLabel "legislature"@en .

<http://www.eionet.europa.eu/gemet/concept/478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1809> ;
    skos:definition "Agent that inhibits the growth of barnacles and other marine organisms on a ship's bottom (an antifouling paint or other coating). Organo-tin compounds have been the most often used agents in this application since they are effective against both soft and hard fouling organisms. However, in spite of their performance, they have a negative impact on the marine environment and their long half life in the environment, has prompted marine paint manufacturers to look for a nonpersistent alternative."@en ;
    skos:prefLabel "antifouling agent"@en .

<http://www.eionet.europa.eu/gemet/concept/4782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A progressive, malignant disease of the blood forming organs; a distorted proliferation and development of leukocytes and their precursors in the blood and bone marrow."@en ;
    skos:prefLabel "leukaemia"@en .

<http://www.eionet.europa.eu/gemet/concept/4784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:definition "A ratable portion of the produce of the property and labor of the individual citizens, taken by the nation, in the exercise of its sovereign rights, for the support of government, for the administration of the laws, and as the means for continuing in operation the various legitimate functions of the state."@en ;
    skos:prefLabel "levy"@en .

<http://www.eionet.europa.eu/gemet/concept/4785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "The vocabulary of a particular sphere of activity, region, social class or individual, or the total set of morphemes or meaningful units of a language and its words."@en ;
    skos:prefLabel "lexicon"@en .

<http://www.eionet.europa.eu/gemet/concept/4788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition "Subjection to a legal obligation, such as financial recompense or ecological reparations, for any harm or damage inflicted on persons, property or the environment in the course of commercial or recreational activity in, on or near a sea."@en ;
    skos:prefLabel "liability for marine accidents"@en .

<http://www.eionet.europa.eu/gemet/concept/4789> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition "Subjection to a legal obligation, such as financial recompense or ecological reparations, for any harm or damage inflicted on persons, property or the environment during the production, use or transport of radioactive materials used as an energy source or in weaponry."@en ;
    skos:prefLabel "liability for nuclear damages"@en .

<http://www.eionet.europa.eu/gemet/concept/4790> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "A law or body of laws enacted that pertains to or establishes an obligation, debt or responsibility for loss, penalty, evil, expense or burden."@en ;
    skos:prefLabel "liability legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/4793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Place where books and other literary materials are kept."@en ;
    skos:prefLabel "library"@en .

<http://www.eionet.europa.eu/gemet/concept/4797> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4796> ;
    skos:definition "Procedures performed by administrative agencies in conjunction with issuance of various types of licences."@en ;
    skos:prefLabel "licencing procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/4798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4796> ;
    skos:definition "Obligation to obtain a permit to pursue an occupation or to carry on some business."@en ;
    skos:prefLabel "licencing obligation"@en .

<http://www.eionet.europa.eu/gemet/concept/4799> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "Composite organisms formed by the symbiosis between species of fungi and an algae. They are either crusty patches or bushy growths on tree trunks, stone walls, roofs or garden paths. Because they have no actual roots they get their sustenance from the atmosphere and rainwater. Lichens play an important role in the detection and monitoring of pollution, especially sulphur dioxide, as they are highly sensitive to pollution and different species disappear if pollution reaches specific levels."@en ;
    skos:prefLabel "lichen"@en .

<http://www.eionet.europa.eu/gemet/concept/4810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5674>,
        <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Electromagnetic radiation that is capable of causing a visual sensation."@en ;
    skos:prefLabel "light"@en .

<http://www.eionet.europa.eu/gemet/concept/4814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The supply of illumination in streets or dwellings."@en ;
    skos:prefLabel "lighting"@en .

<http://www.eionet.europa.eu/gemet/concept/4815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7612> ;
    skos:definition "A mechanical device for separating and removing residues from fuel and lubricating oil from waste water coming from filling stations and industrial plants in order to avoid pollution of water bodies; this system is based on the different specific weights of water and fuel residues that float on the water and can be easily removed."@en ;
    skos:prefLabel "separator of light liquids"@en .

<http://www.eionet.europa.eu/gemet/concept/4818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3462> ;
    skos:definition "Coal of relatively recent origin consisting of accumulated layers of partially decomposed vegetation, intermediate between peat and bituminous coal; often contains patterns from the wood from which it formed."@en ;
    skos:prefLabel "lignite"@en .

<http://www.eionet.europa.eu/gemet/concept/4819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Extraction of brown coal from natural deposits; lignite is a brownish-black solid fuel in the second stage in the development of coal. It has a little over half the heating value of bituminous or anthracite coal."@en ;
    skos:prefLabel "lignite mining"@en .

<http://www.eionet.europa.eu/gemet/concept/4820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "Any of various mineral and industrial forms of calcium oxide differing chiefly in water content and percentage of constituent such as silica, alumina and iron."@en ;
    skos:prefLabel "lime"@en .

<http://www.eionet.europa.eu/gemet/concept/4823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7298> ;
    skos:definition "A sedimentary rock consisting chiefly of calcium carbonate, primarily in the form of the mineral calcite and with or without magnesium carbonate. Limestones are formed by either organic or inorganic processes, and may be detrital, chemical, oolitic, earthy, crystalline, or recrystallized; many are highly fossiliferous and clearly represent ancient shell banks or coral reefs."@en ;
    skos:prefLabel "limestone"@en .

<http://www.eionet.europa.eu/gemet/concept/4828> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:definition "A workplace exposure criterion or standard that determines if a facility or building has a concentration of a substance to which most workers can be exposed without harmful or adverse effects."@en ;
    skos:prefLabel "limit value"@en .

<http://www.eionet.europa.eu/gemet/concept/4830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The study of bodies of fresh water with reference to their plant and animal life, physical properties, geographical features, etc."@en ;
    skos:prefLabel "limnology"@en .

<http://www.eionet.europa.eu/gemet/concept/4832> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7933> ;
    skos:definition "Point noise sources placed one after the other one as, for instance, in a row of cars moving on a road."@en ;
    skos:prefLabel "linear source of sound"@en .

<http://www.eionet.europa.eu/gemet/concept/4834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "A layer of synthetic or natural materials, on the sides of or beneath a landfill, landfill cell or surface impoundment, that restricts the downward or lateral escape of liquids carrying leachate into the surrounding environment."@en ;
    skos:prefLabel "liner material"@en .

<http://www.eionet.europa.eu/gemet/concept/4835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:definition "Line source means a one-dimensional source. An example of a line source is the particular emissions from a dirt road."@en ;
    skos:prefLabel "line source"@en .

<http://www.eionet.europa.eu/gemet/concept/4838> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "One of a class of compounds which contain long-chain aliphatic hydrocarbons and their derivatives, such as fatty acids, alcohols, amines, amino alcohols, and aldehydes; includes waxes, fats, and derived compounds."@en ;
    skos:prefLabel "lipid"@en .

<http://www.eionet.europa.eu/gemet/concept/4839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Substances having an affinity for lipids."@en ;
    skos:prefLabel "lipophilic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/4840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "A gaseous compound or mixture converted to the liquid phase by cooling or compression; examples are liquefied petroleum gas (LPG), liquefied natural gas (LNG), liquid oxygen, and liquid ammonia."@en ;
    skos:prefLabel "liquefied gas"@en .

<http://www.eionet.europa.eu/gemet/concept/4843> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5007> ;
    skos:definition "Any fertilizer substance with a moisture content of over ninety percent, usually consisting of animal excrement with water added."@en ;
    skos:prefLabel "liquid manure"@en .

<http://www.eionet.europa.eu/gemet/concept/4851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2282> ;
    skos:definition "A fund of information on a particular subject or group of related subjects, divided into discrete documents and usually stored in and used with a computer system."@en ;
    skos:prefLabel "literature data bank"@en .

<http://www.eionet.europa.eu/gemet/concept/4852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4850> ;
    skos:definition "The action of evaluating or judging the quality or character of written materials such as poetry, essays, novels, biographies and historical writings."@en ;
    skos:prefLabel "literature evaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/4853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "The identification, description, analysis and classification of books and other materials used or consulted in the preparation of a work."@en ;
    skos:prefLabel "literature study"@en .

<http://www.eionet.europa.eu/gemet/concept/4857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5437> ;
    skos:definition "Straw, hay or similar material used as bedding by animals."@en ;
    skos:prefLabel "litter"@en .

<http://www.eionet.europa.eu/gemet/concept/4858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1513> ;
    skos:definition "The intertidal zone of the seashore."@en ;
    skos:prefLabel "littoral"@en .

<http://www.eionet.europa.eu/gemet/concept/486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Organic halogens subject to absorption. This is a measure of the amount of chlorine (and other halogens) combined with organic compounds."@en ;
    skos:prefLabel "AOX value"@en .

<http://www.eionet.europa.eu/gemet/concept/4863> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "The raising of livestock by crossing different varieties to obtain new varieties with desired characteristics."@en ;
    skos:prefLabel "livestock breeding"@en .

<http://www.eionet.europa.eu/gemet/concept/4864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "Breeding of cattle, horses and similar animals."@en ;
    skos:prefLabel "livestock farming"@en .

<http://www.eionet.europa.eu/gemet/concept/4866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "An element or characteristic of a habitation considered in light of its ability to sustain and promote the health and general well-being of occupants."@en ;
    skos:prefLabel "living condition"@en .

<http://www.eionet.europa.eu/gemet/concept/4867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7525> ;
    skos:prefLabel "living marine resource"@en .

<http://www.eionet.europa.eu/gemet/concept/4868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7825> ;
    skos:definition "Any room, structure or area used as a residence and associated with subsistence activities, including sleeping, relaxing or eating."@en ;
    skos:prefLabel "living space"@en .

<http://www.eionet.europa.eu/gemet/concept/4871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7124> ;
    skos:definition "Any reptile of the suborder Lacertilia, especially those of the family Lacertidae, typically having an elongated body, four limbs, and a small tail: includes the gechos, iguanas, chameleons, monitors, and slow worms."@en ;
    skos:prefLabel "lizard"@en .

<http://www.eionet.europa.eu/gemet/concept/4879> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a government agency or its administrators to administer and implement laws and government policies for a city, town or small district."@en ;
    skos:prefLabel "local authority"@en .

<http://www.eionet.europa.eu/gemet/concept/488> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7144> ;
    skos:definition "An apartment building in which each apartment is individually wholly owned and the common areas are jointly owned."@en ;
    skos:prefLabel "apartment block"@en .

<http://www.eionet.europa.eu/gemet/concept/4884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6793> ;
    skos:definition "The theory and practice of all public money matters pertaining to city, town or small district governments."@en ;
    skos:prefLabel "local finance"@en .

<http://www.eionet.europa.eu/gemet/concept/4885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3718> ;
    skos:definition "Any course of action adopted and pursued by a ruling political authority or system, which determines the affairs for a city, town, county or regional area."@en ;
    skos:prefLabel "local government policy"@en .

<http://www.eionet.europa.eu/gemet/concept/4886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14963> ;
    skos:definition "The supply of heat, either in the form of steam or hot water, from a central source to a group of buildings."@en ;
    skos:prefLabel "teleheating"@en .

<http://www.eionet.europa.eu/gemet/concept/4888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:prefLabel "local building material"@en .

<http://www.eionet.europa.eu/gemet/concept/4889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8653> ;
    skos:definition "Passenger transport system for a limited local area."@en ;
    skos:prefLabel "local passenger service"@en .

<http://www.eionet.europa.eu/gemet/concept/4891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Traffic moving within a city, town, or area and subject to frequent stops, as distinguished from long distance traffic."@en ;
    skos:prefLabel "local traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/4893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7709> ;
    skos:definition "The particular place that seems apt for the installation of a new plant; the choice of the site depends on a number of economic and environmental factors."@en ;
    skos:prefLabel "location of industries"@en .

<http://www.eionet.europa.eu/gemet/concept/4897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6939> ;
    skos:definition "A self -propelled engine driven by steam, electricity or diesel power and used for drawing trains along railway tracks."@en ;
    skos:prefLabel "locomotive"@en .

<http://www.eionet.europa.eu/gemet/concept/490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/429> ;
    skos:definition "Large-scale commercial beekeeping."@en ;
    skos:prefLabel "apiculture"@en .

<http://www.eionet.europa.eu/gemet/concept/4902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Traffic moving over extended areas, great distances and usually not subject to frequent stops."@en ;
    skos:prefLabel "long-distance traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/4903> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3481> ;
    skos:definition "The conveyance of materials or commodities over land, water or through air in which a great distance is covered."@en ;
    skos:prefLabel "long-distance transport"@en .

<http://www.eionet.europa.eu/gemet/concept/4907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4906> ;
    skos:prefLabel "long-term effect of pollutants"@en .

<http://www.eionet.europa.eu/gemet/concept/4908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4571> ;
    skos:definition """1) Experiment lasting for a relatively long period of time.
2) Experiment whose results become effective after a long period of time."""@en ;
    skos:prefLabel "long-term experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/4909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "The act or process of predicting and calculating the likely conditions or occurrences for an extended and future point in time, often involving the study and analysis of pertinent data."@en ;
    skos:prefLabel "long-term forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/4911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8671> ;
    skos:definition "The prevailing tendency or general direction expected for some observed value over a lengthy and extended period of time, often determined by studying and analyzing statistical data."@en ;
    skos:prefLabel "long-term trend"@en .

<http://www.eionet.europa.eu/gemet/concept/4914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/709> ;
    skos:definition "The result of a business operation where overhead costs are greater than the receipts or income."@en ;
    skos:prefLabel "loss"@en .

<http://www.eionet.europa.eu/gemet/concept/4916> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "Destruction of biotopes produced by environmental degradation which in turn is caused by air- or water-borne pollution."@en ;
    skos:prefLabel "loss of biotope"@en .

<http://www.eionet.europa.eu/gemet/concept/4917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:definition "The magnitude of the physiological sensation produced by a sound, which varies directly with the physical intensity of sound but also depends on frequency of sound and waveform."@en ;
    skos:prefLabel "loudness"@en .

<http://www.eionet.europa.eu/gemet/concept/4918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7795> ;
    skos:definition "Residences built at minimal expense and designed to keep the rental rate or price of purchase affordable for persons with limited means, usually determined by an annual income level set below the local median."@en ;
    skos:prefLabel "low-cost housing"@en .

<http://www.eionet.europa.eu/gemet/concept/492> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13283> ;
    skos:definition "Resort to a superior court to review the decision of an inferior court or administrative agency."@en ;
    skos:prefLabel "appeal"@en .

<http://www.eionet.europa.eu/gemet/concept/4920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6048> ;
    skos:definition "The body of a bicameral legislature composed of representatives elected by the general populace and organized into electorates or districts, each comprising an equal number of citizens."@en ;
    skos:prefLabel "Lower House"@en .

<http://www.eionet.europa.eu/gemet/concept/4921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Animals, birds, fish, plants or other living organisms that have been deemed as not being in danger of extinction."@en ;
    skos:prefLabel "lower risk species  (IUCN)"@en .

<http://www.eionet.europa.eu/gemet/concept/4922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "Phase of lowest level of a water course."@en ;
    skos:prefLabel "low flow"@en .

<http://www.eionet.europa.eu/gemet/concept/4929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/282> ;
    skos:definition "Flying at low altitude."@en ;
    skos:prefLabel "low-level flight"@en .

<http://www.eionet.europa.eu/gemet/concept/493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "Procedure through which it is possible to resort to a superior court to review the decision of an inferior court."@en ;
    skos:prefLabel "appeal procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/4931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Any relatively unsophisticated technical equipment or method with an amplitude or functionality below what is available in a similar or comparable system."@en ;
    skos:prefLabel "low-level technology"@en .

<http://www.eionet.europa.eu/gemet/concept/4937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The functional relationship between stellar magnitude and the number and distribution of stars of each magnitude interval. Also known as relative luminosity factor."@en ;
    skos:prefLabel "luminosity"@en .

<http://www.eionet.europa.eu/gemet/concept/494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The application of ecological principles to the solution of human problems."@en ;
    skos:prefLabel "applied ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/4942> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "The alkaline solution that is obtained from the leaching of wood ashes."@en ;
    skos:prefLabel "lye"@en .

<http://www.eionet.europa.eu/gemet/concept/4945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "A system of vessels and nodes conveying lymph in the vertebrate body, beginning with capillaries in tissue spaces and eventually forming the thoracic ducts which empty in the subclavian veins."@en ;
    skos:prefLabel "lymphatic system"@en .

<http://www.eionet.europa.eu/gemet/concept/4948> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "The measurement of the water percolating through soils and the determination of the materials dissolved by the water."@en ;
    skos:prefLabel "lysimetry"@en .

<http://www.eionet.europa.eu/gemet/concept/4952> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12514> ;
    skos:definition "The making or production of mechanical apparatuses used for commercial or industrial purposes, such as engines and turbines, elevators and conveying equipment, computers and office equipment, and hoists, cranes and industrial trucks."@en ;
    skos:prefLabel "machine manufacture"@en .

<http://www.eionet.europa.eu/gemet/concept/4956> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3698> ;
    skos:definition "An aim or objective pertaining to the production, distribution and use of income, wealth and commodities in a country, region or other large area, typically concerned with governmental fiscal and monetary policy as it affects employment, consumption, investment and growth levels."@en ;
    skos:prefLabel "macroeconomic goal"@en .

<http://www.eionet.europa.eu/gemet/concept/4957> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2501> ;
    skos:definition "Modern economic analysis that is concerned with data inaggregate as opposed to individual form such as national income, consumption and investment."@en ;
    skos:prefLabel "macroeconomics"@en .

<http://www.eionet.europa.eu/gemet/concept/4964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1981> ;
    skos:definition "A plastic, paper, or metal tape that is coated or impregnated with magnetizable iron oxide particles, used in magnetic recording."@en ;
    skos:prefLabel "magnetic tape"@en .

<http://www.eionet.europa.eu/gemet/concept/4965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A class of physical phenomena associated with moving electricity, including the mutual mechanical forces among magnets and electric currents."@en ;
    skos:prefLabel "magnetism"@en .

<http://www.eionet.europa.eu/gemet/concept/4967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14856> ;
    skos:definition "A series of addresses or e-mail addresses to which solicited or unsolicited mass mailings can be sent."@en ;
    skos:prefLabel "mailing list"@en .

<http://www.eionet.europa.eu/gemet/concept/4969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:prefLabel "maintenance of environment"@en .

<http://www.eionet.europa.eu/gemet/concept/4974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9426> ;
    skos:definition "A group of human febrile diseases with a chronic relapsing course caused by hemosporidian blood parasites of the genus Plasmodium, transmitted by the bite of Anopheles mosquito."@en ;
    skos:prefLabel "malaria"@en .

<http://www.eionet.europa.eu/gemet/concept/4977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "Permanent structural change that may adversely affect survival, development or function."@en ;
    skos:prefLabel "malformation"@en .

<http://www.eionet.europa.eu/gemet/concept/4979> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3381> ;
    skos:definition "Defective nutrition due to inadequate intake of nutrients or to their faulty digestion, assimilation or metabolism."@en ;
    skos:prefLabel "malnutrition"@en .

<http://www.eionet.europa.eu/gemet/concept/498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition """1) A flexible and participatory approach to developing economically viable, regionally applicable and sustainable technology.
2) Technology designed to be used in developing countries. Typical requirements are that it should: be easy to use by the unskilled; have no difficult-to-get parts; be easily repaired on the spot. Typical example: a simple windmill to pump water rather than a diesel-driven pump. The terms `alternative', `intermediate' and `appropriate' are often used interchangeably."""@en ;
    skos:prefLabel "appropriate technology"@en .

<http://www.eionet.europa.eu/gemet/concept/4984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:definition "A member of the human race."@en ;
    skos:prefLabel "man (society)"@en .

<http://www.eionet.europa.eu/gemet/concept/4987> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2009> ;
    skos:definition "A legal agreement between two or more parties of employers and workers that outlines the administrative or supervisory work that is expected in exchange for certain payments and working conditions."@en ;
    skos:prefLabel "management contract"@en .

<http://www.eionet.europa.eu/gemet/concept/4990> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A program of action designed to reach a given set of objectives."@en ;
    skos:prefLabel "management plan"@en .

<http://www.eionet.europa.eu/gemet/concept/4994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "A command or authorization to act in a particular way given by an administrator to a subordinate, a court to a lower court or an electorate to its representative."@en ;
    skos:prefLabel "mandate"@en .

<http://www.eionet.europa.eu/gemet/concept/4998> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/514> ;
    skos:definition "Plant communities and trees that inhabit tidal swamps, muddy silt, and sand banks at the mouths of rivers and other low-lying areas which are regularly inundated by the sea, but which are protected from strong waves and currents. Mangroves are the only woody species that will grow where the land is periodically flooded with sea water; individual species have adapted themselves to different tidal levels, to various degrees of salinity, and to the nature of the mud or soil. Mangrove swamps and thickets support hundreds of terrestrial, marine, and amphibian species; have a special role in supporting estuarine fisheries; provide shelter, refuge and food for many forms of wildlife."@en ;
    skos:prefLabel "mangrove"@en .

<http://www.eionet.europa.eu/gemet/concept/4999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14194> ;
    skos:definition "A wet, spongy area of land in tropical climates and along coastal regions that is dominated by mangrove trees and shrubs, particularly red mangroves (Rhizophora), black mangroves (Avicennia) and white mangroves (Laguncularia)."@en ;
    skos:prefLabel "mangrove swamp"@en .

<http://www.eionet.europa.eu/gemet/concept/500> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2009> ;
    skos:definition "Authorization or permission for setting up or making adjustments to a building or to a mechanical or electrical system or apparatus."@en ;
    skos:prefLabel "approval of installations"@en .

<http://www.eionet.europa.eu/gemet/concept/5000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1464> ;
    skos:definition "Man-made climate changes may be due to the greenhouse effect and other human activities. A change in albedo of the land brought about by desertification and deforestation affects the amount of solar energy absorbed at the earth's surface. Man-made aerosols produced from the sulphur released from power stations can modify clouds. Changes in ozone levels in the stratosphere due to CFCs may influence climate."@en ;
    skos:prefLabel "man-made climate change"@en .

<http://www.eionet.europa.eu/gemet/concept/5006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The process or act of exchanging, buying or selling any manufactured product, or the raw materials for any manufacturing process."@en ;
    skos:prefLabel "manufacturing trade"@en .

<http://www.eionet.europa.eu/gemet/concept/5009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:prefLabel "manure production"@en .

<http://www.eionet.europa.eu/gemet/concept/5014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5013> ;
    skos:definition "Maps of lichens distribution indicating air quality. Fruticose lichens (with branched structures well above the surface) are more susceptible to SO2 damage than foliose lichens (whose leaflike thallus lies nearly flat on surface) and both in turn are more susceptible than crustose lichens (which embed their tissue in the cracks of bark, soil, or rocks). The use of morphological lichen types as indicators of air pollution concentrations is well developed."@en ;
    skos:prefLabel "mapping of lichens"@en .

<http://www.eionet.europa.eu/gemet/concept/5018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7298> ;
    skos:definition "Metamorphic rock composed of recrystallized calcite or dolomite."@en ;
    skos:prefLabel "marble"@en .

<http://www.eionet.europa.eu/gemet/concept/5023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Low quality land the value of whose production barely covers its cultivation costs."@en ;
    skos:prefLabel "marginal land"@en .

<http://www.eionet.europa.eu/gemet/concept/5024> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:definition "Cultivation of marine organisms in their natural habitats, usually for commercial purposes."@en ;
    skos:prefLabel "mariculture"@en .

<http://www.eionet.europa.eu/gemet/concept/5025> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3834> ;
    skos:definition "A small port that is used for pleasure rather than trade, often with hotels, restaurants and bars."@en ;
    skos:prefLabel "marina"@en .

<http://www.eionet.europa.eu/gemet/concept/5027> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "A branch of biology that deals with those living organisms which inhabit the sea."@en ;
    skos:prefLabel "marine biology"@en .

<http://www.eionet.europa.eu/gemet/concept/5029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Any section of a sea or ocean designated for special protection, often to prevent or reduce harm to its wildlife and ecosystems."@en ;
    skos:prefLabel "marine conservation area"@en .

<http://www.eionet.europa.eu/gemet/concept/5030> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "An integrative science that studies the basic structural and functional relationships within and among living populations and their physical-chemical environments in marine ecosystems. Marine ecology focuses on specific organisms as well as on particular environments or physical settings."@en ;
    skos:prefLabel "marine ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/5032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The design, construction, installation, operation, and maintenance of main power plants, as well as the associated auxiliary machinery and equipment, for the propulsion of ships."@en ;
    skos:prefLabel "marine engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/5033> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5498> ;
    skos:definition "Marine environments include estuaries, coastal marine and nearshore zones, and open-ocean-deep-sea regions."@en ;
    skos:prefLabel "marine environment"@en .

<http://www.eionet.europa.eu/gemet/concept/5034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3138> ;
    skos:definition "Animals which live in the sea."@en ;
    skos:prefLabel "marine fauna"@en .

<http://www.eionet.europa.eu/gemet/concept/5038> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "That aspect of the study of the ocean that deals specifically with the ocean floor and the ocean-continent border, including submarine relief features, the geochemistry and petrology of the sediments and rocks of the ocean bottom and the influence of seawater and waves on the ocean bottom and its materials."@en ;
    skos:prefLabel "marine geology"@en .

<http://www.eionet.europa.eu/gemet/concept/504> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The study of the relationships among aquatic living organisms and between those organisms and their environment."@en ;
    skos:prefLabel "aquatic ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/5042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9196> ;
    skos:definition "The assessment of marine pollution by an integrated chemical, ecological and toxicological survey."@en ;
    skos:prefLabel "marine monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/5046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10212> ;
    skos:definition "Sea area where marine wildlife is protected."@en ;
    skos:prefLabel "marine reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/5048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:prefLabel "marine resources conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/5049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition "Solid fragmental material, originated from weathering of rocks, that has settled down from a state of suspension in the water."@en ;
    skos:prefLabel "marine sediment"@en .

<http://www.eionet.europa.eu/gemet/concept/5052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11289> ;
    skos:definition "Travelling on the sea by means of boats, ships, etc."@en ;
    skos:prefLabel "maritime navigation"@en .

<http://www.eionet.europa.eu/gemet/concept/5055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9245> ;
    skos:definition "Transportation of goods or persons by means of ships travelling on the sea."@en ;
    skos:prefLabel "maritime transport"@en .

<http://www.eionet.europa.eu/gemet/concept/5061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2508> ;
    skos:definition "A mixed economy that relies heavily on markets to answer the three basic questions of allocation, but with a modest amount of government involvement. While it is commonly termed capitalism, market-oriented economy is much more descriptive of how the economy is structured."@en ;
    skos:prefLabel "market economy"@en .

<http://www.eionet.europa.eu/gemet/concept/5062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5058> ;
    skos:definition "The organizational form or structure of the trade or traffic of a particular commodity."@en ;
    skos:prefLabel "market form"@en .

<http://www.eionet.europa.eu/gemet/concept/5068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5064> ;
    skos:definition "The systematic gathering, recording, computing, and analysing of data about problems relating to the sale and distribution of goods and services for certain time periods."@en ;
    skos:prefLabel "market research"@en .

<http://www.eionet.europa.eu/gemet/concept/5076> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "Type of Australian mammal with a pouch in which the young are carried. Marsupials give birth to young at a much earlier stage of development than other mammals so that the young need to be protected in the mother's pouch for some months until they become able to look after themselves."@en ;
    skos:prefLabel "marsupial"@en .

<http://www.eionet.europa.eu/gemet/concept/5080> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "A pastime, diversion, exercise or other means of enjoyment and relaxation that is shared with or performed by a large number of people."@en ;
    skos:prefLabel "mass recreation"@en .

<http://www.eionet.europa.eu/gemet/concept/5081> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The separation of one substance from another when they are intimately mixed. For example the removal of oil from water, or gas from oil or oil from gas, etc."@en ;
    skos:prefLabel "separation"@en .

<http://www.eionet.europa.eu/gemet/concept/5083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8650> ;
    skos:definition "The movement of matter in a medium."@en ;
    skos:prefLabel "mass transport (physics)"@en .

<http://www.eionet.europa.eu/gemet/concept/5094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "The complex of tests performed in order to ascertain the characteristics and behaviour of materials; they are classified in physical and chemical tests, mechanical tests and technological tests."@en ;
    skos:prefLabel "testing of materials"@en .

<http://www.eionet.europa.eu/gemet/concept/5099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7702> ;
    skos:prefLabel "mathematical method"@en .

<http://www.eionet.europa.eu/gemet/concept/51> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/636> ;
    skos:definition "Rain having a pH less than 5.6. The acidity results from chemical reactions occurring when water, sulphur dioxide, and nitrogen oxides, generally released by industrial processes, are chemically transformed into sulphuric and nitric acids."@en ;
    skos:prefLabel "acid rain"@en .

<http://www.eionet.europa.eu/gemet/concept/510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5228> ;
    skos:definition "Microorganisms having a water habitat."@en ;
    skos:prefLabel "aquatic micro-organism"@en .

<http://www.eionet.europa.eu/gemet/concept/5107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The maximum exposure to a physical or chemical agent allowed in an 8-hour work day to prevent disease or injury."@en ;
    skos:prefLabel "maximum admissible concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/5108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The maximum concentration of air polluting substances in the free environment whose impact when of specified duration and frequency is not objectionable to man, fauna and flora."@en ;
    skos:prefLabel "maximum immission concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/5123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119>,
        <http://www.eionet.europa.eu/gemet/concept/5122> ;
    skos:prefLabel "measuring programme"@en .

<http://www.eionet.europa.eu/gemet/concept/5124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "The edible flesh of animals, especially that of mammals as opposed to that of fish or a nut."@en ;
    skos:prefLabel "meat"@en .

<http://www.eionet.europa.eu/gemet/concept/5128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The branch of engineering concerned with the design, construction, and operation of machines."@en ;
    skos:prefLabel "mechanical engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/5137> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6179> ;
    skos:prefLabel "discarded medicinal drug"@en .

<http://www.eionet.europa.eu/gemet/concept/5138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants having therapeutic properties."@en ;
    skos:prefLabel "medicinal plant"@en .

<http://www.eionet.europa.eu/gemet/concept/5147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9349> ;
    skos:definition "A plant formation found in the Mediterranean area comprising mainly lowgrowing, xerophilous evergreen trees and shrubs. It results mainly from the deterioration of the original vegetation by grazing and burning."@en ;
    skos:prefLabel "Mediterranean wood"@en .

<http://www.eionet.europa.eu/gemet/concept/5148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "A change of the state of a substance from the solid phase to the liquid phase. Also known as fusion."@en ;
    skos:prefLabel "melting"@en .

<http://www.eionet.europa.eu/gemet/concept/5150> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8494> ;
    skos:definition "A thin tissue that encloses or lines biological cells, organs, or other structures. It consists of a double layer of lipids with protein molecules between the two layers. Membranes are permeable to water and fat-soluble substances but not to such polar molecules as sugars."@en ;
    skos:prefLabel "membrane"@en .

<http://www.eionet.europa.eu/gemet/concept/5154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A heavy silvery-white toxic liquid metallic element occurring principally in cinnabar: used in thermometers, barometers, mercury-vapour lamps, and dental amalgams."@en ;
    skos:prefLabel "mercury"@en .

<http://www.eionet.europa.eu/gemet/concept/5155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11676> ;
    skos:definition "The presence and release into the air, water and soil of mercury, a naturally occurring heavy metal element, by both natural occurrences such as vaporization and human activities such as burning coal, mining and smelting."@en ;
    skos:prefLabel "mercury contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8014> ;
    skos:prefLabel "aquatic recreational amenity"@en .

<http://www.eionet.europa.eu/gemet/concept/5163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/766> ;
    skos:definition "The sum of chemical reactions, including both synthesis and breakdown, that occurs in substances or mixtures intended to prevent, destroy or mitigate pests that are directly or indirectly detrimental to harvest crops and other humans interests."@en ;
    skos:prefLabel "metabolism of pesticides"@en .

<http://www.eionet.europa.eu/gemet/concept/5165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "A product of intermediary metabolism."@en ;
    skos:prefLabel "metabolite"@en .

<http://www.eionet.europa.eu/gemet/concept/5167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4307> ;
    skos:definition "Data assembled to describe or define another body of data, a document or any information element."@en ;
    skos:prefLabel "metainformation"@en .

<http://www.eionet.europa.eu/gemet/concept/5169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5187> ;
    skos:definition "A process in which a chemical or some other substance is applied to metals as a way to clean, protect, alter or modify appearance or physical properties, especially surface properties."@en ;
    skos:prefLabel "metal finishing"@en .

<http://www.eionet.europa.eu/gemet/concept/517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4082> ;
    skos:definition "A channel for supplying water; often underground, but treated architecturally on high arches when crossing valleys or low ground."@en ;
    skos:prefLabel "aqueduct"@en .

<http://www.eionet.europa.eu/gemet/concept/5179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5187> ;
    skos:definition "Forming a thin, adherent layer of metal on an object."@en ;
    skos:prefLabel "metal plating"@en .

<http://www.eionet.europa.eu/gemet/concept/518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9151> ;
    skos:definition "Layers of rock, sand or gravel that can absorb water and allow it to flow. An aquifer acts as a groundwater reservoir when the underlying rock is impermeable. This may be tapped by wells for domestic, agricultural or industrial use. A serious environmental problem arises when the aquifer is contaminated by the seepage of sewage or toxins from waste dumps. If the groundwater in coastal areas is over-used salt water can seep into the aquifer."@en ;
    skos:prefLabel "aquifer"@en .

<http://www.eionet.europa.eu/gemet/concept/5186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5187> ;
    skos:definition "A metallurgical process in which ore mixtures are heated above melting point to extract or yield a crude metal."@en ;
    skos:prefLabel "metal smelting"@en .

<http://www.eionet.europa.eu/gemet/concept/5193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5496> ;
    skos:definition "Violent, sudden and destructive change to the environment related to, produced by, or affecting the earth's atmosphere, especially the weather-forming processes."@en ;
    skos:prefLabel "meteorological disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/5195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Variables, such as pressure, temperature, wind strength, humidity, etc. from which conclusions as to the forthcoming weather are drawn."@en ;
    skos:prefLabel "meteorological parameter"@en .

<http://www.eionet.europa.eu/gemet/concept/5199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/322> ;
    skos:definition "A colourless, odourless, and tasteless gas, lighter than air and reacting violently with chlorine and bromine in sunlight, a chief component of natural gas; used as a source of methanol, acetylene, and carbon monoxide. Also known as methyl hydride."@en ;
    skos:prefLabel "methane"@en .

<http://www.eionet.europa.eu/gemet/concept/521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Growing crops as opposed to dairy farming, cattle farming, etc."@en ;
    skos:prefLabel "arable farming"@en .

<http://www.eionet.europa.eu/gemet/concept/5210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8797> ;
    skos:definition "A term applied loosely to any large city, but specifically to that city in a country which is the seat of government, of ecclesiastical authority, or of commercial activity."@en ;
    skos:prefLabel "metropolis"@en .

<http://www.eionet.europa.eu/gemet/concept/5215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/873> ;
    skos:definition "Any available source of supply derived from microbes, which would be used for beneficial purposes, such as for the production of food substances and drugs."@en ;
    skos:prefLabel "microbial resource"@en .

<http://www.eionet.europa.eu/gemet/concept/5216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/841> ;
    skos:definition "Analysis for the identification of viruses, bacteria, fungi and parasites."@en ;
    skos:prefLabel "microbiological analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/5218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The science and study of microorganisms, including protozoans, algae, fungi, bacteria, viruses, and rickettsiae."@en ;
    skos:prefLabel "microbiology"@en .

<http://www.eionet.europa.eu/gemet/concept/5219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "The local, rather uniform climate of a specific place or habitat, compared with the climate of the entire area of which it is a part."@en ;
    skos:prefLabel "microclimate"@en .

<http://www.eionet.europa.eu/gemet/concept/5220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1464> ;
    skos:prefLabel "microclimate effect"@en .

<http://www.eionet.europa.eu/gemet/concept/5221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1479> ;
    skos:definition "The study of a microclimate, including the study of profiles of temperature, moisture and wind in the lowest stratum of air, the effects of the vegetation and of shelterbelts, and the modifying effects of towns and buildings."@en ;
    skos:prefLabel "microclimatology"@en .

<http://www.eionet.europa.eu/gemet/concept/5222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2633> ;
    skos:definition "A microprocessor combined with input/output interface devices, some type of external memory, and the other elements required to form a working computer system; it is smaller, lower in cost, and usually slower than a minicomputer."@en ;
    skos:prefLabel "microcomputer"@en .

<http://www.eionet.europa.eu/gemet/concept/5224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "A small-scale, simplified, experimental ecosystem, laboratory- or field- based, which may be: a) derived directly from nature (e.g. when samples of pond water are maintained subsequently by the input of artificial light and gas-exchange); or b) built up from axenic cultures (a culture of an organism that consists of one type of organism only, i.e. that is free from any contaminating organism) until the required conditions of organisms and environment are achieved. Also known as microcosm."@en ;
    skos:prefLabel "microecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2624> ;
    skos:definition "The technology of constructing circuits and devices in extremely small packages by various techniques. Also known as microminiaturization; microsystem electronics."@en ;
    skos:prefLabel "microelectronics"@en .

<http://www.eionet.europa.eu/gemet/concept/5226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3190> ;
    skos:definition "The separation or removal from a liquid of particulates and microorganisms in the size range of 0.1 to 0.2 microns in diameter."@en ;
    skos:prefLabel "microfiltration"@en .

<http://www.eionet.europa.eu/gemet/concept/5229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Pollutant which exists in very small traces in water."@en ;
    skos:prefLabel "micropollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/5230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "The interpretative application of microscope magnification to the study of materials that cannot be properly seen by the unaided eye."@en ;
    skos:prefLabel "microscopy"@en .

<http://www.eionet.europa.eu/gemet/concept/5231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5674>,
        <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "An electromagnetic wave which has a wavelength between about 0.3 and 30 centimeters, corresponding to frequencies of 1-100 gigahertz; however there are no sharp boundaries between microwaves and infrared and radio waves."@en ;
    skos:prefLabel "microwave"@en .

<http://www.eionet.europa.eu/gemet/concept/5234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4581> ;
    skos:definition "Temporary employment performed by persons who move from place to place, such as agricultural workers following crop seasons."@en ;
    skos:prefLabel "migrant labour"@en .

<http://www.eionet.europa.eu/gemet/concept/5237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "Movements that particular animals carry out regularly often between breeding places and winter feeding grounds."@en ;
    skos:prefLabel "animal migration"@en .

<http://www.eionet.europa.eu/gemet/concept/5238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "Birds which migrate in a body."@en ;
    skos:prefLabel "migratory bird"@en .

<http://www.eionet.europa.eu/gemet/concept/5239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10073> ;
    skos:prefLabel "migratory species"@en .

<http://www.eionet.europa.eu/gemet/concept/5245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/282> ;
    skos:definition "Air traffic of or relating to the armed forces."@en ;
    skos:prefLabel "military air traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/5253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1065> ;
    skos:definition "Area whose utilization is exclusively reserved to the army."@en ;
    skos:prefLabel "military zone"@en .

<http://www.eionet.europa.eu/gemet/concept/5254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1952> ;
    skos:definition "The whitish fluid secreted by the mammary gland for the nourishment of the young; composed of carbohydrates, proteins, fats. mineral salts, vitamins, and antibodies."@en ;
    skos:prefLabel "milk"@en .

<http://www.eionet.europa.eu/gemet/concept/5261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5286> ;
    skos:definition "An opening or excavation in the earth for extracting minerals."@en ;
    skos:prefLabel "mine"@en .

<http://www.eionet.europa.eu/gemet/concept/5262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5295> ;
    skos:definition "Filling of disused mines with soil, crushed stone, or waste materials in order to restore the geological, agricultural and landscape features of the concerned area."@en ;
    skos:prefLabel "mine filling"@en .

<http://www.eionet.europa.eu/gemet/concept/5265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "The process of extracting metallic or nonmetallic mineral deposits from the Earth."@en ;
    skos:prefLabel "mineral extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/5268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the exploitation of minerals from soil deposits by underground excavations or open workings, employing adequate plants and equipment."@en ;
    skos:prefLabel "mineral industry"@en .

<http://www.eionet.europa.eu/gemet/concept/5269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "The process of fossilization whereby inorganic materials replace the organic constituent of an organism."@en ;
    skos:prefLabel "mineralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "The planting and care of woody plants, especially trees."@en ;
    skos:prefLabel "arboriculture"@en .

<http://www.eionet.europa.eu/gemet/concept/5274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:definition "Valuable mineral deposits of an area that are presently recoverable and may be so in the future; includes known ore bodies and potential ore."@en ;
    skos:prefLabel "mineral resource"@en .

<http://www.eionet.europa.eu/gemet/concept/5279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water containing naturally or artificially supplied minerals or gases."@en ;
    skos:prefLabel "mineral water"@en .

<http://www.eionet.europa.eu/gemet/concept/5282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2497> ;
    skos:definition "The process of making arrangements or preparations to facilitate the production of goods or services at an output that would require the lowest possible expenditure of money, time or labor."@en ;
    skos:prefLabel "minimal cost planning"@en .

<http://www.eionet.europa.eu/gemet/concept/5283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4160> ;
    skos:definition "The activity of reducing the harm or injury done to the environment or ecosystem."@en ;
    skos:prefLabel "minimisation of damage"@en .

<http://www.eionet.europa.eu/gemet/concept/5287> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "Engineering concerned with the discovery, development and exploitation of coal, ores, and minerals, as well as the cleaning, sizing and dressing of the product."@en ;
    skos:prefLabel "mining engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/5289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3090> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the extraction of minerals occurring naturally, often involving quarrying, well operations, milling, exploration and development."@en ;
    skos:prefLabel "mining industry"@en .

<http://www.eionet.europa.eu/gemet/concept/529> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Any location containing significant relics and artifacts of past culture."@en ;
    skos:prefLabel "archaeological site"@en .

<http://www.eionet.europa.eu/gemet/concept/5290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the potentially harmful activity of enterprises concerned with the extraction and processing of precious or valuable metals."@en ;
    skos:prefLabel "mining law"@en .

<http://www.eionet.europa.eu/gemet/concept/5293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A rule or order prescribed by government or management to promote the safety, legality or ecological responsibility of any aspect of the process or industry of ore extraction."@en ;
    skos:prefLabel "mining regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/5297> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any residue which results from the extraction of raw materials from the earth."@en ;
    skos:prefLabel "mining waste"@en .

<http://www.eionet.europa.eu/gemet/concept/5298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2020> ;
    skos:definition "A formal judgment or mandate handed down on a specific issue or concern from a major administrative department of a state, usually under the authority of that department's chief minister, secretary or administrator."@en ;
    skos:prefLabel "ministerial decree"@en .

<http://www.eionet.europa.eu/gemet/concept/5299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12913> ;
    skos:definition "The body of top government administrators or other high ranking public officials that are selected by a head of state to manage certain aspects of a state's affairs, as opposed to civil servants whose tenure is unaffected by public changes resulting from democratic elections or some other process."@en ;
    skos:prefLabel "ministry"@en .

<http://www.eionet.europa.eu/gemet/concept/530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The scientific study of the material remains of the cultures of historical or prehistorical peoples."@en ;
    skos:prefLabel "archaeology"@en .

<http://www.eionet.europa.eu/gemet/concept/5307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The tendency or capacity of two or more liquids to form a uniform blend, that is, to dissolve in each other; degrees are total miscibility, partial miscibility, and immiscibility."@en ;
    skos:prefLabel "miscibility"@en .

<http://www.eionet.europa.eu/gemet/concept/531> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4514> ;
    skos:definition "A chain of many islands including the waters that surround them."@en ;
    skos:prefLabel "archipelago"@en .

<http://www.eionet.europa.eu/gemet/concept/5310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1296> ;
    skos:definition "An order of small Arachnida with rounded bodies. Mites are very abundant in the soil, feeding on plant material and invertebrate animals. Some parasitic mites (e.g. red spider) damage crops and can be serious pests. Others cause diseases in animals. Ticks are blood-suckers, some being vectors of diseases such as Rocky Mountain spotted fever in humans and fowls, and louping ill in cattle and sheep."@en ;
    skos:prefLabel "mite"@en .

<http://www.eionet.europa.eu/gemet/concept/5311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "Any procedure or action undertaken to reduce the adverse impacts that a project or activity may have on the environment."@en ;
    skos:prefLabel "mitigation measure"@en .

<http://www.eionet.europa.eu/gemet/concept/5313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Type of agriculture based on the combination of crop production and cattle raising."@en ;
    skos:prefLabel "mixed farming"@en .

<http://www.eionet.europa.eu/gemet/concept/5316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A forest composed of several tree species."@en ;
    skos:prefLabel "mixed forest"@en .

<http://www.eionet.europa.eu/gemet/concept/5318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The intermingling of different materials to produce a homogeneous mixture."@en ;
    skos:prefLabel "mixing"@en .

<http://www.eionet.europa.eu/gemet/concept/5322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "Living quarters mounted on wheels and capable of being towed by a motor vehicle."@en ;
    skos:prefLabel "mobile home"@en .

<http://www.eionet.europa.eu/gemet/concept/5332> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition """1) The water vapour content of the atmosphere, or the total water substances (gaseous, liquid and solid) present in a given volume of air. 
2) Water that is dispersed through a gas in the form of water vapour or small droplets, dispersed through a solid, or condensed on the surface of a solid."""@en ;
    skos:prefLabel "moisture"@en .

<http://www.eionet.europa.eu/gemet/concept/5333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The study of the chemical structures and processes of biological phenomena at the molecular level; the discipline is particularly concerned with the study of proteins, nucleic acids, and enzymes, the macromolecules essential to life processes. It seeks to understand the molecular basis of genetic processes. Techniques used include X-ray diffraction and electron microscopy."@en ;
    skos:prefLabel "molecular biology"@en .

<http://www.eionet.europa.eu/gemet/concept/5343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13151> ;
    skos:definition "Financial determination, adjustment, estimation, or appraisal for purposes of levying a tax, charge or fine."@en ;
    skos:prefLabel "monetary assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/5347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:prefLabel "monitoring criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/5350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "Interconnected group of monitoring stations for the surveillance of pollution."@en ;
    skos:prefLabel "monitoring network"@en .

<http://www.eionet.europa.eu/gemet/concept/5352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "Station where the presence, effect, or level of any polluting substance in air or water, noise and blasting, radiation, transport movements, land subsidence, or change in the character of vegetation are measured quantitatively or qualitatively."@en ;
    skos:prefLabel "monitoring station"@en .

<http://www.eionet.europa.eu/gemet/concept/5353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "A coordinated body of sensory and communications devices that observes, detects or records the outputs or operations of any natural or artificial system in order to construct a history or future of events."@en ;
    skos:prefLabel "monitoring system"@en .

<http://www.eionet.europa.eu/gemet/concept/5357> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13263> ;
    skos:definition "The market condition where a particular commodity or service has only one seller, either because the seller has exclusive possession of an essential input or because large economies of scale inhibit the entrance of a competitor into the market."@en ;
    skos:prefLabel "monopoly"@en .

<http://www.eionet.europa.eu/gemet/concept/5360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "An object, especially large and made of stone, built to remember and show respect to a person or group of people, or a special place made for this purpose."@en ;
    skos:prefLabel "monument"@en .

<http://www.eionet.europa.eu/gemet/concept/5362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "A tract of unenclosed waste ground, usually covered with heather, coarse grass, bracken, and moss."@en ;
    skos:prefLabel "moor"@en .

<http://www.eionet.europa.eu/gemet/concept/5364> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7793> ;
    skos:definition "Appealing to the ethical principles or beliefs of an adversary or the public to convince the adversary to change behavior or attitudes."@en ;
    skos:prefLabel "moral persuasion"@en .

<http://www.eionet.europa.eu/gemet/concept/5369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The branch of biology concerned with the form and structure of organisms."@en ;
    skos:prefLabel "morphology"@en .

<http://www.eionet.europa.eu/gemet/concept/5377> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1023> ;
    skos:definition "Any plant of the class Bryophyta, occurring in nearly all damp habitats."@en ;
    skos:prefLabel "moss"@en .

<http://www.eionet.europa.eu/gemet/concept/5384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:prefLabel "motorcycle"@en .

<http://www.eionet.europa.eu/gemet/concept/5392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8929> ;
    skos:definition "Gases vented to the atmosphere by internal-combustion-engine driven vehicles."@en ;
    skos:prefLabel "motor vehicle exhaust gas"@en .

<http://www.eionet.europa.eu/gemet/concept/5395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "A wide road built for fast moving traffic travelling long distances, with a limited number of points at which drivers can enter and leave it."@en ;
    skos:prefLabel "motorway"@en .

<http://www.eionet.europa.eu/gemet/concept/54> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3184> ;
    skos:definition "A device employed to reject sound in a particular range of frequencies while passing sound in another range of frequencies."@en ;
    skos:prefLabel "acoustic filter"@en .

<http://www.eionet.europa.eu/gemet/concept/5403> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "Ecosystems found on high-mountains at low latitudes. Mountain ecosystems are very vulnerable. They are increasingly sensitive to soil erosion, landslide and rapid loss of habitat and genetic diversity. Widespread poverty and an increase in the numbers of mountain inhabitants lead to deforestation, cultivation of marginal lands, excessive livestock grazing, loss of biomass cover and other forms of environmental degradation. Because little is known about mountain ecosystems, Agenda 21 has proposed the establishment of a global mountain database. This is essential for the launch of programmes that would contribute to the sustainable development of mountain ecosystems. The proposals also focus on promoting watershed development and alternative employment for people whose livelihoods are linked to practices that degrade mountains."@en ;
    skos:prefLabel "mountain ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:prefLabel "mountaineering"@en .

<http://www.eionet.europa.eu/gemet/concept/5409> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:definition "A single, large mass consisting of a succession of mountains or narrowly spaced mountain ridges, with or without peaks, closely related in position, direction, formation, and age."@en ;
    skos:prefLabel "mountain range"@en .

<http://www.eionet.europa.eu/gemet/concept/541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6362> ;
    skos:prefLabel "Arctic ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The cutting down of grass, crops or grain with a scythe or a mechanical device."@en ;
    skos:prefLabel "mowing"@en .

<http://www.eionet.europa.eu/gemet/concept/5415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "A relatively level area of fine silt along a shore (as in a sheltered estuary) or around an island, alternately covered and uncovered by the tide, or covered by shallow water."@en ;
    skos:prefLabel "mud flat"@en .

<http://www.eionet.europa.eu/gemet/concept/5417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition "A mixture of clay and/or silt with water to form a plastic mass with a particle size preponderantly below 0.06 mm diameter. It is deposited in low-energy environments in lakes, estuaries and lagoons. It may also be deposited in deep-sea environments."@en ;
    skos:prefLabel "mud (sediment)"@en .

<http://www.eionet.europa.eu/gemet/concept/5418> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "A layer of organic material applied to the surface of the ground to retain moisture; mulching is the spreading of leaves, straw or other loose material on the ground to prevent erosion, evaporation or freezing of plant roots."@en ;
    skos:prefLabel "mulch"@en .

<http://www.eionet.europa.eu/gemet/concept/5419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4417> ;
    skos:definition "Multilateralism stands for a long-held but rarely achieved ideal, namely the voluntary co-operation of nations for peace and development. Multilateral initiatives are undermined or diluted by ultra-nationalist, bilateral and regional initiatives. Multilateralism may be undercut by the uncoordinated decisions of those contributing to it. Multilateralism constitutes the democracy of international society. An enlightened multilateralism enhances the specific interests of states while advancing their common cause."@en ;
    skos:prefLabel "multilateral agreement"@en .

<http://www.eionet.europa.eu/gemet/concept/5421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "A large business company operating in several countries."@en ;
    skos:prefLabel "multinational firm"@en .

<http://www.eionet.europa.eu/gemet/concept/5424> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition """1) Coordinated management for the most judicious and harmonious use of the land on a long term basis under the concept of combining two or more uses and/or purposes with attention to sustainability and nonimpairment of the natural resources and land area.
2) Use of land for more than one purpose; e.g. grazing of livestock, watershed and wildlife protection, recreation, and timber production."""@en ;
    skos:prefLabel "multiple use management area"@en .

<http://www.eionet.europa.eu/gemet/concept/5429> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5428> ;
    skos:definition "Removal for treatment or disposal of those residues that can be regarded as waste including removal of litter from public places, public thoroughfares or the countryside."@en ;
    skos:prefLabel "municipal cleansing service"@en .

<http://www.eionet.europa.eu/gemet/concept/5430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "The guiding procedure, philosophy or course of action regarding the protection of natural resources in local settings, cities or towns."@en ;
    skos:prefLabel "municipal environmental policy"@en .

<http://www.eionet.europa.eu/gemet/concept/5431> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8062> ;
    skos:definition "A town, city, or other district having powers of local self-government."@en ;
    skos:prefLabel "municipality"@en .

<http://www.eionet.europa.eu/gemet/concept/5432> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "Broadly, a law or body of laws that pertains solely to the citizens and inhabitants of a state; narrowly, a law or body of laws pertaining to towns, cities, villages and their local governments."@en ;
    skos:prefLabel "municipal law"@en .

<http://www.eionet.europa.eu/gemet/concept/5433> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "The jurisdiction, position or status of city, town or local government."@en ;
    skos:prefLabel "municipal level"@en .

<http://www.eionet.europa.eu/gemet/concept/5439> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "Any publicly or privately organized setup in which water is processed at a central plant and delivered to homes and businesses via water pipes."@en ;
    skos:prefLabel "municipal water distribution system"@en .

<http://www.eionet.europa.eu/gemet/concept/5440> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "Municipal water management deals with aspects of water supply and water technology concerning planning, processing, building and producing. It also concerns the problems of waste water collection, sewage disposal, waste water treatment in rural areas, water economising measures, water body quality management."@en ;
    skos:prefLabel "municipal water management"@en .

<http://www.eionet.europa.eu/gemet/concept/5443> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The muscle cells, tissues, and organs that effect movement in all vertebrates."@en ;
    skos:prefLabel "muscular system"@en .

<http://www.eionet.europa.eu/gemet/concept/5448> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/733> ;
    skos:definition "A family of Basidiomycetes that are characterized by the production of spores on gills."@en ;
    skos:prefLabel "mushroom"@en .

<http://www.eionet.europa.eu/gemet/concept/5449> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "The artistic organization of sounds or tones that expresses ideas and emotions through the elements of rhythm, melody, harmony and tonal color."@en ;
    skos:prefLabel "music"@en .

<http://www.eionet.europa.eu/gemet/concept/5452> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "A large, diverse family of low-slung, long-bodied carnivorous mammals including minks, weasels, and badgers; distinguished by having only one molar in each upper jaw, and two at the most in the lower jaw."@en ;
    skos:prefLabel "mustelid"@en .

<http://www.eionet.europa.eu/gemet/concept/5456> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3872> ;
    skos:definition "The property of chemical or physical agents of inducing changes in genetic material that are transmitted during cell division."@en ;
    skos:prefLabel "mutagenicity"@en .

<http://www.eionet.europa.eu/gemet/concept/5457> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Testing the property of a substance of being able to induce genetic mutation."@en ;
    skos:prefLabel "mutagenicity testing"@en .

<http://www.eionet.europa.eu/gemet/concept/5459> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "An agent that raises the frequency of mutation above the spontaneous rate. An agent that causes changes to plants and animals, particularly to their genetic material and especially at the time of reproduction. Certain chemicals and forms of radiation are powerful mutagens that damage the DNA, or genetic material in the centre of every cell of a living organism."@en ;
    skos:prefLabel "mutagen"@en .

<http://www.eionet.europa.eu/gemet/concept/5460> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5462> ;
    skos:definition "An individual bearing an allele that has undergone mutation and is expressed in the phenotype."@en ;
    skos:prefLabel "mutant"@en .

<http://www.eionet.europa.eu/gemet/concept/5461> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7097> ;
    skos:definition "The release of mutated micro-organisms creates the risk that they may exhibit some previously unknown pathogenicity, might take over from some naturally occurring bacteria (possibly having other positive functions which thus are lost) or pass on some unwanted trait to such indigenous bacteria. There is also concern that an uncontrolled genetic mutation could produce from such an engineered microorganism, a form with hazardous consequences for the environment."@en ;
    skos:prefLabel "mutated micro-organisms release"@en .

<http://www.eionet.europa.eu/gemet/concept/5463> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/971> ;
    skos:definition "The branch of botany concerned with the study of fungi."@en ;
    skos:prefLabel "mycology"@en .

<http://www.eionet.europa.eu/gemet/concept/5465> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "The symbiotic association of the root of a higher plant with a fungus. In an ectotrophic mycorrhiza (e.g., heath, pine trees) the fungal mycelium covers the outside of the roots; in an endotrophic mycorrhiza (e.g. orchids) the fungus grows inside the cells of the root cortex."@en ;
    skos:prefLabel "mycorrhiza"@en .

<http://www.eionet.europa.eu/gemet/concept/547> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12783> ;
    skos:definition "Area which is supposedly causing dangers to human health and environment."@en ;
    skos:prefLabel "area of potential pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/5474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6705> ;
    skos:prefLabel "national conservation programme"@en .

<http://www.eionet.europa.eu/gemet/concept/5475> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2508> ;
    skos:definition "A nation's financial resources and its financial management, with a view towards its productivity."@en ;
    skos:prefLabel "national economy"@en .

<http://www.eionet.europa.eu/gemet/concept/5478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:prefLabel "cultural goods"@en .

<http://www.eionet.europa.eu/gemet/concept/5479> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The transfer of ownership of a private business or other private property to a national government, either through uncompensated seizure (expropriation) or through forced sale at a government-determined price."@en ;
    skos:prefLabel "nationalisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5482> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:definition "A binding rule or body of rules prescribed by the government of a sovereign state that holds force throughout the regions and territories within the government's dominion."@en ;
    skos:prefLabel "national legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/5484> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Areas of outstanding natural beauty, set aside for the conservation of flora, fauna and scenery, and for recreation, if this does not conflict with the conservation objectives of the parks and their landscapes. Hunting, logging, mining, commercial fishing, agriculture and livestock grazing are all controlled within national parks, as is industrial activity."@en ;
    skos:prefLabel "national park"@en .

<http://www.eionet.europa.eu/gemet/concept/5486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The step by step method and process of defining, developing and outlining various possible courses of actions to meet existing or future needs, goals and objectives for a country or a large body of people associated with a particular territory, often sharing similar ethnic backgrounds, customs and language."@en ;
    skos:prefLabel "national planning"@en .

<http://www.eionet.europa.eu/gemet/concept/5489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:prefLabel "national reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/5497> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11231> ;
    skos:prefLabel "natural drainage system"@en .

<http://www.eionet.europa.eu/gemet/concept/55> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4518> ;
    skos:definition "The process of preventing the transmission of sound by surrounding with a nonconducting material."@en ;
    skos:prefLabel "acoustic insulation"@en .

<http://www.eionet.europa.eu/gemet/concept/5502> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A forest area that has developed free from the influence of humans and remains largely unaffected by their activities. The natural forest may include, but is not necessarily equivalent to, an old-growth forest."@en ;
    skos:prefLabel "natural forest"@en .

<http://www.eionet.europa.eu/gemet/concept/5503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "A natural fuel containing methane and hydrocarbons that occurs in certain geologic formations."@en ;
    skos:prefLabel "natural gas"@en .

<http://www.eionet.europa.eu/gemet/concept/5504> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5505> ;
    skos:definition "Underground prospection conducted with various methods to discover natural gas deposits which are usually found in the immediate vicinity of crude petroleum."@en ;
    skos:prefLabel "natural gas exploration"@en .

<http://www.eionet.europa.eu/gemet/concept/5506> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:definition "The probability of occurrence, within a specific period of time in a given area of a potentially damaging phenomenon of nature."@en ;
    skos:prefLabel "natural hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/5508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2818> ;
    skos:definition "A rule or body of rules that derives from nature and is believed to be binding upon human society, as opposed to human-made laws such as legislative acts and judicial decisions."@en ;
    skos:prefLabel "rights of nature"@en .

<http://www.eionet.europa.eu/gemet/concept/551> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in a climatic region where the annual precipitation averages less than 10 inches per year."@en ;
    skos:prefLabel "arid land ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "A natural/cultural feature which is of outstanding or unique value because of its inherent rarity, representative of aesthetic qualities or cultural significance. Guidance for selection of a natural monument is: a) The area should contain one or more features of outstanding significance (appropriate natural features include spectacular waterfalls, caves, craters, fossil beds, sand dunes and marine features, along with unique or representative fauna and flora; associated cultural features might include cave dwellings, cliff-top forts, archaeological sites, or natural sites which have heritage significance to indigenous peoples).; b) The area should be large enough to protect the integrity of the feature and its immediately related surroundings."@en ;
    skos:prefLabel "natural monument"@en .

<http://www.eionet.europa.eu/gemet/concept/5518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6925> ;
    skos:definition "Radiation stemming mainly from uranium, present in small amounts in many rocks, soils, building material, etc."@en ;
    skos:prefLabel "natural radioactivity"@en .

<http://www.eionet.europa.eu/gemet/concept/5520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:definition "The management of living and non-living resources in such a way as to sustain the maximum benefit for present and future generations."@en ;
    skos:prefLabel "natural resource conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/5523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "An area where human effects, if present, are not significant to the landscape as a whole."@en ;
    skos:prefLabel "natural scenery"@en .

<http://www.eionet.europa.eu/gemet/concept/5529> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "A gemstone that occurs in nature, as distinguished from a man-made substitute."@en ;
    skos:prefLabel "natural stone"@en .

<http://www.eionet.europa.eu/gemet/concept/5530> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:prefLabel "natural value"@en .

<http://www.eionet.europa.eu/gemet/concept/5536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5671> ;
    skos:prefLabel "nature conservation organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5537> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Active management of the earth's natural resources and environment to ensure their quality is maintained and that they are wisely used."@en ;
    skos:prefLabel "nature conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/5538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "A binding rule or body of rules prescribed by a government to protect, preserve or renew an area's natural habitats or ecosystem."@en ;
    skos:prefLabel "nature conservation legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/5539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2897> ;
    skos:definition "An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to preserve and protect elements of the natural world such as mountains, trees, animals or rivers."@en ;
    skos:prefLabel "nature conservation programme"@en .

<http://www.eionet.europa.eu/gemet/concept/5550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:definition "Any obstacle encountered by a vessel in route posing risk or danger to the vessel, its contents or the environment."@en ;
    skos:prefLabel "navigational hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/5554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "The pathologic death of living tissue in a plant or animal."@en ;
    skos:prefLabel "necrosis"@en .

<http://www.eionet.europa.eu/gemet/concept/5559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8794> ;
    skos:prefLabel "neighbourhood improvement scheme"@en .

<http://www.eionet.europa.eu/gemet/concept/556> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5243> ;
    skos:definition "The weapons, ammunition and equipment, or the total force held by a military unit or state."@en ;
    skos:prefLabel "armament"@en .

<http://www.eionet.europa.eu/gemet/concept/5565> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "A group of unsegmented worms which have been variously recognized as an order, class, and phylum."@en ;
    skos:prefLabel "nematode"@en .

<http://www.eionet.europa.eu/gemet/concept/5569> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "A coordinating and integrating system which functions in the adaptation of an organism to its environment; in vertebrates, the system consists of the brain, brainstem, spinal cord, cranial and peripheral nerves, and ganglia."@en ;
    skos:prefLabel "nervous system"@en .

<http://www.eionet.europa.eu/gemet/concept/557> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4441> ;
    skos:definition "Change in character, form or function of the arms and equipment with which a military unit is supplied."@en ;
    skos:prefLabel "armament conversion"@en .

<http://www.eionet.europa.eu/gemet/concept/5571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:definition "The total decrease in the amount of natural materials available for use by humans and other living beings."@en ;
    skos:prefLabel "net resource depletion"@en .

<http://www.eionet.europa.eu/gemet/concept/5572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4233> ;
    skos:definition "All emission sources in the same area that are owned or controlled by a single company are treated as one large source, thereby allowing flexibility in controlling individual sources in order to meet a single emissions standard."@en ;
    skos:prefLabel "netting policy (emissions trading)"@en .

<http://www.eionet.europa.eu/gemet/concept/5575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:definition "The occurrence of adverse effects on a nervous system following exposure to a chemical."@en ;
    skos:prefLabel "neurotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/5577> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "To make a solution neutral by adding a base to an acidic solution, or an acid to a basic solution."@en ;
    skos:prefLabel "neutralisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5580> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7791> ;
    skos:definition "A sociopolitical, religious, occupational or other group of common characteristics and interests formed as an alternative to social, and often residential, options currently available."@en ;
    skos:prefLabel "new community"@en .

<http://www.eionet.europa.eu/gemet/concept/5581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "A device, system, or piece of equipment that has been recently installed."@en ;
    skos:prefLabel "new installation"@en .

<http://www.eionet.europa.eu/gemet/concept/5583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "Novel high-performance materials obtained through the interdisciplinary research of chemistry, applied chemistry, chemical engineering, and mechanical engineering."@en ;
    skos:prefLabel "new material"@en .

<http://www.eionet.europa.eu/gemet/concept/5585> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8330> ;
    skos:definition "Electronic instruments and devices which have recently been developed and are been introduced into industry. New technologies have been introduced often in almost total ignorance or disregard of the biological and ecological systems that they subsequently disturb, and of the dynamic and evolving nature of living systems."@en ;
    skos:prefLabel "new technology"@en .

<http://www.eionet.europa.eu/gemet/concept/5589> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A malleable ductile silvery-white metallic element that is strong and corrosion-resistant, occurring principally in pentlandite and niccolite: used in alloys, especially in toughening steel, in electroplating, and as a catalyst in organic synthesis."@en ;
    skos:prefLabel "nickel"@en .

<http://www.eionet.europa.eu/gemet/concept/5593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Any salt or ester of nitric acid, such as sodium nitrate."@en ;
    skos:prefLabel "nitrate"@en .

<http://www.eionet.europa.eu/gemet/concept/5598> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "The process by which ammonia compounds, including man-made fertilizer and the humus provided by organic matter or plant and animal origin, are converted into nitrites and then nitrates, which are then absorbed as a nutrient by crops. Excess nitrate can be leached into surface waters and groundwaters, causing pollution. Excess nitrate may also be converted by microbes back into gaseous nitrogen, which is an important greenhouse gas, and released back into the atmosphere. The ultimate source of nitrogen in the ecosystem is the molecular nitrogen in the atmosphere. To a very limited extent, some dissolves in water. However, none is found in rock."@en ;
    skos:prefLabel "nitrification"@en .

<http://www.eionet.europa.eu/gemet/concept/5601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A salt or ester of nitric acid, included in compounds such as potassium nitrite, sodium nitrite and butyl nitrite."@en ;
    skos:prefLabel "nitrite"@en .

<http://www.eionet.europa.eu/gemet/concept/5607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/833> ;
    skos:definition "The complex set of processes by which crops acquire the large amount of nitrogen they need to make proteins, nucleic acids and other biochemicals of which they are composed, and how the nitrogen returns to the atmosphere."@en ;
    skos:prefLabel "nitrogen cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/5608> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5613> ;
    skos:definition "A reddish-brown gas; it exists in varying degrees of concentration in equilibrium with other nitrogen oxides; used to produce nitric acid."@en ;
    skos:prefLabel "nitrogen dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/5611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/812> ;
    skos:definition "Assimilation of atmospheric nitrogen by a variety of microorganisms which live freely in soil. Once the nitrogen has been captured by one of the microorganisms, there are many different routes by which it is handled. Some is retained in the soil as decomposing plant matter, waiting to be released and taken up by new crops as a nitrate. That nitrate is produced by nitrifying bacteria living in the soil that thrive on ammonia, which is produced by decaying plant and animal material. In processing nitrogen the nitrifying bacteria produce nitrate that can be absorbed by the roots of plants."@en ;
    skos:prefLabel "nitrogen fixation"@en .

<http://www.eionet.europa.eu/gemet/concept/5612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5613> ;
    skos:definition "A colourless gas, soluble in water, ethanol and ether. It is formed in many reactions involving the reduction of nitric acid, but more convenient reactions for the preparation of reasonably pure NO are reactions of sodium nitrite, sulphuric acid, etc."@en ;
    skos:prefLabel "nitrogen monoxide"@en .

<http://www.eionet.europa.eu/gemet/concept/5618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/372> ;
    skos:definition "Any one of a class of neutral, usually yellow oily compounds containing the divalent group = NNO."@en ;
    skos:prefLabel "nitrosamine"@en .

<http://www.eionet.europa.eu/gemet/concept/5623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Acronym for No Observed Effects Level."@en ;
    skos:prefLabel "NOEL"@en .

<http://www.eionet.europa.eu/gemet/concept/5626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5654> ;
    skos:definition "Measures to reduce noise at the source, to encourage quieter technologies or equipment or to prevent or reduce the propagation of sound. Measures may include the isolation and damping of vibration sources; the replacement of components with quieter parts and material; the enclosure of particularly noisy components; the provision of noise barriers, etc."@en ;
    skos:prefLabel "noise abatement"@en .

<http://www.eionet.europa.eu/gemet/concept/5629> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "Determination of the frequency components that make up a particular noise being studied."@en ;
    skos:prefLabel "noise analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/5630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1064> ;
    skos:definition "Barriers for reducing the propagation of sound: they are widely used in industry and alongside roads and railways to shield receivers from noise sources. Barriers will not reduce the noise on the receivers side, but will increase it, unless the barrier is also covered in absorbing material."@en ;
    skos:prefLabel "noise barrier"@en .

<http://www.eionet.europa.eu/gemet/concept/5631> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5648> ;
    skos:definition "The process to control the audible sound to an acceptable level."@en ;
    skos:prefLabel "noise control"@en .

<http://www.eionet.europa.eu/gemet/concept/5633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13839> ;
    skos:definition "Noise interferes with communication and interferes with thought processes. Noise interferes with sleep, it causes anger and frustration, and has been implicated as a contributor to various psychological and physiological problems. Noise detracts from the quality of life and the environment."@en ;
    skos:prefLabel "noise disturbance"@en .

<http://www.eionet.europa.eu/gemet/concept/5635> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7936> ;
    skos:definition "The release of noise into the environment from various sources that can be grouped in: transportation activities, industrial activities and daily normal activities."@en ;
    skos:prefLabel "noise emission"@en .

<http://www.eionet.europa.eu/gemet/concept/5637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "A mandatory sum of money levied by government upon producers of disturbing, harmful or unwanted sounds, frequently in the transportation or construction industries, to encourage reduction of sound levels."@en ;
    skos:prefLabel "noise emission levy"@en .

<http://www.eionet.europa.eu/gemet/concept/5638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Sound is radiated both as air-borne and as structure-borne; most sources produce both, thus various noise attenuation principles must be employed. Measures include: the replacement of components with quieter parts and material; the enclosure of particularly noisy components; the selection of quieter types of fan; the replacement of noisy compressed-air nozzles with quieter types; the choice of quieter transmission and cooling systems."@en ;
    skos:prefLabel "noise-free technology"@en .

<http://www.eionet.europa.eu/gemet/concept/5640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7937> ;
    skos:definition "Immission in the environment of acoustic vibrations that negatively affect human beings, animals, plants or other objects."@en ;
    skos:prefLabel "noise immission"@en .

<http://www.eionet.europa.eu/gemet/concept/5643> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3874> ;
    skos:definition "Legislation introduced by many governments to prevent or restrict the emission of noise from industrial, commercial and domestic premises; from motor vehicles and aircraft; and from consumer appliances and equipment."@en ;
    skos:prefLabel "noise legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/5644> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:definition "Physical quantity of unwanted sound measured, usually expressed in decibels."@en ;
    skos:prefLabel "noise level"@en .

<http://www.eionet.europa.eu/gemet/concept/5646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:definition "The process of quantitatively determining one or more properties of acoustic noise."@en ;
    skos:prefLabel "noise measurement"@en .

<http://www.eionet.europa.eu/gemet/concept/5651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6227> ;
    skos:definition "Harmful or unwanted sounds in the environment, which in specific locals, can be measured and averaged over a period of time."@en ;
    skos:prefLabel "noise pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/5653> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:definition "Adoption of measures for controlling noise pollution, such as restriction of the emission of noise from industrial, commercial and domestic premises, from motor vehicles and aircrafts, the provision of noise barriers and buffer zones, the fitting of sound attenuation equipment, etc."@en ;
    skos:prefLabel "noise protection"@en .

<http://www.eionet.europa.eu/gemet/concept/566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Agreement to provide refunds or payments in exchange for used bottles or packaging materials."@en ;
    skos:prefLabel "arrangement for a deposit on packaging"@en .

<http://www.eionet.europa.eu/gemet/concept/5662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7531> ;
    skos:definition """1) A member of a people or tribe who move from place to place to find pasture and food.
2) Nomads include gypsies, desert tribes such as the Bedouin and the many primitive tribes in the Americas, Asia and Australia. Herding survives as a way of life around the Sahara, in the Middle East, in Asia as far east as western India, and in the Asian parts of the USSR. The end of pastoral nomadism would be regrettable not merely on account of the independence and distinctiveness of this way of life but because this type of economy may be a more rational means of raising large numbers of animals under arid conditions than is capital-intensive ranching."""@en ;
    skos:prefLabel "nomad"@en .

<http://www.eionet.europa.eu/gemet/concept/5664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8380> ;
    skos:definition "A system of names or terms, particularly those related to a specific area of science or art, or the assignment of names to things."@en ;
    skos:prefLabel "nomenclature"@en .

<http://www.eionet.europa.eu/gemet/concept/5666> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "An organic compound, usually synthetic, that is not decomposed or mineralized by microorganisms or other biological processes."@en ;
    skos:prefLabel "non-biodegradable pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/5669> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5175> ;
    skos:definition "Industry that deals with the processing of metals other than iron and iron-base alloys."@en ;
    skos:prefLabel "non-ferrous metal industry"@en .

<http://www.eionet.europa.eu/gemet/concept/567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2640> ;
    skos:definition "A toxic metalloid element, existing in several allotropic forms, that occurs principally in realgar and orpiment and as the free element. It is used in transistors, lead-based alloys, and high temperature brasses."@en ;
    skos:prefLabel "arsenic"@en .

<http://www.eionet.europa.eu/gemet/concept/5670> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5171> ;
    skos:definition "Any metal other than iron and its alloys."@en ;
    skos:prefLabel "non-ferrous metal"@en .

<http://www.eionet.europa.eu/gemet/concept/5676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5184> ;
    skos:definition "A nonmetallic element, such as arsenic or silicon, that has some of the properties of a metal."@en ;
    skos:prefLabel "non-metal"@en .

<http://www.eionet.europa.eu/gemet/concept/5677> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2741> ;
    skos:definition "Energy that is ecologically safe and renewable. The most widely used source is hydroelectric power, which currently supplies some 6.6% of the world's energy needs. Other non-polluting sources are solar energy, tidal energy, wave energy and wind energy. Most non-polluting energy sources require a high capital investment but have low running costs."@en ;
    skos:prefLabel "non-polluting energy source"@en .

<http://www.eionet.europa.eu/gemet/concept/5679> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Clean fuel that does not release polluting emissions in the environment, such as methane."@en ;
    skos:prefLabel "non-polluting fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "The creation of works of beauty or other special significance."@en ;
    skos:prefLabel "art"@en .

<http://www.eionet.europa.eu/gemet/concept/5684> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5685> ;
    skos:definition "Non-renewable resources have been built up or evolved over a geological time-span and cannot be used without depleting the stock and raising questions of ultimate exhaustibility, since their rate of formation is so slow as to be meaningless in terms of the human life-span."@en ;
    skos:prefLabel "non-renewable energy resource"@en .

<http://www.eionet.europa.eu/gemet/concept/5687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1746> ;
    skos:definition "Any container for which no specific provisions for its return from the consumer or final use has been established."@en ;
    skos:prefLabel "non-returnable container"@en .

<http://www.eionet.europa.eu/gemet/concept/5689> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2929> ;
    skos:definition "A plant or animal other than the one against which the pesticide is applied."@en ;
    skos:prefLabel "non-target organism"@en .

<http://www.eionet.europa.eu/gemet/concept/5691> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:prefLabel "normalisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:definition "A geographic region of the African continent south of Europe and the Mediterranean Sea, and north of Africa's tropical rain forest, including Morocco, Algeria, Tunisia, Libya and the Egyptian region west of the Suez Canal, and also the Sahara Desert and Atlas Mountains."@en ;
    skos:prefLabel "North Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/5693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:definition "A continent in the northern half of the western hemisphere, bounded by the Arctic Ocean in the north, by the Pacific Ocean and the Bering Sea in the west, and by the Atlantic Ocean and the Gulf of Mexico in the east, connected to South America by the Isthmus of Panama, and including the United States, Canada, Mexico and several small island nations."@en ;
    skos:prefLabel "North America"@en .

<http://www.eionet.europa.eu/gemet/concept/5695> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "An ocean north of the equator between the eastern coast of Asia and the western coasts of the Americas, extending northward to the arctic region, with principal arms including the Gulf of Alaska, the Sea of Okhotsk, the Sea of Japan and the Bering, Yellow, East China, South China and Philippine seas, and islands including the Aleutian, Midway, Marshall and Hawaiian islands, the Japanese island arc and the Malay Archipelago."@en ;
    skos:prefLabel "North Pacific Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/5701> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Genetically engineered foods. Novel foods, including those altered using biotechnology, should not differ 'significantly' from the foods they are to replace. Labels should not be misleading, but must make clear any differences between the novel food and its 'conventional' alternative, and must say how that difference was achieved. Foods containing a genetically modified living organism, such as a live yogurt made with an altered culture, would always be labelled. Any food whose modification might raise moral or health worries to consumers would also have to carry a label. This would include genes from an animal considered unclean by some religions, or from a plant that might cause allergic reactions. However, foods which, although made using novel methods, are identical to conventional foods, would not have to be labelled."@en ;
    skos:prefLabel "novel food"@en .

<http://www.eionet.europa.eu/gemet/concept/5712> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1777> ;
    skos:definition "Energy released by nuclear fission or nuclear fusion."@en ;
    skos:prefLabel "nuclear energy"@en .

<http://www.eionet.europa.eu/gemet/concept/5713> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2729> ;
    skos:prefLabel "nuclear energy legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/5714> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Nuclear energy is employed in the industrial sector, in the production of other energy types, in the medical and scientific research field, in transportation, in the production of nuclear weapons, etc."@en ;
    skos:prefLabel "nuclear energy use"@en .

<http://www.eionet.europa.eu/gemet/concept/5718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4052> ;
    skos:definition "An unintentional release of energy from a rapid reaction of atomic nuclei yielding high temperatures and radiation potentially harmful to human health and the environment."@en ;
    skos:prefLabel "nuclear explosion (accident)"@en .

<http://www.eionet.europa.eu/gemet/concept/5721> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "A place, including buildings, where all the activities relating to nuclear research are performed."@en ;
    skos:prefLabel "nuclear facility"@en .

<http://www.eionet.europa.eu/gemet/concept/5722> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5741> ;
    skos:definition "The division of an atomic nucleus into parts of comparable mass; usually restricted to heavier nuclei such as isotopes of uranium, plutonium, and thorium."@en ;
    skos:prefLabel "nuclear fission"@en .

<http://www.eionet.europa.eu/gemet/concept/5727> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5724> ;
    skos:definition "A piece of nuclear fuel which has been formed and coated, and is ready to be placed in a reactor fuel assembly."@en ;
    skos:prefLabel "nuclear fuel element"@en .

<http://www.eionet.europa.eu/gemet/concept/5728> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5741> ;
    skos:definition "Combination of two light nuclei to form a heavier nucleus with release of some binding energy."@en ;
    skos:prefLabel "nuclear fusion"@en .

<http://www.eionet.europa.eu/gemet/concept/5734> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5880> ;
    skos:definition "The ongoing, public discussion and dispute over the uses of energy."@en ;
    skos:prefLabel "nuclear debate"@en .

<http://www.eionet.europa.eu/gemet/concept/5736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "A power plant in which nuclear energy is converted into heat for use in producing steam for turbines, which in turn drive generators that produce electric power."@en ;
    skos:prefLabel "nuclear power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/5737> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:prefLabel "nuclear power plant disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/5745> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7129> ;
    skos:definition "A facility in which scientists and other researchers study the behavior and characteristics of atomic nuclei through testing and other forms of experimentation, often to invent new technology with scientific, medical and industrial purposes."@en ;
    skos:prefLabel "nuclear research centre"@en .

<http://www.eionet.europa.eu/gemet/concept/5746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures and techniques implemented to reduce the possibility of incidence and the potential harm posed by radioactive substances used as an energy source, a test material or in weaponry."@en ;
    skos:prefLabel "nuclear safety"@en .

<http://www.eionet.europa.eu/gemet/concept/5747> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "Test performed to evaluate nuclear weapons."@en ;
    skos:prefLabel "nuclear test"@en .

<http://www.eionet.europa.eu/gemet/concept/5750> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9267> ;
    skos:definition "Any bomb, warhead, or projectile using active nuclear material to cause a chain reaction upon detonation."@en ;
    skos:prefLabel "nuclear weapon"@en .

<http://www.eionet.europa.eu/gemet/concept/5751> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "Any of several organic acids combined with proteins (DNA or RNA) which exist in the nucleus and protoplasm of all cells."@en ;
    skos:prefLabel "nucleic acid"@en .

<http://www.eionet.europa.eu/gemet/concept/5752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:definition "Anything that affects or prejudices health."@en ;
    skos:prefLabel "nuisance"@en .

<http://www.eionet.europa.eu/gemet/concept/5755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "Place where plants are grown until they are large enough to be planted in their final positions."@en ;
    skos:prefLabel "nursery (plant breeding)"@en .

<http://www.eionet.europa.eu/gemet/concept/5756> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327>,
        <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:definition "A medium providing or contributing to nourishment."@en ;
    skos:prefLabel "nutrient medium"@en .

<http://www.eionet.europa.eu/gemet/concept/5757> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5088> ;
    skos:definition "Condition in which there is equilibrium between intake and excretion of nutrients."@en ;
    skos:prefLabel "nutrient balance"@en .

<http://www.eionet.europa.eu/gemet/concept/5758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "The amount of proteins, carbohydrates, fats, inorganic salts (e.g. nitrates, phosphates), minerals (e.g. calcium, iron), and water."@en ;
    skos:prefLabel "nutrient content"@en .

<http://www.eionet.europa.eu/gemet/concept/5759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/833> ;
    skos:definition "A biogeochemical cycle, in which inorganic nutrients move through the soil, living organisms, air and water or through some of these."@en ;
    skos:prefLabel "nutrient cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/5761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Elimination of nutrients as, for example, from sewage in order to prevent eutrophication of water in reservoirs."@en ;
    skos:prefLabel "nutrient removal"@en .

<http://www.eionet.europa.eu/gemet/concept/5763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Chemical elements which are involved in the construction of living tissue and which are needed by both plant and animal. The most important in terms of bulk are carbon, hydrogen and oxygen, with other essential ones including nitrogen, potassium, calcium, sulphur and phosphorus."@en ;
    skos:prefLabel "nutrient"@en .

<http://www.eionet.europa.eu/gemet/concept/5769> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3380> ;
    skos:definition "The measure of the quantity or availability of nutrients found in materials ingested and utilized by humans or animals as a source of nutrition and energy."@en ;
    skos:prefLabel "nutritive value of food"@en .

<http://www.eionet.europa.eu/gemet/concept/5774> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "Any tree of the genus Quercus in the order Fagales, characterized by simple, usually lobed leaves, scaly winter buds, a star-shaped pith, and its fruit, the acorn, which is a nut; the wood is tough, hard, and durable, generally having a distinct pattern."@en ;
    skos:prefLabel "oak"@en .

<http://www.eionet.europa.eu/gemet/concept/5776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "The act of a party who objects to some matter or proceeding in the course of a trial or an argument or reason urged by him in support of his contention that the matter or proceeding objected to is improper or illegal."@en ;
    skos:prefLabel "objection"@en .

<http://www.eionet.europa.eu/gemet/concept/5777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:prefLabel "obligation to inform"@en .

<http://www.eionet.europa.eu/gemet/concept/5778> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6663> ;
    skos:definition "The legal responsibility or duty compelling manufacturers to affix certain marks or other written identification to their products, as is directed by laws, regulations or government standards."@en ;
    skos:prefLabel "obligation to label"@en .

<http://www.eionet.europa.eu/gemet/concept/5783> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6594> ;
    skos:definition "A collection of people who earn their living by similar or identical means of work."@en ;
    skos:prefLabel "occupational group"@en .

<http://www.eionet.europa.eu/gemet/concept/5785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5784> ;
    skos:prefLabel "occupational health care"@en .

<http://www.eionet.europa.eu/gemet/concept/5786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4250> ;
    skos:definition "The branch of medicine which deals with the relationship of humans to their occupations, for the purpose of the prevention of disease and injury and the promotion of optimal health, productivity, and social adjustment."@en ;
    skos:prefLabel "occupational medicine"@en .

<http://www.eionet.europa.eu/gemet/concept/5787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "An area of statutory duty imposed on employers and employees in most countries, for the protection of the workforce from occupational disease and stresses and physical hazards through appropriate measures."@en ;
    skos:prefLabel "occupational safety"@en .

<http://www.eionet.europa.eu/gemet/concept/5788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "Law enacted to reduce the incidence among workers of personal injuries, illnesses, and deaths resulting from employment."@en ;
    skos:prefLabel "occupational safety regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/5789> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7495> ;
    skos:definition "The mass of water occupying all of the Earth's surface not occupied by land, but excluding all lakes and inland seas."@en ;
    skos:prefLabel "ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/579> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7138> ;
    skos:definition "Lakes created behind manmade barriers."@en ;
    skos:prefLabel "artificial lake"@en .

<http://www.eionet.europa.eu/gemet/concept/5792> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5791> ;
    skos:definition "A net transport of ocean water along a definable path."@en ;
    skos:prefLabel "ocean current"@en .

<http://www.eionet.europa.eu/gemet/concept/5793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12417> ;
    skos:definition "The process by which pollutants, including sewage, industrial waste, consumer waste, and agricultural and urban runoff are discharged into the world's oceans. These pollutants arise from a myriad of sources."@en ;
    skos:prefLabel "ocean dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/5794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The islands of the southern, western and central Pacific Ocean, including Melanesia, Micronesia, and Polynesia. The term is sometimes extended to encompass Australia, New Zealand, and the Malay Archipelago."@en ;
    skos:prefLabel "Oceania"@en .

<http://www.eionet.europa.eu/gemet/concept/5799> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5791> ;
    skos:definition "A measure, referenced to a standard value, of the heat or coldness in a body of oceanic water."@en ;
    skos:prefLabel "ocean temperature"@en .

<http://www.eionet.europa.eu/gemet/concept/5804> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The property of a substance affecting the sense of smell; any smell; scent; perfume."@en ;
    skos:prefLabel "odour"@en .

<http://www.eionet.europa.eu/gemet/concept/5806> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5547> ;
    skos:prefLabel "odour nuisance"@en .

<http://www.eionet.europa.eu/gemet/concept/5809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1860> ;
    skos:definition "Unlawful acts against the environment, such as water contamination, hazardous waste disposal, air contamination, unpermitted installation of plants, oil spills, etc."@en ;
    skos:prefLabel "environmental criminality"@en .

<http://www.eionet.europa.eu/gemet/concept/5810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "Any room, set of rooms or building used for the administration of government service, business transactions or other work related activities."@en ;
    skos:prefLabel "office"@en .

<http://www.eionet.europa.eu/gemet/concept/5811> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:prefLabel "official duty"@en .

<http://www.eionet.europa.eu/gemet/concept/5812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Proceedings of relative formality, with definite issues of fact or of law to be tried, in which witnesses are heard and parties proceeded against have right to be heard."@en ;
    skos:prefLabel "official hearing"@en .

<http://www.eionet.europa.eu/gemet/concept/5814> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1623> ;
    skos:definition "Traveling back and forth regularly over some distance, outside of the hours of maximum traffic frequency."@en ;
    skos:prefLabel "off-peak commuting"@en .

<http://www.eionet.europa.eu/gemet/concept/5816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Relating to travelling outside rush-hours to avoid overcrowding in public means of transport."@en ;
    skos:prefLabel "off-peak travelling"@en .

<http://www.eionet.europa.eu/gemet/concept/5818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13343> ;
    skos:prefLabel "off-peak working"@en .

<http://www.eionet.europa.eu/gemet/concept/5820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4233> ;
    skos:definition "Policy whereby emissions from a proposed new or modified stationary source are balanced by reductions from existing sources to stabilise total emissions."@en ;
    skos:prefLabel "offset policy (emissions trading)"@en .

<http://www.eionet.europa.eu/gemet/concept/5823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Oil extraction from platforms situated a short distance from the coast."@en ;
    skos:prefLabel "offshore mining"@en .

<http://www.eionet.europa.eu/gemet/concept/5824> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12488> ;
    skos:definition "The act or process of extracting petroleum from deposits underlying the floor of the ocean or some other large body of water."@en ;
    skos:prefLabel "offshore oil drilling"@en .

<http://www.eionet.europa.eu/gemet/concept/5825> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14848>,
        <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Activities taking place or located away from the site."@en ;
    skos:prefLabel "off-site"@en .

<http://www.eionet.europa.eu/gemet/concept/5827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Highly absorbent agents used for physically removing spilled oil in case of leakages and oil accidents occurring in water bodies, industry, work-shops, on roads, etc. Materials that have been found useful for this service vary from simple, naturally occurring materials such as straw, sawdust, and peat to synthetic agents, such as polyurethane foam and polystyrene powder."@en ;
    skos:prefLabel "oil binding agent"@en .

<http://www.eionet.europa.eu/gemet/concept/5829> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/1777> ;
    skos:definition "Energy produced using oil as fuel."@en ;
    skos:prefLabel "oil-based energy"@en .

<http://www.eionet.europa.eu/gemet/concept/5830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "A floating device used to contain oil on a body of water. Once the boom has been inflated, it is towed downwind of the oil slick and formed into a U-shape; under the influence of wind, the oil becomes trapped within the boom. Skimming equipment travels into the boom enclosure and the oil is pumped into containers."@en ;
    skos:prefLabel "oil boom"@en .

<http://www.eionet.europa.eu/gemet/concept/5831> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4052> ;
    skos:definition "The disaster caused by the dumping and accidental spillage of oil into waterways from ships and land-based or offshore installations. Oil pollution may destroy or damage aquatic life and wildlife such as birds, contaminate water supplies and create fire hazards."@en ;
    skos:prefLabel "oil disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/5833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5834> ;
    skos:prefLabel "oil exploration"@en .

<http://www.eionet.europa.eu/gemet/concept/5835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:definition "Industry for the production and processing of edible oils and fats."@en ;
    skos:prefLabel "oil and fat industry"@en .

<http://www.eionet.europa.eu/gemet/concept/5836> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6270> ;
    skos:definition "A line of pipe connected to valves and other control devices, for conducting oil."@en ;
    skos:prefLabel "oil pipeline"@en .

<http://www.eionet.europa.eu/gemet/concept/5838> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6446> ;
    skos:definition "There are various systems for the abatement of oil pollution at sea: the \"Load-on-top\" system involves passing the washing from tank cleaning operations and residue from discharge of the original ballast water to an empty cargo tank nominated as the \"slop\" tank. Fresh oil cargo is loaded on top of the final residue left after further discharges of water, the resulting mixture being acceptable to refineries despite some additional cost in removing the salt and water. Under the International Convention for the Prevention of Pollution from Ships, 1973, all oil-carrying ships will be required to be capable of operating with this method of retention, or alternatively to discharge to reception facilities. Another method consists in spraying on the oil dispersives and/or blasting straw and sawdust, functioning as \"blotting paper\", onto water, beaches, rocks and docks. The Vikoma System for the containment of oil spills at sea, developed by British Petroleum, a seaboom of about 500 metres in length, is inflated and towed downwind of the oil slick and formed into a U-shape; under the influence of wind, the oil becomes trapped within the boom. Skimming equipment travels into the boom enclosure and the oil is pumped into containers."@en ;
    skos:prefLabel "oil pollution abatement"@en .

<http://www.eionet.europa.eu/gemet/concept/5839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7654> ;
    skos:definition "Boats used for recovering oil spilled at sea from oil tankers. The recommended procedure is to contain and physically recover the spill with or without the use of adsorbents. This approach entails three processes: a) confinement of the spill by spill booms; b) recovery of the spill by sorbing agents; c) physical removal of the contained oil by oil pick-up devices."@en ;
    skos:prefLabel "oil recovery vessel"@en .

<http://www.eionet.europa.eu/gemet/concept/5840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7035> ;
    skos:definition "System of process units used to convert crude petroleum into fuels, lubricants, and other petroleum-derived products."@en ;
    skos:prefLabel "oil refinery"@en .

<http://www.eionet.europa.eu/gemet/concept/5841> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The separation of petroleum mixtures into their component parts."@en ;
    skos:prefLabel "oil refining"@en .

<http://www.eionet.europa.eu/gemet/concept/5843> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The recovery of oil that is leftover or left behind, usually following the primary containment operations for an oil spill."@en ;
    skos:prefLabel "oil residue recuperation"@en .

<http://www.eionet.europa.eu/gemet/concept/5847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5264> ;
    skos:definition "A kerogen-bearing, finely laminated brown or black sedimentary rock that will yield liquid or gaseous hydrocarbons on distillation."@en ;
    skos:prefLabel "oil shale"@en .

<http://www.eionet.europa.eu/gemet/concept/5848> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/30> ;
    skos:definition "The mass of oil that floats on a surface of water, which is discharged accidentally, naturally or by design, and can be moved by currents, tides and the wind."@en ;
    skos:prefLabel "oil slick"@en .

<http://www.eionet.europa.eu/gemet/concept/5852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5837> ;
    skos:definition "The accidental release of oil, or other petroleum products usually into freshwater or marine ecosystems, and usually in large quantities. It can be controlled by chemical dispersion, combustion, mechanical containment, and absorption."@en ;
    skos:prefLabel "oil spill"@en .

<http://www.eionet.europa.eu/gemet/concept/5854> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8285> ;
    skos:definition "A very large ship which carries crude oil or other petroleum products in big tanks."@en ;
    skos:prefLabel "oil tanker"@en .

<http://www.eionet.europa.eu/gemet/concept/5856> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Landfill that has been filled and covered with topsoil and seeded. The most common end use for landfills is open spaces with no active recreation taking place over the completed landfill. The obvious reason for this use is that the completed surface is steeply sloped to provide rapid runoff. Also, no irrigation of the cover grasses should be allowed. It is very unlikely to think that commercial or industrial buildings will be constructed on a completed landfill. If the end use is such that the public will be walking on the site, it is important that all manholes be properly secured, leachate lagoons fenced, and other potential hazards eliminated."@en ;
    skos:prefLabel "old landfill site"@en .

<http://www.eionet.europa.eu/gemet/concept/5857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Any place that has been made unclean or unsafe by the discharge of high concentrations of hazardous or detrimental substances into its water, soil or atmosphere."@en ;
    skos:prefLabel "polluted site"@en .

<http://www.eionet.europa.eu/gemet/concept/5858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4242> ;
    skos:definition "Old installation that do not respond to new rules for the prevention of environmental pollution and whose redevelopment requires investments for adopting technologies related to the protection of waterways, waste management, noise reduction and emission control."@en ;
    skos:prefLabel "antiquated plant"@en .

<http://www.eionet.europa.eu/gemet/concept/5862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution produced by gaseous emissions in the atmosphere that, even in very small amounts, may cause injuries or a condition of general unease or sickness to persons living in the vicinity."@en ;
    skos:prefLabel "olfactory pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/5863> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "The testing and measurement of the sensitivity of the sense of smell."@en ;
    skos:prefLabel "olfactometry"@en .

<http://www.eionet.europa.eu/gemet/concept/5869> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9426> ;
    skos:definition "Infection with the filaria Onchocerca volvulus; results in skin tumours, papular dermatitis, and ocular complications."@en ;
    skos:prefLabel "onchocerciasis"@en .

<http://www.eionet.europa.eu/gemet/concept/5870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The study of the causes, development, characteristics, and treatment of tumors."@en ;
    skos:prefLabel "oncology"@en .

<http://www.eionet.europa.eu/gemet/concept/5874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Extracting metal ores and minerals that lie near the surface by removing the overlying material and breaking and loading the ore."@en ;
    skos:prefLabel "opencast mining"@en .

<http://www.eionet.europa.eu/gemet/concept/5875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5035> ;
    skos:definition "Fishing in the deepest parts of the sea."@en ;
    skos:prefLabel "open sea fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/5877> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:definition "Data referring to the practical carrying-out of a process."@en ;
    skos:prefLabel "operating data"@en .

<http://www.eionet.europa.eu/gemet/concept/5885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4040>,
        <http://www.eionet.europa.eu/gemet/concept/7185> ;
    skos:definition "Adjustments made to a building or to a mechanical or electrical system or apparatus in order to maximize its functionality and efficiency."@en ;
    skos:prefLabel "installation optimisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "A branch of chemistry dealing with the study of composition, reaction, properties, etc. of organic compounds."@en ;
    skos:prefLabel "organic chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/5897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "Farming without the use of industrially made fertilizers or pesticides."@en ;
    skos:prefLabel "organic farming"@en .

<http://www.eionet.europa.eu/gemet/concept/591> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5675> ;
    skos:definition "Generic name for a group of fibrous mineral silicates. It includes blue asbestos (crocidolite), white asbestos (chrysotile) and brown asbestos (amosite). After they are mined the asbestos fibres are separated from the rock and are spun into a cloth. When inhaled the fibres penetrate the lungs and the tissues of the bronchial tubes, resulting in asbestosis, a crippling lung disease. Asbestos also causes cancer of the lung and the gastro-intestinal tract, and mesothelioma, a malignant cancer of the inner lining of the chest. However, because it is a poor conductor of electricity and highly resistant to heat it has been widely used over the years in fire-fighting suits, and building and insulating materials. The fibrous form of several silicate minerals, at one time widely used for electrical and thermal insulation; the use of all forms of asbestos is now either banned or strictly controlled in many countries since it causes cancer."@en ;
    skos:prefLabel "asbestos"@en .

<http://www.eionet.europa.eu/gemet/concept/5910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7925> ;
    skos:definition "Organic materials, including diluents and thinners, which are liquids at standard conditions and which are used as dissolvers, viscosity reducers, or cleaning agents."@en ;
    skos:prefLabel "organic solvent"@en .

<http://www.eionet.europa.eu/gemet/concept/5913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1651>,
        <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste containing carbon compounds; derived from animal and plant materials."@en ;
    skos:prefLabel "organic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/5931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5927> ;
    skos:definition "Pesticides that contain phosphorous; short-lived, but some can be toxic when first applied."@en ;
    skos:prefLabel "organophosphorous compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5927> ;
    skos:definition "Any natural substance composed of two or more unlike atoms held together by chemical bonds and containing silicon, a non-metallic element often found in rocks or minerals."@en ;
    skos:prefLabel "organosilicon compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "One of a group of substances which contain both carbon and sulfur."@en ;
    skos:prefLabel "organosulphur compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5927> ;
    skos:definition "Chemical compounds used in anti-foulant paints to protect the hulls of boats and ships, buoys and pilings from marine organisms such as barnacles."@en ;
    skos:prefLabel "organotin compound"@en .

<http://www.eionet.europa.eu/gemet/concept/594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "A hardened mixture of asbestos fibers, Portland cement and water used in relatively thin slabs for shingles, wallboard and siding."@en ;
    skos:prefLabel "asbestos cement"@en .

<http://www.eionet.europa.eu/gemet/concept/5942> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9425> ;
    skos:definition "The branch of zoology that deals with the study of birds, including their physiology, classification, ecology, and behaviour."@en ;
    skos:prefLabel "ornithology"@en .

<http://www.eionet.europa.eu/gemet/concept/5944> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "A rarely used word referring to the study of mountain systems and the depiction of their relief."@en ;
    skos:prefLabel "orography"@en .

<http://www.eionet.europa.eu/gemet/concept/595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:definition "Association of Southeast Asian Nations."@en ;
    skos:prefLabel "ASEAN"@en .

<http://www.eionet.europa.eu/gemet/concept/5953> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "A pastime, diversion, exercise or other means of enjoyment and relaxation that is carried out in a particular city, town or small district."@en ;
    skos:prefLabel "local recreation"@en .

<http://www.eionet.europa.eu/gemet/concept/5957> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5965> ;
    skos:definition "An excess of people gathered together in a confined space."@en ;
    skos:prefLabel "overcrowding"@en .

<http://www.eionet.europa.eu/gemet/concept/5958> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "The use of raw materials excessively without considering the long-term ecological impacts of such use."@en ;
    skos:prefLabel "overexploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/5959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7861> ;
    skos:definition "Putting too much fertilizer on land; the runoff from overfertilisation can cause water pollution."@en ;
    skos:prefLabel "overfertilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/596> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "The incombustible matter remaining after a substance has been incinerated."@en ;
    skos:prefLabel "ash"@en .

<http://www.eionet.europa.eu/gemet/concept/5960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Taking out of the sea more than natural population growth can sustain. Overfishing has a number of causes, the most ruthless being \"chronic over capacity\" of modern fishing fleets to effectively take far more fish than can be replaced."@en ;
    skos:prefLabel "overfishing"@en .

<http://www.eionet.europa.eu/gemet/concept/5962> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "Intensive grazing by animals, for example cattle, sheep or goats, on an area of pasture. It has become a serious threat to the world's rangelands and grasslands. Several factors have led to overgrazing, which leads to the soil being degraded and becoming liable to erosion by wind and rain, and even to desertification. The main pressures leading to widespread overgrazing have been the need to increase the size and numbers of herds to produce more food for an increasing human population, and the transformation of traditional pasture land into plantations to grow cash crops. Throughout the dry tropics, where traditionally herds ranged over vast areas, intensive livestock-rearing schemes have taken over, mostly to provide meat for the export market. Well-digging operations have also led to heavy concentrations of animals in small areas."@en ;
    skos:prefLabel "overgrazing"@en .

<http://www.eionet.europa.eu/gemet/concept/5963> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2599> ;
    skos:definition "Suspended cables by which electrical power is distributed throughout a country."@en ;
    skos:prefLabel "overhead power line"@en .

<http://www.eionet.europa.eu/gemet/concept/5967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The circulation, especially in the fall and spring, of the layers of water in a lake or sea, whereby surface water sinks and mixes with bottom water; it is caused by changes in density differences due to changes in temperature, and is especially common wherever lakes are icebound in winter."@en ;
    skos:prefLabel "overturn (limnology)"@en .

<http://www.eionet.europa.eu/gemet/concept/5968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "To spend winter in a particular place."@en ;
    skos:prefLabel "overwintering"@en .

<http://www.eionet.europa.eu/gemet/concept/5972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "A chemical reaction that increases the oxygen content of a compound."@en ;
    skos:prefLabel "oxidation"@en .

<http://www.eionet.europa.eu/gemet/concept/5976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "An oxidizing chemical change, where an element's positive valence is increased (electron loss), accompanied by a simultaneous reduction of an associated element (electron gain)."@en ;
    skos:prefLabel "oxidation-reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/5980> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Compound that gives up oxygen easily, removes hydrogen from another compound, or attracts negative electrons."@en ;
    skos:prefLabel "oxidising agent"@en .

<http://www.eionet.europa.eu/gemet/concept/5983> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320>,
        <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Treating with oxygen."@en ;
    skos:prefLabel "oxygenation"@en .

<http://www.eionet.europa.eu/gemet/concept/5987> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5986> ;
    skos:prefLabel "oxygen deficiency"@en .

<http://www.eionet.europa.eu/gemet/concept/5992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15255>,
        <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A factor that reflects the ozone depletion potential of a substance, on a mass per kilogram basis, as compared to chlorofluorocarbon-11 (CFC-11). Such factor shall be based upon the substance's atmospheric life time, the molecular weight of bromine and chlorine, and the substance's ability to be photolytically disassociated, and upon other factors determined to be an accurate measure of relative ozone depletion potential."@en ;
    skos:prefLabel "ozone depletion potential"@en .

<http://www.eionet.europa.eu/gemet/concept/5993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/627> ;
    skos:definition "The general stratum of the upper atmosphere in which there is an appreciable ozone concentration and in which ozone plays an important part in the radiative balance of the atmosphere."@en ;
    skos:prefLabel "ozone layer"@en .

<http://www.eionet.europa.eu/gemet/concept/5995> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "The process of treating, impregnating or combining with ozone."@en ;
    skos:prefLabel "ozonisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6001> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste comprised of materials, or items, used to protect, contain, or transport a commodity or product and usually considered a type of consumer waste."@en ;
    skos:prefLabel "packaging waste"@en .

<http://www.eionet.europa.eu/gemet/concept/6009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "A commercial service through which paint, a decorative or protective coating product, or similar products are applied to the interiors and exteriors of buildings and other surfaces."@en ;
    skos:prefLabel "painting business"@en .

<http://www.eionet.europa.eu/gemet/concept/6012> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7669> ;
    skos:definition "A shop where paint and related items are sold."@en ;
    skos:prefLabel "paint shop"@en .

<http://www.eionet.europa.eu/gemet/concept/6013> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The study of life in past geologic time, based on fossil plants and animals and including phylogeny, their relationship to existing plants, animals, and environments, and the chronology of the Earth's history."@en ;
    skos:prefLabel "palaeontology"@en .

<http://www.eionet.europa.eu/gemet/concept/6023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Felted or matted sheets of cellulose fibers, formed on a fine-wire screen from a dilute water suspension, and bonded together as the water is removed and the sheet is dried."@en ;
    skos:prefLabel "paper"@en .

<http://www.eionet.europa.eu/gemet/concept/6026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industrial production of paper: pulp is produced by mechanically or chemically processing wood or other vegetative materials to extract usable cellulosic fibers as an aqueous slurry. The pulp slurry may be used directly in paper making or it may be shipped elsewhere for processing into paper products. The fundamental industrial operations are divided into two major categories: pulp mill and paper mill. The pulp mill operation includes wood preparation, pulping, deinking, pulp washing, screening and thickening, and bleaching. The paper mill operations include stock preparation, paper machine operation and finishing."@en ;
    skos:prefLabel "paper industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8683> ;
    skos:definition "Organism which lives and obtains food at the expense of another organism, the host."@en ;
    skos:prefLabel "parasite"@en .

<http://www.eionet.europa.eu/gemet/concept/6038> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "A branch of biology which deals with those organisms, plant or animal, which have become dependent on other living creatures."@en ;
    skos:prefLabel "parasitology"@en .

<http://www.eionet.europa.eu/gemet/concept/6046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6047> ;
    skos:definition "Area of ground or a building where there is space for vehicles to be parked."@en ;
    skos:prefLabel "car park"@en .

<http://www.eionet.europa.eu/gemet/concept/605> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161>,
        <http://www.eionet.europa.eu/gemet/concept/6316> ;
    skos:definition "Conversion of nutritive material to living tissue."@en ;
    skos:prefLabel "assimilation"@en .

<http://www.eionet.europa.eu/gemet/concept/6055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7612> ;
    skos:definition "A device for segregation of solid particles by size range, as a screening."@en ;
    skos:prefLabel "particle separator"@en .

<http://www.eionet.europa.eu/gemet/concept/6059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "The conveyance of people over land, water or through air by automobile, bus, train, airplane or some other means of travel."@en ;
    skos:prefLabel "passenger transport"@en .

<http://www.eionet.europa.eu/gemet/concept/6061> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "Land covered with grass or herbage and grazed by or suitable for grazing by livestock."@en ;
    skos:prefLabel "pasture"@en .

<http://www.eionet.europa.eu/gemet/concept/6062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste deriving from various activities having a pasty consistency."@en ;
    skos:prefLabel "paste-like waste"@en .

<http://www.eionet.europa.eu/gemet/concept/6063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "Any disease-producing agent or microorganism."@en ;
    skos:prefLabel "pathogen"@en .

<http://www.eionet.europa.eu/gemet/concept/6064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Agents producing or capable of producing disease."@en ;
    skos:prefLabel "pathogenic organism"@en .

<http://www.eionet.europa.eu/gemet/concept/6068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "The combination of acts, tendencies and other observable characteristics that demonstrates a municipal area's progress or state of development, including its population trends."@en ;
    skos:prefLabel "pattern of urban growth"@en .

<http://www.eionet.europa.eu/gemet/concept/6081> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3462> ;
    skos:definition "Unconsolidated soil material consisting largely of undecomposed or slightly decomposed organic matter accumulated under conditions of excessive moisture."@en ;
    skos:prefLabel "peat"@en .

<http://www.eionet.europa.eu/gemet/concept/6084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Peat is obtained from peat bogs by cutting it from the earth; it is then formed into briquettes, which can be used as fuel. Peat may be found in layers several metres thick. In some countries peat-fired generating stations for electricity are in use. Peat is also used as a soil conditioner."@en ;
    skos:prefLabel "peat extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/6092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "Area where vehicles are not allowed."@en ;
    skos:prefLabel "pedestrian zone"@en .

<http://www.eionet.europa.eu/gemet/concept/6102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7411> ;
    skos:definition "Punishment, varying from fines to withdrawal of government funds to economic sanctions, which is imposed for the harm or injury done to natural resources."@en ;
    skos:prefLabel "penalty for environmental damage"@en .

<http://www.eionet.europa.eu/gemet/concept/6106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1389> ;
    skos:definition "One of the universally toxic phenolic compounds, is a general purpose agent that is used as a fungicide, herbicide and molluscicide, particularly in Egypt where it is used to control snails that carry the larval human blood flukes that cause schistosomiasis. It is also used in wood preservatives and is very poisonous."@en ;
    skos:prefLabel "pentachlorophenol"@en .

<http://www.eionet.europa.eu/gemet/concept/6107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8075> ;
    skos:prefLabel "per capita data"@en .

<http://www.eionet.europa.eu/gemet/concept/6109> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1378> ;
    skos:definition "Stable, colorless liquid, nonflammable and nonexplosive, with low toxicity; used as a dry-cleaning and industrial solvent, in pharmaceuticals and medicines, and for metal cleaning."@en ;
    skos:prefLabel "perchloroethylene"@en .

<http://www.eionet.europa.eu/gemet/concept/611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496> ;
    skos:definition "The science of space flight."@en ;
    skos:prefLabel "astronautics"@en .

<http://www.eionet.europa.eu/gemet/concept/6111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Subsurface water that passes, under the force of gravity, through rocks or soil along the line of least resistance."@en ;
    skos:prefLabel "percolating water"@en .

<http://www.eionet.europa.eu/gemet/concept/6115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6138> ;
    skos:definition "A plant or animal organism which is attached or clings to surfaces of leaves or stems of rooted plants above the bottom stratum."@en ;
    skos:prefLabel "periphyton"@en .

<http://www.eionet.europa.eu/gemet/concept/6118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1559> ;
    skos:definition "The interacting system of the biological communities and their nonliving environmental surroundings in a climatic region where the subsoil is perennially frozen."@en ;
    skos:prefLabel "permafrost ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "The science concerned with celestial bodies and the observation and interpretation of the radiation received in the vicinity of the earth from the component parts of the universe."@en ;
    skos:prefLabel "astronomy"@en .

<http://www.eionet.europa.eu/gemet/concept/6120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The ability of a membrane or other material to permit a substance to pass through it."@en ;
    skos:prefLabel "permeability"@en .

<http://www.eionet.europa.eu/gemet/concept/6123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "An exposure limit that is set for exposure to an hazardous substance or harmful agent and enforced by OSHA (Occupational Safety and Health Act) as a legal standard. It is based on time-weighted average concentrations for a normal 8-hour work day and 40 hour work week."@en ;
    skos:prefLabel "permissible exposure limit"@en .

<http://www.eionet.europa.eu/gemet/concept/6128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5604> ;
    skos:definition "A pollutant created by the action of sunlight on hydrocarbons and nitrogen oxides in the air. An ingredient of smog."@en ;
    skos:prefLabel "peroxyacetylnitrate"@en .

<http://www.eionet.europa.eu/gemet/concept/6131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6129> ;
    skos:definition "The ability of a chemical to retain its molecular integrity and hence its physical, chemical, and functional characteristics in the environment through which such a chemical may be transported and distributed for a considerable period of time."@en ;
    skos:prefLabel "persistence of pesticides"@en .

<http://www.eionet.europa.eu/gemet/concept/6133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7184> ;
    skos:prefLabel "personal responsibility"@en .

<http://www.eionet.europa.eu/gemet/concept/6140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "A general term for chemical agents that are used in order to kill unwanted plants, animals pests or disease-causing fungi, and embracing insecticides, herbicides, fungicides, nematicides, etc. Some pesticides have had widespread disruptive effects among non-target species."@en ;
    skos:prefLabel "pesticide"@en .

<http://www.eionet.europa.eu/gemet/concept/6143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "A norm or measure applicable in legal cases pertaining to the production, dissemination or use of substances designed to mitigate or eliminate insects or small animals that harm vegetation."@en ;
    skos:prefLabel "pesticide control standard"@en .

<http://www.eionet.europa.eu/gemet/concept/6144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The specific or known route or vector of any chemical substance released into the environment to prevent, destroy or mitigate any pest that is directly or indirectly detrimental to harvest crops and other human interests."@en ;
    skos:prefLabel "pesticide pathway"@en .

<http://www.eionet.europa.eu/gemet/concept/6146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7156> ;
    skos:definition "A pesticide remaining in the environment for a fairly long time, continuing to be effective for days, weeks, and months."@en ;
    skos:prefLabel "residual pesticide"@en .

<http://www.eionet.europa.eu/gemet/concept/6149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition """1) The occurrence of one or more pest species in an area or location where their numbers and impact are currently or potentially at intolerable levels. 
2) A sudden increase in destructiveness or population numbers of a pest species in a given area."""@en ;
    skos:prefLabel "pest infestation"@en .

<http://www.eionet.europa.eu/gemet/concept/6152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2291> ;
    skos:definition "An animal which is kept in the home as a companion and treated affectionately."@en ;
    skos:prefLabel "pet"@en .

<http://www.eionet.europa.eu/gemet/concept/6154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1310> ;
    skos:definition "The production of materials derived from petroleum or natural gas."@en ;
    skos:prefLabel "petrochemical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/616> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A bound collection of maps or charts, plates, engravings or tables illustrating any subject."@en ;
    skos:prefLabel "atlas"@en .

<http://www.eionet.europa.eu/gemet/concept/6162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Petroleum belongs to non-renewable energy sources; it is a complex substance derived from the carbonized remains of trees, ferns, mosses, and other types of vegetable matter. The principal chemical constituents of oil are carbon, hydrogen, and sulphur. The various fuels made from crude oil are jet fuel, gasoline, kerosine, diesel fuel, and heavy fuel oils. Major oil consumption is in the following areas: transportation, residential-commercial, industrial and for generating electric power."@en ;
    skos:prefLabel "petroleum consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/6163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5288> ;
    skos:definition "The branch of economic geology that relates to the origin, migration and accumulation of oil and gas, and to the discovery of commercial deposits. Its practice involves the application of geochemistry, geophysics, paleontology, structural geology and stratigraphy to the problems of finding hydrocarbons."@en ;
    skos:prefLabel "petroleum geology"@en .

<http://www.eionet.europa.eu/gemet/concept/6164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Manufacturing industry utilizing complex combination of interdependent operations engaged in the storage and transportation, separation of crude molecular constituents, molecular cracking, molecular rebuilding, and solvent finishing to produce petrochemical products."@en ;
    skos:prefLabel "petroleum industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:definition "Controlled utilization, protection and development of  exploited and potentially exploitable sources of crude oil to meet current demand and ensure future requirements."@en ;
    skos:prefLabel "conservation of petroleum resources"@en .

<http://www.eionet.europa.eu/gemet/concept/6177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1310> ;
    skos:definition "Concerted activity concerned with manufacturing pharmaceutical goods."@en ;
    skos:prefLabel "pharmaceutical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The study of the rates of absorption, tissue distribution, biotransformation, and excretion."@en ;
    skos:prefLabel "pharmacokinetics"@en .

<http://www.eionet.europa.eu/gemet/concept/6181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The science dealing with the nature and properties of drugs, particularly their actions."@en ;
    skos:prefLabel "pharmacology"@en .

<http://www.eionet.europa.eu/gemet/concept/6184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/895> ;
    skos:definition "Any substance secreted by an animal which influences the behaviour of other individuals of the same species."@en ;
    skos:prefLabel "pheromone"@en .

<http://www.eionet.europa.eu/gemet/concept/6189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition """1) Generic term for any compound containing a phosphate group.
2) Any salt or ester of any phosphoric acid, especially a salt of orthophosphoric acid."""@en ;
    skos:prefLabel "phosphate"@en .

<http://www.eionet.europa.eu/gemet/concept/6190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7103> ;
    skos:definition "Replacement of phosphate in detergents by environmentally safer substances, such as zeolite. The substitute will not act as a nutrient, and so will not cause eutrophication as a result of the accelerated growth of plants and microorganisms if it is released into waterways."@en ;
    skos:prefLabel "phosphate removal"@en .

<http://www.eionet.europa.eu/gemet/concept/6192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "All substances that are able to substitute phosphate compounds in detergents; they must have the same chemical and physical properties and must be less polluting for the environment."@en ;
    skos:prefLabel "phosphate substitute"@en .

<http://www.eionet.europa.eu/gemet/concept/6196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2640> ;
    skos:definition "A nonmetallic element used to manufacture phosphoric acid, in phosphor bronzes, incendiaries, pyrotechnics, matches, and rat poisons; the white or yellow allotrope is a soft waxy solid, soluble in carbon disulfide, insoluble in water and alcohol, and is poisonous and self-igniting in air; the red allotrope is an amorphous powder, insoluble in all solvents and is nonpoisonous; the black allotrope comprises lustrous crystals similar to graphite, and is insoluble in most solvents."@en ;
    skos:prefLabel "phosphorus"@en .

<http://www.eionet.europa.eu/gemet/concept/6198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6201> ;
    skos:definition "The result or consequence of a chemical reaction caused by light or ultraviolet radiation."@en ;
    skos:prefLabel "photochemical effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6197> ;
    skos:definition "Any of the chemicals which enter into oxidation reactions in the presence of light or other radiant energy."@en ;
    skos:prefLabel "photochemical oxidant"@en .

<http://www.eionet.europa.eu/gemet/concept/6200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Degradation products that are produced by the action of light radiation."@en ;
    skos:prefLabel "photochemical product"@en .

<http://www.eionet.europa.eu/gemet/concept/6202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7759> ;
    skos:definition "A combination of fog and chemicals that come from automobile and factory emissions and is acted upon by the action of the sun. Nitrogen dioxide, in the presence of the sun and some hydrocarbons, is turned into nitric oxide and atomic oxygen. The atomic oxygen reacts with the oxygen molecules and other constituents of automobile exhaust fumes to form a variety of products including ozone. The ozone is harmful in itself and is also implicated in a highly complex series of continuing reactions. As long as there is ozone or nitrogen dioxide and sunlight present, other undesirable reactions will occur."@en ;
    skos:prefLabel "photochemical smog"@en .

<http://www.eionet.europa.eu/gemet/concept/6204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The process of making measurements from photographs, used especially in the construction of maps from aerial photographs and also in military intelligence, medical and industrial research, etc."@en ;
    skos:prefLabel "photogrammetry"@en .

<http://www.eionet.europa.eu/gemet/concept/621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "The study of the production, transport, modification, and removal of atmospheric constituents in the troposphere and stratosphere."@en ;
    skos:prefLabel "atmospheric chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/6211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10043> ;
    skos:definition "The process by which plants transform carbon dioxide and water into carbohydrates and other compounds, using energy from the sun captured by chlorophyll in the plant. Oxygen is a by-product of the process. Photosynthesis is the essence of all plant life (autotrophic production) and hence of all animal life (heterotrophic production) on the planet Earth. The rate of photosynthesis depends on climate, intensity and duration of sunlight, available leaf area, soil nutrient availability, temperature, carbon dioxide concentration, and soil moisture regimes."@en ;
    skos:prefLabel "photosynthesis"@en .

<http://www.eionet.europa.eu/gemet/concept/622> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/639> ;
    skos:definition "The general movement and circulation of air, which transfers energy between different levels of the atmosphere. The mechanisms of circulation are very complicated. They involve the transfer of energy between the oceans and the atmosphere, the land and the atmosphere, as well as the different levels of the atmosphere."@en ;
    skos:prefLabel "atmospheric circulation"@en .

<http://www.eionet.europa.eu/gemet/concept/6221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:prefLabel "physical conditions"@en .

<http://www.eionet.europa.eu/gemet/concept/6222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The study of the spatial and temporal characteristics and relationships of all phenomena within the Earth's physical environment."@en ;
    skos:prefLabel "physical geography"@en .

<http://www.eionet.europa.eu/gemet/concept/6224> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5797> ;
    skos:definition "The study of the physical aspects of the ocean, the movements of the sea, and the variability of these factors in relationship to the atmosphere and the ocean bottom."@en ;
    skos:prefLabel "physical oceanography"@en .

<http://www.eionet.europa.eu/gemet/concept/6226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "A pollutant characterized by its influence on environmental conditions caused by forces and operations of physics, such as noise, microwave radiation, vibration, etc."@en ;
    skos:prefLabel "physical pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/6234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6838> ;
    skos:definition "Used to concentrate waste brines and to remove solid organics and ammonia from aqueous solutions. Physical treatment consists of reverse osmosis, dialysis, electrodialysis, evaporation, carbon, adsorption, ammonia stripping, filtration, sedimentation, and flocculation. Chemical treatment consists of ion exchange, neutralization, oxidation, reduction, precipitation, and calcination."@en ;
    skos:prefLabel "physicochemical purification"@en .

<http://www.eionet.europa.eu/gemet/concept/6243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "Plant biomass; any quantitative estimate of the total mass of plants in a stand, population, or within a given area, at a given time."@en ;
    skos:prefLabel "phytomass"@en .

<http://www.eionet.europa.eu/gemet/concept/6244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6066> ;
    skos:definition "The study of plant diseases and their control."@en ;
    skos:prefLabel "phytopathology"@en .

<http://www.eionet.europa.eu/gemet/concept/6247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6282> ;
    skos:definition "Planktonic plant life."@en ;
    skos:prefLabel "phytoplankton"@en .

<http://www.eionet.europa.eu/gemet/concept/6248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/971> ;
    skos:definition "The study of vegetation, including the organization, interdependence, development, geographical distribution and classification of plant communities."@en ;
    skos:prefLabel "phytosociology"@en .

<http://www.eionet.europa.eu/gemet/concept/6250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:prefLabel "phytotoxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/6252> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Plant where scale is removed from iron and steel usually by means of immersion in a hot hydrochloric or sulphuric acid bath. Wastes include spent pickling liquor, sludges and rinse water."@en ;
    skos:prefLabel "pickling plant"@en .

<http://www.eionet.europa.eu/gemet/concept/6253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6205> ;
    skos:definition "A pictorial representation of data projected onto a two-dimensional grid of individual picture elements (pixels) and acquired from a human-made vessel placed in orbit round a planet, moon or star."@en ;
    skos:prefLabel "satellite image"@en .

<http://www.eionet.europa.eu/gemet/concept/626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1474> ;
    skos:definition "A measurable quantity of the moisture content found in the earth's atmosphere."@en ;
    skos:prefLabel "atmospheric humidity"@en .

<http://www.eionet.europa.eu/gemet/concept/6261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The service provided by a pilot, one who controls the movements of a ship or aircraft by visual or electronic means."@en ;
    skos:prefLabel "pilotage"@en .

<http://www.eionet.europa.eu/gemet/concept/6262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "A small version of a planned industrial plant, built to gain experience in operating the final plant."@en ;
    skos:prefLabel "pilot plant"@en .

<http://www.eionet.europa.eu/gemet/concept/6263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6710> ;
    skos:definition "A small scale experiment or set of observations undertaken to decide how and whether to launch a full-scale project."@en ;
    skos:prefLabel "pilot project"@en .

<http://www.eionet.europa.eu/gemet/concept/6268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "Belonging to the Pinnipedia, an order of aquatic placental mammals having a streamlined body and limbs specialized as flippers: includes seals, sea lions, and the walrus."@en ;
    skos:prefLabel "pinniped"@en .

<http://www.eionet.europa.eu/gemet/concept/6274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4082> ;
    skos:definition "A tube made of metal, clay, plastic, wood, or concrete and used to conduct a fluid, gas, or finely divided solid."@en ;
    skos:prefLabel "pipe"@en .

<http://www.eionet.europa.eu/gemet/concept/6280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:definition "Pollution which arises from various activities with no discrete source."@en ;
    skos:prefLabel "plane source"@en .

<http://www.eionet.europa.eu/gemet/concept/6285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "Any physical extension of, or changes to, the uses of land in metropolitan areas following certain preparations or designs."@en ;
    skos:prefLabel "planned urban development"@en .

<http://www.eionet.europa.eu/gemet/concept/629> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5325> ;
    skos:definition "A simulation, pattern or plan designed to demonstrate the structure or workings of the atmosphere surrounding any object, including the Earth."@en ;
    skos:prefLabel "atmospheric model"@en .

<http://www.eionet.europa.eu/gemet/concept/6292> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "An authorization, license or equivalent control document issued by a government agency that approves a step by step method and process of defining, developing and outlining various possible courses of action to meet existing or future needs, goals and objectives."@en ;
    skos:prefLabel "planning permission"@en .

<http://www.eionet.europa.eu/gemet/concept/6293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "A system to achieve long-term goals or objectives by means of analysis and evaluation of the alternatives. PPB is designed to solve problems by finding the most effective and most efficient solution on the basis of objective criteria."@en ;
    skos:prefLabel "Planning-Programming-Budgeting System"@en .

<http://www.eionet.europa.eu/gemet/concept/6305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "The equipment, including machinery, tools, instruments, and fixtures necessary for an industrial or manufacturing operation."@en ;
    skos:prefLabel "plant equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/6307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3633> ;
    skos:definition "The scientific study of the hereditary material of plants for purposes such as hybridization, improved food resources and increased production."@en ;
    skos:prefLabel "plant genetics"@en .

<http://www.eionet.europa.eu/gemet/concept/6309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:prefLabel "plant health care"@en .

<http://www.eionet.europa.eu/gemet/concept/6310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/237> ;
    skos:definition "Any substance or mixture of substances which through physiological action protects the plants against parasites, fungi, virus, or other damaging factors."@en ;
    skos:prefLabel "plant protection product"@en .

<http://www.eionet.europa.eu/gemet/concept/6312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "Pertaining to mammals walking with the whole sole of the foot touching the ground."@en ;
    skos:prefLabel "plantigrade"@en .

<http://www.eionet.europa.eu/gemet/concept/6313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "The establishment of trees by planting seedlings, transplants, or cuttings."@en ;
    skos:prefLabel "planting"@en .

<http://www.eionet.europa.eu/gemet/concept/6318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10064> ;
    skos:definition "Conservation of plant species that may be rare or endangered, and of other plants of particular significance."@en ;
    skos:prefLabel "plant protection"@en .

<http://www.eionet.europa.eu/gemet/concept/6319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Tests performed to establish the effectiveness of pesticides under a wide variety of climatic and other environmental conditions; to assess the possible side effects on animals, plants and humans and to determine the persistence of pesticide residues in the environment."@en ;
    skos:prefLabel "testing of plant protection products"@en .

<http://www.eionet.europa.eu/gemet/concept/6326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "Trade of plants is subjected to regulations established by the Convention on International Trade in Endangered Species (CITES)."@en ;
    skos:prefLabel "plant trade"@en .

<http://www.eionet.europa.eu/gemet/concept/6327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition """1) Common name for a number of industrial applications of plasma, such as: etching of semiconductor chips, deposition of silicon for solar cell production, deposition of silicon dioxide for passivation of surfaces, activation of surfaces, melting and welding with plasma arcs as well as plasma chemistry. 
2) Plasma technology consists of minute gas-filled cells, which emit light when an electric current is channelled through them."""@en ;
    skos:prefLabel "plasma technology"@en .

<http://www.eionet.europa.eu/gemet/concept/6338> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A ductile malleable silvery-white metallic element very resistant to heat and chemicals. It occurs free and in association with other platinum metals, especially in osmiridium; used in jewellery, laboratory apparatus, electrical contacts, dentistry, electroplating, and as a catalyst."@en ;
    skos:prefLabel "platinum"@en .

<http://www.eionet.europa.eu/gemet/concept/6339> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A piece of land used for recreation, especially by children, often including equipment such as swings and slides."@en ;
    skos:prefLabel "playground"@en .

<http://www.eionet.europa.eu/gemet/concept/634> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6235> ;
    skos:definition "The study of the physical phenomena of the atmosphere."@en ;
    skos:prefLabel "atmospheric physics"@en .

<http://www.eionet.europa.eu/gemet/concept/6346> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/66> ;
    skos:definition "A highly toxic metallic transuranic element. It occurs in trace amounts in uranium ores and is produced in a nuclear reactor by neutron bombardment of uranium-238. The most stable and important isotope, plutonium-239, readily undergoes fission and is used as a reactor fuel in nuclear power stations and in nuclear weapons."@en ;
    skos:prefLabel "plutonium"@en .

<http://www.eionet.europa.eu/gemet/concept/6355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/468> ;
    skos:definition "To catch game, fish, etc. illegally by trespassing on private property."@en ;
    skos:prefLabel "poaching"@en .

<http://www.eionet.europa.eu/gemet/concept/6357> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6474> ;
    skos:definition "Pollution from a discrete source, such as a septic tank, a sewer, a discharge type, a landfill, a factory or waste water treatment works discharging to a watercourse; stack emission from an industrial process; or spillage from an underground storage tank leaching into groundwater."@en ;
    skos:prefLabel "point source"@en .

<http://www.eionet.europa.eu/gemet/concept/6358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "A substance which, when ingested, inhaled, or absorbed, or when applied to, injected into, or developed within the body, in relatively small amounts, may cause injury, harm, or destruction to organs, tissue, or life."@en ;
    skos:prefLabel "poison"@en .

<http://www.eionet.europa.eu/gemet/concept/6365> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:definition "A generally fertile tract of flat, low-lying land (as in Netherlands and Belgium) reclaimed and protected from the sea, a lake, a river, or other body of water by the use of embankments, dikes, dams, or levees. The term is usually reserved for coastal areas that are at or below sea level and that are constantly protected by an organized system of maintenance and defense."@en ;
    skos:prefLabel "polder"@en .

<http://www.eionet.europa.eu/gemet/concept/6367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4535> ;
    skos:definition "Branch of the government which is charged with the preservation of public order, the promotion of public health and safety, and the prevention, detection, and punishment of crimes."@en ;
    skos:prefLabel "police"@en .

<http://www.eionet.europa.eu/gemet/concept/6368> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the employment and tactics of police or other civil agents organized to maintain order, prevent and detect crimes and promote obedience to civil regulations and authority."@en ;
    skos:prefLabel "police law"@en .

<http://www.eionet.europa.eu/gemet/concept/6372> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "policy guideline"@en .

<http://www.eionet.europa.eu/gemet/concept/6374> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13291> ;
    skos:definition "The process of coordinating, harmonizing and unifying the goals and procedures of various offices or units of an organization."@en ;
    skos:prefLabel "policy integration"@en .

<http://www.eionet.europa.eu/gemet/concept/6378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The process of making arrangements or preparations to facilitate any course of action that may be adopted and pursued by government, business or some other organization."@en ;
    skos:prefLabel "policy planning"@en .

<http://www.eionet.europa.eu/gemet/concept/6381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6371> ;
    skos:definition "A policy, position or principle advocated, taught or put into effect concerning the acquisition and exercise of the power to govern or administrate in society."@en ;
    skos:prefLabel "political doctrine"@en .

<http://www.eionet.europa.eu/gemet/concept/6382> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:prefLabel "political ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/6383> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The study of the effects of political actions on human geography, involving the spatial analysis of political phenomena."@en ;
    skos:prefLabel "political geography"@en .

<http://www.eionet.europa.eu/gemet/concept/6387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6384> ;
    skos:definition "An organized group that has as its fundamental aim the attainment of political power and public office for its designated leaders. Usually, a political party will advertise a common commitment by its leaders and its membership to a set of political, social, economic and/or cultural values."@en ;
    skos:prefLabel "political party"@en .

<http://www.eionet.europa.eu/gemet/concept/6388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6371> ;
    skos:definition "The might, ability or authority of governments, citizens groups and other interested parties in enacting change or in influencing or controlling the outcome of governmental or public policies affecting a nation, region or municipality."@en ;
    skos:prefLabel "political power"@en .

<http://www.eionet.europa.eu/gemet/concept/6392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "Microspores of seed-producing plants. Each pollen grain contains a much-reduced male gametophyte. Pollen grains are transferred by wind, water, birds or other animals."@en ;
    skos:prefLabel "pollen"@en .

<http://www.eionet.europa.eu/gemet/concept/6396> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6428> ;
    skos:definition "The process by which a pollutant is physically incorporated into another substance or body."@en ;
    skos:prefLabel "pollutant absorption"@en .

<http://www.eionet.europa.eu/gemet/concept/6399> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The determination of the composition of any substance that causes pollution, using classical laboratory techniques and other methods involving analytical chemistry."@en ;
    skos:prefLabel "pollutant analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/6400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:prefLabel "pollutant assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/6404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6397> ;
    skos:definition "A measure of the amount of a polluting substance in a given amount of water, soil, air, food or other medium."@en ;
    skos:prefLabel "pollutant concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/6405> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6428> ;
    skos:definition "The physical, chemical or biological breakdown of a complex polluting material into simpler components."@en ;
    skos:prefLabel "pollutant degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/6406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2084> ;
    skos:definition "The act or process in which polluting agents settle or accumulate naturally in ecosystems."@en ;
    skos:prefLabel "pollutant deposition"@en .

<http://www.eionet.europa.eu/gemet/concept/6414> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3853> ;
    skos:definition "The act or state of being subjected to a substance that adversely affects human health, property or the environment."@en ;
    skos:prefLabel "pollutant exposure"@en .

<http://www.eionet.europa.eu/gemet/concept/6415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The act or process in which polluting agents are created, produced or formed."@en ;
    skos:prefLabel "pollutant formation"@en .

<http://www.eionet.europa.eu/gemet/concept/6417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4146> ;
    skos:definition "The transfer of solid, liquid, or gaseous contaminants in the air, water, and soil."@en ;
    skos:prefLabel "pollutant immission"@en .

<http://www.eionet.europa.eu/gemet/concept/6418> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6412> ;
    skos:definition "The treatment process used to reduce the solubility of pollutants in order to minimize possible migration or leaching or to prepare for their disposal."@en ;
    skos:prefLabel "pollutant immobilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2667> ;
    skos:definition "A value representing the concentration of a polluting agent in a specified area, often determined by a measuring and recording device."@en ;
    skos:prefLabel "pollutant level"@en .

<http://www.eionet.europa.eu/gemet/concept/6422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "The amount of polluting material that a transporting agent, such as a stream, a glacier, or the wind, is actually carrying at a given time."@en ;
    skos:prefLabel "pollutant load"@en .

<http://www.eionet.europa.eu/gemet/concept/6429> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6412> ;
    skos:definition "All measures aimed at reducing pollutants often through physical or chemical removal of toxic, or potentially toxic, materials."@en ;
    skos:prefLabel "pollutant reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/6430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6423> ;
    skos:prefLabel "pollutant remobilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6438> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6425> ;
    skos:prefLabel "pollutant source identification"@en .

<http://www.eionet.europa.eu/gemet/concept/6441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "A solid, liquid or gas that has been contaminated, rendered impure or made unsafe for use."@en ;
    skos:prefLabel "polluted matter"@en .

<http://www.eionet.europa.eu/gemet/concept/6443> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4752> ;
    skos:definition "The principle that those causing pollution should meet the costs to which it gives rise."@en ;
    skos:prefLabel "polluter-pays principle"@en .

<http://www.eionet.europa.eu/gemet/concept/6452> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5349> ;
    skos:definition "Devices for the reduction and/or removal of those emissions to the environment which have the potential to cause pollution."@en ;
    skos:prefLabel "pollution control equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/6453> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by government, management or an international organization or treaty in which limits are established for the emission of substances that harm or adversely alter the environment and human health."@en ;
    skos:prefLabel "pollution control regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/6454> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Methods used to reduce the amount of contaminants discharged from a source."@en ;
    skos:prefLabel "pollution control technology"@en .

<http://www.eionet.europa.eu/gemet/concept/6458> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6425> ;
    skos:definition "Standard established for certain pollutants which limits their concentration."@en ;
    skos:prefLabel "pollution criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/6462> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:definition "Organisms, mostly plants, which are most sensitive to slight changes in environmental factors. When identified their reaction can serve as an early warning of the endangerment of the health of a community."@en ;
    skos:prefLabel "pollution indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/6464> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition "Liability for injuries arising from the release of hazardous substances or pollutants or contaminants."@en ;
    skos:prefLabel "pollution liability"@en .

<http://www.eionet.europa.eu/gemet/concept/6470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5690> ;
    skos:prefLabel "pollution norm"@en .

<http://www.eionet.europa.eu/gemet/concept/6472> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Probability of harm to human health, property or the environment posed by the introduction of an undesirable substance into the ecosystem."@en ;
    skos:prefLabel "pollution risk"@en .

<http://www.eionet.europa.eu/gemet/concept/6473> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6446> ;
    skos:definition "Vehicle for removal of a chemical or gas from the atmosphere-biosphere-ocean system, in which the substance is absorbed into a permanent or semi-permanent repository, or else transformed into another substance. A carbon sink, for example, might be the ocean (which absorbs and holds carbon from other parts of carbon cycle) or photosynthesis (which converts atmospheric carbon into plant material). Sinks are a fundamental factor in the ongoing balance which determines the concentration of every greenhouse gas in the atmosphere. If the sink is greater than the sources of a gas, its concentration in the atmosphere will decrease; if the source is greater than the sink, the concentration will increase."@en ;
    skos:prefLabel "pollution sink"@en .

<http://www.eionet.europa.eu/gemet/concept/6481> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3819> ;
    skos:definition "A chemical substance the composition of which, without regard to impurities, consists of brominated biphenyl molecules."@en ;
    skos:prefLabel "polybrominated biphenyl"@en .

<http://www.eionet.europa.eu/gemet/concept/6486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2207> ;
    skos:definition "PCDD are formed (along with variants including furans) when compounds containing chlorine are burnt at low temperature in improperly operated/designed domestic refuse and industrial waste incinerators where PCDDs can be found in both the flue gases and the fly ash."@en ;
    skos:prefLabel "polychlordibenzo-p-dioxin"@en .

<http://www.eionet.europa.eu/gemet/concept/6487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3536> ;
    skos:definition "A family containing 135 individual, colorless compounds known as congeners with varying harmful health and environmental effects. They are produced as unwanted compounds during the manufacture of several chemicals and consumer products such as wood treatment chemicals, some metals, and paper products; also produced from the burning of municipal and industrial waste in incinerators, from exhaust of leaded gasoline, heat, or production of electricity. They are hazardous to the respiratory system, gastrointestinal system, liver, musculoskeletal system, skin and nervous system; and are toxic by inhalation, ingestion, and contact. Symptoms of exposure include frequent coughing, severe respiratory infections, chronic bronchitis, abdominal pain, muscle pain, acne rashes, skin color changes, unexpected weight loss, nonmalignant or malignant liver disease."@en ;
    skos:prefLabel "polychlorinated dibenzofuran"@en .

<http://www.eionet.europa.eu/gemet/concept/6488> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3823> ;
    skos:definition "Compounds consisting of three benzene rings linked to each other in either ortho, meta or para positions and substituted with chlorine atoms."@en ;
    skos:prefLabel "polychlorinated terphenyl"@en .

<http://www.eionet.europa.eu/gemet/concept/6497> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6505> ;
    skos:definition """1) A thermoplastic polyester resin made from ethylene glycol and terephthalic acid; melts at 265°C; used to make films or fibers.
2) Type of plastic used to make artificial fibres and plastic bottles, which can be recycled."""@en ;
    skos:prefLabel "polyethylene terephtalate"@en .

<http://www.eionet.europa.eu/gemet/concept/6498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition """1) The bonding of two or more monomers to produce a polymer. 
2) Any chemical reaction that produces such a bonding."""@en ;
    skos:prefLabel "polymerisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "A natural body of standing fresh water occupying a small surface depression, usually smaller than a lake and larger than a pool."@en ;
    skos:prefLabel "pond"@en .

<http://www.eionet.europa.eu/gemet/concept/6508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7627> ;
    skos:definition "Any collection of liquid effluents or wastewater drained or separated out during the processing of crops or mineral ores."@en ;
    skos:prefLabel "tailings pond"@en .

<http://www.eionet.europa.eu/gemet/concept/6510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "A small, natural body of standing water, usually fresh; e.g. a stagnant body of water in a marsh, or a still body of water within a cave."@en ;
    skos:prefLabel "pool"@en .

<http://www.eionet.europa.eu/gemet/concept/6518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6519> ;
    skos:definition "The process of numerical and structural change within populations resulting from births, deaths, and movements."@en ;
    skos:prefLabel "population dynamics"@en .

<http://www.eionet.europa.eu/gemet/concept/6520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "The study of the interaction of a particular species or genus population with its environment."@en ;
    skos:prefLabel "population ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/6523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6528> ;
    skos:definition "An increase in the total number of inhabitants of a country, city, district or area."@en ;
    skos:prefLabel "population growth"@en .

<http://www.eionet.europa.eu/gemet/concept/6536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:definition "Treatment of treated water or wastewater to improve the water quality."@en ;
    skos:prefLabel "post-treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "Under certain circumstances, the tax law applies attribution rules to assign to one taxpayer the ownership interest of another taxpayer."@en ;
    skos:prefLabel "attribution"@en .

<http://www.eionet.europa.eu/gemet/concept/6540> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1162> ;
    skos:definition "Any of several compounds containing potassium, especially soluble compounds such as potassium oxide, potassium chloride, and various potassium sulfates, used chiefly in fertilizers."@en ;
    skos:prefLabel "potash"@en .

<http://www.eionet.europa.eu/gemet/concept/6541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Rock salt mining is an underground mining process in which the salt is physically dug out of the ground in an operation involving drilling, blasting and crushing the rock. The major percentage of this output is used for winter road maintenance."@en ;
    skos:prefLabel "rock salt mining"@en .

<http://www.eionet.europa.eu/gemet/concept/6548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3122> ;
    skos:definition "Domesticated fowl grown for their meat and eggs."@en ;
    skos:prefLabel "poultry"@en .

<http://www.eionet.europa.eu/gemet/concept/6549> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11192> ;
    skos:definition "One of the commonest of agricultural occupations. Many urban households and many farms maintain some chickens for both meat and eggs."@en ;
    skos:prefLabel "poultry farming"@en .

<http://www.eionet.europa.eu/gemet/concept/6552> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13213> ;
    skos:definition "Company which is responsible for the supply and distribution of electric energy to a given area."@en ;
    skos:prefLabel "power company"@en .

<http://www.eionet.europa.eu/gemet/concept/6558> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The ratio of the work done by an engine to the heat supplied."@en ;
    skos:prefLabel "power-heat relation"@en .

<http://www.eionet.europa.eu/gemet/concept/6570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The process of producing a separable solid phase within a liquid medium; represents the formation of a new condensed phase, such as a vapour or gas condensing to liquid droplets; a new solid phase gradually precipitates within a solid alloy as a result of slow, inner chemical reaction; in analytical chemistry, precipitation is used to separate a solid phase in an aqueous solution."@en ;
    skos:prefLabel "precipitation (chemical)"@en .

<http://www.eionet.europa.eu/gemet/concept/6571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9274> ;
    skos:definition "Increase of precipitation resulting from changes in the colloidal stability of clouds. This can be either intentional, as with cloud seeding, or unintentional, as with air pollution, which increases aerosol concentrations and reduces sunlight."@en ;
    skos:prefLabel "precipitation enhancement"@en .

<http://www.eionet.europa.eu/gemet/concept/6577> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8683> ;
    skos:definition "Animal which kills and eats other animals."@en ;
    skos:prefLabel "predator"@en .

<http://www.eionet.europa.eu/gemet/concept/6579> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1064> ;
    skos:definition "Building whose sections are manufactured in specialized factories and later transported and assembled on a building site."@en ;
    skos:prefLabel "prefabricated building"@en .

<http://www.eionet.europa.eu/gemet/concept/6583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Any introductory action in the judicial process designed to determine the need for further court involvement or to expedite a motion that requires immediate attention."@en ;
    skos:prefLabel "preliminary proceedings"@en .

<http://www.eionet.europa.eu/gemet/concept/6584> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12887> ;
    skos:definition "Amount to be paid for a contract of insurance or life assurance."@en ;
    skos:prefLabel "premium"@en .

<http://www.eionet.europa.eu/gemet/concept/6586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "To maintain and keep safe from harm, destruction or decay any species of proof legally presented at the trial of an issue, including witnesses, records, documents, exhibits and concrete objects."@en ;
    skos:prefLabel "preservation of evidence"@en .

<http://www.eionet.europa.eu/gemet/concept/6587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A chemical added to foodstuffs to prevent oxidation, fermentation or other deterioration, usually by inhibiting the growth of bacteria."@en ;
    skos:prefLabel "preservative"@en .

<http://www.eionet.europa.eu/gemet/concept/6588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:prefLabel "preserve"@en .

<http://www.eionet.europa.eu/gemet/concept/6591> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5079> ;
    skos:definition "Printed matter as a whole, especially newspapers and periodicals."@en ;
    skos:prefLabel "press"@en .

<http://www.eionet.europa.eu/gemet/concept/6592> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The application of a pressure to squeeze out the juice or contents of a fruit, seed, etc."@en ;
    skos:prefLabel "pressing"@en .

<http://www.eionet.europa.eu/gemet/concept/6600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3877> ;
    skos:prefLabel "preventive health measure"@en .

<http://www.eionet.europa.eu/gemet/concept/6607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13257> ;
    skos:definition "The guiding procedure or philosophy for decisions regarding the monetary rate or value of a country or region's resources, including natural resources, human resources and capital, or man-made goods."@en ;
    skos:prefLabel "pricing policy of resources"@en .

<http://www.eionet.europa.eu/gemet/concept/6610> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "The first five or six years of instruction in elementary schools."@en ;
    skos:prefLabel "primary education"@en .

<http://www.eionet.europa.eu/gemet/concept/6614> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/2715> ;
    skos:definition "Consumption of energy used in the same form as in its naturally occurring state, for example crude oil, coal, natural gas, e.g. before it is converted into electricity."@en ;
    skos:prefLabel "primary energy consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/6619> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7554> ;
    skos:definition "That part of a country's or region's economy that makes direct use of natural resources, including agriculture, forestry, fishing and the fuel, metal and mining industries."@en ;
    skos:prefLabel "primary sector"@en .

<http://www.eionet.europa.eu/gemet/concept/6621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Order of mammals containing monkeys, apes, and human beings."@en ;
    skos:prefLabel "primate"@en .

<http://www.eionet.europa.eu/gemet/concept/6622> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "Forest which originally covered a region before changes in the environment brought about by people."@en ;
    skos:prefLabel "primary forest"@en .

<http://www.eionet.europa.eu/gemet/concept/6627> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6630> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the reproduction of written text or images in multiple copies such as books, periodicals, newspapers or other similar formats."@en ;
    skos:prefLabel "printing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6631> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:prefLabel "prior informed consent"@en .

<http://www.eionet.europa.eu/gemet/concept/6632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11621> ;
    skos:definition "A formal announcement and, often, a request for permission to the proper governmental authorities of the intention to convey across political borders potentially harmful materials that have been left over from manufacturing or testing processes."@en ;
    skos:prefLabel "prior notification for hazardous waste transport"@en .

<http://www.eionet.europa.eu/gemet/concept/6634> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1148> ;
    skos:definition "Transportation mean belonging to an individual person."@en ;
    skos:prefLabel "private car"@en .

<http://www.eionet.europa.eu/gemet/concept/6636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "Living quarters where a group of persons (family) live together."@en ;
    skos:prefLabel "private household"@en .

<http://www.eionet.europa.eu/gemet/concept/6640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8722> ;
    skos:definition "Segment of the economy not run by government, including households, sole traders, partnerships and companies."@en ;
    skos:prefLabel "private sector"@en .

<http://www.eionet.europa.eu/gemet/concept/6641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8653> ;
    skos:definition "Transport performed with private means."@en ;
    skos:prefLabel "private transport"@en .

<http://www.eionet.europa.eu/gemet/concept/6643> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "The transfer of ownership or control of  a government enterprise or other governmental property to a non-public, non-official company, organization or individual, either through sale or through the establishment of a special enterprise outside direct government control."@en ;
    skos:prefLabel "privatisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6645> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "An order of herbivorous placental mammals characterized by having a proboscis, incisors enlarged to become tusks, and pillarlike legs with five toes bound together on a broad pad."@en ;
    skos:prefLabel "proboscidean"@en .

<http://www.eionet.europa.eu/gemet/concept/6647> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "Law which prescribes method of enforcing rights or obtaining redress for their invasion. Laws which fix duties, establish rights and responsibilities among and for persons, natural or otherwise, are \"substantive laws\" in character, while those which merely prescribe the manner in which such rights and responsibilities may be exercised and enforced in a court are \"procedural laws\"."@en ;
    skos:prefLabel "procedural law"@en .

<http://www.eionet.europa.eu/gemet/concept/665> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1989> ;
    skos:definition "The processing, discovery and identification of data elements by automated means."@en ;
    skos:prefLabel "automatic detection"@en .

<http://www.eionet.europa.eu/gemet/concept/6654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "Any technical strategies, methods or tools used for the conception, design, development or implementation of any system."@en ;
    skos:prefLabel "process technology"@en .

<http://www.eionet.europa.eu/gemet/concept/6655> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9180> ;
    skos:definition "Water used in a manufacturing or treatment process or in the actual product manufactured. Examples would include water used for washing, rinsing, direct contact, cooling, solution make-up, chemical reactions, and gas scrubbing in industrial and food processing applications. In many cases, water is specifically treated to produce the quality of water needed for the process."@en ;
    skos:prefLabel "process water"@en .

<http://www.eionet.europa.eu/gemet/concept/6658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition "Obligations, responsibilities or debts imposed upon all members of an industry that manufactures or produces a product or service causing injury or harm to a consumer and apportioned according to each member's share of the market for the product."@en ;
    skos:prefLabel "producer liability"@en .

<http://www.eionet.europa.eu/gemet/concept/6661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6662> ;
    skos:definition "Comparison of products or processes to identify those having reduced environmental impacts."@en ;
    skos:prefLabel "product comparison"@en .

<http://www.eionet.europa.eu/gemet/concept/6664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1739> ;
    skos:definition "Factual, circumstantial and, often, comparative knowledge concerning various goods, services or events, their quality and the entities producing them."@en ;
    skos:prefLabel "product information"@en .

<http://www.eionet.europa.eu/gemet/concept/6670> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "The amount of output or yield per unit of input or expenditure achieved by a company, industry or country."@en ;
    skos:prefLabel "productivity"@en .

<http://www.eionet.europa.eu/gemet/concept/6672> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2511> ;
    skos:definition "The general direction or tendency in the measurement of the production of goods and services having exchange value."@en ;
    skos:prefLabel "productivity trend"@en .

<http://www.eionet.europa.eu/gemet/concept/6675> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4787> ;
    skos:definition """1) The legal liability of manufacturers and sellers to compensate buyers, users, and even bystanders, for damages or injuries suffered because of defects in goods purchased.
2) A tort which makes a manufacturer liable if his product has a defective condition that makes it unreasonably dangerous to the user or consumer."""@en ;
    skos:prefLabel "product liability"@en .

<http://www.eionet.europa.eu/gemet/concept/6676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "A standard which prescribes aspects of the physical or chemical composition of products which have potential for causing environmental damage or the handling, presentation and packaging of products, particularly those which are toxic."@en ;
    skos:prefLabel "product standard"@en .

<http://www.eionet.europa.eu/gemet/concept/6678> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/709> ;
    skos:definition "An excess of the receipts over the spending, costs and expenses of a business or other commercial entity during any period."@en ;
    skos:prefLabel "profit"@en .

<http://www.eionet.europa.eu/gemet/concept/668> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5393> ;
    skos:prefLabel "automobile industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6681> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:prefLabel "prognostic data"@en .

<http://www.eionet.europa.eu/gemet/concept/6708> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5348> ;
    skos:definition "A diagrammatic presentation of observed data in the sequence of their occurrence in time, in the context of water flow."@en ;
    skos:prefLabel "progress line"@en .

<http://www.eionet.europa.eu/gemet/concept/6718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Process by which a disturbance at one point is propagated to another point more remote from the source with no net transport of the material of the medium itself; examples include the motion of electromagnetic waves, sound waves, hydrodynamic waves in liquids, and vibration waves in solids."@en ;
    skos:prefLabel "propagation process"@en .

<http://www.eionet.europa.eu/gemet/concept/6720> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "A gas used in aerosol preparations to expel the liquid contents through an atomizer."@en ;
    skos:prefLabel "propellant"@en .

<http://www.eionet.europa.eu/gemet/concept/6728> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5971> ;
    skos:definition "That benefit or safety which the government affords to the citizens to insure their individual or corporate right to exclusive enjoyment and disposal of property, money and any other thing tangible or intangible that represents a source of income or wealth."@en ;
    skos:prefLabel "property protection"@en .

<http://www.eionet.europa.eu/gemet/concept/6736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Technique for causing a body to move by exerting a force against it."@en ;
    skos:prefLabel "propulsion technique"@en .

<http://www.eionet.europa.eu/gemet/concept/6737> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11540> ;
    skos:definition "The pursuit of legal proceedings, particularly criminal proceedings."@en ;
    skos:prefLabel "prosecution"@en .

<http://www.eionet.europa.eu/gemet/concept/6739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6861> ;
    skos:definition "State of being prosperous; wealth or success."@en ;
    skos:prefLabel "prosperity"@en .

<http://www.eionet.europa.eu/gemet/concept/6746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Threatened, vulnerable or endangered species which are protected from extinction by preventive measures."@en ;
    skos:prefLabel "protected species"@en .

<http://www.eionet.europa.eu/gemet/concept/6749> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7815> ;
    skos:prefLabel "protection from neighbours"@en .

<http://www.eionet.europa.eu/gemet/concept/6750> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10670> ;
    skos:prefLabel "protection of birds"@en .

<http://www.eionet.europa.eu/gemet/concept/6752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10064> ;
    skos:definition "Measures adopted for the safeguarding of species, of their ecosystems and their biodiversity."@en ;
    skos:prefLabel "protection of species"@en .

<http://www.eionet.europa.eu/gemet/concept/6755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "Any of a class of high-molecular weight polymer compounds composed of a variety of alfa-amino acids joined by peptide linkages."@en ;
    skos:prefLabel "protein"@en .

<http://www.eionet.europa.eu/gemet/concept/6759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "A diverse phylum of eukaryotic microorganisms; the structure varies from a simple uninucleate protoplast to colonial forms, the body is either naked or covered by a test, locomotion is by means of pseudopodia or cilia or flagella, there is a tendency toward universal symmetry in floating species and radial symmetry in sessile types, and nutrition may be phagotrophic or autotrophic or saprozoic."@en ;
    skos:prefLabel "protozoan"@en .

<http://www.eionet.europa.eu/gemet/concept/6760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8062> ;
    skos:definition "A geographic area of some considerable extent, smaller than a continent but larger than a region, which is unified by some or all of its characteristics and which can therefore be studied as a whole. A faunal province, for example, has a particular assemblage of animal species, which differs from assemblages in different contemporaneous environments elsewhere."@en ;
    skos:prefLabel "province"@en .

<http://www.eionet.europa.eu/gemet/concept/6766> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a government agency or its administrators to administer and implement laws and government policies applicable to a specific geographical area, usually falling under the jurisdiction of two or more states."@en ;
    skos:prefLabel "regional authority"@en .

<http://www.eionet.europa.eu/gemet/concept/6773> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5152> ;
    skos:definition "A result or consequence stemming from mental processes that create or influence human consciousness and emotions."@en ;
    skos:prefLabel "psychic effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6774> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5152> ;
    skos:prefLabel "psychological effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6778> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6777> ;
    skos:definition "Illness arising from or aggravated by a mind-body relationship."@en ;
    skos:prefLabel "psychosomatic illness"@en .

<http://www.eionet.europa.eu/gemet/concept/6784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4600> ;
    skos:definition "The right or permission for all persons of a community to use government owned geographic areas such as parks, campgrounds and historical sites."@en ;
    skos:prefLabel "public access to land"@en .

<http://www.eionet.europa.eu/gemet/concept/6787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A place having baths for public use."@en ;
    skos:prefLabel "public bath"@en .

<http://www.eionet.europa.eu/gemet/concept/6788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5686> ;
    skos:definition "A building to which there is free access by the public and which is available for the use of a community."@en ;
    skos:prefLabel "public building"@en .

<http://www.eionet.europa.eu/gemet/concept/6790> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5880> ;
    skos:definition "That which can be accessed, used and shared by the general populace without restrictions, penalties or fees."@en ;
    skos:prefLabel "public domain"@en .

<http://www.eionet.europa.eu/gemet/concept/6791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:prefLabel "public emergency limit"@en .

<http://www.eionet.europa.eu/gemet/concept/6794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3195> ;
    skos:definition "The act of obtaining or furnishing money or capital for a program, purchase or enterprise from the general population of a community or state, usually through government allocation of tax revenues."@en ;
    skos:prefLabel "public financing"@en .

<http://www.eionet.europa.eu/gemet/concept/6799> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Right to appear and give evidence and also right to hear and examine witnesses whose testimony is presented by opposing parties."@en ;
    skos:prefLabel "public hearing"@en .

<http://www.eionet.europa.eu/gemet/concept/680> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6753> ;
    skos:definition "The total of measures and devices implemented to protect people, property or natural resources from avalanche conditions, including avalanche forecasting and warning, avalanche zoning, ski testing and the use of explosives and other equipment to stabilize an avalanche area."@en ;
    skos:prefLabel "avalanche protection"@en .

<http://www.eionet.europa.eu/gemet/concept/6804> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5880> ;
    skos:definition "The purported, collective view of the public on some issue or problem, typically formulated by selective polling or sampling, and frequently used as a guide to action or decision."@en ;
    skos:prefLabel "public opinion"@en .

<http://www.eionet.europa.eu/gemet/concept/6805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11531> ;
    skos:definition "The canvassing of a representative sample of a large group of people on some question in order to determine the general opinion of a group."@en ;
    skos:prefLabel "public opinion polling"@en .

<http://www.eionet.europa.eu/gemet/concept/6806> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3770> ;
    skos:definition "Park with big trees, ornamental plants, alleys bordered by trees or bushes, fountains and statues situated in a town and whose access is free."@en ;
    skos:prefLabel "public park"@en .

<http://www.eionet.europa.eu/gemet/concept/6808> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/77> ;
    skos:definition "The involvement, as an enfranchised citizen, in public matters, with the purpose of exerting influence."@en ;
    skos:prefLabel "public participation"@en .

<http://www.eionet.europa.eu/gemet/concept/6809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "A joint venture between corporations and government or between community members and government or business beyond the course of normal interaction."@en ;
    skos:prefLabel "public-private partnership"@en .

<http://www.eionet.europa.eu/gemet/concept/6810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The governmental process of purchasing supplies, equipment and services, or purchasing contracts to secure the provision of supplies, equipment and services, which are often sold by the private sector."@en ;
    skos:prefLabel "public procurement"@en .

<http://www.eionet.europa.eu/gemet/concept/6812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4535> ;
    skos:definition "A government agency for which an elected or appointed attorney or staff of attorneys is vested with the authority by a constitution or statute to try cases on the government's behalf, to represent public interest or to take legal action against persons violating federal, state or local laws."@en ;
    skos:prefLabel "public prosecutor's office"@en .

<http://www.eionet.europa.eu/gemet/concept/6816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8722> ;
    skos:definition "Segment of the economy run to some degree by government, including national and local governments, government-owned firms and quasi-autonomous non-government organizations."@en ;
    skos:prefLabel "public sector"@en .

<http://www.eionet.europa.eu/gemet/concept/6818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8653> ;
    skos:definition "The act or the means of conveying people in mass as opposed to conveyance in private vehicles."@en ;
    skos:prefLabel "public transport"@en .

<http://www.eionet.europa.eu/gemet/concept/6827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7179> ;
    skos:definition "Any disease pertaining to the lungs."@en ;
    skos:prefLabel "pulmonary disease"@en .

<http://www.eionet.europa.eu/gemet/concept/6828> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9358> ;
    skos:definition "The cellulosic material produced by reducing wood mechanically or chemically and used in making paper and cellulose products. Also known as wood pulp."@en ;
    skos:prefLabel "pulp"@en .

<http://www.eionet.europa.eu/gemet/concept/6830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8486> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in manufacturing and selling the soft, moist, slightly cohering mass deriving from wood that is used to produce paper sheets, cardboard and other paper products."@en ;
    skos:prefLabel "pulp industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The removal of gases and vapors from a vacuum system."@en ;
    skos:prefLabel "pumping"@en .

<http://www.eionet.europa.eu/gemet/concept/6835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13242> ;
    skos:definition "The acquisition or the act of buying something by payment of money or its equivalent."@en ;
    skos:prefLabel "purchase"@en .

<http://www.eionet.europa.eu/gemet/concept/6846> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5928> ;
    skos:definition "Any of a number of nitrogenous bases, such as guanine and adenine, that are derivatives of purine and constituents of nucleic acids and certain coenzymes."@en ;
    skos:prefLabel "purin"@en .

<http://www.eionet.europa.eu/gemet/concept/6855> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "The breaking apart of complex molecules into simpler units by the use of heat."@en ;
    skos:prefLabel "pyrolysis"@en .

<http://www.eionet.europa.eu/gemet/concept/6859> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6662> ;
    skos:prefLabel "quality assurance"@en .

<http://www.eionet.europa.eu/gemet/concept/686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3138> ;
    skos:definition "All the birds in a particular region."@en ;
    skos:prefLabel "avifauna"@en .

<http://www.eionet.europa.eu/gemet/concept/6860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The inspection, analysis, and other relevant actions taken to provide control over what is being done, manufactured, or fabricated, so that a desirable level of quality is achieved and maintained."@en ;
    skos:prefLabel "quality control"@en .

<http://www.eionet.europa.eu/gemet/concept/6870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "The surface exploitation and removal of stone or mineral deposits from the earth's crust."@en ;
    skos:prefLabel "quarrying"@en .

<http://www.eionet.europa.eu/gemet/concept/6882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2651> ;
    skos:definition "The associations, tensions or harmony between two or more groups of people distinguished by history, culture, religion or physique: distinctions erroneously construed as being based on consistent biological differences and as representing, in effect, species of a human genus."@en ;
    skos:prefLabel "race relations"@en .

<http://www.eionet.europa.eu/gemet/concept/6883> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5349> ;
    skos:definition "A system using beamed and reflected radiofrequency energy for detecting and locating objects, measuring distance or altitude, navigating, homing, bombing and other purposes."@en ;
    skos:prefLabel "radar"@en .

<http://www.eionet.europa.eu/gemet/concept/6888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2308> ;
    skos:definition "The total amount of radiation absorbed by material or tissues, in the sense of absorbed dose, exposure dose, or dose equivalent."@en ;
    skos:prefLabel "radiation dose"@en .

<http://www.eionet.europa.eu/gemet/concept/6889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Prolonged exposure to ionizing radiation from various sources can be harmful. Nuclear radiation from fallout from nuclear weapons or from power stations, background radiation from substances naturally present in the soil, exposure to X-rays can cause radiation sickness. Massive exposure to radiation can kill quickly and any person exposed to radiation is more likely to develop certain types of cancer than other members of the population."@en ;
    skos:prefLabel "radiation effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12793> ;
    skos:definition "The act or state of being subjected to electromagnetic energy strong enough to ionize atoms thereby posing a threat to human health or the environment."@en ;
    skos:prefLabel "radiation exposure"@en .

<http://www.eionet.europa.eu/gemet/concept/6892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The periodic or continuous surveillance or analysis of the level of radiant energy present in a given area, to determine that its prescribed amount has not been exceeded or that it meets acceptable safety standards."@en ;
    skos:prefLabel "radiation monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/6894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5733> ;
    skos:definition "The study of ionizing radiation and its effects on matter."@en ;
    skos:prefLabel "radiation physics"@en .

<http://www.eionet.europa.eu/gemet/concept/6896> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:definition "Precautionary actions, measures or equipment implemented to guard or defend people, property and natural resources from the harmful effects of ionizing energy."@en ;
    skos:prefLabel "radiation protection"@en .

<http://www.eionet.europa.eu/gemet/concept/6897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3874> ;
    skos:definition "A binding rule or body of rules prescribed by  government to establish measures to keep humans and natural resources safe from harmful exposure to energy waves released by nuclear materials, electromagnetic current and other sources."@en ;
    skos:prefLabel "radiation protection law"@en .

<http://www.eionet.europa.eu/gemet/concept/6899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6887> ;
    skos:definition "The complex of symptoms characterizing the disease known as radiation injury, resulting from excessive exposure of the whole body (or large part) to ionizing radiation. The earliest of these symptoms are nausea, fatigue, vomiting, and diarrhea, which may be followed by loss of hair (epilation), hemorrhage, inflammation of the mouth and throat, and general loss of energy."@en ;
    skos:prefLabel "radiation sickness"@en .

<http://www.eionet.europa.eu/gemet/concept/6904> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1752> ;
    skos:definition "Contamination of a substance, living organism or site caused by radioactive material."@en ;
    skos:prefLabel "radioactive contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/6908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2015> ;
    skos:definition "The removal of radioactive contamination which is deposited on surfaces or may have spread throughout a work area. Personnel decontamination is also included. Decontamination methods follow two broad avenues of attack, mechanical and chemical."@en ;
    skos:prefLabel "radioactive decontamination"@en .

<http://www.eionet.europa.eu/gemet/concept/6909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "Waste generated by the emission of particulate or electromagnetic radiation resulting from the decay of the nuclei of unstable elements."@en ;
    skos:prefLabel "radioactive dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/6911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "The release of radioactive substances into the environment deriving from nuclear installations and from mining, purification and enrichment operations of radioactive elements."@en ;
    skos:prefLabel "radioactive emission"@en .

<http://www.eionet.europa.eu/gemet/concept/6912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3110> ;
    skos:definition "The material that descends to the earth or water well beyond the site of a surface or subsurface nuclear explosion."@en ;
    skos:prefLabel "radioactive fallout"@en .

<http://www.eionet.europa.eu/gemet/concept/6915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "A substance undergoing spontaneous decay or disintegration of atomic nuclei and giving off radiant energy in the form of particles or waves, often associated with an explosion of a nuclear weapon or an accidental release from a nuclear power plant, holding facility or transporting container."@en ;
    skos:prefLabel "radioactive pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/6919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5057> ;
    skos:definition "A radioactive isotope which, when injected into a biological or physical system, can be traced by radiation detection devices, permitting determination of the distribution or location of the substance to which it is attached."@en ;
    skos:prefLabel "radioactive tracer"@en .

<http://www.eionet.europa.eu/gemet/concept/6920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:prefLabel "radioactive tracer technique"@en .

<http://www.eionet.europa.eu/gemet/concept/6921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any waste that emit radiation in excess of normal background level, including the toxic by-products of the nuclear energy industry."@en ;
    skos:prefLabel "radioactive waste"@en .

<http://www.eionet.europa.eu/gemet/concept/6923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "The total supervision of the production, handling, processing, storage and transport of materials that contain radioactive nuclides and for which use, reuse or recovery are impractical."@en ;
    skos:prefLabel "radioactive waste management"@en .

<http://www.eionet.europa.eu/gemet/concept/6928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12004> ;
    skos:definition "A nuclide that exhibits radioactivity."@en ;
    skos:prefLabel "radionuclide"@en .

<http://www.eionet.europa.eu/gemet/concept/693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Term used in a variety of situations, always as the constant or natural amount of a given substance, radiation, noise, etc."@en ;
    skos:prefLabel "background level"@en .

<http://www.eionet.europa.eu/gemet/concept/6935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2635> ;
    skos:definition "A radioactive gaseous element emitted naturally from rocks and minerals where radioactive elements are present. It is released in non-coal mines, e.g. tin, iron, fluorspar, uranium. Radon is an alpha particle emitter as are its decay products and has been indicted as a cause of excessive occurrence of lung cancer in uranium miners. Concern has been expressed at radon levels in some housing usually adjacent to granite rocks or old tin mining regions."@en ;
    skos:prefLabel "radon"@en .

<http://www.eionet.europa.eu/gemet/concept/6937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded textile waste, either post-consumer waste or pre-consumer waste, such as manufacturing process scraps."@en ;
    skos:prefLabel "rag"@en .

<http://www.eionet.europa.eu/gemet/concept/6940> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "The movement and circulation of vehicles transporting goods and people on railroad systems."@en ;
    skos:prefLabel "rail traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/6941> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4676> ;
    skos:definition "Transportation of goods and persons by railway."@en ;
    skos:prefLabel "rail transport"@en .

<http://www.eionet.europa.eu/gemet/concept/6947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/637> ;
    skos:definition "Precipitation in the form of liquid water drops with diameters greater than 0.5 millimeter."@en ;
    skos:prefLabel "rain"@en .

<http://www.eionet.europa.eu/gemet/concept/695> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Radiation resulting from natural sources, as opposed to man-made sources, and to which people are exposed in everyday, normal life; for example from rocks and soil."@en ;
    skos:prefLabel "background radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/6950> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/636> ;
    skos:definition "Process by which particles in the atmosphere act as centres round which water can form drops which then falls as rain."@en ;
    skos:prefLabel "rainout"@en .

<http://www.eionet.europa.eu/gemet/concept/6951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:definition "Water which falls as rain from clouds."@en ;
    skos:prefLabel "rain water"@en .

<http://www.eionet.europa.eu/gemet/concept/6953> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The building up of land by the deposition of allochthonous material, such as rocks, gravel, etc."@en ;
    skos:prefLabel "raising a site"@en .

<http://www.eionet.europa.eu/gemet/concept/6959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Tests which do not always yield the same result when repeated under the same conditions."@en ;
    skos:prefLabel "random test"@en .

<http://www.eionet.europa.eu/gemet/concept/6962> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "A Eurasian cruciferous plant, Brassica napus, that is cultivated for its seeds, which yield a useful oil, and as a fodder plant."@en ;
    skos:prefLabel "rape (plant)"@en .

<http://www.eionet.europa.eu/gemet/concept/6963> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8606> ;
    skos:prefLabel "rapid transit train"@en .

<http://www.eionet.europa.eu/gemet/concept/6965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Species which have a restricted world range."@en ;
    skos:prefLabel "rare species"@en .

<http://www.eionet.europa.eu/gemet/concept/6968> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7172> ;
    skos:definition "The developed countries depend on a stable supply of raw materials for their industries. Total resource requirements are increasing rapidly over the entire world. In developed countries, although population is increasing slowly, per capita use is increasing rapidly, while the opposite is happening in developing countries. Traditionally raw materials have been classified as non-renewable resources, but a distinction may be important between \"loosable\" resources, such as oil and coal, and \"non-loosable\" resources, such as metals, which can be used several times over by recycling processes."@en ;
    skos:prefLabel "raw material consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/6970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures used to ensure the provision of or the access to crude, unprocessed or partially processed materials used as feedstock for processing or manufacturing."@en ;
    skos:prefLabel "raw material securing"@en .

<http://www.eionet.europa.eu/gemet/concept/6975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "That branch of physical chemistry concerned with the mechanisms and rates of chemical reactions."@en ;
    skos:prefLabel "reaction kinetics"@en .

<http://www.eionet.europa.eu/gemet/concept/6978> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Those studies and activities that seek to minimise the risk of a nuclear reactor accident."@en ;
    skos:prefLabel "reactor safety"@en .

<http://www.eionet.europa.eu/gemet/concept/6979> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/167> ;
    skos:definition "The planting of trees in forest areas which have been cleared. Reforestation has become increasingly important for preventing or reversing environmental degradation and for helping to maximize economic returns on commercially forested lands."@en ;
    skos:prefLabel "reforestation"@en .

<http://www.eionet.europa.eu/gemet/concept/6982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1419> ;
    skos:prefLabel "reasonableness"@en .

<http://www.eionet.europa.eu/gemet/concept/6988> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "Techniques and practical applications associated with recombinant DNA (deoxyribonucleic acid artificially introduced into a cell that alters the genotype and phenotype of the cell and is replicated along with the natural DNA)."@en ;
    skos:prefLabel "recombinant DNA technology"@en .

<http://www.eionet.europa.eu/gemet/concept/6989> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Recommendation refers to an action which is advisory in nature rather than one having any binding effect."@en ;
    skos:prefLabel "recommendation"@en .

<http://www.eionet.europa.eu/gemet/concept/699> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3184> ;
    skos:definition "A device that removes some suspended solids from sewage. Air and bacteria decompose additional wastes filtering through the sand so that cleaner water drains from the bed."@en ;
    skos:prefLabel "bacterial bed"@en .

<http://www.eionet.europa.eu/gemet/concept/6992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:prefLabel "recording of substances"@en .

<http://www.eionet.europa.eu/gemet/concept/6997> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Reclamation measures taken to restore the environmental quality level of a landscape to its predisturbed condition."@en ;
    skos:prefLabel "recovery of landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/700> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/816> ;
    skos:definition "An agent that destroys bacteria."@en ;
    skos:prefLabel "bactericide"@en .

<http://www.eionet.europa.eu/gemet/concept/7000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for the restoration of natural resources or the reuse of materials and objects."@en ;
    skos:prefLabel "recovery plan"@en .

<http://www.eionet.europa.eu/gemet/concept/7009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Characteristic of materials that still have useful physical or chemical properties after serving their original purpose and that can, therefore, be reused or remanufactured into additional products."@en ;
    skos:prefLabel "recyclability"@en .

<http://www.eionet.europa.eu/gemet/concept/7010> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6329> ;
    skos:definition "Plastic waste that can be transformed into new products."@en ;
    skos:prefLabel "recyclable plastic"@en .

<http://www.eionet.europa.eu/gemet/concept/7014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7012> ;
    skos:definition "Paper that has been separated from the solid waste stream for utilization as a raw material in the manufacture of a new product. Not all paper in the waste stream is recyclable. It may be heavily contaminated or otherwise unusable."@en ;
    skos:prefLabel "recycled paper"@en .

<http://www.eionet.europa.eu/gemet/concept/7018> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "Management of all the stages involved in the life of a product such as raw materials acquisition, manufacturing, distribution and retail, use and re-use and maintenance, recycling and waste management, in order to create less environmentally harmful products."@en ;
    skos:prefLabel "life-cycle management"@en .

<http://www.eionet.europa.eu/gemet/concept/7019> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9091> ;
    skos:definition "A binding rule or body of rules prescribed by government to establish and regulate provisions for the minimization of waste generation through recovery and reprocessing of re-usable products."@en ;
    skos:prefLabel "recycling management and waste law"@en .

<http://www.eionet.europa.eu/gemet/concept/702> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The science and study of bacteria."@en ;
    skos:prefLabel "bacteriology"@en .

<http://www.eionet.europa.eu/gemet/concept/7021> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7015> ;
    skos:prefLabel "recycling potential"@en .

<http://www.eionet.europa.eu/gemet/concept/7023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7015> ;
    skos:prefLabel "recycling ratio"@en .

<http://www.eionet.europa.eu/gemet/concept/7028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "An administrative or legal remedy that attempts to restore a person to his or her original or expected position prior to loss or injury, including breach of contract."@en ;
    skos:prefLabel "redress"@en .

<http://www.eionet.europa.eu/gemet/concept/7029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/303> ;
    skos:definition "Sea water which is covered or discoloured by the sudden growth of algal bloom or by a great increase in single-celled organisms, dinoflagellates. Red tides are often fatal to many forms of marine life and, in some cases, can result in human deaths because the dinoflagellates are eaten by clams and mussels which concentrate the paralysing toxins which they produce."@en ;
    skos:prefLabel "red tide"@en .

<http://www.eionet.europa.eu/gemet/concept/7030> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Chemical reaction in which an element gains an electron."@en ;
    skos:prefLabel "chemical reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/7032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "Any of various types of tall stiff grass-like plants growing together in groups near water."@en ;
    skos:prefLabel "reed"@en .

<http://www.eionet.europa.eu/gemet/concept/7036> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The processing of raw material to remove impurities."@en ;
    skos:prefLabel "refining"@en .

<http://www.eionet.europa.eu/gemet/concept/7037> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The return of waves or particles from surfaces on which they are incident."@en ;
    skos:prefLabel "reflection"@en .

<http://www.eionet.europa.eu/gemet/concept/7038> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "The study of the reflectance of light or other radiant energy."@en ;
    skos:prefLabel "reflectometry"@en .

<http://www.eionet.europa.eu/gemet/concept/7042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A substance that by undergoing a change in phase (liquid to gas, gas to liquid) releases or absorbs a large latent heat in relation to its volume, and thus effects a considerable cooling effect."@en ;
    skos:prefLabel "refrigerant"@en .

<http://www.eionet.europa.eu/gemet/concept/7043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "refrigeration industry"@en .

<http://www.eionet.europa.eu/gemet/concept/7044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The cooling of substances, usually food, below the environmental temperature for preservative purposes. Refrigeration is responsible for the largest and fastest-growing use of CFCs in the developing world. The industrial countries, and some developing countries, have taken exceptional steps to control and, eventually, ban the production of CFCs and other ozone-depleting materials by the year 2000. However, many developing nations have not signed the Montreal Protocol because they are afraid that the cost of changing over to alternative, ozone-friendly technology will be too high."@en ;
    skos:prefLabel "refrigeration"@en .

<http://www.eionet.europa.eu/gemet/concept/7045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225>,
        <http://www.eionet.europa.eu/gemet/concept/2633> ;
    skos:definition "An appliance, a cabinet, or a room for storing food or other substances at a low temperature."@en ;
    skos:prefLabel "refrigerator"@en .

<http://www.eionet.europa.eu/gemet/concept/7046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "A restricted and isolated area in which plants and animals persisted during a period of continental climatic change that made surrounding areas uninhabitable; especially an ice-free or unglaciated area within or close to a continental ice sheet or upland ice cap, where hardy biotas eked out an existence during a glacial phase. It later served as a center of dispersal for the repopulation of surrounding areas after climatic readjustment."@en ;
    skos:prefLabel "refuge"@en .

<http://www.eionet.europa.eu/gemet/concept/7047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A person who is outside his country of origin and who, due to well-founded fear of persecution, is unable or unwilling to avail himself of that country protection."@en ;
    skos:prefLabel "refugee"@en .

<http://www.eionet.europa.eu/gemet/concept/7050> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:definition "Special vehicles designed and equipped for the collection of wastes and their transportation to a waste disposal site."@en ;
    skos:prefLabel "refuse collection vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/7051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Fuel produced from domestic refuse, after glass and metals have been removed from it, by compressing it to form briquettes used to fuel boilers."@en ;
    skos:prefLabel "refuse derived fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/7056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1649> ;
    skos:definition "Compost derived by the biodegradation of the organic constituents of solid wastes and wastewater sludges. The major public health issues associated with composting using solid wastes mixed with sewage sludge are pathogens, heavy metal, and odors. The heat generated during composting, as a result of the activities of thermophilic organisms, is capable of killing bacteria, viruses, protozoa and helminths present in sewage sludge. The metallic elements in sludge of greatest concern to human health are cadmium, lead, arsenic, selenium, and mercury. Only cadmium is normally found in sewage sludge at levels which, when applied to soils, can be absorbed by plants, and accumulate in edible parts, thereby entering the food chain."@en ;
    skos:prefLabel "refuse-sludge compost"@en .

<http://www.eionet.europa.eu/gemet/concept/7058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7057> ;
    skos:definition "Making changes to old industrial plants installing new equipment's and facilities for the disposal of gas emissions in the atmosphere, of waste water and waste material in soil and water."@en ;
    skos:prefLabel "retrofitting of old plants"@en .

<http://www.eionet.europa.eu/gemet/concept/7059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8062> ;
    skos:definition "A designated area or an administrative division of a city, county or larger geographical territory that is formulated according to some biological, political, economic or demographic criteria."@en ;
    skos:prefLabel "region"@en .

<http://www.eionet.europa.eu/gemet/concept/7063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1776> ;
    skos:definition "An assembly of national, political party or organizational delegates representing persons or the interests of a specific geographic area, or the pact or the agreement that arises from such an assembly."@en ;
    skos:prefLabel "regional convention"@en .

<http://www.eionet.europa.eu/gemet/concept/7066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7075> ;
    skos:definition "The progress or advancement for a large geographical territory or a designated division of a country or state, particularly in economic growth that leads to modernization or industrialization."@en ;
    skos:prefLabel "regional development"@en .

<http://www.eionet.europa.eu/gemet/concept/7070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4749> ;
    skos:prefLabel "regional law"@en .

<http://www.eionet.europa.eu/gemet/concept/7073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "The plan for a region according to some physiographic, biological, political, administrative, economic, demographic, or other criteria."@en ;
    skos:prefLabel "regional plan"@en .

<http://www.eionet.europa.eu/gemet/concept/7077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by government, management or an international organization or treaty pertaining to or effective within a specific territory of one or more states."@en ;
    skos:prefLabel "regional regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/7079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:prefLabel "regional statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/7080> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7075> ;
    skos:definition "The organization or arrangement of a large geographical territory or a designated division of a country or state that may be formulated according to some administrative, biological, political, economic or demographic criteria."@en ;
    skos:prefLabel "regional structure"@en .

<http://www.eionet.europa.eu/gemet/concept/7083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:definition "The course of action or record in which an individual, company or an organization formally enrolls with a government agency or an authority in order to be granted certain rights, particularly trademark or copyright privileges, or the permission to sell and distribute a product."@en ;
    skos:prefLabel "registration proceeding"@en .

<http://www.eionet.europa.eu/gemet/concept/7084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "Resources that have a natural rate of availability and yield a continual flow of services which may be consumed in any time period without endangering future consumption possibilities as long as current use does not exceed net renewal during the period under consideration."@en ;
    skos:prefLabel "renewable raw material"@en .

<http://www.eionet.europa.eu/gemet/concept/7086> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by a government or an international organization or treaty establishing levels of hazardous materials in the environment or in ingestible substances beyond which human exposure is deemed health-threatening."@en ;
    skos:prefLabel "regulation on maximum permissible limits"@en .

<http://www.eionet.europa.eu/gemet/concept/7087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A rule established by authority; a permanent rule of action; a law or statute. In its most common meaning, the term is used to designate the enactment of the legislative body."@en ;
    skos:prefLabel "ordinance"@en .

<http://www.eionet.europa.eu/gemet/concept/7089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6290> ;
    skos:prefLabel "regulative law"@en .

<http://www.eionet.europa.eu/gemet/concept/7090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "Government supervision over the obligations and rights of an industry or enterprise for the purpose of providing the public with services that are considered important, vital or necessary to most members of a community or area."@en ;
    skos:prefLabel "regulatory control"@en .

<http://www.eionet.europa.eu/gemet/concept/7092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4022> ;
    skos:definition "To provide with new or different housing."@en ;
    skos:prefLabel "rehousing"@en .

<http://www.eionet.europa.eu/gemet/concept/7094> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The relating of causes to the effects that they produce."@en ;
    skos:prefLabel "cause-effect relation"@en .

<http://www.eionet.europa.eu/gemet/concept/7099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The expression of man's belief in and reverence for a superhuman power recognized as the creator and governor of the universe."@en ;
    skos:prefLabel "religion"@en .

<http://www.eionet.europa.eu/gemet/concept/71> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6594> ;
    skos:definition "A collection of persons united to address specific sociopolitical or socioeconomic concerns."@en ;
    skos:prefLabel "action group"@en .

<http://www.eionet.europa.eu/gemet/concept/710> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "Considering, weighing or counterbalancing the competing political or financial concerns of different parts of society, including industries, consumers, trade unions and other groups or organizations."@en ;
    skos:prefLabel "balancing of interests"@en .

<http://www.eionet.europa.eu/gemet/concept/7102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8351> ;
    skos:definition """1) The scientific detection, recognition, inventory and analysis of land and water area by the use of distant sensors or recording devices such as photography, thermal scanners, radar, etc. 
2) Complex of techniques for the remote measure of electromagnetic energy emitted by objects."""@en ;
    skos:prefLabel "remote sensing"@en .

<http://www.eionet.europa.eu/gemet/concept/7107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/2741> ;
    skos:definition "Energy sources that do not rely on fuels of which there are only finite stocks. The most widely used renewable source is hydroelectric power; other renewable sources are biomass energy, solar energy, tidal energy, wave energy, and wind energy; biomass energy does not avoid the danger of the greenhouse effect."@en ;
    skos:prefLabel "renewable energy source"@en .

<http://www.eionet.europa.eu/gemet/concept/7108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7168> ;
    skos:definition "Resources capable of being continuously renewed or replaced through such processes as organic reproduction and cultivation such as those practiced in agriculture, animal husbandry, forestry and fisheries."@en ;
    skos:prefLabel "renewable resource"@en .

<http://www.eionet.europa.eu/gemet/concept/7110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4022> ;
    skos:definition "Dwelling places occupied by tenants who make periodic payments to landlords or owners for use of the facilities as residences."@en ;
    skos:prefLabel "rental housing"@en .

<http://www.eionet.europa.eu/gemet/concept/7112> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "Any commercial activity, position or site that involves work in restoring or fixing some material thing or structure, such as by replacing parts or putting together something torn, broken or detached."@en ;
    skos:prefLabel "repair business"@en .

<http://www.eionet.europa.eu/gemet/concept/7115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "The amount of money involved to replace or have an item take the place of another item."@en ;
    skos:prefLabel "replacement cost"@en .

<http://www.eionet.europa.eu/gemet/concept/7118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10833> ;
    skos:definition "Any conduct or action undertaken on behalf of a person, group, business or government, often as an elected or appointed voice."@en ;
    skos:prefLabel "representation"@en .

<http://www.eionet.europa.eu/gemet/concept/7119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6650> ;
    skos:definition "Restoration of contaminated nuclear fuel to a usable condition."@en ;
    skos:prefLabel "reprocessing"@en .

<http://www.eionet.europa.eu/gemet/concept/7122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3624> ;
    skos:definition "The technology involved in altering in some prescribed way the genetic constitution of an organism. Typically \"useful\" genes, i.e. very short sequence of DNA, are isolated from one organism and inserted into the DNA of a bacterium of yeast. These microorganisms multiply rapidly and can be cultured easily, enabling large quantities of the gene product to be obtained. Reproductive manipulation has been used for the large-scale production of antibiotics, enzymes, and hormones (e.g. insulin). Organisms into which foreign DNA has been artificially inserted are called \"transgenic organisms\"."@en ;
    skos:prefLabel "reproductive manipulation"@en .

<http://www.eionet.europa.eu/gemet/concept/7126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6822> ;
    skos:definition "Service organized to provide immediate assistance to persons injured or in distress."@en ;
    skos:prefLabel "rescue service"@en .

<http://www.eionet.europa.eu/gemet/concept/7135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "Proposal, plan or design containing the necessary information and data for conducting a specific survey."@en ;
    skos:prefLabel "research project"@en .

<http://www.eionet.europa.eu/gemet/concept/7146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7143> ;
    skos:definition "Residential zones where raised areas are built across roads so that vehicles are forced to move more slowly along it."@en ;
    skos:prefLabel "residential area with traffic calmings"@en .

<http://www.eionet.europa.eu/gemet/concept/7149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9172> ;
    skos:definition "Amount of water left in a water course after it has fed a hydropower plant in order to maintain a satisfactory dry-weather-flow for allowing the survival of biotic communities."@en ;
    skos:prefLabel "residual amount of water"@en .

<http://www.eionet.europa.eu/gemet/concept/7155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Remaining potential for harm to persons, property or the environment following all possible efforts to reduce predictable hazards."@en ;
    skos:prefLabel "residual risk"@en .

<http://www.eionet.europa.eu/gemet/concept/7159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "Analysis of residues from agricultural chemicals used in food crops and contained in foodstuff. The analyses use gas chromatography, liquid chromatography, mass spectrometry, immunoassays, etc."@en ;
    skos:prefLabel "residue analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7015> ;
    skos:definition "Recycling of material or energy which is left over or wasted in industrial processes and other human activities. Examples include waste heat and gaseous pollutants from electricity generation, slag from metal-ore refining, and garbage. A residual becomes an output or input when a technological advance creates economic opportunities for the waste."@en ;
    skos:prefLabel "residue recycling"@en .

<http://www.eionet.europa.eu/gemet/concept/7161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "Any of a class of solid or semisolid organic products of natural or synthetic origin with no definite melting point, generally of high molecular weight; most resins are polymers."@en ;
    skos:prefLabel "resin"@en .

<http://www.eionet.europa.eu/gemet/concept/7163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition """1) The ability of a plant to overcome, retard, suppress, or prevent infection or colonization by a pathogen, parasite, or adverse abiotic factor. 
2) The ability of insects, fungi, weeds, or other pests to survive normally lethal doses of an insecticide, fungicide, herbicide, or other pesticide."""@en ;
    skos:prefLabel "resistance (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/7165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A formal expression of the opinion of an official body or a public assembly, adopted by vote, as a legislative resolution."@en ;
    skos:prefLabel "resolution (act)"@en .

<http://www.eionet.europa.eu/gemet/concept/7167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7930> ;
    skos:definition "Absorption or, less commonly, adsorption of material by a body or system from which the material was previously released."@en ;
    skos:prefLabel "resorption"@en .

<http://www.eionet.europa.eu/gemet/concept/7173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:prefLabel "resource reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/7178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7176> ;
    skos:definition "Air volumes inspired and expired through the lungs."@en ;
    skos:prefLabel "respiratory air"@en .

<http://www.eionet.europa.eu/gemet/concept/718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6709> ;
    skos:definition "Prohibition of spreading sewage sludge on land to prevent accumulation of toxic heavy metals in excessive quantities."@en ;
    skos:prefLabel "sewage spreading prohibition"@en .

<http://www.eionet.europa.eu/gemet/concept/7180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Any of a group of devices that protect the respiratory system from exposure to airborne contaminants; usually a mask with a fitting to cover the nose and mouth."@en ;
    skos:prefLabel "respiratory protection apparatus"@en .

<http://www.eionet.europa.eu/gemet/concept/7182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7181> ;
    skos:definition "The structures and passages involved with intake, expulsion, and exchange of oxygen and carbon dioxide in the vertebrate body."@en ;
    skos:prefLabel "respiratory tract"@en .

<http://www.eionet.europa.eu/gemet/concept/7187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "Resistant structure that allows the organism to survive adverse environmental conditions."@en ;
    skos:prefLabel "resting form"@en .

<http://www.eionet.europa.eu/gemet/concept/7188> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "The process of renewing or returning something to its original, normal or unimpaired condition, particularly works of art, cultural artifacts, furniture or buildings."@en ;
    skos:prefLabel "restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/7189> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:definition "Procedure or course of action taken to reestablish or bring back to state of environmental or ecological health."@en ;
    skos:prefLabel "restoration measure"@en .

<http://www.eionet.europa.eu/gemet/concept/719> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:definition "A soft silvery-white metallic element of the alkaline earth group. It is used in bearing alloys and compounds are used as pigments."@en ;
    skos:prefLabel "barium"@en .

<http://www.eionet.europa.eu/gemet/concept/7191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2009> ;
    skos:definition "Any decision, action or policy which limits or constrains the making of valued goods or services."@en ;
    skos:prefLabel "restriction of production"@en .

<http://www.eionet.europa.eu/gemet/concept/7192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A limitation on the utilization of land or some other property, often inscribed in a deed or lease document."@en ;
    skos:prefLabel "restriction on use"@en .

<http://www.eionet.europa.eu/gemet/concept/7193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The sale of goods to ultimate consumers, usually in small quantities."@en ;
    skos:prefLabel "retail trade"@en .

<http://www.eionet.europa.eu/gemet/concept/7194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A basin designed and operated to provide temporary storage and thus reduce the peak flood flows of a stream."@en ;
    skos:prefLabel "retarding basin"@en .

<http://www.eionet.europa.eu/gemet/concept/7195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition """1) Addition of a pollution control device on an existing facility without making major changes to the generating plant.
2) Providing a jet, an automobile, a computer, or a factory, for example, with parts, devices or equipment not in existence or available at the time of original manufacture."""@en ;
    skos:prefLabel "retrofitting"@en .

<http://www.eionet.europa.eu/gemet/concept/7197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5003> ;
    skos:prefLabel "return to nature"@en .

<http://www.eionet.europa.eu/gemet/concept/7198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1746> ;
    skos:definition "Any container which has been conceived and designed to accomplish within its life cycle a minimum number of trips or rotations in order to be refilled or reused for the same purpose for which it was conceived."@en ;
    skos:prefLabel "reusable container"@en .

<http://www.eionet.europa.eu/gemet/concept/72> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A powdered, granular or pelleted form of amorphous carbon characterized by a very large surface area per unit volume because of an enormous number of fine pores."@en ;
    skos:prefLabel "activated carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/7201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Any re-utilization of products or components, in original form, such as when used glass bottles are sterilized and refilled for resale."@en ;
    skos:prefLabel "reuse of materials"@en .

<http://www.eionet.europa.eu/gemet/concept/7202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7104> ;
    skos:definition "Planting of new trees and, particularly, of native plants in disturbed sites where the vegetation cover has been destroyed, to stabilize the land surface from wind and water erosion and to reclame the land for other uses. Revegetation practices are employed in mined lands, roadsides, parks, wetlands, utility corridors, riparian areas, etc."@en ;
    skos:prefLabel "revegetation"@en .

<http://www.eionet.europa.eu/gemet/concept/7204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5949> ;
    skos:definition "A method of obtaining pure water from water containing a salt, as in desalination. Pure water and the salt water are separated by a semipermeable membrane and the pressure of the salt water is raised above the osmotic pressure, causing water from the brine to pass through the membrane into the pure water. This process requires a pressure of some 25 atmospheres, which makes it difficult to apply on a large scale."@en ;
    skos:prefLabel "reverse osmosis"@en .

<http://www.eionet.europa.eu/gemet/concept/7214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "An erect grass, Oryza sativa, that grows in East Asia on wet ground and has drooping flower spikes and yellow oblong edible grains that become white when polished."@en ;
    skos:prefLabel "rice"@en .

<http://www.eionet.europa.eu/gemet/concept/7217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A legal guarantee or just claim enabling a citizen or employee to compose and submit a formal written request to an authority asking for some benefit or favor or for intervention and redress of some wrong."@en ;
    skos:prefLabel "petition right"@en .

<http://www.eionet.europa.eu/gemet/concept/7218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The legal guarantee or just claim inhering in a citizen's relation to some physical thing, but especially a plot of land, including the right to possess, use and dispose of it."@en ;
    skos:prefLabel "right of property"@en .

<http://www.eionet.europa.eu/gemet/concept/7221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "A legally enforceable claim for payment or reimbursement to pay for damages, loss or injury, or for remuneration to pay for services rendered, whether in fees, commissions or salary."@en ;
    skos:prefLabel "right to compensation"@en .

<http://www.eionet.europa.eu/gemet/concept/7222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:definition "The individual's right to know in general about the existence of data banks, the right to be informed on request and the general right to a print-out of the information registered and to know the actual use made of the information."@en ;
    skos:prefLabel "right to information"@en .

<http://www.eionet.europa.eu/gemet/concept/7223> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "To attach a numbered ring to the leg of a bird so that its movements can be recorded. Ringing is a very common method of tracing bird movement and providing information about bird's ages. It can also cause stress to the birds."@en ;
    skos:prefLabel "ringing (wildlife)"@en .

<http://www.eionet.europa.eu/gemet/concept/7227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7340> ;
    skos:definition "The removal of thin layers of surface material more or less evenly from an extensive area of gently sloping land, by broad continuous sheets of running water rather than by streams flowing in well-defined channels; e.g. erosion that occurs when rain washes away a thin layer of topsoil."@en ;
    skos:prefLabel "rinsing"@en .

<http://www.eionet.europa.eu/gemet/concept/7230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition """1) Terrestrial areas where the vegetation complex and microclimate are products of the combined pressure and influence of perennial and/or intermittent water... and soils that exhibit some wetness characteristics.
2) Zone situated on the bank of a water course such as a river or stream."""@en ;
    skos:prefLabel "riparian zone"@en .

<http://www.eionet.europa.eu/gemet/concept/7232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7513> ;
    skos:definition "Sea level rises are a possible consequence of global warming. As the amount of free water in the ocean increases, and as the water becomes warmer, global warming will increase. In addition, according to theory, the heating at the poles may reduce the amount of water trapped in glaciers and ice caps. By the year 3000, the seas could rise between one and two metres. Such an event would clearly threaten low-lying areas, particularly in Asia, where million of people live and farm on river deltas and flood plains."@en ;
    skos:prefLabel "rising sea level"@en .

<http://www.eionet.europa.eu/gemet/concept/7235> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "Technique used to determine the likelihood or chance of hazardous events occurring (such as release of a certain quantity of a toxic gas) and the likely consequences. Originally developed for use in nuclear and chemical industry where certain possible events, of low probability, could have extremely serious results. Attempts are being made to use concepts from probabilistic risk analysis to characterise environmental impacts, whose occurrence and nature are not easy to predict with any degree of accuracy."@en ;
    skos:prefLabel "risk analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "A systematic process of evaluating and assessing the hazards of loss versus the possibility of financial gain or profit."@en ;
    skos:prefLabel "risk-benefit analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The exchange of information about health or environmental risks among risk assessors and managers, the general public, news media, interest groups, etc."@en ;
    skos:prefLabel "risk communication"@en .

<http://www.eionet.europa.eu/gemet/concept/7240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "A subjective appreciation by individuals which will more often than not bear little relation to the statistical probability of damage or injury."@en ;
    skos:prefLabel "risk perception"@en .

<http://www.eionet.europa.eu/gemet/concept/7241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "Any act, instance or process lowering the probability that harm will come to an area or its population as the result of some hazard."@en ;
    skos:prefLabel "risk reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/7251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145>,
        <http://www.eionet.europa.eu/gemet/concept/15281>,
        <http://www.eionet.europa.eu/gemet/concept/15282> ;
    skos:definition "Any growth, maturation or change in an area of land drained by a river and its tributaries."@en ;
    skos:prefLabel "river basin development"@en .

<http://www.eionet.europa.eu/gemet/concept/7257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1288> ;
    skos:definition "The alteration of a natural stream by excavation, realignment, lining or other means to accelerate the flow of water."@en ;
    skos:prefLabel "river channelling"@en .

<http://www.eionet.europa.eu/gemet/concept/726> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "Monitoring of long-term changes in atmospheric compositions of particular significance to the weather and the climate."@en ;
    skos:prefLabel "baseline monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/7266> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3493> ;
    skos:definition "The direct or indirect human alteration of the biological, physical, chemical or radiological integrity of river water, or a river ecosystem."@en ;
    skos:prefLabel "river pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/7269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3485> ;
    skos:definition "Water which flows in a channel from high ground to low ground and ultimately to a lake or the sea, except in a desert area where it may dwindle away to nothing."@en ;
    skos:prefLabel "river water"@en .

<http://www.eionet.europa.eu/gemet/concept/7276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6815> ;
    skos:prefLabel "road construction"@en .

<http://www.eionet.europa.eu/gemet/concept/7279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6824> ;
    skos:definition "The care or upkeep of streets, highways and other routes, including improvements in alignment, widening and markings, and work involving buried cables, water mains or gas mains."@en ;
    skos:prefLabel "road maintenance"@en .

<http://www.eionet.europa.eu/gemet/concept/728> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Any chemical species, ionic or molecular, capable of accepting or receiving a proton (hydrogen ion) from another substance; the other substance acts as an acid in giving of the proton; the other ion is a base."@en ;
    skos:prefLabel "base (chemical)"@en .

<http://www.eionet.europa.eu/gemet/concept/7282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Any measure, technique or design intended to reduce the risk of harm posed by moving vehicles along a constructed land route."@en ;
    skos:prefLabel "road safety"@en .

<http://www.eionet.europa.eu/gemet/concept/7283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Salt used against the formation of ice on roads; when excess salt washes off the roads, it can poison roadside vegetation or raise salt concentrations in streams and reserves of underground water. It also accelerates the deterioration of concrete and metal."@en ;
    skos:prefLabel "road salt"@en .

<http://www.eionet.europa.eu/gemet/concept/7295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8589> ;
    skos:definition "Discipline which includes the design of highways and pedestrian ways, the study and application of traffic statistics, and the environmental aspects of the transportation of goods and people."@en ;
    skos:prefLabel "road traffic engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/7296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4676> ;
    skos:definition "Transportation of goods and persons by vehicles travelling on a road network."@en ;
    skos:prefLabel "road transport"@en .

<http://www.eionet.europa.eu/gemet/concept/73> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7740> ;
    skos:definition "Sludge that has been aerated and subjected to bacterial action; used to speed breakdown of organism matter in raw sewage during secondary waste treatment."@en ;
    skos:prefLabel "activated sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3381> ;
    skos:definition "The minimum nutriments deemed necessary for a person of a particular age, gender, physiological condition and activity level to sustain life, health and growth."@en ;
    skos:prefLabel "basic food requirement"@en .

<http://www.eionet.europa.eu/gemet/concept/7302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5267> ;
    skos:definition "A generic term for felted or matted fibers manufactured by blowing or spinning threads of molten rock, slag, or glass. The material is used for thermal insulation."@en ;
    skos:prefLabel "rock wool"@en .

<http://www.eionet.europa.eu/gemet/concept/7306> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Any of the relatively small placental mammals that constitute the order Rodentia, having constantly growing incisor teeth specialized for gnawing."@en ;
    skos:prefLabel "rodent"@en .

<http://www.eionet.europa.eu/gemet/concept/731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/48> ;
    skos:definition "The state of a solution of containing an excess of hydroxyl ions."@en ;
    skos:prefLabel "basicity"@en .

<http://www.eionet.europa.eu/gemet/concept/7312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6300> ;
    skos:definition "The absorbing and anchoring organ of a vascular plant; it bears neither leaves nor flowers and is usually subterranean."@en ;
    skos:prefLabel "root"@en .

<http://www.eionet.europa.eu/gemet/concept/7314> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3538> ;
    skos:definition "A heat-treating furnace of circular construction which rotates the workpiece around the axis of the furnace during heat treatment; workpieces are transported through the furnace along a circular path."@en ;
    skos:prefLabel "rotary furnace"@en .

<http://www.eionet.europa.eu/gemet/concept/7324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A cream to dark brown elastic material obtained by coagulating and drying the latex from certain plants, especially the rubber tree."@en ;
    skos:prefLabel "rubber"@en .

<http://www.eionet.europa.eu/gemet/concept/7326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7327> ;
    skos:definition "The systematic series of actions in which a solid substance deriving from rubber trees and plants is toughened and treated chemically to give it the strength, elasticity, resistance and other qualities needed for the manufacture of products such as erasers, elastic bands, water hoses, electrical insulation and tires."@en ;
    skos:prefLabel "rubber processing"@en .

<http://www.eionet.europa.eu/gemet/concept/7328> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any refuse or unwanted material made of synthetic or natural rubber, often the byproduct of rubber processing."@en ;
    skos:prefLabel "rubber waste"@en .

<http://www.eionet.europa.eu/gemet/concept/7348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "Environment pertaining to the countryside."@en ;
    skos:prefLabel "rural environment"@en .

<http://www.eionet.europa.eu/gemet/concept/7352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The total number of persons inhabiting an agricultural or pastoral region."@en ;
    skos:prefLabel "rural population"@en .

<http://www.eionet.europa.eu/gemet/concept/7354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8522> ;
    skos:definition "Holidays organized in a farm: meals are prepared with natural products and guests are entertained with handicraft, sporting and agricultural activities."@en ;
    skos:prefLabel "agritourism"@en .

<http://www.eionet.europa.eu/gemet/concept/7355> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9244> ;
    skos:prefLabel "rural water supply"@en .

<http://www.eionet.europa.eu/gemet/concept/736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "A process that is not in continuous or mass production; operations are carried out with discrete quantities of material or a limited number of items."@en ;
    skos:prefLabel "batch process"@en .

<http://www.eionet.europa.eu/gemet/concept/7363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The process of studying the need for or efficacy of actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "A principle or regulation governing actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety rule"@en .

<http://www.eionet.europa.eu/gemet/concept/7369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7367> ;
    skos:definition "A collection of rules and regulations adopted by authorities concerning structural and mechanical standards for safety."@en ;
    skos:prefLabel "safety standard for building"@en .

<http://www.eionet.europa.eu/gemet/concept/7370> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "Research, detailed examination and usually a written report on the need for or efficacy of actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety study"@en .

<http://www.eionet.europa.eu/gemet/concept/7373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/387> ;
    skos:definition "Any of various urodele amphibians, such as Salamandra salamandra of central and S Europe. They are typically terrestrial, have an elongated body, and only return to water to breed."@en ;
    skos:prefLabel "salamander"@en .

<http://www.eionet.europa.eu/gemet/concept/7384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1561> ;
    skos:definition "General name for a family of microorganisms, one of the largest groups of bacteria, that includes those most frequently implicated in food poisoning and gastroenteritis. Unhygienic handling and inadequate cooking of poultry and meat, improper storage of cold meats and, more recently, contamination of battery-reared hen eggs, are the most common sources of salmonella infections."@en ;
    skos:prefLabel "salmonella"@en .

<http://www.eionet.europa.eu/gemet/concept/7395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:prefLabel "salt load"@en .

<http://www.eionet.europa.eu/gemet/concept/7396> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8252> ;
    skos:definition "Areas of brackish, shallow water usually found in coastal areas and in deltas. There are also inland marshes in arid areas where the water has a high salt level because of evaporation. They are environmentally delicate areas, extremely vulnerable to pollution by industrial or agricultural chemicals, or to thermal pollution, which often results when river water has been used as the coolant in power stations and industrial plants."@en ;
    skos:prefLabel "salt marsh"@en .

<http://www.eionet.europa.eu/gemet/concept/7397> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5110> ;
    skos:definition "A meadow subject to overflow by salt water."@en ;
    skos:prefLabel "salt meadow"@en .

<http://www.eionet.europa.eu/gemet/concept/7400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5264> ;
    skos:definition "A mass of salt which is injected as a diapir (a dome in which the overlying rocks have been ruptured by the squeezing-out of plastic core material) into overlying sedimentary rocks, thereby piercing and deforming them. The mechanism is similar to that of an intrusive magma, with the salt deforming and behaving plastically under pressure. It is of great economic importance because it assists in the formation of a \"trap\" structure for oil accumulation, in addition to its associated deposits of anhydrite, gypsum and sulphur."@en ;
    skos:prefLabel "salt plug"@en .

<http://www.eionet.europa.eu/gemet/concept/7401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "The reaction product when a metal displaces the hydrogen of an acid."@en ;
    skos:prefLabel "salt"@en .

<http://www.eionet.europa.eu/gemet/concept/7404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6822> ;
    skos:definition "The act, process, or business of rescuing vessels or their cargoes from loss at sea."@en ;
    skos:prefLabel "salvage"@en .

<http://www.eionet.europa.eu/gemet/concept/7410> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7407> ;
    skos:definition "Method of selecting items at random from a set in such a manner that the sample will be representative of the whole."@en ;
    skos:prefLabel "sampling technique"@en .

<http://www.eionet.europa.eu/gemet/concept/7413> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "A loose material consisting of small mineral particles, or rock and mineral particles, distinguishable by the naked eye; grains vary from almost spherical to angular, with a diameter range from 1/16 to 2 millimeters."@en ;
    skos:prefLabel "sand"@en .

<http://www.eionet.europa.eu/gemet/concept/7419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Stabilization of dunes effected by the planting of marram grass (Ammophila arenaria), or rice grass, whose long roots bind the surface layers of sand and so hinder its removal by wind. A larger scale method of dealing with the same problem is by afforestation."@en ;
    skos:prefLabel "sand dune fixation"@en .

<http://www.eionet.europa.eu/gemet/concept/7420> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2377> ;
    skos:definition "An accumulation of loose sand heaped up by the wind, commonly found along low-lying seashores above high-tide level, more rarely on the border of large lakes or river valleys, as well as in various desert regions, where there is abundant dry surface sand during some part of the year."@en ;
    skos:prefLabel "sand dune"@en .

<http://www.eionet.europa.eu/gemet/concept/7423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "The extraction of sand by mining for building purposes and for the extraction of heavy minerals such as rutile and zircon."@en ;
    skos:prefLabel "sand extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/7425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5286> ;
    skos:definition "A place where sand is extracted from the ground."@en ;
    skos:prefLabel "sand pit"@en .

<http://www.eionet.europa.eu/gemet/concept/7436> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2290> ;
    skos:definition "The set of furnishings designed for personal hygiene and the disposal of organic waste."@en ;
    skos:prefLabel "sanitary fitting"@en .

<http://www.eionet.europa.eu/gemet/concept/7438> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "An engineered method of disposing of solid waste on land in a manner that protects the environment, by spreading the waste in thin layers, compacting it to the smallest practical volume and covering it with compacted soil by the end of each working day or at more frequent intervals if necessary."@en ;
    skos:prefLabel "sanitary landfill"@en .

<http://www.eionet.europa.eu/gemet/concept/7443> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6798> ;
    skos:definition "The study and use of practical measures for the preservation of public health."@en ;
    skos:prefLabel "sanitation"@en .

<http://www.eionet.europa.eu/gemet/concept/7444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "Plans for the control of the physical factors in the human environment that can harm development, health, or survival."@en ;
    skos:prefLabel "sanitation plan"@en .

<http://www.eionet.europa.eu/gemet/concept/7449> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11124> ;
    skos:definition "Indication or measure of the level of organic pollution."@en ;
    skos:prefLabel "saprobic index"@en .

<http://www.eionet.europa.eu/gemet/concept/7450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8683> ;
    skos:definition "Referring to the classification of organisms according to the way in which they tolerate pollution."@en ;
    skos:prefLabel "saprobe"@en .

<http://www.eionet.europa.eu/gemet/concept/7452> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7962> ;
    skos:definition "An object that orbits around a larger one. Artificial satellites orbiting the Earth are used for communications, the gathering of military intelligence, the monitoring of weather and other environmental phenomena, etc."@en ;
    skos:prefLabel "satellite"@en .

<http://www.eionet.europa.eu/gemet/concept/7457> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4187> ;
    skos:definition "The amount of current income which is not spent for survival or enjoyment."@en ;
    skos:prefLabel "saving"@en .

<http://www.eionet.europa.eu/gemet/concept/7458> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9358> ;
    skos:definition "Wood fragments made by a saw in cutting."@en ;
    skos:prefLabel "sawdust"@en .

<http://www.eionet.europa.eu/gemet/concept/746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:prefLabel "battery disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/7464> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9426> ;
    skos:definition "A disease in which humans are parasitized by any of three species of blood flukes: Schistosoma mansoni, S. haematobium, and S. japonicum; adult worms inhabit the blood vessels."@en ;
    skos:prefLabel "schistosomiasis"@en .

<http://www.eionet.europa.eu/gemet/concept/7465> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "An institution or building at which children and young people receive education."@en ;
    skos:prefLabel "school"@en .

<http://www.eionet.europa.eu/gemet/concept/7470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "Instruction or training received in any educational institution, but especially to persons under college age."@en ;
    skos:prefLabel "school teaching"@en .

<http://www.eionet.europa.eu/gemet/concept/7477> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Knowledge communicated or received pertaining to the systematic study of the physical world or to the mechanical or industrial arts."@en ;
    skos:prefLabel "scientific and technical information"@en .

<http://www.eionet.europa.eu/gemet/concept/7478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7480> ;
    skos:prefLabel "scientific co-operation"@en .

<http://www.eionet.europa.eu/gemet/concept/7482> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2844> ;
    skos:definition "The prescribed step or manner of proceeding in an environmental impact assessment, by which a public discussion is held to discuss the information that needs to be developed, the alternatives that need to be considered and other important environmental issues."@en ;
    skos:prefLabel "scoping procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/7484> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5058> ;
    skos:definition "The trade or traffic in discarded or leftover materials that can be reused in some way."@en ;
    skos:prefLabel "scrap material market"@en .

<http://www.eionet.europa.eu/gemet/concept/7485> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "The amount of money or the monetary rate at which materials discarded from manufacturing operations can be bought or sold."@en ;
    skos:prefLabel "scrap material price"@en .

<http://www.eionet.europa.eu/gemet/concept/7489> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7483> ;
    skos:definition "Car which is delivered for breaking up or otherwise discarded."@en ;
    skos:prefLabel "scrap vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/749> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3800> ;
    skos:definition "An open, curving indentation made by the sea or a lake into a coastline."@en ;
    skos:prefLabel "bay"@en .

<http://www.eionet.europa.eu/gemet/concept/7491> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The reduction of the electric field about a nucleus by the space charge of the surrounding electrons."@en ;
    skos:prefLabel "screening"@en .

<http://www.eionet.europa.eu/gemet/concept/7497> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8158> ;
    skos:definition "The bottom of the ocean. Also known as sea floor; sea bottom. The ocean floor is defined as the near-horizontal surface of the ocean basin."@en ;
    skos:prefLabel "sea bed"@en .

<http://www.eionet.europa.eu/gemet/concept/7498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12171> ;
    skos:definition "Marine mineral resources extend far beyond those presently exploited; minerals are derived from two separate types of marine sources: from sedimentary deposits underlying the continental shelves and from inshore deposits on the surface of the continental shelves. By far the most valuable of the mineral resources exploited from marine environments is petroleum. Offshore placer deposits on the surface of the continental shelves yield gold, platinum, and tin. On the floors of the world's oceans manganese nodules are found as a result of pelagic sedimentation or precipitation; they are small, irregular, black to brown, friable, laminated concretionary masses consisting primarily of manganese salts and manganese-oxide minerals."@en ;
    skos:prefLabel "sea bed exploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/7500> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "The activity or processes involving the extraction of mineral deposits from the surface, or below the surface, of the ocean floor."@en ;
    skos:prefLabel "sea bed mining"@en .

<http://www.eionet.europa.eu/gemet/concept/7514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3692> ;
    skos:definition "Sea-level rises are a possible consequence of global warming. As the amount of free water in the oceans increases, and as the water becomes warmer, global warming will increase. In addition, according to theory, the heating at the poles may reduce the amount of water trapped in glaciers and ice caps."@en ;
    skos:prefLabel "sea level rise"@en .

<http://www.eionet.europa.eu/gemet/concept/7519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "Any device or system that creates a nonleaking union between two mechanical or process-system elements."@en ;
    skos:prefLabel "seal (technical)"@en .

<http://www.eionet.europa.eu/gemet/concept/7520> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5044> ;
    skos:definition "The point, location or structure where effluent discharges into a body of marine waters such as a sea, ocean, etc."@en ;
    skos:prefLabel "sea outfall"@en .

<http://www.eionet.europa.eu/gemet/concept/7529> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2406> ;
    skos:definition "One of the four equal periods into which the year is divided by the equinoxes and solstices, resulting from the apparent movement of the sun north and south of the equator during the course of the earth's orbit around it. These periods (spring, summer, autumn and winter) have their characteristic weather conditions in different regions, and occur at opposite times of the year in the N and S hemispheres."@en ;
    skos:prefLabel "season"@en .

<http://www.eionet.europa.eu/gemet/concept/7535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7402> ;
    skos:definition "Aqueous solution of salts in more or less constant ratio, whose composition depends on several factors among which predominate living organisms, detrital sedimentation and the related chemical reactions. Sea-water accounts for more than 98% of the mass of the hydrosphere and covers just over 70% of the globe. Because of the composition and stability of the oceans, and the way they are controlled, they are of great importance to the climate, and great attention has been given to studying the effects of pollution. Man's activities are believed to be accelerating the change in the composition of sea-water."@en ;
    skos:prefLabel "sea water"@en .

<http://www.eionet.europa.eu/gemet/concept/7536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12165> ;
    skos:definition "Removing salt from ocean or brackish water."@en ;
    skos:prefLabel "sea water desalination"@en .

<http://www.eionet.europa.eu/gemet/concept/7538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9206> ;
    skos:prefLabel "sea water protection"@en .

<http://www.eionet.europa.eu/gemet/concept/7541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/901> ;
    skos:definition "In the case of disruption of an existing biotope, secondary biotope can be created as a compensation and substitute measure for the loss of the natural one."@en ;
    skos:prefLabel "secondary biotope"@en .

<http://www.eionet.europa.eu/gemet/concept/7542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13307> ;
    skos:definition "The years of instruction following elementary school and until the end of high school."@en ;
    skos:prefLabel "secondary education"@en .

<http://www.eionet.europa.eu/gemet/concept/7548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7554> ;
    skos:definition "The part of a country or region's economy that produces commodities without much direct use of natural resources."@en ;
    skos:prefLabel "secondary sector"@en .

<http://www.eionet.europa.eu/gemet/concept/755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "The washing ashore of whales or other cetaceans that have died for natural causes, or because of highly polluted sea water or after being trapped in drift nets."@en ;
    skos:prefLabel "beaching"@en .

<http://www.eionet.europa.eu/gemet/concept/7551> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10930> ;
    skos:definition "Goods or products that have been used previously."@en ;
    skos:prefLabel "second-hand goods"@en .

<http://www.eionet.europa.eu/gemet/concept/7557> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures, techniques or designs implemented to protect from harm or restrict access to any apparatus, machinery or construction put in place or connected for use."@en ;
    skos:prefLabel "security of installations"@en .

<http://www.eionet.europa.eu/gemet/concept/7560> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2400> ;
    skos:definition "A geomorphic feature of the earth in which the surface has subsided for a prolonged time, including deep ocean floors, intercontinental rifts and elevated and interior drainage basins."@en ;
    skos:prefLabel "sedimentary basin"@en .

<http://www.eionet.europa.eu/gemet/concept/7562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "The separation of an insoluble solid from a liquid in which it is suspended by settling under the influence of gravity or centrifugation."@en ;
    skos:prefLabel "sedimentation (industrial process)"@en .

<http://www.eionet.europa.eu/gemet/concept/7563> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3648> ;
    skos:definition "The act or process of forming or accumulating sediment in layers, including such processes as the separation of rock particles from the material from which the sediment is derived, the transportation of these particles to the site of deposition, the actual deposition or settling of the particles, the chemical and other changes occurring in the sediment, and the ultimate consolidation of the sediment into solid rock."@en ;
    skos:prefLabel "sedimentation (geology)"@en .

<http://www.eionet.europa.eu/gemet/concept/7566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4115> ;
    skos:definition "The movement and carrying- away of sediment by natural agents; especially the conveyance of a stream load by suspension, saltation, solution or traction."@en ;
    skos:prefLabel "sediment transport"@en .

<http://www.eionet.europa.eu/gemet/concept/7567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2654> ;
    skos:definition "A mature fertilized plant ovule, consisting of an embryo and its food store surrounded by a protective seed coat (testa)."@en ;
    skos:prefLabel "seed (biology)"@en .

<http://www.eionet.europa.eu/gemet/concept/7568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/237> ;
    skos:definition "A chemical applied before planting to protect seeds and seedlings from disease or insects."@en ;
    skos:prefLabel "seed dressing"@en .

<http://www.eionet.europa.eu/gemet/concept/7571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7340> ;
    skos:definition "The slow movement of water through small openings and spaces in the surface of unsaturated soil into or out of a body of surface or subsurface water."@en ;
    skos:prefLabel "water seepage"@en .

<http://www.eionet.europa.eu/gemet/concept/7574> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water that moves slowly through small openings of a porous material such as soil or the amount of water that has been involved in seepage."@en ;
    skos:prefLabel "seepage water"@en .

<http://www.eionet.europa.eu/gemet/concept/7578> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The gathering of seismic data from an area."@en ;
    skos:prefLabel "seismic monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/7579> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9262> ;
    skos:definition "A large seismically generated sea wave which is capable of considerable destruction in certain coastal areas, especially where submarine earthquakes occur. Although in the open ocean the wave height may be less than one meter it steepens to hights of 15 metres or more on entering shallow coastal water. The wavelength in the open ocean is of the order of 100 to 150 km and the rate of travel of a seismic sea wave is between 640 and 960 km/h."@en ;
    skos:prefLabel "seismic sea wave"@en .

<http://www.eionet.europa.eu/gemet/concept/7582> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7581> ;
    skos:definition "The official or legally authorized act of taking away monetary gain or surplus resulting from investments or property or from returns, proceeds or revenue in a business or business transaction."@en ;
    skos:prefLabel "seizure of profits"@en .

<http://www.eionet.europa.eu/gemet/concept/7584> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:prefLabel "selection of technology"@en .

<http://www.eionet.europa.eu/gemet/concept/7586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11198> ;
    skos:definition "Breeding of animals having desirable characters."@en ;
    skos:prefLabel "selective breeding of animals"@en .

<http://www.eionet.europa.eu/gemet/concept/7588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6298> ;
    skos:definition "Breeding of plants having desirable characters."@en ;
    skos:prefLabel "selective breeding of plants"@en .

<http://www.eionet.europa.eu/gemet/concept/7590> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2641> ;
    skos:definition "A highly toxic, nonmetallic element; used in analytical chemistry, metallurgy, and photoelectric cells."@en ;
    skos:prefLabel "selenium"@en .

<http://www.eionet.europa.eu/gemet/concept/7592> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6705> ;
    skos:definition "A series of steps or a system of services or activities designed to enable an individual to help or improve one's self without depending on the aid of others."@en ;
    skos:prefLabel "self-help programme"@en .

<http://www.eionet.europa.eu/gemet/concept/7593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:prefLabel "self-monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/7594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6838> ;
    skos:definition "A natural process of organic degradation that produces nutrients utilized by autotrophic organisms."@en ;
    skos:prefLabel "self-purification"@en .

<http://www.eionet.europa.eu/gemet/concept/7595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in regions that have between 10 to 20 inches of rainfall and are capable of sustaining some grasses and shrubs but not woodland."@en ;
    skos:prefLabel "semi-arid land ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/7597> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2623> ;
    skos:definition "A solid crystalline material whose electrical conductivity is intermediate between that of a metal and an insulator and is usually strongly temperature-dependent."@en ;
    skos:prefLabel "semiconductor"@en .

<http://www.eionet.europa.eu/gemet/concept/7599> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Product that has undergone a partial processing and is used as raw material in a successive productive step."@en ;
    skos:prefLabel "semimanufactured product"@en .

<http://www.eionet.europa.eu/gemet/concept/760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7983> ;
    skos:definition "The care, preservation and husbandry of hymenopterous insects valued for their ability to pollinate crops and other flora or for their production of honey."@en ;
    skos:prefLabel "bee conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/7600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5184> ;
    skos:definition "An element having some properties characteristic of metals and others of non-metals. Many metalloids give rise to an amphoteric oxide (e.g. arsenic or antimony) and many are semiconductors."@en ;
    skos:prefLabel "semi-metal"@en .

<http://www.eionet.europa.eu/gemet/concept/7604> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397>,
        <http://www.eionet.europa.eu/gemet/concept/8280> ;
    skos:definition "A formalized procedure to identify the impact of changes in various model components on model output. Sensitivity analysis is an integral part of simulation experimentation and may influence model formulations. It is commonly used to examine model behaviour. The general procedure is to define a model output variable that represents an important aspect of model behaviour. The values of various inputs of the model are then varied and the resultant change in the output variable is monitored. Large changes in the output variable imply that the particular input varied is important in controlling model behaviour. Within this general definition, sensitivity analysis has been applied to a variety of model inputs including state variables, environmental variables and initial conditions."@en ;
    skos:prefLabel "sensitivity analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1225> ;
    skos:definition "Cattle bred for the production of meat."@en ;
    skos:prefLabel "beef cattle"@en .

<http://www.eionet.europa.eu/gemet/concept/7611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7609> ;
    skos:definition "Segregating various wastes at the point of generation (e.g. separation of paper, metal and glass from other wastes) to make recycling simpler and more efficient."@en ;
    skos:prefLabel "separation at source"@en .

<http://www.eionet.europa.eu/gemet/concept/7613> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "A tank, usually underground, into which sewage flows, the deposited matter being wholly, or partially broken down through anaerobic action. The final effluent may be allowed to soak into the ground through a system of agricultural drains, if the soil is suitable. Alternatively, the tank must be emptied at regular intervals by a special road-tanker."@en ;
    skos:prefLabel "septic tank"@en .

<http://www.eionet.europa.eu/gemet/concept/7618> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "The area served by a particular public facility such as school, library, police station, park, etc."@en ;
    skos:prefLabel "service area"@en .

<http://www.eionet.europa.eu/gemet/concept/762> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4127> ;
    skos:definition "Any of the membranous-winged insects which compose the superfamily Apoidea in the order Hymenoptera characterized by a hairy body and by sucking and chewing mouthparts."@en ;
    skos:prefLabel "bee"@en .

<http://www.eionet.europa.eu/gemet/concept/7625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "The physical pattern of low-density expansion of large urban areas under market conditions into the surrounding agricultural areas. Sprawl lies in advance of the principal lines of urban growth and implies little planning control of land subdivision. Development is patchy, scattered and strung out, with a tendency to discontinuity because it leap-frogs over some areas, leaving agricultural enclaves."@en ;
    skos:prefLabel "urban sprawl"@en .

<http://www.eionet.europa.eu/gemet/concept/7628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Any liquid-born waste that contains animal or plant matter in suspension or solution, soils and storm water, or chemicals in solution."@en ;
    skos:prefLabel "sewage"@en .

<http://www.eionet.europa.eu/gemet/concept/7629> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9130> ;
    skos:prefLabel "sewage disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/7630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9144> ;
    skos:definition "Area of land on which sewage or any other type of waste water is distributed in order to purify it; it is a kind of waste water treatment."@en ;
    skos:prefLabel "sewage farm"@en .

<http://www.eionet.europa.eu/gemet/concept/7636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "Sewage treatment comes in two stages - primary and secondary treatment. The primary stage involves a process of screening solids from sewage, leaving a sludge and relatively clear water for further treatment or for disposal into rivers, the sea or on to the land. In the secondary stage the sludge is stirred constantly in vast tanks to get more oxygen into the mixture, allowing bacteria to break down the organic matter and leave a harmless residue that falls as a sediment to the bottom of the tank. After processing, the clear water on top of the tank is discharged into rivers and the sediment is used as landfill or discharged at sea."@en ;
    skos:prefLabel "sewage treatment system"@en .

<http://www.eionet.europa.eu/gemet/concept/764> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "Any insect of the order Coleoptera, having biting mouthparts and forewings modified to form shell-like protective elytra."@en ;
    skos:prefLabel "beetle"@en .

<http://www.eionet.europa.eu/gemet/concept/7646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/503> ;
    skos:prefLabel "shellfish"@en .

<http://www.eionet.europa.eu/gemet/concept/7651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "Barriers devised for keeping away from people harmful substances."@en ;
    skos:prefLabel "shielding device"@en .

<http://www.eionet.europa.eu/gemet/concept/7652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Agricultural practice using the rotation of fields rather than crops, short cropping periods followed by long fallows and the maintenance of fertility by the regeneration of vegetation."@en ;
    skos:prefLabel "shifting cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/7655> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8934> ;
    skos:definition "The art or business of designing and constructing ships."@en ;
    skos:prefLabel "shipbuilding"@en .

<http://www.eionet.europa.eu/gemet/concept/7659> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8583> ;
    skos:definition "An unexpected incident, failure or loss involving a vessel or its contents in the course of commercial transport that poses potential harm to persons, property or the environment."@en ;
    skos:prefLabel "shipping accident"@en .

<http://www.eionet.europa.eu/gemet/concept/7662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Domestic and operational wastes, disposed of continuously or periodically, that are generated during the normal operation of a ship; usually excluding fresh fish waste from fishing operations."@en ;
    skos:prefLabel "ship garbage"@en .

<http://www.eionet.europa.eu/gemet/concept/7663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "Discharging of ship waste into the sea."@en ;
    skos:prefLabel "ship waste disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/7668> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10847> ;
    skos:definition "Area designed for target shooting."@en ;
    skos:prefLabel "shooting range"@en .

<http://www.eionet.europa.eu/gemet/concept/7670> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7669> ;
    skos:definition "Enclosed area in which there is a variety of shops."@en ;
    skos:prefLabel "shopping centre"@en .

<http://www.eionet.europa.eu/gemet/concept/768> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Any pollinating insect, or any pest predator, parasite, pathogen or other biological control agent which functions naturally or as part of an integrated pest management program to control another pest."@en ;
    skos:prefLabel "beneficial organism"@en .

<http://www.eionet.europa.eu/gemet/concept/7680> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A size-reduction machine which tears or grinds materials to a smaller and more uniform particle size. Shredding process is also called size reduction, grinding, milling, comminution, pulverisation, hogging, granulating, breaking, chipping, crushing, cutting, rasping."@en ;
    skos:prefLabel "shredder"@en .

<http://www.eionet.europa.eu/gemet/concept/7681> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "A machine used to break up refuse material into smaller pieces by tearing and/or impact."@en ;
    skos:prefLabel "refuse shredder"@en .

<http://www.eionet.europa.eu/gemet/concept/7683> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1020> ;
    skos:definition "A woody perennial plant, smaller than a tree, with several major branches arising from near the base of the main stem."@en ;
    skos:prefLabel "shrub"@en .

<http://www.eionet.europa.eu/gemet/concept/7684> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "Area where a car or a train can be shoven or turned off or moved from one track to another."@en ;
    skos:prefLabel "shunting yard"@en .

<http://www.eionet.europa.eu/gemet/concept/7686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A set of symptoms, including headaches, fatigue, eye irritation, and dizziness, typically affecting workers in modern airtight office buildings and thought to be caused by indoor pollutants, such as formaldehyde fumes, particulate matter, microorganisms, etc."@en ;
    skos:prefLabel "sick building syndrome"@en .

<http://www.eionet.europa.eu/gemet/concept/7688> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Any secondary effect, especially an undesirable one."@en ;
    skos:prefLabel "side effect"@en .

<http://www.eionet.europa.eu/gemet/concept/7689> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2564> ;
    skos:prefLabel "side effects of pharmaceutical drugs"@en .

<http://www.eionet.europa.eu/gemet/concept/7690> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The size distribution of solid particles on a series of standard sieves of decreasing size, expressed as a weight percent."@en ;
    skos:prefLabel "sieving"@en .

<http://www.eionet.europa.eu/gemet/concept/7692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6447> ;
    skos:definition "Any device designed to reduce noise, especially the device in the exhaust system of a motor vehicle."@en ;
    skos:prefLabel "silencer"@en .

<http://www.eionet.europa.eu/gemet/concept/7694> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2639> ;
    skos:definition "A brittle metalloid element that exists in two allotropic forms; occurs principally in sand, quartz, granite, feldspar, and clay. It is usually a grey crystalline solid but is also found as a brown amorphous powder. It is used in transistors, rectifiers, solar cells, and alloys. Its compounds are widely used in glass manufacture, the building industry, and in the form of silicones."@en ;
    skos:prefLabel "silicon"@en .

<http://www.eionet.europa.eu/gemet/concept/7697> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/186> ;
    skos:definition "A large round tower on a farm for storing grain or winter food for cattle."@en ;
    skos:prefLabel "silo"@en .

<http://www.eionet.europa.eu/gemet/concept/7698> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition "The fine mineral material formed from the erosion of rock fragments and deposited by rivers and lakes. Its particles are the intermediate form between sand and clay. The particles can range in size from 0.01-0.05 mm in diameter."@en ;
    skos:prefLabel "silt"@en .

<http://www.eionet.europa.eu/gemet/concept/7699> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A very ductile malleable brilliant greyish-white element having the highest electrical and thermal conductivity of any metal. It occurs free and in argentite and other ores: used in jewellery, tableware, coinage, electrical contacts, and in electroplating. Its compounds are used in photography."@en ;
    skos:prefLabel "silver"@en .

<http://www.eionet.europa.eu/gemet/concept/7707> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Forming a coherent bonded mass by heating metal powders without melting, used mostly in powder metallurgy."@en ;
    skos:prefLabel "sintering"@en .

<http://www.eionet.europa.eu/gemet/concept/7712> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "To fix the cross-section of structural components on the basis of statics and material strength."@en ;
    skos:prefLabel "sizing"@en .

<http://www.eionet.europa.eu/gemet/concept/7715> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "Gliding over snow on skis, especially as a sport."@en ;
    skos:prefLabel "skiing"@en .

<http://www.eionet.europa.eu/gemet/concept/7716> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5890> ;
    skos:definition "The tissue forming the outer covering of the vertebrate body: it consists of two layers, the outermost of which may be covered with hair, scales, feathers, etc. It is mainly protective and sensory in function."@en ;
    skos:prefLabel "skin"@en .

<http://www.eionet.europa.eu/gemet/concept/7718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4650> ;
    skos:prefLabel "skyline destruction"@en .

<http://www.eionet.europa.eu/gemet/concept/772> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8158> ;
    skos:definition "The bottom of a body of water often occupied by benthos."@en ;
    skos:prefLabel "benthic division"@en .

<http://www.eionet.europa.eu/gemet/concept/7720> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "A nonmetallic product resulting from the interaction of flux and impurities in the smelting and refining of metals."@en ;
    skos:prefLabel "slag"@en .

<http://www.eionet.europa.eu/gemet/concept/7724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "A place where animals are butchered for food."@en ;
    skos:prefLabel "slaughterhouse"@en .

<http://www.eionet.europa.eu/gemet/concept/7725> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/453> ;
    skos:definition "Animal body parts cut off in the preparation of carcasses for use as food. This waste can come from several sources including slaughterhouses, restaurants, stores and farms."@en ;
    skos:prefLabel "slaughterhouse waste"@en .

<http://www.eionet.europa.eu/gemet/concept/7726> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/233> ;
    skos:definition "Killing of animals for food."@en ;
    skos:prefLabel "slaughtering of animals"@en .

<http://www.eionet.europa.eu/gemet/concept/7729> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "A periodic state of physiological rest during which consciousness is suspended and metabolic rate is decreased."@en ;
    skos:prefLabel "sleep"@en .

<http://www.eionet.europa.eu/gemet/concept/773> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5031> ;
    skos:definition "The interacting system of the biological communities located at the bottom of bodies of freshwater and saltwater and their non-living environmental surroundings."@en ;
    skos:prefLabel "benthic ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/7730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "sleep disturbance"@en .

<http://www.eionet.europa.eu/gemet/concept/7731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1064> ;
    skos:definition "Sloping surface of an excavation."@en ;
    skos:prefLabel "excavation side"@en .

<http://www.eionet.europa.eu/gemet/concept/7733> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7565> ;
    skos:definition """1) A soft, soupy, or muddy bottom deposit, such as found on tideland or in a stream bed. 
2) A semifluid, slushy, murky mass of sediment resulting from treatment of water, sewage, or industrial and mining wastes, and often appearing as local bottom deposits in polluted bodies of water."""@en ;
    skos:prefLabel "sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/7737> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7740> ;
    skos:definition "A treatment to stabilize raw sludge. The treatment can be either anaerobic process or aerobic process."@en ;
    skos:prefLabel "sludge digestion"@en .

<http://www.eionet.europa.eu/gemet/concept/7738> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4183> ;
    skos:definition "A method used for drying and reducing sludge volume and weight. Since incineration requires auxiliary fuel to obtain and maintain high temperature and to evaporate the water contained in the incoming sludge, concentration techniques should be applied before incineration. Sludge incineration is a two-step process involving drying and combustion after a preceding dewatering process, such as filters, drying beds, or centrifuges."@en ;
    skos:prefLabel "sludge incineration"@en .

<http://www.eionet.europa.eu/gemet/concept/7739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "Pond for the removal of settleable solids through which wastewater is passed in a treatment works."@en ;
    skos:prefLabel "sludge settling pond"@en .

<http://www.eionet.europa.eu/gemet/concept/7747> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13179> ;
    skos:prefLabel "small and medium sized industry"@en .

<http://www.eionet.europa.eu/gemet/concept/775> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/511> ;
    skos:definition "Those organisms attached to, living on, in or near the sea bed, river bed or lake floor."@en ;
    skos:prefLabel "benthos"@en .

<http://www.eionet.europa.eu/gemet/concept/7752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:prefLabel "Small Islands (political geography)"@en .

<http://www.eionet.europa.eu/gemet/concept/7755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3538> ;
    skos:definition "Small enclosed structures containing a heat source, typically used for the purpose of intense heating. Most are lined with refractory material, the heat source is typically provided by electrical elements or the burning of gas, coke or coal."@en ;
    skos:prefLabel "small-scale furnace"@en .

<http://www.eionet.europa.eu/gemet/concept/7756> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A domestic source introducing small quantities of pollutants into a publicly owned waste-treatment system."@en ;
    skos:prefLabel "small-scale inducer"@en .

<http://www.eionet.europa.eu/gemet/concept/776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/562> ;
    skos:definition "A colorless, liquid, flammable, aromatic hydrocarbon used to manufacture styrene and phenol. Also known as benzol."@en ;
    skos:prefLabel "benzene"@en .

<http://www.eionet.europa.eu/gemet/concept/7760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9035> ;
    skos:definition "Action, device or announcement that serves to give caution or notice to the level of air pollutants typically associated with oxidants in a given area."@en ;
    skos:prefLabel "smog warning"@en .

<http://www.eionet.europa.eu/gemet/concept/7763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3877> ;
    skos:prefLabel "smoke prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/7765> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "The inhalation and exhalation of carcinogenic fumes from burning plant material, usually tobacco."@en ;
    skos:prefLabel "smoking"@en .

<http://www.eionet.europa.eu/gemet/concept/7768> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7617> ;
    skos:definition "Any snakes of the family of Colubridae, including many harmless snakes, such as the grass snake and whip belonging to the Colubridae."@en ;
    skos:prefLabel "colubrid"@en .

<http://www.eionet.europa.eu/gemet/concept/7769> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/637> ;
    skos:definition "The most common form of frozen precipitation, usually flakes or starlike crystals, matted ice needles, or combinations, and often rime-coated."@en ;
    skos:prefLabel "snow"@en .

<http://www.eionet.europa.eu/gemet/concept/777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6492> ;
    skos:definition "A five-ring aromatic hydrocarbon found in coal tar, in cigarette smoke, and as a product of incomplete combustion."@en ;
    skos:prefLabel "benzopyrene"@en .

<http://www.eionet.europa.eu/gemet/concept/7771> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/678> ;
    skos:definition "An avalanche of relatively pure snow; some rock and earth material may also be carried downward."@en ;
    skos:prefLabel "snowslide"@en .

<http://www.eionet.europa.eu/gemet/concept/7774> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Absorption of liquid by a solid or a semisolid material."@en ;
    skos:prefLabel "soaking"@en .

<http://www.eionet.europa.eu/gemet/concept/7776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1458> ;
    skos:definition "A cleansing agent, manufactured in bars, granules, flakes, or liquid form, made from a mixture of the sodium salts of various fatty acids of natural oils and fats."@en ;
    skos:prefLabel "soap"@en .

<http://www.eionet.europa.eu/gemet/concept/7787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The price paid or the loss incurred to acquire, produce or maintain an objective or goal in a group, community or society."@en ;
    skos:prefLabel "social cost"@en .

<http://www.eionet.europa.eu/gemet/concept/7788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "The process of getting those who produce goods or services with adverse effects on the environment or on society to incorporate a knowledge of possible negative repercussions into future economic decisions."@en ;
    skos:prefLabel "internalisation of external costs"@en .

<http://www.eionet.europa.eu/gemet/concept/7803> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:definition "Medicine as applied to treatment of diseases which occur in certain social groups."@en ;
    skos:prefLabel "social medicine"@en .

<http://www.eionet.europa.eu/gemet/concept/7807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6051> ;
    skos:definition "Collective, civic action shared and performed by a significant number of the community or general population."@en ;
    skos:prefLabel "social participation"@en .

<http://www.eionet.europa.eu/gemet/concept/7809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which seeks to ensure that all people have acceptable working or living conditions by providing social security, welfare, health care, insurance, fair employment practices, low cost housing or educational opportunities."@en ;
    skos:prefLabel "social policy"@en .

<http://www.eionet.europa.eu/gemet/concept/781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:definition "A corrosion-resistant, toxic silvery-white metallic element that occurs chiefly in beryl and is used mainly in x-ray windows and in the manufacture of alloys."@en ;
    skos:prefLabel "beryllium"@en .

<http://www.eionet.europa.eu/gemet/concept/7813> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "Public assistance especially financial given to persons in special need or difficulty."@en ;
    skos:prefLabel "social relief"@en .

<http://www.eionet.europa.eu/gemet/concept/7818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8240> ;
    skos:definition "Data collections that employ both interviewing and sampling to produce quantitative data-sets, amenable to computer-based analysis."@en ;
    skos:prefLabel "social survey"@en .

<http://www.eionet.europa.eu/gemet/concept/7819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "The concept of system appears throughout the social and natural sciences and has generated a body of literature of its own (general systems theory). A system is any pattern of relationships between elements, and is regarded as having emergent properties on its own over and above the properties of its elements."@en ;
    skos:prefLabel "social system"@en .

<http://www.eionet.europa.eu/gemet/concept/782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:definition "Name given to the ionizing radiation which is produced as a stream of high speed electrons emitted by certain types of radioactive substance when they decay. The intensity of radiation energy produced in human tissue by a beta particle is a hundred times less than that produced by an alpha radiation particle, but it travels slightly deeper into tissue."@en ;
    skos:prefLabel "beta radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/7821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7798> ;
    skos:definition "Regarding social values, distinctions are often drawn between values, which are strong, semi permanent, underlying, and sometimes inexplicit dispositions, and attitudes, which are shallow, weakly held, and highly variable views and opinions. Societies can usually tolerate highly diverse attitude, whereas they require some degree of homogeneity and consistency in the values held by people, providing a common fund of shared values which shape social and political consensus."@en ;
    skos:prefLabel "social value"@en .

<http://www.eionet.europa.eu/gemet/concept/7826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7798> ;
    skos:definition "An essential element in a society's make-up, organization or behavior that combines financial dimensions with inter-personal or inter-group dynamics."@en ;
    skos:prefLabel "socioeconomic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/7827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Biotechnology is the application of biological and technical solutions to problems, and often refers to the industrial use of microorganisms (perhaps genetically altered) to perform chemical processing, for example of waste or water, or to manufacture hormones or enzymes for medicinal and commercial purposes. Biotechnology offers great potential to increase farm production and food processing efficiency, to lower food costs, to enhance food quality and safety and to increase international competitiveness."@en ;
    skos:prefLabel "socioeconomic impact of biotechnologies"@en .

<http://www.eionet.europa.eu/gemet/concept/7830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8240> ;
    skos:definition "Research on social questions or problems, especially focusing on cultural and environmental factors."@en ;
    skos:prefLabel "sociological survey"@en .

<http://www.eionet.europa.eu/gemet/concept/7831> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10057> ;
    skos:definition "The study of the development, organization, functioning and classification of human societies."@en ;
    skos:prefLabel "sociology"@en .

<http://www.eionet.europa.eu/gemet/concept/7839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320> ;
    skos:definition "Reduction of the hardness of water by removing hardness-forming ions (chiefly calcium and magnesium) by precipitation or ion exchange, or sequestering them as by combining them with substances such as certain phosphates, that form soluble but non-ionized salts."@en ;
    skos:prefLabel "softening"@en .

<http://www.eionet.europa.eu/gemet/concept/784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Any one of various liquids for drinking, usually excluding water."@en ;
    skos:prefLabel "beverage"@en .

<http://www.eionet.europa.eu/gemet/concept/7840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition """1) A substance added to another substance to increase its softness, pliability, or plasticity. 
2) A substance, such as a zeolite, for softening water."""@en ;
    skos:prefLabel "softening agent"@en .

<http://www.eionet.europa.eu/gemet/concept/7842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "Software is the general term used to describe all of the various programs that may be used on a computer system. Software can be divided into four main categories: systems software, development software, user interface software, applications software."@en ;
    skos:prefLabel "software"@en .

<http://www.eionet.europa.eu/gemet/concept/7844> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7857> ;
    skos:definition "A naturally occurring process in humid climates that has long been the subject of research, whose findings suggest acid precipitation effects. The generally accepted impact of soil acidification on the productivity of terrestrial plants is summarised as follows: as soil becomes more acidic the basic cations (Ca, Mg) on the soil exchange are replaced by hydrogen ions or solubilized metals. The basic cation, now in solution, can be leached through the soil. As time progresses the soil becomes less fertile and more acidic. Resultant decreases in soil pH cause reduced, less-active population of soil microorganisms, which in turn slow decomposition of plant residues and cycling of essential plant nutrients."@en ;
    skos:prefLabel "soil acidification"@en .

<http://www.eionet.europa.eu/gemet/concept/7845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "The air and other gases in spaces in the soil; specifically that which is found within the zone of aeration. Also known as soil atmosphere."@en ;
    skos:prefLabel "soil air"@en .

<http://www.eionet.europa.eu/gemet/concept/7846> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The use of rapid chemical analyses to determine the fertility status of a soil. It is used to identify those nutrients or substances that are present in either insufficient or excessive quantities for optimum plant growth. Analyses are also used to monitor increases or decreases in soil fertility over time."@en ;
    skos:prefLabel "soil analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/7847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:definition "The study of the living organisms, mainly microorganisms and microinvertebrates which live within the soil, and which are largely responsible for the decomposition processes vital to soil fertility."@en ;
    skos:prefLabel "soil biology"@en .

<http://www.eionet.europa.eu/gemet/concept/7849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:definition "The study of the inorganic and organic components of the soil and its life cycles."@en ;
    skos:prefLabel "soil chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/7850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "An increase in bulk density (mass per unit volume) and a decrease in soil porosity resulting from applied loads, vibration, or pressure. More compacted soils (or other materials) can support greater loads (load-bearing capacity). Bulk density can be increased by controlling the moisture content, compaction forces and treatment procedures, as well as by manipulating the type of material being compacted."@en ;
    skos:prefLabel "soil compaction"@en .

<http://www.eionet.europa.eu/gemet/concept/7852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Management of soil to prevent or reduce soil erosion and depletion by wind and water. Preservation of soil against deterioration and loss by using it within its capabilities; application of conservation practices needed for its protection and improvement."@en ;
    skos:prefLabel "soil conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/7853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:definition "A binding rule or body of rules prescribed by a government to protect and prevent the loss of an area's surface layer of decomposed rock and organic material, valued for its nutrients and ability to support life."@en ;
    skos:prefLabel "soil conservation legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/7855> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Soil impaired as a consequence of human activity. A study financed by UNEP, reporting in 1992, found that about 10,5% of the world's vegetative surface had been seriously damaged by human activity since 1945. The study found that much of the damage had been masked by a general rise in global agricultural productivity resulting from expanded irrigation, better plant varieties, and greater use of production inputs, such as fertilizers and pesticides. More than 1/3 of the damaged land was in Asia, almost 1/3 in Africa, and 1/4 in Central America. Some land had been damaged beyond restoration. The greatest sources of soil degradation were overgrazing, unsuitable agricultural practices, and deforestation."@en ;
    skos:prefLabel "soil damage"@en .

<http://www.eionet.europa.eu/gemet/concept/7856> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2015> ;
    skos:definition "Technologies employed in the removal of PCBs, PAH, pesticides and, more generally, of organic compounds by physical, chemical or biological treatments."@en ;
    skos:prefLabel "soil decontamination"@en .

<http://www.eionet.europa.eu/gemet/concept/7858> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "Detachment and movement of topsoil or soil material from the upper part of the profile, by the action of wind or running water, especially as a result of changes brought about by human activity, such as unsuitable or mismanaged agriculture."@en ;
    skos:prefLabel "soil erosion"@en .

<http://www.eionet.europa.eu/gemet/concept/786> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A complete or selective listing of documents by a given subject, author or publisher, often including the description and identification of the editions, dates of issue, titles, authorship, publishers or other written materials."@en ;
    skos:prefLabel "bibliography"@en .

<http://www.eionet.europa.eu/gemet/concept/7860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7848> ;
    skos:definition "The status of a soil with respect to the amount and availability to plants of elements necessary for plant growth."@en ;
    skos:prefLabel "soil fertility"@en .

<http://www.eionet.europa.eu/gemet/concept/7862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "The combination of natural processes by which soils are formed. It is also known as pedogenesis. The most important soil-forming factors are parent material, terrain, climate, aspect, vegetation cover, microorganisms in the soil and the age of the land surface. Some pedologists would add to this list the influence of human activities. All the factors exhibit varying degrees of interrelationship and some are more important than others, with climate often being singled out as the most important."@en ;
    skos:prefLabel "soil formation"@en .

<http://www.eionet.europa.eu/gemet/concept/7863> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9373> ;
    skos:definition "Process of protecting the soil from excessive erosion and making soil more fertile and productive."@en ;
    skos:prefLabel "soil improvement"@en .

<http://www.eionet.europa.eu/gemet/concept/7867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "In soil mechanics and civil engineering the term is used to denote the increased weight brought to bear on the ground surface."@en ;
    skos:prefLabel "soil loading"@en .

<http://www.eionet.europa.eu/gemet/concept/7868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5011> ;
    skos:definition "A two-dimensional representation that shows the areal extent or the distribution of soils in relation to other features of the land surface."@en ;
    skos:prefLabel "soil map"@en .

<http://www.eionet.europa.eu/gemet/concept/7871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "The study of the physical properties of soil, especially those properties that affect its ability to bear weight such as water content, density, strength, etc."@en ;
    skos:prefLabel "soil mechanics"@en .

<http://www.eionet.europa.eu/gemet/concept/7873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7890> ;
    skos:definition "Study of the formation, occurrence, properties, composition, and classification of the minerals present in the soil."@en ;
    skos:prefLabel "soil mineralogy"@en .

<http://www.eionet.europa.eu/gemet/concept/7875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7874> ;
    skos:definition "The water regime of the soil is determined by the physical properties and arrangement of the soil particles. The pores in a soil determine its water-retention characteristics. When all the pores are full of water, the soil is said to be saturated."@en ;
    skos:prefLabel "soil moisture regime"@en .

<http://www.eionet.europa.eu/gemet/concept/7878> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Solid, liquid and gaseous substances that detrimentally alter the natural condition of the soil."@en ;
    skos:prefLabel "soil pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "A vehicle with two wheels in tandem, pedals connected to the rear wheel by a chain, handlebars for steering, and a saddlelike seat."@en ;
    skos:prefLabel "bicycle"@en .

<http://www.eionet.europa.eu/gemet/concept/7880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4636> ;
    skos:definition "Modifications of soil features or, more generally, of its chemical and biological balance, caused by the discharge of polluting substances."@en ;
    skos:prefLabel "soil pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/7884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2912> ;
    skos:definition "All current positive or negative properties with regard to soil utilization and soil functions."@en ;
    skos:prefLabel "soil quality"@en .

<http://www.eionet.europa.eu/gemet/concept/7886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:prefLabel "soil resource"@en .

<http://www.eionet.europa.eu/gemet/concept/7889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7376> ;
    skos:definition "The accumulation of soluble mineral salts near the surface of soil, usually caused by the capillary flow of water from saline ground water. Where the rate of surface evaporation is high, irrigation can exacerbate the problem by moistening the soil and causing water to be drawn from deeper levels as water evaporates from the surface. The evaporation of pure water leaves the salts behind, allowing them to accumulate, and they can reach concentrations that are toxic to plants, thus sterilizing the land."@en ;
    skos:prefLabel "soil salination"@en .

<http://www.eionet.europa.eu/gemet/concept/7892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "Compaction involves the close-packing of the individual grains mainly by the elimination of pore-space and expulsion of entrapped water; this is normally brought about by the weight of the overlying sediments."@en ;
    skos:prefLabel "soil settling"@en .

<http://www.eionet.europa.eu/gemet/concept/7894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Chemical or mechanical treatment designed to increase or maintain the stability of a soil mass or otherwise to improve its engineering properties, as by increasing its shear strength, reducing its compressibility, or decreasing its tendency to absorb water. Stabilization methods include physical compaction and treatment with cement, lime, and bitumen."@en ;
    skos:prefLabel "soil stabilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/7895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "The combination or aggregation of primary soil particles into aggregates or clusters, which are separated from adjoining peds by surfaces of weakness. Soil structure is classified on the basis of size, shape, and distinctness into classes, types, and grades."@en ;
    skos:prefLabel "soil structure"@en .

<http://www.eionet.europa.eu/gemet/concept/7896> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7881> ;
    skos:definition "A sinking down of a part of the earth's crust, generally due to underground excavations."@en ;
    skos:prefLabel "soil subsidence"@en .

<http://www.eionet.europa.eu/gemet/concept/7897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Any activity or process in which ground surface areas are packed or plugged to prevent percolation or the passage of fluids."@en ;
    skos:prefLabel "soil surface sealing"@en .

<http://www.eionet.europa.eu/gemet/concept/7898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition """1) Refers to the relative proportions of the various size groups (sand, silt and clay) of the individual soil grains in a mass of soil. 
2) Classification of soil by the proportion and graduations of the three size groups of soil grains, i.e., sand, silt and clay, present in the soil."""@en ;
    skos:prefLabel "soil texture"@en .

<http://www.eionet.europa.eu/gemet/concept/79> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4707> ;
    skos:definition """1) Something done voluntarily by a person, and of such a nature that certain legal consequences attach to it.
2) Documents, decrees, edicts, laws, judgments, etc."""@en ;
    skos:prefLabel "act"@en .

<http://www.eionet.europa.eu/gemet/concept/7900> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "Functional utilization of soil for agriculture, industry, or residential building purposes."@en ;
    skos:prefLabel "soil use"@en .

<http://www.eionet.europa.eu/gemet/concept/7904> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7905> ;
    skos:definition "A device for converting sunlight into electrical power using a semiconductor sensitive to the photovoltaic effect. Solar cells are used on space satellites to power electronic equipment, and as their price falls they may come to be used to provide energy on the Earth."@en ;
    skos:prefLabel "solar cell"@en .

<http://www.eionet.europa.eu/gemet/concept/7906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "The energy transmitted from the sun in the form of electromagnetic radiation. The most successful examples of energy extraction from the sun are so far solar cells used in satellites and solar collectors used to heat water."@en ;
    skos:prefLabel "solar energy"@en .

<http://www.eionet.europa.eu/gemet/concept/7907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2932> ;
    skos:definition "Solar energy can be converted to useful work or heat by using a collector to absorb solar radiation, allowing much of the sun's radiant energy to be converted to heat. This heat can be used directly in residential, industrial, and agricultural operations; converted to mechanical or electrical power; or applied in chemical reactions for production of fuels and chemicals."@en ;
    skos:prefLabel "solar energy technology"@en .

<http://www.eionet.europa.eu/gemet/concept/7908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2741> ;
    skos:definition "A domestic or industrial heating system that makes direct use of solar energy. The simplest form consists of a collector through which a fluid is pumped. The circuit also contains some form of heat storage tank and an alternative energy source to provide energy when the sun is not shining. The collector usually consists of a black surface through which water is piped, the black surface being enclosed behind glass sheets to make use of the greenhouse effect."@en ;
    skos:prefLabel "solar heating"@en .

<http://www.eionet.europa.eu/gemet/concept/7910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Plant where energy is generated using radiation from the sun."@en ;
    skos:prefLabel "solar power station"@en .

<http://www.eionet.europa.eu/gemet/concept/7918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7919> ;
    skos:definition "A crystalline material, that is, one in which the constituent atoms are arranged in a three-dimensional lattice, periodic in three independent directions."@en ;
    skos:prefLabel "solid matter"@en .

<http://www.eionet.europa.eu/gemet/concept/792> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1776> ;
    skos:definition "An international agreement, especially one dealing with a specific matter, involving two or both sides, factions, or the like."@en ;
    skos:prefLabel "bilateral convention"@en .

<http://www.eionet.europa.eu/gemet/concept/7920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded solid materials. Includes agricultural waste, mining waste, industrial waste and municipal waste."@en ;
    skos:prefLabel "solid waste"@en .

<http://www.eionet.europa.eu/gemet/concept/7921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "The orderly discarding, release, collection, treatment or salvaging of unwanted or useless non-liquid, non-soluble refuse."@en ;
    skos:prefLabel "solid waste disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/7923> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322>,
        <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The ability of a substance to form a solution with another substance."@en ;
    skos:prefLabel "solubility"@en .

<http://www.eionet.europa.eu/gemet/concept/7926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Solvent recovery is a widely practised form of recycling where spent solvents are distilled and reused. However, the cheaper solvents are often incinerated or dumped in hazardous waste landfill sites."@en ;
    skos:prefLabel "solvent recovery"@en .

<http://www.eionet.europa.eu/gemet/concept/7927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "Any passerine bird of the suborder Oscines, having highly developed vocal organs and, in most, a music call."@en ;
    skos:prefLabel "songbird"@en .

<http://www.eionet.europa.eu/gemet/concept/7928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11918> ;
    skos:definition "A noise caused by a shock wave that emanates from an aircraft or other object traveling at or above sonic velocity."@en ;
    skos:prefLabel "sonic boom"@en .

<http://www.eionet.europa.eu/gemet/concept/7929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Impure black carbon with oily compounds obtained from the incomplete combustion of resinous materials, oils, wood, or coal."@en ;
    skos:prefLabel "soot"@en .

<http://www.eionet.europa.eu/gemet/concept/7938> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/57> ;
    skos:definition "The sound pressure level (in decibels) at a point in a sound field, averaged over the audible frequency range and over a time interval."@en ;
    skos:prefLabel "sound level"@en .

<http://www.eionet.europa.eu/gemet/concept/7939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:definition "Because of the large variations in sound magnitudes, and because the human hearing sensation seems to vary in a logarithmic way, logarithms are used in measurement of sound. The sound pressure level is given in decibels (dB)."@en ;
    skos:prefLabel "sound measurement"@en .

<http://www.eionet.europa.eu/gemet/concept/794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9098> ;
    skos:definition "Waste oil that accumulates, usually in small quantities, inside the lower spaces of a ship, just inside the shell plating, and usually mixed with larger quantities of water."@en ;
    skos:prefLabel "bilge oil"@en .

<http://www.eionet.europa.eu/gemet/concept/7941> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Reducing or eliminating reverberation in a room by placing sound-absorbing materials on the walls and ceiling."@en ;
    skos:prefLabel "soundproofing"@en .

<http://www.eionet.europa.eu/gemet/concept/7942> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/59> ;
    skos:definition "The travelling of acoustic waves in the atmosphere with a speed independent of their amplitude. The speed only depends on the acoustic medium and is proportional to the square route of the absolute temperature for any given medium."@en ;
    skos:prefLabel "sound propagation"@en .

<http://www.eionet.europa.eu/gemet/concept/7945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/59> ;
    skos:definition "Passage of a sound wave through a medium or series of media."@en ;
    skos:prefLabel "sound transmission"@en .

<http://www.eionet.europa.eu/gemet/concept/7947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/367> ;
    skos:definition "A continent in the southern part of the western hemisphere, astride the equator and the Tropic of Capricorn, bordered by the Caribbean Sea to the north and between the Atlantic and Pacific Oceans, connected to North America by the Isthmus of Panama, and divided into twelve countries:  Argentina, Bolivia, Brazil, Chile, Columbia, Ecuador, Guyana, Paraguay, Peru, Suriname, Uruguay and Venezuela."@en ;
    skos:prefLabel "South America"@en .

<http://www.eionet.europa.eu/gemet/concept/7948> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "An ocean south of the equator between the eastern coast of South America and the western coast of Africa that extends southward to the Antarctic continent, including the Drake Passage, South Sandwich Islands and Falkand Islands."@en ;
    skos:prefLabel "South Atlantic Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/7949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:definition "A geographic region of continental Asia, south of China, west of the South Pacific Ocean, north of the Indian Ocean, and east of the Bay of Bengal and the Indian subcontinent, including the Indochina Peninsula, the Malay Peninsula and the Indonesian and Philippine Archipelagos, and countries such as Brunei, Cambodia, Indonesia, Laos, Malaysia, Myanmar, the Philippines, Singapore, Thailand and Vietnam."@en ;
    skos:prefLabel "Southeast Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/795> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Water that builds up in the bottom of a ship's bilge."@en ;
    skos:prefLabel "bilge water"@en .

<http://www.eionet.europa.eu/gemet/concept/7950> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:definition "A geographic region of the African continent astride the Tropic of Capricorn, including Angola, Botswana, Lesotho, Malawi, Mozambique, Namibia, South Africa, Swaziland, Zambia and Zimbabwe, and also the Kalahari Desert, Zambezi River and Orange River."@en ;
    skos:prefLabel "Southern Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/7951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:definition "A geographic region of the Asian continent bordered in the north by the countries of Central Asia and in the south by the Arabian Sea and the Bay of Bengal, extending  westward into Iran and eastward into China, including Afghanistan, Pakistan, India, Nepal, Bangladesh, Burma, Bhutan and Sri Lanka."@en ;
    skos:prefLabel "Southern Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/7952> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "An ocean south of the equator between Southeast Asia and Australia in the Eastern hemisphere and South America in the Western hemisphere, extending southward to the Antarctic region, including the Tasman and Coral seas and numerous islands, such as Galapagos, Solomon, Easter, Samoa, Fiji and Tonga islands, and also New Zealand and its islands."@en ;
    skos:prefLabel "South Pacific Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/7969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Transportation by means of vehicles designed to operate in free space outside the earth's atmosphere."@en ;
    skos:prefLabel "space transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/7970> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8658> ;
    skos:definition "Travel in the space beyond the earth's atmosphere performed for scientific research purposes."@en ;
    skos:prefLabel "space travel"@en .

<http://www.eionet.europa.eu/gemet/concept/7972> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Nonfunctional debris of human origin left in a multitude of orbits about the earth as the result of the exploration and use of the environment lying outside the earth's atmosphere."@en ;
    skos:prefLabel "space waste"@en .

<http://www.eionet.europa.eu/gemet/concept/7973> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4288> ;
    skos:prefLabel "spasmodic croup"@en .

<http://www.eionet.europa.eu/gemet/concept/7974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:definition "The rate of moves or migrations made by a given population within a given time frame."@en ;
    skos:prefLabel "spatial mobility"@en .

<http://www.eionet.europa.eu/gemet/concept/7975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/662> ;
    skos:definition "An exceptional granting of power or permission or a legislative act authorizing money to be spent on government programs."@en ;
    skos:prefLabel "special authorisation"@en .

<http://www.eionet.europa.eu/gemet/concept/7978> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2655> ;
    skos:definition "One relating to particular persons or things; one made for individual cases or for particular places or districts; one operating upon a selected class, rather than upon the public generally. A law is special when it is different from others of the same general kind or designed for a particular purpose, or limited in range or confined to a prescribed field of action or operation."@en ;
    skos:prefLabel "special law"@en .

<http://www.eionet.europa.eu/gemet/concept/798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/833> ;
    skos:definition """1) The accumulation of pollutants in living organisms by direct adsorption or through food chains. 
2) Accumulation by an organism of materials that are not an essential component or nutrient of that organism. Usually it refers to the accumulation of metals, but it can apply to bioaccumulation of persistent synthetic substances such as organochlorine compounds. Many organisms, such as plants, fungi and bacteria, will accumulate metals when grown in solutions containing them. The process can be employed usefully as a purification process to remove toxic heavy metals from waste water and contaminated land."""@en ;
    skos:prefLabel "bioaccumulation"@en .

<http://www.eionet.europa.eu/gemet/concept/7984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2897> ;
    skos:definition "An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to preserve and protect living organisms designated as being at risk."@en ;
    skos:prefLabel "species conservation programme"@en .

<http://www.eionet.europa.eu/gemet/concept/7985> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "Loss of species due to factors such as climate change or random events such as persistent drought, natural catastrophe, the emergence of a new predator, or genetic mutation."@en ;
    skos:prefLabel "species impoverishment"@en .

<http://www.eionet.europa.eu/gemet/concept/7992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "The branch of physics concerned with the production, measurement, and interpretation of electromagnetic spectra arising from either emission or absorption of radiant energy by various substances."@en ;
    skos:prefLabel "spectroscopy"@en .

<http://www.eionet.europa.eu/gemet/concept/7994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A scalar measure of the rate of movement of a body expressed either as the distance travelled divided by the time taken (average speed) or the rate of change of position with respect to time at a particular point (instantaneous speed). It is measured in metres per second, miles per hour, etc."@en ;
    skos:prefLabel "speed"@en .

<http://www.eionet.europa.eu/gemet/concept/7996> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11472> ;
    skos:definition "The maximum permitted speed at which a vehicle may travel on certain roads."@en ;
    skos:prefLabel "speed limit"@en .

<http://www.eionet.europa.eu/gemet/concept/7999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1296> ;
    skos:definition "Any predatory silk-producing arachnid of the order Araneae, having four pairs of legs and a rounded unsegmented body consisting of abdomen and cephalothorax."@en ;
    skos:prefLabel "spider"@en .

<http://www.eionet.europa.eu/gemet/concept/8> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "A vehicle that has been discarded in the environment, urban or otherwise, often found wrecked, destroyed, damaged or with a major component part stolen or missing."@en ;
    skos:prefLabel "abandoned vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/800> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Pollutants that become concentrated in living organisms through the consumption of food or water."@en ;
    skos:prefLabel "bioaccumulative pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/8000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5837> ;
    skos:definition "The uncontrolled discharge, leakage, dripping or running over of fluids or liquid substances."@en ;
    skos:prefLabel "spillage"@en .

<http://www.eionet.europa.eu/gemet/concept/8004> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Place where rubbish and waste minerals dug out of a mine are deposited."@en ;
    skos:prefLabel "spoil dump"@en .

<http://www.eionet.europa.eu/gemet/concept/8006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "The sponges, a phylum of the animal kingdom characterized by the presence of canal systems and chambers through which water is drawn in and released; tissues and organs are absent."@en ;
    skos:prefLabel "poriferan"@en .

<http://www.eionet.europa.eu/gemet/concept/8019> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "An aerosol can for applying paint, deodorant, etc., as a fine spray."@en ;
    skos:prefLabel "spray can"@en .

<http://www.eionet.europa.eu/gemet/concept/802> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "The extent to which a drug or other substance is taken up by a specific tissue or organ after administration."@en ;
    skos:prefLabel "bio-availability"@en .

<http://www.eionet.europa.eu/gemet/concept/8020> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Asbestos emitted into the atmosphere in a spraying operation."@en ;
    skos:prefLabel "sprayed asbestos"@en .

<http://www.eionet.europa.eu/gemet/concept/8025> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9161> ;
    skos:definition "A place where ground water flows naturally from a rock or the soil onto the land surface or into a body of surface water."@en ;
    skos:prefLabel "spring (hydrology, land)"@en .

<http://www.eionet.europa.eu/gemet/concept/8028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water obtained from an underground formation from which water flows naturally to the surface, or would flow naturally to the surface if it were not collected underground."@en ;
    skos:prefLabel "spring water"@en .

<http://www.eionet.europa.eu/gemet/concept/8029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Supplying water or pesticides to crops with a spray."@en ;
    skos:prefLabel "spurting"@en .

<http://www.eionet.europa.eu/gemet/concept/8031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "An open area in a town, sometimes including the surrounding buildings."@en ;
    skos:prefLabel "square"@en .

<http://www.eionet.europa.eu/gemet/concept/8032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "Settlement on land or property to which there is no legal title."@en ;
    skos:prefLabel "squatter settlement"@en .

<http://www.eionet.europa.eu/gemet/concept/8036> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6841> ;
    skos:definition "Ponds in which wastes are allowed to decompose over long periods of time and aeration is provided only by wind action. Sunlight is allowed to fall on sewage to purify it."@en ;
    skos:prefLabel "stabilisation lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/8039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1033> ;
    skos:definition "The portion of a chimney rising above the roof."@en ;
    skos:prefLabel "stack"@en .

<http://www.eionet.europa.eu/gemet/concept/8051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7367> ;
    skos:definition "A norm or measure applicable in legal cases for any enterprise involved in the construction, remodeling or finishing of enclosed structures for habitation."@en ;
    skos:prefLabel "standard for building industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1159> ;
    skos:definition "A polysaccharide which is a combination of many monosaccharide molecules, made during photosynthesis and stored as starch grains in many plants."@en ;
    skos:prefLabel "starch"@en .

<http://www.eionet.europa.eu/gemet/concept/8067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:definition "Everything made available to the public by means of a written or oral description, by use or in any other way before the date of the patent application, or an application filed in a foreign country the priority of which is validly claimed."@en ;
    skos:prefLabel "state of the art"@en .

<http://www.eionet.europa.eu/gemet/concept/8068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:prefLabel "data on the state of the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/8069> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2917> ;
    skos:definition "A written account on the level of integrity and conditions of the ecosystem and natural resources in a given region, usually presented by an official person or body mandated to protect human health and the environment in that region."@en ;
    skos:prefLabel "report on the state of the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088> ;
    skos:definition "Method based on the utilisation of a biochemical mechanism, e.g. any chemical reaction or series of reactions, usually enzyme catalysed, which produces a given physiological effect in a living organism."@en ;
    skos:prefLabel "biochemical method"@en .

<http://www.eionet.europa.eu/gemet/concept/8070> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:prefLabel "state of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/8074> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The body of techniques used in statistical inference concerning a population."@en ;
    skos:prefLabel "statistical analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/8082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:prefLabel "prescription statutory limitation"@en .

<http://www.eionet.europa.eu/gemet/concept/8083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "An association, supported in whole or part by public funding, that is established to operate programs for the public, often with little interference from government in day-to-day business."@en ;
    skos:prefLabel "statutory public body"@en .

<http://www.eionet.europa.eu/gemet/concept/8084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Unceasing prolonged noise, without interruption."@en ;
    skos:prefLabel "steady noise"@en .

<http://www.eionet.europa.eu/gemet/concept/8086> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "A pressurized system in which water is vaporized to steam by heat transferred from a source of higher temperature, usually the products of combustion from burning fuels. Also known as steam boiler."@en ;
    skos:prefLabel "steam generator"@en .

<http://www.eionet.europa.eu/gemet/concept/8088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/340>,
        <http://www.eionet.europa.eu/gemet/concept/5180> ;
    skos:definition "Any of various alloys based on iron containing carbon (usually 0.1-0.7 per cent) and often small quantities of other elements such as phosphorus, sulphur, manganese, chromium, and nickel. Steels exhibit a variety of properties, such as strength, machinability, malleability, etc., depending on their composition and the way they have been treated."@en ;
    skos:prefLabel "steel"@en .

<http://www.eionet.europa.eu/gemet/concept/8089> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13098> ;
    skos:definition "Industry that deals with the processing of iron."@en ;
    skos:prefLabel "steel industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8095> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "An act or process of destroying all forms of microbial life on and in an object."@en ;
    skos:prefLabel "sterilisation (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/8096> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "A compound composed of a series of four carbon rings joined together to form a structural unit called cyclopentanoperhydrophenanthrene."@en ;
    skos:prefLabel "steroid"@en .

<http://www.eionet.europa.eu/gemet/concept/8098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11044> ;
    skos:definition "Money or financial resources set aside to stimulate, encourage, or incite action towards greater productivity."@en ;
    skos:prefLabel "incentive fund"@en .

<http://www.eionet.europa.eu/gemet/concept/8099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3444> ;
    skos:definition "A group of individuals of one species within a specified area."@en ;
    skos:prefLabel "stock (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/81> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:prefLabel "adaptable species"@en .

<http://www.eionet.europa.eu/gemet/concept/8100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13159> ;
    skos:definition "The handling or controlling of accumulated materials or stored goods."@en ;
    skos:prefLabel "stock management"@en .

<http://www.eionet.europa.eu/gemet/concept/8104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "A general term for rock that is used in construction, either crushed for use as aggregate or cut into shaped blocks as dimension stone."@en ;
    skos:prefLabel "stone"@en .

<http://www.eionet.europa.eu/gemet/concept/8110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1955> ;
    skos:definition "A barrier of concrete, earth, etc., built across a river to create a body of water."@en ;
    skos:prefLabel "storage dam"@en .

<http://www.eionet.europa.eu/gemet/concept/8117> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Storms may cause flooding and damage to crops; uproot trees; damage roofs and chimneys; break windows, leading to rain damage; overturn trucks; affect transportation, communication and energy supplies; delay building construction and destroy traditional landmarks. In their more violent form, storms may cause severe damage and loss of life."@en ;
    skos:prefLabel "storm damage"@en .

<http://www.eionet.europa.eu/gemet/concept/8122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "A chamber within which a fuel-air mixture is burned to provide heat, the heat itself being radiated outward from the chamber; used for space heating, process-fluid heating, and steel blast furnaces."@en ;
    skos:prefLabel "stove"@en .

<http://www.eionet.europa.eu/gemet/concept/8125> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The arrangement of a body of water, as a lake, into two or more horizontal layers of different characteristics, especially densities."@en ;
    skos:prefLabel "stratification"@en .

<http://www.eionet.europa.eu/gemet/concept/8128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/641> ;
    skos:definition "The layer of the atmosphere which is sandwiched between the troposphere and mesosphere. Of the energy that reaches the Earth from the sun, only 3% is absorbed in the stratosphere, but that includes the vitally important process of absorption of ultraviolet radiation by the stratospheric ozone layer. The stratosphere is cloudless and dust free, and almost unaffected by the turbulent conditions of the underlying level of the atmosphere."@en ;
    skos:prefLabel "stratosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/8129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15255>,
        <http://www.eionet.europa.eu/gemet/concept/5994> ;
    skos:definition "Damage of the ozone shield by chemicals released on Earth. The main chemicals that are depleting stratospheric ozone are chlorofluorocarbons (CFCs), which are used in refrigerators, aerosols, and as cleaners in many industries, and halons which are used in fire extinguishers. The damage is caused when these chemicals release highly reactive forms of chlorine and bromine."@en ;
    skos:prefLabel "stratospheric ozone depletion"@en .

<http://www.eionet.europa.eu/gemet/concept/8133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9196> ;
    skos:definition "The quantitative determination of the rate and amount of flow or discharge from a natural body of running water, such as a small river or brook."@en ;
    skos:prefLabel "stream measurement"@en .

<http://www.eionet.europa.eu/gemet/concept/8136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5428> ;
    skos:definition "The process of removing dirt, litter or other unsightly materials from city or town streets."@en ;
    skos:prefLabel "street cleaning"@en .

<http://www.eionet.europa.eu/gemet/concept/8140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:prefLabel "strength of materials"@en .

<http://www.eionet.europa.eu/gemet/concept/8143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14837> ;
    skos:definition "Superficial mining, in which the valuable rock is exposed by removal of overburden. Coal, numerous nonmetals and metalliferous ores (iron and copper) are worked in this way. Sinonym: strip mining, opencast mining, openpit mining."@en ;
    skos:prefLabel "strip mining"@en .

<http://www.eionet.europa.eu/gemet/concept/8144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2637> ;
    skos:definition "A soft silvery-white element of the alkaline earth group of metals, occurring chiefly as celestite and as strontianite. Its compounds burn with a crimson flame and are used in fire works."@en ;
    skos:prefLabel "strontium"@en .

<http://www.eionet.europa.eu/gemet/concept/8145> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6705> ;
    skos:definition "A program for economic reforms aimed at improving or liberalizing an economy, which is advocated and imposed by the World Bank and International Monetary Fund on poor or developing countries in exchange for new loans."@en ;
    skos:prefLabel "structural adjustment program"@en .

<http://www.eionet.europa.eu/gemet/concept/8148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The association between a chemical structure and carcinogenicity."@en ;
    skos:prefLabel "structure-activity relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/8149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Sound that travels over at least part of its path by means of the vibration of a solid structure."@en ;
    skos:prefLabel "structure-borne noise"@en .

<http://www.eionet.europa.eu/gemet/concept/815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:definition "The study of chemical substances occurring in living organisms and the reactions and methods for identifying these substances."@en ;
    skos:prefLabel "biochemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/8151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "Metropolitan structure and land use plan intended to outline the general lines along which development should proceed in an area."@en ;
    skos:prefLabel "structure plan"@en .

<http://www.eionet.europa.eu/gemet/concept/8159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7654> ;
    skos:prefLabel "submarine"@en .

<http://www.eionet.europa.eu/gemet/concept/8162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11494> ;
    skos:prefLabel "subsequent order"@en .

<http://www.eionet.europa.eu/gemet/concept/8163> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7231> ;
    skos:definition """1) A sinking down of a part of the earth's crust, generally due to underground excavations.
2) The sudden sinking or gradual downward settling of the Earth's surface with little or no horizontal motion. The movement is not restricted in rate, magnitude, or area involved. Subsidence may be caused by natural geologic processes, such as solution, thawing, compaction, slow crustal warping, or withdrawal of fluid lava from beneath a solid crust; or by man's activity, such as subsurface mining or the pumping of oil or ground water."""@en ;
    skos:prefLabel "subsidence"@en .

<http://www.eionet.europa.eu/gemet/concept/8165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3205> ;
    skos:definition "Any monetary grant made by the government to a private industrial undertaking or charitable organization, but especially one given to consumers or producers in order to lower the market price of some service or product and make it readily affordable to the public."@en ;
    skos:prefLabel "subsidy"@en .

<http://www.eionet.europa.eu/gemet/concept/8167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7899> ;
    skos:definition "Soil underlying surface soil, devoid of plant roots."@en ;
    skos:prefLabel "subsoil"@en .

<http://www.eionet.europa.eu/gemet/concept/8168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2319> ;
    skos:definition "The removal of surplus water from within the soil by natural or artificial means, such as by drains placed below the surface to lower the water table below the root zone."@en ;
    skos:prefLabel "subsoil drainage"@en .

<http://www.eionet.europa.eu/gemet/concept/8171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The capability of a substance of being replaced by another, for example sweeteners used in place of sugar."@en ;
    skos:prefLabel "substitutability (chemistry)"@en .

<http://www.eionet.europa.eu/gemet/concept/8173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7114> ;
    skos:definition "Halogenated compounds, because of their toxical and persistent character, should be substituted by environmental friendly compounds, like water-based fat solvents in metal processing industry or water-based coating agents."@en ;
    skos:prefLabel "substitution of halogenated compounds"@en .

<http://www.eionet.europa.eu/gemet/concept/8174> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1336> ;
    skos:definition "Replacement of phosphate in detergents by environmentally safer substances, such as zeolite. The substitute will not act as a nutrient, and so will not cause eutrophication as a result of the accelerated growth of plants and microorganisms if it is released into waterways."@en ;
    skos:prefLabel "substitution of phosphate"@en .

<http://www.eionet.europa.eu/gemet/concept/8175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1902> ;
    skos:prefLabel "substrate cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/8179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in regions bordering on the tropics or the regions between tropical and temperate zones."@en ;
    skos:prefLabel "subtropical ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1479> ;
    skos:definition "The study of climate in relation to fauna and flora."@en ;
    skos:prefLabel "bioclimatology"@en .

<http://www.eionet.europa.eu/gemet/concept/8182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "A residential district situated on the outskirts of a city or town."@en ;
    skos:prefLabel "suburb"@en .

<http://www.eionet.europa.eu/gemet/concept/8185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8255> ;
    skos:definition "A sweet crystalline or powdered substance, white when pure, consisting of sucrose obtained mainly from sugar cane and sugar beets and used in many foods, drinks, and medicines to improve their taste."@en ;
    skos:prefLabel "sugar (product)"@en .

<http://www.eionet.europa.eu/gemet/concept/8188> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:definition "Establishments primarily engaged in processing raw cane sugar, sugar beets or starches to finished sucrose, glucose or fructose. By-products of this industry include beet pulp and inedible molasses."@en ;
    skos:prefLabel "sugar industry"@en .

<http://www.eionet.europa.eu/gemet/concept/819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "A community or natural assemblage of organisms; often used as an alternative to ecosystem but strictly is the fauna/flora association excluding physical aspects of the environment."@en ;
    skos:prefLabel "biocoenosis"@en .

<http://www.eionet.europa.eu/gemet/concept/8190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A salt or ester of sulfuric acid, widely distributed in nature and often found in the atmosphere."@en ;
    skos:prefLabel "sulphate"@en .

<http://www.eionet.europa.eu/gemet/concept/8198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2641> ;
    skos:definition "A nonmetallic element existing in a crystalline or amorphous form and in four stable isotopes; used as a chemical intermediate and fungicide, and in rubber vulcanization. It is deposited from volcanic vents and fumaroles and also is found in sedimentary rocks, particularly with gypsum and limestone, and associated with salt-domes. Native sulphur is the main source of sulphur for the sulphuric acid industry, followed by sour gas (natural gas containing hydrogen sulphide) and pyrite. Sulphur is an essential plant macronutrient."@en ;
    skos:prefLabel "sulphur"@en .

<http://www.eionet.europa.eu/gemet/concept/820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The quotient of the concentration of a chemical in aquatic organisms at a specific time or during a discrete time period of exposure, divided by the concentration in the surrounding water at the same time or during the same period."@en ;
    skos:prefLabel "bioconcentration factor"@en .

<http://www.eionet.europa.eu/gemet/concept/8200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "Sulphur content in a solution."@en ;
    skos:prefLabel "sulphur concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/8202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5978>,
        <http://www.eionet.europa.eu/gemet/concept/8204> ;
    skos:definition "Emissions of the gas given off during the burning of fossil fuels in power stations and other boilers. Sulphur dioxide is created because sulphur is an impurity in most coal and oils. When the fuel is burned the hot sulphur reacts with oxygen in the atmosphere to form sulphur dioxide."@en ;
    skos:prefLabel "sulphur dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/8203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A toxic, corrosive, strongly acid, colorless liquid that is miscible with water and dissolves most metals, and melts at 10C; used in industry in the manufacture of chemicals, fertilizers and explosives, and in petroleum refining."@en ;
    skos:prefLabel "sulphuric acid"@en .

<http://www.eionet.europa.eu/gemet/concept/821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2039> ;
    skos:definition """The extent to which a substance can be decomposed - or rotted - by bacteria and fungi.
Implies that residues from degradation are nontoxic. One of the most misleading claims in business, because shoppers often assume a biodegradable product to be harmless. Some harmful compounds take much longer to degrade than others and the product can harm the environment while it is rotting. Biodegradation may also be incomplete, sometimes leaving residues in the environment which are more harmful than the original substance. Accumulation in the environment of nonbiodegradable (or poorly biodegradable) substances, such as some biocides, can cause serious problems."""@en ;
    skos:prefLabel "biodegradability"@en .

<http://www.eionet.europa.eu/gemet/concept/8213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8212> ;
    skos:definition "The oversight or direction over the process of setting up or making adjustments to a building or to a mechanical or electrical system or apparatus."@en ;
    skos:prefLabel "supervision of installation"@en .

<http://www.eionet.europa.eu/gemet/concept/8214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13289> ;
    skos:definition "An appointed or official group given the responsibility of overseeing or managing normal work operations, special projects or other functions of an organization or agency."@en ;
    skos:prefLabel "supervisory body"@en .

<http://www.eionet.europa.eu/gemet/concept/8219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "The willingness and ability to sell a range of quantities of a good at a range of prices, during a given time period. Supply is one half of the market exchange process; the other is demand."@en ;
    skos:prefLabel "supply (trade)"@en .

<http://www.eionet.europa.eu/gemet/concept/8222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A substance that, when used in small quantities, modifies the surface properties of liquids or solids. A surface-active agent reduces surface tension in a fluid or the interfacial tension between two immiscible fluids, such as oil and water. Surfactants are particularly useful in accomplishing the wetting or penetration of solids by aqueous liquids and serve in the manner of detergent, emulsifying, or dispersing agents. They are more effective than soap in certain situations and are used by conservators for such purposes as cleaning, wetting, and dispersing."@en ;
    skos:prefLabel "surface-active agent"@en .

<http://www.eionet.europa.eu/gemet/concept/8225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7340> ;
    skos:definition "Water that travels over the soil surface to the nearest surface stream; runoff of a drainage basin that has not passed beneath the surface since precipitation."@en ;
    skos:prefLabel "surface runoff"@en .

<http://www.eionet.europa.eu/gemet/concept/8226> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The force acting on the surface of a liquid, tending to minimize the area of the surface; quantitatively, the force that appears to act across a line of unit length on the surface. Also known as interfacial force; interfacial tension; surface intensity."@en ;
    skos:prefLabel "surface tension"@en .

<http://www.eionet.europa.eu/gemet/concept/8227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Any method of treating a material (metal, polymer, or wood) so as to alter the surface, rendering it receptive to inks, paints, lacquers, adhesives, and various other treatments, or resistant to weather or chemical attack."@en ;
    skos:prefLabel "surface treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "A pollutant which can be converted by biological processes into simple inorganic molecules."@en ;
    skos:prefLabel "biodegradable pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/8236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4002> ;
    skos:definition "Any tissue, blood or mucus removed during surgery or autopsy, soiled surgical dressings, or other materials requiring special disposal procedures."@en ;
    skos:prefLabel "surgical waste"@en .

<http://www.eionet.europa.eu/gemet/concept/8237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "The extent to which assets exceed liabilities, especially the profits remaining after operating expenses, taxes, interest and insurance costs are subtracted."@en ;
    skos:prefLabel "surplus"@en .

<http://www.eionet.europa.eu/gemet/concept/8239> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "System that permits the continuous observation, measurement and evaluation of the progress of a process or phenomenon with the view to taking corrective measures."@en ;
    skos:prefLabel "surveillance"@en .

<http://www.eionet.europa.eu/gemet/concept/8249> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:definition "Statistical indicators used for measuring sustainable development that may be chosen among a wide range of themes as, for example, environmental capacity and quality of life."@en ;
    skos:prefLabel "sustainable development indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/8259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "A close and mutually beneficial association of organisms of different species."@en ;
    skos:prefLabel "symbiosis"@en .

<http://www.eionet.europa.eu/gemet/concept/826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2040>,
        <http://www.eionet.europa.eu/gemet/concept/812> ;
    skos:definition "Breaking down of a substance by microorganisms."@en ;
    skos:prefLabel "biodegradation"@en .

<http://www.eionet.europa.eu/gemet/concept/8263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "An ecological association in which the physiological processes of behaviour of an individual are enhanced by the nearby presence of another organism."@en ;
    skos:prefLabel "synergism"@en .

<http://www.eionet.europa.eu/gemet/concept/8265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11678> ;
    skos:definition """1) A state in which the combined effect of two or more substances is greater than the sum of the separate effects. 
2) An effect whereby two toxic substance together have more of an impact than anticipated."""@en ;
    skos:prefLabel "synergistic effect of toxic substances"@en .

<http://www.eionet.europa.eu/gemet/concept/8268> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2131> ;
    skos:definition "An artificially produced solid or liquid cleansing substance that acts like soap but is stronger, and is capable of dissolving oily materials and dispersing them in water."@en ;
    skos:prefLabel "synthetic detergent"@en .

<http://www.eionet.europa.eu/gemet/concept/8269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "synthetic fibres industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Material made artificially by chemical reaction."@en ;
    skos:prefLabel "synthetic material"@en .

<http://www.eionet.europa.eu/gemet/concept/8273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "synthetic materials industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3174> ;
    skos:definition "An artificially produced filament or threadlike strand used by manufacturers to produce clothes or other goods that require weaving, knitting or felting, including polyester, nylon, rayon and other similar material."@en ;
    skos:prefLabel "synthetic textile fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/8278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5097> ;
    skos:definition "A means of organizing elements into an integrated analytic and/or decisionmaking procedure to achieve the best possible results."@en ;
    skos:prefLabel "systems analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/8279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "Analysis or estimate noting similarities and differences in the operations of businesses and organizations."@en ;
    skos:prefLabel "systems comparison"@en .

<http://www.eionet.europa.eu/gemet/concept/8283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "In criminal law and torts, the act of laying hold upon an evidence, with or without removing the same."@en ;
    skos:prefLabel "taking of evidence"@en .

<http://www.eionet.europa.eu/gemet/concept/8284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4913> ;
    skos:definition "A truck designed for bulk shipment of liquids or gases."@en ;
    skos:prefLabel "tanker (truck)"@en .

<http://www.eionet.europa.eu/gemet/concept/8286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Storage space for containers of liquids or gases."@en ;
    skos:prefLabel "tank farm"@en .

<http://www.eionet.europa.eu/gemet/concept/8289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9358> ;
    skos:definition "One of a group of complex organic chemicals commonly found in leaves, unripe fruits, and the bark of trees. Their function is uncertain though the unpleasant taste may discourage grazing animals. Some tannins have commercial uses, notably in the production of leather and ink; used in tanning, as a mordant in dyeing, and in ink manufacture."@en ;
    skos:prefLabel "tannin"@en .

<http://www.eionet.europa.eu/gemet/concept/8296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "A viscous material composed of complex, high-molecular-weight, compounds derived from the distillation of petroleum or the destructive distillation of wood or coal."@en ;
    skos:prefLabel "tar"@en .

<http://www.eionet.europa.eu/gemet/concept/83> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:prefLabel "adaptation period"@en .

<http://www.eionet.europa.eu/gemet/concept/830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2980> ;
    skos:definition "The study of ethical problems arising from biological research and its applications in such fields as organ transplantation, genetic engineering, or artificial insemination."@en ;
    skos:prefLabel "bioethics"@en .

<http://www.eionet.europa.eu/gemet/concept/8303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The manufacture of dark, heavy, viscous substances or residue, which is obtained by the distillation of organic materials such as coal, wood and petroleum."@en ;
    skos:prefLabel "tar production"@en .

<http://www.eionet.europa.eu/gemet/concept/8304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5264> ;
    skos:definition "A sandstone in which hydrocarbons have been trapped; the lighter compounds evaporate, leaving a residue of asphalt in the rock pores."@en ;
    skos:prefLabel "tar sand"@en .

<http://www.eionet.europa.eu/gemet/concept/8305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Any employment or utilization of dark, heavy, viscous substances or residue derived from the distillation of certain organic materials, often to produce benzene, soap, dyes, cosmetics and other products."@en ;
    skos:prefLabel "tar use"@en .

<http://www.eionet.europa.eu/gemet/concept/8309> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13253> ;
    skos:prefLabel "tax differentiation"@en .

<http://www.eionet.europa.eu/gemet/concept/8312> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3200> ;
    skos:definition "A binding rule or body of rules prescribed by a government stipulating the sum of money and manner of collection it demands for governmental support, facilities and services, usually levied upon income, property, sales or other financial resources."@en ;
    skos:prefLabel "tax law"@en .

<http://www.eionet.europa.eu/gemet/concept/8313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "The branch of biology concerned with the classification of organisms into groups based on similarities of structures, origin, etc."@en ;
    skos:prefLabel "taxonomy"@en .

<http://www.eionet.europa.eu/gemet/concept/832> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12011> ;
    skos:definition "Gas, rich in methane, which is produced by the fermentation of animal dung, human sewage or crop residues in an air-tight container. It is used as a fuel, to heat stoves, lamps, run small machines and to generate electricity. The residues of biogas production are used as a low-grade organic fertilizer. Biogas fuels do not usually cause any pollution to the atmosphere, and because they come from renewable energy resources they have great potential for future use."@en ;
    skos:prefLabel "biogas"@en .

<http://www.eionet.europa.eu/gemet/concept/8321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8319> ;
    skos:definition "A procedure, technique or system with definite plans for instruction or imparting knowledge."@en ;
    skos:prefLabel "teaching method"@en .

<http://www.eionet.europa.eu/gemet/concept/8326> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "Technical Guideline for Dangerous Substances: technical rules for handling dangerous materials."@en ;
    skos:prefLabel "technical regulation for dangerous substances"@en .

<http://www.eionet.europa.eu/gemet/concept/8333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8330> ;
    skos:prefLabel "technological development"@en .

<http://www.eionet.europa.eu/gemet/concept/8337> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:prefLabel "technological process"@en .

<http://www.eionet.europa.eu/gemet/concept/834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1348> ;
    skos:prefLabel "biogeochemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/8340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7804> ;
    skos:definition "The approval, favorable reception and ongoing use of newly introduced devices and systems, usually developed from recent advances in the engineering sciences or industrial arts."@en ;
    skos:prefLabel "technology acceptance"@en .

<http://www.eionet.europa.eu/gemet/concept/8341> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "The systematic analysis of the anticipated impact of a particular technology in regard to its safety and efficacy as well as its social, political, economic, and ethical consequences."@en ;
    skos:prefLabel "technology assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/8342> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8330> ;
    skos:definition "The transfer of development and design work: a) from a parent company to a subsidiary, perhaps in another nation where it will be paid for in repatriated profits or royalties; b) from one country to another as a form of aid to help promote development and sustainable growth. Many nations have made great progress on the strength of technology transfer."@en ;
    skos:prefLabel "technology transfer"@en .

<http://www.eionet.europa.eu/gemet/concept/8344> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "A branch of geology dealing with the broad architecture of the outer part of the Earth, that is, the regional assembling of structural or deformation features, a study of their mutual relations, origin and historical evolution."@en ;
    skos:prefLabel "tectonics"@en .

<http://www.eionet.europa.eu/gemet/concept/8347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1605> ;
    skos:definition "The conveyance of images, speech and other sounds, usually over great distances, through technological means, particularly by television, telegraph, telephone or radio."@en ;
    skos:prefLabel "telecommunication"@en .

<http://www.eionet.europa.eu/gemet/concept/835> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "Area of the Earth's surface defined by the species of fauna and flora it contains."@en ;
    skos:prefLabel "biogeographical region"@en .

<http://www.eionet.europa.eu/gemet/concept/8350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The convergence of computing and communications technologies, thus the use of telephone or radio to link computers and the use of computers to send messages via telephone or radio links."@en ;
    skos:prefLabel "telematics"@en .

<http://www.eionet.europa.eu/gemet/concept/836> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3646> ;
    skos:definition "The science concerned with the geographical distribution of animal and plant life."@en ;
    skos:prefLabel "biogeography"@en .

<http://www.eionet.europa.eu/gemet/concept/8360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in regions of or related to moderate climates, intermediate between tropical and polar zones and having distinct warm to hot summer seasons and cool to cold winter seasons."@en ;
    skos:prefLabel "temperate ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/8362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9349> ;
    skos:definition "Forest dominated by broad-leaved hardwoods, which occurs over large tracts in the mid-latitudes of Europe, N. America, and eastern Asia, but which is restricted in the southern hemisphere to Chilean Patagonia."@en ;
    skos:prefLabel "temperate woodland"@en .

<http://www.eionet.europa.eu/gemet/concept/8367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4022> ;
    skos:prefLabel "temporary housing"@en .

<http://www.eionet.europa.eu/gemet/concept/8369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8627> ;
    skos:definition "Simple facilities for asylum or provisional lodgings to individuals or groups in emergencies."@en ;
    skos:prefLabel "temporary shelter"@en .

<http://www.eionet.europa.eu/gemet/concept/8371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Any deposit or holdings of goods, materials or waste in a facility, container, tank or some other physical location for a brief or short time period."@en ;
    skos:prefLabel "temporary storage"@en .

<http://www.eionet.europa.eu/gemet/concept/8376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6065> ;
    skos:definition "The process whereby abnormalities of the offspring are generated, usually as the result of damage to the embryonal structure during the first trimester of pregnancy, producing deformity of the fetus."@en ;
    skos:prefLabel "teratogenesis"@en .

<http://www.eionet.europa.eu/gemet/concept/8377> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6798> ;
    skos:prefLabel "teratogenesis screening"@en .

<http://www.eionet.europa.eu/gemet/concept/8378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3872> ;
    skos:definition "The ability or tendency to produce anomalies of formation."@en ;
    skos:prefLabel "teratogenicity"@en .

<http://www.eionet.europa.eu/gemet/concept/8379> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "Substances causing formation of a congenital anomaly or monstrosity in the embryo."@en ;
    skos:prefLabel "teratogen"@en .

<http://www.eionet.europa.eu/gemet/concept/8381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "A soft-bodied insect of the order Isoptera; individuals feed on cellulose and live in colonies with a caste system comprising three types of functional individuals: sterile workers and soldiers, and the reproductives. Also known as white ant."@en ;
    skos:prefLabel "termite"@en .

<http://www.eionet.europa.eu/gemet/concept/8387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/873> ;
    skos:definition "Any source of supply derived from plants, animals or other wildlife inhabiting land or ground, which may be used by humans for food, clothes and other necessities."@en ;
    skos:prefLabel "terrestrial biological resource"@en .

<http://www.eionet.europa.eu/gemet/concept/839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:prefLabel "biological activity"@en .

<http://www.eionet.europa.eu/gemet/concept/84> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Chemical reaction in which one or more of the double bonds or triple bonds in an unsaturated compound is converted to a single bond by the addition of other atoms or groups."@en ;
    skos:prefLabel "chemical addition"@en .

<http://www.eionet.europa.eu/gemet/concept/8401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "An area that an animal or group of animals defends, mainly against members of the same species."@en ;
    skos:prefLabel "territory"@en .

<http://www.eionet.europa.eu/gemet/concept/8403> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7554> ;
    skos:definition "The part of a country or region's economy that produces services or assets lacking a tangible and storable form."@en ;
    skos:prefLabel "tertiary sector"@en .

<http://www.eionet.europa.eu/gemet/concept/8407> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8415> ;
    skos:definition "Animals on which experiments are conducted in order to provide evidence for or against a scientific hypothesis, or to prove the efficacy of drugs or the reaction to certain products."@en ;
    skos:prefLabel "test animal"@en .

<http://www.eionet.europa.eu/gemet/concept/8411> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:prefLabel "testing guideline"@en .

<http://www.eionet.europa.eu/gemet/concept/842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Properties or features belonging to living organisms."@en ;
    skos:prefLabel "biological attribute"@en .

<http://www.eionet.europa.eu/gemet/concept/8421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the production of fabrics."@en ;
    skos:prefLabel "textile industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8428> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2638> ;
    skos:definition "Bluish-white metal with tinlike malleability, but a little softer; used in alloys."@en ;
    skos:prefLabel "thallium"@en .

<http://www.eionet.europa.eu/gemet/concept/8433> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13151> ;
    skos:definition "A coherent group of general propositions about the supply and demand of money, interest rates, the flow of money's influence on the overall economy or the policies that should be adopted by institutions controlling the money supply."@en ;
    skos:prefLabel "theory of money"@en .

<http://www.eionet.europa.eu/gemet/concept/8434> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7832> ;
    skos:definition "A political conception of government in a capitalist economy where the state is responsible for insuring that all members of society attain a minimum standard of living through redistribution of resources, progressive taxation and universal social programs, including health care and education."@en ;
    skos:prefLabel "theory of the welfare state"@en .

<http://www.eionet.europa.eu/gemet/concept/8435> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:definition "The treatment of physical, mental or social disorders or disease."@en ;
    skos:prefLabel "therapy"@en .

<http://www.eionet.europa.eu/gemet/concept/8440> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8447> ;
    skos:definition "The process of preventing the passage of heat to or from a body by surrounding it with a nonconducting material."@en ;
    skos:prefLabel "thermal insulation"@en .

<http://www.eionet.europa.eu/gemet/concept/8442> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6227> ;
    skos:definition "The excessive raising or lowering of water temperature above or below normal seasonal ranges in streams, lakes, or estuaries or oceans as the result of discharge of hot or cold effluents into such water."@en ;
    skos:prefLabel "thermal pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/8443> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "A power-generating plant which uses heat to produce energy. Such plants may burn fossil fuels or use nuclear energy to produce the necessary thermal energy."@en ;
    skos:prefLabel "thermal power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/8446> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "The concept of utilizing the temperature differences of 20°C or more that occur between the surface of an ocean and its depths to achieve a continuous supply of power; this temperature difference may be found in the tropical regions of the world. Various small plants have been constructed to demonstrate the principle."@en ;
    skos:prefLabel "thermal sea power"@en .

<http://www.eionet.europa.eu/gemet/concept/8448> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water, generally of a spring or geyser, whose temperature is appreciably above the local mean annual air temperature."@en ;
    skos:prefLabel "thermal water"@en .

<http://www.eionet.europa.eu/gemet/concept/8450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The branch of physics which seeks to derive, from a few basic postulates, relationships between properties of matter, especially those connected with temperature, and a description of the conversion of energy from one form to another."@en ;
    skos:prefLabel "thermodynamics"@en .

<http://www.eionet.europa.eu/gemet/concept/8452> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8447> ;
    skos:definition "Trade-Mark-Name for a thermic waste processing technology. Gasification is emerging as an alternative to combustion in the treatment and energy recovery from Municipal Solid Waste. Several innovative processes and demonstration plants are trying to achieve higher electrical efficiencies and lower emissions using this technology."@en ;
    skos:prefLabel "thermoselect process"@en .

<http://www.eionet.europa.eu/gemet/concept/8454> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A compilation of terms showing synonyms, related terms and other relationships and dependencies, often used in a book format or as a standardized, controlled vocabulary for an information storage and retrieval system."@en ;
    skos:prefLabel "thesaurus"@en .

<http://www.eionet.europa.eu/gemet/concept/8470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The maximum concentration of a particular substance to which a worker should be exposed in a given period of time."@en ;
    skos:prefLabel "threshold value"@en .

<http://www.eionet.europa.eu/gemet/concept/8475> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9259> ;
    skos:definition "Mechanical power, which may be converted to electrical power, generated by the rise and fall of ocean tides. The possibilities of utilizing tidal power have been studied for many generations, but the only feasible schemes devised so far are based on the use of one or more tidal basins, separated from the sea by dams (known as barrages), and of hydraulic turbines through which water passes on its way between the basins and the sea."@en ;
    skos:prefLabel "tidal power"@en .

<http://www.eionet.europa.eu/gemet/concept/8480> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7513> ;
    skos:definition "The periodic rise and fall of the water resulting from gravitational interaction between the sun, moon and earth. In each lunar day of 24 hours and 49 minutes there are two high tides and two low tides."@en ;
    skos:prefLabel "tide"@en .

<http://www.eionet.europa.eu/gemet/concept/8487> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition """1) The dimension of the physical universe which, at a given place, orders the sequence of events. 
2) A designated instant in this sequence, as the time of day. Also known as epoch."""@en ;
    skos:prefLabel "time"@en .

<http://www.eionet.europa.eu/gemet/concept/8490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2639> ;
    skos:definition "A metallic element, occurring in cassiterite, that has several allotropes; the ordinary malleable silvery-white metal slowly changes below 13.2°C to a grey powder. It is used extensively in alloys, especially bronze and pewter, and as a noncorroding coating for steel."@en ;
    skos:prefLabel "tin (element)"@en .

<http://www.eionet.europa.eu/gemet/concept/8495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A strong malleable white metallic element, which is very corrosion-resistant and occurs in rutile and ilmenite. It is used in the manufacture of strong lightweight alloys, especially aircraft parts."@en ;
    skos:prefLabel "titanium"@en .

<http://www.eionet.europa.eu/gemet/concept/8496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5178>,
        <http://www.eionet.europa.eu/gemet/concept/5978> ;
    skos:definition "A white, water-insoluble powder that melts at 1560°C, and which is produced commercially from the titanium dioxide minerals ilmenite and rutile; used in paints and cosmetics."@en ;
    skos:prefLabel "titanium dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/8499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/387> ;
    skos:definition "Any anuran amphibian of the class Bufonidae, such as Bufo bufo of Europe. They are similar to frogs but are more terrestrial, having a drier warty skin."@en ;
    skos:prefLabel "toad"@en .

<http://www.eionet.europa.eu/gemet/concept/8501> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:prefLabel "tobacco"@en .

<http://www.eionet.europa.eu/gemet/concept/8503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7761> ;
    skos:definition "The grey, brown, or blackish mixture of gases and suspended carbon particles resulting from the combustion of tobacco. Tobacco smoke is inhaled and distributes toxins widely throughout the body and causes an enormous variety of illness among users and among non-smokers exposed to tobacco smoke."@en ;
    skos:prefLabel "tobacco smoke"@en .

<http://www.eionet.europa.eu/gemet/concept/851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/898> ;
    skos:definition "The application of engineering principles and techniques to living organisms. It is largely concerned with the design of replacement body parts, such as limbs, heart valves, etc."@en ;
    skos:prefLabel "biological engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/8516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A rapidly rotating column of air developed around a very intense low-pressure centre. It is associated with a dark funnel-shaped cloud and with extremely violent winds (>300km/h) blowing in a counterclockwise spiral, but accompanied by violent downdraughts. The precise mechanisms are not fully understood but the following atmospheric conditions appear to be necessary for tornado development: a layer of warm moist air at low altitude; a layer of dry air at higher altitude with an inversion of temperature at about 1.000 m; a triggering mechanism, usually in the form of an active, intense cold front or solar heating of the ground which will create a vortex."@en ;
    skos:prefLabel "tornado"@en .

<http://www.eionet.europa.eu/gemet/concept/8519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7124> ;
    skos:definition "Any herbivorous terrestrial chelonian reptile of the family Testudinidae, of most warm regions, having a heavy dome-shaped shell and clawed limbs."@en ;
    skos:prefLabel "tortoise"@en .

<http://www.eionet.europa.eu/gemet/concept/8521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The sum of parameters that must be taken into account when assessing water quality (organoleptic factors, physico-chemical factors, toxic substances, microbiological parameters."@en ;
    skos:prefLabel "total parameter"@en .

<http://www.eionet.europa.eu/gemet/concept/8527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7003> ;
    skos:definition "Any section of a region which attracts travelers, often because of its scenery, objects of interest or recreational activities."@en ;
    skos:prefLabel "touristic zone"@en .

<http://www.eionet.europa.eu/gemet/concept/8537> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A result produced by the ingestion or contact of poisonous materials."@en ;
    skos:prefLabel "toxic effect"@en .

<http://www.eionet.europa.eu/gemet/concept/8539> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8538> ;
    skos:prefLabel "toxicity of pesticides"@en .

<http://www.eionet.europa.eu/gemet/concept/8540> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8546> ;
    skos:definition "Metals (usually heavy metals) which interfere with the respiration, metabolism or growth of organisms."@en ;
    skos:prefLabel "toxic metal"@en .

<http://www.eionet.europa.eu/gemet/concept/8542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "Test for the determination of the inherent toxicity of a chemical."@en ;
    skos:prefLabel "toxicological testing"@en .

<http://www.eionet.europa.eu/gemet/concept/8545> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8546> ;
    skos:definition "Any product which can cause acute or chronic injury to the human body or which is suspected of being able to cause disease or injury under some conditions."@en ;
    skos:prefLabel "toxic product"@en .

<http://www.eionet.europa.eu/gemet/concept/8547> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Refuse posing a significant hazard to the environment or to human health when improperly handled; includes carcinogenic, mutagenic, teratogenic or phytotoxic wastes, or wastes harmful to aquatic species, or poisonous wastes."@en ;
    skos:prefLabel "toxic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/8549> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:definition "A poisonous substance generally of plant or animal origin."@en ;
    skos:prefLabel "toxin"@en .

<http://www.eionet.europa.eu/gemet/concept/8554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Any of various chemical elements that occur in very small amounts in organisms and are essential for many physiological and biochemical processes."@en ;
    skos:prefLabel "trace element"@en .

<http://www.eionet.europa.eu/gemet/concept/8556> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition """1) Both metals and non-metals, essential for the metabolic processes of algae, invertebrates and vertebrates. Organisms that derive nearly all their energy via photosynthesis are especially dependent upon dissolved trace substances.
2) Impurities that are present at small but detectable levels."""@en ;
    skos:prefLabel "trace material"@en .

<http://www.eionet.europa.eu/gemet/concept/856> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:definition "A species or organism that is used to grade environmental quality or change."@en ;
    skos:prefLabel "biological indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/8562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6279> ;
    skos:definition "A formulated or systematic method for following or tracing environmentally related issues or concerns."@en ;
    skos:prefLabel "tracking plan"@en .

<http://www.eionet.europa.eu/gemet/concept/8564> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Tradable emissions permits are used in an environmental regulatory scheme where the sources of the pollutant to be regulated (most often an air pollutant) are given permits to release a specified number of tons of the pollutant. The government issues only a limited number of permits consistent with the desired level of emissions. The owners of the permits may keep them and release the pollutants, or reduce their emissions and sell the permits. The fact that the permits have value as an item to be sold gives the owner an incentive to reduce their emissions."@en ;
    skos:prefLabel "tradeable permit"@en .

<http://www.eionet.europa.eu/gemet/concept/8567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8574> ;
    skos:definition "An artificial restraint on the free exchange of goods and services between nations. The most common types of trade barriers are tariffs, quotas, and exchange control. Such obstacles to trade are usually imposed by a country that wishes to protect domestic products in their home market against foreign competition, better its terms of trade, reduce domestic unemployment, or improve its balance-of-payments position. The raising of trade barriers by one country often provokes other nations position. Generally, the effect of a trade barrier is to reduce the volume of trade while increasing the domestic price of the protected good. Thus, it results in a relatively inefficient allocation of world resources and reduces the level of total world income and production."@en ;
    skos:prefLabel "trade barrier"@en .

<http://www.eionet.europa.eu/gemet/concept/8569> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13242> ;
    skos:definition "The act or the business of buying and selling for money. Mercantile or commercial business in general or the buying and selling, or exchanging, of commodities, either by wholesale or retail within a country or between countries."@en ;
    skos:prefLabel "trade (economic)"@en .

<http://www.eionet.europa.eu/gemet/concept/8570> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Trade impacts on the environment can be direct, such as trade of endangered species, of natural resources, of natural products such as tropical timber, etc., or indirect, such as deforestation, loss of habitats, pollution from mining, from energy production, oil spills, global warming, etc., increases in transport infrastructures."@en ;
    skos:prefLabel "trade impact on environment"@en .

<http://www.eionet.europa.eu/gemet/concept/8572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "The act or process of buying, selling, or exchanging commodities, at either wholesale or retail, within a country or between countries."@en ;
    skos:prefLabel "trade (profession)"@en .

<http://www.eionet.europa.eu/gemet/concept/8576> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4584> ;
    skos:definition "An organization whose members are wholly or mainly workers and whose principal purposes include the regulation of relations between workers and employers or employers' associations."@en ;
    skos:prefLabel "trades union"@en .

<http://www.eionet.europa.eu/gemet/concept/8580> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:definition "A system of treating and healing maladies based on cultural beliefs and practices handed down from generation to generation."@en ;
    skos:prefLabel "traditional health care"@en .

<http://www.eionet.europa.eu/gemet/concept/8586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8585> ;
    skos:definition "Means of controlling the number and speed of motorvehicles using a road."@en ;
    skos:prefLabel "traffic control measure"@en .

<http://www.eionet.europa.eu/gemet/concept/8588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "Exhaust gases and vapours emitted by motorvehicles."@en ;
    skos:prefLabel "traffic emission"@en .

<http://www.eionet.europa.eu/gemet/concept/8592> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7293> ;
    skos:definition "A number of vehicles so obstructed that they can scarcely move."@en ;
    skos:prefLabel "traffic jam"@en .

<http://www.eionet.europa.eu/gemet/concept/8595> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The periodic or continuous surveillance or analysis of the movement of persons, objects, vehicles or other conveyances along an area of passage."@en ;
    skos:prefLabel "traffic monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/8596> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2884> ;
    skos:definition "Noise emitted by vehicles (heavy vehicles, cars and motorcycles, tyre/road interaction)."@en ;
    skos:prefLabel "traffic noise"@en .

<http://www.eionet.europa.eu/gemet/concept/8597> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2665> ;
    skos:definition "Traffic noise can be controlled by reduction at source, by fitting motor vehicles with silencers, by installing barriers which interrupt the direct path of sound or by insulating dwellings exposed to high noise levels, such as those related to motorways or airports."@en ;
    skos:prefLabel "traffic noise control"@en .

<http://www.eionet.europa.eu/gemet/concept/8599> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:prefLabel "traffic route"@en .

<http://www.eionet.europa.eu/gemet/concept/86> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5999> ;
    skos:definition "Additional packaging around the normal sales packaging. For example as protection against theft or for the purpose of advertising; the customer may leave the additional packaging in the shop for waste collection."@en ;
    skos:prefLabel "additional packaging"@en .

<http://www.eionet.europa.eu/gemet/concept/8608> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Place where people are prepared for a specific purpose."@en ;
    skos:prefLabel "training centre"@en .

<http://www.eionet.europa.eu/gemet/concept/8610> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The path described by an object moving in air or space under the influence of such forces as thrust, wind resistance, and gravity, especially the curved path of a projectile."@en ;
    skos:prefLabel "trajectory"@en .

<http://www.eionet.europa.eu/gemet/concept/862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10043>,
        <http://www.eionet.europa.eu/gemet/concept/11714> ;
    skos:prefLabel "biological nitrogen fixation"@en .

<http://www.eionet.europa.eu/gemet/concept/8621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2895> ;
    skos:definition "Polluted air and water, or any other contaminated waste, that is generated in one country and transmitted to others."@en ;
    skos:prefLabel "transboundary pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/8626> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1776> ;
    skos:definition "Rules, guidelines or an agreement on the process of changing the administration, structure or constitution of a government or organization."@en ;
    skos:prefLabel "transitional arrangement"@en .

<http://www.eionet.europa.eu/gemet/concept/8630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "The loss of water vapour from a plant, mainly through the stomata and to a small extent through the cuticle and lenticels. Transpiration results in a stream of water, carrying dissolved minerals salts, flowing upwards through the xylem."@en ;
    skos:prefLabel "transpiration"@en .

<http://www.eionet.europa.eu/gemet/concept/8633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "Any commercial venture involved in the processes of conveying things or people from one place to another."@en ;
    skos:prefLabel "transportation business"@en .

<http://www.eionet.europa.eu/gemet/concept/8634> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13233> ;
    skos:definition "Transportation of gases, liquids or slurries by a system of tubes, of steel or plastics. Petroleum, natural gas and products derived from them are the main substances transported by pipelines."@en ;
    skos:prefLabel "transportation by pipeline"@en .

<http://www.eionet.europa.eu/gemet/concept/8639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Comprehensive statements of the objectives and policies which a local transport authority intends to pursue; it includes and estimate of transport expenditure, a statement of transport objectives, etc."@en ;
    skos:prefLabel "transportation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6139> ;
    skos:definition "Any living organism applied to or introduced into the environment that is intended to function as a pesticide against another organism declared to be a pest."@en ;
    skos:prefLabel "biological pest control"@en .

<http://www.eionet.europa.eu/gemet/concept/865> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Viruses, bacteria, fungi, and mammal and bird antigens that may be present in the environment and cause many health effects."@en ;
    skos:prefLabel "biological pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/8655> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "To catch an animal in a mechanical device or enclosed place or pit."@en ;
    skos:prefLabel "trapping"@en .

<http://www.eionet.europa.eu/gemet/concept/8659> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "Expenditure of money or the amount of money incurred for journeying or going from one place to another by some mode of transportation."@en ;
    skos:prefLabel "travel cost"@en .

<http://www.eionet.europa.eu/gemet/concept/866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Disturbance of the ecological balance by the accidental or deliberate introduction of a foreign organism, animal or plant species into an environment."@en ;
    skos:prefLabel "biological pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/8667> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10704> ;
    skos:definition "An area where trees, shrubs, or plants are grown for transplanting, for use as stocks for budding and grafting."@en ;
    skos:prefLabel "tree nursery"@en .

<http://www.eionet.europa.eu/gemet/concept/8675> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4505> ;
    skos:definition "Method in which water drips to the soil from perforated tubes or emitters. This irrigation technology is water conserving compared to flooding, furrows, and sprinklers."@en ;
    skos:prefLabel "trickle irrigation"@en .

<http://www.eionet.europa.eu/gemet/concept/8679> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "Three fundamental principles of environmental policy: precautionary principle, polluter pays-principle and cooperation principle."@en ;
    skos:prefLabel "trinity of principles"@en .

<http://www.eionet.europa.eu/gemet/concept/868> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition """1) The amount and rate of production which occur in a given ecosystem over a given time period. It may apply to a single organism, a population, or entire communities and ecosystems.
2) The quantity of organic matter or its equivalent in dry matter, carbon, or energy content which is accumulated during a given period of time."""@en ;
    skos:prefLabel "biological production"@en .

<http://www.eionet.europa.eu/gemet/concept/8680> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4103> ;
    skos:definition "The hydrogen isotope having mass number 3; it is one form of heavy hydrogen, the other being deuterium."@en ;
    skos:prefLabel "tritium"@en .

<http://www.eionet.europa.eu/gemet/concept/8686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8685> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in forests found in tropical regions near the equator, which are characterized by warm to hot weather and abundant rainfall."@en ;
    skos:prefLabel "tropical forest ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/8687> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A vegetation class consisting of tall, close-growing trees, their columnar trunks more or less unbranched in the lower two-thirds, and forming a spreading and frequently flat crown; occurs in areas of high temperature and high rainfall."@en ;
    skos:prefLabel "tropical forest"@en .

<http://www.eionet.europa.eu/gemet/concept/8688> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6949> ;
    skos:definition "The most valuable and the richest ecosystem on Earth. It plays a critical part in the Earth's life support systems and house 50%, and possibly as much as 90%, of all the species on Earth. It is a key storehouse of foods, oils and minerals, and a source of ingredients that make up a range of medical treatments. It also represents home and livelihood for many people. However, more than half of the rainforests have disappeared, chopped down for valuable tropical hardwoods, or cleared to provide areas for cattle grazing or human habitation. The forests play an important part in climate patterns, and deforestation is thought to be responsible for 18% of global warming. Furthermore, as they disappear there is also an albedo effect - a damaging increase in the sunlight reflected - which affects wind and rainfall patterns."@en ;
    skos:prefLabel "tropical rain forest"@en .

<http://www.eionet.europa.eu/gemet/concept/8693> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1476> ;
    skos:definition "The region of the earth's surface lying between two parallels of latitude on the earth, one 23°27' north of the equator and the other 23°27' south of the equator, representing the points farthest north and south at which the sun can shine directly overhead and constituting the boundaries of the Torrid Zone."@en ;
    skos:prefLabel "tropics"@en .

<http://www.eionet.europa.eu/gemet/concept/8695> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/641> ;
    skos:definition "The lowest of the concentric layers of the atmosphere, occurring between the Earth's surface and the tropopause. It is the zone where atmospheric turbulence is at its greatest and where the bulk of the Earth's weather is generated. It contains almost all the water vapour and aerosols and three-quarters of the total gaseous mass of the atmosphere. Throughout the troposphere temperature decreases with height at a mean rate of 6.5°C/km and the whole zone is capped by either an inversion of temperature or an isothermal layer at the tropopause."@en ;
    skos:prefLabel "troposphere"@en .

<http://www.eionet.europa.eu/gemet/concept/8696> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/632> ;
    skos:definition "Tropospheric ozone is a secondary pollutant formed from emissions of nitrogen oxides, non-methane volatile organic compounds and carbon monoxide. Ozone scars lung tissue, makes eyes sting and throats itch. It has been implicated as a contributor to forest dieback, damage to agricultural crops, etc."@en ;
    skos:prefLabel "tropospheric ozone"@en .

<http://www.eionet.europa.eu/gemet/concept/8701> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "A main road, especially one that is suitable for heavy vehicles."@en ;
    skos:prefLabel "trunk road"@en .

<http://www.eionet.europa.eu/gemet/concept/8703> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "Any new and abnormal growth, specifically one in which cell multiplication is uncontrolled and progressive."@en ;
    skos:prefLabel "tumour"@en .

<http://www.eionet.europa.eu/gemet/concept/8704> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "An area supporting some vegetation (lichens, mosses, sedges and low shrubs) between the northern upper limit of trees and the lower limit of perennial snow on mountains, and on the fringes of the Antarctic continent and its neighbouring islands."@en ;
    skos:prefLabel "tundra"@en .

<http://www.eionet.europa.eu/gemet/concept/8707> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A underground passageway, especially one for trains or cars that passes under a mountain, river or a congested urban area."@en ;
    skos:prefLabel "tunnel"@en .

<http://www.eionet.europa.eu/gemet/concept/8711> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "Cloudy or hazy appearance in a naturally clear liquid caused by a suspension of colloidal liquid droplets or fine solids."@en ;
    skos:prefLabel "turbidity"@en .

<http://www.eionet.europa.eu/gemet/concept/8713> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A fluid acceleration machine for generating rotary mechanical power from the energy in a stream of fluid."@en ;
    skos:prefLabel "turbine"@en .

<http://www.eionet.europa.eu/gemet/concept/8719> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8285> ;
    skos:definition "A sea-going vessel that includes space between two continuous floor-like surfaces or platforms, which is also designed for bulk shipments of liquids or gases."@en ;
    skos:prefLabel "tween-deck tanker"@en .

<http://www.eionet.europa.eu/gemet/concept/8720> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7654> ;
    skos:definition "Oil tank vessels provided with a double-hull to meet the regulatory safety requirements in oil transportation. Requirements include minimum values for depths and breadth of double bottoms. Also called double-hull tank vessel."@en ;
    skos:prefLabel "twin-hull craft"@en .

<http://www.eionet.europa.eu/gemet/concept/8721> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1582> ;
    skos:definition "An internal combustion engine whose cycle is completed in two strokes of the piston."@en ;
    skos:prefLabel "two-stroke engine"@en .

<http://www.eionet.europa.eu/gemet/concept/8723> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A class or category of interests or remedies recognized in law or equity that create in the holder a right to the interest or its proceeds, typically taking the form of money, property or privilege."@en ;
    skos:prefLabel "type of claim"@en .

<http://www.eionet.europa.eu/gemet/concept/8724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2498> ;
    skos:definition "The different, specific methods of business administration."@en ;
    skos:prefLabel "type of management"@en .

<http://www.eionet.europa.eu/gemet/concept/8727> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "A severe tropical cyclone in the western Pacific."@en ;
    skos:prefLabel "typhoon"@en .

<http://www.eionet.europa.eu/gemet/concept/8736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3190> ;
    skos:definition "Separation of colloidal or very fine solid materials by filtration through microporous or semipermeable mediums."@en ;
    skos:prefLabel "ultrafiltration"@en .

<http://www.eionet.europa.eu/gemet/concept/8739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7933> ;
    skos:definition "Sound waves having a frequency above about 20,000 hertz."@en ;
    skos:prefLabel "ultrasound"@en .

<http://www.eionet.europa.eu/gemet/concept/8742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491>,
        <http://www.eionet.europa.eu/gemet/concept/5674> ;
    skos:definition "The part of the electromagnetic spectrum with wavelengths shorter than light but longer than x-rays; in the range of 4-400 nm."@en ;
    skos:prefLabel "ultraviolet radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/8745> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8776> ;
    skos:definition "United Nations Conference on Environment and Development, Rio de Janeiro, Brazil, 1992."@en ;
    skos:prefLabel "UNCED"@en .

<http://www.eionet.europa.eu/gemet/concept/8747> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Place where waste is left on the ground and not buried in a hole."@en ;
    skos:prefLabel "uncontrolled dump"@en .

<http://www.eionet.europa.eu/gemet/concept/8755> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Sealing of a landfill with a relatively impermeable barrier designed to keep leachate inside. Liner materials include plastic and dense clay."@en ;
    skos:prefLabel "landfill base sealing"@en .

<http://www.eionet.europa.eu/gemet/concept/8758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Storage located underground designed to hold gasoline or other petroleum products or chemical solutions."@en ;
    skos:prefLabel "underground storage"@en .

<http://www.eionet.europa.eu/gemet/concept/8760> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6939> ;
    skos:definition "A train for transportation of people, mostly beneath the surface of the ground, in order to lessen the traffic."@en ;
    skos:prefLabel "underground train"@en .

<http://www.eionet.europa.eu/gemet/concept/8761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6861> ;
    skos:definition "A segment of the population that does not have access to the rights or benefits granted to the rest of society, often because of low economic or social status."@en ;
    skos:prefLabel "underprivileged people"@en .

<http://www.eionet.europa.eu/gemet/concept/8762> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "Any commercial activity, position or site associated with the preparation of the dead for burial and the management and arrangement of funerals."@en ;
    skos:prefLabel "undertaking business"@en .

<http://www.eionet.europa.eu/gemet/concept/8768> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2683> ;
    skos:definition "The condition of being without remunerative employment."@en ;
    skos:prefLabel "unemployment"@en .

<http://www.eionet.europa.eu/gemet/concept/878> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9043> ;
    skos:definition "Processes for removing impurities from waste gas based on the employing of microorganisms."@en ;
    skos:prefLabel "biological waste gas purification"@en .

<http://www.eionet.europa.eu/gemet/concept/8780> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6156> ;
    skos:definition "Petrol with a low octane rating, which has no lead additives in it and therefore creates less lead pollution in the atmosphere."@en ;
    skos:prefLabel "unleaded petrol"@en .

<http://www.eionet.europa.eu/gemet/concept/8782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Areas where significant reductions in ozone forming pollutants have been achieved through industrial initiatives to control and/or prevent pollution, through implementation of transportation improvement plans, national efforts to reduce automobile tailpipe emissions and lower the volatility (evaporation rate) of gasoline."@en ;
    skos:prefLabel "clean air area"@en .

<http://www.eionet.europa.eu/gemet/concept/8784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water that has not been treated."@en ;
    skos:prefLabel "raw water"@en .

<http://www.eionet.europa.eu/gemet/concept/8785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2547> ;
    skos:prefLabel "upbringing"@en .

<http://www.eionet.europa.eu/gemet/concept/8789> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6048> ;
    skos:definition "The body of a bicameral legislature comprising either representatives of member states in a federation or a select number of individuals from certain privileged estates or social classes."@en ;
    skos:prefLabel "Upper House"@en .

<http://www.eionet.europa.eu/gemet/concept/8791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/66> ;
    skos:definition "A metallic element highly toxic and radioactive; used as nuclear fuel."@en ;
    skos:prefLabel "uranium"@en .

<http://www.eionet.europa.eu/gemet/concept/880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9267> ;
    skos:definition "Living organisms (or infective material derived from them) which are intended to cause disease or death in animals, plants, or man, and which depend for their effects on their ability to multiply in the person, animal or plant attacked. Various living organisms (for example, rickettsiae, viruses and fungi), as well as bacteria, can be used as weapons."@en ;
    skos:prefLabel "biological weapon"@en .

<http://www.eionet.europa.eu/gemet/concept/8801> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Condition where part of a city or town becomes old or dirty or ruined, because businesses and wealthy families have moved away from it."@en ;
    skos:prefLabel "urban decay"@en .

<http://www.eionet.europa.eu/gemet/concept/8803> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2115>,
        <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "A plan, outline or preliminary sketch of, or for, a city or town."@en ;
    skos:prefLabel "urban design"@en .

<http://www.eionet.europa.eu/gemet/concept/8805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6290> ;
    skos:definition "A binding rule or body of rules prescribed by government to regulate public services and the competing claims of residential, commercial and industrial interests in municipal areas generally characterized by moderate to high population density."@en ;
    skos:prefLabel "urban development law"@en .

<http://www.eionet.europa.eu/gemet/concept/8807> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "Towns and cities viewed as ecosystems, having an input of matter and energy, recycling within the system, and an output of matter and energy into the surroundings."@en ;
    skos:prefLabel "urban ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/8811> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "Supply of essential services to the community, e.g. electricity, gas, water."@en ;
    skos:prefLabel "urban facility"@en .

<http://www.eionet.europa.eu/gemet/concept/8812> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:prefLabel "urban flows (resources)"@en .

<http://www.eionet.europa.eu/gemet/concept/882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "The production of light of various colors by living organisms (e.g. some bacteria and fungi, glow-worms and many marine animals). Luminescence is produced by a biochemical reaction, which is catalyzed by an enzyme. In some animals the light is used as a mating signal; in others it may be a protective device. In deep-sea forms luminous organs may serve as lanterns."@en ;
    skos:prefLabel "bioluminescence"@en .

<http://www.eionet.europa.eu/gemet/concept/8820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "The state of being or becoming a community with urban characteristics."@en ;
    skos:prefLabel "urbanisation"@en .

<http://www.eionet.europa.eu/gemet/concept/8824> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:definition "The traits, patterns and structure of a city's specific geographic area, including its biological composition, its physical environment and its social patterns."@en ;
    skos:prefLabel "urban landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/8826> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4065> ;
    skos:definition "The administration, organization and planning performed for cities or towns, particularly the process of converting farmland or undeveloped land into offices, businesses, housing and other forms of development."@en ;
    skos:prefLabel "urban management"@en .

<http://www.eionet.europa.eu/gemet/concept/8832> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which seeks to improve or develop cities or towns through land use planning, water resource management, central city development, policing and criminal justice, or pollution control."@en ;
    skos:prefLabel "urban policy"@en .

<http://www.eionet.europa.eu/gemet/concept/8833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2895> ;
    skos:definition "Pollution of highly populated areas mainly deriving from motor vehicles, industrial plants, combustion and heating plants, etc."@en ;
    skos:prefLabel "urban pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/8834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The total number of persons inhabiting a city, metropolitan region or any area where the sum of residents exceeds a designated amount."@en ;
    skos:prefLabel "urban population"@en .

<http://www.eionet.europa.eu/gemet/concept/8839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "A continuing process of remodelling urban areas by means of rehabilitation and conservation as well as redevelopment. Urban renewal programmes are generally undertaken by public authorities and concern those parts of the city which have fallen below current standards of public acceptability."@en ;
    skos:prefLabel "urban renewal"@en .

<http://www.eionet.europa.eu/gemet/concept/8840> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14717> ;
    skos:definition "The renovation or redevelopment of the decaying areas of cities by the demolition or up-grading of existing dwellings and buildings and a general improvement in environmental conditions."@en ;
    skos:prefLabel "urban sanitation"@en .

<http://www.eionet.europa.eu/gemet/concept/8843> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8141> ;
    skos:definition "A state of bodily or mental tension developed through city living, or the physical, chemical, or emotional factors that give rise to that tension."@en ;
    skos:prefLabel "urban stress"@en .

<http://www.eionet.europa.eu/gemet/concept/8844> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "The built-up components, the street system and the facilities which make up an urban unit."@en ;
    skos:prefLabel "urban structure"@en .

<http://www.eionet.europa.eu/gemet/concept/8845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "The study and theory of building and other physical needs in cities or predominantly urban cultures."@en ;
    skos:prefLabel "urban study"@en .

<http://www.eionet.europa.eu/gemet/concept/8847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7293> ;
    skos:definition "Movements of vehicles and people within a city."@en ;
    skos:prefLabel "urban traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/8850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1126> ;
    skos:definition "Water destined for private and public use in a town."@en ;
    skos:prefLabel "urban water"@en .

<http://www.eionet.europa.eu/gemet/concept/8852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9244> ;
    skos:definition "The distribution of water, including collection, treatment and storage, for use in a town, city or municipal area, and used generally for domestic and industrial needs."@en ;
    skos:prefLabel "urban water supply"@en .

<http://www.eionet.europa.eu/gemet/concept/8857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "A family of mammals in the order Carnivora including the bears and their allies."@en ;
    skos:prefLabel "ursid"@en .

<http://www.eionet.europa.eu/gemet/concept/8866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7483> ;
    skos:definition "Recyclable material from discarded motor vehicle tyres."@en ;
    skos:prefLabel "scrap tyre"@en .

<http://www.eionet.europa.eu/gemet/concept/8870> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4771> ;
    skos:definition "Making use of free time to carry out recreational activities."@en ;
    skos:prefLabel "use of leisure time"@en .

<http://www.eionet.europa.eu/gemet/concept/8872> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:prefLabel "user advantage"@en .

<http://www.eionet.europa.eu/gemet/concept/8875> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Calorific value is the heat per unit mass produced by complete combustion of a given substance. Calorific values are used to express the energy values of fuels; usually these are expressed in megajoules per kilogram. They are also used to measure the energy content of foodstuffs; i.e. the energy produced when the food is oxidized in the body. The units here are kilojoules per gram. Calorific values are measured using a bomb calorimeter (apparatus consisting of a strong container in which the sample is sealed with excess oxygen and ignited electrically. The heat of combustion at constant volume can be calculated from the resulting rise in temperature)."@en ;
    skos:prefLabel "utilisation of calorific value"@en .

<http://www.eionet.europa.eu/gemet/concept/8876> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "The use of a source of supply from a municipal or regional area, which can be readily drawn upon when needed."@en ;
    skos:prefLabel "local resource utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/8877> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Use of chemical or biological substances to deliberately kill unwanted plants or animals."@en ;
    skos:prefLabel "utilisation of pesticides"@en .

<http://www.eionet.europa.eu/gemet/concept/888> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6235> ;
    skos:definition "The hybrid science involving the application of physical principles and methods to study and explain the structures of living organisms and the mechanics of life processes."@en ;
    skos:prefLabel "biophysics"@en .

<http://www.eionet.europa.eu/gemet/concept/8886> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "A condition or extent of time in a government enforced contract, instrument or agreement that lacks precision, distinguishing characteristics or fixed boundaries."@en ;
    skos:prefLabel "indefinite legal concept"@en .

<http://www.eionet.europa.eu/gemet/concept/889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6977> ;
    skos:definition "A container, such as a large fermentation chamber, for growing living organisms that are used in the industrial production of substances such as pharmaceuticals, antibodies, or vaccines."@en ;
    skos:prefLabel "bioreactor"@en .

<http://www.eionet.europa.eu/gemet/concept/8892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "An appraised, evaluated or estimated element or ingredient of a biological community and its non-living environmental surroundings."@en ;
    skos:prefLabel "valued ecosystem component"@en .

<http://www.eionet.europa.eu/gemet/concept/8893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A silvery-white, ductile metal resistant to corrosion; used in alloy steels and as an x-ray target."@en ;
    skos:prefLabel "vanadium"@en .

<http://www.eionet.europa.eu/gemet/concept/8895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Species which have disappeared from an area because of adverse environmental conditions."@en ;
    skos:prefLabel "vanished species"@en .

<http://www.eionet.europa.eu/gemet/concept/8898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The partial pressure of water vapour in the atmosphere. For a liquid or solid, the pressure of the vapour in equilibrium with the liquid or solid."@en ;
    skos:prefLabel "vapour pressure"@en .

<http://www.eionet.europa.eu/gemet/concept/8899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6007> ;
    skos:definition "A transparent surface coating which is applied as a liquid and then changes to a hard solid; all varnishes are solutions of resinous materials in a solvent."@en ;
    skos:prefLabel "varnish"@en .

<http://www.eionet.europa.eu/gemet/concept/890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "A cyclically recurring pattern of physiological states in an organism or organ, such as alpha rhythm or circadian rhythm; believed by some to affect physical and mental states and behaviour."@en ;
    skos:prefLabel "biorhythm"@en .

<http://www.eionet.europa.eu/gemet/concept/8906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2947> ;
    skos:definition "An agent or organism that acts as a carrier or transmitter of a human illness."@en ;
    skos:prefLabel "vector of human diseases"@en .

<http://www.eionet.europa.eu/gemet/concept/8908> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Number of plants growing on a certain area of land."@en ;
    skos:prefLabel "vegetation cover"@en .

<http://www.eionet.europa.eu/gemet/concept/8909> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "Cultivation of herbaceous plants that are used as food."@en ;
    skos:prefLabel "vegetable cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/891> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "The combination of knowledge, techniques and equipment used to manage or contain potentially infectious materials or biohazards in the laboratory environment, to reduce or prevent harm to laboratory workers, other persons and the environment."@en ;
    skos:prefLabel "biosafety"@en .

<http://www.eionet.europa.eu/gemet/concept/8910> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10129> ;
    skos:definition "Study of the relationships between plants and their environment."@en ;
    skos:prefLabel "plant ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/8912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "The selection by man of particular genotypes in a plant population because they exhibit desired phenotypic characters."@en ;
    skos:prefLabel "plant selection"@en .

<http://www.eionet.europa.eu/gemet/concept/8913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "An edible, mixed glyceride oil derived from plants (fruit, leaves, and seeds), including cottonseed, linseed, tung, and peanut; used in food oils, shortenings, soaps, and medicine, and as a paint drying oil."@en ;
    skos:prefLabel "vegetable oil"@en .

<http://www.eionet.europa.eu/gemet/concept/8918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7120> ;
    skos:definition "Any of various processes, either sexual or asexual, by which a plant produces one or more individuals similar to itself."@en ;
    skos:prefLabel "plant reproduction"@en .

<http://www.eionet.europa.eu/gemet/concept/8921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste, comprised mainly of vegetable matter, which is capable of being decomposed by microorganisms."@en ;
    skos:prefLabel "vegetable waste"@en .

<http://www.eionet.europa.eu/gemet/concept/8931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4360> ;
    skos:definition "An official periodical examination of an automobile, truck, boat, airplane or other means of conveyance to determine compliance in design or operation with legal standards for safety or pollution emissions."@en ;
    skos:prefLabel "vehicle inspection"@en .

<http://www.eionet.europa.eu/gemet/concept/894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Protected land and coastal areas that are approved under the Man and Biosphere programme (MAB) in conjunction with the Convention on International Trade in Endangered Species (CITES). Each reserve has to have an ecosystem that is recognized for its diversity and usefulness as a conservation unit. The reserves have at least one core area where there can be no interference with the natural ecosystem. A transition zone surrounds this and within it scientific research is allowed. Beyond this is a buffer zone which protects the whole reserve from agricultural, industrial and urban development. Biosphere reserves and buffer zones were regarded as examples of a new generation of conservation techniques."@en ;
    skos:prefLabel "biosphere reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/8940> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The process of supplying or removing air, by natural or mechanical means, to or from any space; such air may or may not have been conditioned."@en ;
    skos:prefLabel "ventilation"@en .

<http://www.eionet.europa.eu/gemet/concept/8944> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450>,
        <http://www.eionet.europa.eu/gemet/concept/6138> ;
    skos:definition "Small animals and insects that can be harmful and which are difficult to control when they appear in large numbers."@en ;
    skos:prefLabel "vermin"@en .

<http://www.eionet.europa.eu/gemet/concept/8951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:definition "The branch of medical practice which treats of the diseases and injuries of animals."@en ;
    skos:prefLabel "veterinary medicine"@en .

<http://www.eionet.europa.eu/gemet/concept/8955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A long high bridge, usually held up by many arches, which carries a railway or a road over a valley or other similar area at a lower level."@en ;
    skos:prefLabel "viaduct"@en .

<http://www.eionet.europa.eu/gemet/concept/8964> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2284> ;
    skos:definition "A format or system used to record and transmit visual or audiovisual information by translating moving or still images into electrical signals."@en ;
    skos:prefLabel "video"@en .

<http://www.eionet.europa.eu/gemet/concept/8967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062>,
        <http://www.eionet.europa.eu/gemet/concept/7353> ;
    skos:definition "A group of houses and other buildings, such as a church, a school and some shops, which is smaller than a town, usually in the countryside."@en ;
    skos:prefLabel "village"@en .

<http://www.eionet.europa.eu/gemet/concept/8969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "The residual liquid from the distillation of alcoholic liquors, specifically, that remaining from the fermentation and distillation of beet-sugar molasses, valuable as yielding potassium salts, ammonia, etc."@en ;
    skos:prefLabel "vinasse"@en .

<http://www.eionet.europa.eu/gemet/concept/8974> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The study of submicroscopic organisms known as viruses."@en ;
    skos:prefLabel "virology"@en .

<http://www.eionet.europa.eu/gemet/concept/8977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "Energy dissipation and generation of stresses in a fluid by the distortion of fluid elements; quantitatively, when otherwise qualified, the absolute viscosity. Also known as flow resistance."@en ;
    skos:prefLabel "viscosity"@en .

<http://www.eionet.europa.eu/gemet/concept/8986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "An organic compound present in variable, minute quantities in natural foodstuffs and essential for the normal processes of growth and maintenance of the body."@en ;
    skos:prefLabel "vitamin"@en .

<http://www.eionet.europa.eu/gemet/concept/8987> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11170> ;
    skos:definition "That division of horticulture concerned with grape growing, studies of grape varieties, methods of culture, and insect and disease control."@en ;
    skos:prefLabel "viticulture"@en .

<http://www.eionet.europa.eu/gemet/concept/8990> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A list of words or phrases of a language, technical field or some specialized area, usually arranged in alphabetical order and often provided with brief definitions and with foreign translations."@en ;
    skos:prefLabel "vocabulary"@en .

<http://www.eionet.europa.eu/gemet/concept/8992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8607> ;
    skos:definition "A special training for a regular occupation or profession, especially, one for which one is specially suited or qualified."@en ;
    skos:prefLabel "vocational training"@en .

<http://www.eionet.europa.eu/gemet/concept/8993> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11794> ;
    skos:definition "Organic compound readily passing off by evaporation."@en ;
    skos:prefLabel "volatile organic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/8995> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The property of a substance or substances to convert into vapor or gas without chemical change."@en ;
    skos:prefLabel "volatility"@en .

<http://www.eionet.europa.eu/gemet/concept/8997> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:prefLabel "volcanic area"@en .

<http://www.eionet.europa.eu/gemet/concept/8999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9003> ;
    skos:definition "The ejection of solid, liquid, or gaseous material from a volcano."@en ;
    skos:prefLabel "volcanic eruption"@en .

<http://www.eionet.europa.eu/gemet/concept/90> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Substance used for sticking objects together, such as glue, cement, or paste."@en ;
    skos:prefLabel "adhesive"@en .

<http://www.eionet.europa.eu/gemet/concept/9004> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:definition "A vent in the surface of the Earth through which magma and associated gases and ash erupt; also, the form or structure, usually conical, that is produced by the ejected material."@en ;
    skos:prefLabel "volcano"@en .

<http://www.eionet.europa.eu/gemet/concept/9010> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7816> ;
    skos:definition "Unpaid activities done by citizens often organized in associations, to provide services to others, particularly to elderly and poor people, handicapped, etc."@en ;
    skos:prefLabel "voluntary work"@en .

<http://www.eionet.europa.eu/gemet/concept/9013> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "A chemical reaction of sulfur (or other vulcanizing agent) with rubber or plastic to cause cross-linking of the polymer chains; it increases strength and resiliency of the polymer."@en ;
    skos:prefLabel "vulcanisation"@en .

<http://www.eionet.europa.eu/gemet/concept/9015> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "Species which is likely to become endangered unless protective measures are taken."@en ;
    skos:prefLabel "vulnerable species  (IUCN)"@en .

<http://www.eionet.europa.eu/gemet/concept/9019> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5694> ;
    skos:definition "The Wadden sea is a shallow sea extending along the North Sea coasts of The Netherlands, Germany and Denmark. It is a highly dynamic ecosystem with tidal channels, sands, mud flats, salt marshes, beaches, dunes, river mouths and a transition zone to the North Sea, the offshore zone. Most parts of the Wadden Sea, in particular in The Netherlands and Lower Saxony, are sheltered by barrier islands and contain smaller or wider areas of intertidal flats. The present form of the Wadden Sea is the result of both natural forces and action by man. Twice a day, on average, 15 km3 of sea water enter the Wadden sea. With the water from the North Sea, large amount of sand and silt are imported which settle in places with little water movement. During low tides large parts of the Wadden Sea emerge. These so-called tidal flats cover about 2/3 of the tidal area and are one of its most characteristic features. Nowhere in the world can such a large unbroken stretch of tidal flats be found. They account for 60% of all tidal areas in Europe and North Africa."@en ;
    skos:prefLabel "Wadden Sea"@en .

<http://www.eionet.europa.eu/gemet/concept/902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/901> ;
    skos:definition "Intersection of corridors connecting patchy ecological communities. Species survival tends to be higher in patches that have higher connectivity."@en ;
    skos:prefLabel "biotope network"@en .

<http://www.eionet.europa.eu/gemet/concept/9022> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3149> ;
    skos:definition "System which compensates the employees with a fixed sum per piece, hour, day or another period of time, covering all compensations including salary."@en ;
    skos:prefLabel "wage system"@en .

<http://www.eionet.europa.eu/gemet/concept/9023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1033> ;
    skos:definition "A vertical construction made of stone, brick, wood, etc., with a length and height much greater than its thickness, used to enclose, divide or support."@en ;
    skos:prefLabel "wall"@en .

<http://www.eionet.europa.eu/gemet/concept/903> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "Measures taken to ensure that the biological and physical components of a biotope are in equilibrium by maintaining constant their relative numbers and features."@en ;
    skos:prefLabel "biotope protection"@en .

<http://www.eionet.europa.eu/gemet/concept/9032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Animal which has a body temperature that stays the same and does not change with the temperature of its surroundings."@en ;
    skos:prefLabel "warm-blooded animal"@en .

<http://www.eionet.europa.eu/gemet/concept/9034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2656> ;
    skos:definition "A scheme or method of acting developed in advance to notify as quickly as possible the affected population of any sudden, urgent and usually unexpected occurrence requiring immediate action."@en ;
    skos:prefLabel "warning plan"@en .

<http://www.eionet.europa.eu/gemet/concept/9040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1743> ;
    skos:definition "Extravagant or useless consumption or expenditures."@en ;
    skos:prefLabel "wastage"@en .

<http://www.eionet.europa.eu/gemet/concept/9042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3572> ;
    skos:definition "Exhaust or gaseous air given off by any industrial, manufacturing or chemical process."@en ;
    skos:prefLabel "waste air"@en .

<http://www.eionet.europa.eu/gemet/concept/9045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:prefLabel "waste assimilation capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/9048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9106> ;
    skos:definition "The inventory of all waste produced or recovered during a certain time period, classified by type and quantity."@en ;
    skos:prefLabel "waste balance"@en .

<http://www.eionet.europa.eu/gemet/concept/9049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2290> ;
    skos:definition "A container for litter, rubbish, etc."@en ;
    skos:prefLabel "waste bin"@en .

<http://www.eionet.europa.eu/gemet/concept/9052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Imposed fee, expense, or cost for the management of refuse or unwanted materials left over from a manufacturing process."@en ;
    skos:prefLabel "waste charge"@en .

<http://www.eionet.europa.eu/gemet/concept/9055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9054> ;
    skos:definition "The gathering and transporting of refuse from its place of origin."@en ;
    skos:prefLabel "waste collection at source"@en .

<http://www.eionet.europa.eu/gemet/concept/9057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "The component material types, by percentage or weight, emanating from any source."@en ;
    skos:prefLabel "waste composition"@en .

<http://www.eionet.europa.eu/gemet/concept/9058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "Any specialized procedure or method used to transform refuse from one state, form or chemical composition into another."@en ;
    skos:prefLabel "waste conversion technique"@en .

<http://www.eionet.europa.eu/gemet/concept/9059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The removal of gaseous components form waste."@en ;
    skos:prefLabel "waste degasification"@en .

<http://www.eionet.europa.eu/gemet/concept/9063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10026> ;
    skos:definition "Law that settles the rules concerning the disposal, recycling and treatment of wastes."@en ;
    skos:prefLabel "waste disposal act"@en .

<http://www.eionet.europa.eu/gemet/concept/9065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2796> ;
    skos:definition "The amount of money incurred for the action of removing or getting rid of refuse or unwanted materials left over from a manufacturing process."@en ;
    skos:prefLabel "waste disposal cost"@en .

<http://www.eionet.europa.eu/gemet/concept/9067> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2372> ;
    skos:definition "The planned discharge, deposit or burial of refuse or other unserviceable material into the surface of the earth, as in a landfill."@en ;
    skos:prefLabel "waste disposal in the ground"@en .

<http://www.eionet.europa.eu/gemet/concept/9068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Imposed fee, expense, or cost for the action of removing or getting rid of refuse or unwanted materials left over from a manufacturing process."@en ;
    skos:prefLabel "waste disposal charge"@en .

<http://www.eionet.europa.eu/gemet/concept/9069> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4621> ;
    skos:definition "Area where wastes are deposited and burned."@en ;
    skos:prefLabel "waste dump"@en .

<http://www.eionet.europa.eu/gemet/concept/9071> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "The disposal of solid wastes without environmental controls."@en ;
    skos:prefLabel "waste dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/9072> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "Exchange of the recyclable part of wastes. This procedure allows to minimize waste volume and the cost relating to waste disposal. The basis of waste exchange is the concept that \"one company's waste is another company's raw material\"."@en ;
    skos:prefLabel "waste exchange"@en .

<http://www.eionet.europa.eu/gemet/concept/9075> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9074> ;
    skos:definition "Heating plant where fuel is provided from refuse."@en ;
    skos:prefLabel "waste-fed heating plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9076> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9074> ;
    skos:definition "Power station that functions with refuse-derived fuel."@en ;
    skos:prefLabel "waste-fed power station"@en .

<http://www.eionet.europa.eu/gemet/concept/9078> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15183>,
        <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition "The direct or indirect discharge of exhaust gas into the atmosphere."@en ;
    skos:prefLabel "waste gas emission"@en .

<http://www.eionet.europa.eu/gemet/concept/9079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9044> ;
    skos:definition "Qualitative and quantitative analysis of exhaust gases emitted from vehicles, industrial plants, etc. in order to asses their composition."@en ;
    skos:prefLabel "waste gas examination"@en .

<http://www.eionet.europa.eu/gemet/concept/9080> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2670> ;
    skos:definition "Reduction of the quantity of gaseous emissions in the atmosphere, from motorvehicles, industrial and heating plants, etc. by the adoption of clean technologies, the effectiveness of process operations, the improvement of fuel quality and the installment of chimney stacks high enough to ensure the dispersion of gases."@en ;
    skos:prefLabel "waste gas reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/9082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded material from the glass manufacturing process or from used consumer products made of glass."@en ;
    skos:prefLabel "waste glass"@en .

<http://www.eionet.europa.eu/gemet/concept/9083> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1059> ;
    skos:definition "By-product of the wet limestone flue gas desulphurisation process."@en ;
    skos:prefLabel "waste gypsum"@en .

<http://www.eionet.europa.eu/gemet/concept/9085> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Heat derived from the cooling process of electric power generating plants and which can cause thermal pollution of water courses, promoting algal bloom."@en ;
    skos:prefLabel "waste heat"@en .

<http://www.eionet.europa.eu/gemet/concept/9086> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "The release of heat generated as a byproduct from industrial or power generation processes."@en ;
    skos:prefLabel "waste heat charge"@en .

<http://www.eionet.europa.eu/gemet/concept/9087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Waste heat applications include space heating and refrigeration in urban areas, thawing of ice-bound seaways, agricultural use to stimulate growth and to extend the growing season and in aquaculture to stimulate the growth of algae, shellfish, and other potential marine food sources."@en ;
    skos:prefLabel "waste heat utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/9088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4169> ;
    skos:definition "An authorization, license or equivalent control document issued by a government agency that approves bringing in refuse or unwanted materials left over from a manufacturing process from foreign countries."@en ;
    skos:prefLabel "waste importation permit"@en .

<http://www.eionet.europa.eu/gemet/concept/9090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4184> ;
    skos:definition "Establishment where waste is burnt."@en ;
    skos:prefLabel "waste incinerator"@en .

<http://www.eionet.europa.eu/gemet/concept/9095> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9008> ;
    skos:definition "Measures or techniques, including plans and directives, that reduce the amount of wastes generated. Examples of waste minimisation are environmentally-sound recycling and source reduction practices."@en ;
    skos:prefLabel "waste minimisation"@en .

<http://www.eionet.europa.eu/gemet/concept/9096> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The capability of measures or techniques that reduce the amount of refuse or unwanted materials that is generated, particularly during industrial production processes."@en ;
    skos:prefLabel "waste minimisation potential"@en .

<http://www.eionet.europa.eu/gemet/concept/9099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Newspapers, magazines, cartons and other paper separated from solid waste for the purpose of recycling."@en ;
    skos:prefLabel "waste paper"@en .

<http://www.eionet.europa.eu/gemet/concept/91> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The measurement of the amount of any chemical substance that can be safely consumed by a human being in a day. Calculations are usually based on the maximum level of a substance that can be fed to animals without producing any harmful effects. This is divided by a \"safety factor\" to allow for the differences between animals and humans and to take account of the variation in human diets."@en ;
    skos:prefLabel "acceptable daily intake"@en .

<http://www.eionet.europa.eu/gemet/concept/9103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "waste processing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/9105> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9125> ;
    skos:definition "The process of collecting and separating wastes in preparation for reuse."@en ;
    skos:prefLabel "waste reclamation"@en .

<http://www.eionet.europa.eu/gemet/concept/9107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7015> ;
    skos:definition "A method of recovering wastes as resources which includes the collection, and often involving the treatment, of waste products for use as a replacement of all or part of the raw material in a manufacturing process."@en ;
    skos:prefLabel "waste recycling"@en .

<http://www.eionet.europa.eu/gemet/concept/9110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "The aggregate of commercial enterprises primarily concerned with eliminating or getting rid of refuse from places of human or animal habitation or of unwanted materials left over from a manufacturing process."@en ;
    skos:prefLabel "waste removal industry"@en .

<http://www.eionet.europa.eu/gemet/concept/9118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Temporary holding of waste pending treatment or disposal. Storage methods include containers, tanks, waste piles, and surface impoundments."@en ;
    skos:prefLabel "waste storage"@en .

<http://www.eionet.europa.eu/gemet/concept/9119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3481> ;
    skos:definition "Transportation of wastes by means of special vehicles."@en ;
    skos:prefLabel "waste transport"@en .

<http://www.eionet.europa.eu/gemet/concept/9123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Place where waste material is treated to make it reusable or so it may be disposed of safely."@en ;
    skos:prefLabel "waste treatment plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9008> ;
    skos:definition "The total amount of refuse or unusable material produced at any source."@en ;
    skos:prefLabel "waste volume"@en .

<http://www.eionet.europa.eu/gemet/concept/9128> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3757> ;
    skos:definition "Imposed fee, expense, or cost for the management of spent or used water that contains dissolved or suspended matter from a home, community farm, or industry."@en ;
    skos:prefLabel "waste water charge"@en .

<http://www.eionet.europa.eu/gemet/concept/9129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9130> ;
    skos:definition "The flow of treated effluent from any wastewater treatment process."@en ;
    skos:prefLabel "waste water discharge"@en .

<http://www.eionet.europa.eu/gemet/concept/913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9321> ;
    skos:definition "Special area where birds are protected."@en ;
    skos:prefLabel "bird sanctuary"@en .

<http://www.eionet.europa.eu/gemet/concept/9132> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "Liquid or waterborne wastes polluted or fouled by commercial operations."@en ;
    skos:prefLabel "waste water from trade"@en .

<http://www.eionet.europa.eu/gemet/concept/9133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9091> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the outflow and disposal of spent or used water from a home, community, farm or industry that contains dissolved or suspended matter."@en ;
    skos:prefLabel "waste water legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/9135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6465> ;
    skos:definition "The amount of spent or used water, often containing dissolved and suspended matter, that is found in a stream or some other body of water."@en ;
    skos:prefLabel "waste water load"@en .

<http://www.eionet.europa.eu/gemet/concept/9136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6838>,
        <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "Processing of waste water for reuse."@en ;
    skos:prefLabel "waste water purification"@en .

<http://www.eionet.europa.eu/gemet/concept/9138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9214> ;
    skos:definition "The state or condition of spent or used water that contains dissolved or suspended matter from a home, community farm or industry."@en ;
    skos:prefLabel "waste water quality"@en .

<http://www.eionet.europa.eu/gemet/concept/9139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9143> ;
    skos:definition "The act or process of lessening the volume of used or spent water that is discharged from homes, businesses or industries."@en ;
    skos:prefLabel "waste water reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "Any of various carnivorous bird of the orders Falconiformes and Strigiformes which feed on meat taken by hunting."@en ;
    skos:prefLabel "bird of prey"@en .

<http://www.eionet.europa.eu/gemet/concept/9140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7632> ;
    skos:definition "The removed materials resulting from physical, biological and chemical treatment of waste water."@en ;
    skos:prefLabel "waste water sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/9141> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8077> ;
    skos:prefLabel "waste water statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/9147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "Study of the chemical, physical and biological properties of water."@en ;
    skos:prefLabel "water analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/9149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The amount of ingoing and outgoing water in a system, which are assumed to be equal in the long term so that the water budget will balance."@en ;
    skos:prefLabel "biological water balance"@en .

<http://www.eionet.europa.eu/gemet/concept/915> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10073> ;
    skos:definition "Any species of the warm-blooded vertebrates which make up the class Aves."@en ;
    skos:prefLabel "bird species"@en .

<http://www.eionet.europa.eu/gemet/concept/9153> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9151> ;
    skos:definition "The floor upon which any body of water rests."@en ;
    skos:prefLabel "water bottom"@en .

<http://www.eionet.europa.eu/gemet/concept/9157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The catching of water, especially rain water, in a structure such as a basin or reservoir."@en ;
    skos:prefLabel "water collection"@en .

<http://www.eionet.europa.eu/gemet/concept/9164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745>,
        <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:prefLabel "water demand"@en .

<http://www.eionet.europa.eu/gemet/concept/9168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2963> ;
    skos:definition "The breakdown of solid rock into smaller particles and its removal by water. As weathering, erosion is a natural geological process, but more rapid soil erosion results from poor land-use practices, leading to the loss of fertile topsoil and to the silting of dams, lakes, rivers and harbours. There are three classes of erosion by water. a) Splash erosion occurs when raindrops strike bare soil, causing it to splash, as mud, to flow into spaces in the soil and to turn the upper layer of soil into a structureless, compacted mass that dries with a hard, largely impermeable crust. b) Surface flow occurs when soil is removed with surface run-off during heavy rain. c) Channelized flow occurs when a flowing mixture of water and soil cuts a channel, which is then deepened by further scouring. A minor erosion channel is called a rill, a larger channel a gully."@en ;
    skos:prefLabel "water erosion"@en .

<http://www.eionet.europa.eu/gemet/concept/917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2056> ;
    skos:definition "Limitation of the number of children born by preventing or reducing the frequency of impregnation."@en ;
    skos:prefLabel "birth control"@en .

<http://www.eionet.europa.eu/gemet/concept/9170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7244> ;
    skos:definition "A perpendicular or steep descent of the water of a stream, as where it crosses an outcrop of resistant rock overhanging softer rock that has been eroded or flows over the edge of a plateau of cliffed coast."@en ;
    skos:prefLabel "waterfall"@en .

<http://www.eionet.europa.eu/gemet/concept/9171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1889> ;
    skos:definition "Fresh-water branchiopod crustaceans characterized by a transparent bivalve shell."@en ;
    skos:prefLabel "water flea"@en .

<http://www.eionet.europa.eu/gemet/concept/9176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water used in agriculture for irrigation and livestock. Livestock watering is only 1 percent of the total water withdrawal for agricultural use. Of all functional water uses, irrigation is the largest agricultural use of water."@en ;
    skos:prefLabel "water for agricultural use"@en .

<http://www.eionet.europa.eu/gemet/concept/9178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Consumptive water use starts with withdrawal, but in this case without any return, e.g. irrigation, steam escaping into the atmosphere, water contained in final products, i.e. it is no longer available directly for subsequent use."@en ;
    skos:prefLabel "water for consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/9183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "Aquatic birds which constitute the order Anseriformes, including the swans, ducks, geese, and screamers."@en ;
    skos:prefLabel "waterfowl"@en .

<http://www.eionet.europa.eu/gemet/concept/9184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "The amount of calcium and magnesium salts dissolved in water."@en ;
    skos:prefLabel "water hardness"@en .

<http://www.eionet.europa.eu/gemet/concept/9186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3313> ;
    skos:definition "Floating aquatic plant, Eichornia crassipes of tropical America, having showy bluish-purple flowers and swollen leafstalks: family Pontederiaceae. It forms dense masses in rivers, ponds, etc., and is a serious pest in the southern U.S., Java, Australia, New Zealand, and parts of Africa."@en ;
    skos:prefLabel "water hyacinth"@en .

<http://www.eionet.europa.eu/gemet/concept/9190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The level reached by the surface of a body of water."@en ;
    skos:prefLabel "water level"@en .

<http://www.eionet.europa.eu/gemet/concept/9193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7345> ;
    skos:definition "Waterlogging is an effect of canal irrigation; it occurs when the water table rises to within 3 meters of a crop's roots, impeding their ability to absorb oxygen and ultimately compromising crop yields. Many factors contribute to waterlogging. These include inadequate drainage, improper balance in the use of groundwater and surface water, seepage and percolation from unlined channels, overwatering, planting crops not suited to specific soils, and inadequate preparation of land before irrigation."@en ;
    skos:prefLabel "waterlogged land"@en .

<http://www.eionet.europa.eu/gemet/concept/9199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "A chemical or physical agent introduced to any body of water that may detrimentally alter the natural condition of that body of water and other associated bodies of water."@en ;
    skos:prefLabel "water pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/9203> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10049> ;
    skos:definition "Precautionary measures, actions or installations implemented to avert or hinder human-made or human-induced alteration of the physical, biological, chemical and radiological integrity of water."@en ;
    skos:prefLabel "water pollution prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/9207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15330>,
        <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:prefLabel "water protection directive"@en .

<http://www.eionet.europa.eu/gemet/concept/9208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2862> ;
    skos:prefLabel "water protection legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/9209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6831> ;
    skos:definition "A machine or apparatus used to lift water, usually from a well or borehole, which is powered manually or by engine, wind or some other source."@en ;
    skos:prefLabel "water pump"@en .

<http://www.eionet.europa.eu/gemet/concept/921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7298> ;
    skos:definition "A generic term applied to natural inflammable substances of variable colour, hardness, and volatility, composed principally of a mixture of hydrocarbons substantially free from oxygenated bodies. Bitumens are sometimes associated with mineral matter, the nonmineral constituents being fusible and largely soluble in carbon disulfide, yielding water-insoluble sulfonation products. Petroleum, asphalts, natural mineral waxes, and asphaltites are all considered bitumens."@en ;
    skos:prefLabel "bitumen"@en .

<http://www.eionet.europa.eu/gemet/concept/9210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "Any of several processes in which undesirable impurities in water are removed or neutralized."@en ;
    skos:prefLabel "water purification"@en .

<http://www.eionet.europa.eu/gemet/concept/9211> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6842> ;
    skos:definition "Plant where water, through physical and chemical processes, is made suitable for human consumption and other purposes."@en ;
    skos:prefLabel "water purification plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9215> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15330>,
        <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "EC Directive establishing the rules relating to water for human consumption."@en ;
    skos:prefLabel "water quality directive"@en .

<http://www.eionet.europa.eu/gemet/concept/9217> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "The administration or handling of the amount of available potable water."@en ;
    skos:prefLabel "water quantity management"@en .

<http://www.eionet.europa.eu/gemet/concept/9220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/661> ;
    skos:definition "The power of a government agency or its administrators to administer and implement regulations, laws and government policies relating to the preservation and protection of water resources."@en ;
    skos:prefLabel "water regulatory authority"@en .

<http://www.eionet.europa.eu/gemet/concept/9223> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7170> ;
    skos:definition "Controlled utilization or protection of any supply of water so that it is potentially useful for some purpose, such as for an economic, recreational or life-sustaining purpose."@en ;
    skos:prefLabel "water resources conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/9225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:prefLabel "water resources development"@en .

<http://www.eionet.europa.eu/gemet/concept/9227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Use of process wastewater or treatment facility effluent in a different manufacturing process."@en ;
    skos:prefLabel "water reuse"@en .

<http://www.eionet.europa.eu/gemet/concept/9229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7376> ;
    skos:definition "Process by which water becomes more salty, found especially in hot countries where irrigation is practised."@en ;
    skos:prefLabel "water salination"@en .

<http://www.eionet.europa.eu/gemet/concept/9230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745>,
        <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "Management of water resources aiming at ensuring the continued availability of water for human uses and natural ecosystems."@en ;
    skos:prefLabel "water saving"@en .

<http://www.eionet.europa.eu/gemet/concept/9234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "Use, regulation and treatment of water and land resources of a watershed to accomplish stated objectives."@en ;
    skos:prefLabel "watershed management"@en .

<http://www.eionet.europa.eu/gemet/concept/9235> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "The dividing line between two adjacent river systems, such as a ridge."@en ;
    skos:prefLabel "watershed"@en .

<http://www.eionet.europa.eu/gemet/concept/9241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:prefLabel "water statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/9251> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "Three types of water use are distinguished: a) withdrawal, where water is taken from a river, or surface or underground reservoir, and after use returned to a natural water body, e.g. water used for cooling in industrial processes. Such return flows are particularly important for downstream users in the case of water taken from rivers; b) consumptive, which starts with withdrawal but in this case without any return, e.g. irrigation, steam escaping into the atmosphere, water contained in final products, i.e. it is no longer available directly for subsequent uses; c) non-withdrawal, i.e. the in situ use of a water body for navigation (including the floating of logs by the lumber industry), fishing, recreation, effluent disposal and hydroelectric power generation."@en ;
    skos:prefLabel "water utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/9255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9290> ;
    skos:definition "A well sunk to extract water from a zone of saturation."@en ;
    skos:prefLabel "water well"@en .

<http://www.eionet.europa.eu/gemet/concept/9257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Plant for treating and purifying water before it is pumped into pipes for distribution to houses, factories, schools, etc."@en ;
    skos:prefLabel "waterworks"@en .

<http://www.eionet.europa.eu/gemet/concept/926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1500> ;
    skos:definition "A natural black graphitelike material used as a fuel, formed from fossilized plants and consisting of amorphous carbon with various organic and some inorganic compounds."@en ;
    skos:prefLabel "black coal"@en .

<http://www.eionet.europa.eu/gemet/concept/9276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The periodic or continuous surveillance or analysis of the state of the atmosphere and climate, including variables such as temperature, moisture, wind velocity and barometric pressure."@en ;
    skos:prefLabel "weather monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/9278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5194> ;
    skos:definition "The act or process of predicting and highlighting meteorological conditions that are expected for a specific time period and for a specific area or portion of air space, by using objective models based on certain atmospheric parameters, along with the skill and experience of a meteorologist."@en ;
    skos:prefLabel "weather forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/9280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/212> ;
    skos:definition "Any plant that grows wild and profusely, especially one that grows among cultivated plants, depriving them of space, food, etc."@en ;
    skos:prefLabel "weed"@en .

<http://www.eionet.europa.eu/gemet/concept/9281> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6139> ;
    skos:definition "Freeing an area of land from weeds by several means, such as herbicides, tillage, burning, mowing, and crop competition."@en ;
    skos:prefLabel "weed control"@en .

<http://www.eionet.europa.eu/gemet/concept/9286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The gravitational force with which the earth attracts a body. By extension, the gravitational force with which a star, planet, or satellite attracts a nearby body."@en ;
    skos:prefLabel "weight"@en .

<http://www.eionet.europa.eu/gemet/concept/9289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Joining two metals by applying heat to melt and fuse them, with or without filler metal."@en ;
    skos:prefLabel "welding"@en .

<http://www.eionet.europa.eu/gemet/concept/9293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/170> ;
    skos:definition "A geographic region of the African continent bordered in the west and south by the Atlantic Ocean, including the republics of Benin, Burkina Faso, Cabo Verde, Cote D'ivoire, Gambie, Ghana, Guinee Bissau, Liberia, Mali, Mauritanie, Niger, Nigeria, Sengegal, Sierra Leone and Togo."@en ;
    skos:prefLabel "West Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/9295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2992> ;
    skos:definition "A geographic region of the European continent surrounded by the North Sea, Atlantic Ocean and the Mediterranean Sea, including Belgium, France, Germany, Great Britain, Greece, Italy, Luxembourg, Netherlands, Portugal, Spain and other member countries of the Western European Union."@en ;
    skos:prefLabel "Western Europe"@en .

<http://www.eionet.europa.eu/gemet/concept/9298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "Ecosystems of areas largely inundated with water but offering elevated lands as a habitat for wildlife. This areas include swamps, both seasonal and permanent, marsh, open fresh water, shallow saline lagoons, the estuaries of rivers, floodplains and coastal sand dunes. They provide food, breeding grounds, water and sanctuary for many forms of fish, birds and other animal and plant life. They are among the most productive ecosystems producing timber, peat moss and crops such as rice and a variety of berries."@en ;
    skos:prefLabel "wetlands ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/9299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Process used to remove particulate matter and/or gaseous pollutants by means of an aqueous stream or slurry."@en ;
    skos:prefLabel "wet process"@en .

<http://www.eionet.europa.eu/gemet/concept/930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3538> ;
    skos:definition "A tall, cylindrical smelting furnace for reducing iron ore to pig iron; the blast of air blown through solid fuel increases the combustion rate."@en ;
    skos:prefLabel "blast furnace"@en .

<http://www.eionet.europa.eu/gemet/concept/9300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6447> ;
    skos:definition """1) An air cleaning device that literally washes out the dust. Exhaust air is forced into a spray chamber, where fine water particles cause the dust to drop from the air stream. The dust-ladden water is then treated to remove the solid material and is often recirculated.
2) Equipment through which a gas is passed to remove impurities (solid, liquid, or gaseous particles) by intimate contact with a suitable liquid, usually an aqueous medium."""@en ;
    skos:prefLabel "wet scrubber"@en .

<http://www.eionet.europa.eu/gemet/concept/9301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Organic refuse or material left over from a manufacturing process, which is characterized by the presence of moisture."@en ;
    skos:prefLabel "wet waste"@en .

<http://www.eionet.europa.eu/gemet/concept/9302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1275> ;
    skos:definition "Large marine mammals of the order Cetacea; the body is streamlined, the broad flat tail is used for propulsion, and the limbs are balancing structures."@en ;
    skos:prefLabel "whale"@en .

<http://www.eionet.europa.eu/gemet/concept/9305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5035> ;
    skos:definition "Catching whales to use as food or for their oil, etc. Whales are the largest mammals still in existence. They are caught mainly for their oils, though in some case for food. Some species of whale have become extinct because of overexploitation and the population of many of the existing species is dangerously low. Commercial whaling is severely restricted."@en ;
    skos:prefLabel "whaling"@en .

<http://www.eionet.europa.eu/gemet/concept/9308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The business of selling goods to retailers in larger quantities than they are sold to final consumers but in smaller quantities than they are purchased from manufacturers."@en ;
    skos:prefLabel "wholesale trade"@en .

<http://www.eionet.europa.eu/gemet/concept/9310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Not domesticated animals living independently of man."@en ;
    skos:prefLabel "wild animal"@en .

<http://www.eionet.europa.eu/gemet/concept/9313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Animals and plants that grow independently of people, usually in natural conditions."@en ;
    skos:prefLabel "wildlife"@en .

<http://www.eionet.europa.eu/gemet/concept/9314> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "A series of measures required to maintain or restore the natural habitats and the populations of species of wild fauna and flora at a favourable status."@en ;
    skos:prefLabel "wildlife conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/9315> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3808> ;
    skos:definition "Suitable upland or wetland areas promoting survival of wildlife."@en ;
    skos:prefLabel "wildlife habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/9318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2926> ;
    skos:definition "The numerical facts or data collected through various methodologies, such as sighting surveys, which represent or estimate the size of any wildlife species for purposes such as analyzing population trends."@en ;
    skos:prefLabel "wildlife population statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/9322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/767> ;
    skos:definition "A state of nature or a quality or state of being undomesticated, untamed or uncultivated."@en ;
    skos:prefLabel "running wild"@en .

<http://www.eionet.europa.eu/gemet/concept/9323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants growing in a natural state (not cultivated)."@en ;
    skos:prefLabel "wild plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9324> ;
    skos:prefLabel "willingness-to-pay analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/9327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "The motion of air relative to the earth's surface; usually means horizontal air motion, as distinguished from vertical motion."@en ;
    skos:prefLabel "wind"@en .

<http://www.eionet.europa.eu/gemet/concept/933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/932> ;
    skos:definition "Clay capable of chemically adsorbing oils, insecticides, alkaloids, vitamins, carbohydrates and other materials; it is used for refining and decolorizing mineral and vegetable oils."@en ;
    skos:prefLabel "bleaching clay"@en .

<http://www.eionet.europa.eu/gemet/concept/9330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2963> ;
    skos:definition "The breakdown of solid rock into smaller particles and its removal by wind. It may occur on any soil whose surface is dry, unprotected by vegetation (to bind it at root level and shelter the surface) and consists of light particles. The mechanisms include straightforward picking up of dust and soil particles by the airflow and the dislodging or abrasion of surface material by the impact of particles already airborne."@en ;
    skos:prefLabel "wind erosion"@en .

<http://www.eionet.europa.eu/gemet/concept/9331> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5258> ;
    skos:definition "A machine for grinding or pumping driven by a set of adjustable vanes or sails that are caused to turn by the force of the wind."@en ;
    skos:prefLabel "windmill"@en .

<http://www.eionet.europa.eu/gemet/concept/9335> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "Energy extracted from wind, traditionally in a windmill, but increasingly by more complicated designes including turbines, usually to produce electricity but also for water pumping. The power available from wind is proportional to the area swept by the rotating place and the cube of the wind velocity, but less than half the available power can be recovered."@en ;
    skos:prefLabel "wind power"@en .

<http://www.eionet.europa.eu/gemet/concept/9336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2606> ;
    skos:definition "Power station which uses wind to drive a turbine which creates electricity."@en ;
    skos:prefLabel "wind power station"@en .

<http://www.eionet.europa.eu/gemet/concept/934> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition """1) Removing colored components from a textile. Common bleaches are hydrogen peroxide, sodium hypochloride, and sodium chlorite. 
2) The brightening and delignification of pulp by the addition of oxidizing chemicals such as chlorine or reducing chemicals such as sodium hypochloride."""@en ;
    skos:prefLabel "bleaching process"@en .

<http://www.eionet.europa.eu/gemet/concept/9344> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:definition "An adult human female."@en ;
    skos:prefLabel "woman"@en .

<http://www.eionet.europa.eu/gemet/concept/9347> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3611> ;
    skos:definition "The social position, rank or relative importance of women in society."@en ;
    skos:prefLabel "woman's status"@en .

<http://www.eionet.europa.eu/gemet/concept/9348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3432> ;
    skos:definition "A wood, especially when regarded as a construction material."@en ;
    skos:prefLabel "timber"@en .

<http://www.eionet.europa.eu/gemet/concept/935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8494> ;
    skos:definition "A fluid connective tissue consisting of the plasma and cells that circulate in the blood vessels."@en ;
    skos:prefLabel "blood (tissue)"@en .

<http://www.eionet.europa.eu/gemet/concept/9352> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2036> ;
    skos:definition "The permanent clear-felling of an area of forest or woodland. On steep slopes this can lead to severe soil erosion, especially where heavy seasonal rains or the melting of snow at higher levels cause sudden heavy flows of water. In the humid tropics it may also lead to a release of carbon dioxide from the soil."@en ;
    skos:prefLabel "woodland clearance"@en .

<http://www.eionet.europa.eu/gemet/concept/9353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in wooded areas or land areas covered with trees and shrubs."@en ;
    skos:prefLabel "woodland ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/9356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The use of chemicals to prevent or retard the decay of wood, especially by fungi or insects; widely used preservatives include creosote, pitch, sodium fluoride and tar; especially used on wood having contact with the ground."@en ;
    skos:prefLabel "wood preservation"@en .

<http://www.eionet.europa.eu/gemet/concept/9362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste which is left over after the processing of raw timber."@en ;
    skos:prefLabel "wood waste"@en .

<http://www.eionet.europa.eu/gemet/concept/9363> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/451> ;
    skos:definition "A textile fiber made from raw wool characterized by absorbency, resiliency and insulation."@en ;
    skos:prefLabel "wool"@en .

<http://www.eionet.europa.eu/gemet/concept/9366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25> ;
    skos:definition "Accident occurring in the course of the employment and caused by inherent or related factors arising from the operation of materials of one's occupation."@en ;
    skos:prefLabel "work accident"@en .

<http://www.eionet.europa.eu/gemet/concept/9367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3032> ;
    skos:definition "A mine where all the mineral that could be profitably exploited has been removed."@en ;
    skos:prefLabel "worked-out open cut"@en .

<http://www.eionet.europa.eu/gemet/concept/9371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10837> ;
    skos:definition "The time devoted to gainful employment or job-related activities, usually calculated as hours per day or per week."@en ;
    skos:prefLabel "working hours"@en .

<http://www.eionet.europa.eu/gemet/concept/9375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:definition "Any or all locations or environments where people are employed."@en ;
    skos:prefLabel "workplace"@en .

<http://www.eionet.europa.eu/gemet/concept/9382> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Sites of great cultural significance and geographic areas of outstanding universal value. They include the Pyramids of Egypt, the Grand Canyon of United States, the Taj Mahal of India, the Great Wall of China, etc."@en ;
    skos:prefLabel "world heritage site"@en .

<http://www.eionet.europa.eu/gemet/concept/9389> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13260> ;
    skos:definition "Accounting procedure that is used when an asset is uncollectible and is therefore charged-off as a loss."@en ;
    skos:prefLabel "write-off"@en .

<http://www.eionet.europa.eu/gemet/concept/939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6646> ;
    skos:definition "Microorganisms, formerly classified as algae but now regarded as bacteria, including nostoc, which contain a blue pigment in addition to chlorophyll."@en ;
    skos:prefLabel "blue-green alga"@en .

<http://www.eionet.europa.eu/gemet/concept/9392> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9391> ;
    skos:definition "A deed performed by a government official or agent in exercise of police, constitutional, legislative, administrative or judicial powers that infringes upon the rights of another and causes damage, without protecting an equal or superior right."@en ;
    skos:prefLabel "wrongful government act"@en .

<http://www.eionet.europa.eu/gemet/concept/9395> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "A substance which would not normally be found in a given environment, and usually means a toxic chemical which is entirely artificial, such as a chlorinated aromatic compound or an organomercury compound."@en ;
    skos:prefLabel "xenobiotic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/9398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4491> ;
    skos:definition "A penetrating electromagnetic radiation, usually generated by accelerating electrons to high velocity and suddenly stopping them by collision with a solid body, or by inner-shell transitions of atoms with atomic number greater than 10; their wavelength ranges from about 10(-5) angstrom to 10(3) angstroms, the average wavelength used in research being 1 angstrom."@en ;
    skos:prefLabel "X-ray"@en .

<http://www.eionet.europa.eu/gemet/concept/9403> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3528> ;
    skos:definition "Many species of unicellular fungi, most of which belong to the Ascomycetes and reproduce by budding. The genus Saccharomyces is used in brewing and winemaking because in low oxygen concentration it produces zymase, an enzyme system that breaks down sugars to alcohol and carbon dioxide. Saccharomyces is also used in bread-making. Some yeasts are used as a source of protein and of vitamins of the B group."@en ;
    skos:prefLabel "yeast"@en .

<http://www.eionet.europa.eu/gemet/concept/9404> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "Profit or income created through an investment or a business transaction."@en ;
    skos:prefLabel "yield (economy)"@en .

<http://www.eionet.europa.eu/gemet/concept/9406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1350> ;
    skos:definition "A young child in the first years of life."@en ;
    skos:prefLabel "infant"@en .

<http://www.eionet.europa.eu/gemet/concept/9407> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/173> ;
    skos:definition "The state of being young; the period between childhood and adult age."@en ;
    skos:prefLabel "youth"@en .

<http://www.eionet.europa.eu/gemet/concept/9409> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9369> ;
    skos:definition "Job opportunities and employment for adolescents, either for financial reward or educational enrichment."@en ;
    skos:prefLabel "youth work"@en .

<http://www.eionet.europa.eu/gemet/concept/9412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A brittle bluish-white metallic element that becomes coated with a corrosion-resistant layer in moist air and occurs chiefly in sphalerite and smithsonite. It is a constituent of several alloys, especially brass and nickel-silver, and is used in die-casting, galvanizing metals, and in battery electrodes."@en ;
    skos:prefLabel "zinc"@en .

<http://www.eionet.europa.eu/gemet/concept/9422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Area in which animals, especially wild animals, are kept so that people can go and look at them, or study them."@en ;
    skos:prefLabel "zoological garden"@en .

<http://www.eionet.europa.eu/gemet/concept/945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "To travel or go in a boat as a form of recreation."@en ;
    skos:prefLabel "boating"@en .

<http://www.eionet.europa.eu/gemet/concept/947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The amount of oxygen used for biochemical oxidation by a unit volume of water at a given temperature and for a given time. BOD is an index of the degree of organic pollution in water."@en ;
    skos:prefLabel "biochemical oxygen demand"@en .

<http://www.eionet.europa.eu/gemet/concept/953> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "An enclosed vessel in which water is heated and circulated, either as hot water or as steam, for heating or power."@en ;
    skos:prefLabel "boiler"@en .

<http://www.eionet.europa.eu/gemet/concept/954> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "The temperature at which the transition from the liquid to the gaseous phase occurs in a pure substance at fixed pressure."@en ;
    skos:prefLabel "boiling point"@en .

<http://www.eionet.europa.eu/gemet/concept/959> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A collection of leaves of paper, parchment or other material, usually bound or fastened together within covers, containing writing of any type or blank pages for future inscription."@en ;
    skos:prefLabel "book"@en .

<http://www.eionet.europa.eu/gemet/concept/965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2638> ;
    skos:definition "A very hard almost colourless crystalline metalloid element that in impure form exists as a brown amorphous powder. It occurs principally in borax and is used in hardening steel."@en ;
    skos:prefLabel "boron"@en .

<http://www.eionet.europa.eu/gemet/concept/969> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "A place in which plants are grown, studied and exhibited."@en ;
    skos:prefLabel "botanical garden"@en .

<http://www.eionet.europa.eu/gemet/concept/975> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Crossing of a state border."@en ;
    skos:prefLabel "boundary crossing"@en .

<http://www.eionet.europa.eu/gemet/concept/976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/627> ;
    skos:definition "The layer of fluid adjacent to a physical boundary in which the fluid motion is significantly affected by the boundary and has a mean velocity less than the free stream value."@en ;
    skos:prefLabel "boundary layer"@en .

<http://www.eionet.europa.eu/gemet/concept/984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water, salty between the concentrations of fresh water and sea water; usually 5-10 parts x thousand."@en ;
    skos:prefLabel "brackish water"@en .

<http://www.eionet.europa.eu/gemet/concept/986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7575> ;
    skos:definition "A long-continued, extremely slow vertical instability of the crust, as in the volcanic district west of Naples, Italy, where the Phlegraean bradyseism has involved up-and-down movements between 6 m below sea level and 6 m above over a period of more than 2.000 years."@en ;
    skos:prefLabel "bradyseism"@en .

<http://www.eionet.europa.eu/gemet/concept/992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Milk from the breast for feeding babies."@en ;
    skos:prefLabel "breast milk"@en .

<http://www.eionet.europa.eu/gemet/concept/995> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/912> ;
    skos:definition "The individuals in a bird population that are involved in reproduction during a particular period in a given place."@en ;
    skos:prefLabel "breeding bird"@en .

<http://www.eionet.europa.eu/gemet/concept/997> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/783> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and marketing of beverages made from malt and hops by steeping, boiling and fermentation, such as beer, ale and other related beverages."@en ;
    skos:prefLabel "brewing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/998> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "A building material usually made from clay, molded as a rectangular block, and baked or burned in a kiln."@en ;
    skos:prefLabel "brick"@en .

<http://www.eionet.europa.eu/gemet/concept/100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "Any governmental agency or organization charged with managing and implementing regulations, laws and government policies."@en ;
    skos:prefLabel "administrative body"@en .

<http://www.eionet.europa.eu/gemet/concept/10049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2914> ;
    skos:definition "Eliminating the production of hazardous wastes and greenhouse gases at their source, within the production process. This can often be achieved through a variety of relatively simple strategies, including minor changes in manufacturing processes, substitution of non-polluting products for polluting products, and simplification of packaging. Companies practicing waste reduction have saved hundreds of millions of dollars, and used it to catalyze employee involvement and eliminate the need for expensive end-of-the-pipe filtering."@en ;
    skos:prefLabel "pollution prevention"@en .

<http://www.eionet.europa.eu/gemet/concept/10058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "The administration or handling of water naturally open to the atmosphere (rivers, lakes, reservoirs, ponds, streams, seas, etc.)."@en ;
    skos:prefLabel "surface water management"@en .

<http://www.eionet.europa.eu/gemet/concept/10088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:prefLabel "measuring instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/10166> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "The material surroundings of a system, process or organism."@en ;
    skos:prefLabel "physical environment"@en .

<http://www.eionet.europa.eu/gemet/concept/1023> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "Any plant of the division Bryophyta, having stems and leaves but lacking true vascular tissue and roots and reproducing by spores: includes the mosses and liverworts."@en ;
    skos:prefLabel "bryophyte"@en .

<http://www.eionet.europa.eu/gemet/concept/10238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10032> ;
    skos:definition "A form of environmental management designed to allay the progressive degradation of the land by coastal erosion processes. Sea defence works can be undertaken to protect the land from erosion and encroachment by the sea and against flooding. These involve engineering solutions such as groynes, sea walls, bulkheads, revetments and breakwaters."@en ;
    skos:prefLabel "coast protection"@en .

<http://www.eionet.europa.eu/gemet/concept/10244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Area which is officially registered because of its unique features; a description is provided concerning its location, size, latitude, longitude, orientation, elevation, boundaries, wildlife, hydrological and soil characteristics, etc."@en ;
    skos:prefLabel "registered site"@en .

<http://www.eionet.europa.eu/gemet/concept/1025> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "A balance sheet or statement of estimated receipts and expenditures. A plan for the coordination of resource and expenditures. The amount of money that is available for, required for, or assigned to a particular purpose."@en ;
    skos:prefLabel "budget"@en .

<http://www.eionet.europa.eu/gemet/concept/1049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:prefLabel "building regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/10548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7120> ;
    skos:definition "Any of various processes, either sexual or asexual, by which an animal produces one or more individuals similar to itself."@en ;
    skos:prefLabel "animal reproduction"@en .

<http://www.eionet.europa.eu/gemet/concept/10660> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7097> ;
    skos:definition "Animals which have been translocated by human agency into lands or waters where they have not lived previously, at least during historic times. Such translocation of species always involves an element of risk if not of serious danger. Newly arrived species, depending on their interspecific relationships and characteristics, may act as or carry parasites or diseases, prey upon native organisms, display toxic reactions, or be highly competitive with or otherwise adversely affect native species and communities."@en ;
    skos:prefLabel "introduction of animal species"@en .

<http://www.eionet.europa.eu/gemet/concept/10661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7097> ;
    skos:definition "Plants which have been translocated by human agency into lands or waters where they have not lived previously, at least during historic times. Such translocation of species always involves an element of risk if not of serious danger. Newly arrived species may be highly competitive with or otherwise adversely affect native species and communities. Some may become a nuisance through sheer overabundance. They may become liable to rapid genetic changes in their new environment. Many harmful introductions have been made by persons unqualified to anticipate the often complex ecological interaction which may ensue. On the other hand many plants introduced into modified or degraded environments may be more useful than native species in controlling erosion or in performing other positive functions."@en ;
    skos:prefLabel "introduction of plant species"@en .

<http://www.eionet.europa.eu/gemet/concept/10670> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10064> ;
    skos:prefLabel "protection of animals"@en .

<http://www.eionet.europa.eu/gemet/concept/10704> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:prefLabel "nursery garden"@en .

<http://www.eionet.europa.eu/gemet/concept/10847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "A building containing a swimming pool and a large room or other places where you can play sports."@en ;
    skos:prefLabel "leisure centre"@en .

<http://www.eionet.europa.eu/gemet/concept/10931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The total of economic assets, including both physical or storable objects and intangible acts of human assistance."@en ;
    skos:prefLabel "goods and services"@en .

<http://www.eionet.europa.eu/gemet/concept/10936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6663> ;
    skos:definition "A mark, seal or written identification attached or affixed to products that provides specific ecological information allowing consumers to make comparisons with other similar products, or instructions on how to safely use or properly recycle or dispose of both products and packaging."@en ;
    skos:prefLabel "ecolabel"@en .

<http://www.eionet.europa.eu/gemet/concept/1114> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8412> ;
    skos:definition "To mark the scale of a measuring instrument so that readings can be made in appropriate units."@en ;
    skos:prefLabel "calibration"@en .

<http://www.eionet.europa.eu/gemet/concept/11192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "The raising, keeping, and care of birds."@en ;
    skos:prefLabel "aviculture"@en .

<http://www.eionet.europa.eu/gemet/concept/11198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/994> ;
    skos:definition "Term referring to the systems employed in animal rearing (extensive and intensive)."@en ;
    skos:prefLabel "breeding technique"@en .

<http://www.eionet.europa.eu/gemet/concept/11227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7882> ;
    skos:definition "Plant and animal residue that decomposes and becomes a part of the soil."@en ;
    skos:prefLabel "organic matter"@en .

<http://www.eionet.europa.eu/gemet/concept/11231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2319> ;
    skos:definition "A surface stream, or a body of impounded surface water, together with all other such streams and water bodies that are tributary to it and by which a region is drained. An artificial drainage system includes also surface and subsurface conduits."@en ;
    skos:prefLabel "drainage system"@en .

<http://www.eionet.europa.eu/gemet/concept/11234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/193> ;
    skos:definition "The monetary or material worth at which buyers and sellers agree to do business for agricultural goods and services."@en ;
    skos:prefLabel "agronomic value"@en .

<http://www.eionet.europa.eu/gemet/concept/11276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "The whole system of railway distribution in a country."@en ;
    skos:prefLabel "railway network"@en .

<http://www.eionet.europa.eu/gemet/concept/11277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "The system of roads through a country."@en ;
    skos:prefLabel "road network"@en .

<http://www.eionet.europa.eu/gemet/concept/1134> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1191> ;
    skos:definition "Carnivorous mammal in the superfamily Canoidea, including dogs and their allies."@en ;
    skos:prefLabel "canid"@en .

<http://www.eionet.europa.eu/gemet/concept/11472> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Rules concerning the movement of goods or persons by sea, railway or road."@en ;
    skos:prefLabel "transport law"@en .

<http://www.eionet.europa.eu/gemet/concept/11477> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:definition "Just claims, legal guarantees or moral principles accorded to sentient, non-human species, including freedom from abuse, consumption, experimentation, use as clothing or performing for human entertainment."@en ;
    skos:prefLabel "animal rights"@en .

<http://www.eionet.europa.eu/gemet/concept/11504> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Authorization required by local governmental bodies for the erection of an enclosed structure or for the major alteration or expansion of an existing edifice."@en ;
    skos:prefLabel "building permit"@en .

<http://www.eionet.europa.eu/gemet/concept/1159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/813> ;
    skos:definition "Any of the group of organic compounds composed of carbon, hydrogen and oxygen, including sugars, starches and celluloses."@en ;
    skos:prefLabel "carbohydrate"@en .

<http://www.eionet.europa.eu/gemet/concept/1162> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1168> ;
    skos:definition "A salt or ester of carbonic acid."@en ;
    skos:prefLabel "carbonate"@en .

<http://www.eionet.europa.eu/gemet/concept/11621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10085> ;
    skos:definition "Information concerning a fact, actually communicated to a person by an authorized person."@en ;
    skos:prefLabel "notification"@en .

<http://www.eionet.europa.eu/gemet/concept/11706> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/587> ;
    skos:definition "Man-made device that orbits the earth, receiving, processing and transmitting signals and generating images such as weather pictures."@en ;
    skos:prefLabel "observation satellite"@en .

<http://www.eionet.europa.eu/gemet/concept/11714> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5605>,
        <http://www.eionet.europa.eu/gemet/concept/5928> ;
    skos:definition "nitrogen chemically bound in organic molecules such as proteins, amines, and amino acids"@en ;
    skos:prefLabel "organic nitrogen"@en .

<http://www.eionet.europa.eu/gemet/concept/11794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "A substance capable of readily changing from a solid or liquid form to a vapour; having a high vapour pressure and a low boiling point."@en ;
    skos:prefLabel "volatile substance"@en .

<http://www.eionet.europa.eu/gemet/concept/11798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "Analysis based on the physical changes associated with chemical reactions."@en ;
    skos:prefLabel "physicochemical analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/11816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Properties that can be perceived by sense organs."@en ;
    skos:prefLabel "organoleptic property"@en .

<http://www.eionet.europa.eu/gemet/concept/11918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5658> ;
    skos:definition "Noise caused by the movement of large volumes of air and the use of high-pressure air."@en ;
    skos:prefLabel "airborne noise"@en .

<http://www.eionet.europa.eu/gemet/concept/12004> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6918> ;
    skos:definition "An element that is naturally radioactive."@en ;
    skos:prefLabel "radioelement"@en .

<http://www.eionet.europa.eu/gemet/concept/12013> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236> ;
    skos:definition "Reduction of tree population in forests caused by acidic precipitation, forest fires, air pollution, deforestation, pests and diseases of trees, wildlife, etc."@en ;
    skos:prefLabel "forest deterioration"@en .

<http://www.eionet.europa.eu/gemet/concept/12060> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "A climate characterized by hot summers, cold winters, and little rainfall, typical of the interior of a continent."@en ;
    skos:prefLabel "continental climate"@en .

<http://www.eionet.europa.eu/gemet/concept/12066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1469> ;
    skos:definition "The climate of the middle latitudes; the climate between the extremes of tropical climate and polar climate."@en ;
    skos:prefLabel "temperate climate"@en .

<http://www.eionet.europa.eu/gemet/concept/1210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6447> ;
    skos:definition "A substance whose presence alters the rate at which a chemical reaction proceeds, but whose own composition remains unchanged by the reaction. Catalysts are usually employed to accelerate reactions(positive catalyst), but retarding (negative) catalysts are also used."@en ;
    skos:prefLabel "catalyst"@en .

<http://www.eionet.europa.eu/gemet/concept/12107> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9206> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the environmental integrity of drainage areas used to catch water, such as reservoirs or basins."@en ;
    skos:prefLabel "water catchment protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15118>,
        <http://www.eionet.europa.eu/gemet/concept/2215> ;
    skos:definition "A sudden, widespread disaster or calamity that greatly exceeds the resources of an area or region."@en ;
    skos:prefLabel "catastrophe"@en .

<http://www.eionet.europa.eu/gemet/concept/12165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2098>,
        <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "Any mechanical procedure or process where some or all of the salt is removed from water."@en ;
    skos:prefLabel "water desalination"@en .

<http://www.eionet.europa.eu/gemet/concept/12171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7172> ;
    skos:definition "The utilization of the ocean for its food resources, mineral resources, and energy and water sources."@en ;
    skos:prefLabel "ocean exploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/1225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4862> ;
    skos:definition "Domesticated bovine animals, including cows, steers and bulls, raised and bred on a ranch or farm."@en ;
    skos:prefLabel "cattle"@en .

<http://www.eionet.europa.eu/gemet/concept/12284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "The liquid wastes deriving from domestic, commercial and industrial activities of an urban settlement."@en ;
    skos:prefLabel "urban waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/12377> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Wastes resulting from the operations of pollutant removal from industries, cleaning processes, etc."@en ;
    skos:prefLabel "pollution abatement waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "A dry powder made from silica, alumina, lime, iron oxide, and magnesia which hardens when mixed with water; used as an ingredient in concrete."@en ;
    skos:prefLabel "cement"@en .

<http://www.eionet.europa.eu/gemet/concept/1248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1044> ;
    skos:definition "Industry for the production of cement. The emissions of most relevance from this sector are atmospheric: dust, carbon dioxide and nitrogen oxides are the most important. Cement is essential for the construction sector, either directly or mixed with sand or gravel to form concrete."@en ;
    skos:prefLabel "cement industry"@en .

<http://www.eionet.europa.eu/gemet/concept/12488> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2333> ;
    skos:definition "Boring a hole for extracting oil."@en ;
    skos:prefLabel "drilling for oil"@en .

<http://www.eionet.europa.eu/gemet/concept/12514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of enterprises is engaged in the design, manufacture and marketing of mechanical apparatuses for commercial or industrial usage."@en ;
    skos:prefLabel "mechanical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "The action of drawing public attention to goods, services or events, often through paid announcements in newspapers, magazines, television or radio."@en ;
    skos:prefLabel "advertisement"@en .

<http://www.eionet.europa.eu/gemet/concept/12601> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Process that uses microorganisms to decompose organic wastes either into water, carbon dioxide, and simple inorganic substances, or into simpler organic substances, such as aldehydes and acids. The purpose of a biological treatment system is to control the environment for microorganisms so that their growth and activity are enhanced, and provide a means for maintaining high concentration of the microorganisms in contact with the wastes."@en ;
    skos:prefLabel "biological treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/1275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Aquatic mammals, including the whales, dolphins, and porpoises."@en ;
    skos:prefLabel "cetacean"@en .

<http://www.eionet.europa.eu/gemet/concept/12793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:definition "Risk or danger to human health or the environment posed by radiation emanating from the atomic nuclei of a given substance, or the possibility of an uncontrolled explosion originating from a fusion or fission reaction of atomic nuclei."@en ;
    skos:prefLabel "nuclear hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/1288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/9236> ;
    skos:definition "Any system of distribution canals or conduits for water, gas, electricity, or steam."@en ;
    skos:prefLabel "channelling"@en .

<http://www.eionet.europa.eu/gemet/concept/12913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12912> ;
    skos:definition "Public institution for the management of administrative issues."@en ;
    skos:prefLabel "public institution of administrative nature"@en .

<http://www.eionet.europa.eu/gemet/concept/1299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The nature and proportions of the elements comprising a chemical compound."@en ;
    skos:prefLabel "chemical composition"@en .

<http://www.eionet.europa.eu/gemet/concept/130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An official notice, opinion, counsel or recommendation that is optional or at the receiver's discretion."@en ;
    skos:prefLabel "advice"@en .

<http://www.eionet.europa.eu/gemet/concept/1307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/237> ;
    skos:definition "Fertilizer manufactured from chemicals; excessive use of them can cause pollution, when all the chemicals are not taken up by the plants and the excess is leached out of the soil into rivers and may cause algal bloom."@en ;
    skos:prefLabel "chemical fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/13077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:definition "Qualitative or quantitative determination of the components of a material, such as an ore or a drug."@en ;
    skos:prefLabel "assay"@en .

<http://www.eionet.europa.eu/gemet/concept/13100> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "The resulting effects and interrelationships of human population concentrations, the built environment, and the biophysical environment."@en ;
    skos:prefLabel "urban habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/13117> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8815> ;
    skos:definition "Any relatively unobstructed field of cultivated and mown grass, especially near a house or in a park."@en ;
    skos:prefLabel "open lawn"@en .

<http://www.eionet.europa.eu/gemet/concept/13123> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The process of forming visible images directly or indirectly by the action of light or other forms of radiation on sensitive surfaces."@en ;
    skos:prefLabel "photography"@en .

<http://www.eionet.europa.eu/gemet/concept/13145> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The financial resources or income of the European Community, a body of people organized into a political unity."@en ;
    skos:prefLabel "Community finance"@en .

<http://www.eionet.europa.eu/gemet/concept/13149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "Distribution of material goods to consumers, through retailing and wholesaling."@en ;
    skos:prefLabel "distributive trade"@en .

<http://www.eionet.europa.eu/gemet/concept/13150> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The different modes in which countries, nations, etc., are brought together by financial, currency, or pecuniary interests."@en ;
    skos:prefLabel "monetary relations"@en .

<http://www.eionet.europa.eu/gemet/concept/13156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "The monies and programs a society enacts through either public or private entities to provide economic security and general welfare for its members, often on account of old age, unemployment, health, disability or death of a spouse, parent or other benefactor."@en ;
    skos:prefLabel "social protection"@en .

<http://www.eionet.europa.eu/gemet/concept/13160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1084> ;
    skos:definition "The categorization of enterprises or organizations involved in an economy."@en ;
    skos:prefLabel "business classification"@en .

<http://www.eionet.europa.eu/gemet/concept/13161> a skos:Concept ;
    skos:definition "The type, structure or purpose of an institution as arranged, required and defined by local or national laws to determine the appropriate governmental regulations, privileges and tax status applicable to that institution."@en ;
    skos:prefLabel "legal form of organisations"@en .

<http://www.eionet.europa.eu/gemet/concept/13179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:prefLabel "industrial structure"@en .

<http://www.eionet.europa.eu/gemet/concept/1319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Pollution caused by substances of chemical nature, including chlorinated hydrocarbon pesticides, polychlorinated biphenyls, metals as mercury, lead, cadmium, arsenic, etc."@en ;
    skos:prefLabel "chemical pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/13193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:definition "As defined by the United Nations Food and Agriculture Organization, an agricultural holding is simply a basic unit for agricultural production."@en ;
    skos:prefLabel "agricultural holding"@en .

<http://www.eionet.europa.eu/gemet/concept/13199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Food which has been treated to improve its appearance or to prevent it going bad."@en ;
    skos:prefLabel "processed foodstuff"@en .

<http://www.eionet.europa.eu/gemet/concept/132> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Exposition to the action of air."@en ;
    skos:prefLabel "aeration"@en .

<http://www.eionet.europa.eu/gemet/concept/13210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "Refers to all the structures (fishing vessels, trawling nets, factory ships, catcher boats, etc.) used in fishing industry."@en ;
    skos:prefLabel "fisheries structure"@en .

<http://www.eionet.europa.eu/gemet/concept/13222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A group of parts or machines arranged to perform a useful function."@en ;
    skos:prefLabel "machinery"@en .

<http://www.eionet.europa.eu/gemet/concept/13253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:definition "The use of government tax and spending policies to achieve desired macroeconomic goals. Accordingly, they involve discretionary efforts to adjust governmental tax and spending to induce changes in economic incentives and, hence, to stabilize fluctuations in aggregate demand."@en ;
    skos:prefLabel "taxation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13257> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "The guiding procedure, philosophy, or course of action for decisions regarding the monetary rate or value for goods and services."@en ;
    skos:prefLabel "prices policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1639> ;
    skos:definition "Article 85(1) of the EEC Treaty prohibits all agreements between undertakings, decisions by associations of undertakings and concerted practices which may affect trade between member states and which have as their object or effect the prevention, restriction or distortion of competition within the common market. All such arrangements are automatically null and void under Article 85(2), unless exempted by the Commission pursuant to Article 85(3). The text of Article 85 is as follows: \"1. The following shall be prohibited as incompatible with the common market: all agreements between undertakings, decisions by associations of undertakings and concerted practices which may affect trade between member states and which have as their object or effect the prevention, restriction or distortion of competition within the common market, and in particular those which: (a) directly or indirectly fix purchase or selling prices or any other trading conditions; (b) limit or control production, markets, technical development, or investment; (c) share markets or sources of supply; (d) apply dissimilar conditions to equivalent transactions with other trading parties, thereby placing them at a competitive disadvantage; (e) make the conclusion of contracts subject to acceptance by the other parties of supplementary obligations which, by their nature or according to commercial usage, have no connection with the subject of such contracts."@en ;
    skos:prefLabel "restriction on competition"@en .

<http://www.eionet.europa.eu/gemet/concept/13269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1762> ;
    skos:definition "Any contract in which there are public funds provided though private persons may perform the contract and the subject of the contract may ultimately benefit private persons."@en ;
    skos:prefLabel "public contract"@en .

<http://www.eionet.europa.eu/gemet/concept/13272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:definition "A body of rules or orders prescribed by government or management for the safe and orderly movement of vehicles on land, sea or in the air."@en ;
    skos:prefLabel "traffic regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/13283> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11583> ;
    skos:definition "A judicial or administrative interpretation of a provision of a statute, order, regulation, or ordinance. May also refer to judicial determination of admissibility of evidence, allowance of motion, etc."@en ;
    skos:prefLabel "ruling"@en .

<http://www.eionet.europa.eu/gemet/concept/13293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "The specific tasks, undertakings or functions that governments, businesses and other organizations perform."@en ;
    skos:prefLabel "institutional activity"@en .

<http://www.eionet.europa.eu/gemet/concept/13316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "An assembly of computer hardware, firmware and software configured for the purpose of performing various operations on digital information elements with a minimum of human intervention."@en ;
    skos:prefLabel "data processing system"@en .

<http://www.eionet.europa.eu/gemet/concept/13318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The study of the behaviour of organisms."@en ;
    skos:prefLabel "behavioural science"@en .

<http://www.eionet.europa.eu/gemet/concept/1350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6527> ;
    skos:definition "A person below the age of puberty."@en ;
    skos:prefLabel "child"@en .

<http://www.eionet.europa.eu/gemet/concept/13550> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8525> ;
    skos:definition """1) A place where tents, cabins, or other temporary structures are erected for the use of military troops, for training soldiers, etc.
2) Tents, cabins, etc., used as temporary lodgings by a group of travellers, holiday-makers, Scouts, Gypsies, etc."""@en ;
    skos:prefLabel "camp"@en .

<http://www.eionet.europa.eu/gemet/concept/1356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2775> ;
    skos:definition "The appropriate height for chimneys serving industrial combustion plants in order to avoid unacceptable pollution."@en ;
    skos:prefLabel "chimney height"@en .

<http://www.eionet.europa.eu/gemet/concept/1368> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5921> ;
    skos:definition "A class of persistent, broad-spectrum insecticides that linger in the environment and accumulate in the food chain. Among them are DDT, aldrin, dieldrin, heptachlor, chlordane, lindane, endrin, mirex, hexachloride, and toxaphene. In insects and other animals these compounds act primarily on the central nervous system. They also become concentrated in the fats of organisms and thus tend to produce fatty infiltration of the heart and fatty degeneration of the liver in vertebrates. In fishes they have the effect of preventing oxygen uptake, causing suffocation. They are also known to slow the rate of photosynthesis in plants. Their danger to the ecosystem resides in their rate stability and the fact that they are broad-spectrum poisons which are very mobile because of their propensity to stick to dust particles and evaporate with water into the atmosphere."@en ;
    skos:prefLabel "chlorinated hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/13839> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6459> ;
    skos:prefLabel "noise effect"@en .

<http://www.eionet.europa.eu/gemet/concept/1389> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3821> ;
    skos:definition "Major group of chlorinated hydrocarbons, pesticides and biocides which account for a very high percentage of the non-agricultural pesticide use, such as anti-rotting agents in non-woollen textiles and wood preservatives. The chlorophenols act as biocides by inhibiting the respiration and energy-conversion processes of the microorganisms. They are toxic to man above 40 parts per million, to fish above 1 ppm, whilst concentrations as low as one part per thousand million can taint water."@en ;
    skos:prefLabel "chlorophenol"@en .

<http://www.eionet.europa.eu/gemet/concept/1400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4574> ;
    skos:definition "A method of separating and analyzing mixtures of chemical substances by selective adsorption in a column of powder or on a strip of paper."@en ;
    skos:prefLabel "chromatography"@en .

<http://www.eionet.europa.eu/gemet/concept/1406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/301> ;
    skos:definition "The golden-brown and orange-yellow algae; a diverse group of microscopically small algae which inhabit fresh and salt water, many being planktonic. They contain carotenoid pigments and may be unicellular, colonial, filamentous or amoeboid."@en ;
    skos:prefLabel "chrysophyta"@en .

<http://www.eionet.europa.eu/gemet/concept/1419> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7793> ;
    skos:definition "State of citizens of being aware of their civic obligations."@en ;
    skos:prefLabel "citizen awareness"@en .

<http://www.eionet.europa.eu/gemet/concept/14194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "A permanently waterlogged area in which there is often associated tree growth, e.g. mangroves in hot climates."@en ;
    skos:prefLabel "swamp"@en .

<http://www.eionet.europa.eu/gemet/concept/14208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13290> ;
    skos:definition "The entire course of action necessary to bring a law, resolution or special act to an authoritative, legally binding status."@en ;
    skos:prefLabel "legislative process"@en .

<http://www.eionet.europa.eu/gemet/concept/1422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1421> ;
    skos:definition "The central part of a city."@en ;
    skos:prefLabel "city centre"@en .

<http://www.eionet.europa.eu/gemet/concept/1466> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm from pollution to natural weather conditions or patterns, including the prevailing temperature, atmospheric composition and precipitation."@en ;
    skos:prefLabel "climate protection"@en .

<http://www.eionet.europa.eu/gemet/concept/14717> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:prefLabel "environmental sanitation"@en .

<http://www.eionet.europa.eu/gemet/concept/14851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:definition "Destruction of wildlife habitats by increasing pressure for land by fast-growing human populations, pollution and over-exploitation. Whole species or populations of plants and animals have disappeared causing a loss of genetic resource that is not only regrettable from an aesthetic or philosophical point of view but also threatens man's food supply. Habitat loss takes several forms: outright loss of areas used by wild species; degradation, for example, from vegetation removal and erosion, which deprive native species of food, shelter, and breeding areas; and fragmentation, when native species are squeezed onto small patches of undisturbed land surrounded by areas cleared for agriculture and other purposes."@en ;
    skos:prefLabel "habitat destruction"@en .

<http://www.eionet.europa.eu/gemet/concept/14853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:definition "Any change in a body or substance that does not involve an alteration in its chemical composition."@en ;
    skos:prefLabel "physical alteration"@en .

<http://www.eionet.europa.eu/gemet/concept/14856> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "The basic, underlying framework and features of a communications system supporting the exchange of knowledge, including hardware, software and transmission media."@en ;
    skos:prefLabel "information infrastructure"@en .

<http://www.eionet.europa.eu/gemet/concept/1486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7411> ;
    skos:definition "The cessation, discontinuation or breaking-off of a business transaction, lease, contract or employment arrangement, usually before its anticipated or stipulated end."@en ;
    skos:prefLabel "closing down"@en .

<http://www.eionet.europa.eu/gemet/concept/14930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/963> ;
    skos:definition "The line demarcating recognized limits of established political units."@en ;
    skos:prefLabel "national boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/14931> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14930> ;
    skos:definition "The line demarcating a territory located within the limits of a State."@en ;
    skos:prefLabel "sub-national boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/14934> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2286> ;
    skos:definition "A representation of the globe constructed on a plane with lines representative of and corresponding to the meridians and parallels of the curved surface of the earth."@en ;
    skos:prefLabel "geographical projection"@en .

<http://www.eionet.europa.eu/gemet/concept/14940> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "Service providing an active connection with a communications network."@en ;
    skos:prefLabel "on-line service"@en .

<http://www.eionet.europa.eu/gemet/concept/14950> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "Punishment aiming at deterring the criminal from repeating his offences or deterring others from committing similar acts."@en ;
    skos:prefLabel "deterrence"@en .

<http://www.eionet.europa.eu/gemet/concept/14960> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:prefLabel "services providing company"@en .

<http://www.eionet.europa.eu/gemet/concept/14963> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3907> ;
    skos:definition "The provision of heating fuel, coal or other heating source materials, or the amount of heating capacity, for the use of a specific local community."@en ;
    skos:prefLabel "local heat supply"@en .

<http://www.eionet.europa.eu/gemet/concept/15033> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1471> ;
    skos:definition "process of preparing to cope with living in a changing climate"@en ;
    skos:prefLabel "climate change adaptation"@en .

<http://www.eionet.europa.eu/gemet/concept/15046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15033> ;
    skos:definition """The property of a system to adjust its characteristics or behaviour, in order to expand its coping range under existing climate variability, or future climate conditions. 
ACC definition: The ability of systems, institutions, humans, and other organisms to
adjust to potential damage, to take advantage of opportunities, or to
respond to consequences."""@en ;
    skos:prefLabel "adaptive capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/15047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2735> ;
    skos:definition "oil crops which are converted into biofuels"@en ;
    skos:prefLabel "agricultural bioenergy production"@en .

<http://www.eionet.europa.eu/gemet/concept/15055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4589> ;
    skos:definition "type of liquid storage system designed and operated to combine waste stabilization and storage with varying lengths of storage (up to a year or greater), depending on the climate region, the volatile solids loading rate, and other operational factors"@en ;
    skos:prefLabel "anaerobic lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/15058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3763> ;
    skos:definition """Emissions of greenhouse gases, greenhouse gas precursors, and
aerosols caused by human activities. These activities include the burning
of fossil fuels, deforestation, land use changes, livestock production,
fertilization, waste management, and industrial processes."""@en ;
    skos:prefLabel "anthropogenic greenhouse gas"@en .

<http://www.eionet.europa.eu/gemet/concept/15068> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "Transformation or modification of human behavior"@en ;
    skos:prefLabel "behavioural change"@en .

<http://www.eionet.europa.eu/gemet/concept/15076> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2735> ;
    skos:definition "New and quickly developing branch of industry in most of European countries to find different efficient solution of energy conversion from different biomass recourses"@en ;
    skos:prefLabel "bioenergy production"@en .

<http://www.eionet.europa.eu/gemet/concept/15093> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4873> ;
    skos:definition "maximum supply of biological products and services that can be provided by the natural environment so that renewable resources are not depleted faster than they can be regenerated and that ecological systems remain viable"@en ;
    skos:prefLabel "carrying capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/15106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "study of individuals, groups, or organizations and the processes they use to select, secure, use, and dispose of products, services, experiences, or ideas to satisfy needs and the impacts that these processes have on the consumer and society"@en ;
    skos:prefLabel "consumption behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/15115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15243>,
        <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "waste not subject to or capable of degradation or decomposition"@en ;
    skos:prefLabel "degradable waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15118> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2215> ;
    skos:definition "convergence of hazards with the vulnerability of those exposed to them"@en ;
    skos:prefLabel "disaster risk"@en .

<http://www.eionet.europa.eu/gemet/concept/15130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2440> ;
    skos:definition "Expression of the quality of the structure and functioning of aquatic ecosystems associated with surface waters, classified in accordance with Annex V of the Water Framework Directive."@en ;
    skos:prefLabel "ecological status"@en .

<http://www.eionet.europa.eu/gemet/concept/15132> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15133>,
        <http://www.eionet.europa.eu/gemet/concept/2440> ;
    skos:definition "Social process through which the findings of science concerning the causes of ecosystem change, their consequences for human well-being, and management and policy options are brought to bear on the needs of decision-makers"@en ;
    skos:prefLabel "ecosystem assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15132>,
        <http://www.eionet.europa.eu/gemet/concept/2519>,
        <http://www.eionet.europa.eu/gemet/concept/2522> ;
    skos:definition "Spatial delimitation of an ecosystem, typically based on discontinuities in the distribution of organisms, the biophysical environment (soil types, drainage basins, depth in a water body), and spatial interactions (home ranges, migration patterns, fluxes of matter)"@en ;
    skos:prefLabel "ecosystem boundary"@en .

<http://www.eionet.europa.eu/gemet/concept/15134> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "exchanges of materials, energy, and information within and among ecosystems"@en ;
    skos:prefLabel "ecosystem interaction"@en .

<http://www.eionet.europa.eu/gemet/concept/15138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "benefits that people obtain from ecosystems contributing to human well-being"@en ;
    skos:prefLabel "ecosystem services"@en .

<http://www.eionet.europa.eu/gemet/concept/15140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2519> ;
    skos:definition "Exposure to contingencies and stress, and the difficulty in coping with them"@en ;
    skos:prefLabel "ecosystem vulnerability"@en .

<http://www.eionet.europa.eu/gemet/concept/15161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2534> ;
    skos:definition "laws to reduce the damages to ecosystems, resources, or people more generally, arising from human activity"@en ;
    skos:prefLabel "environmental regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/15174> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "waste composed of raw or cooked food materials and includes food materials discarded before, during or after food preparation, in the process of manufacturing, distribution, retail or food service activities, and includes materials such as vegetable peelings, meat trimmings, and spoiled or excess ingredients or prepared food"@en ;
    skos:prefLabel "food waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3633> ;
    skos:definition "genes and other hereditary material in any biological material that can be transferred to other organisms with or without the help of technology, except for human genetic material"@en ;
    skos:prefLabel "genetic material"@en .

<http://www.eionet.europa.eu/gemet/concept/15188> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15185>,
        <http://www.eionet.europa.eu/gemet/concept/8366> ;
    skos:definition ""@en ;
    skos:prefLabel "global temperature increase"@en .

<http://www.eionet.europa.eu/gemet/concept/15191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "economy in which policies and innovations enable society to use resources efficiently, enhancing human well‑being in an inclusive manner, while maintaining the natural systems that sustain us"@en ;
    skos:prefLabel "green economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "any petroleum-derived liquid fuel, excluding marine fuel"@en ;
    skos:prefLabel "heavy fuel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/15201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7822> ;
    skos:definition "secure and adequate livelihoods, enough food at all times, shelter, clothing, and access to goods: health, feeling well and healthy physical environment, such as clean air and clean water, good social relations, social cohesion, mutual respect, the ability to help others and provide for children; security, including secure access to natural and other resources, personal safety, and security from natural and human-made disasters; freedom of choice and action, including the opportunity to achieve individual values"@en ;
    skos:prefLabel "human well-being"@en .

<http://www.eionet.europa.eu/gemet/concept/15205> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4612> ;
    skos:definition "permanent layer of ice covering an extensive tract of land, especially a polar region"@en ;
    skos:prefLabel "ice sheet"@en .

<http://www.eionet.europa.eu/gemet/concept/15214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236> ;
    skos:definition "process which lowers the current and/or potential capability of soil to produce goods and services that can be limited, reversed and avoided through the appropriate management of land"@en ;
    skos:prefLabel "land degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/15225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "any fuel intended for marine use"@en ;
    skos:prefLabel "marine fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/15229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8671> ;
    skos:definition "a widespread and long-term social, economic, environmental, political or technological change that is slow to form but has a major impact once in place"@en ;
    skos:prefLabel "megatrend"@en .

<http://www.eionet.europa.eu/gemet/concept/1523> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9202> ;
    skos:definition "The presence, release or introduction of polluting substances in or onto the seashore or the land near it."@en ;
    skos:prefLabel "coastal pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/15231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "chemical (synthetic) fertiliser containing simple, inorganic plant nutrients or naturally occurring mined minerals"@en ;
    skos:prefLabel "mineral fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/15234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:definition "all the things that nature provides for our existence, i.e. the basic building blocks of our society, the healthy soils that give us food, the raw materials we need for buildings and clothes, the fresh water we drink and the clean air we breathe."@en ;
    skos:prefLabel "natural capital"@en .

<http://www.eionet.europa.eu/gemet/concept/15240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5605> ;
    skos:definition "mass of nitrogen per unit of time, usually measured in pounds or kilograms per day, calculated by multiplying concentrations by flow, such as the treatment plant effluent flow or river streamflow"@en ;
    skos:prefLabel "nitrogen load"@en .

<http://www.eionet.europa.eu/gemet/concept/15267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15155>,
        <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "result of a Product Environmental Footprint study based on the Product Environmental Footprint method"@en ;
    skos:prefLabel "product environmental footprint"@en .

<http://www.eionet.europa.eu/gemet/concept/15274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "general classification for the heavier oils that remain after the distillate fuel oils and lighter hydrocarbons are distilled away in refinery operations"@en ;
    skos:prefLabel "residual fuel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/15278> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "dearth or rarity of resources, can be also caused by decline in the quality, availability or productivity of natural resources and lead to reduction in economic well-being"@en ;
    skos:prefLabel "resource scarcity"@en .

<http://www.eionet.europa.eu/gemet/concept/15279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "appropriation and use of resources, ecosystems and naturally occurring materials, such as soil, wood, water, and minerals"@en ;
    skos:prefLabel "resource use"@en .

<http://www.eionet.europa.eu/gemet/concept/15296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/827> ;
    skos:definition "variation in soil life, from genes to communities, and the ecological complexes of which they are part, that is from soil micro-habitats to landscapes"@en ;
    skos:prefLabel "soil biodiversity"@en .

<http://www.eionet.europa.eu/gemet/concept/15299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "household combustion of coal or biomass such as dung, charcoal, wood or crop residues"@en ;
    skos:prefLabel "solid fuel use"@en .

<http://www.eionet.europa.eu/gemet/concept/15302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "use of goods and services that respond to basic needs and bring a better quality of life, while minimising the use of natural resources, toxic materials and emissions of waste and pollutants over the life cycle, so as not to jeopardise the needs of future generations"@en ;
    skos:prefLabel "sustainable consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/15307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "management approach which efficiently integrates economic, environmental and social issues with the aim of creating long-term benefits and securing the support, cooperation, and trust of the local community in a way that will benefit the current and the future generations"@en ;
    skos:prefLabel "sustainable management"@en .

<http://www.eionet.europa.eu/gemet/concept/15313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "total amount of living organic matter in trees expressed as oven-dry biomass per unit area (usually in tonnes/hectare)"@en ;
    skos:prefLabel "tree biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "process of data collection, profile and consultations designed to provide an informational and consensual basis for preparing an urban environmental management strategy"@en ;
    skos:prefLabel "urban environment assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/15323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4183> ;
    skos:definition "destruction of waste where the main purpose of the destruction is the thermal treatment of waste in order to reduce the volume and the hazardousness of the waste."@en ;
    skos:prefLabel "waste incineration"@en .

<http://www.eionet.europa.eu/gemet/concept/15325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "any stationary or mobile technical unit and equipment dedicated to the thermal treatment of waste with or without recovery of the combustion heat generated"@en ;
    skos:prefLabel "waste incineration plant"@en .

<http://www.eionet.europa.eu/gemet/concept/15331> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "environmental sustainability in the management of water resources, via integrated ecosystem approaches, access to good quality water in sufficient quantity and contribution to the internationally agreed targets and goals relevant to water and socio-economic development"@en ;
    skos:prefLabel "water policy"@en .

<http://www.eionet.europa.eu/gemet/concept/15345> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9041> ;
    skos:definition "waste put on or in the ground"@en ;
    skos:prefLabel "landfill waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1548> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "Animals that have a single body cavity (the coelenteron). The name was formerly given to a phylum comprising the Cnidaria and Ctenophora, but these are now regarded as phyla in their own right, and the name Coelenterata has fallen from use, although it is sometimes used as a synonym for Cnidaria."@en ;
    skos:prefLabel "coelenterate"@en .

<http://www.eionet.europa.eu/gemet/concept/1559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings located in climatic regions where the air temperature is below 10° Celsius for eight to eleven months of the year."@en ;
    skos:prefLabel "cold zone ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/1561> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/698> ;
    skos:definition "A group of bacteria that are normally abundant in the intestinal tracts of human and other warm-blooded animals and are used as indicators (being measured as the number of individuals found per millilitre of water) when testing the sanitary quality of water."@en ;
    skos:prefLabel "coliform bacterium"@en .

<http://www.eionet.europa.eu/gemet/concept/1568> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8072> ;
    skos:definition "A system of particles in a dispersion medium, with properties distinct from those of a true solution because of the larger size of the particles. The presence of these particles can often be detected by means of the ultramicroscope."@en ;
    skos:prefLabel "colloidal state"@en .

<http://www.eionet.europa.eu/gemet/concept/157> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8072> ;
    skos:definition "A gaseous suspension of ultramicroscopic particles of a liquid or a solid."@en ;
    skos:prefLabel "aerosol"@en .

<http://www.eionet.europa.eu/gemet/concept/1584> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7156> ;
    skos:definition "A residual layer of ash on the heat-exchange surfaces of a combustion chamber, resulting from the burning of fuel."@en ;
    skos:prefLabel "combustion residue"@en .

<http://www.eionet.europa.eu/gemet/concept/1613> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition """1) All of the plants and animals in an area or volume; a complex association usually containing both animals and plants. 
2) Any naturally occurring group of organisms that occupy a common environment."""@en ;
    skos:prefLabel "ecological community"@en .

<http://www.eionet.europa.eu/gemet/concept/1623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13343> ;
    skos:prefLabel "commuting"@en .

<http://www.eionet.europa.eu/gemet/concept/1649> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "A mixture of decaying organic matter used to fertilize and condition the soil."@en ;
    skos:prefLabel "compost"@en .

<http://www.eionet.europa.eu/gemet/concept/1652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The natural biological decomposition of organic material in the presence of air to form a humus-like material. Controlled methods of composting include mechanical mixing and aerating, ventilating the materials by dropping them through a vertical series of aerated chambers, or placing the compost in piles out in the open air and mixing it or turning it periodically."@en ;
    skos:prefLabel "composting"@en .

<http://www.eionet.europa.eu/gemet/concept/1728> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:prefLabel "construction technology"@en .

<http://www.eionet.europa.eu/gemet/concept/173> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/846> ;
    skos:definition "The period of time that a person, animal or plant has lived or is expected to live."@en ;
    skos:prefLabel "age"@en .

<http://www.eionet.europa.eu/gemet/concept/1739> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6801> ;
    skos:definition "Factual, circumstantial and, often, comparative knowledge concerning various goods, services or events, their quality and the entities producing them."@en ;
    skos:prefLabel "consumer information"@en .

<http://www.eionet.europa.eu/gemet/concept/1757> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2400> ;
    skos:definition "The gently sloping seabed of the shallow water nearest to a continent, covering about 45 miles from the shore and deepening over the sloping sea floor to an average depth of 400 ft. It continues until it reaches the continental slope. The continental shelf contains most of the important fishing grounds and a range of resources, including gas and oil, sand and gravel. However, the shelf is, in general, a structural extension of the continent, and so may also be a source of minerals found in that region, such as tin, gold and platinum."@en ;
    skos:prefLabel "continental shelf"@en .

<http://www.eionet.europa.eu/gemet/concept/1762> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1437> ;
    skos:definition "An agreement between two or more persons which creates an obligation to do or not to do a particular thing. Its essential are competent parties, subject matter, a legal consideration, mutuality of agreement, and mutuality of obligation."@en ;
    skos:prefLabel "contract"@en .

<http://www.eionet.europa.eu/gemet/concept/1787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "co-operation"@en .

<http://www.eionet.europa.eu/gemet/concept/1793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A growth of small trees that are repeatedly cut down at short intervals; the new shoots are produced by the old stumps."@en ;
    skos:prefLabel "coppice"@en .

<http://www.eionet.europa.eu/gemet/concept/1798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "The highest phylum in the animal kingdom, characterized by a notochord, nerve cord, and gill slits; includes the urochordate, lancelets and vertebrates."@en ;
    skos:prefLabel "chordate"@en .

<http://www.eionet.europa.eu/gemet/concept/1809> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A chemical agent which slows down or prohibits a corrosion reaction."@en ;
    skos:prefLabel "corrosion inhibitor"@en .

<http://www.eionet.europa.eu/gemet/concept/1817> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "Relation between costs of a certain activity and its benefits to a certain community."@en ;
    skos:prefLabel "cost-benefit"@en .

<http://www.eionet.europa.eu/gemet/concept/1860> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11583> ;
    skos:definition "A violation of the law, punishable by the State in criminal proceedings."@en ;
    skos:prefLabel "criminality"@en .

<http://www.eionet.europa.eu/gemet/concept/1864> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "General term referring to the concentration limit beyond which a substance can cause dangerous effects to living organisms."@en ;
    skos:prefLabel "critical level"@en .

<http://www.eionet.europa.eu/gemet/concept/1874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:definition "The problem of crop protection has changed dramatically since 1945. There is now a whole arsenal of chemicals with which to combat agricultural pests and diseases, but this development has itself many drawbacks. Such sophisticated techniques are available only to a minority of farmers; in most parts of the world the standard of crop protection remains abysmally low. In addition, modern crop protection methods have been criticized for relying too heavily on chemical control. Biological controls, both natural and contrived, have been neglected. In some cases involving misuse of agricultural chemicals, crops must be protected from the very measures intended for their protection. Meanwhile previously localized pests and diseases continue to spread worldwide."@en ;
    skos:prefLabel "crop protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A place, often shown by markings, lights, or poles, where a street, railway, etc. may be crossed."@en ;
    skos:prefLabel "crossing place"@en .

<http://www.eionet.europa.eu/gemet/concept/1889> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/571> ;
    skos:definition "A class of arthropod animals having jointed feet and mandibles, two pairs of antennae, and segmented, chitin-encased bodies."@en ;
    skos:prefLabel "crustacean"@en .

<http://www.eionet.europa.eu/gemet/concept/1902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13164> ;
    skos:definition "Any procedure or approach used to prepare land or soil for the growth of new crops, or to promote or improve the growth of existing crops."@en ;
    skos:prefLabel "cultivation method"@en .

<http://www.eionet.europa.eu/gemet/concept/1951> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:definition "Production of food made from milk or milk products."@en ;
    skos:prefLabel "dairy industry"@en .

<http://www.eionet.europa.eu/gemet/concept/1952> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Products derived from milk, such as butter, cheese, lactose, etc."@en ;
    skos:prefLabel "dairy product"@en .

<http://www.eionet.europa.eu/gemet/concept/1979> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4302> ;
    skos:definition "A computerized compilation of data, facts and records that is organized for convenient access, management and updating."@en ;
    skos:prefLabel "data base"@en .

<http://www.eionet.europa.eu/gemet/concept/1981> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A medium on which data can be recorded, and which is usually easily transportable, such as cards, tape, paper, or disks."@en ;
    skos:prefLabel "data carrier"@en .

<http://www.eionet.europa.eu/gemet/concept/1984> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14896> ;
    skos:definition "A reciprocal transfer of individual facts, statistics or items of information between two or more parties for the purpose of enhancing knowledge of the participants."@en ;
    skos:prefLabel "data exchange"@en .

<http://www.eionet.europa.eu/gemet/concept/1986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:definition "Any operation or combination of operations on data, including everything that happens to data from the time they are observed or collected to the time they are destroyed."@en ;
    skos:prefLabel "data processing"@en .

<http://www.eionet.europa.eu/gemet/concept/1989> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The body of specialized procedures and methods used for the preservation, collocation or registration of individual elements of information."@en ;
    skos:prefLabel "data recording technique"@en .

<http://www.eionet.europa.eu/gemet/concept/2020> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A declaration of the court announcing the legal consequences of the facts found."@en ;
    skos:prefLabel "decree"@en .

<http://www.eionet.europa.eu/gemet/concept/2036> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "The removal of forest and undergrowth to increase the surface of arable land or to use the timber for construction or industrial purposes. Forest and its undergrowth possess a very high water-retaining capacity, inhibiting runoff of rainwater."@en ;
    skos:prefLabel "deforestation"@en .

<http://www.eionet.europa.eu/gemet/concept/2039> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The capacity of being decomposed chemically or biologically."@en ;
    skos:prefLabel "degradability"@en .

<http://www.eionet.europa.eu/gemet/concept/204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4648> ;
    skos:prefLabel "agricultural landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/2042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Those chemicals resulting from partial decomposition or chemical breakdown of substances."@en ;
    skos:prefLabel "degradation product"@en .

<http://www.eionet.europa.eu/gemet/concept/2050> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7810> ;
    skos:prefLabel "delinquency"@en .

<http://www.eionet.europa.eu/gemet/concept/208> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877>,
        <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The administration or handling of soil, crops and livestock."@en ;
    skos:prefLabel "agricultural management"@en .

<http://www.eionet.europa.eu/gemet/concept/2098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "Removal of salt, as from water or soil."@en ;
    skos:prefLabel "desalination"@en .

<http://www.eionet.europa.eu/gemet/concept/2115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889>,
        <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "A graphic representation, especially a detailed plan for construction or manufacture."@en ;
    skos:prefLabel "design (project)"@en .

<http://www.eionet.europa.eu/gemet/concept/212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6138> ;
    skos:definition "Insects and mites that damage crops, weeds that compete with field crops for nutrients and water, plants that choke irrigation channels or drainage systems, rodents that eat young plants and grain, and birds that eat seedlings or stored foodstuffs."@en ;
    skos:prefLabel "agricultural pest"@en .

<http://www.eionet.europa.eu/gemet/concept/2131> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1458> ;
    skos:definition "A surface-active agent used for removing dirt and grease from a variety of surfaces and materials. Early detergents contained alkyl sulphonates, which proved resistant to bacterial decomposition, causing foaming in rivers and difficulties in sewage treatment plants. These hard detergents were replaced during the 1960s with soft biodegradable detergents. Apprehension continues to be expressed about the use of phosphates in detergents, helping to promote the process of eutrophication. No satisfactory substitute has yet emerged."@en ;
    skos:prefLabel "detergent"@en .

<http://www.eionet.europa.eu/gemet/concept/2207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3937>,
        <http://www.eionet.europa.eu/gemet/concept/5929> ;
    skos:definition "A by-product formed during the preparation of the herbicide 2, 4, 5-T, and sometimes produced by the incineration of chlorinated organic compounds. It may also occur naturally and is distributed widely in the environment, except locally in extremely low concentrations. Substantial amounts were released by the industrial accident of Seveso in 1976."@en ;
    skos:prefLabel "dioxin"@en .

<http://www.eionet.europa.eu/gemet/concept/2218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "An anticipatory emergency plan to be followed in an expected or eventual disaster, based on risk assessment, availability of human and material resources, community preparedness, local and international response capability, etc."@en ;
    skos:prefLabel "disaster contingency plan"@en .

<http://www.eionet.europa.eu/gemet/concept/2285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Centre for assembling, coding, and disseminating recorded knowledge comprehensively treated as an integral procedure, utilizing various techniques for giving documentary information maximum accessibility and usability."@en ;
    skos:prefLabel "documentation centre"@en .

<http://www.eionet.europa.eu/gemet/concept/229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Unusable materials, liquid or solid, that result from agricultural practices, such as fertilizers, pesticides, crop residue (such as orchard prunings) and cattle manure."@en ;
    skos:prefLabel "agricultural waste"@en .

<http://www.eionet.europa.eu/gemet/concept/2291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "1) Wild animal which has been trained to live near a house and not be frightened of human beings; 2) species which was formerly wild, now selectively bred to fill human needs."@en ;
    skos:prefLabel "domesticated animal"@en .

<http://www.eionet.europa.eu/gemet/concept/233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Large scale growing of crops and livestock grazing for profit."@en ;
    skos:prefLabel "agriculture and cattle industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2333> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The act of boring holes in the earth for finding water or oil, for geologic surveys, etc."@en ;
    skos:prefLabel "drilling"@en .

<http://www.eionet.europa.eu/gemet/concept/2344> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9246> ;
    skos:definition "The Directive on the Quality of Surface Water Intended for Drinking Water defines three categories of water treatment (A1, A2, A3) from simple physical treatment and disinfection to intensive physical and chemical treatment. The treatment to be used depends on the quality of the water abstracted. The Directive uses imperative values for parameters known to have an adverse effect on health and also guide values for those which are less adverse. There is also a directive which complements the \"surface water abstraction\" Directive by indicating the methods of measurement and the frequency of sampling and analysis required."@en ;
    skos:prefLabel "drinking water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/2354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A chemical substance used internally or externally as a medicine for the prevention, diagnosis, treatment or cure of disease, for the relief of pain or to control or enhance physical or mental well-being."@en ;
    skos:prefLabel "drug (medicine)"@en .

<http://www.eionet.europa.eu/gemet/concept/2361> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "The process of partially or totally removing water or other liquids from a solid."@en ;
    skos:prefLabel "drying"@en .

<http://www.eionet.europa.eu/gemet/concept/2377> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "A low mound, ridge, bank, or hill of loose, windblown granular material (generally sand, sometimes volcanic ash), either bare or covered with vegetation, capable of movement from place but always retaining its characteristic shape."@en ;
    skos:prefLabel "dune"@en .

<http://www.eionet.europa.eu/gemet/concept/2389> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A coloring material."@en ;
    skos:prefLabel "dye"@en .

<http://www.eionet.europa.eu/gemet/concept/2413> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2992> ;
    skos:definition "A geographic region of the European continent west of Asia and east of Germany and the Adriatic Sea, traditionally consisting of countries that were formerly part of the Soviet Union, such as Poland, the Czech Republic, Slovakia, Hungary, Romania, Serbia, Croatia and Bulgaria."@en ;
    skos:prefLabel "Eastern Europe"@en .

<http://www.eionet.europa.eu/gemet/concept/2438> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "Change in an organism so that it is better able to survive or reproduce, thereby contributing to its fitness."@en ;
    skos:prefLabel "ecological adaptation"@en .

<http://www.eionet.europa.eu/gemet/concept/2441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "The condition of equilibrium among the components of a natural community such that their relative numbers remain fairly constant and their ecosystem is stable. Gradual readjustments to the composition of a balanced community take place continually in response to natural ecological succession and to alterations in climatic and other influences."@en ;
    skos:prefLabel "ecological balance"@en .

<http://www.eionet.europa.eu/gemet/concept/245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/617> ;
    skos:definition "A predominantly mechanical mixture of a variety of individual gases forming the earth's enveloping atmosphere."@en ;
    skos:prefLabel "air"@en .

<http://www.eionet.europa.eu/gemet/concept/2463> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2440>,
        <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "Taking stock of, evaluating, or inventorying a company's impact on the environment or its progress towards environmentally sound business practices."@en ;
    skos:prefLabel "ecological stocktaking"@en .

<http://www.eionet.europa.eu/gemet/concept/2476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Any effort, work, function or sphere of action pertaining to the production of goods, services or any other resource with exchange value."@en ;
    skos:prefLabel "economic activity"@en .

<http://www.eionet.europa.eu/gemet/concept/2493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Any tool or method used by an organization to achieve general developmental goals in the production of, or in the regulation of, material resources."@en ;
    skos:prefLabel "economic instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/2497> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "An economy in which prices, incomes etc. are determined centrally by government rather than through the operation of the free market, and in which industrial production is governed by an overall national plan."@en ;
    skos:prefLabel "economic planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2501> ;
    skos:definition "The study of relationships in the economy. Its purpose is to analyze and explain the behaviour of the various economic elements. The body of economic theory can be divided into two broad categories, positive theory and welfare theory. Positive theory is an attempt to analyze the operation of the economy without considering the desirability of its results in terms of ultimate goals. Welfare theory is concerned primarily with an evaluation of the economic system in terms of ethical goals which are not themselves derived from economic analysis."@en ;
    skos:prefLabel "economic theory"@en .

<http://www.eionet.europa.eu/gemet/concept/2511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2490> ;
    skos:definition "Changes of variables and parameters of an economic system, analysed in statistical calculations."@en ;
    skos:prefLabel "economic trend"@en .

<http://www.eionet.europa.eu/gemet/concept/2522> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15140>,
        <http://www.eionet.europa.eu/gemet/concept/15154> ;
    skos:definition "Degradation or destruction of large natural environments. When one ecosystem is under attack as a result of natural or man-made disaster it is extremely difficult to calculate the ripple effects throughout nature. When two or more ecosystems are being degraded the probabilities of synergistic destructiveness multiply. Ecosystems in many regions are threatened, despite their biological richness and their promise of material benefits."@en ;
    skos:prefLabel "ecosystem degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/2569> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2478> ;
    skos:definition "Parameter or rule for assessing the competency in performance of production relative to the input of resources."@en ;
    skos:prefLabel "efficiency criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/2587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry for the production of electric energy."@en ;
    skos:prefLabel "electrical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:prefLabel "electronic material"@en .

<http://www.eionet.europa.eu/gemet/concept/2624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "Study, control, and application of the conduction of electricity through gases or vacuum or through semiconducting or conducting materials."@en ;
    skos:prefLabel "electronics"@en .

<http://www.eionet.europa.eu/gemet/concept/2635> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "A group of monatomic gaseous elements forming group 18 (formerly group 0) of the periodic table: helium (He), neon (Ne), argon (Ar), krypton (Kr), xenon (Xe), and radon (Rn)."@en ;
    skos:prefLabel "element of group 0"@en .

<http://www.eionet.europa.eu/gemet/concept/2655> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:prefLabel "emergency law"@en .

<http://www.eionet.europa.eu/gemet/concept/2657> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Money, food or other assistance provided for those surviving a sudden and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment."@en ;
    skos:prefLabel "emergency relief"@en .

<http://www.eionet.europa.eu/gemet/concept/2665> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2795> ;
    skos:definition "Procedures aiming at reducing or preventing the harm caused by atmospheric emissions."@en ;
    skos:prefLabel "emission control"@en .

<http://www.eionet.europa.eu/gemet/concept/2667> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "The relationship between the amount of pollutants produced to the amount of raw materials processed, or fuel consumed, in any polluting process."@en ;
    skos:prefLabel "emission factor"@en .

<http://www.eionet.europa.eu/gemet/concept/2670> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6446> ;
    skos:definition "The act or process of limiting or restricting the discharge of pollutants or contaminants, such as by setting emission limits or by modifying the emission source."@en ;
    skos:prefLabel "emission reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/2715> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2749> ;
    skos:definition "Amount of energy consumed by a person or an apparatus shown as a unit."@en ;
    skos:prefLabel "energy consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/2722> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Any publicly or privately organized setup in which usable power such as electricity is delivered to homes and businesses."@en ;
    skos:prefLabel "energy distribution system"@en .

<http://www.eionet.europa.eu/gemet/concept/2729> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:prefLabel "energy legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2733> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A statement of a country's intentions in the energy sector."@en ;
    skos:prefLabel "energy policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2734> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "Any natural phenomenon or series of actions by which energy is converted or made more usable."@en ;
    skos:prefLabel "energy process"@en .

<http://www.eionet.europa.eu/gemet/concept/2744> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14976> ;
    skos:definition "Amount of energy reserves; often refers to the stocks of non-renewable fuel, such as oil, which a nation, for example, possesses."@en ;
    skos:prefLabel "energy storage"@en .

<http://www.eionet.europa.eu/gemet/concept/2746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The provision and storage of energy (the capacity to do work or produce a change), or the amount of energy stored, for the use of a municipality, or other energy user."@en ;
    skos:prefLabel "energy supply"@en .

<http://www.eionet.europa.eu/gemet/concept/2747> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:prefLabel "energy technology"@en .

<http://www.eionet.europa.eu/gemet/concept/2753> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The execution, carrying out or putting into effect an order, regulation, law or official decree."@en ;
    skos:prefLabel "enforcement"@en .

<http://www.eionet.europa.eu/gemet/concept/2754> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A machine in which power is applied to do work by the conversion of various forms of energy into mechanical force and motion."@en ;
    skos:prefLabel "engine"@en .

<http://www.eionet.europa.eu/gemet/concept/2767> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10002> ;
    skos:prefLabel "environmental accounting"@en .

<http://www.eionet.europa.eu/gemet/concept/2818> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2778>,
        <http://www.eionet.europa.eu/gemet/concept/2980> ;
    skos:definition "An ecological conscience or moral that reflects a commitment and responsibility toward the environment, including plants and animals as well as present and future generations of people. Oriented toward human societies living in harmony with the natural world on which they depend for survival and well being."@en ;
    skos:prefLabel "environmental ethics"@en .

<http://www.eionet.europa.eu/gemet/concept/2824> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:definition "The art and science of the protection of good health, the prevention of disease and injury through the control of positive environmental factors, and the reduction of potential physical, biological, chemical and radiological hazards."@en ;
    skos:prefLabel "environmental health"@en .

<http://www.eionet.europa.eu/gemet/concept/2844> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4159> ;
    skos:definition "Survey conducted to ascertain the conditions of a site prior to the realization of a project, to analyze its possible impacts and compensative measures."@en ;
    skos:prefLabel "environmental impact study"@en .

<http://www.eionet.europa.eu/gemet/concept/2847> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4196> ;
    skos:definition "A measurement, statistic or value that provides a proximate gauge or evidence of the effects of environmental management programs or of the state or condition of the environment."@en ;
    skos:prefLabel "environmental indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/2849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industries involved in the development of cleaner technologies, waste and wastewater treatment, recycling processes, biotechnology processes, catalysts, membranes, desulphurisation plants, noise reduction, and the manufacture of other products having an environment protection purpose."@en ;
    skos:prefLabel "environmental industry"@en .

<http://www.eionet.europa.eu/gemet/concept/2852> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13060> ;
    skos:definition "A system of interrelated persons and devices linked to permit the exchange of data or knowledge concerning natural resources, human health and other ecological matters."@en ;
    skos:prefLabel "environmental information network"@en .

<http://www.eionet.europa.eu/gemet/concept/290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/639> ;
    skos:definition "The physical processes at the air-water interface: momentum, heat and mass transfer across the air-water interface, mixing of surface water by wind stress and wave breaking, directional wave spectra and wave forces on offshore structures. The air-water interaction is measured by the turbulence and gas exchanges resulting from the mixing of the water column by wind."@en ;
    skos:prefLabel "air-water interaction"@en .

<http://www.eionet.europa.eu/gemet/concept/2918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11148> ;
    skos:definition "The study of the environment and its modifications caused by human activities."@en ;
    skos:prefLabel "environmental research"@en .

<http://www.eionet.europa.eu/gemet/concept/2921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Likelihood, or probability, of injury, disease, or death resulting from exposure to a potential environmental hazard."@en ;
    skos:prefLabel "environmental risk"@en .

<http://www.eionet.europa.eu/gemet/concept/2929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Environmental elements of recognized importance which can be modified by the completion of a project."@en ;
    skos:prefLabel "environmental target"@en .

<http://www.eionet.europa.eu/gemet/concept/2955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "Animals belonging to the family of Equidae."@en ;
    skos:prefLabel "equine"@en .

<http://www.eionet.europa.eu/gemet/concept/298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5929> ;
    skos:definition "A group of organic chemical compounds composed of carbon, hydrogen, and oxygen. The molecules in the series vary in chain length and are composed of a hydrocarbon plus a hydroxyl group. Alcohol includes methanol and ethanol."@en ;
    skos:prefLabel "alcohol"@en .

<http://www.eionet.europa.eu/gemet/concept/30> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25> ;
    skos:definition "The cause or origin of an unexpected occurrence, failure or loss with the potential for harming human life, property or the environment."@en ;
    skos:prefLabel "accident source"@en .

<http://www.eionet.europa.eu/gemet/concept/3007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6459> ;
    skos:definition "enrichment of water by nutrients, especially compounds of nitrogen and/or phosphorus, causing an accelerated growth of algae and higher forms of plant life that produce an undesirable disturbance to the balance of organisms present in the water and to the quality of the water concerned"@en ;
    skos:prefLabel "eutrophication"@en .

<http://www.eionet.europa.eu/gemet/concept/301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "Simple, green, aquatic plants without stems, roots or leaves. They are among the microscopic organisms that form the start of the food chain. Algae are found floating in the sea and fresh water, but they also grow on the surface of damp walls, rocks, the bark of trees and on soil. They contain chlorophyll and other pigments that let them grow by photosynthesis. On land, algae can be useful in improving the fertility of soil by nitrogen fixation."@en ;
    skos:prefLabel "alga"@en .

<http://www.eionet.europa.eu/gemet/concept/3012> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "A standard, norm, value or measurement by which the quantity or quality of a process, object or person's work performance is ascertained through an analysis and judgment of the relevant information in context and in view of established goals, objectives and standards."@en ;
    skos:prefLabel "evaluation criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/3013> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:prefLabel "evaluation method"@en .

<http://www.eionet.europa.eu/gemet/concept/3045> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1583>,
        <http://www.eionet.europa.eu/gemet/concept/9077> ;
    skos:definition "Offgas produced during combustion processes discharged directly or ultimately to the atmosphere."@en ;
    skos:prefLabel "exhaust gas"@en .

<http://www.eionet.europa.eu/gemet/concept/308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/311> ;
    skos:definition "Any substance composed of two or more unlike atoms held together by chemical bonds characterized by straight-chained, branched or cyclic properties."@en ;
    skos:prefLabel "alicyclic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/3081> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition """1) The complete disappearance of a species of plant or animal from the planet.
2) Disappearing of animals and plants from the biota."""@en ;
    skos:prefLabel "extinction (ecological)"@en .

<http://www.eionet.europa.eu/gemet/concept/3115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:definition "Arable land not under rotation that is set at rest for a period of time ranging from one to five years before it is cultivated again, or land usually under permanent crops, meadows or pastures, which is not being used for that purpose for a period of at least one year. Arable land which is normally used for the cultivation of temporary crops but which is temporarily used for grazing is included."@en ;
    skos:prefLabel "fallow land"@en .

<http://www.eionet.europa.eu/gemet/concept/3119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The control of the number of children in a family and of the intervals between them, especially by the use of contraceptives."@en ;
    skos:prefLabel "family planning"@en .

<http://www.eionet.europa.eu/gemet/concept/319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7899> ;
    skos:definition "Soil that contains sufficient exchangeable sodium to interfere with water penetration and crop growth, either with or without appreciable quantities of soluble salts."@en ;
    skos:prefLabel "alkali soil"@en .

<http://www.eionet.europa.eu/gemet/concept/3195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3205> ;
    skos:definition "Help and support provided on matters concerning money."@en ;
    skos:prefLabel "financial assistance"@en .

<http://www.eionet.europa.eu/gemet/concept/3200> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:prefLabel "financial law"@en .

<http://www.eionet.europa.eu/gemet/concept/3209> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Air-borne solid particles, originating from human activity and natural sources, such as wind-blown soil and fires, that eventually settle through the force of gravity, and can cause injury to human and other animal respiratory systems through excessive inhalation."@en ;
    skos:prefLabel "fine dust"@en .

<http://www.eionet.europa.eu/gemet/concept/3218> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11661> ;
    skos:definition "Measure, action or installation implemented in advance to avert the possibility of any unexpected and potentially harmful combustion of materials."@en ;
    skos:prefLabel "fire precaution"@en .

<http://www.eionet.europa.eu/gemet/concept/322> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4091> ;
    skos:definition "Paraffins. A homologous series of saturated hydrocarbons having the general formula CnH2n+2. Their systematic names end in -ane. They are chemically inert, stable, and flammable. The first four members of the series (methane, ethane, propane, butane) are gases at ordinary temperatures; the next eleven are liquids, and form the main constituents of paraffin oil; the higher members are solids. Paraffin waxs consists mainly of higher alkanes."@en ;
    skos:prefLabel "alkane"@en .

<http://www.eionet.europa.eu/gemet/concept/3220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11662> ;
    skos:definition "All necessary precautions to see that fire is not initiated, by ensuring that all necessary fire fighting apparatus is in good order and available for use if fire should break out, and by ensuring that personnel are properly trained and drilled in fighting fire."@en ;
    skos:prefLabel "fire protection"@en .

<http://www.eionet.europa.eu/gemet/concept/3238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877>,
        <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The administration and handling of aspects of the fishing industry, including the catching, processing and selling of fish."@en ;
    skos:prefLabel "fisheries management"@en .

<http://www.eionet.europa.eu/gemet/concept/3241> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7525> ;
    skos:prefLabel "fishery resource"@en .

<http://www.eionet.europa.eu/gemet/concept/3252> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/511>,
        <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "Cold-blooded aquatic vertebrates."@en ;
    skos:prefLabel "fish"@en .

<http://www.eionet.europa.eu/gemet/concept/3263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7003> ;
    skos:definition "Limited portion of a water body where angling is allowed."@en ;
    skos:prefLabel "fishing preserve"@en .

<http://www.eionet.europa.eu/gemet/concept/3301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3298> ;
    skos:definition "A general and temporary condition of partial or complete inundation of normally dry land areas from the overflow of inland and/or tidal waters, and/or the unusual and rapid accumulation or runoff of surface waters from any source. A great flow along a watercourse or a flow causing inundation of lands not normally covered by water."@en ;
    skos:prefLabel "flooding"@en .

<http://www.eionet.europa.eu/gemet/concept/3311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9172> ;
    skos:definition "The forward continuous movement of a fluid through closed or open channels or conduits."@en ;
    skos:prefLabel "flow"@en .

<http://www.eionet.europa.eu/gemet/concept/3324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12605> ;
    skos:definition "A roasting process in which finely divided solids are suspended in a rising current of air (or other fluid), producing a fluidized bed; used in the calcination of various materials, in the coal industry, etc."@en ;
    skos:prefLabel "fluidisation"@en .

<http://www.eionet.europa.eu/gemet/concept/3354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "A material that can be ingested and utilized by the organism as a source of nutrition and energy."@en ;
    skos:prefLabel "food"@en .

<http://www.eionet.europa.eu/gemet/concept/3356> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Substances that have no nutritive value in themselves (or are not being used as nutrients) which are added to food during processing to improve colour, texture, flavour, or keeping qualities."@en ;
    skos:prefLabel "food additive"@en .

<http://www.eionet.europa.eu/gemet/concept/3358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "A sequence of organisms on successive trophic levels within a community, through which energy is transferred by feeding; energy enters the food chain during fixation by primary producers (mainly green plants) and passes to the herbivores (primary consumers) and then to the carnivores (secondary and tertiary consumers)."@en ;
    skos:prefLabel "food chain"@en .

<http://www.eionet.europa.eu/gemet/concept/3375> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3391>,
        <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Processing designed to protect food from spoilage caused by microbes, enzymes, and autooxidation."@en ;
    skos:prefLabel "food preservation"@en .

<http://www.eionet.europa.eu/gemet/concept/3391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "The application of science and engineering to the refining, manufacturing, and handling of foods; many food technologists are food scientists rather than engineers."@en ;
    skos:prefLabel "food technology"@en .

<http://www.eionet.europa.eu/gemet/concept/3405> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "Trade between countries and firms belonging to different countries."@en ;
    skos:prefLabel "foreign trade"@en .

<http://www.eionet.europa.eu/gemet/concept/3414> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2802> ;
    skos:definition "Reduction of tree population in forests caused by acidic precipitation, forest fires, air pollution, deforestation, pests and diseases of trees, wildlife, etc."@en ;
    skos:prefLabel "forest damage"@en .

<http://www.eionet.europa.eu/gemet/concept/3438> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8919> ;
    skos:definition "Forest resources consist of two separate but closely related parts: the forest land and the trees (timber) on that land."@en ;
    skos:prefLabel "forest resource"@en .

<http://www.eionet.europa.eu/gemet/concept/3442> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the use and conservation of wooded areas, most often those owned by the government itself."@en ;
    skos:prefLabel "forestry legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/3488> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15334> ;
    skos:definition "Pollution immediately or eventually involves the hydrological cycle of the earth, because even pollutants emitted into the air and those present in the soil are washed out by precipitation. Water is considered polluted when it is altered in composition or condition so that it becomes less suitable for any or all of the functions and purposes for which it would be suitable in its natural state. This definition includes changes in the physical, chemical and biological properties of water, or such discharges of liquid, gaseous or solid substances into water as will or are likely to create nuisances or render such water harmful to public health, safety or welfare, or to domestic, commercial, industrial, agricultural, fish or other aquatic life. It also includes changes in temperatures, due to the discharge of hot water."@en ;
    skos:prefLabel "freshwater degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/3494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9221> ;
    skos:definition "The network of rivers, lakes, and other surface waters that supply water for food production and other essential human systems."@en ;
    skos:prefLabel "freshwater resource"@en .

<http://www.eionet.europa.eu/gemet/concept/3512> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "A liquid product burned to generate heat, exclusive of oils with a flash point below 38°C; includes heating oils, stove oils, furnace oils, bunker fuel oils."@en ;
    skos:prefLabel "fuel oil"@en .

<http://www.eionet.europa.eu/gemet/concept/3516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1064> ;
    skos:definition "The operating, fuel-storage component of a fuel system."@en ;
    skos:prefLabel "fuel tank installation"@en .

<http://www.eionet.europa.eu/gemet/concept/3518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Solids in the air that have been generated by the condensation of vapors, chemical reactions or sublimation (a direct change from solid to gas). Often metallic oxides or metals, these particles are less than 1 micrometer in diameter and may be toxic."@en ;
    skos:prefLabel "fume"@en .

<http://www.eionet.europa.eu/gemet/concept/3529> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3528> ;
    skos:definition "Nucleated usually filamentous, sporebearing organisms devoid of chlorophyll."@en ;
    skos:prefLabel "fungus"@en .

<http://www.eionet.europa.eu/gemet/concept/3536> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5929> ;
    skos:definition "A colourless flammable toxic liquid heterocyclic compound, used in the synthesis of nylon."@en ;
    skos:prefLabel "furan"@en .

<http://www.eionet.europa.eu/gemet/concept/3553> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Wild animals, including birds and fish, hunted for sport, food or profit."@en ;
    skos:prefLabel "game (animals)"@en .

<http://www.eionet.europa.eu/gemet/concept/3566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3577> ;
    skos:definition "A substance that continues to occupy in a continuous manner the whole of the space in which it is placed, however large or small this place is mad, the temperature remaining constant."@en ;
    skos:prefLabel "gas"@en .

<http://www.eionet.europa.eu/gemet/concept/3581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3578> ;
    skos:definition """1) Any chemical or heat process used to convert a substance to a gas. 
2) The production of gaseous fuels by reacting hot carbonaceous materials with air, steam or oxygen. The process takes place at high temperature. The gasification product is a mixture of combustible gases and tar compounds, together with particles and water vapour. Depending on the gasification method, the proportion of components varies, but common to all the processes is that the gas has to be purified before it can be used directly in a gas engine or a gas turbine."""@en ;
    skos:prefLabel "gasification"@en .

<http://www.eionet.europa.eu/gemet/concept/3599> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The provision and storage of any fuel gas, or the amount of any fuel gas stored, for the use of a municipality, or other fuel gas user."@en ;
    skos:prefLabel "gas supply"@en .

<http://www.eionet.europa.eu/gemet/concept/3611> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2651> ;
    skos:definition "A point, matter or dispute concerning the capabilities, societal roles or other differences and divisions between women and men, especially the relative weight of biological and physical difference versus culture and socialization as a cause of those distinctions."@en ;
    skos:prefLabel "gender issue"@en .

<http://www.eionet.europa.eu/gemet/concept/3620> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "The variation between individuals and between populations within a species."@en ;
    skos:prefLabel "genetic diversity"@en .

<http://www.eionet.europa.eu/gemet/concept/3690> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5325> ;
    skos:definition "Models concerning different aspects of reality which can be applied at global level."@en ;
    skos:prefLabel "global model"@en .

<http://www.eionet.europa.eu/gemet/concept/3698> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2498> ;
    skos:definition "The aim, purpose, objective, or end for a profit-seeking enterprise engaged in commerce, manufacturing, or a service."@en ;
    skos:prefLabel "goal of individual economic business"@en .

<http://www.eionet.europa.eu/gemet/concept/3718> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Any course of action adopted and pursued by a ruling political authority or system, which determines the affairs for a nation, state or region."@en ;
    skos:prefLabel "government policy"@en .

<http://www.eionet.europa.eu/gemet/concept/372> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5928> ;
    skos:definition "One of a class of organic compounds which can be considered to be derived from ammonia by replacement of one or more hydrogens by organic radicals."@en ;
    skos:prefLabel "amine"@en .

<http://www.eionet.europa.eu/gemet/concept/3732> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5945> ;
    skos:definition "A plant-eating insect with long back legs that can jump very high and makes a sharp high noise using its back legs or wings."@en ;
    skos:prefLabel "grasshopper"@en .

<http://www.eionet.europa.eu/gemet/concept/3733> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Grassland cover nearly one-fifth of the Earth's land surface. They include savannah, the prairies of North America, and the steppes of Russia and Central Asia. Grassland ecosystems support thousands of different species, above and below the ground, and have a vital part to play maintaining the ecological balance of the world."@en ;
    skos:prefLabel "grassland"@en .

<http://www.eionet.europa.eu/gemet/concept/3763> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9077> ;
    skos:definition "A collective expression for those components of the atmosphere that influence the greenhouse effect, namely carbon dioxide, methane, nitrous oxides, ozone, CFCs and water vapour."@en ;
    skos:prefLabel "greenhouse gas"@en .

<http://www.eionet.europa.eu/gemet/concept/3805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6176> ;
    skos:definition "Any seed-bearing plant of the division Gymnospermae, in which the ovules are borne naked on the surface of the mega sporophylls, which are often arranged in cones."@en ;
    skos:prefLabel "gymnosperm"@en .

<http://www.eionet.europa.eu/gemet/concept/3821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6183> ;
    skos:definition "Halogen derivatives of phenol."@en ;
    skos:prefLabel "halogenated phenol"@en .

<http://www.eionet.europa.eu/gemet/concept/3823> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3820> ;
    skos:prefLabel "halogenated terphenyl"@en .

<http://www.eionet.europa.eu/gemet/concept/3830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1850> ;
    skos:definition "A particular skill performed with the hands."@en ;
    skos:prefLabel "handicraft"@en .

<http://www.eionet.europa.eu/gemet/concept/3834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "Area of water next to the coast, often surrounded by thick walls, where ships and boats can be sheltered."@en ;
    skos:prefLabel "harbour"@en .

<http://www.eionet.europa.eu/gemet/concept/3853> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852> ;
    skos:definition "Risk or danger to human health, property or the environment posed by the introduction of a harmful substances into the ecosystem."@en ;
    skos:prefLabel "hazard of pollutants"@en .

<http://www.eionet.europa.eu/gemet/concept/3871> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "A facility or location where medical, dental, surgical, or nursing attention or treatment is provided to humans or animals."@en ;
    skos:prefLabel "health facility"@en .

<http://www.eionet.europa.eu/gemet/concept/3887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10003> ;
    skos:definition "The general perceptual behaviour and the specific responses made in relation to sound stimuli."@en ;
    skos:prefLabel "hearing (sense)"@en .

<http://www.eionet.europa.eu/gemet/concept/394> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/812> ;
    skos:definition "A process from which air or oxygen not in chemical combination is excluded."@en ;
    skos:prefLabel "anaerobic process"@en .

<http://www.eionet.europa.eu/gemet/concept/4002> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12379> ;
    skos:definition "Solid waste, both biological and non-biological, produced by hospitals and discarded and not intended for further use."@en ;
    skos:prefLabel "hospital waste"@en .

<http://www.eionet.europa.eu/gemet/concept/401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10088> ;
    skos:definition "Equipment employed in analytical techniques."@en ;
    skos:prefLabel "analytical equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/4032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the buying, selling, leasing, construction or maintenance of dwelling places."@en ;
    skos:prefLabel "housing legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/4049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2233> ;
    skos:prefLabel "human exposure to pollutants"@en .

<http://www.eionet.europa.eu/gemet/concept/4065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:prefLabel "human settlement management"@en .

<http://www.eionet.europa.eu/gemet/concept/4103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2636> ;
    skos:definition "A flammable colourless gas that is the lightest and most abundant element in the universe. It occurs mainly in water and in most organic compounds and is used in the production of ammonia and other chemicals, in the hydrogenation of fats and oils, and in welding."@en ;
    skos:prefLabel "hydrogen"@en .

<http://www.eionet.europa.eu/gemet/concept/411> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6176> ;
    skos:definition "The class of seed plants that includes all the flowering plants, characterized by the possession of flowers. The ovules, which become seeds after fertilization, are enclosed in ovaries. The xylem contains true vessels. The angiospermae are divided into two subclasses: Monocotyledoneae and Dycotiledoneae."@en ;
    skos:prefLabel "angiosperm"@en .

<http://www.eionet.europa.eu/gemet/concept/4122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1777> ;
    skos:definition "Energy obtained from natural or artificial waterfalls, either directly by turning a water wheel or turbine, or indirectly by generating electricity in a dynamo driven by a turbine."@en ;
    skos:prefLabel "water power"@en .

<http://www.eionet.europa.eu/gemet/concept/4127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "Insects including bees, wasps, ants, and sawflies, having two pair of membranous wings and an ovipositor specialized for stinging, sawing or piercing."@en ;
    skos:prefLabel "hymenopteran"@en .

<http://www.eionet.europa.eu/gemet/concept/4133> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "Large areas of floating ice, usually occurring in polar seas, consisting of separate pieces that have become massed together."@en ;
    skos:prefLabel "ice pack"@en .

<http://www.eionet.europa.eu/gemet/concept/4140> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1986> ;
    skos:definition "The process of converting 'raw' remotely sensed data into a usable form through the application of various transformations such as supervised and unsupervised classification schemes."@en ;
    skos:prefLabel "image processing"@en .

<http://www.eionet.europa.eu/gemet/concept/415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/765> ;
    skos:definition "Behaviour of animals in their normal environment, including all the processes, both internal and external, by which they respond to changes in their environment."@en ;
    skos:prefLabel "animal behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/4154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "A body system that helps an organism to resist disease, through the activities of specialised blood cells or antibodies produced by them in response to natural exposure or inoculation."@en ;
    skos:prefLabel "immune system"@en .

<http://www.eionet.europa.eu/gemet/concept/4160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7185> ;
    skos:definition "Actions, procedures or installations undertaken to reduce the extent or degree of negative effects on human health and the ecosystem introduced by human design or interaction with the environment."@en ;
    skos:prefLabel "impact minimisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6124> ;
    skos:definition "Permission from a government to bring within its borders and sell a product manufactured in a foreign country."@en ;
    skos:prefLabel "import licence"@en .

<http://www.eionet.europa.eu/gemet/concept/417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:prefLabel "animal disease"@en .

<http://www.eionet.europa.eu/gemet/concept/4182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "Controlled process by which solid, liquid, or gaseous combustible wastes are burned and changed into gases; residue produced contains little or no combustible material."@en ;
    skos:prefLabel "incineration"@en .

<http://www.eionet.europa.eu/gemet/concept/4184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Device which burns waste."@en ;
    skos:prefLabel "incinerator"@en .

<http://www.eionet.europa.eu/gemet/concept/4187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The gain derived from capital, from labour or effort, or both combined, including profit or gain through sale or conversion of capital."@en ;
    skos:prefLabel "income"@en .

<http://www.eionet.europa.eu/gemet/concept/4213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1065> ;
    skos:definition "Areas allocated for industry within a town-planning scheme or environmental plan. The range of industries accommodated in a plan may include: light industry, service industry, general industry, hazardous, noxious or offensive industry, waterfront industry, extractive industry. Standards are usually defined for industrial areas relating to access and roads, drainage, car parking, aesthetics, landscaping, buffer zones, noise levels, and air and water pollution."@en ;
    skos:prefLabel "industrial area"@en .

<http://www.eionet.europa.eu/gemet/concept/423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Any crops or other food substances for animal consumption."@en ;
    skos:prefLabel "animal foodstuff"@en .

<http://www.eionet.europa.eu/gemet/concept/4250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5144> ;
    skos:definition "The branch of medicine which deals with the relationship of humans to their occupations, for the purpose of the prevention of disease and injury and the promotion of optimal health, productivity, and social adjustment."@en ;
    skos:prefLabel "industrial medicine"@en .

<http://www.eionet.europa.eu/gemet/concept/4273> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste materials discarded from industrial operations, or derived from manufacturing processes; may be solid, sludge (wet solids) or liquid wastes and may or may not be considered hazardous."@en ;
    skos:prefLabel "industrial waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4115> ;
    skos:definition "Movement of water through the soil surface into the ground."@en ;
    skos:prefLabel "infiltration"@en .

<http://www.eionet.europa.eu/gemet/concept/4307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "A systematic series of actions performed by a person or computer on data elements including classifying, sorting, calculating, summarizing, transmitting, retrieving and receiving."@en ;
    skos:prefLabel "information processing"@en .

<http://www.eionet.europa.eu/gemet/concept/4310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1605> ;
    skos:definition "Generally, any resource initiating and substantiating the reception of knowledge or specifically, the origin of a data transmission."@en ;
    skos:prefLabel "information source"@en .

<http://www.eionet.europa.eu/gemet/concept/4313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "The systems, equipment, components and software required to ensure the retrieval, processing and storage of information in all centres of human activity (home, office, factory, etc.), the application of which generally requires the use of electronics or similar technology."@en ;
    skos:prefLabel "information technology"@en .

<http://www.eionet.europa.eu/gemet/concept/4325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A stress upon an organism that disrupts the structure or function and results in a pathological process."@en ;
    skos:prefLabel "injury"@en .

<http://www.eionet.europa.eu/gemet/concept/4336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9245> ;
    skos:definition "Transportation of persons and goods by boats travelling on rivers, channels or lakes."@en ;
    skos:prefLabel "inland waterways transport"@en .

<http://www.eionet.europa.eu/gemet/concept/4340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050> ;
    skos:definition "Something newly introduced, such as a new method or device."@en ;
    skos:prefLabel "innovation"@en .

<http://www.eionet.europa.eu/gemet/concept/44> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Addition of an acid to a solution until the pH falls below 7."@en ;
    skos:prefLabel "acidification"@en .

<http://www.eionet.europa.eu/gemet/concept/4417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "Cooperation in international efforts to support global environmental goals. Solutions to environmental problems such as trans-boundary airborne and waterborne pollution, ozone depletion and climate change require action by all responsible countries."@en ;
    skos:prefLabel "international agreement"@en .

<http://www.eionet.europa.eu/gemet/concept/4420> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1776> ;
    skos:definition "Treaties and other agreements of a contractual character between different countries or organizations of states creating legal rights and obligations between the parties."@en ;
    skos:prefLabel "international convention"@en .

<http://www.eionet.europa.eu/gemet/concept/4436> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6371> ;
    skos:definition "The use of methods, strategy, intrigue, decision making and power by governments and their representatives to achieve goals in policy making or governmental affairs in a worldwide or international arena."@en ;
    skos:prefLabel "international politics"@en .

<http://www.eionet.europa.eu/gemet/concept/4441> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "Freedom from danger or the quality of averting risk of harm to persons, property or the environment shared across one or more national boundaries; consequently, the combined efforts of more than one nation to achieve or preserve that state."@en ;
    skos:prefLabel "international safety"@en .

<http://www.eionet.europa.eu/gemet/concept/4444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3405> ;
    skos:definition "The flow of commodities and goods between nations."@en ;
    skos:prefLabel "international trade"@en .

<http://www.eionet.europa.eu/gemet/concept/4455> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:definition "Stepping in or participating in problem solving efforts for troublesome or perplexing situations involving the natural world or scenery."@en ;
    skos:prefLabel "intervention in nature and landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/4505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "1) To supply land with water so that crops and plants will grow or grow stronger."@en ;
    skos:prefLabel "irrigation"@en .

<http://www.eionet.europa.eu/gemet/concept/451> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5501> ;
    skos:definition "A filament or threadlike strand derived from animals that manufacturers use to produce clothes or other goods that require weaving, knitting or felting, which include silk, wool, mohair and other forms of animal hair."@en ;
    skos:prefLabel "animal textile fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/4514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5494> ;
    skos:definition "A land mass, especially one smaller than a continent, entirely surrounded by water."@en ;
    skos:prefLabel "island"@en .

<http://www.eionet.europa.eu/gemet/concept/4518> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "The process of preventing or reducing the transmission of electricity, heat, or sound to or from a body, device, or region by surrounding it with a nonconducting material."@en ;
    skos:prefLabel "insulation (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/4541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "The power of a court to hear and decide a case or make a certain order."@en ;
    skos:prefLabel "jurisdiction"@en .

<http://www.eionet.europa.eu/gemet/concept/4545> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition """1) A German rendering of a Serbo-Croat term referring to the terrain created by limestone solution and characterized by a virtual absence of surface drainage, a series of surface hollows, depressions and fissures, collapse structures, and an extensive subterranean drainage network.
2) A type of topography that is formed on limestone, gypsum, and other rocks by dissolution, and that is characterized by sinkholes, caves, and underground drainage. Etymology: German, from the Yugoslavian territory Krs; type locality, a limestone plateau in the Dinaric Alps of northwestern Yugoslavia and northeastern Italy."""@en ;
    skos:prefLabel "karst"@en .

<http://www.eionet.europa.eu/gemet/concept/456> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/572> ;
    skos:definition "Any worms of the phylum Anellida, in which the body is divided into segments both internally and externally. The group includes the earthworms, lugworm, ragworm, and leeches."@en ;
    skos:prefLabel "annelid"@en .

<http://www.eionet.europa.eu/gemet/concept/4567> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "A room or building with scientific equipment for doing scientific tests or for teaching science, or a place where chemicals or medicines are produced."@en ;
    skos:prefLabel "laboratory"@en .

<http://www.eionet.europa.eu/gemet/concept/4600> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11527> ;
    skos:definition "The permission or freedom to use, enter, approach or pass to and from a tract of land, which often consists of real estate property."@en ;
    skos:prefLabel "land access"@en .

<http://www.eionet.europa.eu/gemet/concept/4603> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7082> ;
    skos:definition "The system of registering certain legal estates or interests in land. It describes the land and any additional rights incidental to it, such as rights of way over adjoining land."@en ;
    skos:prefLabel "land and property register"@en .

<http://www.eionet.europa.eu/gemet/concept/4612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14933>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Land cover is the physical state of the land surface. It is the combination of vegetation, soil, rock, water and human-made structures, which make up the earth's landscape. The land cover is the interface between the earth's crust and the atmosphere, influencing the exchange of energy and matter in the climatic system and biogeochemical cycles."@en ;
    skos:prefLabel "land cover"@en .

<http://www.eionet.europa.eu/gemet/concept/4614> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13102> ;
    skos:definition "Planning of infrastructures, services and industrial settlements in order to promote the socio-economic growth of certain land area."@en ;
    skos:prefLabel "land development"@en .

<http://www.eionet.europa.eu/gemet/concept/4636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2895> ;
    skos:definition "The presence of one or more contaminants upon or within an area of land, or its constituents."@en ;
    skos:prefLabel "land pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/4646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The treatment of any unusable land usually by filling with refuse or levelling until the land can be brought into productive use."@en ;
    skos:prefLabel "land restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/4650> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Landscapes might change through time as a result of human activities or natural processes such as fires or natural disasters. Changes in landscape structure can be documented by using data from aerial photographs or satellite images, and new technologies, such as remote sensing and geographic information systems."@en ;
    skos:prefLabel "landscape alteration"@en .

<http://www.eionet.europa.eu/gemet/concept/4663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "Using landscape or parts of it for tourism, sports, or agriculture."@en ;
    skos:prefLabel "landscape utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/47> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/48> ;
    skos:definition "The state of being acid that is of being capable of transferring a hydrogen ion in solution."@en ;
    skos:prefLabel "acidity"@en .

<http://www.eionet.europa.eu/gemet/concept/470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11> ;
    skos:prefLabel "anthropogenic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/4702> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The act of washing and ironing clothes, linen, etc."@en ;
    skos:prefLabel "laundering"@en .

<http://www.eionet.europa.eu/gemet/concept/4707> a skos:Concept ;
    skos:definition "One of the rules making up the body of law."@en ;
    skos:prefLabel "law (individual)"@en .

<http://www.eionet.europa.eu/gemet/concept/4710> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2753> ;
    skos:definition "Any variety of activities associated with promoting compliance and obedience to the binding rules of a state, especially the prevention, investigation, apprehension or detention of individuals suspected or convicted of violating those rules."@en ;
    skos:prefLabel "law enforcement"@en .

<http://www.eionet.europa.eu/gemet/concept/4731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2766> ;
    skos:definition "The accidental, uncontrolled discharge or seepage of liquids, gases and other substances to unintended and unwanted locations, frequently causing risks of damage or harm to persons, property or the environment."@en ;
    skos:prefLabel "leakage"@en .

<http://www.eionet.europa.eu/gemet/concept/4771> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7001> ;
    skos:definition "Time free from work or other duties; spare time."@en ;
    skos:prefLabel "leisure time"@en .

<http://www.eionet.europa.eu/gemet/concept/4777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "A large order of scaly-winged insects, including the butterflies, skippers, and moths; adults are characterized by two pairs of membranous wings and sucking mouthparts, featuring a prominent, coiled proboscis."@en ;
    skos:prefLabel "lepidopteran"@en .

<http://www.eionet.europa.eu/gemet/concept/4802> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The phases, changes, or stages through which an organism passes throughout its lifetime."@en ;
    skos:prefLabel "life cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/483> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2845> ;
    skos:definition "Financial reward or penalty used to incite action towards greater responsibility in reducing the presence of pollution or substances in the environment deemed harmful to human health or natural resources."@en ;
    skos:prefLabel "antipollution incentive"@en .

<http://www.eionet.europa.eu/gemet/concept/4844> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8072> ;
    skos:definition "A state of matter intermediate between that of crystalline substances and gases in which a substance has the capacity to flow under extremely small shear stresses and conforms to the shape of a confining vessel, but is relatively incompressible, lacks the capacity to expand without limit, and can posses a free surface."@en ;
    skos:prefLabel "liquid state"@en .

<http://www.eionet.europa.eu/gemet/concept/4845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Fluid wastes, consisting of sewage and domestic wastewater, or processed water, or other liquids, produced by industrial activity, particularly by such industries as pulp and paper production, food processing, and the manufacture of chemicals."@en ;
    skos:prefLabel "liquid waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4850> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "Written material such as poetry, novels, essays, especially works of imagination characterized by excellence of style and expression and by themes of general or enduring interest."@en ;
    skos:prefLabel "literature"@en .

<http://www.eionet.europa.eu/gemet/concept/4906> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Effects which will last long after the cause has ceased."@en ;
    skos:prefLabel "long-term effect"@en .

<http://www.eionet.europa.eu/gemet/concept/4913> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:definition "A large motor vehicle designed to carry heavy loads, especially one with a flat platform."@en ;
    skos:prefLabel "lorry"@en .

<http://www.eionet.europa.eu/gemet/concept/4934> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A substance used to reduce friction between parts or objects in relative motion."@en ;
    skos:prefLabel "lubricant"@en .

<http://www.eionet.europa.eu/gemet/concept/4971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25> ;
    skos:definition "An unexpected occurrence, failure or loss beyond normal or specified levels with the potential for harming human life, property or the environment."@en ;
    skos:prefLabel "major accident"@en .

<http://www.eionet.europa.eu/gemet/concept/5004> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4581> ;
    skos:definition """1) The power generated by a man working.
2) The number of people available for work, service, etc."""@en ;
    skos:prefLabel "manpower"@en .

<http://www.eionet.europa.eu/gemet/concept/5005> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Activities connected with the processing of raw material into a finished product, especially by means of a large-scale industrial operation."@en ;
    skos:prefLabel "manufacturing activity"@en .

<http://www.eionet.europa.eu/gemet/concept/5013> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The process of making a map of an area; especially the field work necessary for the production of a map."@en ;
    skos:prefLabel "mapping"@en .

<http://www.eionet.europa.eu/gemet/concept/5031> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/505> ;
    skos:definition "Any marine environment, from pond to ocean, in which plants and animals interact with the chemical and physical features of the environment."@en ;
    skos:prefLabel "marine ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9202> ;
    skos:definition "Any detrimental alteration of the marine environment caused by the intentional or accidental release of dangerous or toxic substances, such as industrial, commercial and urban waste water."@en ;
    skos:prefLabel "marine pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/5051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "That system of law which particularly relates to marine commerce and navigation, to business transacted at sea or relating to navigation, to ships and shipping, to seamen, to the transportation of persons and property by sea, and to marine affairs generally."@en ;
    skos:prefLabel "maritime law"@en .

<http://www.eionet.europa.eu/gemet/concept/5056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/861> ;
    skos:definition """1) Small amount of an easily detected substance that can be used to follow and quantify the flow of materials or movement of organisms not otherwise visible or detectable by ordinary means.
2) An isotope of an element, a small amount of which may be incorporated into a sample of material in order to follow the course of that element through a chemical, biological, or physical process, and thus also follow the larger sample. The tracer may be radioactive, in which case observations are made by measuring the radioactivity."""@en ;
    skos:prefLabel "marker"@en .

<http://www.eionet.europa.eu/gemet/concept/5057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/861> ;
    skos:definition "A minute quantity of radioactive isotope used in medicine or biology to study the chemical changes within living tissues."@en ;
    skos:prefLabel "tracer"@en .

<http://www.eionet.europa.eu/gemet/concept/5064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "A related group of business activities whose purpose is to satisfy the demands for goods and services of consumers, businesses and government. The marketing process includes estimating the demand, producing the product, pricing the product to satisfy profit criteria, and promoting and distributing the product."@en ;
    skos:prefLabel "marketing"@en .

<http://www.eionet.europa.eu/gemet/concept/508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:prefLabel "aquatic mammal"@en .

<http://www.eionet.europa.eu/gemet/concept/5088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "A calculation to inventory material inputs versus outputs in a process system."@en ;
    skos:prefLabel "balance of matter"@en .

<http://www.eionet.europa.eu/gemet/concept/5090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "All the stages involved in the manufacturing, distribution and retail, use and re-use and maintenance, recycling and waste management of materials."@en ;
    skos:prefLabel "material life cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/5097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The branch of mathematics most explicitly concerned with the limit process or the concept of convergence; includes the theories of differentiation, integration and measure, infinite series, and analytic functions."@en ;
    skos:prefLabel "mathematical analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/5110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3733> ;
    skos:definition "Strictly a term for a field of permanent grass used for hay, but also applied to rich, waterside grazing areas that are not suitable for arable cultivation."@en ;
    skos:prefLabel "meadow"@en .

<http://www.eionet.europa.eu/gemet/concept/5116> a skos:Concept ;
    skos:definition "Vehicles used for transferring people or goods from one place to another."@en ;
    skos:prefLabel "transportation mean"@en .

<http://www.eionet.europa.eu/gemet/concept/5122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13088> ;
    skos:prefLabel "measuring method"@en .

<http://www.eionet.europa.eu/gemet/concept/514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Plants adapted for a partially or completely submerged life."@en ;
    skos:prefLabel "aquatic plant"@en .

<http://www.eionet.europa.eu/gemet/concept/5145> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The collective islands and countries of the inland sea between Europe, Africa and Asia that is linked to the Atlantic Ocean at its western end by the Strait of Gibraltar and includes the Tyrrhenian, Adriatic, Aegean and Ionian seas."@en ;
    skos:prefLabel "Mediterranean Area"@en .

<http://www.eionet.europa.eu/gemet/concept/5171> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5277> ;
    skos:definition "Minerals containing metals, such as bauxite, pyrite, etc."@en ;
    skos:prefLabel "metallic mineral"@en .

<http://www.eionet.europa.eu/gemet/concept/5178> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Any binary compound in which oxygen is combined with one or more metal atoms."@en ;
    skos:prefLabel "metal oxide"@en .

<http://www.eionet.europa.eu/gemet/concept/5180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:prefLabel "metal product"@en .

<http://www.eionet.europa.eu/gemet/concept/5181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry related with the primary metal processing and fabricated metal products manufacturing. The most important end uses of the products of the metals industries are automobiles, machinery, appliances, electrical equipment, structures, furniture, and containers."@en ;
    skos:prefLabel "metal products industry"@en .

<http://www.eionet.europa.eu/gemet/concept/5194> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "A branch of science that studies the dynamics of the atmosphere and the direct effects of the atmosphere upon the Earth's surface, oceans and inhabitants, focusing particularly on weather and weather conditions."@en ;
    skos:prefLabel "meteorological forecasting"@en .

<http://www.eionet.europa.eu/gemet/concept/5241> a skos:Concept ;
    skos:prefLabel "military aspects"@en .

<http://www.eionet.europa.eu/gemet/concept/5270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The science which concerns the study of natural inorganic substances called minerals."@en ;
    skos:prefLabel "mineralogy"@en .

<http://www.eionet.europa.eu/gemet/concept/5288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3650> ;
    skos:definition "The study of geologic aspects of mineral deposits, with particular regard to problems associated with mining."@en ;
    skos:prefLabel "mining geology"@en .

<http://www.eionet.europa.eu/gemet/concept/5295> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "Mining is an intensive type of land use with potential for environmental impact over a limited area. When closure occurs, it should address both environmental and safety aspects. Mine reclamation is an ongoing program designed to restore to an acceptable state the physical, chemical and biological quality or potential of air, land and water regimes disturbed by mining. The objective of mine reclamation is to prevent or minimize adverse long-term environmental impacts, and create a self-sustaining ecosystem as near as practicable to what existed before the mining activity."@en ;
    skos:prefLabel "mining site restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/5303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A group that is different racially, politically, etc. from a larger group of which it is a part."@en ;
    skos:prefLabel "minority"@en .

<http://www.eionet.europa.eu/gemet/concept/5317> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Use of land for more than one purpose; e.g. grazing of livestock, watershed and wildlife protection, recreation, and timber production."@en ;
    skos:prefLabel "mixed use area"@en .

<http://www.eionet.europa.eu/gemet/concept/5327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7702> ;
    skos:definition "An investigative technique using a mathematical or physical representation of a system or theory that accounts for all or some its known properties. Models are often used to test the effect of changes of system components on the overall performance of the system."@en ;
    skos:prefLabel "modelling"@en .

<http://www.eionet.europa.eu/gemet/concept/5371> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2056> ;
    skos:definition "The number of deaths occurring in a given population for a given period of time."@en ;
    skos:prefLabel "mortality"@en .

<http://www.eionet.europa.eu/gemet/concept/5391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "The formation and discharge of gaseous and particulate pollutants into the environment chiefly from car, truck and bus exhaust."@en ;
    skos:prefLabel "motor vehicle emission"@en .

<http://www.eionet.europa.eu/gemet/concept/5393> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8934> ;
    skos:prefLabel "motor vehicle industry"@en .

<http://www.eionet.europa.eu/gemet/concept/5401> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5405> ;
    skos:definition "A feature of the earth's surface that rises high above the base and has generally steep slopes and a relatively small summit area. Mountains are an important source of water, energy, minerals, forest and agricultural products, and recreation. They are storehouses of biological diversity and endangered species and an essential part of the global ecosystem. About 10% of the world's population depend on mountain resources and nearly half of these people are affected by the degradation of mountain watershed areas."@en ;
    skos:prefLabel "mountain"@en .

<http://www.eionet.europa.eu/gemet/concept/542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The smallest and most poorly studied of the oceans on earth. It covers an area of 14 million square km that is divided by three submarine ridges, i.e. the Alpha Ridge, the Lomonosov Ridge, and an extension of the mid-Atlantic ridge. It is also nearly landlocked, covered year-round by pack ice, and the third of its area is continental shelf."@en ;
    skos:prefLabel "Arctic Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/543> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6364> ;
    skos:definition "The northernmost area of the earth, centered on the North Pole, that includes the Arctic Ocean, the northern reaches of Canada, Alaska, Russia, Norway and most of Greenland, Iceland and Svalbard."@en ;
    skos:prefLabel "Arctic region"@en .

<http://www.eionet.europa.eu/gemet/concept/544> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition """1) The overall geographical distribution of a talon. 
2) The range occupied by a community or other group."""@en ;
    skos:prefLabel "distribution area"@en .

<http://www.eionet.europa.eu/gemet/concept/5444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "A place or building where objects of historical, artistic, or scientific interest are exhibited, preserved or studied."@en ;
    skos:prefLabel "museum"@en .

<http://www.eionet.europa.eu/gemet/concept/5450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/501> ;
    skos:definition "Breeding of mussels for sale as food."@en ;
    skos:prefLabel "mussel farming"@en .

<http://www.eionet.europa.eu/gemet/concept/5462> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "A change in the chemical constitution of the DNA in the chromosomes of an organism: the changes are normally restricted to individual genes, but occasionally involve serious alteration to whole chromosomes. When a mutation occurs in gametes or gametocytes an inherited change may be produced in the characteristics of the organisms that develop from them. Mutation is one of the ways in which genetic variation is produced in organisms. A somatic mutation is one that occurs to a body cell, and is consequently past on to all the cells derived from it by mitosis. Natural mutations, at this stage of biological evolution, when they occur in the cells of higher animals, almost always produce deleterious characteristics. Both natural and artificial mutations can be brought about by ionizing radiation (hence the genetic and carcinogenic dangers of nuclear weapons) and by certain chemical substances called mutagens."@en ;
    skos:prefLabel "mutation"@en .

<http://www.eionet.europa.eu/gemet/concept/5476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2767> ;
    skos:definition "The collection and processing of financial information regarding the costs for ecological challenges or opportunities for nations or countries."@en ;
    skos:prefLabel "national environmental accounting"@en .

<http://www.eionet.europa.eu/gemet/concept/5505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "The tapping of natural gas from wells located under the sea and in general from underground sources often in association with petroleum deposits; it is used as a fuel, having largely replaced coal-gas for this purpose, and as a source of intermediates for organic synthesis."@en ;
    skos:prefLabel "natural gas extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/552> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Lands characterized by low annual rainfall of less than 250 mm, by evaporation exceeding precipitation and a sparse vegetation."@en ;
    skos:prefLabel "arid land"@en .

<http://www.eionet.europa.eu/gemet/concept/5544> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the elements of the material world that exist independently of human activity."@en ;
    skos:prefLabel "nature protection"@en .

<http://www.eionet.europa.eu/gemet/concept/5547> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "nausea"@en .

<http://www.eionet.europa.eu/gemet/concept/5555> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6861> ;
    skos:definition "The fact or an instance of feeling the lack of something."@en ;
    skos:prefLabel "need"@en .

<http://www.eionet.europa.eu/gemet/concept/558> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "The military units of a state, typically divided by their differing contexts of operations, such as the army, navy, air force and marines."@en ;
    skos:prefLabel "armed forces"@en .

<http://www.eionet.europa.eu/gemet/concept/560> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Compounds characterized by the presence of at least one benzene ring."@en ;
    skos:prefLabel "aromatic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5604> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5928> ;
    skos:definition "Any one of a class of usually organic compounds that contain the monovalent group, -NO2 (nitro group or radical) linked to a carbon atom."@en ;
    skos:prefLabel "nitro compound"@en .

<http://www.eionet.europa.eu/gemet/concept/562> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/560> ;
    skos:definition "Hydrocarbons having an unsaturated ring containing alternating double and single bonds, especially containing a benzene ring."@en ;
    skos:prefLabel "aromatic hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/564> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3356> ;
    skos:definition "Substance having a distinctive, usually fragrant smell."@en ;
    skos:prefLabel "aromatic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/5650> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Noise in the environment which can be harmful to human beings, animals and plants."@en ;
    skos:prefLabel "noise pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/5654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6446> ;
    skos:definition "The reduction in the sound pressure level of a noise, or the attenuation of unwanted sound by any means."@en ;
    skos:prefLabel "noise reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/5671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "Private, voluntary, non-profit organisations, acting as pressure groups. Throughout the world there are more than 5.000 international NGOs which are concerned with the environment and development, with millions of supporters."@en ;
    skos:prefLabel "non-governmental organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/5685> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7168> ;
    skos:definition "A natural resource which, in terms of human time scales, is contained within the Earth in a fixed quantity and therefore can be used once only in the foreseeable future (although it may be recycled after its first use). This includes the fossil fuels and is extended to include mineral resources and sometimes ground water, although water and many minerals are renewed eventually."@en ;
    skos:prefLabel "non-renewable resource"@en .

<http://www.eionet.europa.eu/gemet/concept/5690> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "An established standard, guide, or regulation. A principle or regulation set up by authority, prescribing or directing action or forbearance; as the rules of a legislative body, of a company, court, public office, of the law, of ethics."@en ;
    skos:prefLabel "norm"@en .

<http://www.eionet.europa.eu/gemet/concept/5694> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The northern part of the Atlantic Ocean, extending northward from the equator to the Arctic Ocean."@en ;
    skos:prefLabel "North Atlantic Ocean"@en .

<http://www.eionet.europa.eu/gemet/concept/5708> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4971> ;
    skos:definition "An event occurring in a nuclear power plant or anywhere that radioactive materials are used, stored, or transported and involving the release of potentially dangerous levels of radioactive materials into the environment."@en ;
    skos:prefLabel "nuclear accident"@en .

<http://www.eionet.europa.eu/gemet/concept/5733> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6235> ;
    skos:definition "The study of the characteristics, behaviour and internal structures of the atomic nucleus."@en ;
    skos:prefLabel "nuclear physics"@en .

<http://www.eionet.europa.eu/gemet/concept/5742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6977> ;
    skos:definition "Device which creates heat and energy by starting and controlling atomic fission."@en ;
    skos:prefLabel "nuclear reactor"@en .

<http://www.eionet.europa.eu/gemet/concept/5781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A functional or organic disease caused by factors arising from the operations or materials of an individual's industry, trade, or occupation."@en ;
    skos:prefLabel "occupational disease"@en .

<http://www.eionet.europa.eu/gemet/concept/5784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:definition "An area of statutory duty imposed on employers and employees in most countries, for the protection of the workforce from occupational diseases and stresses and physical hazards through adequate planning, ventilation, lighting, safeguards, safety and emergency procedures, routine inspections, monitoring, personal protection, etc."@en ;
    skos:prefLabel "occupational health"@en .

<http://www.eionet.europa.eu/gemet/concept/5802> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:prefLabel "odonate"@en .

<http://www.eionet.europa.eu/gemet/concept/5834> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "Recovery of oil by surface mining, as in tar sands or oil shales, or from tunnels in a shallow reservoir."@en ;
    skos:prefLabel "oil extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/587> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Any man-made object placed in a near-periodic orbit in which it moves mainly under the gravitational influence of one celestial body, such as the earth, sun, another planet, or a planet's moon."@en ;
    skos:prefLabel "artificial satellite"@en .

<http://www.eionet.europa.eu/gemet/concept/5887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "A mineral or mineral aggregate, more or less mixed with gangue, that can be worked and treated at a profit."@en ;
    skos:prefLabel "ore"@en .

<http://www.eionet.europa.eu/gemet/concept/5921> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3820> ;
    skos:definition "Organic compounds containing a C-Cl bond."@en ;
    skos:prefLabel "organochlorine compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5924> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Organic compounds containing a C-halogen bond."@en ;
    skos:prefLabel "organohalogen compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The passage of a solvent through a semipermeable membrane separating two solutions of different concentrations. A semipermeable membrane is one through which the molecules of a solvent can pass but the molecules of most solutes cannot. There is a thermodynamic tendency for solutions separated by such a membrane to become equal in concentration, the water (or other solvent) flowing from the weaker to the stronger solution. Osmosis will stop when the two solutions reach equal concentration, and can also be stopped by applying a pressure to the liquid on the stronger-solution side of the membrane. The pressure required to stop the flow from a pure solvent into a solution is a characteristic of the solution, and is called the osmotic pressure. Osmotic pressure depends only on the concentration of particles in the solution, not on their nature."@en ;
    skos:prefLabel "osmosis"@en .

<http://www.eionet.europa.eu/gemet/concept/5965> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2055> ;
    skos:definition "A population density that exceeds the capacity of the environment to supply the health requirements of the individual organism."@en ;
    skos:prefLabel "overpopulation"@en .

<http://www.eionet.europa.eu/gemet/concept/5982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2641> ;
    skos:definition "A gaseous chemical element; an essential element in cellular respiration and in combustion processes; the most abundant element in the earth's crust and about 20% of the air by volume."@en ;
    skos:prefLabel "oxygen"@en .

<http://www.eionet.europa.eu/gemet/concept/5986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "Amount of oxygen contained in a solution."@en ;
    skos:prefLabel "oxygen content"@en .

<http://www.eionet.europa.eu/gemet/concept/5994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3692> ;
    skos:definition "The fragile shield of ozone is been damaged by chemicals released on earth. The main chemicals that are depleting stratospheric ozone are chlorofluorocarbons which are used in refrigerators, aerosols, and as cleaners in many industries, and halons, which are used in fire extinguishers. The damage is caused when these chemicals release highly reactive forms of chlorine and bromine. Over the past 30 years ozone levels over parts of Antarctica have dropped by almost 40% during some months and a \"hole\" in ozone concentrations is clearly visible in satellite observations."@en ;
    skos:prefLabel "ozone layer depletion"@en .

<http://www.eionet.europa.eu/gemet/concept/5999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "All products made of any materials of any nature to be used for the containment, protection, handling, delivery and presentation of goods, from raw materials to processed goods, from the producer to the user or the consumer."@en ;
    skos:prefLabel "packaging"@en .

<http://www.eionet.europa.eu/gemet/concept/6007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A mixture of pigment and a vehicle, such as oil or water, that together form a liquid or paste that can be applied to a surface to provide an adherent coating that imparts colour to and often protects the surface."@en ;
    skos:prefLabel "paint"@en .

<http://www.eionet.europa.eu/gemet/concept/6047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "Area where a vehicle can be left for a period of time."@en ;
    skos:prefLabel "parking provision"@en .

<http://www.eionet.europa.eu/gemet/concept/6051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6785> ;
    skos:definition "The act of sharing or taking part in a civic, community or public action."@en ;
    skos:prefLabel "participation"@en .

<http://www.eionet.europa.eu/gemet/concept/6052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7919> ;
    skos:definition """1) Any very small part of matter, such as a molecule, atom, or electron. 
2) Any relatively small subdivision of matter, ranging in diameter from a few angstroms to a few millimeters."""@en ;
    skos:prefLabel "particle"@en .

<http://www.eionet.europa.eu/gemet/concept/6065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3869> ;
    skos:prefLabel "pathologic effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1862> ;
    skos:definition """1) A punishment for a crime.
2) A sum specified in a contract as payable on its breach but not constituting a genuine estimate of the likely loss."""@en ;
    skos:prefLabel "penalty"@en .

<http://www.eionet.europa.eu/gemet/concept/6129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "The capacity of a substance to remain chemically stable. This is an important factor in estimating the environmental effects of substances discharged into the environment. Certain toxic substances (e.g., cyanides) have a low persistence, whereas other less immediately toxic substances (e.g., many organochlorines) have a high persistence and may therefore produce more serious effects."@en ;
    skos:prefLabel "persistence"@en .

<http://www.eionet.europa.eu/gemet/concept/6156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "A fuel for internal combustion engines consisting essentially of volatile flammable liquid hydrocarbons; derived from crude petroleum by processes such as distillation reforming, polymerization, catalytic cracking, and alkilation."@en ;
    skos:prefLabel "petrol"@en .

<http://www.eionet.europa.eu/gemet/concept/6161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6967> ;
    skos:definition "A comparatively volatile liquid bitumen composed principally of hydrocarbon, with traces of sulphur, nitrogen or oxygen compounds; can be removed from the earth in a liquid state."@en ;
    skos:prefLabel "petroleum"@en .

<http://www.eionet.europa.eu/gemet/concept/6179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12379> ;
    skos:definition "Discarded medicinal drugs and related products from pharmacies, hospitals, clinics, pharmaceutical manufacturers, etc."@en ;
    skos:prefLabel "pharmaceutical waste"@en .

<http://www.eionet.europa.eu/gemet/concept/6183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5929> ;
    skos:definition "A white crystalline soluble poisonous acidic derivative of benzene, used as an antiseptic and disinfectant and in the manufacture of resins, nylon, dyes, explosives and pharmaceuticals."@en ;
    skos:prefLabel "phenol"@en .

<http://www.eionet.europa.eu/gemet/concept/6197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6201> ;
    skos:definition "Agents which trigger off photochemical reactions."@en ;
    skos:prefLabel "photochemical agent"@en .

<http://www.eionet.europa.eu/gemet/concept/623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/624> ;
    skos:definition "The Earth's atmosphere consists by volume of nitrogen (79,1%), oxygen (20,9%), carbon dioxide (about 0,03%) and traces of the noble gases (argon, krypton, xenon, helium) plus water vapour, traces of ammonia, organic matter, ozone, various salts and suspended solid particles."@en ;
    skos:prefLabel "atmospheric component"@en .

<http://www.eionet.europa.eu/gemet/concept/624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/245> ;
    skos:definition "The chemical abundance in the earth's atmosphere of its constituents including nitrogen, oxygen, argon, carbon dioxide, water vapour, ozone, neon, helium, krypton, methane, hydrogen and nitrous oxide."@en ;
    skos:prefLabel "atmospheric composition"@en .

<http://www.eionet.europa.eu/gemet/concept/6270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "A line of pipe connected to valves and other control devices, for conducting fluids, gases, or finely divided solids."@en ;
    skos:prefLabel "pipeline"@en .

<http://www.eionet.europa.eu/gemet/concept/6276> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "An extensive, broad tract of level or rolling, almost treeless land with a shrubby vegetation, usually at a low elevation."@en ;
    skos:prefLabel "plain"@en .

<http://www.eionet.europa.eu/gemet/concept/6282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/511> ;
    skos:definition "Small organisms (animals, plants, or microbes) passively floating in water."@en ;
    skos:prefLabel "plankton"@en .

<http://www.eionet.europa.eu/gemet/concept/6298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1899> ;
    skos:definition "Raising a certain type of plant by crossing one variety with another to produce a new variety where the desired characteristics are strongest."@en ;
    skos:prefLabel "plant breeding"@en .

<http://www.eionet.europa.eu/gemet/concept/6304> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:prefLabel "plant disease"@en .

<http://www.eionet.europa.eu/gemet/concept/6316> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6240> ;
    skos:definition "The study of the function and chemical reactions within the various organs of plants."@en ;
    skos:prefLabel "plant physiology"@en .

<http://www.eionet.europa.eu/gemet/concept/6325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5501> ;
    skos:definition "Natural textile fibres of vegetal origin."@en ;
    skos:prefLabel "plant textile fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/6329> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A polymeric material (usually organic) of large molecular weight which can be shaped by flow; usually refers to the final product with fillers, plasticizers, pigments, and stabilizers included (versus the resin, the homogeneous polymeric starting material); examples are polyvinyl chloride, polyethylene, and urea-formaldehyde."@en ;
    skos:prefLabel "plastic"@en .

<http://www.eionet.europa.eu/gemet/concept/633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "A concentration of fine liquid or solid particles, such as dust, smoke, mist, fumes or smog, found in the atmosphere."@en ;
    skos:prefLabel "atmospheric particulate"@en .

<http://www.eionet.europa.eu/gemet/concept/6336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any discarded plastic (organic, or synthetic, material derived from polymers, resins or cellulose) generated by any industrial process, or by consumers."@en ;
    skos:prefLabel "plastic waste"@en .

<http://www.eionet.europa.eu/gemet/concept/6380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6371> ;
    skos:prefLabel "political counselling"@en .

<http://www.eionet.europa.eu/gemet/concept/6397> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6428> ;
    skos:definition "The process by which concentrations of pollutants progressively increase in the tissues of living organisms in environments where these pollutants are present."@en ;
    skos:prefLabel "pollutant accumulation"@en .

<http://www.eionet.europa.eu/gemet/concept/6407> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The spreading of pollutants from a point of release in air, soil and water. The dispersion of air pollutants is heavily influenced by how and where the pollutant is emitted, e.g., by continuous low-level versus accidental releases, multiple stacks versus a few, or the height of the stacks. The nature of the local terrain meteorology and the chemistry of the released material strongly influence the pattern of regional and, finally, global dispersion and transport."@en ;
    skos:prefLabel "pollutant dispersion"@en .

<http://www.eionet.europa.eu/gemet/concept/6409> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "Arrangement, or pattern, associated with the occurrence of pollutants over a geographical area."@en ;
    skos:prefLabel "pollutant distribution"@en .

<http://www.eionet.europa.eu/gemet/concept/6423> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6412> ;
    skos:prefLabel "pollutant mobilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6451> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6469> ;
    skos:definition "Chemical and physical methods to lessen discharges of most pollutants; for carbon dioxide there is, at present, no economic or practical way to reduce the quantities discharged except by reduced fossil fuel usage. Most specific means for removing pollutants from emissions include flue-gas desulphurisation, fluidised combustion, catalytic converters and the redesign of equipment, such as furnace burners and car engines, to lessen the production of pollutants."@en ;
    skos:prefLabel "pollution control"@en .

<http://www.eionet.europa.eu/gemet/concept/6467> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5119> ;
    skos:definition "The assessment of the concentration of pollutants for a given time in a given point."@en ;
    skos:prefLabel "pollution measurement"@en .

<http://www.eionet.europa.eu/gemet/concept/6485> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3819> ;
    skos:definition "PCBs are a family of chemical compounds which do not exist in nature but which are man-made. Commercial mixtures are clear, pale yellow liquids, manufactured by the replacement of hydrogen atoms on the biphenyl molecule by chlorine. Because of their physical properties, PCBs are commonly found in electrical equipment which requires dielectric fluid such as power transformers and capacitors, as well as in hydraulic machinery, vacuum pumps, compressors and heat-exchanger fluids. Other uses include: lubricants, fluorescent light ballasts, paints, glues, waxes, carbonless copy paper, inks including newspapers, dust-control agents for dirt roads, solvents for spreading insecticides, cutting oils. PCBs are stable compounds and although they are no longer manufactured they are extremely persistent and remain in huge quantities in the atmosphere and in landfill sites. They are not water-soluble and float on the surface of water where they are eaten by aquatic animals and so enter the food chain. PCBs are fat-soluble, and are therefore easy to take into the system, but difficult to excrete."@en ;
    skos:prefLabel "polychlorinated biphenyl"@en .

<http://www.eionet.europa.eu/gemet/concept/6492> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6493> ;
    skos:definition "Hydrocarbons containing two or more closed rings of atoms."@en ;
    skos:prefLabel "polycyclic aromatic hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/6493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4091> ;
    skos:definition "Hydrocarbon molecule with two or more nuclei; examples are naphtalene, with two benzene rings side by side, or diphenyl, with two bond-connected benzene rings. Also known as polynuclear hydrocarbon."@en ;
    skos:prefLabel "polycyclic hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/6499> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Substance made of giant molecules formed by the union of simple molecules (monomers)."@en ;
    skos:prefLabel "polymer"@en .

<http://www.eionet.europa.eu/gemet/concept/6505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/87> ;
    skos:definition "Polymer of vinyl chloride; tasteless, odourless; insoluble in most organic solvents; a member of the family of vinyl resins."@en ;
    skos:prefLabel "polyvinyl chloride"@en .

<http://www.eionet.europa.eu/gemet/concept/6517> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The density, dispersal pattern and apportionment of the total number of persons in any area."@en ;
    skos:prefLabel "population distribution"@en .

<http://www.eionet.europa.eu/gemet/concept/6525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6528> ;
    skos:definition "Any shift or migration of a statistically significant number of persons inhabiting a country, district or area."@en ;
    skos:prefLabel "population movement"@en .

<http://www.eionet.europa.eu/gemet/concept/6551> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6861> ;
    skos:definition "State in which the individual lacks the resources necessary for subsistence."@en ;
    skos:prefLabel "poverty"@en .

<http://www.eionet.europa.eu/gemet/concept/6561> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "A stationary plant containing apparatus for large-scale conversion of some form of energy (such as hydraulic, steam, chemical, or nuclear energy) into electrical energy."@en ;
    skos:prefLabel "power station"@en .

<http://www.eionet.europa.eu/gemet/concept/658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13313> ;
    skos:definition "Any means of communication transmitted to both the sense of hearing and the sense of sight, especially technologies directed to large audiences."@en ;
    skos:prefLabel "audiovisual media"@en .

<http://www.eionet.europa.eu/gemet/concept/662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An official certification of competence or a transfer of the right and power to act, including permission from government to use state funds for a particular program or project."@en ;
    skos:prefLabel "authorisation"@en .

<http://www.eionet.europa.eu/gemet/concept/6623> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "Principle adopted by the UN Conference on Environment and Development (1992) that in order to protect the environment, a precautionary approach should be widely applied, meaning that where there are threats of serious or irreversible damage to the environment, lack of full scientific certainty should not be used as a reason for postponing cost-effective measures to prevent environmental degradation."@en ;
    skos:prefLabel "precautionary principle"@en .

<http://www.eionet.europa.eu/gemet/concept/6630> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "The art, process or business of producing reproductions of written text or images in multiple copies, in book, periodical or newspaper formats, or in other similar formats."@en ;
    skos:prefLabel "printing work"@en .

<http://www.eionet.europa.eu/gemet/concept/6637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "The branch of law dealing with such aspects of relationships between individuals that are of no direct concern to the state."@en ;
    skos:prefLabel "private law"@en .

<http://www.eionet.europa.eu/gemet/concept/6710> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "The complex of actions, which have a potential for resulting in a physical change in the environment."@en ;
    skos:prefLabel "project"@en .

<http://www.eionet.europa.eu/gemet/concept/6743> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Natural or man-made areas which have been reserved for conservation, scientific, educational and/or recreational purposes."@en ;
    skos:prefLabel "protected landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/6747> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Area surrounding a water recovery plant in which certain forms of soil utilization are restricted or prohibited in order to protect the groundwater."@en ;
    skos:prefLabel "water protection area"@en .

<http://www.eionet.europa.eu/gemet/concept/6758> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition """1) The original draft of a document.
2) An international agreement of a less formal nature than a treaty. It is often used to amend treaties."""@en ;
    skos:prefLabel "protocol"@en .

<http://www.eionet.europa.eu/gemet/concept/6775> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8141> ;
    skos:definition "Strain or disequilibrium of the mind especially in its affective or cognitive functions, or the physical or mental stimulus, agent or experience that causes such an imbalance."@en ;
    skos:prefLabel "psychological stress"@en .

<http://www.eionet.europa.eu/gemet/concept/6776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The science that deals with the functions of the mind and the behaviour of an organism in relation to its environment."@en ;
    skos:prefLabel "psychology"@en .

<http://www.eionet.europa.eu/gemet/concept/6777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "Any result pertaining to the influence of the mind or higher functions of the brain upon the operations of the body, particularly bodily disorders or diseases."@en ;
    skos:prefLabel "psychosomatic effect"@en .

<http://www.eionet.europa.eu/gemet/concept/678> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3652> ;
    skos:definition "A fall or slide of a large mass, as of snow or rock, down a mountainside."@en ;
    skos:prefLabel "avalanche"@en .

<http://www.eionet.europa.eu/gemet/concept/6785> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7793> ;
    skos:definition "A measure or provision taken on behalf and with the consent of the general populace."@en ;
    skos:prefLabel "public action"@en .

<http://www.eionet.europa.eu/gemet/concept/6793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The theory and practice of governmental money matters, including taxation, spending, transfer and property incomes, borrowing, debt and revenue management."@en ;
    skos:prefLabel "public finance"@en .

<http://www.eionet.europa.eu/gemet/concept/68> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8629> ;
    skos:definition "A radioactive element of the actinide series, occurring as a decay product of uranium. It is used as an alpha particle source and in neutron production."@en ;
    skos:prefLabel "actinium"@en .

<http://www.eionet.europa.eu/gemet/concept/6815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "traffic route construction"@en .

<http://www.eionet.europa.eu/gemet/concept/6821> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:definition "Vehicle for conveying large numbers of paying passengers from one place to another."@en ;
    skos:prefLabel "public transport vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/6831> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4234> ;
    skos:definition "A machine that draws a fluid into itself through an entrance port and forces the fluid out through an exhaust port."@en ;
    skos:prefLabel "pump"@en .

<http://www.eionet.europa.eu/gemet/concept/6842> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Installation where impurities are removed from waste water."@en ;
    skos:prefLabel "purification plant"@en .

<http://www.eionet.europa.eu/gemet/concept/685> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "International rules regulating air transportation."@en ;
    skos:prefLabel "aviation law"@en .

<http://www.eionet.europa.eu/gemet/concept/6867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5286> ;
    skos:definition "An open or surface working or excavation for the extraction of building stone, ore, coal, gravel, or minerals."@en ;
    skos:prefLabel "quarry"@en .

<http://www.eionet.europa.eu/gemet/concept/6887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:definition "Somatic and genetic damage to living organisms caused by exposure to ionizing radiation."@en ;
    skos:prefLabel "radiation damage"@en .

<http://www.eionet.europa.eu/gemet/concept/6901> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5079> ;
    skos:definition "The process, equipment or programming involved in transmitting and receiving sound signals by electromagnetic waves."@en ;
    skos:prefLabel "radio"@en .

<http://www.eionet.europa.eu/gemet/concept/6918> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Any substance that contains one or more radionuclides of which the activity or the concentration cannot be disregarded as far as radiation protection is concerned."@en ;
    skos:prefLabel "radioactive substance"@en .

<http://www.eionet.europa.eu/gemet/concept/6925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "The property possessed by some atomic nuclei of disintegrating spontaneously, with loss of energy through emission of a charged particle and/or gamma radiation."@en ;
    skos:prefLabel "radioactivity"@en .

<http://www.eionet.europa.eu/gemet/concept/6949> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A forest of broad-leaved, mainly evergreen, trees found in continually moist climates in the tropics, subtropics, and some parts of the temperate zones."@en ;
    skos:prefLabel "rain forest"@en .

<http://www.eionet.europa.eu/gemet/concept/6999> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7093> ;
    skos:definition "The process of returning wildlife ecosystems and habitats to their original conditions."@en ;
    skos:prefLabel "fauna restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/7> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Site that cannot be used for any purpose, being contaminated by pollutants, not necessarily radioactive."@en ;
    skos:prefLabel "abandoned industrial site"@en .

<http://www.eionet.europa.eu/gemet/concept/7012> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "Waste materials that are transformed into new products in such a manner that the original products may lose their identity."@en ;
    skos:prefLabel "recycled material"@en .

<http://www.eionet.europa.eu/gemet/concept/7035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "A factory for the purification of some crude material such as ore, sugar, oil, etc."@en ;
    skos:prefLabel "refinery"@en .

<http://www.eionet.europa.eu/gemet/concept/7057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The renewing or reuse of materials such as activated carbon, single ion exchange resins, and filter beds by appropriate means to remove organics, metals, solids, etc."@en ;
    skos:prefLabel "regeneration"@en .

<http://www.eionet.europa.eu/gemet/concept/7082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An instance of or a certificate attesting to the fact of entering in an official list various pieces of information in order to facilitate regulation or authorization, including one's name, contact information and, in some instances, data concerning a specific possession or property."@en ;
    skos:prefLabel "registration"@en .

<http://www.eionet.europa.eu/gemet/concept/7091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "A conservation measure involving the correction of past abuses that have impaired the productivity of the resources base."@en ;
    skos:prefLabel "rehabilitation"@en .

<http://www.eionet.europa.eu/gemet/concept/7104> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "A process of returning natural ecosystems or habitats to their original structure and species composition. Restoration requires a detailed knowledge of the original species, ecosystem functions and interacting processes involved."@en ;
    skos:prefLabel "renaturation"@en .

<http://www.eionet.europa.eu/gemet/concept/7114> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320> ;
    skos:definition "Substitution of an atom or atomic group with a different one."@en ;
    skos:prefLabel "replacement"@en .

<http://www.eionet.europa.eu/gemet/concept/7116> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:prefLabel "reporting process"@en .

<http://www.eionet.europa.eu/gemet/concept/7137> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:definition "An area of land and/or of water designated as having protected status for purposes of preserving certain biological features. Reserves are managed primarily to safeguard these features and provide opportunities for research into the problems underlying the management of natural sites and of vegetation and animal populations. Regulations are normally imposed controlling public access and disturbance."@en ;
    skos:prefLabel "biological reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/7143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "Area that has only private houses, not offices and factories."@en ;
    skos:prefLabel "residential area"@en .

<http://www.eionet.europa.eu/gemet/concept/7169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Assessment of the availability of resources in a given area."@en ;
    skos:prefLabel "resource appraisal"@en .

<http://www.eionet.europa.eu/gemet/concept/7176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "The process in living organisms of taking in oxygen from the surroundings and giving out carbon dioxide."@en ;
    skos:prefLabel "respiration"@en .

<http://www.eionet.europa.eu/gemet/concept/7179> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "respiratory disease"@en .

<http://www.eionet.europa.eu/gemet/concept/7184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/103> ;
    skos:definition "The obligation to answer for an act done, and to repair or otherwise make restitution for any injury it may have caused."@en ;
    skos:prefLabel "responsibility"@en .

<http://www.eionet.europa.eu/gemet/concept/7231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3648> ;
    skos:definition "The slow vertical instability of the earth crust involving up-and-down movements as in the volcanic district west of Naples, Italy."@en ;
    skos:prefLabel "rising (geological)"@en .

<http://www.eionet.europa.eu/gemet/concept/7319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "Any established or selected course for passage or travel."@en ;
    skos:prefLabel "route"@en .

<http://www.eionet.europa.eu/gemet/concept/7320> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8648> ;
    skos:definition "The activity of designing, organizing or preparing for the construction of boulevards, turnpikes, highways and other roads."@en ;
    skos:prefLabel "route planning"@en .

<http://www.eionet.europa.eu/gemet/concept/7327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and marketing of natural or synthetic rubber products."@en ;
    skos:prefLabel "rubber processing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/733> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3529> ;
    skos:prefLabel "basidiomycete"@en .

<http://www.eionet.europa.eu/gemet/concept/7390> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "Amount of salt contained in a solution."@en ;
    skos:prefLabel "salt content"@en .

<http://www.eionet.europa.eu/gemet/concept/7407> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The obtaining of small representative quantities of material for the purpose of analysis."@en ;
    skos:prefLabel "sampling"@en .

<http://www.eionet.europa.eu/gemet/concept/7486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7483> ;
    skos:definition "Any metal material discarded from manufacturing operations and usually suitable for reprocessing."@en ;
    skos:prefLabel "scrap metal"@en .

<http://www.eionet.europa.eu/gemet/concept/7502> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "Large-scale horizontal water motion within an ocean. The way energy from the sun, stored in the sea, is transported around the world. The currents explain, for example, why the UK has ice-free ports in winter, while St. Petersburg, at the same latitude as the Shetland Islands, needs ice breakers. Evidence is growing that the world's ocean circulation was very different during the last ice age and has changed several times in the distant past, with dramatic effects on climate. The oceans are vital as storehouses, as they absorb more than half the sun's heat reaching the earth. This heat, which is primarily absorbed near the equator is carried around the world and released elsewhere, creating currents which last up to 1.000 years. As the Earth rotates and the wind acts upon the surface, currents carry warm tropical water to the cooler parts of the world. The strength and direction of the currents are affected by landmasses, bottlenecks through narrow straits, and even the shape of the sea-bed. When the warm water reaches polar regions its heat evaporates into the atmosphere, reducing its temperature and increasing its density. When sea-water freezes it leaves salt behind in the unfrozen water and this cold water sinks into the ocean and begins to flow back to the tropics. Eventually it is heated and begins the cycle all over again."@en ;
    skos:prefLabel "sea circulation"@en .

<http://www.eionet.europa.eu/gemet/concept/751> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7528> ;
    skos:definition "The unconsolidated material that covers a gently sloping zone, typically with a concave profile, extending landward from the low-water line to the place where there is a definite change in material or physiographic from (such as a cliff), or to the line of permanent vegetation (usually the effective limit of the highest storm waves); a shore of body of water, formed and washed by waves or tides, usually covered by sand or gravel, and lacking a bare rocky surface."@en ;
    skos:prefLabel "beach"@en .

<http://www.eionet.europa.eu/gemet/concept/7516> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Luting, making watertight, waterproofing."@en ;
    skos:prefLabel "sealing"@en .

<http://www.eionet.europa.eu/gemet/concept/7528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:definition "The zone of unconsolidated material that extends landward from the low water-line to where there is marked change in material or physiographic form or to the line of permanent vegetation."@en ;
    skos:prefLabel "seashore"@en .

<http://www.eionet.europa.eu/gemet/concept/7531> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5236> ;
    skos:definition "The periodic movement of a population from one region or climate to another in accordance with the yearly cycle of weather and temperature changes."@en ;
    skos:prefLabel "seasonal migration"@en .

<http://www.eionet.europa.eu/gemet/concept/7581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The official or legally authorized act of taking away possessions or property, often for a violation of law or to enforce a judgment imposed by a court of law."@en ;
    skos:prefLabel "seizure"@en .

<http://www.eionet.europa.eu/gemet/concept/7609> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9054> ;
    skos:definition "The collection of individual components of solid waste from any source, usually separated into different collection containers, in order to recover, reuse or recycle the material or to facilitate its collection and disposal."@en ;
    skos:prefLabel "separated collection"@en .

<http://www.eionet.europa.eu/gemet/concept/7616> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7411> ;
    skos:definition """1) A legal term referring generally to the act of valuable property being taken into custody by an agent of the court and locked away for safekeeping, usually to prevent the property from being disposed of or abused before a dispute over its ownership can be resolved.
2) The taking of someone's property, voluntarily (by deposit) or involuntarily (by seizure), by court officers or into the possession of a third party, awaiting the outcome of a trial in which ownership of that property is at issue."""@en ;
    skos:prefLabel "sequestration"@en .

<http://www.eionet.europa.eu/gemet/concept/7617> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7124> ;
    skos:definition "Any reptile of the suborder Ophidia, typically having a scaly cylindrical limbless body, fused eyelids, and a jaw modified for swallowing large prey: includes venomous forms such as cobras and rattlesnakes, large nonvenomous constrictors, and small harmless types such as the grass snake."@en ;
    skos:prefLabel "snake"@en .

<http://www.eionet.europa.eu/gemet/concept/7627> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6447> ;
    skos:definition "A tank into which a two-phase mixture is fed and the entrained solids settle by gravity during storage."@en ;
    skos:prefLabel "settling tank"@en .

<http://www.eionet.europa.eu/gemet/concept/7679> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1921> ;
    skos:definition "A performance, program or exhibition providing entertainment to a group of people, displayed either through some communication media, such as radio or television, or live at a museum or theater."@en ;
    skos:prefLabel "show"@en .

<http://www.eionet.europa.eu/gemet/concept/7709> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "The process of choosing or picking a location or area for some designated purpose."@en ;
    skos:prefLabel "site selection"@en .

<http://www.eionet.europa.eu/gemet/concept/7742> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9254> ;
    skos:definition "Vertical sliding gate or valve to regulate the flow of water in a channel or lock."@en ;
    skos:prefLabel "sluice"@en .

<http://www.eionet.europa.eu/gemet/concept/7759> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Air pollution consisting of smoke and fog. The air pollution caused by the action of sunlight on unburned hydrocarbons and nitrogen oxides, mostly from car exhaust. It occurs over large industrial areas and urban complexes, and causes eye irritations, breathing problems and damage to plant life."@en ;
    skos:prefLabel "smog"@en .

<http://www.eionet.europa.eu/gemet/concept/7790> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The state of nations and the hystorical processes of change experienced by them. The concept of development subsumes associated cultural and political changes as well as welfare measures which reflect distribution of goods, wealth and opportunities."@en ;
    skos:prefLabel "social development"@en .

<http://www.eionet.europa.eu/gemet/concept/7795> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7622> ;
    skos:definition "Any structure designed, built or installed to provide space for living or interaction among persons in a community."@en ;
    skos:prefLabel "social facility"@en .

<http://www.eionet.europa.eu/gemet/concept/7805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "A organized effort by a significant number of people to change (or resist change in) some major aspect or aspects of society."@en ;
    skos:prefLabel "social movement"@en .

<http://www.eionet.europa.eu/gemet/concept/7810> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7793> ;
    skos:definition "A generic term applied to the range of conditions and aberrant behaviours which are considered to be manifestations of social disorganization and to warrant changing via some means of social engineering. Typically, these problems include many forms of deviant behaviour (such as crime, juvenile delinquency, prostitution, mental illness, drug addiction, suicide) and of social conflict (ethnic tension, domestic violence, industrial strife, and so forth)."@en ;
    skos:prefLabel "social problem"@en .

<http://www.eionet.europa.eu/gemet/concept/7815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:prefLabel "social security"@en .

<http://www.eionet.europa.eu/gemet/concept/7816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "Welfare activities organized by the state or a local authority and carried out by trained personnel."@en ;
    skos:prefLabel "social service"@en .

<http://www.eionet.europa.eu/gemet/concept/7851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7899> ;
    skos:definition "Description of the character of the surface of the ground at the time of observation, especially in relation to the influence of rain and snow."@en ;
    skos:prefLabel "soil condition"@en .

<http://www.eionet.europa.eu/gemet/concept/7857> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236>,
        <http://www.eionet.europa.eu/gemet/concept/15214> ;
    skos:definition "Soil may deteriorate either by physical movement of soil particles from a given site or by depletion of the water-soluble elements in the soil which contribute to the nourishment of crop, plants, grasses, trees, and other economically usable vegetation. The physical movement generally is referred to as erosion. Wind, water, glacial ice, animals and tools in use may be agents of erosion."@en ;
    skos:prefLabel "soil degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/7861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The application of any organic or inorganic material of natural or synthetic origins to a soil to supply one or more elements essential to the growth of plants."@en ;
    skos:prefLabel "soil fertilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/7866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7882> ;
    skos:definition "Distinctive successive layers of soil produced by internal redistribution processes. Conventionally the layers have been divided into A, B and C horizons. The A horizon is the upper layer, containing humus and is leached and/or eluviated of many minerals. The B horizon forms a zone of deposition and is enriched with clay minerals and iron/aluminium oxides from the A layer. The C layer is the parent material for the present soil and may be partially weathered rock, transported glacial or alluvial material or an earlier soil."@en ;
    skos:prefLabel "soil layer"@en .

<http://www.eionet.europa.eu/gemet/concept/7874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7902> ;
    skos:definition """1) Water stored in soils.
2) One of the most important elements involved in pedological processes and plant growth. There are three basic forms: a) water adhering in thin films by molecular attraction to the surface of soil particles and not available for plants is termed hygroscopic water. b) Water forming thicker films and occupying the smaller pore spaces is termed capillary water. Since it is held against the force of gravity it is permanently available for plant growth and it is this type of soil water which contains plant nutrients in solution. c) Water in excess of hygroscopic and capillary water is termed gravitational water, which is of a transitory nature because it flows away under the influence of gravity. When the excess has drained away the amount of water retained in the soil is termed its field capacity, when some of its pore spaces are still free of water."""@en ;
    skos:prefLabel "soil moisture"@en .

<http://www.eionet.europa.eu/gemet/concept/7876> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15296>,
        <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Organisms which live in the soil."@en ;
    skos:prefLabel "soil organism"@en .

<http://www.eionet.europa.eu/gemet/concept/7902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "Water stored in soils."@en ;
    skos:prefLabel "soil water"@en .

<http://www.eionet.europa.eu/gemet/concept/7905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Device which converts the energy from light into electricity. The collector system contains a concentrator and a receiver. The concentrator redirects and focuses sunlight on the receiver by using mirrors or lenses, and the receiver absorbs solar radiation and converts it to heat."@en ;
    skos:prefLabel "solar collector"@en .

<http://www.eionet.europa.eu/gemet/concept/7925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Substance, generally a liquid, capable of dissolving another substance."@en ;
    skos:prefLabel "solvent"@en .

<http://www.eionet.europa.eu/gemet/concept/7936> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "Diffusion into the environment of a sound emitted from a given source."@en ;
    skos:prefLabel "sound emission"@en .

<http://www.eionet.europa.eu/gemet/concept/7937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4146> ;
    skos:definition "The introduction in the environment of noise deriving from various sources that can be grouped in: transportation activities, industrial activities and daily normal activities."@en ;
    skos:prefLabel "sound immission"@en .

<http://www.eionet.europa.eu/gemet/concept/7962> a skos:Concept ;
    skos:definition "Space extending between the sun and the planets of the solar system. Interplanetary space is not empty, but contains dust, particles with an electric charge, and the magnetic field of the sun (also called the IMF, or Interplanetary Magnetic Field)."@en ;
    skos:prefLabel "space (interplanetary)"@en .

<http://www.eionet.europa.eu/gemet/concept/7976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "Evolutionary adaptation to a particular mode of life or habitat."@en ;
    skos:prefLabel "specialisation (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/7981> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste which must be handled in a particular manner and for which particular rules apply."@en ;
    skos:prefLabel "special waste"@en .

<http://www.eionet.europa.eu/gemet/concept/8008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7001> ;
    skos:definition "The complex of individual or group activities pursued for exercise or pleasure, often taking a competitive form."@en ;
    skos:prefLabel "sport"@en .

<http://www.eionet.europa.eu/gemet/concept/8037> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/186> ;
    skos:definition "A building or structure usually with stalls that is used to house and feed horses, cattle or other animals."@en ;
    skos:prefLabel "stable"@en .

<http://www.eionet.europa.eu/gemet/concept/8048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "The act of conforming to a rule."@en ;
    skos:prefLabel "standardisation"@en .

<http://www.eionet.europa.eu/gemet/concept/8056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5765> ;
    skos:definition "The most commonly or regularly eaten food in a country or community and which forms the mainstay of the total calorie supply, especially in the poorer populations and at times of food shortage."@en ;
    skos:prefLabel "staple food"@en .

<http://www.eionet.europa.eu/gemet/concept/8077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:definition "Determination of the quantity and character of the wastes discarded by a community, by spot sampling procedure."@en ;
    skos:prefLabel "waste statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/8102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8563> ;
    skos:definition "The counting over of materials or goods on hand, as in a stockroom or store."@en ;
    skos:prefLabel "stocktaking"@en .

<http://www.eionet.europa.eu/gemet/concept/8115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "An atmospheric disturbance involving perturbations of the prevailing pressure and wind fields on scales ranging from tornadoes to extratropical cyclones; also the associated weather and the like."@en ;
    skos:prefLabel "storm"@en .

<http://www.eionet.europa.eu/gemet/concept/8192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Any compound that includes one or more sulfur atoms with a more electropositive element, either carbon, metal or some other nonoxygen atom."@en ;
    skos:prefLabel "sulphide"@en .

<http://www.eionet.europa.eu/gemet/concept/8212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:definition "The oversight or direction in the construction and maintenance of houses, facilities, offices and other structures."@en ;
    skos:prefLabel "supervision of building works"@en .

<http://www.eionet.europa.eu/gemet/concept/8252> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9297> ;
    skos:definition "An periodically inundated area of low ground having shrubs and trees, with or without the formation of peat."@en ;
    skos:prefLabel "marsh"@en .

<http://www.eionet.europa.eu/gemet/concept/8255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "A sweetening agent, especially one that does not contain sugar."@en ;
    skos:prefLabel "sweetener"@en .

<http://www.eionet.europa.eu/gemet/concept/8280> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2510> ;
    skos:definition "The science concerned with the general study of structures and behaviours of systems which may be applicable in different branches of learning."@en ;
    skos:prefLabel "systems theory"@en .

<http://www.eionet.europa.eu/gemet/concept/8299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A collection of people selected and approached by some entity for a variety of purposes, including assistance, recruitment, information dissemination, marketing and research."@en ;
    skos:prefLabel "target group"@en .

<http://www.eionet.europa.eu/gemet/concept/8301> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6602> ;
    skos:definition "A classified list or scale of charges made in any private or public business."@en ;
    skos:prefLabel "tariff"@en .

<http://www.eionet.europa.eu/gemet/concept/8334> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3852>,
        <http://www.eionet.europa.eu/gemet/concept/7233> ;
    skos:definition "Any application of practical or mechanical sciences to industry or commerce capable of harming persons, property or the environment."@en ;
    skos:prefLabel "technological hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/8351> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "The use of radio waves, telephone lines, etc., to transmit the readings of measuring instruments to a device on which the readings can be indicated or recorded."@en ;
    skos:prefLabel "telemetry"@en .

<http://www.eionet.europa.eu/gemet/concept/8353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5079> ;
    skos:definition "The process, equipment or programming involved in converting a succession of audiovisual images into corresponding electrical signals that are transmitted by means of electromagnetic waves to distant receivers or screens, at which the signals can be used to reproduce the original image."@en ;
    skos:prefLabel "television"@en .

<http://www.eionet.europa.eu/gemet/concept/8361> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "Mixed forest of conifers and broad-leaf deciduous trees, or mixed conifer and broad-leaf evergreen trees, or entirely broad-leaf deciduous, or entirely broad-leaf evergreen trees, found in temperate regions across the world; characterized by high rainfall, warm summers, cold winters occasionally subzero, seasonality; typically with dense canopies, understorey saplings and tall shrubs, large animals, carnivores dominant, very rich in bird species."@en ;
    skos:prefLabel "temperate forest"@en .

<http://www.eionet.europa.eu/gemet/concept/8398> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which determines the present and future use of each parcel of land in an area."@en ;
    skos:prefLabel "territorial policy"@en .

<http://www.eionet.europa.eu/gemet/concept/841> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "The analysis of a substance in order to ascertain its influence on living organisms."@en ;
    skos:prefLabel "biological analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/8415> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Any animal organism used for scientific research."@en ;
    skos:prefLabel "test organism"@en .

<http://www.eionet.europa.eu/gemet/concept/8422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A material made of natural or man-made fibers and used for the manufacture of items such as clothing and furniture fittings."@en ;
    skos:prefLabel "textile"@en .

<http://www.eionet.europa.eu/gemet/concept/846> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The action of growing of living organisms."@en ;
    skos:prefLabel "biological development"@en .

<http://www.eionet.europa.eu/gemet/concept/8478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7402> ;
    skos:definition "Any water whose level changes periodically due to tidal action."@en ;
    skos:prefLabel "tidal water"@en .

<http://www.eionet.europa.eu/gemet/concept/8541> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "The process of characterizing and evaluating the inherent toxicity of a chemical substance, a poison, etc."@en ;
    skos:prefLabel "toxicological assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/8543> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "A science that deals with poisons, their actions, their detection, and the treatment of the conditions they produce."@en ;
    skos:prefLabel "toxicology"@en .

<http://www.eionet.europa.eu/gemet/concept/8559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "A large group of plants characterized by the presence of specialized conducting tissues (xylem and phloem) in the roots, stems, and leaves."@en ;
    skos:prefLabel "tracheophyte"@en .

<http://www.eionet.europa.eu/gemet/concept/8566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The act or process of buying, selling, or exchanging commodities and the use of goods and services."@en ;
    skos:prefLabel "trade and consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/8574> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8573> ;
    skos:definition "Commercial discrimination that apply to the exports of certain countries but not to similar goods from other countries."@en ;
    skos:prefLabel "trade restriction"@en .

<http://www.eionet.europa.eu/gemet/concept/8583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25> ;
    skos:definition "An unexpected incident with potential for harm occurring through the movement or collision of vessels, vehicles or persons along a land, water, air or space route."@en ;
    skos:prefLabel "traffic accident"@en .

<http://www.eionet.europa.eu/gemet/concept/8585> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "The organization of a more efficient movement of traffic within a given road network by rearranging the flows, controlling the intersections and regulating the times and places for parking."@en ;
    skos:prefLabel "traffic control"@en .

<http://www.eionet.europa.eu/gemet/concept/8589> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12586> ;
    skos:definition "The determination of the required capacity and layout of highway and street facilities that can safely and economically serve vehicular movement between given points."@en ;
    skos:prefLabel "traffic engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/8627> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "A small village, community or group of houses, or other shelters, usually located in a thinly populated area and existing there for only a short time."@en ;
    skos:prefLabel "transitional settlement"@en .

<http://www.eionet.europa.eu/gemet/concept/8650> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "Transfer of mass, momentum, or energy in a system as a result of molecular agitation, including such properties as thermal conduction and viscosity."@en ;
    skos:prefLabel "transport (physics)"@en .

<http://www.eionet.europa.eu/gemet/concept/8658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Moving from one place to another generally by using a transportation mean."@en ;
    skos:prefLabel "travel"@en .

<http://www.eionet.europa.eu/gemet/concept/8663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "An international agreement in writing between two states or a number of states. Treaties are binding in international law; some treaties create law only for those states that are parties to them."@en ;
    skos:prefLabel "treaty"@en .

<http://www.eionet.europa.eu/gemet/concept/8673> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3937> ;
    skos:definition "Azines that contain three nitrogen atoms in their molecules."@en ;
    skos:prefLabel "triazine"@en .

<http://www.eionet.europa.eu/gemet/concept/8685> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting system of a biological community and its non-living environmental surroundings in the land and water of the equatorial region between the Tropic of Cancer and the Tropic of Capricorn."@en ;
    skos:prefLabel "tropical ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/87> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6499> ;
    skos:definition "A polymer formed by the chain addition of unsaturated monomer molecules, such as olefins, with one another without the formation of a by-product, as water; examples are polyethylene, polypropylene and polystyrene."@en ;
    skos:prefLabel "addition polymer"@en .

<http://www.eionet.europa.eu/gemet/concept/8731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "A rubber ring placed over the rim of a wheel of a road vehicle to provide traction and reduce road shocks."@en ;
    skos:prefLabel "tyre"@en .

<http://www.eionet.europa.eu/gemet/concept/8766> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4082> ;
    skos:definition "Point of water disposal located below the sea surface."@en ;
    skos:prefLabel "underwater outlet"@en .

<http://www.eionet.europa.eu/gemet/concept/88> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Substances mixed in small quantities with another product to modify its chemical or physical state. Additives are used to make food look visually more attractive, in the case of colouring agents, as well as to preserve and extend the life of the product."@en ;
    skos:prefLabel "additive"@en .

<http://www.eionet.europa.eu/gemet/concept/8829> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4635> ;
    skos:definition "The activity of designing, organizing or preparing for the future lay-out and condition of a city or town."@en ;
    skos:prefLabel "urban planning"@en .

<http://www.eionet.europa.eu/gemet/concept/885> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "A renewable energy source that makes use of such biofuels as methane (biogas) generated by sewage, farm, industrial, or household organic waste materials. Other biofuels include trees grown in so-called \"energy forests\" or other plants, such as sugar cane, grown for their energy potential. Biomass energy relies on combustion and therefore produces carbon dioxide; its use would not, therefore, alleviate the greenhouse effect."@en ;
    skos:prefLabel "biomass energy"@en .

<http://www.eionet.europa.eu/gemet/concept/8894> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2050> ;
    skos:definition "The deliberate or wanton destruction of personal or public property caused by a vandal."@en ;
    skos:prefLabel "vandalism"@en .

<http://www.eionet.europa.eu/gemet/concept/8919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/873> ;
    skos:prefLabel "plant resource"@en .

<http://www.eionet.europa.eu/gemet/concept/8920> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3388> ;
    skos:definition "Any of various herbaceous plants having parts that are used as food."@en ;
    skos:prefLabel "vegetable"@en .

<http://www.eionet.europa.eu/gemet/concept/8925> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8922> ;
    skos:definition "A community of plants or plant life that share distinguishable characteristics."@en ;
    skos:prefLabel "vegetation type"@en .

<http://www.eionet.europa.eu/gemet/concept/8929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3045> ;
    skos:definition "An aeriform fluid of fine particles suspended in air, produced and vented as a byproduct of the operation of wheeled machines or conveyances self-propelled by internal combustion engines."@en ;
    skos:prefLabel "vehicle exhaust gas"@en .

<http://www.eionet.europa.eu/gemet/concept/895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5161> ;
    skos:definition "Production, by synthesis or degradation, of a chemical compound by a living organism."@en ;
    skos:prefLabel "biosynthesis"@en .

<http://www.eionet.europa.eu/gemet/concept/8959> a skos:Concept ;
    skos:definition "A periodic motion of small amplitude and high frequency, characteristic of elastic bodies."@en ;
    skos:prefLabel "vibration"@en .

<http://www.eionet.europa.eu/gemet/concept/8976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "Submicroscopic agents that infect plants, animals and bacteria, and are unable to reproduce outside the tissues of the host. A fully formed virus consists of nucleic acid (DNA or RNA) surrounded by a protein and lipid (fat) coat. The nucleic acid of the virus interferes with nucleic acid-synthesizing mechanism of the host cell, organizing it to produce more viral nucleic acid. Viruses cause many diseases (e.g., mosaic diseases of many cultivated plants, myxomatosis, foot and mouth disease, the common cold, influenza, measles, poliomyelitis). Many plant viruses are transmitted by insects, some by eelworms. Animal viruses are spread by contact, droplet infection or by insect vectors and some are spread by the exchange of body fluids."@en ;
    skos:prefLabel "virus"@en .

<http://www.eionet.europa.eu/gemet/concept/899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "The influence upon the environment of organisms owing to the presence and activities of other organisms, as distinct from a physical, abiotic, environmental factor."@en ;
    skos:prefLabel "biotic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/9003> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3648> ;
    skos:definition "The processes by which magma and its associated gases rise into the crust and are extruded onto the Earth's surface and into the atmosphere."@en ;
    skos:prefLabel "volcanism"@en .

<http://www.eionet.europa.eu/gemet/concept/9044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/397> ;
    skos:definition "An investigation carried out to decide what arrangements are appropriate for dealing with different kinds of wastes."@en ;
    skos:prefLabel "waste analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/9053> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1447> ;
    skos:definition "The arrangement of unwanted materials left over from manufacturing processes or refuse from places of human or animal habitation into a variety of categories based on chemical and microbiological constituents or other common characteristics."@en ;
    skos:prefLabel "waste classification"@en .

<http://www.eionet.europa.eu/gemet/concept/9073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3063> ;
    skos:definition "Transporting unwanted materials, including those leftover from a manufacturing processes, refuse, or trash to other countries or areas for the conduct of foreign trade."@en ;
    skos:prefLabel "waste export"@en .

<http://www.eionet.europa.eu/gemet/concept/9098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Oil arising as a waste product of the use of oils in a wide range of industrial and commercial activities, such as engineering, power generation and vehicle maintenance and should be properly disposed of, or treated in order to be reused."@en ;
    skos:prefLabel "waste oil"@en .

<http://www.eionet.europa.eu/gemet/concept/9108> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9008> ;
    skos:definition "Practices that reduce the amount of waste generated by a specific source through the redesigning of products or patterns of production or consumption."@en ;
    skos:prefLabel "waste reduction"@en .

<http://www.eionet.europa.eu/gemet/concept/9116> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9125> ;
    skos:definition "Separating waste into different materials, such as glass, metal, paper, plastic, etc."@en ;
    skos:prefLabel "waste sorting"@en .

<http://www.eionet.europa.eu/gemet/concept/9144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Plant where, through physical-chemical and biological processes, organic matter, bacteria, viruses and solids are removed from residential, commercial and industrial wastewaters before they are discharged in rivers, lakes and seas."@en ;
    skos:prefLabel "waste water treatment plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "The protection, development and efficient management of water resources for beneficial purposes."@en ;
    skos:prefLabel "water conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/9160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1745> ;
    skos:definition "The utilization patterns and quantities entailed in a community or human group's use of water for survival, comfort and enjoyment."@en ;
    skos:prefLabel "water consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/9166> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2829> ;
    skos:definition "Can be caused by a variety of means, e.g. farm pollution from animal wastes and silage liquor (liquors from green leaf cattle food which has had molasses added to promote fermentation and preservation; they are highly polluting and can be a seasonal cause of fish deaths in small streams), leachate from landfill sites, and spoil heaps, solvent discharge to sewers or to land and inadequate sewage treatment works."@en ;
    skos:prefLabel "water endangering"@en .

<http://www.eionet.europa.eu/gemet/concept/9216> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "Water quality management concerns four major elements: the use (recreation, drinking water, fish and wildlife propagation, industrial or agricultural) to be made of the water; criteria to protect those uses; implementation plans (for needed industrial-municipal waste treatment improvements) and enforcement plans, and an anti-degradation statement to protect existing high quality waters."@en ;
    skos:prefLabel "water quality management"@en .

<http://www.eionet.europa.eu/gemet/concept/9221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:definition "Water in any of its forms, wherever located - atmosphere, surface or ground - which is or can be of value to man."@en ;
    skos:prefLabel "water resource"@en .

<http://www.eionet.europa.eu/gemet/concept/9259> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15266>,
        <http://www.eionet.europa.eu/gemet/concept/15271>,
        <http://www.eionet.europa.eu/gemet/concept/5668> ;
    skos:definition "Power extracted from the motion of sea waves at the coast."@en ;
    skos:prefLabel "wave energy"@en .

<http://www.eionet.europa.eu/gemet/concept/9262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "A moving ridge or swell of water occurring close to the surface of the sea, characterized by oscillating and rising and falling movements, often as a result of the frictional drag of the wind."@en ;
    skos:prefLabel "sea wave"@en .

<http://www.eionet.europa.eu/gemet/concept/9270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9269> ;
    skos:definition "The complex of meteorological characteristics in a given region."@en ;
    skos:prefLabel "weather condition"@en .

<http://www.eionet.europa.eu/gemet/concept/9274> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9269> ;
    skos:definition "The changing of natural weather phenomena by technical means."@en ;
    skos:prefLabel "weather modification"@en .

<http://www.eionet.europa.eu/gemet/concept/9290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "A hole dug into the earth to reach a supply of water, oil, brine or gas."@en ;
    skos:prefLabel "well"@en .

<http://www.eionet.europa.eu/gemet/concept/9294> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/598> ;
    skos:definition "A geographic region of Asia that includes Turkey, Iran and other countries of the Middle East and the Arabian peninsula."@en ;
    skos:prefLabel "Western Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/932> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition """1) A chemical, such as an aromatic acyl peroxide or monoperoxiphthalic acid, used to bleach flour, fats, oils and other edibles. 
2) An oxidizing or reducing chemical such as sodium hypochlorite, sulfur dioxide, sodium acid sulfite, or hydrogen peroxide."""@en ;
    skos:prefLabel "bleaching agent"@en .

<http://www.eionet.europa.eu/gemet/concept/9321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition """1) An area, usually in natural condition, which is reserved (set aside) by a governmental or private agency for the protection of particular species of animals during part or all of the year. 
2) An area designated for the protection of wild animals, within which hunting and fishing is either prohibited or strictly controlled."""@en ;
    skos:prefLabel "wildlife sanctuary"@en .

<http://www.eionet.europa.eu/gemet/concept/9324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:prefLabel "willingness-to-pay"@en .

<http://www.eionet.europa.eu/gemet/concept/9391> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10026> ;
    skos:definition "An act contrary to the rules of natural or legal justice."@en ;
    skos:prefLabel "wrongful act"@en .

<http://www.eionet.europa.eu/gemet/concept/9425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "The study of animals, including their classification, structure, physiology, and history."@en ;
    skos:prefLabel "zoology"@en .

<http://www.eionet.europa.eu/gemet/concept/977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8769> ;
    skos:definition "Any animal belonging to the Bovidae family."@en ;
    skos:prefLabel "bovid"@en .

<http://www.eionet.europa.eu/gemet/concept/10003> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:prefLabel "animal life"@en .

<http://www.eionet.europa.eu/gemet/concept/10012> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3715> ;
    skos:definition "A central government organization that has authority or oversight over government activity relating to the preservation and safeguarding of ecological or natural resources."@en ;
    skos:prefLabel "environmental administration institution"@en .

<http://www.eionet.europa.eu/gemet/concept/10053> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7236> ;
    skos:definition "The process of evaluating and selecting alternative regulatory and non-regulatory responses to prepare for the probability of an accidental occurrence and its expected magnitude of damage, including the consideration of legal, economic and behavioral factors."@en ;
    skos:prefLabel "risk management"@en .

<http://www.eionet.europa.eu/gemet/concept/10073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7982> ;
    skos:definition "Species belonging to the animal kingdom."@en ;
    skos:prefLabel "animal species"@en .

<http://www.eionet.europa.eu/gemet/concept/10076> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:prefLabel "occupation"@en .

<http://www.eionet.europa.eu/gemet/concept/10099> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3232> ;
    skos:definition "Environment where the manifold activities connected with the production of goods and services take place."@en ;
    skos:prefLabel "industrial environment (in general)"@en .

<http://www.eionet.europa.eu/gemet/concept/1020> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Woody vegetation including shrubs and scrub trees of non-commercial height and form, often seen in the initial stages of succession following a disturbance. Brush often grows in very dense thickets that are impenetrable to wild animals and serve to suppress the growth of more desirable crop trees. However, brush can also serve an important function as desirable habitat for a range or bird, animal, and invertebrate species, and often provides a good source of browse and cover for larger wildlife. It adds structural diversity within the forest and is important in riparian zones. It is also termed scrub."@en ;
    skos:prefLabel "brushwood"@en .

<http://www.eionet.europa.eu/gemet/concept/10212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:definition "Sea area where marine wildlife is protected."@en ;
    skos:prefLabel "protected marine zone"@en .

<http://www.eionet.europa.eu/gemet/concept/1041> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1065> ;
    skos:definition "Area of land suitable for building on."@en ;
    skos:prefLabel "building land"@en .

<http://www.eionet.europa.eu/gemet/concept/1044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:prefLabel "building materials industry"@en .

<http://www.eionet.europa.eu/gemet/concept/1063> a skos:Concept ;
    skos:definition "That part of the physical surroundings which are people-made or people-organized, such as buildings and other major structures, roads, bridges and the like, down to lesser objects such as traffic lights, telephone and pillar boxes."@en ;
    skos:prefLabel "built environment"@en .

<http://www.eionet.europa.eu/gemet/concept/10837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:definition "The coordination or structuring of work practices and production processes in order to influence the way jobs are designed and performed in the workplace."@en ;
    skos:prefLabel "organisation of work"@en .

<http://www.eionet.europa.eu/gemet/concept/10898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "Provision of accommodation for rest or for residence in a room or rooms or in a dwelling place."@en ;
    skos:prefLabel "lodging"@en .

<http://www.eionet.europa.eu/gemet/concept/11> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Physical, chemical and other non-living environmental factors. They are essential for living plants and animals of an ecosystem, providing the essential elements and nutrients that are necessary for growth. The abiotic elements also include the climatic and pedologic components of the ecosystem."@en ;
    skos:prefLabel "abiotic factor"@en .

<http://www.eionet.europa.eu/gemet/concept/11034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "Organised method of recording all business transactions in the national economy."@en ;
    skos:prefLabel "national accounting"@en .

<http://www.eionet.europa.eu/gemet/concept/11044> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "Monetary resources set aside for some purpose."@en ;
    skos:prefLabel "financial fund"@en .

<http://www.eionet.europa.eu/gemet/concept/1126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9254> ;
    skos:definition "An artificial open waterway used for transportation, waterpower, or irrigation."@en ;
    skos:prefLabel "canal"@en .

<http://www.eionet.europa.eu/gemet/concept/1148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5390> ;
    skos:definition "A four-wheeled motor vehicle used for land transport, usually propelled by a gasoline or diesel internal combustion engine."@en ;
    skos:prefLabel "car"@en .

<http://www.eionet.europa.eu/gemet/concept/11527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:prefLabel "right of access"@en .

<http://www.eionet.europa.eu/gemet/concept/11531> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8240> ;
    skos:definition "An investigation, especially a formal one conducted into a matter of public utility by a body constituted for that purpose by a government, local authority, or other organization."@en ;
    skos:prefLabel "public inquiry"@en .

<http://www.eionet.europa.eu/gemet/concept/11594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4535> ;
    skos:definition "An organ of the government, belonging to the judicial department, whose function is the application of the laws to controversies brought before it and the public administration of justice. The presence of a sufficient number of the members of such a body regularly convened in an authorized place at an appointed time, engaged in the full and regular performance of its functions. A body in the government to which the administration of justice is delegated. A body organized to administer justice, and including both judge and jury. An incorporeal, political being, composed of one or more judges, who sit at fixed times and places, attended by proper officers, pursuant to lawful authority, for the administration of justice. An organized body with defined powers, meeting at certain times and places for the hearing and decision of causes and other matters brought before it, and aided in this, its proper business, by its proper officers, attorneys and counsel to present and manage the business, clerks to record and attest its acts and decisions, and ministerial officers to execute its commands, and secure due order in its proceedings."@en ;
    skos:prefLabel "court"@en .

<http://www.eionet.europa.eu/gemet/concept/11678> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/849> ;
    skos:definition "Effects of pollution on living systems."@en ;
    skos:prefLabel "biological effect of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/1168> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "A colourless gas with a faint tingling smell and taste. Atmospheric carbon dioxide is the source of carbon for plants. As carbon dioxide is heavier than air and does not support combustion, it is used in fire extinguishers. It is a normal constituent of the atmosphere, relatively innocuous in itself but playing an important role in the greenhouse effect. It is produced during the combustion of fossil fuels when the carbon content of the fuels reacts with the oxygen during combustion. It is also produced when living organisms respire. It is essential for plant nutrition and in the ocean phytoplankton is capable of absorbing and releasing large quantities of the gas."@en ;
    skos:prefLabel "carbon dioxide"@en .

<http://www.eionet.europa.eu/gemet/concept/1198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15093>,
        <http://www.eionet.europa.eu/gemet/concept/15125>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "1) The maximum number of species an area can support during the harshest part of the year, or the maximum biomass it can support indefinitely. 2) The maximum number of grazing animals an area can support without deterioration."@en ;
    skos:prefLabel "ecological carrying capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/12379> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:prefLabel "health-care activities waste"@en .

<http://www.eionet.europa.eu/gemet/concept/12417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2367> ;
    skos:definition "A manner of waste disposal in which refuse or unwanted material is dumped or submerged beneath the surface of a body of water."@en ;
    skos:prefLabel "sinking of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/1296> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/571> ;
    skos:definition "A subphylum of the phylum Artrophoda; chelicerae are characteristically modified as pincers."@en ;
    skos:prefLabel "chelicerate"@en .

<http://www.eionet.europa.eu/gemet/concept/13098> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5175> ;
    skos:definition "Sector of the metallurgical industry dealing with the production of cast iron, steel and iron alloys. Emissions from these industries tend to settle quickly from the atmosphere and can lead to rising concentrations in the soil. The main raw material input to the production process is iron ore. Also recycled scrap is used."@en ;
    skos:prefLabel "iron and steel industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13136> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029>,
        <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:definition "The buildings, machinery, facilities, related to agricultural production."@en ;
    skos:prefLabel "agricultural structure"@en .

<http://www.eionet.europa.eu/gemet/concept/13143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4438> ;
    skos:definition "A system in which nations or blocs of nations strive to maintain an equilibrium of power to prevent dominance by any single nation or to reduce conflict or the possibility of war."@en ;
    skos:prefLabel "international balance"@en .

<http://www.eionet.europa.eu/gemet/concept/13148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The underlying framework, including transportation and communications systems, industrial facilities, education and technology, that enables a country or region to produce goods, services and other resources with exchange value."@en ;
    skos:prefLabel "economic structure"@en .

<http://www.eionet.europa.eu/gemet/concept/13164> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Cultivation of land for the production of plant crops. Agricultural land may be employed in an unimproved state with few, if any, management inputs (extensive rangeland), or in an intensively managed state with annual inputs of fertilizer, pest, control treatments, and tillage."@en ;
    skos:prefLabel "cultivation of agricultural land"@en .

<http://www.eionet.europa.eu/gemet/concept/1318> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:prefLabel "chemical pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/13233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Type of vehicle used for moving from one place to the other."@en ;
    skos:prefLabel "mode of transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/13238> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Any form of financial assistance or inducement for persons or institutions."@en ;
    skos:prefLabel "economic support"@en .

<http://www.eionet.europa.eu/gemet/concept/13260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The management of acquisitions and the use of long- and short-term capital by a business."@en ;
    skos:prefLabel "financial management"@en .

<http://www.eionet.europa.eu/gemet/concept/13261> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/961> ;
    skos:definition "The collection and processing of financial information to assist with the handling, direction, or control of an organization."@en ;
    skos:prefLabel "management accounting"@en .

<http://www.eionet.europa.eu/gemet/concept/13262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1084> ;
    skos:definition "The guiding procedure, philosophy or course of action for an enterprise or company organized for commercial purposes."@en ;
    skos:prefLabel "business policy"@en .

<http://www.eionet.europa.eu/gemet/concept/13343> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:prefLabel "labour force"@en .

<http://www.eionet.europa.eu/gemet/concept/13560> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:prefLabel "allowance"@en .

<http://www.eionet.europa.eu/gemet/concept/13722> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The act or process of washing, laundering or removing dirt and other unwanted substances from the surface of an object, thing or place."@en ;
    skos:prefLabel "cleansing"@en .

<http://www.eionet.europa.eu/gemet/concept/1378> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1368> ;
    skos:definition "A flammable, explosive gas with an ethereal aroma; soluble in alcohol and ether, slightly soluble in water; boils at -14° C; an important monomer for polyvinyl chloride and its copolymers; used in organic synthesis and in adhesives."@en ;
    skos:prefLabel "chloroethylene"@en .

<http://www.eionet.europa.eu/gemet/concept/1381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3820> ;
    skos:definition "Gases formed of chlorine, fluorine, and carbon whose molecules normally do not react with other substances; they are therefore used as spray can propellants because they do not alter the material being sprayed."@en ;
    skos:prefLabel "chlorofluorocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/1421> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8797> ;
    skos:definition "Term used generically today to denote any urban form but applied particularly to large urban settlements. There are, however, no agreed definitions to separate a city from the large metropolis or the smaller town."@en ;
    skos:prefLabel "city"@en .

<http://www.eionet.europa.eu/gemet/concept/1447> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An arrangement or organization of persons, items or data elements into groups by reason of common attributes, characteristics, qualities or traits."@en ;
    skos:prefLabel "classification"@en .

<http://www.eionet.europa.eu/gemet/concept/1458> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:prefLabel "cleansing product"@en .

<http://www.eionet.europa.eu/gemet/concept/1474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "Physical conditions that determine the climate in a given area, e.g. latitude, altitude, ocean streams, etc."@en ;
    skos:prefLabel "climate factor"@en .

<http://www.eionet.europa.eu/gemet/concept/1476> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "A belt of the earth's surface within which the climate is generally homogeneous in some respect; an elemental region of a simple climatic classification."@en ;
    skos:prefLabel "climate zone"@en .

<http://www.eionet.europa.eu/gemet/concept/14848> a skos:Concept ;
    skos:prefLabel "subject"@en .

<http://www.eionet.europa.eu/gemet/concept/14896> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "A reciprocal transference of data between two or more parties for the purpose of enhancing knowledge of the participants."@en ;
    skos:prefLabel "information exchange"@en .

<http://www.eionet.europa.eu/gemet/concept/14911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14924> ;
    skos:definition "Processing techniques which apply quantitative methods to the values in a digital yield or remotely sensed scene to group pixels with similar digital number values into feature classes or categories."@en ;
    skos:prefLabel "image classification"@en .

<http://www.eionet.europa.eu/gemet/concept/14933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:prefLabel "geo-referenced data"@en .

<http://www.eionet.europa.eu/gemet/concept/14935> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A reference system used to measure horizontal and vertical distances on a planimetric map. A coordinate system is usually defined by a map projection, a spheroid of reference, a datum, one or more standard parallels, a central meridian, and possible shifts in the x- and y-directions to locate x, y positions of point, line, and area features. A common coordinate system is used to spatially register geographic data for the same area."@en ;
    skos:prefLabel "co-ordinate system"@en .

<http://www.eionet.europa.eu/gemet/concept/15020> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1042> ;
    skos:definition "Material that prevents or reduces the transmission of electricity, heat, or sound to or from a body, device or region."@en ;
    skos:prefLabel "insulating material"@en .

<http://www.eionet.europa.eu/gemet/concept/15041> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "all living biomass above the soil including stem, stump, branches, bark, seeds and foliage"@en ;
    skos:prefLabel "above-ground biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15069> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/883> ;
    skos:definition "all living biomass of live roots"@en ;
    skos:prefLabel "below-ground biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/15077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/885> ;
    skos:definition "Conversion of biomass to biofuel"@en ;
    skos:prefLabel "biofuel production"@en .

<http://www.eionet.europa.eu/gemet/concept/15086> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1160> ;
    skos:definition "Process of identifying and quantifying carbon in form of carbon dioxide (CO2) added to or removed from the earth's atmosphere, natural and human activity"@en ;
    skos:prefLabel "carbon balance"@en .

<http://www.eionet.europa.eu/gemet/concept/15087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15092>,
        <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "economy based on low carbon power sources that therefore has a minimal output of greenhouse gas emissions into the environment biosphere, but specifically refers to the greenhouse gas carbon dioxide."@en ;
    skos:prefLabel "carbon economy"@en .

<http://www.eionet.europa.eu/gemet/concept/15096> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1471> ;
    skos:definition "Consequences of climate change on natural and human systems"@en ;
    skos:prefLabel "climate change impact"@en .

<http://www.eionet.europa.eu/gemet/concept/15097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6373> ;
    skos:definition "government or private actions designed to lower anthropogenic greenhouse gas (GHG) emissions, or to adapt to climate change"@en ;
    skos:prefLabel "climate policy"@en .

<http://www.eionet.europa.eu/gemet/concept/15116> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "policy of the European Union which has as a primary objective the eradication of poverty in the context of sustainable development, including pursuit of the MDGs, as well as the promotion of democracy, good governance and respect for human rights"@en ;
    skos:prefLabel "development policy"@en .

<http://www.eionet.europa.eu/gemet/concept/15145> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13560> ;
    skos:definition "entitlement to emit a tonne of carbon dioxide, or an amount of any other greenhouse gas with an equivalent global warming potential, during a specified period"@en ;
    skos:prefLabel "emission allowance"@en .

<http://www.eionet.europa.eu/gemet/concept/15155> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15154>,
        <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "environmental impact of a product, a service, and/or a company, over its lifecycle"@en ;
    skos:prefLabel "environmental footprint"@en .

<http://www.eionet.europa.eu/gemet/concept/15185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "Climate is the average weather, or more rigorously, the statistical description in terms of the mean and variability of relevant quantities over a period of time ranging from months to thousands or millions of years. The classical period for averaging these variables is 30 years, as defined by the World Meteorological Organization. IPCC 2013"@en ;
    skos:prefLabel "global climate"@en .

<http://www.eionet.europa.eu/gemet/concept/15192> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15058>,
        <http://www.eionet.europa.eu/gemet/concept/15145>,
        <http://www.eionet.europa.eu/gemet/concept/15183>,
        <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition "emissions covered by the Kyoto Protocol including carbon dioxide (CO2), methane (CH4), nitrous oxide (N2O) and three fluorinated gases, hydrofluorocarbons (HFCs), perfluorocarbons (PFCs) and sulphur hexafluoride (SF6)"@en ;
    skos:prefLabel "greenhouse gas emissions"@en .

<http://www.eionet.europa.eu/gemet/concept/15198> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2921> ;
    skos:definition "any environmental factors (including physical, chemical, biological or socio-economic) that have harmful consequences for human health and the environment"@en ;
    skos:prefLabel "health risks"@en .

<http://www.eionet.europa.eu/gemet/concept/15204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13236> ;
    skos:definition "range of interdependent processes, including ocean circulation, temperature, weather, and the earth’s albedo that contribute to reducing the sea or land ice"@en ;
    skos:prefLabel "ice loss"@en .

<http://www.eionet.europa.eu/gemet/concept/15221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9092> ;
    skos:definition "system that stabilizes or stores livestock manure, or does both"@en ;
    skos:prefLabel "manure management system"@en .

<http://www.eionet.europa.eu/gemet/concept/15248> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5500> ;
    skos:definition "fertiliser which consists of organic materials of biological origin"@en ;
    skos:prefLabel "organic fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/15250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15155>,
        <http://www.eionet.europa.eu/gemet/concept/2450> ;
    skos:definition "result of an Organisation Environmental Footprint study based on the Organisation Environmental Footprint method."@en ;
    skos:prefLabel "organisation environmental footprint"@en .

<http://www.eionet.europa.eu/gemet/concept/15255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/632> ;
    skos:definition "steady decline of the ozone concentration in the stratosphere and a decrease in stratospheric ozone in the Polar Regions"@en ;
    skos:prefLabel "ozone depletion"@en .

<http://www.eionet.europa.eu/gemet/concept/15282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145>,
        <http://www.eionet.europa.eu/gemet/concept/15281> ;
    skos:definition "management of the sustainable use of water resources in a river basin, comprising the main river, all its tributaries and ground water, so as to provide for the social, cultural and economic development by taking into account the basics of ecology"@en ;
    skos:prefLabel "river basin management"@en .

<http://www.eionet.europa.eu/gemet/concept/15311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2159> ;
    skos:definition "new definition: multi-dimensional and fundamental processes of change in socio-technical systems and their interactions with ecosystems"@en ;
    skos:prefLabel "transition"@en .

<http://www.eionet.europa.eu/gemet/concept/15327> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9127> ;
    skos:definition "process of collecting wastewater from the time it exits residential and industrial sites to the point it arrives at the wastewater treatment plant"@en ;
    skos:prefLabel "waste water collection"@en .

<http://www.eionet.europa.eu/gemet/concept/15334> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9195> ;
    skos:definition "use of water by agriculture, industry, energy production and households, including in-stream uses such as fishing, recreation, transportation and waste disposal."@en ;
    skos:prefLabel "water use"@en .

<http://www.eionet.europa.eu/gemet/concept/1542> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "A systematic collection, compendium or revision of laws, rules, or regulations. A private or official compilation of all permanent laws in force consolidated and classified according to subject matter. Many states have published official codes of all laws in force, including the common law and statutes as judicially interpreted, which have been compiled by code commissions and enacted by the legislatures."@en ;
    skos:prefLabel "code"@en .

<http://www.eionet.europa.eu/gemet/concept/1583> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9077> ;
    skos:definition "The exhaust gas from a combustion process. It may contain nitrogen oxides, carbon oxides, water vapour, sulfur oxides, particles and many chemical pollutants."@en ;
    skos:prefLabel "combustion gas"@en .

<http://www.eionet.europa.eu/gemet/concept/1616> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "The law of European Community (as opposed to the national laws of the member states.) It consists of the treaties establishing the EC (together with subsequent amending treaties) community legislation, and decisions of the court of justice of the European Communities. Any provision of the treaties or of community legislation that is directly applicable or directly effective in a member state forms part of the law of that state and prevails over its national law in the event of any inconsistency between the two."@en ;
    skos:prefLabel "Community law"@en .

<http://www.eionet.europa.eu/gemet/concept/1639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1084> ;
    skos:definition "The market condition where an individual or firm that wants to buy or sell a commodity or service has a choice of possible suppliers or customers."@en ;
    skos:prefLabel "economic competition"@en .

<http://www.eionet.europa.eu/gemet/concept/1651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Waste consisting largely of biodegradable organic matter."@en ;
    skos:prefLabel "compostable waste"@en .

<http://www.eionet.europa.eu/gemet/concept/167> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition """1) Establishment of a new forest by seeding or planting of nonforested land.
2) The planting of trees on land which was previously used for other uses than forestry.
3) The planting of trees in an area, or the management of an area to allow trees to regenerate or colonize naturally, in order to produce a forest."""@en ;
    skos:prefLabel "afforestation"@en .

<http://www.eionet.europa.eu/gemet/concept/1736> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7804> ;
    skos:definition "An observable pattern of activity concerned with the purchase of goods and services and susceptible to the influence of marketing and advertising strategies."@en ;
    skos:prefLabel "consumer behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/1850> a skos:Concept ;
    skos:definition "An occupation or trade requiring manual dexterity or skilled artistry."@en ;
    skos:prefLabel "craft"@en .

<http://www.eionet.europa.eu/gemet/concept/186> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13136> ;
    skos:definition "The buildings and adjacent service areas of a farm."@en ;
    skos:prefLabel "agricultural building"@en .

<http://www.eionet.europa.eu/gemet/concept/193> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "An applied social science that deals with the production, distribution, and consumption of agricultural or farming goods and services."@en ;
    skos:prefLabel "agricultural economics"@en .

<http://www.eionet.europa.eu/gemet/concept/1955> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4082> ;
    skos:definition "Structure constructed across a watercourse or stream channel."@en ;
    skos:prefLabel "dam"@en .

<http://www.eionet.europa.eu/gemet/concept/2000> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13177> ;
    skos:definition "Something owed to someone else."@en ;
    skos:prefLabel "debt"@en .

<http://www.eionet.europa.eu/gemet/concept/2055> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2060> ;
    skos:definition "Growth in the number of individuals of a population."@en ;
    skos:prefLabel "demographic development"@en .

<http://www.eionet.europa.eu/gemet/concept/2056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2055> ;
    skos:definition "The gradual pattern of change in the growth of human populations in a particular region or country, from a rapid increase in the birth and death rates to a leveling off in the growth rate due to reduced fertility and other factors."@en ;
    skos:prefLabel "demographic evolution"@en .

<http://www.eionet.europa.eu/gemet/concept/213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "The development of plans and measures to achieve greater and more efficient output from agriculture; a sound agricultural policy should be able to reconcile three basic needs: the production of food and agricultural products, the protection of the environment and the maintenance of the socio-economic structure of rural areas."@en ;
    skos:prefLabel "agricultural planning"@en .

<http://www.eionet.europa.eu/gemet/concept/2159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7811> ;
    skos:definition "The combination of qualities, structures, acts and tendencies characterizing the economic and social growth of a community or human group."@en ;
    skos:prefLabel "development pattern"@en .

<http://www.eionet.europa.eu/gemet/concept/220> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:definition "The output of the cultivation of the soil."@en ;
    skos:prefLabel "agricultural product"@en .

<http://www.eionet.europa.eu/gemet/concept/2222> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Money, food or other assistance provided for those surviving a sudden, calamitous event causing loss of life, damage or hardship."@en ;
    skos:prefLabel "disaster relief"@en .

<http://www.eionet.europa.eu/gemet/concept/2290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A machine or device, especially an electrical one used domestically."@en ;
    skos:prefLabel "domestic appliance"@en .

<http://www.eionet.europa.eu/gemet/concept/2319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7340> ;
    skos:definition """1) Removal of groundwater or surface water, or of water from structures, by gravity or pumping.
2) The discharge of water from a soil by percolation (the process by which surface water moves downwards through cracks, joints and pores in soil and rocks)."""@en ;
    skos:prefLabel "drainage"@en .

<http://www.eionet.europa.eu/gemet/concept/2372> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "The discharge, deposit or injection of any waste onto or into the soil or other land surfaces."@en ;
    skos:prefLabel "land disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/2406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/617> ;
    skos:definition "The Earth depends on the sun for its existence as a planet hospitable to life, and solar energy is the major factor determining the climate. Hence, conditions on the sun and conditions on Earth are inextricably linked. Although the sun's rays may appear unchanging, its radiation does vary. Many scientists suspect that sunspot activity has a greater influence on climatic change than variations attributed to the greenhouse effect."@en ;
    skos:prefLabel "Earth-Sun relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/2588> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:prefLabel "electrical storage device"@en .

<http://www.eionet.europa.eu/gemet/concept/2599> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2722> ;
    skos:definition "Wires conducting electric power from one location to another; also known as electric power line."@en ;
    skos:prefLabel "electric line"@en .

<http://www.eionet.europa.eu/gemet/concept/2636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Any of the monovalent metals lithium, sodium, potassium, rubidium, caesium, and francium, belonging to group 1A of the periodic table. They are all very reactive and electropositive."@en ;
    skos:prefLabel "element of group I (alkaline)"@en .

<http://www.eionet.europa.eu/gemet/concept/265> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/636> ;
    skos:definition "Presence in the atmosphere of large quantities of gases, solids and radiation produced by the burning of natural and artificial fuels, chemical and other industrial processes and nuclear explosions."@en ;
    skos:prefLabel "air pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/2651> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7811> ;
    skos:definition "The state of being free from social or political restraint or from the inhibition of moral or social conventions."@en ;
    skos:prefLabel "emancipation"@en .

<http://www.eionet.europa.eu/gemet/concept/2656> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Program of procedures to be undertaken in the event of a sudden, urgent and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment."@en ;
    skos:prefLabel "emergency plan"@en .

<http://www.eionet.europa.eu/gemet/concept/2702> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1221> ;
    skos:definition "One of the three degrees of \"rarity\" drawn up by the International Union for the Conservation of Natural Resources. All plants and animals in these categories need special protection. Endangered species are those species in danger of extinction unless steps are taken to change the cause of threat and decline."@en ;
    skos:prefLabel "endangered species  (IUCN)"@en .

<http://www.eionet.europa.eu/gemet/concept/2730> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877>,
        <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The administration or handling of power derived from sources such as fossil fuel, electricity and solar radiation."@en ;
    skos:prefLabel "energy management"@en .

<http://www.eionet.europa.eu/gemet/concept/2766> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/25> ;
    skos:definition "An unexpected occurrence, failure or loss, with the potential for harming the ecosystem or natural resources."@en ;
    skos:prefLabel "environmental accident"@en .

<http://www.eionet.europa.eu/gemet/concept/2776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "An assessment of the nature and extent of any harm or detriment, or any possible harm or detriment, that may be inflicted on any aspect of the environment by any activity process, development programme, or any product, chemical, or waste substance. Audits may be designed to: verify or otherwise comply with environmental requirements; evaluate the effectiveness of existing environmental management systems; assess risks generally; or assist in planning for future improvements in environment protection and pollution control"@en ;
    skos:prefLabel "environmental auditing"@en .

<http://www.eionet.europa.eu/gemet/concept/2805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "The growth, progress or advancement in matters of ecological concern."@en ;
    skos:prefLabel "environmental development"@en .

<http://www.eionet.europa.eu/gemet/concept/2830> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4159> ;
    skos:definition "Analysis and judgement of the effects upon the environment, both temporary and permanent, of a significant development or project. It must also consider the social consequences and alternative actions."@en ;
    skos:prefLabel "environmental impact assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/2845> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:prefLabel "environmental incentive"@en .

<http://www.eionet.europa.eu/gemet/concept/2851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Knowledge communicated or received concerning any aspect of the ecosystem, the natural resources within it or, more generally, the external factors surrounding and affecting human life."@en ;
    skos:prefLabel "environmental information"@en .

<http://www.eionet.europa.eu/gemet/concept/2893> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "Technological, economical and legislative measures employed to prevent or control pollution or damage of the environment."@en ;
    skos:prefLabel "environmental policy instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/2926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8076> ;
    skos:prefLabel "environmental statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/2947> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A sudden increase in the incidence rate of a disease to a value above normal, affecting large numbers of people and spread over a wide area."@en ;
    skos:prefLabel "epidemic"@en .

<http://www.eionet.europa.eu/gemet/concept/2980> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6187> ;
    skos:definition "The philosophical study of the moral value of human conduct and of the rules and principles that ought to govern it."@en ;
    skos:prefLabel "ethics"@en .

<http://www.eionet.europa.eu/gemet/concept/2992> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The second smallest continent, forming the W extension of Eurasia: the border with Asia runs from the Urals to the Caspian and the Black Sea. The coastline is generally extremely indented and there are several peninsulas (notably Scandinavia, Italy and Iberia) and offshore islands (including the British Isles and Iceland). It contains a series of great mountain systems in the south (Pyrenees, Alps, Apennines, Carpathians, Caucasus), a large central plain, and a N region of lakes and mountains in Scandinavia."@en ;
    skos:prefLabel "Europe"@en .

<http://www.eionet.europa.eu/gemet/concept/3026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "The biological theory or process whereby species of plants and animals change with the passage of time so that their descendants differ from their ancestors, i.e. development from earlier forms by hereditary transmission of slight variations in successive generations."@en ;
    skos:prefLabel "evolution"@en .

<http://www.eionet.europa.eu/gemet/concept/303> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3007> ;
    skos:definition "Excessive and rapid growth of algae and other aquatic plants when they are stimulated to grow too quickly by pollution. It takes place when there are too many nutrients in the water and is aggravated when accompanied by a rise in temperature. Although the algae grow quickly they soon die because they have swallowed up all the water's nutrients. As they decompose they tend to rise to the surface and form a green slime. Algal bloom have increased because higher levels of nitrogen and phosphates from agricultural areas have leached from the fields into water courses."@en ;
    skos:prefLabel "algal bloom"@en .

<http://www.eionet.europa.eu/gemet/concept/3032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5286> ;
    skos:definition "The location chosen for an excavation, meaning the act or process of removing soil and/or rock materials by digging, blasting, breaking, loading either at the surface or underground."@en ;
    skos:prefLabel "excavation site"@en .

<http://www.eionet.europa.eu/gemet/concept/3063> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10940> ;
    skos:definition "To send, take or carry an article of trade or commerce out of the country. To transport merchandise from one country to another in the course of trade."@en ;
    skos:prefLabel "export"@en .

<http://www.eionet.europa.eu/gemet/concept/3090> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Primary activities involved in the extraction of non-renewable resources."@en ;
    skos:prefLabel "extractive industry"@en .

<http://www.eionet.europa.eu/gemet/concept/311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Any organic compound of hydrogen and carbon characterized by a straight chain of the carbon atoms."@en ;
    skos:prefLabel "aliphatic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/3130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13136> ;
    skos:definition "Any tract of land or building used for agricultural purposes, such as for raising crops and livestock."@en ;
    skos:prefLabel "farm"@en .

<http://www.eionet.europa.eu/gemet/concept/3149> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "A charge fixed by law for services of public officers or for use of a privilege under control of government."@en ;
    skos:prefLabel "fee"@en .

<http://www.eionet.europa.eu/gemet/concept/3174> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "An extremely long, pliable, cohesive natural or manufactured threadlike object from which yarns are spun to be woven into textiles."@en ;
    skos:prefLabel "fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/3183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2284> ;
    skos:definition "A motion picture; a thin flexible strip of cellulose coated with a photographic emission, used to make negatives and transparencies."@en ;
    skos:prefLabel "film"@en .

<http://www.eionet.europa.eu/gemet/concept/3190> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "Separation of suspended particles from a liquid, gas, etc., by the action of a filter."@en ;
    skos:prefLabel "filtration"@en .

<http://www.eionet.europa.eu/gemet/concept/3199> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3201> ;
    skos:definition "A generic term that refers to the many different forms of financing a business may use. For example - loans, shares, and bonds are all considered financing instruments."@en ;
    skos:prefLabel "financial instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/3201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "A place or institution in which buyers and sellers meet and trade monetary assets, including stocks, bonds, securities and money."@en ;
    skos:prefLabel "financial market"@en .

<http://www.eionet.europa.eu/gemet/concept/3212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2215> ;
    skos:definition "The state of combustion in which inflammable material burns, producing heat, flames and often smoke."@en ;
    skos:prefLabel "fire"@en .

<http://www.eionet.europa.eu/gemet/concept/3256> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4767> ;
    skos:definition "The attempt to catch fish or other aquatic animal with a hook or with nets, traps, etc."@en ;
    skos:prefLabel "fishing"@en .

<http://www.eionet.europa.eu/gemet/concept/3291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2893> ;
    skos:definition "Plans, referred to in various rules as emissions averaging, or flexible compliance plans, allow facilities to undercontrol some emission points that are too costly to control to mandated levels as long as these units are balanced by overcontrolling other emission units that are more cost-effective to control."@en ;
    skos:prefLabel "flexible approach to environmental protection"@en .

<http://www.eionet.europa.eu/gemet/concept/3380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8056> ;
    skos:prefLabel "food quality"@en .

<http://www.eionet.europa.eu/gemet/concept/3381> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/495> ;
    skos:definition "The minimum food ration required for satisfying the essential needs of an organism."@en ;
    skos:prefLabel "food requirement"@en .

<http://www.eionet.europa.eu/gemet/concept/340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "Any of a large number of substances having metallic properties and consisting of two or more elements; with few exceptions, the components are usually metallic elements."@en ;
    skos:prefLabel "alloy"@en .

<http://www.eionet.europa.eu/gemet/concept/3425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Planning of forest utilization for wood production, conservation purposes, fauna and flora protection, recreation and water supply."@en ;
    skos:prefLabel "forest management"@en .

<http://www.eionet.europa.eu/gemet/concept/3444> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3439> ;
    skos:definition "The farming of trees to ensure a continuing supply of timber and other forest products. Foresters care for existing trees, protecting them from fire, pests and diseases, and felling where trees are overcrowded or dying and when ready for cropping. They also plant new areas (afforestation) and replant felled areas (reafforestation)."@en ;
    skos:prefLabel "forestry practice"@en .

<http://www.eionet.europa.eu/gemet/concept/3469> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1582> ;
    skos:definition "An internal combustion engine whose cycle is completed in four piston strokes; includes a suction stroke, compression stroke, expansion stroke, and exhaust stroke."@en ;
    skos:prefLabel "four stroke engine"@en .

<http://www.eionet.europa.eu/gemet/concept/3528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "Nucleated usually filamentous, sporebearing organisms devoid of chlorophyll."@en ;
    skos:prefLabel "mycete"@en .

<http://www.eionet.europa.eu/gemet/concept/3572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Uncondensed or volatile gases, usually comprised of chemical compounds, discharged to the atmosphere."@en ;
    skos:prefLabel "gaseous air pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/3577> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8072> ;
    skos:definition "State of matter in which the matter concerned occupies the whole of its container irrespective of its quantity."@en ;
    skos:prefLabel "gaseous state"@en .

<http://www.eionet.europa.eu/gemet/concept/3586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Interconnected system of pipes for the distribution and supply of gas."@en ;
    skos:prefLabel "gas network"@en .

<http://www.eionet.europa.eu/gemet/concept/3645> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4311> ;
    skos:definition "An organized collection of computer hardware, software, geographic data, and personnel designed to efficiently capture, store, update, manipulate, analyze, and display all forms of geographically referenced information that can be drawn from different sources, both statistical and mapped."@en ;
    skos:prefLabel "geographic information system"@en .

<http://www.eionet.europa.eu/gemet/concept/3673> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Slow moving masses of ice which have accumulated either on mountains or in polar regions. They are found where warm, moist air or warm water meets cold air or water. They move, influenced by the force of gravity and the pressure of the ice, above the underlying slush layers and slide downhill, eventually melting at lower levels to form rivers or reaching sea-level, where they form ice shelves or fall into the water as icebergs."@en ;
    skos:prefLabel "glacier"@en .

<http://www.eionet.europa.eu/gemet/concept/3800> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1512> ;
    skos:definition "An inlet of the sea of large areal proportions, more indented than a bay and generally more enclosed."@en ;
    skos:prefLabel "gulf"@en .

<http://www.eionet.europa.eu/gemet/concept/3808> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition """1) The locality in which a plant or animal naturally grows or lives. It can be either the geographical area over which it extends, or the particular station in which a specimen is found.
2) A physical portion of the environment that is inhabited by an organism or population of organisms. A habitat is characterized by a relative uniformity of the physical environment and fairly close interaction of all the biological species involved. In terms of region, a habitat may comprise a desert, a tropical forest, a prairie field, the Arctic Tundra or the Arctic Ocean."""@en ;
    skos:prefLabel "habitat"@en .

<http://www.eionet.europa.eu/gemet/concept/3819> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3820> ;
    skos:definition "Halogen derivatives of biphenyl."@en ;
    skos:prefLabel "halogenated biphenyl"@en .

<http://www.eionet.europa.eu/gemet/concept/3874> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Laws, ordinances, or codes prescribing sanitary, clean air, etc., standards and regulations, designed to promote and preserve the health of the community and working conditions of businesses."@en ;
    skos:prefLabel "health legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/3900> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4254> ;
    skos:definition "Plant for producing and supplying heat."@en ;
    skos:prefLabel "heating plant"@en .

<http://www.eionet.europa.eu/gemet/concept/3907> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The provision of heating fuel, coal or other heating source materials, or the amount of heating capacity, for the use of a municipality, or other heat user."@en ;
    skos:prefLabel "heat supply"@en .

<http://www.eionet.europa.eu/gemet/concept/3937> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Compound in which the ring structure is a combination of more than one kind of atom."@en ;
    skos:prefLabel "heterocyclic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/4091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "A very large group of chemical compounds composed only of carbon and hydrogen."@en ;
    skos:prefLabel "hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/4126> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6798> ;
    skos:definition "The science that deals with the principles and practices of good health."@en ;
    skos:prefLabel "hygiene"@en .

<http://www.eionet.europa.eu/gemet/concept/4183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "The controlled burning of solid, liquid, or gaseous combustible wastes to produce gases and solid residues containing little or no combustible material in order to reduce the bulk of the original waste materials."@en ;
    skos:prefLabel "incineration of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate working conditions or the acquisition, processing and disposal of materials by the aggregate of factories, companies and enterprises in one or more manufacturing or technically productive fields."@en ;
    skos:prefLabel "industrial legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/4253> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The process of making arrangements or preparations to facilitate the manufacturing, producing and processing of goods or merchandise."@en ;
    skos:prefLabel "industrial planning"@en .

<http://www.eionet.europa.eu/gemet/concept/4288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "Pathogenic condition resulting from invasion of an host by a pathogen that propagates causing infection."@en ;
    skos:prefLabel "infectious disease"@en .

<http://www.eionet.europa.eu/gemet/concept/4360> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An official examination and evaluation of the extent to which specified goals, objectives, standards, policies or procedures of an agency, organization, department or unit have been met properly."@en ;
    skos:prefLabel "inspection"@en .

<http://www.eionet.europa.eu/gemet/concept/4466> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:definition "A detailed list of articles, goods, property, etc."@en ;
    skos:prefLabel "inventory"@en .

<http://www.eionet.europa.eu/gemet/concept/4493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "An electrically charged atom or group of atoms formed by the loss or gain of one or more electrons."@en ;
    skos:prefLabel "ion"@en .

<http://www.eionet.europa.eu/gemet/concept/4566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Attaching a notice to a product or container bearing information concerning its contents, proper use, manufacturer and any cautions or hazards of use."@en ;
    skos:prefLabel "labelling"@en .

<http://www.eionet.europa.eu/gemet/concept/4571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050> ;
    skos:definition "Tests or investigations carried out in a laboratory."@en ;
    skos:prefLabel "laboratory experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/4584> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:definition "The dynamics or general state of the association between management and non-management employees in an enterprise, industry or nation, with special attention to the maintenance of agreements, collective bargaining and the status of unions."@en ;
    skos:prefLabel "labour relations"@en .

<http://www.eionet.europa.eu/gemet/concept/4589> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1513> ;
    skos:definition "A body of water cut off from the open sea by coral reefs or sand bars."@en ;
    skos:prefLabel "lagoon"@en .

<http://www.eionet.europa.eu/gemet/concept/4676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Transport of persons and goods by a network of roads or railways."@en ;
    skos:prefLabel "land transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/468> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4163> ;
    skos:definition "Action resulting from or influenced by human activity or intervention."@en ;
    skos:prefLabel "anthropic activity"@en .

<http://www.eionet.europa.eu/gemet/concept/4796> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13284> ;
    skos:definition "Any process of granting and certifying legal or administrative permission to a person or organization to pursue some occupation or to perform some activity or business."@en ;
    skos:prefLabel "licencing"@en .

<http://www.eionet.europa.eu/gemet/concept/4808> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "The particular attitudes, habits or behaviour associated with an individual or group."@en ;
    skos:prefLabel "lifestyle"@en .

<http://www.eionet.europa.eu/gemet/concept/4862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3122> ;
    skos:definition "Cattle, horses, and similar animals kept for domestic use especially on a farm."@en ;
    skos:prefLabel "livestock"@en .

<http://www.eionet.europa.eu/gemet/concept/4873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The maximum load that a system can support before failing."@en ;
    skos:prefLabel "load bearing capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5765> ;
    skos:definition "Putting to use general principles of the science of human nourishment to address or solve specific problems."@en ;
    skos:prefLabel "applied nutrition"@en .

<http://www.eionet.europa.eu/gemet/concept/4988> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7175> ;
    skos:definition "Planned use of natural resources, in particular of non-renewable resources, in accordance with principles that assure their optimum long-term economic and social benefits."@en ;
    skos:prefLabel "management of natural resources"@en .

<http://www.eionet.europa.eu/gemet/concept/503> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450>,
        <http://www.eionet.europa.eu/gemet/concept/511> ;
    skos:definition "Animal having a water habitat."@en ;
    skos:prefLabel "aquatic animal"@en .

<http://www.eionet.europa.eu/gemet/concept/5043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/511> ;
    skos:definition "Organisms which live in sea water."@en ;
    skos:prefLabel "marine organism"@en .

<http://www.eionet.europa.eu/gemet/concept/5093> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496>,
        <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The study of the nature, behaviour, and use of materials applied to science and technology."@en ;
    skos:prefLabel "materials science"@en .

<http://www.eionet.europa.eu/gemet/concept/5152> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:prefLabel "mental effect"@en .

<http://www.eionet.europa.eu/gemet/concept/5197> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/640> ;
    skos:definition "The science concerned with the atmosphere and its phenomena."@en ;
    skos:prefLabel "meteorology"@en .

<http://www.eionet.europa.eu/gemet/concept/52> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "A compound capable of transferring a hydrogen ion in solution."@en ;
    skos:prefLabel "acid"@en .

<http://www.eionet.europa.eu/gemet/concept/5228> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "A microscopic organism, including bacteria, protozoans, yeast, viruses, and algae."@en ;
    skos:prefLabel "micro-organism"@en .

<http://www.eionet.europa.eu/gemet/concept/5236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6525> ;
    skos:definition "The permanent or semipermanent change of a person's place of residence."@en ;
    skos:prefLabel "human migration"@en .

<http://www.eionet.europa.eu/gemet/concept/5258> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "A building where grain is crushed into flour."@en ;
    skos:prefLabel "mill"@en .

<http://www.eionet.europa.eu/gemet/concept/5267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15020> ;
    skos:definition "A fiber manufactured from glass, rock, or slag generally for use in fabricating heat insulation."@en ;
    skos:prefLabel "mineral fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/5277> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4855> ;
    skos:definition "A naturally occurring substance with a characteristic chemical composition expressed by a chemical formula; may occur as individual crystals or may be disseminated in some other material or rock."@en ;
    skos:prefLabel "mineral"@en .

<http://www.eionet.europa.eu/gemet/concept/5339> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "Any of various invertebrates having a soft unsegmented body and often a shell, secreted by a fold of skin."@en ;
    skos:prefLabel "mollusc"@en .

<http://www.eionet.europa.eu/gemet/concept/5348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:prefLabel "monitoring data"@en .

<http://www.eionet.europa.eu/gemet/concept/5437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15115>,
        <http://www.eionet.europa.eu/gemet/concept/15174>,
        <http://www.eionet.europa.eu/gemet/concept/15243>,
        <http://www.eionet.europa.eu/gemet/concept/9041>,
        <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Municipal waste is mainly produced by households, though similar wastes from sources such as commerce, offices and public institutions are included. The amount of municipal waste generated consists of waste collected by or on behalf of municipal authorities and disposed of through the waste management system."@en ;
    skos:prefLabel "municipal waste"@en .

<http://www.eionet.europa.eu/gemet/concept/5501> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3174>,
        <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "A textile fiber of mineral, plant or animal origin."@en ;
    skos:prefLabel "natural fibre"@en .

<http://www.eionet.europa.eu/gemet/concept/5648> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The systematic deployment of monitoring equipment for the purpose of detecting or measuring quantitatively or qualitatively the presence, effect, or level of noise."@en ;
    skos:prefLabel "noise monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/5675> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5277> ;
    skos:definition "Minerals containing non-metals, such as quartz, garnet, etc."@en ;
    skos:prefLabel "non-metallic mineral"@en .

<http://www.eionet.europa.eu/gemet/concept/572> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4475> ;
    skos:definition "Animals characterized by the repetition of similar segments (metameres), exhibited especially by arthropods, annelids, and vertebrates in early embryonic stages and in certain specialized adult structures."@en ;
    skos:prefLabel "Articulata"@en .

<http://www.eionet.europa.eu/gemet/concept/5724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Nuclear fuels are obtained from inorganic minerals extracted by mining. Although they are at least partially consumed when used in nuclear reactors for the production of heat, they differ from fossil fuels in the way they release energy. Burning of fossil fuels, such as coal, oil and gas, is a chemical reaction. Nuclear fuels, such as uranium, are destroyed by a process of spontaneous disintegration, called fission, and prompted by natural radioactivity. If the process is left to occur naturally in uranium-bearing rock, the rate of change is imperceptibly small. In a man-made nuclear reactor the energy-releasing processes of disintegration, which in the natural state happen slowly over thousands of millions of years, are compressed into minutes. The release of energy is harnessed to generate steam which drives electricity generators."@en ;
    skos:prefLabel "nuclear fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/5741> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6228> ;
    skos:definition "A reaction involving a change in an atomic nucleus, such as fission, fusion, neutron capture, or radioactive decay, as distinct from a chemical reaction, which is limited to changes in the electron structure surrounding the nucleus."@en ;
    skos:prefLabel "nuclear reaction"@en .

<http://www.eionet.europa.eu/gemet/concept/5791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "Water current flow in a closed circular pattern within an ocean."@en ;
    skos:prefLabel "ocean circulation"@en .

<http://www.eionet.europa.eu/gemet/concept/5837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "Contamination of any ecosystem, but usually of freshwater or marine ecosystems, by oil or other petroleum products."@en ;
    skos:prefLabel "oil pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/5890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "A fully differentiated structural and functional unit, such as a kidney or a root, in an animal or plant."@en ;
    skos:prefLabel "organ"@en .

<http://www.eionet.europa.eu/gemet/concept/5892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Carbon which comes from an animal or plant."@en ;
    skos:prefLabel "organic carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/59> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/60> ;
    skos:definition "The characteristics found within a structure that determine the quality of sound in its relevance to hearing."@en ;
    skos:prefLabel "acoustic property"@en .

<http://www.eionet.europa.eu/gemet/concept/5902> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1318> ;
    skos:definition "A plant- or animal-produced pollutant containing mainly carbon, hydrogen and oxygen."@en ;
    skos:prefLabel "organic pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/5945> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4358> ;
    skos:definition "A heterogeneous order of generalized insects with gradual metamorphosis, chewing mouthparts, and four wings."@en ;
    skos:prefLabel "orthopteran"@en .

<http://www.eionet.europa.eu/gemet/concept/5978> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Binary chemical compound in which oxygen is combined with a metal or nonmetal."@en ;
    skos:prefLabel "oxide"@en .

<http://www.eionet.europa.eu/gemet/concept/5991> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5982> ;
    skos:definition "An allotropic form of oxygen containing three atoms in the molecule. It is a bluish gas, very active chemically, and a powerful oxidizing agent. Ozone is formed when oxygen or air is subjected to a silent electric discharge. It occurs in ordinary air in very small amounts only."@en ;
    skos:prefLabel "ozone"@en .

<http://www.eionet.europa.eu/gemet/concept/6048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "An assembly of elected representatives, typically controlled by a political party and constituting the legislative and, in some cases, the executive power of a state."@en ;
    skos:prefLabel "Parliament"@en .

<http://www.eionet.europa.eu/gemet/concept/6066> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5135> ;
    skos:definition "The branch of medicine concerned with the causes, origin, and nature of disease, including the changes occurring as a result of disease."@en ;
    skos:prefLabel "pathology"@en .

<http://www.eionet.europa.eu/gemet/concept/607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "A body of persons associated for the regulation of a common economic activity by means of a special organization."@en ;
    skos:prefLabel "association"@en .

<http://www.eionet.europa.eu/gemet/concept/6094> a skos:Concept ;
    skos:definition "That shell or layer of the Earth in which soil-forming processes occur."@en ;
    skos:prefLabel "pedosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/6176> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1890> ;
    skos:definition "Plants that produce seeds. The group comprises the Gymnospermae and the Angiospermae."@en ;
    skos:prefLabel "phanerogam"@en .

<http://www.eionet.europa.eu/gemet/concept/6187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The academic discipline concerned with making explicit the nature and significance of ordinary and scientific beliefs and investigating the intelligibility of concepts by means of rational argument concerning their presuppositions, implications, and interrelationships; in particular, the rational investigation of the nature and structure of reality (metaphysics), the resources and limits of knowledge (epistemology), the principles and import of moral judgment (ethics), and the relationship between language and reality (semantics)."@en ;
    skos:prefLabel "philosophy"@en .

<http://www.eionet.europa.eu/gemet/concept/6227> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "The introduction or presence of harmful substances or forces in the environment that cause damage to the environment and its processes due to their material actions, as through vibration, thermal alteration or electromagnetic radiation."@en ;
    skos:prefLabel "physical pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/6299> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1613> ;
    skos:definition "Any group of plants belonging to a number of different species that co-occur in the same habitat or area and interact through trophic and spatial relationships; typically characterized by reference to one or more dominant species."@en ;
    skos:prefLabel "plant community"@en .

<http://www.eionet.europa.eu/gemet/concept/631> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "A practice of continuous atmospheric sampling by various levels of government or particular industries."@en ;
    skos:prefLabel "atmospheric monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/623> ;
    skos:definition "A triatomic molecule of oxygen; a natural constituent of the atmosphere, with the highest concentrations in the ozone layer or stratosphere; it is found at a level between 15 and 30 km above the Earth, which prevents harmful ultraviolet B radiation, which causes skin cancer and threatens plant life, from reaching the ground. The fragile shield is being damaged by chemicals released on Earth. The main chemicals that are depleting stratospheric ozone are chlorofluorocarbons (CFCs), which are used in refrigerators, aerosols and as cleaners in many industries and halons, which are used in fire extinguishers. The damage is caused when these chemicals release highly reactive forms of chlorine and bromine."@en ;
    skos:prefLabel "atmospheric ozone"@en .

<http://www.eionet.europa.eu/gemet/concept/6362> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8388> ;
    skos:definition "The interacting systems of the biological communities and their nonliving environmental surroundings located in the regions where the air temperature is perennially below 10° Celsius, usually at and near the North and South Poles."@en ;
    skos:prefLabel "polar ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/6364> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1476> ;
    skos:definition "Area relating to the earth's poles or the area inside the Arctic or Antarctic Circles."@en ;
    skos:prefLabel "polar region"@en .

<http://www.eionet.europa.eu/gemet/concept/637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5196> ;
    skos:definition "The settling out of water from cloud in the form of dew, rain, hail, snow, etc."@en ;
    skos:prefLabel "atmospheric precipitation"@en .

<http://www.eionet.europa.eu/gemet/concept/6384> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6371> ;
    skos:definition "A group of persons organized to seek or exercise power in governmental or public affairs, by supporting candidates for office or by lobbying for action and mobilizing support for bills or governmental policies."@en ;
    skos:prefLabel "political organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "The atmospheric sciences study the dynamics, physics and chemistry of atmospheric phenomena and processes, including the interactions of the atmosphere with soil physics, hydrology and oceanic circulation. The research focuses on the following areas: turbulence and convection, atmospheric radiation and remote sensing, aerosol and cloud physics and chemistry, planetary atmospheres, air-sea interactions, climate, and statistical meteorology."@en ;
    skos:prefLabel "atmospheric science"@en .

<http://www.eionet.europa.eu/gemet/concept/6413> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "Release of polluting substances in the air, water and soil from a given source and measured at the immission point."@en ;
    skos:prefLabel "pollutant emission"@en .

<http://www.eionet.europa.eu/gemet/concept/6469> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The quantitative or qualitative measure of the presence, effect or level of any polluting substance in air, water or soil."@en ;
    skos:prefLabel "pollution monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/6528> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2060> ;
    skos:definition "The direction of change in the total number of persons inhabiting a country, city, district or area."@en ;
    skos:prefLabel "population trend"@en .

<http://www.eionet.europa.eu/gemet/concept/6593> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A type of stress which is exerted uniformly in all directions; its measure is the force exerted per unit area."@en ;
    skos:prefLabel "pressure"@en .

<http://www.eionet.europa.eu/gemet/concept/66> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/68> ;
    skos:definition "A group of 15 radioactive elements some of which occur naturally while others are produced in nuclear reactions. They include plutonium, americium and neptunium. The health hazard presented by the actinides, if they are released into the environment, comes from the potency of their radioactive characteristics. They are alpha-emitters, and therefore can cause intense localized damage in tissues if absorbed into the body."@en ;
    skos:prefLabel "actinide"@en .

<http://www.eionet.europa.eu/gemet/concept/6624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8247> ;
    skos:definition "Principle stated by the World Commission on Environment and Development (The Bruntland Commission) in 1987: development that meets the needs of the present without compromising the needs of future generations. Sustainable development is a process of integrating economic, social and ecological goals, and should not mean a trade-off between the environment and development. Sustainable development should imply balance rather than conflict."@en ;
    skos:prefLabel "principle of sustainability"@en .

<http://www.eionet.europa.eu/gemet/concept/6646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Organisms (i.e. prokaryotes) whose genetic material (filaments of DNA) is not enclosed by a nuclear membrane, and that do not possess mitochondria or plastids. Bacteria and cyanophyta are the only prokaryotic organisms."@en ;
    skos:prefLabel "procaryote"@en .

<http://www.eionet.europa.eu/gemet/concept/6662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:prefLabel "product evaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/6663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4255> ;
    skos:definition "Attaching a notice to a product or container bearing information concerning its contents, proper use, manufacturer and any cautions or hazards of use."@en ;
    skos:prefLabel "product identification"@en .

<http://www.eionet.europa.eu/gemet/concept/6709> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "An interdiction or forbidding of an activity or action by authority or law."@en ;
    skos:prefLabel "prohibition"@en .

<http://www.eionet.europa.eu/gemet/concept/6753> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10054> ;
    skos:definition "A series of procedures and devices designed to preserve people, property or the environment from injury or harm."@en ;
    skos:prefLabel "protection system"@en .

<http://www.eionet.europa.eu/gemet/concept/6942> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11276> ;
    skos:definition "A permanent track composed of a line of parallel metal rails fixed to sleepers, for transport of passengers and goods in trains."@en ;
    skos:prefLabel "railway"@en .

<http://www.eionet.europa.eu/gemet/concept/6977> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A device that introduces either inductive or capacitive reactance into a circuit, such as a coil or capacitor."@en ;
    skos:prefLabel "reactor"@en .

<http://www.eionet.europa.eu/gemet/concept/698> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5228>,
        <http://www.eionet.europa.eu/gemet/concept/6646> ;
    skos:definition "Group of single-cell micro-organisms, the smallest of the living organisms. Some are vital to sustain life, while others are responsible for causing highly dangerous human diseases, such as anthrax, tetanus and tuberculosis. Bacteria are found everywhere, in the soil, water and air."@en ;
    skos:prefLabel "bacterium"@en .

<http://www.eionet.europa.eu/gemet/concept/7034> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "A line of rocks in the tidal zone of a coast, submerged at high water but partly uncovered at low water."@en ;
    skos:prefLabel "reef"@en .

<http://www.eionet.europa.eu/gemet/concept/7075> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6287> ;
    skos:definition "The step by step method and process of defining, developing and outlining various possible courses of actions to meet existing or future needs, goals and objectives for a designated area or an administrative division of a city, county or larger geographical area."@en ;
    skos:prefLabel "regional planning"@en .

<http://www.eionet.europa.eu/gemet/concept/709> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10002> ;
    skos:definition "An equality between the sums total of the two sides of an account, or the excess on either side."@en ;
    skos:prefLabel "balance (economic)"@en .

<http://www.eionet.europa.eu/gemet/concept/7093> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4455> ;
    skos:definition "Reintroduction of exterminated species in an area; it is bound to fail if the chosen animal became extinct in the area too long ago and if the area itself has undergone too many changes. Reintroduction needs years of careful planning - the approval of local population, technical conditions of the release, feeding system, protection and breeding control - and even then some unexpected problems may arise."@en ;
    skos:prefLabel "reintroduction"@en .

<http://www.eionet.europa.eu/gemet/concept/7129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1911> ;
    skos:definition "Place where systematic investigation to establish facts or principles or to collect information on a subject is performed."@en ;
    skos:prefLabel "research centre"@en .

<http://www.eionet.europa.eu/gemet/concept/7138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5317> ;
    skos:definition "An artificial or natural storage place for water, such as a lake or pond, from which the water may be withdrawn as for irrigation, municipal water supply, or flood control."@en ;
    skos:prefLabel "reservoir"@en .

<http://www.eionet.europa.eu/gemet/concept/7144> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "A building allocated for residence."@en ;
    skos:prefLabel "residential building"@en .

<http://www.eionet.europa.eu/gemet/concept/716> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13177> ;
    skos:definition "Transactional business between any bank, an institution for safeguarding, exchanging, receiving and lending money, and that bank's clients or customers."@en ;
    skos:prefLabel "banking"@en .

<http://www.eionet.europa.eu/gemet/concept/7181> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "The structures and passages involved with the intake, expulsion and exchange of oxygen and carbon dioxide in the vertebrate body."@en ;
    skos:prefLabel "respiratory system"@en .

<http://www.eionet.europa.eu/gemet/concept/7353> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "A collection of dwellings located in a rural area."@en ;
    skos:prefLabel "rural settlement"@en .

<http://www.eionet.europa.eu/gemet/concept/7367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:definition "A norm or measure applicable in legal cases for any action, procedure or contrivance designed to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety standard"@en .

<http://www.eionet.europa.eu/gemet/concept/7376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2782> ;
    skos:definition "The accumulation of soluble salts by evaporation of the waters that bore them to the soil zone, in a soil of an arid, poorly drained region."@en ;
    skos:prefLabel "salination"@en .

<http://www.eionet.europa.eu/gemet/concept/740> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "All waters, inland or coastal, except those intended for therapeutic purposes or used in swimming pools, an area either in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters."@en ;
    skos:prefLabel "bathing water"@en .

<http://www.eionet.europa.eu/gemet/concept/7480> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which promotes or determines the direction for the systematic study, research and experimentation of a particular aspect of the physical or material world, which may lead to scholarly contributions in a branch of knowledge."@en ;
    skos:prefLabel "scientific policy"@en .

<http://www.eionet.europa.eu/gemet/concept/7513> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The level of the surface of the ocean; especially, the mean level halfway between high and low tide, used as a standard in reckoning land elevation or sea depths."@en ;
    skos:prefLabel "sea level"@en .

<http://www.eionet.europa.eu/gemet/concept/7525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:definition "Marine resources include food, energy and minerals."@en ;
    skos:prefLabel "sea resource"@en .

<http://www.eionet.europa.eu/gemet/concept/7575> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3648> ;
    skos:definition "The phenomenon of Earth movements."@en ;
    skos:prefLabel "seismic activity"@en .

<http://www.eionet.europa.eu/gemet/concept/7603> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12783> ;
    skos:definition "Areas of a country where special measures may be given to protect the natural habitats which present a high level of vulnerability."@en ;
    skos:prefLabel "sensitive area"@en .

<http://www.eionet.europa.eu/gemet/concept/7612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A machine for separating materials of different specific gravity by means of water or air."@en ;
    skos:prefLabel "separator"@en .

<http://www.eionet.europa.eu/gemet/concept/765> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/664> ;
    skos:definition "Any observable action or response of an organism, group or species to environmental factors."@en ;
    skos:prefLabel "behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/766> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "Reactivity of a compound depending on the structure of the molecules."@en ;
    skos:prefLabel "behaviour of substances"@en .

<http://www.eionet.europa.eu/gemet/concept/7669> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10851> ;
    skos:definition "A place, especially a small building, for the retail sale of goods and services."@en ;
    skos:prefLabel "shop"@en .

<http://www.eionet.europa.eu/gemet/concept/7761> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "An aerosol, consisting of visible particles and gases, produced by the incomplete burning of carbon-based materials, such as wood and fossil fuels."@en ;
    skos:prefLabel "smoke"@en .

<http://www.eionet.europa.eu/gemet/concept/7798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "Easily identified features of a society which can be measured, which vary over time, and are taken as revealing some underlying aspect of social reality. In general, the most commonly used indicators are derived from official statistics, and include unemployment figures, health and mortality data, and crime rates."@en ;
    skos:prefLabel "social indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/7804> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:prefLabel "social-minded behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/7822> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "The prosperity, well-being or convenience of a community. It embraces the primary social interests of safety, order, morals, economic interest, and non material and political interests."@en ;
    skos:prefLabel "social welfare"@en .

<http://www.eionet.europa.eu/gemet/concept/7825> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:prefLabel "socioeconomic aspect of human settlements"@en .

<http://www.eionet.europa.eu/gemet/concept/783> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3368> ;
    skos:prefLabel "beverage industry"@en .

<http://www.eionet.europa.eu/gemet/concept/7912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2406>,
        <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "The electromagnetic radiation and particles emitted by the sun."@en ;
    skos:prefLabel "solar radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/7983> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Controlled utilization, protection or development of selected classes of plants or animals for their richness, biodiversity and benefits to humanity."@en ;
    skos:prefLabel "conservation of species"@en .

<http://www.eionet.europa.eu/gemet/concept/7986> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7093> ;
    skos:definition "Reintroducing wild animal and plant species to their natural habitat. The reintroduction of species in a region requires a preliminary study to establish the reasons of their disappearance and the modifications that might have occurred in the biotopes."@en ;
    skos:prefLabel "species reintroduction"@en .

<http://www.eionet.europa.eu/gemet/concept/8014> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Buildings, constructions, installations, organized areas and equipment for indoor and outdoor sport activities."@en ;
    skos:prefLabel "sports facility"@en .

<http://www.eionet.europa.eu/gemet/concept/8073> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A place along a route or line at which a bus, train, etc. stops for fuel or to pick up or let off passengers or goods, especially with ancillary buildings and services."@en ;
    skos:prefLabel "station"@en .

<http://www.eionet.europa.eu/gemet/concept/8141> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "A stimulus or succession of stimuli of such magnitude as to tend to disrupt the homeostasis of the organism."@en ;
    skos:prefLabel "stress"@en .

<http://www.eionet.europa.eu/gemet/concept/8158> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "That aspect of geological oceanography which deals with the relief features of the ocean floor and with the forces that modify them."@en ;
    skos:prefLabel "submarine morphology"@en .

<http://www.eionet.europa.eu/gemet/concept/8204> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "An oxide of sulphur, such as sulphur dioxide and sulphur trioxide; they are formed primarily from the combustion of fossil fuels; major air pollutants and cause of damage to the respiratory tract as well as vegetation."@en ;
    skos:prefLabel "sulphur oxide"@en .

<http://www.eionet.europa.eu/gemet/concept/8250> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7172> ;
    skos:definition "Use of the environment and its living resources at a rate that does not exceed its capacity for renewal in order to ensure its availability for future generations."@en ;
    skos:prefLabel "sustainable use"@en .

<http://www.eionet.europa.eu/gemet/concept/8285> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7654> ;
    skos:definition "A ship designed for bulk shipment of liquids or gases."@en ;
    skos:prefLabel "tanker (ship)"@en .

<http://www.eionet.europa.eu/gemet/concept/8380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "The body of specialized words relating to a particular subject."@en ;
    skos:prefLabel "terminology"@en .

<http://www.eionet.europa.eu/gemet/concept/8447> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition """1) Heating and cooling a metal or alloy to obtain desired properties or conditions. 
2) Treatment of hazardous waste in a device which uses elevated temperatures as the primary means to change the chemical, physical, or biological character or composition of the hazardous waste. Examples of thermal treatment processes are incineration, molten salt, pyrolysis, calcination, wet air oxidation, and microwave discharge."""@en ;
    skos:prefLabel "thermal treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/8486> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry related with timber harvesting and processing."@en ;
    skos:prefLabel "timber industry"@en .

<http://www.eionet.europa.eu/gemet/concept/8546> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "A chemical or mixture that may present a risk or injury to health or the environment."@en ;
    skos:prefLabel "toxic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/8571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government, business or some other organization, which promotes or determines the direction for the act or process of buying, selling or exchanging goods and services within a country or between countries."@en ;
    skos:prefLabel "trade policy"@en .

<http://www.eionet.europa.eu/gemet/concept/8573> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8571> ;
    skos:prefLabel "trade relations"@en .

<http://www.eionet.europa.eu/gemet/concept/8606> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6939> ;
    skos:definition "A connected group of railroad cars, usu. pushed or pulled by a locomotive."@en ;
    skos:prefLabel "train"@en .

<http://www.eionet.europa.eu/gemet/concept/8648> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6225> ;
    skos:definition "A programme of action to provide for present and future demands for movement of people and goods. Such a programme is preceded by a transport study and necessarily includes consideration of the various modes of transport."@en ;
    skos:prefLabel "transport planning"@en .

<http://www.eionet.europa.eu/gemet/concept/8722> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13160> ;
    skos:definition "The class or category of an enterprise or organization involved in an economy."@en ;
    skos:prefLabel "type of business"@en .

<http://www.eionet.europa.eu/gemet/concept/8776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:definition "A voluntary association of around 180 state signatory to the UN charter (1945), whose primary aim is to maintain international peace and security, solve economic, social, and political problems through international co-operation, and promote respect for human rights."@en ;
    skos:prefLabel "United Nations"@en .

<http://www.eionet.europa.eu/gemet/concept/879> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "A generic term applied to processes that use microorganisms to decompose organic wastes either into water, carbon dioxide, and simple inorganic substances, such as aldehydes and acids. The purpose of biological waste treatment is to control either the environment for microorganisms so that their growth and activity are enhanced, and to provide a means for maintaining high concentrations of the microorganisms in contact with the wastes."@en ;
    skos:prefLabel "biological waste treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/8887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "Any low-lying land bordered by higher ground; especially an elongate, relatively large, gently sloping depression of the Earth's surface, commonly situated between two mountains or between ranges of hills or mountains, and often containing a stream with an outlet. It is usually developed by stream erosion, but may be formed by faulting."@en ;
    skos:prefLabel "valley"@en .

<http://www.eionet.europa.eu/gemet/concept/8934> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and sale of equipment that conveys people, goods or materials by land, air or water."@en ;
    skos:prefLabel "vehicle manufacturing industry"@en .

<http://www.eionet.europa.eu/gemet/concept/901> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "A region of relatively uniform environmental conditions, occupied by a given plant community and its associated animal community."@en ;
    skos:prefLabel "biotope"@en .

<http://www.eionet.europa.eu/gemet/concept/9028> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5243> ;
    skos:definition "A conflict or a state of hostility between two or more parties, nations or states, in which armed forces or military operations are used."@en ;
    skos:prefLabel "war"@en .

<http://www.eionet.europa.eu/gemet/concept/9043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6838> ;
    skos:prefLabel "waste air purification (gas)"@en .

<http://www.eionet.europa.eu/gemet/concept/9054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9106> ;
    skos:definition "The periodic or on-demand removal of solid waste from primary source locations using a collection vehicle and followed by the depositing of this waste at some central facility or disposal site."@en ;
    skos:prefLabel "waste collection"@en .

<http://www.eionet.europa.eu/gemet/concept/9074> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3900> ;
    skos:definition "Heating and power production plant where fuel is provided from refuse."@en ;
    skos:prefLabel "waste-fed heating and power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/9130> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "Collection and removal of wastewater deriving from industrial and urban settlements by means of a system of pipes and treatment plants."@en ;
    skos:prefLabel "waste water disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/9151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124> ;
    skos:definition "Any mass of water having definite hydrological, physical, chemical and biological characteristics and which can be employed for one or several purposes."@en ;
    skos:prefLabel "water body"@en .

<http://www.eionet.europa.eu/gemet/concept/9169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "Pumping of water for different purposes (i.e. agriculture, land reclamation, domestic and industrial use, etc.)."@en ;
    skos:prefLabel "water extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/9172> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "The characteristic behaviour and the total quantity of water involved in a drainage basin, determined by measuring such quantities as rainfall, surface and subsurface storage and flow, and evapotranspiration."@en ;
    skos:prefLabel "hydrologic flow"@en .

<http://www.eionet.europa.eu/gemet/concept/9180> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9242> ;
    skos:definition "Water used by industries for purposes such as fabrication, processing, washing and cooling, which is obtained from a public supply or through self-supplied sources."@en ;
    skos:prefLabel "water for industrial use"@en .

<http://www.eionet.europa.eu/gemet/concept/9236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257>,
        <http://www.eionet.europa.eu/gemet/concept/8804> ;
    skos:definition "Any physical extension of, or changes to, the uses of land in waterfront areas."@en ;
    skos:prefLabel "waterside development"@en .

<http://www.eionet.europa.eu/gemet/concept/9245> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Transportation of goods or persons by means of ships travelling on the sea or on inland waterways."@en ;
    skos:prefLabel "water transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/9269> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "The day-to-day meteorological conditions, especially temperature, cloudiness, and rainfall, affecting a specific place."@en ;
    skos:prefLabel "weather"@en .

<http://www.eionet.europa.eu/gemet/concept/9373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "Ploughing the soil for agricultural purposes."@en ;
    skos:prefLabel "working the soil"@en .

<http://www.eionet.europa.eu/gemet/concept/9417> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6291> ;
    skos:definition "Designation and reservation under a master plan of land use for light and heavy industry, dwellings, offices, and other buildings; use is enforced by restrictions on types of buildings in each zone."@en ;
    skos:prefLabel "zoning"@en .

<http://www.eionet.europa.eu/gemet/concept/10026> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Acts relating to the administration of justice."@en ;
    skos:prefLabel "juridical act"@en .

<http://www.eionet.europa.eu/gemet/concept/10043> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:prefLabel "plant life"@en .

<http://www.eionet.europa.eu/gemet/concept/10054> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "A unified, coordinated assemblage or plan of procedures and devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety system"@en .

<http://www.eionet.europa.eu/gemet/concept/10064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5544> ;
    skos:definition "Precautionary actions, procedures or installations undertaken to prevent or reduce harm to animals, plants and other organisms living in their natural state."@en ;
    skos:prefLabel "wildlife protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1059> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Masonry and rubble wastes arising from the demolition or reconstruction of buildings or other civil engineering structures."@en ;
    skos:prefLabel "building waste"@en .

<http://www.eionet.europa.eu/gemet/concept/11124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "A list of record surrogates arranged in order of some attribute expressible in machine-orderable form."@en ;
    skos:prefLabel "index"@en .

<http://www.eionet.europa.eu/gemet/concept/11289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8598> ;
    skos:definition "The science or art of conducting ships or aircraft from one place to another, esp. the method of determining position, course, and distance travelled over the surface of the earth by the principles of geometry and astronomy and by reference to devices (as radar beacons or instruments) designed as aids."@en ;
    skos:prefLabel "navigation"@en .

<http://www.eionet.europa.eu/gemet/concept/11429> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8047> ;
    skos:prefLabel "quality standard"@en .

<http://www.eionet.europa.eu/gemet/concept/1160> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2639> ;
    skos:definition "A nonmetallic element existing in the three crystalline forms: graphite, diamond and buckminsterfullerene: occurring in carbon dioxide, coal, oil and all organic compounds."@en ;
    skos:prefLabel "carbon"@en .

<http://www.eionet.europa.eu/gemet/concept/11612> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition "The formal assertion in writing of some fact."@en ;
    skos:prefLabel "certification"@en .

<http://www.eionet.europa.eu/gemet/concept/11676> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1752> ;
    skos:definition "The addition or presence of chemicals to, or in, another substance to such a degree as to render it unfit for its intended purpose. Also refers to the result(s) of such an addition or presence."@en ;
    skos:prefLabel "chemical contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/12008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/263> ;
    skos:definition "Particulate matter suspended in the air. The particulate matter may be in the form of dusts, fumes, or mist. Aerosols in the atmosphere are the form in which pollutants such as smoke are dispersed."@en ;
    skos:prefLabel "atmospheric aerosol"@en .

<http://www.eionet.europa.eu/gemet/concept/12887> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4374> ;
    skos:definition "A commercial product which provides a guarantee against damage to property in return for premiums paid."@en ;
    skos:prefLabel "damage insurance"@en .

<http://www.eionet.europa.eu/gemet/concept/12912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3715> ;
    skos:definition "Institution for the management of public issues."@en ;
    skos:prefLabel "public institution"@en .

<http://www.eionet.europa.eu/gemet/concept/13060> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "A system of interrelated persons and/or devices linked to permit the exchange of data or knowledge."@en ;
    skos:prefLabel "information network"@en .

<http://www.eionet.europa.eu/gemet/concept/1310> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry related with the production of chemical compounds. The chemical processing industry has a variety of special pollution problems due to the vast number of products manufactured. The treatment processes combine processing, concentration, separation, extraction, by-product recovery, destruction, and reduction in concentration. The wastes may originate from solvent extraction, acid and caustic wastes, overflows, spills, mechanical loss, etc."@en ;
    skos:prefLabel "chemical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13102> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Operations for preparing and controlling the implementation of plans for organizing human activities on land."@en ;
    skos:prefLabel "land management and planning"@en .

<http://www.eionet.europa.eu/gemet/concept/13146> a skos:Concept ;
    skos:definition "The specific manner, form and institutions by which a government's ability to make, enforce and interpret laws are brought together into a coordinated whole."@en ;
    skos:prefLabel "organisation of the legal system"@en .

<http://www.eionet.europa.eu/gemet/concept/13159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1084> ;
    skos:definition "A particular legal arrangement for owning a firm, the principal forms are sale trades, partnerships and companies/corporations;  collective term for the system, function, process of planning, providing, coordinating, directing all efforts and resources in a business in order to achieve its goals."@en ;
    skos:prefLabel "business organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/13207> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13164> ;
    skos:definition "Any overall structure or set-up used to organize the activity of preparing land or soil for the growth of new crops, or the activity of promoting or improving the growth of existing crops."@en ;
    skos:prefLabel "cultivation system"@en .

<http://www.eionet.europa.eu/gemet/concept/13213> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry which converts various types of fuels as well as solar, water, tidal, and geothermal energy into other energy forms for a variety of household, commercial, transportation, and industrial application."@en ;
    skos:prefLabel "energy industry"@en .

<http://www.eionet.europa.eu/gemet/concept/13288> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13146> ;
    skos:definition "The organization and network of courts and other institutions, procedures and customs, officers and other personnel concerned with interpretation and enforcement of a country's law or with advice and assistance in matters pertaining to those laws."@en ;
    skos:prefLabel "legal system"@en .

<http://www.eionet.europa.eu/gemet/concept/13313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1605> ;
    skos:definition "The agents, instruments, methods or resources used to impart or interchange thoughts, opinions or information."@en ;
    skos:prefLabel "means of communication"@en .

<http://www.eionet.europa.eu/gemet/concept/1437> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "Law inspired by old Roman Law, the primary feature of which was that laws were written into a collection; codified, and not determined, as is common law, by judges. The principle of civil law is to provide all citizens with an accessible and written collection of the laws which apply to them and which judges must follow."@en ;
    skos:prefLabel "civil law"@en .

<http://www.eionet.europa.eu/gemet/concept/1479> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/640> ;
    skos:definition "That branch of meteorology concerned with the mean physical state of the atmosphere together with its statistical variations in both space and time as reflected in the weather behaviour over a period of many years."@en ;
    skos:prefLabel "climatology"@en .

<http://www.eionet.europa.eu/gemet/concept/14904> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4140> ;
    skos:definition "Techniques employed in the calibration of image data, the correction or reduction of errors occurring during capture or transmission of the data and in various types of image enhancement-operations which increase the ability of the analyst to recognize features of interest."@en ;
    skos:prefLabel "digital image processing technique"@en .

<http://www.eionet.europa.eu/gemet/concept/1500> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3462> ;
    skos:definition "The natural, rocklike, brown to black derivative of forest-type plant material, usually accumulated in peat beds and progressively compressed and indurated until it is finally altered in to graphite-like material."@en ;
    skos:prefLabel "coal"@en .

<http://www.eionet.europa.eu/gemet/concept/15092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2463> ;
    skos:definition "quantity of carbon in a “pool”, meaning a reservoir or system which has the capacity to accumulate or release carbon"@en ;
    skos:prefLabel "carbon stock"@en .

<http://www.eionet.europa.eu/gemet/concept/15125> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15046>,
        <http://www.eionet.europa.eu/gemet/concept/2441> ;
    skos:definition "ecosystems' capacity to produce biological materials used by people and to absorb waste material generated by humans, under current management schemes and extraction technologies"@en ;
    skos:prefLabel "ecological capacity"@en .

<http://www.eionet.europa.eu/gemet/concept/15154> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2040> ;
    skos:definition "Environmental degradation is a process through which the natural environment is compromised in some way, reducing biological diversity and the general health of the environment. This process can be entirely natural in origin, or it can be accelerated or caused by human activities. Many international organizations recognize environmental degradation as one of the major threats facing the planet, since humans have only been given one Earth to work with, and if the environment becomes irreparably compromised, it could mean the end of human existence."@en ;
    skos:prefLabel "environmental degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/15243> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "all waste that is not defined as hazardous"@en ;
    skos:prefLabel "non-hazardous waste"@en .

<http://www.eionet.europa.eu/gemet/concept/15275> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2438> ;
    skos:definition "The ability of a system, community or society exposed to hazards to resist, absorb, accommodate to and recover from the effects of a hazard in a timely and efficient manner, including through the preservation and restoration of its essential basic structures and functions."@en ;
    skos:prefLabel "resilience"@en .

<http://www.eionet.europa.eu/gemet/concept/15281> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12145> ;
    skos:definition """area of land
from which all surface run‑off flows through a sequence of streams, rivers or lakes
into the sea at a single river mouth, estuary or delta"""@en ;
    skos:prefLabel "river basin"@en .

<http://www.eionet.europa.eu/gemet/concept/15330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2422> ;
    skos:definition "Directive 2000/60/EC establishing a framework for Community action in the field of water policy"@en ;
    skos:prefLabel "Water Framework Directive"@en .

<http://www.eionet.europa.eu/gemet/concept/1582> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2754> ;
    skos:definition "An engine that operates by the energy of combustion of a fuel."@en ;
    skos:prefLabel "combustion engine"@en .

<http://www.eionet.europa.eu/gemet/concept/1590> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "The whole body of substantive jurisprudence applicable to the rights, intercourse and relations of persons engaged in commerce, trade or mercantile pursuits."@en ;
    skos:prefLabel "commercial law"@en .

<http://www.eionet.europa.eu/gemet/concept/1731> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The construction, rehabilitation, alteration, conversion, extension, demolition or repair of buildings, highways, or other changes or improvement to real property, including facilities providing utility services. The term also includes the supervision, inspection, and other on-site functions incidental to the actual construction."@en ;
    skos:prefLabel "construction work"@en .

<http://www.eionet.europa.eu/gemet/concept/1743> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Spending for survival or enjoyment in contrast to providing for future use or production."@en ;
    skos:prefLabel "consumption"@en .

<http://www.eionet.europa.eu/gemet/concept/2015> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/78> ;
    skos:definition "The removing of chemical, biological, or radiological contamination from, or the neutralizing of it on a person, object, or area."@en ;
    skos:prefLabel "decontamination"@en .

<http://www.eionet.europa.eu/gemet/concept/2040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "A type of organic chemical reaction in which a compound is converted into a simpler compound in stages."@en ;
    skos:prefLabel "degradation"@en .

<http://www.eionet.europa.eu/gemet/concept/206> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Agricultural law is a blend of traditional fields of law including the law of contracts, bailments, torts, criminal, environmental, property, nuisance, wills and estates, and tax law. As such, it is a gathering of statutory and common law."@en ;
    skos:prefLabel "agricultural legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2060> a skos:Concept ;
    skos:definition "The statistical study of human vital statistics and population dynamics."@en ;
    skos:prefLabel "demography"@en .

<http://www.eionet.europa.eu/gemet/concept/2084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The process by which polluting material is precipitated from the atmosphere and accumulates in ecosystems."@en ;
    skos:prefLabel "deposition"@en .

<http://www.eionet.europa.eu/gemet/concept/2282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2284> ;
    skos:definition "Material of any kind, regardless of physical form, which furnishes information, evidence or ideas, including items such as contracts, bills of sale, letters, audio and video recordings, and machine readable data files."@en ;
    skos:prefLabel "document"@en .

<http://www.eionet.europa.eu/gemet/concept/23> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1921> ;
    skos:definition "The ability, right and permission to approach and use, or the general availability of resources that transmit the beliefs, customs, artistic activity and knowledge of a people."@en ;
    skos:prefLabel "access to culture"@en .

<http://www.eionet.europa.eu/gemet/concept/237> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "Any substance or mixture of substances used or intended to be used for preventing, destroying, repelling, attracting, inhibiting, or controlling any insects, rodents, birds, nematodes, bacteria, fungi, weeds or other forms of plant, animal or microbial life regarded as pests."@en ;
    skos:prefLabel "agrochemical"@en .

<http://www.eionet.europa.eu/gemet/concept/2490> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "An increase over successive periods in the productivity and wealth of a household, country or region, as measured by one of several possible variables, such as the gross domestic product."@en ;
    skos:prefLabel "economic growth"@en .

<http://www.eionet.europa.eu/gemet/concept/2501> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496>,
        <http://www.eionet.europa.eu/gemet/concept/5093> ;
    skos:definition "The social study of the production, distribution, and consumption of wealth."@en ;
    skos:prefLabel "economics"@en .

<http://www.eionet.europa.eu/gemet/concept/2508> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Organized sets of procedures used within or between communities to govern the production and distribution of goods and services."@en ;
    skos:prefLabel "economic system"@en .

<http://www.eionet.europa.eu/gemet/concept/2564> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3869>,
        <http://www.eionet.europa.eu/gemet/concept/849> ;
    skos:prefLabel "effect on health"@en .

<http://www.eionet.europa.eu/gemet/concept/2571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "The waste liquid from domestic sewage, industrial sites or from agricultural processes. Effluents are harmful when they enter the environment, especially in freshwater, because of their polluting chemical composition."@en ;
    skos:prefLabel "effluent"@en .

<http://www.eionet.europa.eu/gemet/concept/2633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "All the equipment connected with the technological use of electric power."@en ;
    skos:prefLabel "electrotechnical equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/2640> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Group V consists of two subgroups: group Vb, the main group, and group Va. Group Va consists of vanadium, niobium, and tantalum, which are generally considered with the transition elements. The main group consists of nitrogen, phosphorus, arsenic, antimony, and bismuth."@en ;
    skos:prefLabel "element of group V"@en .

<http://www.eionet.europa.eu/gemet/concept/2641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Group VI consists of two subgroups: group VIb, the main group, and group VIa. Group VIa consists of chromium, molybdenum, and tungsten. The main group consists of oxygen, sulphur, selenium, tellurium, and polonium."@en ;
    skos:prefLabel "element of group VI"@en .

<http://www.eionet.europa.eu/gemet/concept/2654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "The formation and development of an embryo from an egg."@en ;
    skos:prefLabel "embryogenesis"@en .

<http://www.eionet.europa.eu/gemet/concept/270> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2912> ;
    skos:definition "The degree to which air is polluted; the type and maximum concentration of man-produced pollutants that should be permitted in the atmosphere."@en ;
    skos:prefLabel "air quality"@en .

<http://www.eionet.europa.eu/gemet/concept/282> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Aircraft moving in flight or on airport runways."@en ;
    skos:prefLabel "air traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/2897> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6705> ;
    skos:definition "An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to protect natural or ecological resources and advocate for ecological progress."@en ;
    skos:prefLabel "environmental programme"@en .

<http://www.eionet.europa.eu/gemet/concept/2912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Properties and characteristics of the environment, either generalized or local, as they impinge on human beings and other organisms. Environmental quality is a general term which can refer to: varied characteristics such as air and water purity or pollution, noise, access to open space, and the visual effects of buildings, and the potential effects which such characteristics may have on physical and mental health."@en ;
    skos:prefLabel "environmental quality"@en .

<http://www.eionet.europa.eu/gemet/concept/2914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:prefLabel "environmental quality objective"@en .

<http://www.eionet.europa.eu/gemet/concept/2917> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2851> ;
    skos:definition "An account or statement, usually in writing, describing in detail events, situations or conditions pertaining to the ecosystem, its natural resources or any of the external factors surrounding and affecting human life."@en ;
    skos:prefLabel "environmental report"@en .

<http://www.eionet.europa.eu/gemet/concept/2963> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3652> ;
    skos:definition "The general process or the group of processes whereby the materials of Earth's crust are loosened , dissolved, or worn away and simultaneously moved from one place to another, by natural agencies, which include weathering, solution, corrosion, and transportation, but usually exclude mass wasting."@en ;
    skos:prefLabel "erosion"@en .

<http://www.eionet.europa.eu/gemet/concept/3049> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10002> ;
    skos:definition "Spending by consumers, investors, or government for goods or services."@en ;
    skos:prefLabel "expenditure"@en .

<http://www.eionet.europa.eu/gemet/concept/3122> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Animals reared in farms for working and producing food such as meat, eggs and milk."@en ;
    skos:prefLabel "farm animal"@en .

<http://www.eionet.europa.eu/gemet/concept/3138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "The entire animal life of a given region, habitat or geological stratum."@en ;
    skos:prefLabel "fauna"@en .

<http://www.eionet.europa.eu/gemet/concept/3184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "A porous material for separating suspended particulate matter from liquids by passing the liquid through the pores in the filter and sieving out the solids."@en ;
    skos:prefLabel "filter"@en .

<http://www.eionet.europa.eu/gemet/concept/3432> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "Any material afforded by a forest for commercial use, such as tree products and forage."@en ;
    skos:prefLabel "forest product"@en .

<http://www.eionet.europa.eu/gemet/concept/3435> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:definition "Forest area set aside for the purpose of protecting certain fauna and flora, or both."@en ;
    skos:prefLabel "forest reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/3493> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9202> ;
    skos:definition "The direct or indirect human alteration of the biological, physical, chemical or radiological integrity of freshwater."@en ;
    skos:prefLabel "freshwater pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/3538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13225> ;
    skos:definition "A structure or apparatus in which heat is produced by the combustion of fuel, often to warm houses, melt metals, produce steam and bake pottery."@en ;
    skos:prefLabel "furnace"@en .

<http://www.eionet.europa.eu/gemet/concept/3628> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8494> ;
    skos:definition "The information for protein synthesis contained in the nucleotide sequences of the DNA polynucleotide chain."@en ;
    skos:prefLabel "genetic information"@en .

<http://www.eionet.europa.eu/gemet/concept/3633> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "The science that is concerned with the study of biological inheritance."@en ;
    skos:prefLabel "genetics"@en .

<http://www.eionet.europa.eu/gemet/concept/3652> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "The physical and chemical interactions between the Earth's surface and the natural forces acting upon it to produce landforms. The processes are determined by such natural environmental variables as geology, climate, vegetation and baselevel, to say nothing of human interference. The nature of the process and the rate at which it operates will be influenced by a change in any of these variables."@en ;
    skos:prefLabel "geomorphic process"@en .

<http://www.eionet.europa.eu/gemet/concept/3692> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1464>,
        <http://www.eionet.europa.eu/gemet/concept/15185> ;
    skos:definition "Changes in the surface-air temperature, referred to as the global temperature, brought about by the greenhouse effect which is induced by emission of greenhouse gases into the air."@en ;
    skos:prefLabel "global warming"@en .

<http://www.eionet.europa.eu/gemet/concept/3854> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6724> ;
    skos:definition "Any material that poses a threat to human health and/or the environment. Typical hazardous substances are toxic, corrosive, ignitable, explosive, or chemically reactive."@en ;
    skos:prefLabel "hazardous substance"@en .

<http://www.eionet.europa.eu/gemet/concept/387> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "A class of vertebrate animals characterized by a moist, glandular skin, gills at some stage of development, and no amnion during the embryonic stage."@en ;
    skos:prefLabel "amphibian"@en .

<http://www.eionet.europa.eu/gemet/concept/4040> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:definition "The process of repairing or reconstructing an edifice in order to return it to its original condition."@en ;
    skos:prefLabel "installation restoration"@en .

<http://www.eionet.europa.eu/gemet/concept/4060> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13147> ;
    skos:definition "The rights of individuals to liberty, justice, etc."@en ;
    skos:prefLabel "human rights"@en .

<http://www.eionet.europa.eu/gemet/concept/4146> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The reception of material, such as pollutants, by the environment and from any source."@en ;
    skos:prefLabel "immission"@en .

<http://www.eionet.europa.eu/gemet/concept/4233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "The guiding procedure, philosophy or course of action for the protection of natural resources from pollution generated by manufacturing or business enterprises."@en ;
    skos:prefLabel "industrial environmental policy"@en .

<http://www.eionet.europa.eu/gemet/concept/4345> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1307> ;
    skos:definition "Inorganic chemical which promotes plant growth by enhancing the supply of essential nutrients such as ammonium sulphate or lime."@en ;
    skos:prefLabel "inorganic fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/442> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:prefLabel "animal product"@en .

<http://www.eionet.europa.eu/gemet/concept/4430> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "The system of law regulating the interrelationship of sovereign states and their rights and duties with regard to one another."@en ;
    skos:prefLabel "international law"@en .

<http://www.eionet.europa.eu/gemet/concept/453> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15243>,
        <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Discarded material from industries directly associated with the raising of animals, such as those wastes produced by livestock farming (manure, milk, etc.), meat production and animal testing (animal bodies, animal parts, feathers, etc.) and fur breeding (fur, blood, etc.)."@en ;
    skos:prefLabel "animal waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4535> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "Any public organization or branch of government responsible for the administration of justice or the enforcement of laws."@en ;
    skos:prefLabel "judicial body"@en .

<http://www.eionet.europa.eu/gemet/concept/4581> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:prefLabel "labour market"@en .

<http://www.eionet.europa.eu/gemet/concept/4752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Rules concerning the limits of pollutant emissions."@en ;
    skos:prefLabel "legislation on pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/48> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1673> ;
    skos:definition "The amount of acid present in a solution, often expressed in terms of pH."@en ;
    skos:prefLabel "acidity degree"@en .

<http://www.eionet.europa.eu/gemet/concept/5175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "Industry concerned with the extraction, refining, alloying and fabrication of metals."@en ;
    skos:prefLabel "metallurgical industry"@en .

<http://www.eionet.europa.eu/gemet/concept/5184> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "An opaque crystalline material usually of high strength with good electrical and thermal conductivities, ductility and reflectivity."@en ;
    skos:prefLabel "metal"@en .

<http://www.eionet.europa.eu/gemet/concept/5187> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:prefLabel "metal working"@en .

<http://www.eionet.europa.eu/gemet/concept/5243> a skos:Concept ;
    skos:definition "Actions and movements pertaining to or conducted by the armed forces."@en ;
    skos:prefLabel "military activities"@en .

<http://www.eionet.europa.eu/gemet/concept/5325> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5327> ;
    skos:definition """1) A representation, usually on a smaller scale, of a device, structure, etc. 
2) A quantitative or mathematical representation or computer simulation which attempts to describe the characteristics or relationships of physical events."""@en ;
    skos:prefLabel "model"@en .

<http://www.eionet.europa.eu/gemet/concept/5428> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The aggregation of services offered by a town or city in which streets and other public areas are kept clean, such as through trash pick-ups, street sweeping and decontamination of water, soil and other natural resources."@en ;
    skos:prefLabel "municipal cleansing"@en .

<http://www.eionet.europa.eu/gemet/concept/5494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "An area in which natural processes predominate, fluctuations in numbers of organisms are allowed free play and human intervention is minimal."@en ;
    skos:prefLabel "natural area"@en .

<http://www.eionet.europa.eu/gemet/concept/5496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2215> ;
    skos:definition "Violent, sudden and destructive change in the environment without cause from human activity, due to phenomena such as floods, earthquakes, fire and hurricanes."@en ;
    skos:prefLabel "natural disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/5500> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "Organic material added to the soil to supply chemical elements needed for plant nutrition."@en ;
    skos:prefLabel "natural fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/5507> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "Generally, the world's natural resources as handed down to the present generation, and specifically, the earth's outstanding physical, biological and geological formations, and habitats of threatened species of animals and plants and areas with scientific, conservation or aesthetic value."@en ;
    skos:prefLabel "natural heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/5513> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:definition "A designation of project lands which preserves natural resources for their scientific, scenic, cultural and/or educational value by limiting development and management practices. Land managed to protect rare and endangered species of flora and fauna will be designed as natural areas."@en ;
    skos:prefLabel "natural park"@en .

<http://www.eionet.europa.eu/gemet/concept/5545> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10201> ;
    skos:definition "Areas allocated to preserve and protect certain animals and plants, or both. They differ from national park, which are largely a place for public recreation, because they are provided exclusively to protect species for their own sake. Endangered species are increasingly being kept in nature reserves to prevent them from extinction, particularly in India, Indonesia and some African countries. Natural reserves were used once to preserve the animals that landowners hunted, but, in the 19th century, they became places where animals were kept to prevent them from dying out. Special refuges and sanctuaries are also often designated to protect certain species or groups of wild animals or plants, especially if their numbers and distribution have been significantly reduced. They also serve as a place for more plentiful species to rest, breed or winter. Many parts of the world also have marine and aquatic reserves to protect different species of sea or freshwater plant and animal life."@en ;
    skos:prefLabel "nature reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/5613> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4350> ;
    skos:definition "Oxides formed and released in all common types of combustion; they are formed by the oxidation of atmospheric nitrogen at high temperatures. Introduced into the atmosphere from car exhausts, furnace stacks, incinerators, power stations and similar sources, the oxides include nitrous oxide, nitric oxide, nitrogen dioxide, nitrogen pentoxide and nitric acid. The oxides of nitrogen undergo many reactions in the atmosphere to form photochemical smog."@en ;
    skos:prefLabel "nitrogen oxides"@en .

<http://www.eionet.europa.eu/gemet/concept/5686> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "Area which provides commercial, industrial, and public facilities."@en ;
    skos:prefLabel "non-residential building"@en .

<http://www.eionet.europa.eu/gemet/concept/571> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/572> ;
    skos:definition "The largest phylum in the animal kingdom; adults typically have segmented body, a sclerotized integument, and many-jointed segmental limbs."@en ;
    skos:prefLabel "arthropod"@en .

<http://www.eionet.europa.eu/gemet/concept/5797> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9231> ;
    skos:definition "The scientific study and exploration of the oceans and seas in all their aspects."@en ;
    skos:prefLabel "oceanography"@en .

<http://www.eionet.europa.eu/gemet/concept/5927> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Molecules containing carbon-metal linkage; a compound containing an alkyl or aryl radical bonded to a metal."@en ;
    skos:prefLabel "organometallic compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Collection of rights to use and enjoy property, including right to transmit it to others. The complete dominion, title, or proprietary right in a thing or claim."@en ;
    skos:prefLabel "ownership"@en .

<http://www.eionet.europa.eu/gemet/concept/60> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The science of the production, transmission and effects of sound."@en ;
    skos:prefLabel "acoustics"@en .

<http://www.eionet.europa.eu/gemet/concept/6201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1324> ;
    skos:definition "Chemical reaction which is initiated by light of a specific wavelength. In an environmental context an example is the potential action of ultraviolet light on CFCs which may bring about the detrimental degradation of the ozone layer. Photochemical reactions initiate the process of photosynthesis in which plants convert carbon dioxide into sugars, which are incorporated into cell materials."@en ;
    skos:prefLabel "photochemical reaction"@en .

<http://www.eionet.europa.eu/gemet/concept/6205> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2284> ;
    skos:definition "An image captured by a camera or some other device and reproduced as a picture, usually on a sensitized surface and formed by the chemical action of light or of radiant energy."@en ;
    skos:prefLabel "photograph"@en .

<http://www.eionet.europa.eu/gemet/concept/6225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "A form of urban land use planning which attempts to achieve an optimal spatial coordination of different human activities for the enhancement of the quality of life."@en ;
    skos:prefLabel "physical planning"@en .

<http://www.eionet.europa.eu/gemet/concept/6235> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6230> ;
    skos:definition "The study of those aspects of nature which can be understood in a fundamental way in terms of elementary principles and laws."@en ;
    skos:prefLabel "physics"@en .

<http://www.eionet.europa.eu/gemet/concept/627> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/641> ;
    skos:definition "Any one of a number of strata or layers of the earth's atmosphere; temperature distribution is the most common criterion used for denoting the various shell. Also known as atmospheric shell; atmospheric region."@en ;
    skos:prefLabel "atmospheric layering"@en .

<http://www.eionet.europa.eu/gemet/concept/6290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to organize, designate and regulate land use within its domain through zoning laws, subdivision regulations, rent and sign controls, growth management and other measures designed to protect human health and ecological integrity."@en ;
    skos:prefLabel "planning law"@en .

<http://www.eionet.europa.eu/gemet/concept/6359> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4046> ;
    skos:definition "The morbid condition produced by a poison which may be swallowed, inhaled, injected, or absorbed through the skin."@en ;
    skos:prefLabel "poisoning"@en .

<http://www.eionet.europa.eu/gemet/concept/636> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2895> ;
    skos:definition "The presence in the air of one or more contaminants in such a concentration and of such duration as to cause a nuisance or to be injurious to human life, animal life or vegetation."@en ;
    skos:prefLabel "atmospheric pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/6376> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2892> ;
    skos:definition "The guiding procedure, philosophy or course of action for preserving and renewing human and natural resources."@en ;
    skos:prefLabel "conservation policy"@en .

<http://www.eionet.europa.eu/gemet/concept/639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/617> ;
    skos:definition "Atmospheric processes are distinguished in physical and chemical processes and both types may be operating simultaneously in complicated and interdependent ways. The physical processes of transport by atmospheric winds and the formation of clouds and precipitation strongly influence the patterns and rates of acidic deposition, while chemical reactions govern the forms of the compounds deposited."@en ;
    skos:prefLabel "atmospheric process"@en .

<http://www.eionet.europa.eu/gemet/concept/6412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "The process of completely removing a pollutant's source as well as the pollutant itself."@en ;
    skos:prefLabel "pollutant elimination"@en .

<http://www.eionet.europa.eu/gemet/concept/6425> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6469> ;
    skos:definition "Periodic or continuous determination of the amount of pollutants present in the environment."@en ;
    skos:prefLabel "pollutant monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/6519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "A group of organisms of one species, occupying a defined area."@en ;
    skos:prefLabel "population (ecological)"@en .

<http://www.eionet.europa.eu/gemet/concept/6594> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7796> ;
    skos:definition "Any politically active group with a common set of values about resource use allocation. Pressure groups seek to influence decisions on resource use allocation in excess of their proportional representation in the planned-for populace by seeking preferential consideration for their resource use choices."@en ;
    skos:prefLabel "pressure group"@en .

<http://www.eionet.europa.eu/gemet/concept/6802> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "A general classification of law, consisting generally of constitutional, administrative, criminal and international law, concerned with the organization of the state, the relations between the state and the people who compose it, the responsibilities of public officers to the state, to each other, and to private persons, and the relations of states to one other. The branch or department of law which is concerned with the state in its political or sovereign capacity, including constitutional and administrative law, and with the definition, regulation, and enforcement of rights in cases where the state is regarded as the subject of the right or object of the duty, - including criminal law and criminal procedure, - and the law of the state, considered in its quasi private personality, i.e., as capable of holding or exercising rights, or acquiring and dealing with property, in the character of an individual."@en ;
    skos:prefLabel "public law"@en .

<http://www.eionet.europa.eu/gemet/concept/6822> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "An enterprise concerned with the provision to the public of essentials, such as electricity or water."@en ;
    skos:prefLabel "public utility"@en .

<http://www.eionet.europa.eu/gemet/concept/6824> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "Structures, as roads, dams, or post offices, paid for by government funds for public use."@en ;
    skos:prefLabel "public works"@en .

<http://www.eionet.europa.eu/gemet/concept/6939> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:prefLabel "railroad vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/7001> a skos:Concept ;
    skos:definition "Activities that promote refreshment of health or spirits by relaxation and enjoyment."@en ;
    skos:prefLabel "recreation"@en .

<http://www.eionet.europa.eu/gemet/concept/7003> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3770> ;
    skos:definition "A piece of publicly owned land, especially in a town, used for sports and games."@en ;
    skos:prefLabel "recreational area"@en .

<http://www.eionet.europa.eu/gemet/concept/7103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320> ;
    skos:definition "General term indicating the elimination of substances from a medium or from the environment."@en ;
    skos:prefLabel "removal"@en .

<http://www.eionet.europa.eu/gemet/concept/7185> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:definition "The counteracting or undoing of negative effects or influences on the environment."@en ;
    skos:prefLabel "impact reversal"@en .

<http://www.eionet.europa.eu/gemet/concept/7244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9161> ;
    skos:definition "A stream of water which flows in a channel from high ground to low ground and ultimately to a lake or the sea, except in a desert area where it may dwindle away to nothing. A river and all its tributaries within a single basin is termed a drainage system."@en ;
    skos:prefLabel "river"@en .

<http://www.eionet.europa.eu/gemet/concept/7293> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "Circulation of motor vehicles and people on the road network."@en ;
    skos:prefLabel "road traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/7402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water of the seas, distinguished by high salinity."@en ;
    skos:prefLabel "salt water"@en .

<http://www.eionet.europa.eu/gemet/concept/7554> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13148> ;
    skos:definition "A part of a country's or region's commercial, industrial and financial activity, delimited either by public, corporate and private organization of expenditures or by agriculture, manufacturing and service product types."@en ;
    skos:prefLabel "economic sector"@en .

<http://www.eionet.europa.eu/gemet/concept/7641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "System of pipes, usually underground, for carrying waste water and human waste away from houses and other buildings, to a place where they can be safely get rid of."@en ;
    skos:prefLabel "sewerage system"@en .

<http://www.eionet.europa.eu/gemet/concept/77> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The involvement, either by an individual or a group of individuals, in their own governance or other activities, with the purpose of exerting influence."@en ;
    skos:prefLabel "active participation"@en .

<http://www.eionet.europa.eu/gemet/concept/7791> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "A concept associated with evolutionary theories of history and with structural functionalism. Societies are seen as moving from the simple to the complex via a process of social change based on structural differentiation."@en ;
    skos:prefLabel "social differentiation"@en .

<http://www.eionet.europa.eu/gemet/concept/7817> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "A term loosely applied to any recurring pattern of social behaviour; or, more specifically, to the ordered interrelationships between the different elements or a social system or society."@en ;
    skos:prefLabel "social structure"@en .

<http://www.eionet.europa.eu/gemet/concept/7848> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "The suitability of soils for various uses, e.g. sustained production of cultivated crops, pasture plants, etc., depending on depth, texture, kinds of minerals, salinity, kinds of salts, acidity, etc."@en ;
    skos:prefLabel "soil capability"@en .

<http://www.eionet.europa.eu/gemet/concept/7882> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "A vertical section of a soil, showing horizons and parent material."@en ;
    skos:prefLabel "soil profile"@en .

<http://www.eionet.europa.eu/gemet/concept/7899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7843> ;
    skos:definition "A phase or subdivision of a soil series based primarily on texture of the surface soil to a depth at least equal to plow depth (about 15 cm)."@en ;
    skos:prefLabel "soil type"@en .

<http://www.eionet.europa.eu/gemet/concept/7919> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8072> ;
    skos:definition "The physical state of matter in which the constituent molecules, atoms, or ions have no translatory motion although they vibrate about the fixed positions that they occupy in a crystal lattice."@en ;
    skos:prefLabel "solid state"@en .

<http://www.eionet.europa.eu/gemet/concept/7930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6233> ;
    skos:definition "The taking up, usually, of a liquid or gas into the body of another material (the absorbent). Thus, for instance, an air pollutant may be removed by absorption in a suitable solvent."@en ;
    skos:prefLabel "sorption"@en .

<http://www.eionet.europa.eu/gemet/concept/7933> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/60> ;
    skos:definition "Auditory sensation produced by the oscillations, stress, pressure, particle displacement, and particle velocity in a medium with internal forces; pressure variation that the human ear can detect."@en ;
    skos:prefLabel "sound"@en .

<http://www.eionet.europa.eu/gemet/concept/8078> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7832> ;
    skos:definition "The extent to which a society promotes human well-being in all dimensions of existence by forming people's capabilities, expanding choices and increasing opportunities."@en ;
    skos:prefLabel "status of development"@en .

<http://www.eionet.europa.eu/gemet/concept/8319> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2175> ;
    skos:definition "The act of imparting knowledge or skill."@en ;
    skos:prefLabel "teaching"@en .

<http://www.eionet.europa.eu/gemet/concept/8330> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "Changing of industrial methods by introducing new technology."@en ;
    skos:prefLabel "technological change"@en .

<http://www.eionet.europa.eu/gemet/concept/8366> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6229> ;
    skos:definition "A property that determines the direction of heat flow when an object is brought into thermal contact with other objects: heat flows from regions of higher to those of lower temperatures."@en ;
    skos:prefLabel "temperature"@en .

<http://www.eionet.europa.eu/gemet/concept/849> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Biological effects include allergic reactions, respiratory disorders, hypersensitivity diseases and infectious diseases and can be caused by a variety of contaminants and pollutants."@en ;
    skos:prefLabel "biological effect"@en .

<http://www.eionet.europa.eu/gemet/concept/8494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/406> ;
    skos:definition "A part of an organism consisting of a large number of cells having a similar structure and function."@en ;
    skos:prefLabel "tissue"@en .

<http://www.eionet.europa.eu/gemet/concept/8522> a skos:Concept ;
    skos:definition "The temporary movement of people to destinations outside their normal places or work and residence, the activities undertaken during their stay in those destinations and the facilities created to cater for their needs."@en ;
    skos:prefLabel "tourism"@en .

<http://www.eionet.europa.eu/gemet/concept/8598> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8582> ;
    skos:definition "The movement of boats and other vessels over any water route or area."@en ;
    skos:prefLabel "traffic on water"@en .

<http://www.eionet.europa.eu/gemet/concept/8607> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2547> ;
    skos:definition "The process of bringing a person or a group of persons to an agreed standard of proficiency, by practice and instruction."@en ;
    skos:prefLabel "training"@en .

<http://www.eionet.europa.eu/gemet/concept/861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "The direct measurement of changes in the biological status of a habitat, based on evaluations of the number and distribution of individuals or species before and after a change."@en ;
    skos:prefLabel "biological monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/8653> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "System of lines of movements or communication by road, rail, water or air."@en ;
    skos:prefLabel "transport system"@en .

<http://www.eionet.europa.eu/gemet/concept/8671> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "The general drift, tendency, or bent of a set of statistical data as related to time or another related set of statistical data."@en ;
    skos:prefLabel "trend"@en .

<http://www.eionet.europa.eu/gemet/concept/8794> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6705> ;
    skos:definition "A planned, coordinated group of activities or services intended for improving urban centers in order to provide healthy and safe living conditions, efficient transport and communication, adequate public facilities and aesthetic surroundings."@en ;
    skos:prefLabel "urban action program"@en .

<http://www.eionet.europa.eu/gemet/concept/8797> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8841> ;
    skos:definition "Areas within the legal boundaries of cities and towns; suburban areas developed for residential, industrial or recreational purposes."@en ;
    skos:prefLabel "urban area"@en .

<http://www.eionet.europa.eu/gemet/concept/8815> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3770> ;
    skos:definition "The complex of private and public gardens in an urban area."@en ;
    skos:prefLabel "urban green"@en .

<http://www.eionet.europa.eu/gemet/concept/8922> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6299> ;
    skos:definition "1) The plants of an area considered in general or as communities, but not taxonomically; the total plant cover in a particular area or on the Earth as a whole. 2) The total mass of plant life that occupies a given area."@en ;
    skos:prefLabel "vegetation"@en .

<http://www.eionet.europa.eu/gemet/concept/9035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10054> ;
    skos:definition "Any series of procedures and devices designed to detect sudden or potential threats to persons, property or the environment, often utilizing radar technology."@en ;
    skos:prefLabel "warning system"@en .

<http://www.eionet.europa.eu/gemet/concept/9091> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A binding rule or body of rules prescribed by a government to regulate the disposal of unwanted materials left over from a manufacturing process or the refuse from places of human or animal habitation."@en ;
    skos:prefLabel "waste legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/9161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124>,
        <http://www.eionet.europa.eu/gemet/concept/9232> ;
    skos:definition "A natural stream arising in a given drainage basin but not wholly dependent for its flow on surface drainage in its immediate area, flowing in a channel with a well-defined bed between visible banks or through a definite depression in the land, having a definite and permanent or periodic supply of water, and usually, but not necessarily, having a perceptible current in a particular direction and discharging at a fixed point into another body of water."@en ;
    skos:prefLabel "watercourse"@en .

<http://www.eionet.europa.eu/gemet/concept/9196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "Studies conducted to estimate the quantity and the quality of pollutants, nutrients and suspended solids contained in water bodies and to assess sources and factors associated with agricultural practices, industrial activities or other human activities."@en ;
    skos:prefLabel "water monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/9202> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2895> ;
    skos:definition "The manmade or man-induced alteration of the chemical, physical, biological and radiological integrity of water."@en ;
    skos:prefLabel "water pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/9206> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Measures to conserve surface and groundwater; to ensure the continued availability of water for growing domestic, commercial and industrial uses and to ensure sufficient water for natural ecosystems."@en ;
    skos:prefLabel "water protection"@en .

<http://www.eionet.europa.eu/gemet/concept/9214> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2912> ;
    skos:definition "A graded value of the components (organic and inorganic, chemical or physical) which comprise the nature of water."@en ;
    skos:prefLabel "water quality"@en .

<http://www.eionet.europa.eu/gemet/concept/9231> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "The science that treats the occurrence, circulation, distribution, and properties of the waters of the earth, and their reaction with the environment."@en ;
    skos:prefLabel "water science"@en .

<http://www.eionet.europa.eu/gemet/concept/9244> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "A source or volume of water available for use; also, the system of reservoirs, wells, conduits, and treatment facilities required to make the water available and usable."@en ;
    skos:prefLabel "water supply"@en .

<http://www.eionet.europa.eu/gemet/concept/9254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8590> ;
    skos:definition "A river, canal, or other navigable channel used as a means of travel or transport."@en ;
    skos:prefLabel "waterway"@en .

<http://www.eionet.europa.eu/gemet/concept/9267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4260> ;
    skos:definition "An instrument of attack or defense in combat, as a gun, missile, or sword."@en ;
    skos:prefLabel "weapon"@en .

<http://www.eionet.europa.eu/gemet/concept/971> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "A branch of the biological sciences which embraces the study of plants and plant life."@en ;
    skos:prefLabel "botany"@en .

<http://www.eionet.europa.eu/gemet/concept/10002> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1084> ;
    skos:definition "Method of recording all the transactions affecting the financial condition of a business or organization."@en ;
    skos:prefLabel "accounting"@en .

<http://www.eionet.europa.eu/gemet/concept/10057> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The study of society and of the relationship of individual members within society, including economics, history, political science, psychology, anthropology, and sociology."@en ;
    skos:prefLabel "social science"@en .

<http://www.eionet.europa.eu/gemet/concept/1033> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "A building element which uses industrial products that are manufactured as independent until capable of being joined with other elements."@en ;
    skos:prefLabel "building component"@en .

<http://www.eionet.europa.eu/gemet/concept/1064> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "Any structure made of stone, bricks, wood, concrete, or steel, built with a roof and walls, such as a house or factory."@en ;
    skos:prefLabel "built structure"@en .

<http://www.eionet.europa.eu/gemet/concept/1065> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Area which is full of houses, shops, offices and other buildings, with very little open space."@en ;
    skos:prefLabel "built-up area"@en .

<http://www.eionet.europa.eu/gemet/concept/11494> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition """1) A direction or command of a court. In this sense it is often used synonymously with judgment. 
2) The document bearing the seal of the court recording its judgment in a case."""@en ;
    skos:prefLabel "order"@en .

<http://www.eionet.europa.eu/gemet/concept/12011> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15047>,
        <http://www.eionet.europa.eu/gemet/concept/5388> ;
    skos:definition "A gaseous, liquid, or solid fuel that contains an energy content derived from a biological source. The organic matter that makes up living organisms provides a potential source of trapped energy that is beginning to be exploited to supply the ever-increasing energy demand around the world. An example of a biofuel is rapeseed oil, which can be used in place of diesel fuel in modified engines. The methyl ester of this oil, rapeseed methyl ester (RME), can be used in unmodified diesel engines and is sometimes known as biodiesel. Other biofuels include biogas and gasohol."@en ;
    skos:prefLabel "biofuel"@en .

<http://www.eionet.europa.eu/gemet/concept/12783> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "Any site or region in which there is a physical or chemical agent capable of causing harm to property, persons, animals, plants or other natural resources."@en ;
    skos:prefLabel "hazard area"@en .

<http://www.eionet.europa.eu/gemet/concept/13151> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The study, policies or system of institutions and procedures by which a country or region's commerce is supplied with notes, coins, bank deposits or other equivalent mediums of exchange."@en ;
    skos:prefLabel "monetary economics"@en .

<http://www.eionet.europa.eu/gemet/concept/13177> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The financial facility or system by which goods and services are provided in return for deferred, instead of immediate, payment."@en ;
    skos:prefLabel "credit"@en .

<http://www.eionet.europa.eu/gemet/concept/13242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The conduct or carrying on of trade, business or a financial matter to a conclusion or settlement."@en ;
    skos:prefLabel "commercial transaction"@en .

<http://www.eionet.europa.eu/gemet/concept/13290> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:definition "Any prescribed step or manner of proceeding that a law making body takes in proposing laws, resolutions or special acts before they can be enacted or passed."@en ;
    skos:prefLabel "legislative procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/13291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "systematic approach or method of performance for the accomplishment of administrative goals or tasks."@en ;
    skos:prefLabel "management technique"@en .

<http://www.eionet.europa.eu/gemet/concept/1336> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Processes that alter the chemical structure of the constituents of the waste to produce either an innocuous or a less hazardous material. Chemical processes are attractive because they produce minimal air emissions, they can often be carried out on the site of the waste generator, and some processes can be designed and constructed as mobile units."@en ;
    skos:prefLabel "chemical treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/1464> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Climate has a central influence on many human needs and activities, such as agriculture, housing, human health, water resources, and energy use. The influence of climate on vegetation and soil type is so strong that the earliest climate classification schemes where often based more on these factors than on the meteorological variables. While technology can be used to mitigate the effects of unfavorable climatic conditions, climate fluctuations that result in significant departures from normal cause serious problems for modern industrialized societies as much as for primitive ones. The goals of climatology are to provide a comprehensive description of the Earth's climate, to understand its features in terms of fundamental physical principles, and to develop models of the Earth's climate that will allow the prediction of future changes that may result from natural and human causes."@en ;
    skos:prefLabel "climate effect"@en .

<http://www.eionet.europa.eu/gemet/concept/1471> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "The long-term fluctuations in temperature, precipitation, wind, and all other aspects of the Earth's climate. External processes, such as solar-irradiance variations, variations of the Earth's orbital parameters (eccentricity, precession, and inclination), lithosphere motions, and volcanic activity, are factors in climatic variation. Internal variations of the climate system, e.g., changes in the abundance of greenhouse gases, also may produce fluctuations of sufficient magnitude and variability to explain observed climate change through the feedback processes interrelating the components of the climate system."@en ;
    skos:prefLabel "climate change"@en .

<http://www.eionet.europa.eu/gemet/concept/1513> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5494> ;
    skos:definition "The areas of land and sea bordering the shoreline and extending seaward through the breaker zone."@en ;
    skos:prefLabel "coastal area"@en .

<http://www.eionet.europa.eu/gemet/concept/15182> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2124> ;
    skos:definition "tbc"@en ;
    skos:prefLabel "gas desulphurisation"@en .

<http://www.eionet.europa.eu/gemet/concept/15183> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663>,
        <http://www.eionet.europa.eu/gemet/concept/625> ;
    skos:definition "Dataset of all emission estimates, typically expressed by source for a particular pollutant, for a particular location and for a defined time span"@en ;
    skos:prefLabel "emission inventory"@en .

<http://www.eionet.europa.eu/gemet/concept/15339> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3400> ;
    skos:definition "Studies aiming at providing information and advice for shaping the future. The results of forward-looking studies can be fed into the foresight processes, as well as into other strategic decision-making processes, but taken alone they cannot deliver the governance-related benefits that foresight processes offer. Examples of forward-looking studies are environmental outlooks and scenario and megatrend studies."@en ;
    skos:prefLabel "forward-looking studies"@en .

<http://www.eionet.europa.eu/gemet/concept/1746> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5305> ;
    skos:definition "A large case that can be transported by truck and than easily loaded on a ship."@en ;
    skos:prefLabel "container"@en .

<http://www.eionet.europa.eu/gemet/concept/1776> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "International agreement on a specific topic."@en ;
    skos:prefLabel "convention"@en .

<http://www.eionet.europa.eu/gemet/concept/1862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10084> ;
    skos:definition "That body of the law that deals with conduct considered so harmful to society as a whole that it is prohibited by statute, prosecuted and punished by the government."@en ;
    skos:prefLabel "criminal law"@en .

<http://www.eionet.europa.eu/gemet/concept/1921> a skos:Concept ;
    skos:definition "The body of customary beliefs, social forms, and material traits constituting a distinct complex of tradition of a racial or social group."@en ;
    skos:prefLabel "culture (society)"@en .

<http://www.eionet.europa.eu/gemet/concept/2009> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:prefLabel "decision process"@en .

<http://www.eionet.europa.eu/gemet/concept/2124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7103> ;
    skos:definition "The removal of sulphur, as from molten metals or petroleum oil. Sulphur residues in fuels end up as sulphur dioxide when the fuel is burned causing acid rain."@en ;
    skos:prefLabel "desulphurisation"@en .

<http://www.eionet.europa.eu/gemet/concept/2308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "The amount of test substance administered. Dose is expressed as weight of test substance (g, mg) per unit weight of test animal (e.g., mg/kg), or as weight of food or drinking water."@en ;
    skos:prefLabel "dose"@en .

<http://www.eionet.europa.eu/gemet/concept/2400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4855> ;
    skos:definition "The outer layers of the Earth's structure, varying between 6 and 48 km in thickness, and comprising all the material above the Mohorovicic Discontinuity (a seismic discontinuity occurring between the crust of the earth and the underlying mantle; the discontinuity occurs at an average depth of 35 km below the continents and at about 10 km below the oceans). The earlier idea of a cool solid skin overlaying a hot molten interior has now been replaced by a concept of a crust composed of two shells: an inner basic unit composed of sima (oceanic crust) and an outer granitic unit composed of sial (continental crust)."@en ;
    skos:prefLabel "earth's crust"@en .

<http://www.eionet.europa.eu/gemet/concept/2440> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Ecological assessment consists in monitoring the current and changing conditions of ecological resources from which success or failure of the ecosystem can be judged without bias; understanding more fully the structure and function of ecosystems in order to develop improved management options; developing models to predict the response of ecosystems to changes resulting from human-induced stress from which possible ecosystem management strategies can be assessed and assessing the ecological consequences of management actions so that decisionmakers can best understand the outcomes of choosing a particular management strategy."@en ;
    skos:prefLabel "ecological assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/2470> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805>,
        <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "The study of the interrelationships between living organisms and their environment."@en ;
    skos:prefLabel "ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/2525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2470> ;
    skos:definition "Ecosystems can be classified according to various criteria: from the point of view of energy source, two major types of ecosystems can be distinguished. Autotrophic ecosystems have primary producers as a principal component and sunlight has the major initial energy source; etherotrophic ecosystems depend upon preformed organic matter that is imported from autotrophic ecosystems elsewhere. Ecosystems can also be classified in terrestrial, marine and freshwater."@en ;
    skos:prefLabel "ecosystem type"@en .

<http://www.eionet.europa.eu/gemet/concept/2534> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11514> ;
    skos:prefLabel "EC regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/2547> a skos:Concept ;
    skos:definition "The act or process of imparting or acquiring knowledge or skills."@en ;
    skos:prefLabel "education"@en .

<http://www.eionet.europa.eu/gemet/concept/2637> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Any of the divalent electropositive metals beryllium, magnesium, calcium, strontium, barium, and radium, belonging to group 2A of the periodic table."@en ;
    skos:prefLabel "element of group II (alkaline earth metals)"@en .

<http://www.eionet.europa.eu/gemet/concept/2638> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Group III consists of two subgroups: group IIIb and group IIIa. Group IIIa consists of scandium, yttrium, and lanthanium, which is generally considered with the lanthanoids, and actinium, which is classified with the actinoids. Group IIIb, the main group, comprises boron, aluminium, gallium, indium, and thallium."@en ;
    skos:prefLabel "element of group III"@en .

<http://www.eionet.europa.eu/gemet/concept/2639> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Group IV consists of two subgroups: group IVb, main group, and group IVa. Group IVa consists of titanium, zirconium, and hafnium which are generally classified as transition metals. The main group consists of carbonium, silicium, germanium, tin, and lead. The main valency of the elements is IV, and the members of the group show a variation from nonmetallic to metallic behaviour in moving down the group. The reactivity of the elements increases down the group from carbon to lead. All react with oxygen on heating."@en ;
    skos:prefLabel "element of group IV"@en .

<http://www.eionet.europa.eu/gemet/concept/2642> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "Any of the elements of the halogen family, consisting of fluorine, chlorine, bromine, iodine, and astatine."@en ;
    skos:prefLabel "element of group VII"@en .

<http://www.eionet.europa.eu/gemet/concept/2735> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "Generation of energy in a coal fired power station, in an oil fired power station, in a nuclear power station, etc."@en ;
    skos:prefLabel "energy production"@en .

<http://www.eionet.europa.eu/gemet/concept/2741> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "Potential supplies of energy including fossil and nuclear fuels as well as solar, water, wind, tidal and geothermal power."@en ;
    skos:prefLabel "energy source"@en .

<http://www.eionet.europa.eu/gemet/concept/2796> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1824> ;
    skos:definition "Expenses incurred as a result of some violation of ecological integrity either by an enterprise that implements a program to rectify the situation, or by society or the ecosystem as a whole when no person or enterprise is held liable."@en ;
    skos:prefLabel "environmental cost"@en .

<http://www.eionet.europa.eu/gemet/concept/2856> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "Securities held for the production of income in the form of interest and dividends with the aim of benefitting the environment."@en ;
    skos:prefLabel "environmental investment"@en .

<http://www.eionet.europa.eu/gemet/concept/3110> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2084> ;
    skos:definition "The descent of airborne solid or liquid particles to the ground, which occurs when the speed at which they fall due to gravity exceeds that of any upward motion of the air surrounding them."@en ;
    skos:prefLabel "fallout"@en .

<http://www.eionet.europa.eu/gemet/concept/3455> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3715> ;
    skos:definition "Form of authority in which an individual or group of individuals wield power over the majority."@en ;
    skos:prefLabel "form of government"@en .

<http://www.eionet.europa.eu/gemet/concept/3559> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3770> ;
    skos:definition "A piece of land next to a house where flowers and other plants are grown and which often has an area of grass."@en ;
    skos:prefLabel "garden"@en .

<http://www.eionet.europa.eu/gemet/concept/3578> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/12606> ;
    skos:definition "Gas is treated before it can be supplied to the marketplace. The extent to which gas needs to be processed will depend on its quality, the amount of associated impurities such as water, carbon dioxide and sulphur compounds, and the ultimate end-use for the gas. Common gaseous impurities found in natural gas are carbon dioxide and sulphur compounds. Both have an acidic reaction and are given the generic name 'acid gases'. These gases can be removed by a number of commercial processes, using either a physical or a chemical solvent. Physical solvent processes tend to be used where gas pressures are high and for gases with lower levels of propane and heavier hydrocarbons."@en ;
    skos:prefLabel "treatment of gases"@en .

<http://www.eionet.europa.eu/gemet/concept/3648> a skos:Concept ;
    skos:definition "Dynamic actions or events that occur at the Earth's surface due to application of natural forces resulting from gravity, temperature changes, freezing and thawing, chemical reactions, seismic shaking, and the agencies of wind and moving water, ice and snow. Where and when a force exceeds the strength of the earth material, the material is changed by deformation, translocation, or chemical reactions."@en ;
    skos:prefLabel "geological process"@en .

<http://www.eionet.europa.eu/gemet/concept/367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The landmasses and islands of North America, South America, Mexico, and Central America included in the Western Hemisphere."@en ;
    skos:prefLabel "Americas"@en .

<http://www.eionet.europa.eu/gemet/concept/3715> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "A body of top government officials appointed to advise the President or the chief executive officer of a country, usually consisting of the heads of government departments or agencies."@en ;
    skos:prefLabel "government (cabinet)"@en .

<http://www.eionet.europa.eu/gemet/concept/3770> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "A plot of vegetated land separating or surrounding areas of intensive residential or industrial use and devoted to recreation or park uses."@en ;
    skos:prefLabel "green space"@en .

<http://www.eionet.europa.eu/gemet/concept/3820> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5924> ;
    skos:definition "One of a group of halogen derivatives of organic hydrogen and carbon containing compounds; the group includes monohalogen compounds (alkyl or aryl halides) and polyhalogen compounds that contain the same or different halogen atoms."@en ;
    skos:prefLabel "halogenated hydrocarbon"@en .

<http://www.eionet.europa.eu/gemet/concept/3869> a skos:Concept ;
    skos:definition "Relationship between the quality of the environment and the health conditions of individuals."@en ;
    skos:prefLabel "health-environment relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/4022> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7825> ;
    skos:definition """1) Dwelling-houses collectively and the provision of these.
2) Shelter, lodging."""@en ;
    skos:prefLabel "housing"@en .

<http://www.eionet.europa.eu/gemet/concept/4052> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2215> ;
    skos:definition "Violent, sudden and destructive change in the environment caused by man."@en ;
    skos:prefLabel "human-made disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/4115> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "An accounting of the inflow to, outflow from, and storage in a hydrologic unit such as a drainage basin, aquifer, soil zone, lake or reservoir; the relationship between evaporation, precipitation, runoff, and the change in water storage."@en ;
    skos:prefLabel "hydrologic balance"@en .

<http://www.eionet.europa.eu/gemet/concept/4159> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Evaluation of the effect of a project upon the environment."@en ;
    skos:prefLabel "impact assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/429> a skos:Concept ;
    skos:definition "A branch of agriculture concerned with the breeding and feeding of domestic animals."@en ;
    skos:prefLabel "animal husbandry"@en .

<http://www.eionet.europa.eu/gemet/concept/4374> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "The act, system, or business of providing financial protection contingencies, such as death, loss or damage and involving payment of regular premiums in return for a policy guaranteeing such protection."@en ;
    skos:prefLabel "insurance"@en .

<http://www.eionet.europa.eu/gemet/concept/4855> a skos:Concept ;
    skos:definition "The solid portion of the Earth, as compared with the atmosphere and the hydrosphere."@en ;
    skos:prefLabel "lithosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/5007> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3169> ;
    skos:definition "Animal excreta collected from stables and barnyards with or without litter; used to enrich the soil."@en ;
    skos:prefLabel "manure"@en .

<http://www.eionet.europa.eu/gemet/concept/5011> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/14934> ;
    skos:definition "A representation, normally on a flat medium, that displays the physical and political features of a surface area of the earth, showing them in their respective forms, sizes and relationships according to some convention of representation."@en ;
    skos:prefLabel "map"@en .

<http://www.eionet.europa.eu/gemet/concept/5079> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13313> ;
    skos:definition "The means of communication that reach large numbers of people, such as television, newspapers, magazines and radio."@en ;
    skos:prefLabel "mass media"@en .

<http://www.eionet.europa.eu/gemet/concept/5086> a skos:Concept ;
    skos:definition "The substance of which a product is made or composed."@en ;
    skos:prefLabel "material"@en .

<http://www.eionet.europa.eu/gemet/concept/5264> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2400> ;
    skos:definition "A mass of naturally occurring mineral material, e.g. metal ores or nonmetallic mineral, usually of economic value, without regard to mode of origin."@en ;
    skos:prefLabel "mineral deposit"@en .

<http://www.eionet.europa.eu/gemet/concept/5349> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Specific equipment used in remote sensing."@en ;
    skos:prefLabel "monitoring equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10019> ;
    skos:definition "The art and science of designing and building structures, or large groups of structures, in keeping with aesthetic and functional criteria."@en ;
    skos:prefLabel "architecture"@en .

<http://www.eionet.europa.eu/gemet/concept/5605> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2640> ;
    skos:definition "An essential nutrient in the food supply of plants and the diets of animals. Animals obtain it in nitrogen-containing compounds, particularly amino acids. Although the atmosphere is nearly 80% gaseous nitrogen, very few organisms have the ability to use it in this form. The higher plants normally obtain it from the soil after micro-organisms have converted the nitrogen into ammonia or nitrates, which they can then absorb."@en ;
    skos:prefLabel "nitrogen"@en .

<http://www.eionet.europa.eu/gemet/concept/5674> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Radiation that does not change the structure of atoms but does heat tissue and may cause harmful biological effects."@en ;
    skos:prefLabel "non-ionising radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/57> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6033> ;
    skos:definition "Physical quantity of sound measured, usually expressed in decibels."@en ;
    skos:prefLabel "acoustic level"@en .

<http://www.eionet.europa.eu/gemet/concept/5765> a skos:Concept ;
    skos:definition "A process in animals and plants involving the intake of nutrient materials and their subsequent assimilation into the tissues."@en ;
    skos:prefLabel "nutrition"@en .

<http://www.eionet.europa.eu/gemet/concept/5956> a skos:Concept ;
    skos:definition "The material such as soil and rock lying above a mineral deposit that must be removed in order to work the deposit."@en ;
    skos:prefLabel "overburden"@en .

<http://www.eionet.europa.eu/gemet/concept/6138> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Any organism that damages crops, injures or irritates livestock or man, or reduces the fertility of land."@en ;
    skos:prefLabel "pest"@en .

<http://www.eionet.europa.eu/gemet/concept/6139> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1874> ;
    skos:definition "Keeping down the number of pests by killing them or preventing them from attacking."@en ;
    skos:prefLabel "pest control"@en .

<http://www.eionet.europa.eu/gemet/concept/617> a skos:Concept ;
    skos:definition "The gaseous envelope surrounding the Earth in a several kilometers-thick layer."@en ;
    skos:prefLabel "atmosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/6240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/881> ;
    skos:definition "The biological study of the functions of living organisms and their parts."@en ;
    skos:prefLabel "physiology"@en .

<http://www.eionet.europa.eu/gemet/concept/641> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/617> ;
    skos:definition "The gaseous area surrounding the planet is divided into several concentric spherical strata (layers, like shells) separated by narrow transition zones. The boundaries are know as \"pause\". More than 99% of the total atmospheric mass is concentrated in the first 40 km from the Earth's surface. Atmospheric layers are characterized by differences in chemical composition that produce variations in temperature."@en ;
    skos:prefLabel "atmospheric structure"@en .

<http://www.eionet.europa.eu/gemet/concept/6446> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The reduction in degree or intensity of pollution in soil, rivers, lakes, seas, atmosphere, etc."@en ;
    skos:prefLabel "pollution abatement"@en .

<http://www.eionet.europa.eu/gemet/concept/6447> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Equipment for the reduction in degree or intensity of pollution."@en ;
    skos:prefLabel "pollution abatement equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/6459> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "The main pollution effects concern human health and cover all aspects of the physical environment - air, water and land, including the effects of climate change. Human activities which are sources of pollution arise from domestic, commercial, industrial and military sectors and their effects are influenced by various issues, trends and public sector programmes, such as safe water and food, management of waste, increasing use of chemicals in agriculture, and urbanization. Types of pollutants which are negatively impacting health include litter, toxic chemicals, nuclear waste, lead, spoil from mining, food and water contaminants; and the polluting effects of over-population."@en ;
    skos:prefLabel "pollution effect"@en .

<http://www.eionet.europa.eu/gemet/concept/6798> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:definition "The discipline in health science that, at the level of the community or the public, aims at promoting prevention of disease, sanitary living, laws, practices and a healthier environment."@en ;
    skos:prefLabel "public health"@en .

<http://www.eionet.europa.eu/gemet/concept/6838> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The removal of unwanted constituents from a substance."@en ;
    skos:prefLabel "purification"@en .

<http://www.eionet.europa.eu/gemet/concept/6861> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7784> ;
    skos:definition "Quality of life is largely a matter of individual preference and perception and overlaps the concept of social well-being. Generally the emphasis is on the amount and distribution of jointly consumed public goods, such as health care and welfare services, protection against crime, regulation of pollution, preservation of fine landscapes and historic townscapes."@en ;
    skos:prefLabel "quality of life"@en .

<http://www.eionet.europa.eu/gemet/concept/7015> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9106> ;
    skos:definition "A resource recovery method involving the collection and treatment of a waste product for use as raw material in the manufacture of the same or a similar product."@en ;
    skos:prefLabel "recycling"@en .

<http://www.eionet.europa.eu/gemet/concept/7097> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/468> ;
    skos:definition "The release of organisms in the environment creates the risk that once released they may exhibit some previously unknown pathogenicity, might take over from some naturally occurring bacteria or pass on some unwanted trait to such indigenous bacteria."@en ;
    skos:prefLabel "release of organisms"@en .

<http://www.eionet.europa.eu/gemet/concept/7120> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/867> ;
    skos:definition "Any of various processes, either sexual or asexual, by which an animal or plant produces one or more individuals similar to itself."@en ;
    skos:prefLabel "reproduction (biological)"@en .

<http://www.eionet.europa.eu/gemet/concept/7124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "A class of terrestrial vertebrates, characterized by the lack of hair, feathers, and mammary glands; the skin is covered with scales, they have a three chambered heart and the pleural and peritoneal cavities are continuous."@en ;
    skos:prefLabel "reptile"@en .

<http://www.eionet.europa.eu/gemet/concept/7156> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Material left after any waste treatment process, including industrial, urban, agricultural, mining or other similar treatments."@en ;
    skos:prefLabel "residual waste"@en .

<http://www.eionet.europa.eu/gemet/concept/7168> a skos:Concept ;
    skos:definition "Any component of the environment that can be utilized by an organism."@en ;
    skos:prefLabel "resource"@en .

<http://www.eionet.europa.eu/gemet/concept/7172> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:prefLabel "resource exploitation"@en .

<http://www.eionet.europa.eu/gemet/concept/7340> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4115> ;
    skos:definition "Rate at which water is removed by flowing over the soil surface. This rate is determined by the texture of the soil, slope, climate, and land use cover (e.g. paved surface, grass, forest, bare soil)."@en ;
    skos:prefLabel "runoff"@en .

<http://www.eionet.europa.eu/gemet/concept/745> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2588> ;
    skos:definition "A series of cells, each containing the essentials for producing voltaic electricity, connected together."@en ;
    skos:prefLabel "battery"@en .

<http://www.eionet.europa.eu/gemet/concept/7483> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Recyclable material from any manufacturing process or discarded consumer products."@en ;
    skos:prefLabel "scrap material"@en .

<http://www.eionet.europa.eu/gemet/concept/7495> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124>,
        <http://www.eionet.europa.eu/gemet/concept/9232> ;
    skos:definition """1) In general, the marine section of the globe as opposed to that of the land. 
2) The name given to a body of salt water smaller than an ocean and generally in proximity to a continent."""@en ;
    skos:prefLabel "sea"@en .

<http://www.eionet.europa.eu/gemet/concept/7702> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050> ;
    skos:definition "A representation of a problem, situation in mathematical terms, especially using a computer."@en ;
    skos:prefLabel "simulation"@en .

<http://www.eionet.europa.eu/gemet/concept/7740> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "The processing of wastewater sludges to render them innocuous. This may be done by aerobic or anaerobic digestion followed by drying in sand beds, filtering, and incineration, filtering, and drying, or wet air oxidation."@en ;
    skos:prefLabel "sludge treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/7811> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "A continuous action, operation, or series of changes taking place in a definite manner and pertaining to the life, welfare, and relations of human beings in a community."@en ;
    skos:prefLabel "social process"@en .

<http://www.eionet.europa.eu/gemet/concept/7832> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "Any part, feature or quality of society that combines governmental dimensions with inter-personal or inter-group dynamics."@en ;
    skos:prefLabel "sociopolitical aspect"@en .

<http://www.eionet.europa.eu/gemet/concept/7890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "The study of the properties, occurrence, and management of soil as a natural resource. Generally it includes the chemistry, microbiology, physics, morphology, and mineralogy of soils, as well as their genesis and classification."@en ;
    skos:prefLabel "soil science"@en .

<http://www.eionet.europa.eu/gemet/concept/8062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "A people permanently occupying a fixed territory bound together by common law, habits and custom into one body politic exercising, through the medium of an organized government, independent sovereignty and control over all persons and things within its boundaries, unless or until authority is ceded to a federation or union of other states."@en ;
    skos:prefLabel "state"@en .

<http://www.eionet.europa.eu/gemet/concept/8075> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2803> ;
    skos:prefLabel "statistical data"@en .

<http://www.eionet.europa.eu/gemet/concept/8240> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "A critical examination of facts or conditions to provide information on a situation. Usually conducted by interviews and/or on-site visitations."@en ;
    skos:prefLabel "survey"@en .

<http://www.eionet.europa.eu/gemet/concept/8247> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15116>,
        <http://www.eionet.europa.eu/gemet/concept/2805> ;
    skos:definition "Development that provides economic, social and environmental benefits in the long term having regard to the needs of living and future generations. Defined by the World Commission on Environment and Development in 1987 as: development that meets the needs of the present without compromising the ability of future generations to meet their own needs."@en ;
    skos:prefLabel "sustainable development"@en .

<http://www.eionet.europa.eu/gemet/concept/827> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition """1) Genetic diversity: the variation between individuals and between populations within a species; species diversity: the different types of plants, animals and other life forms within a region; community or ecosystem diversity: the variety of habitats found within an area (grassland, marsh, and woodland for instance.
2) An umbrella term to describe collectively the variety and variability of nature. It encompasses three basic levels of organisation in living systems: the genetic, species, and ecosystem levels. Plant and animal species are the most commonly recognized units of biological diversity, thus public concern has been mainly devoted to conserving species diversity."""@en ;
    skos:prefLabel "biodiversity"@en .

<http://www.eionet.europa.eu/gemet/concept/8307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8308> ;
    skos:definition "An amount of money demanded by a government for its support or for specific facilities or services, most frequently levied upon income, property or sales."@en ;
    skos:prefLabel "tax"@en .

<http://www.eionet.europa.eu/gemet/concept/833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Movement of chemical elements in a circular pathway, from organisms to physical environment, back to organisms. The process is termed a nutrient cycle if the elements concerned are trace elements, which are essential to life. A biogeochemical cycle occurs when vegetation decomposes and minerals are incorporated naturally in the humus for future plant growth."@en ;
    skos:prefLabel "biogeochemical cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/8579> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1912> ;
    skos:definition "Learned, nonrandom, systematic behavior and knowledge transmitted over several generations, especially customs and beliefs originating before the advent of modern science and technology."@en ;
    skos:prefLabel "traditional culture"@en .

<http://www.eionet.europa.eu/gemet/concept/8683> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3358> ;
    skos:definition "Any of the feeding levels through which the passage of energy through an ecosystem proceeds; examples are photosynthetic plants, herbivorous animals, and microorganisms of decay."@en ;
    skos:prefLabel "trophic level"@en .

<http://www.eionet.europa.eu/gemet/concept/898> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050>,
        <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:definition "A combination of biology and technology. It is used to describe developments in the application of biological organisms for commercial and scientific purposes. So \"bio\" stands for biology and the science of life, and \"tech\" stands for technology, or the tools and techniques that the biotechnologists have in their workbox. Those tools and techniques include microorganisms and a range of methods for manipulating them, such as genetic engineering."@en ;
    skos:prefLabel "biotechnology"@en .

<http://www.eionet.europa.eu/gemet/concept/9008> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5956> ;
    skos:definition "The total amount of refuse or unusable material that enters a process or system."@en ;
    skos:prefLabel "waste income"@en .

<http://www.eionet.europa.eu/gemet/concept/9041> a skos:Concept ;
    skos:definition "Material, often unusable, left over from any manufacturing, industrial, agricultural or other human process; Material damaged or altered during a manufacturing process and subsequently left useless."@en ;
    skos:prefLabel "waste"@en .

<http://www.eionet.europa.eu/gemet/concept/9106> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5956>,
        <http://www.eionet.europa.eu/gemet/concept/9041> ;
    skos:definition "The process of obtaining materials or energy resources from waste."@en ;
    skos:prefLabel "waste recovery"@en .

<http://www.eionet.europa.eu/gemet/concept/9125> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9106> ;
    skos:definition "The incorporation of wastes into natural or artificial cycles, mainly in order to recover secondary raw materials or energy."@en ;
    skos:prefLabel "waste use"@en .

<http://www.eionet.europa.eu/gemet/concept/9358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3432> ;
    skos:prefLabel "wood product"@en .

<http://www.eionet.europa.eu/gemet/concept/9369> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:definition "All existing circumstances affecting labor in the workplace, including job hours, physical aspects, legal rights and responsibilities."@en ;
    skos:prefLabel "working condition"@en .

<http://www.eionet.europa.eu/gemet/concept/9426> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4288> ;
    skos:definition "Diseases which are biologically adapted to and normally found in animals but which under some conditions also infect man."@en ;
    skos:prefLabel "zoonosis"@en .

<http://www.eionet.europa.eu/gemet/concept/1084> a skos:Concept ;
    skos:definition "The activity, position or site associated with commerce or the earning of a livelihood."@en ;
    skos:prefLabel "business"@en .

<http://www.eionet.europa.eu/gemet/concept/10905> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7272> ;
    skos:definition "A route or track between one place to another."@en ;
    skos:prefLabel "path"@en .

<http://www.eionet.europa.eu/gemet/concept/11540> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11583> ;
    skos:definition "Any act done in violation of those duties which an individual owes to the community, and for the breach of which the law has provided that the offender shall make satisfaction to the public."@en ;
    skos:prefLabel "crime"@en .

<http://www.eionet.europa.eu/gemet/concept/11583> a skos:Concept ;
    skos:definition "The correct application of law as opposed to arbitrariness."@en ;
    skos:prefLabel "justice"@en .

<http://www.eionet.europa.eu/gemet/concept/11661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Measures taken in advance to prevent the occurrence of disasters or similar emergencies."@en ;
    skos:prefLabel "prevention measure"@en .

<http://www.eionet.europa.eu/gemet/concept/11662> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7364> ;
    skos:definition "Any precautionary action, procedure or installation conceived or undertaken to guard or defend from harm persons, property or the environment."@en ;
    skos:prefLabel "protective measure"@en .

<http://www.eionet.europa.eu/gemet/concept/1191> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "An animal that eats meat."@en ;
    skos:prefLabel "carnivore"@en .

<http://www.eionet.europa.eu/gemet/concept/12145> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition """1) The drainage basin of a stream. 
2) An area occupied by a lake and its drainage basin."""@en ;
    skos:prefLabel "hydrographic basin"@en .

<http://www.eionet.europa.eu/gemet/concept/13147> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7811> ;
    skos:definition """1) Title to or an interest in any property.
2) Any interest or privilege recognized and protected by law."""@en ;
    skos:prefLabel "rights"@en .

<http://www.eionet.europa.eu/gemet/concept/13187> a skos:Concept ;
    skos:definition "The activity of finding solutions for troublesome or perplexing situations involving ecological or natural resources."@en ;
    skos:prefLabel "environmental problem solving"@en .

<http://www.eionet.europa.eu/gemet/concept/13302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "A course of action adopted and pursued by government or some other organization that promotes or determines the allocation of assistance, support or relief, often from one country to another."@en ;
    skos:prefLabel "aid policy"@en .

<http://www.eionet.europa.eu/gemet/concept/1512> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4629> ;
    skos:definition "A line or zone where the land meets the sea or some other large expanse of water."@en ;
    skos:prefLabel "coast"@en .

<http://www.eionet.europa.eu/gemet/concept/1605> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "The concept, science, technique and process of transmitting, receiving or otherwise exchanging information and data."@en ;
    skos:prefLabel "communication"@en .

<http://www.eionet.europa.eu/gemet/concept/170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The second largest of the continents, on the Mediterranean in the north, the Atlantic in the west, and the Red Sea, Gulf of Aden, and Indian Ocean in the east. The Sahara desert divides the continent unequally into North Africa and Africa south of Sahara. The largest lake is Lake Victoria and the chief rivers are the Nile, Niger, Congo, and Zambezi. The hottest continent, Africa has vast mineral resources, many of which are still undeveloped."@en ;
    skos:prefLabel "Africa"@en .

<http://www.eionet.europa.eu/gemet/concept/1752> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "Introduction into or onto water, air, soil or other media of microorganisms, chemicals, toxic substances, wastes, wastewater or other pollutants in a concentration that makes the medium unfit for its next intended use."@en ;
    skos:prefLabel "contamination"@en .

<http://www.eionet.europa.eu/gemet/concept/1777> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2748> ;
    skos:definition "Power provided by traditional means such as coal, wood, gas, etc., as opposed to alternative energy sources such as solar power, tidal power, wind power, etc."@en ;
    skos:prefLabel "conventional energy"@en .

<http://www.eionet.europa.eu/gemet/concept/2175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2547> ;
    skos:definition "The art or science of teaching."@en ;
    skos:prefLabel "didactics"@en .

<http://www.eionet.europa.eu/gemet/concept/2215> a skos:Concept ;
    skos:definition "The result of a vast ecological breakdown in the relations between man and his environment, a serious and sudden event (or slow, as in drought) on such a scale that the stricken community needs extraordinary efforts to cope with it, often with outside help or international aid."@en ;
    skos:prefLabel "disaster"@en .

<http://www.eionet.europa.eu/gemet/concept/2284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "The process of accumulating, classifying and disseminating information, often to support the claim or data given in a book or article."@en ;
    skos:prefLabel "documentation"@en .

<http://www.eionet.europa.eu/gemet/concept/2450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15125>,
        <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "An environmental factor that, under some definite conditions, can exert appreciable influence on organisms or their communities, causing the increase or decrease in the number of organisms and/or changes in the communities."@en ;
    skos:prefLabel "ecological factor"@en .

<http://www.eionet.europa.eu/gemet/concept/2498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "A definite course of action adopted and pursued by a government, political party or enterprise pertaining to the production, distribution and use of income, wealth and commodities."@en ;
    skos:prefLabel "economic policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2533> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:prefLabel "EC policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2566> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Resultant of natural or manmade perturbations of the physical, chemical or biological components making up the environment."@en ;
    skos:prefLabel "effect on the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/2748> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:definition "According to the source, energy can be classified as hydroenergy, solar energy, tidal energy, wind energy, waves energy, geothermal energy, etc.. According to the type of fuel used for its production, energy can be classified as nuclear energy, coal derived energy, petroleum derived energy, biomass derived energy, etc."@en ;
    skos:prefLabel "energy type"@en .

<http://www.eionet.europa.eu/gemet/concept/2775> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15318>,
        <http://www.eionet.europa.eu/gemet/concept/2799> ;
    skos:definition "Principle or standard for the evaluation or appraisal of ecological or natural resources."@en ;
    skos:prefLabel "environmental assessment criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/2778> a skos:Concept ;
    skos:definition "The growth and development of awareness, understanding and consciousness toward the biophysical environment and its problems, including human interactions and effects. Thinking \"ecologically\" or in terms of an ecological consciousness."@en ;
    skos:prefLabel "environmental awareness"@en .

<http://www.eionet.europa.eu/gemet/concept/2795> a skos:Concept ;
    skos:definition "Protection of the environment through policies concerning the control of wastes, the improvement of the human-made environment, the protection of heritage values, the institution of national parks and reserves, the protection of fauna and flora, the conservation of forests and landscapes, etc."@en ;
    skos:prefLabel "environmental control"@en .

<http://www.eionet.europa.eu/gemet/concept/2895> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The introduction by man into the environment of substances or energy liable to cause hazards to human health, harm to living resources and ecological systems, damage to structure or amenity, or interference with legitimate uses of the environment."@en ;
    skos:prefLabel "environmental pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/3205> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "Procurement of monetary resources or credit to operate a business or acquire assets."@en ;
    skos:prefLabel "financing"@en .

<http://www.eionet.europa.eu/gemet/concept/3462> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "The energy-containing materials which were converted over many thousands of years from their original form of trees, plants and other organisms after being buried in the ground. Physical and chemical processes occurred in the Earth's crust that changed them into coal, peat, oil or natural gas."@en ;
    skos:prefLabel "fossil fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/3481> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8641> ;
    skos:definition "Transportation of goods by ship, aircraft or other vehicles."@en ;
    skos:prefLabel "freight transport"@en .

<http://www.eionet.europa.eu/gemet/concept/3485> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8229> ;
    skos:definition "Water having a relatively low mineral content, generally less than 500 mg/l of dissolved solids."@en ;
    skos:prefLabel "freshwater"@en .

<http://www.eionet.europa.eu/gemet/concept/3624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/898> ;
    skos:definition """1) The complex of techniques for the production of new genes and the alteration of the structure of the chromosomes to produce effects beneficial to man, in agriculture and medicine.
2) The intentional production of new genes and alteration of genomes by the substitution or addition of new genetic material."""@en ;
    skos:prefLabel "genetic engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/3788> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "An observable pattern of activity displayed by persons in and as an aggregate."@en ;
    skos:prefLabel "group behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/3877> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3866> ;
    skos:prefLabel "health protection"@en .

<http://www.eionet.europa.eu/gemet/concept/4082> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9165> ;
    skos:definition "Any structure built to route the flow of water, or to support the weight and pressure of a body of water."@en ;
    skos:prefLabel "hydraulic construction"@en .

<http://www.eionet.europa.eu/gemet/concept/4491> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6884> ;
    skos:definition "Radiation that is capable of energizing atoms sufficiently to remove electrons from them. In this state atoms become more reactive, so that ionizing radiation increases chemical activity and in this way produces biological effects, including effects that involve alterations induced in DNA. X-rays and gamma-rays are the only electromagnetic waves that cause ionization in biological material."@en ;
    skos:prefLabel "ionising radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/4635> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6225> ;
    skos:definition "The activity of designing, organizing or preparing for the future use of solid areas of the earth's surface, especially regions valued for natural resources, utilized as agricultural resources or considered for human settlement."@en ;
    skos:prefLabel "land planning"@en .

<http://www.eionet.europa.eu/gemet/concept/5003> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3788> ;
    skos:prefLabel "man-nature relationship"@en .

<http://www.eionet.europa.eu/gemet/concept/501> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/429> ;
    skos:definition """1) The cultivation and harvest of freshwater or marine animals and plants, in ponds, tanks, cages or on protected beds. This is usually done in inland waters, estuaries or coastal waters. It is estimated that commercial fish farming accounts for more than 10% of the world's fish needs. Fish farming usually concentrates on molluscs, including oysters, mussels and clams, because they are usually immobile and fetch high prices. Shrimps and salmon are also farmed, but the stock have to be caught in the wild first, so that they can be brought up to commercial standards in pens. Aquaculture in not new. In Asia freshwater fish have been farmed for some 4.000 years, usually on small farms. 
2) The use of artificial means to increase the production of aquatic organisms in fresh or salt water."""@en ;
    skos:prefLabel "aquaculture"@en .

<http://www.eionet.europa.eu/gemet/concept/5035> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3237> ;
    skos:definition "The harvest of animals and plants from the ocean to provide food and recreation for people, food for animals, and a variety of organic materials for industry."@en ;
    skos:prefLabel "marine fishery"@en .

<http://www.eionet.europa.eu/gemet/concept/505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2525> ;
    skos:definition "Any watery environment, from small to large, from pond to ocean, in which plants and animals interact with the chemical and physical features of the environment."@en ;
    skos:prefLabel "aquatic ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/5058> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "Place of commercial activity in which articles are bought and sold. Also purchase and sale. In a limited sense market is the range of bid and asked prices reported by brokers making the market in over-the-counter securities. Also the demand for any particular article."@en ;
    skos:prefLabel "market"@en .

<http://www.eionet.europa.eu/gemet/concept/5286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:definition "A district where mineral exploitation is performed."@en ;
    skos:prefLabel "mining district"@en .

<http://www.eionet.europa.eu/gemet/concept/5390> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "A road vehicle driven by a motor or engine, especially an internal-combustion engine."@en ;
    skos:prefLabel "motor vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/5405> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Area characterized by conspicuous peaks, ridges, or mountain ranges."@en ;
    skos:prefLabel "mountainous area"@en .

<http://www.eionet.europa.eu/gemet/concept/5498> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2944> ;
    skos:definition "The complex of atmospheric, geological and biological characteristics found in an area in the absence of artifacts or influences of a well developed technological, human culture."@en ;
    skos:prefLabel "natural environment"@en .

<http://www.eionet.europa.eu/gemet/concept/5624> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/60> ;
    skos:definition "Sound which is unwanted, either because of its effects on humans, its effect on fatigue or malfunction of physical equipment, or its interference with the perception or detection of other sounds."@en ;
    skos:prefLabel "noise"@en .

<http://www.eionet.europa.eu/gemet/concept/5880> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7793> ;
    skos:definition "Judgement or belief not founded on certainty or proof."@en ;
    skos:prefLabel "opinion"@en .

<http://www.eionet.europa.eu/gemet/concept/5928> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Organic compounds having a C-N bond."@en ;
    skos:prefLabel "organonitrogen compound"@en .

<http://www.eionet.europa.eu/gemet/concept/5929> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5912> ;
    skos:definition "Compounds, both aliphatic and aromatic, which have a C-O bond, including alcohols, aldehydes, etc."@en ;
    skos:prefLabel "organooxygen compound"@en .

<http://www.eionet.europa.eu/gemet/concept/598> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9380> ;
    skos:definition "The world's largest continent. It occupies the eastern part of the Eurasian landmass and its adjacent islands and is separated from Europe by the Ural Mountains. Asia borders on the Arctic Ocean, the Pacific Ocean, the Indian Ocean, and the Mediterranean and Red Seas in the west. It includes the largest peninsulas of Asia Minor, India, Arabia, and Indochina and the island groups of Japan, Indonesia, the Philippines, and Ceylon; contains the mountain ranges of the Hindu Kush, Himalayas, Pamirs, Tian Shan, Urals, and Caucasus, the great plateaus of India, Iran and Tibet, vast plains and deserts, and the valleys of many large rivers including the Mekong, Irrawaddy, Indus, Ganges, Tigris and Euphrates."@en ;
    skos:prefLabel "Asia"@en .

<http://www.eionet.europa.eu/gemet/concept/6371> a skos:Concept ;
    skos:definition "The theory and practice of acquiring and exercising the power to govern in a society in order to arbitrate values, allocate resources and establish and enforce rules."@en ;
    skos:prefLabel "politics"@en .

<http://www.eionet.europa.eu/gemet/concept/6428> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6402> ;
    skos:definition "The retraceable route of a pollutant, from its source, through its interactions with the environment, and finally to its effect upon a target ecosystem or target organisms."@en ;
    skos:prefLabel "pollutant pathway"@en .

<http://www.eionet.europa.eu/gemet/concept/6474> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The place, places or areas from where a pollutant is released into the atmosphere or water, or where noise is generated. A source can be classified as point source, i.e. a large individual generator of pollution, an area source, or a line source, e.g. vehicle emissions and noise."@en ;
    skos:prefLabel "source of pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/6650> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "The act of converting material from one form into another desired form."@en ;
    skos:prefLabel "processing"@en .

<http://www.eionet.europa.eu/gemet/concept/6705> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:prefLabel "programme"@en .

<http://www.eionet.europa.eu/gemet/concept/6967> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5086> ;
    skos:definition "A crude, unprocessed or partially processed material used as feedstock for a processing operation."@en ;
    skos:prefLabel "raw material"@en .

<http://www.eionet.europa.eu/gemet/concept/7170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2790> ;
    skos:definition "Reduction of overall resource consumption and utilization of recovered resources in order to avoid waste."@en ;
    skos:prefLabel "resource conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/7298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4855> ;
    skos:definition "Any aggregate of minerals that makes up part of the earth's crust. It may be unconsolidated, such as sand, clay, or mud, or consolidated, such as granite, limestone, or coal."@en ;
    skos:prefLabel "rock"@en .

<http://www.eionet.europa.eu/gemet/concept/7411> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:prefLabel "sanction"@en .

<http://www.eionet.europa.eu/gemet/concept/7654> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8926> ;
    skos:definition "A vessel propelled by engines or sails for navigating on the water, especially a large vessel that can not be carried aboard another, as distinguished from a boat."@en ;
    skos:prefLabel "ship"@en .

<http://www.eionet.europa.eu/gemet/concept/7793> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The pattern, change, development and driving forces of a human group, community or society."@en ;
    skos:prefLabel "social dynamics"@en .

<http://www.eionet.europa.eu/gemet/concept/8072> a skos:Concept ;
    skos:definition "One of the three fundamental conditions of matter: the solid, the liquid, and gaseous states."@en ;
    skos:prefLabel "state of matter"@en .

<http://www.eionet.europa.eu/gemet/concept/8076> a skos:Concept ;
    skos:definition "A branch of mathematics dealing with the collection, analysis, interpretation, and presentation of masses of numerical data."@en ;
    skos:prefLabel "statistics"@en .

<http://www.eionet.europa.eu/gemet/concept/812> a skos:Concept ;
    skos:definition "Chemical processes occurring in living organisms."@en ;
    skos:prefLabel "biochemical process"@en .

<http://www.eionet.europa.eu/gemet/concept/8308> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The act or result of a government requiring money for its support or for specific facilities or services."@en ;
    skos:prefLabel "taxation"@en .

<http://www.eionet.europa.eu/gemet/concept/873> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5521> ;
    skos:definition "Wild organisms harvested for subsistence, commerce, or recreation (such as fish, game, timber or furbearers); domesticated organisms raised by agriculture, aquaculture, and silviculture; and ecosystems cropped by livestock."@en ;
    skos:prefLabel "biological resource"@en .

<http://www.eionet.europa.eu/gemet/concept/8769> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4982> ;
    skos:definition "Hoofed mammals, including the Artiodactyla and Perissodactyla."@en ;
    skos:prefLabel "ungulate"@en .

<http://www.eionet.europa.eu/gemet/concept/9077> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Any unusable aeriform fluid, or suspension of fine particles in air, given off by a manufacturing process or the burning of a substance in a enclosed area."@en ;
    skos:prefLabel "waste gas"@en .

<http://www.eionet.europa.eu/gemet/concept/9232> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124> ;
    skos:definition "The liquid that forms streams, lakes, and seas, and issues from the ground in springs."@en ;
    skos:prefLabel "water (geographic)"@en .

<http://www.eionet.europa.eu/gemet/concept/9349> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3406> ;
    skos:definition "A dense growth of trees more extensive than a grove and smaller than a forest."@en ;
    skos:prefLabel "wood"@en .

<http://www.eionet.europa.eu/gemet/concept/10201> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6740> ;
    skos:definition "Any area of land or water that has been set aside for a special purpose, often to prevent or reduce harm to its wildlife and ecosystems."@en ;
    skos:prefLabel "reserve"@en .

<http://www.eionet.europa.eu/gemet/concept/10930> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10931> ;
    skos:definition "A term of variable content and meaning. It may include every species of personal chattels or property. Items of merchandise, supplies, raw materials, or finished goods. Land is excluded."@en ;
    skos:prefLabel "goods"@en .

<http://www.eionet.europa.eu/gemet/concept/10940> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The relationship between the amount or quantity of a commodity that is available for purchase and the desire or ability of consumers to buy or purchase the commodity, which, in theory, determines the commodity's price in a free market."@en ;
    skos:prefLabel "supply and demand"@en .

<http://www.eionet.europa.eu/gemet/concept/1320> a skos:Concept ;
    skos:definition "The particular method of manufacturing or making a chemical usually involving a number of steps or operations."@en ;
    skos:prefLabel "chemical process"@en .

<http://www.eionet.europa.eu/gemet/concept/1469> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "Weather conditions typical of areas roughly corresponding to lines of latitude."@en ;
    skos:prefLabel "climate type"@en .

<http://www.eionet.europa.eu/gemet/concept/14862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "A global consortium of local computer networks that uses the TCP/IP (Transmission Control Protocol/Internet Protocol) protocol to connect machines to each other, providing access to the World Wide Web, Gopher, electronic mail, remote login and file transfer."@en ;
    skos:prefLabel "Internet"@en .

<http://www.eionet.europa.eu/gemet/concept/14884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6817> ;
    skos:definition "The duties of an establishment, or a public institution, charged with the care and organizing of a collection of printed and other materials, and the duty of interpreting such materials to meet the informational, cultural, educational, recreational or research needs of its clients."@en ;
    skos:prefLabel "library service"@en .

<http://www.eionet.europa.eu/gemet/concept/15266> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2748> ;
    skos:definition "energy contained in fossil fuels, and renewable energy sources, not subject to any conversion or transformation process"@en ;
    skos:prefLabel "primary energy"@en .

<http://www.eionet.europa.eu/gemet/concept/15271> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2748> ;
    skos:definition "Energy derived from natural processes (e.g. sunlight and wind) that are replenished at a faster rate than they are consumed. Solar, wind, geothermal, hydro, and some forms of biomass are common sources of renewable energy."@en ;
    skos:prefLabel "renewable energy"@en .

<http://www.eionet.europa.eu/gemet/concept/1890> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "A large group of plants, comprising the Thallophyta, Bryophyta and Pteridophyta, the last of which are cryptogams."@en ;
    skos:prefLabel "cryptogam"@en .

<http://www.eionet.europa.eu/gemet/concept/25> a skos:Concept ;
    skos:definition "An unexpected occurrence, failure or loss with the potential for harming human life, property or the environment."@en ;
    skos:prefLabel "accident"@en .

<http://www.eionet.europa.eu/gemet/concept/3050> a skos:Concept ;
    skos:definition "A test under controlled conditions that is made to demonstrate a known truth, examine the validity of a hypothesis, or determine the efficacy of something previously untried."@en ;
    skos:prefLabel "experiment"@en .

<http://www.eionet.europa.eu/gemet/concept/3087> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8879> ;
    skos:definition "Any process by which a pure metal is obtained from its ore."@en ;
    skos:prefLabel "extraction"@en .

<http://www.eionet.europa.eu/gemet/concept/3298> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4116> ;
    skos:definition "An unusual accumulation of water above the ground caused by high tide, heavy rain, melting snow or rapid runoff from paved areas."@en ;
    skos:prefLabel "flood"@en .

<http://www.eionet.europa.eu/gemet/concept/3368> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4279> ;
    skos:definition "The commercial production and packaging of foods that are fabricated by processing, by combining various ingredients, or both."@en ;
    skos:prefLabel "food industry"@en .

<http://www.eionet.europa.eu/gemet/concept/3650> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2405> ;
    skos:definition "The study or science of the earth, its history, and its life as recorded in the rocks; includes the study of geologic features of an area, such as the geometry of rock formations, weathering and erosion, and sedimentation."@en ;
    skos:prefLabel "geology"@en .

<http://www.eionet.europa.eu/gemet/concept/3852> a skos:Concept ;
    skos:definition "A physical or chemical agent capable of causing harm to persons, property, animals, plants or other natural resources."@en ;
    skos:prefLabel "hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/3872> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3869> ;
    skos:prefLabel "health hazard"@en .

<http://www.eionet.europa.eu/gemet/concept/4196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/861> ;
    skos:definition "Something that provides an indication especially of trends."@en ;
    skos:prefLabel "indicator"@en .

<http://www.eionet.europa.eu/gemet/concept/4242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "A device, system or piece of equipment installed for a particular industry."@en ;
    skos:prefLabel "industrial installation"@en .

<http://www.eionet.europa.eu/gemet/concept/4434> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13292> ;
    skos:definition "An association of independent states, whose representatives gather for the promotion of common interests including defense and trade."@en ;
    skos:prefLabel "international organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/4648> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "The traits, patterns, and structure of a specific geographic area, including its biological composition, its physical environment, and its anthropogenic or social patterns. An area where interacting ecosystems are grouped and repeated in similar form."@en ;
    skos:prefLabel "landscape"@en .

<http://www.eionet.europa.eu/gemet/concept/4787> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1437> ;
    skos:definition "Subjection to a legal obligation. Liability is civil or criminal according to whether it is enforced by the civil or criminal courts."@en ;
    skos:prefLabel "liability"@en .

<http://www.eionet.europa.eu/gemet/concept/511> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Organisms which live in water."@en ;
    skos:prefLabel "aquatic organism"@en .

<http://www.eionet.europa.eu/gemet/concept/5119> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "The ability of the analytical method or protocol to quantify as well as identify the presence of the substance in question."@en ;
    skos:prefLabel "measuring"@en .

<http://www.eionet.europa.eu/gemet/concept/5144> a skos:Concept ;
    skos:definition "The science and art of treating and healing."@en ;
    skos:prefLabel "medicine (practice)"@en .

<http://www.eionet.europa.eu/gemet/concept/5524> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The branches of science dealing with objectively measurable phenomena pertaining to the transformation and relationships of energy and matter; includes biology, physics, and chemistry."@en ;
    skos:prefLabel "natural science"@en .

<http://www.eionet.europa.eu/gemet/concept/5667> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4666> ;
    skos:definition "Areas which are not intensely developed for housing, commerce, industry, etc."@en ;
    skos:prefLabel "non-built-up area"@en .

<http://www.eionet.europa.eu/gemet/concept/5668> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2748> ;
    skos:definition "Energy that is renewable and ecologically safe, such as tidal power, wind power, etc."@en ;
    skos:prefLabel "non-conventional energy"@en .

<http://www.eionet.europa.eu/gemet/concept/6300> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5890> ;
    skos:definition "The constituent parts of a plant."@en ;
    skos:prefLabel "plant component"@en .

<http://www.eionet.europa.eu/gemet/concept/6402> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:prefLabel "pollutant behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/6527> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4056> ;
    skos:definition "The organization of, and inter-relationships among, inhabitants of a given region, country or city."@en ;
    skos:prefLabel "population structure"@en .

<http://www.eionet.europa.eu/gemet/concept/6801> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Factual or circumstantial knowledge or the service, office or station providing this knowledge for an entire population or community, without restriction."@en ;
    skos:prefLabel "public information"@en .

<http://www.eionet.europa.eu/gemet/concept/6841> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Equipment for the removal of impurities and unwanted constituents from a medium."@en ;
    skos:prefLabel "purification facility"@en .

<http://www.eionet.europa.eu/gemet/concept/7345> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:definition "Area outside the limits of any incorporated or unincorporated city, town, village, or any other designated residential or commercial area such as a subdivision, a business or shopping center, or community development."@en ;
    skos:prefLabel "rural area"@en .

<http://www.eionet.europa.eu/gemet/concept/7565> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4855> ;
    skos:definition "Any material transported by water which will ultimately settle to the bottom after the water loses its transporting power."@en ;
    skos:prefLabel "sediment"@en .

<http://www.eionet.europa.eu/gemet/concept/7632> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "A semi-liquid waste with a solid concentration in excess of 2500 parts per million, obtained from the purification of municipal sewage."@en ;
    skos:prefLabel "sewage sludge"@en .

<http://www.eionet.europa.eu/gemet/concept/767> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/765> ;
    skos:definition "A relatively uniform series of overt activities that can be observed with some regularity."@en ;
    skos:prefLabel "behaviour pattern"@en .

<http://www.eionet.europa.eu/gemet/concept/816> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11813> ;
    skos:definition "A diverse group of poisonous substance including preservatives, insecticides, disinfectants and pesticides used for the control of organisms that are harmful to human or animal health or that cause damage to natural or manufactured products."@en ;
    skos:prefLabel "biocide"@en .

<http://www.eionet.europa.eu/gemet/concept/8664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6323> ;
    skos:definition "Any large woody perennial plant with a distinct trunk giving rise to branches or leaves at some distance from the ground."@en ;
    skos:prefLabel "tree"@en .

<http://www.eionet.europa.eu/gemet/concept/892> a skos:Concept ;
    skos:definition "That part of the Earth and atmosphere capable of supporting living organisms."@en ;
    skos:prefLabel "biosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/9165> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "The system of pipes supplying water to communities and industries."@en ;
    skos:prefLabel "water distribution system"@en .

<http://www.eionet.europa.eu/gemet/concept/95> a skos:Concept ;
    skos:definition "The management or direction of the affairs of a public or private office, business or organization."@en ;
    skos:prefLabel "administration"@en .

<http://www.eionet.europa.eu/gemet/concept/961> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10002> ;
    skos:definition "The art or science of recording business accounts and transactions."@en ;
    skos:prefLabel "bookkeeping"@en .

<http://www.eionet.europa.eu/gemet/concept/963> a skos:Concept ;
    skos:definition "The dividing line or frontier between political or geographic regions."@en ;
    skos:prefLabel "border"@en .

<http://www.eionet.europa.eu/gemet/concept/10019> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "Group of sciences including sociology, anthropology, psychology, pedagogy, etc. as opposed to the humanistic group."@en ;
    skos:prefLabel "human science"@en .

<http://www.eionet.europa.eu/gemet/concept/10032> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Active management of nature areas in order to ensure that wildlife is protected and the quality of its environment is maintained."@en ;
    skos:prefLabel "natural areas protection"@en .

<http://www.eionet.europa.eu/gemet/concept/1221> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Those of the planet's flora and fauna which are threatened with extinction. Hunting and poaching to fuel the trade in ivory, horn, skins, fur and feathers have long been a threat to already endangered species. Pollution, agricultural expansion, loss of wetlands, deforestation and other erosion of habitats have been added to the hazards. Human activity was responsible for most of the animals and plants known to have been lost in the past two centuries."@en ;
    skos:prefLabel "category of endangered species"@en .

<http://www.eionet.europa.eu/gemet/concept/13088> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:definition "A way of proceeding or doing something, especially a systematic or regular one."@en ;
    skos:prefLabel "method"@en .

<http://www.eionet.europa.eu/gemet/concept/13236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2566> ;
    skos:definition "The process by which the environment is progressively contaminated, overexploited and destroyed."@en ;
    skos:prefLabel "degradation of the environment"@en .

<http://www.eionet.europa.eu/gemet/concept/13284> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11583> ;
    skos:definition "Term includes all proceedings authorised or sanctioned by law, and brought or instituted in a court of legal tribunal, for the acquiring of a right or the enforcement of a remedy."@en ;
    skos:prefLabel "legal procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/14976> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "A series of actions undertaken to deposit or hold goods, materials or waste in some physical location, as in a facility, container, tank or dumping site."@en ;
    skos:prefLabel "storage (process)"@en .

<http://www.eionet.europa.eu/gemet/concept/1899> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:definition "The practice of growing and nurturing plants outside of their wild habitat (i.e., in gardens, nurseries, arboreta)."@en ;
    skos:prefLabel "cultivation"@en .

<http://www.eionet.europa.eu/gemet/concept/2212> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "The second rank of administrative acts (inferior to regulations, superior to decisions) made by the council or commission of the European Communities on order to carry out their tasks in accordance with the Treaties. They must be addressed to states, not individuals, but many create rights for individuals or allow the directive to be pleaded before municipal court."@en ;
    skos:prefLabel "directive"@en .

<http://www.eionet.europa.eu/gemet/concept/232> a skos:Concept ;
    skos:definition "The production of plants and animals useful to man, involving soil cultivation and the breeding and management of crops and livestock."@en ;
    skos:prefLabel "agriculture"@en .

<http://www.eionet.europa.eu/gemet/concept/2367> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9062> ;
    skos:definition "The discarding of waste in any manner, often without regard to environmental control."@en ;
    skos:prefLabel "dumping"@en .

<http://www.eionet.europa.eu/gemet/concept/2405> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "The science that deals with the earth or any part thereof; includes the disciplines of geology, geography, oceanography and meteorology, among others."@en ;
    skos:prefLabel "earth science"@en .

<http://www.eionet.europa.eu/gemet/concept/2683> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4577> ;
    skos:definition "The work or occupation in which a person is employed."@en ;
    skos:prefLabel "employment"@en .

<http://www.eionet.europa.eu/gemet/concept/2712> a skos:Concept ;
    skos:definition "The capacity to do work; involving thermal energy (heat), radiant energy (light), kinetic energy (motion) or chemical energy; measured in joules."@en ;
    skos:prefLabel "energy"@en .

<http://www.eionet.europa.eu/gemet/concept/2782> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Changes that may take place in ecosystems, climate, soil, habitats, etc. due to pressures of various origin."@en ;
    skos:prefLabel "environmental change"@en .

<http://www.eionet.europa.eu/gemet/concept/2799> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2774> ;
    skos:definition "Standards of physical, chemical or biological (but sometimes including social, aesthetic, etc.) components that define a given quality of an environment."@en ;
    skos:prefLabel "environmental criterion"@en .

<http://www.eionet.europa.eu/gemet/concept/2802> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2562> ;
    skos:definition "Harm done to the environment, e.g. loss of wetlands, pollution of rivers, etc."@en ;
    skos:prefLabel "environmental damage"@en .

<http://www.eionet.europa.eu/gemet/concept/2900> a skos:Concept ;
    skos:definition "Measures and controls to prevent damage and degradation of the environment, including the sustainability of its living resources."@en ;
    skos:prefLabel "environmental protection"@en .

<http://www.eionet.europa.eu/gemet/concept/2944> a skos:Concept ;
    skos:definition "A concept which includes all aspects of the surroundings of humanity, affecting individuals and social groupings. The European Union has defined the environment as \"the combination of elements whose complex interrelationships make up the settings, the surroundings and the conditions of life of the individual and of society, as they are or as they are felt\". The environment thus includes the built environment, the natural environment and all natural resources, including air, land and water. It also includes the surroundings of the workplace."@en ;
    skos:prefLabel "environment"@en .

<http://www.eionet.europa.eu/gemet/concept/3169> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "Substance added to soil for the purpose of promoting plant life, usually containing nitrogen, potassium and phosphorus, e.g. manure, guano, rock phosphates."@en ;
    skos:prefLabel "fertiliser"@en .

<http://www.eionet.europa.eu/gemet/concept/3400> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3011> ;
    skos:definition "An estimate or prediction of a future condition."@en ;
    skos:prefLabel "forecast"@en .

<http://www.eionet.europa.eu/gemet/concept/3865> a skos:Concept ;
    skos:definition "A state of dynamic equilibrium between an organism and its environment in which all functions of mind and body are normal."@en ;
    skos:prefLabel "health"@en .

<http://www.eionet.europa.eu/gemet/concept/4056> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2060> ;
    skos:definition "Group of individuals having common characteristics."@en ;
    skos:prefLabel "human population"@en .

<http://www.eionet.europa.eu/gemet/concept/4062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1065> ;
    skos:definition "Cities, towns, villages, and other concentrations of human populations which inhabit a given segment or area of the environment. Human settlements are associated with numerous and complex environmental, pollution, and living condition problems for planning and management."@en ;
    skos:prefLabel "human settlement"@en .

<http://www.eionet.europa.eu/gemet/concept/4124> a skos:Concept ;
    skos:definition "The waters of the Earth, as distinguished from the rocks (lithosphere), living things (biosphere), and the air (atmosphere). Includes the waters of the ocean; rivers, lakes, and other bodies of surface water in liquid form on the continents; snow, ice, and glaciers; and liquid water, ice, and water vapour in both the unsaturated and saturated zones below the land surface. Included by some, but excluded by others, is water in the atmosphere , which includes water vapour, clouds, and all forms of precipitation while still in the atmosphere."@en ;
    skos:prefLabel "hydrosphere"@en .

<http://www.eionet.europa.eu/gemet/concept/4163> a skos:Concept ;
    skos:definition "Elements of an action which cause damage to the surrounding environment."@en ;
    skos:prefLabel "impact source"@en .

<http://www.eionet.europa.eu/gemet/concept/4267> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1029> ;
    skos:definition "The location for the individual manufacturing firm."@en ;
    skos:prefLabel "industrial site"@en .

<http://www.eionet.europa.eu/gemet/concept/4302> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303>,
        <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "Science and technique of data elaboration and of automatic treatment of information."@en ;
    skos:prefLabel "informatics"@en .

<http://www.eionet.europa.eu/gemet/concept/4475> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/450> ;
    skos:definition "Any animal lacking a backbone, including all species not classified as vertebrates."@en ;
    skos:prefLabel "invertebrate"@en .

<http://www.eionet.europa.eu/gemet/concept/4577> a skos:Concept ;
    skos:definition "One of the factors of production. It includes all the exertions - manual, physical or mental - by individuals, directed towards the production of wealth."@en ;
    skos:prefLabel "labour"@en .

<http://www.eionet.europa.eu/gemet/concept/496> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "Science whose results are employed in technical applications."@en ;
    skos:prefLabel "applied science"@en .

<http://www.eionet.europa.eu/gemet/concept/5161> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10003> ;
    skos:definition "All the chemical reactions that take place in a living organism, comprising both anabolism and catabolism. Basal metabolism is the energy exchange of an animal at rest. Catabolism is the synthesis of complex molecules from simpler ones. Catabolism is the breaking down by organisms of complex molecules into simpler ones with the liberation of energy."@en ;
    skos:prefLabel "metabolism"@en .

<http://www.eionet.europa.eu/gemet/concept/5388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3505> ;
    skos:definition "Any gaseous or liquid flammable fuel that burns in an internal combustion engine."@en ;
    skos:prefLabel "motor fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/5521> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7168> ;
    skos:definition "A feature or component of the natural environment that is of value in serving human needs, e.g. soil, water, plantlife, wildlife, etc. Some natural resources have an economic value (e.g. timber) while others have a \"noneconomic\" value (e.g. scenic beauty)."@en ;
    skos:prefLabel "natural resource"@en .

<http://www.eionet.europa.eu/gemet/concept/625> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2663> ;
    skos:definition "Suspended pollutants -- solid particles, liquid aerosols, etc. -- or toxic gases released into the atmosphere from a polluting source, or type of source."@en ;
    skos:prefLabel "atmospheric emission"@en .

<http://www.eionet.europa.eu/gemet/concept/6287> a skos:Concept ;
    skos:definition "The act of making a detailed scheme for attaining an objective."@en ;
    skos:prefLabel "planning"@en .

<http://www.eionet.europa.eu/gemet/concept/6465> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/10048> ;
    skos:definition "The amount of stress placed upon an ecosystem by pollution, physical or chemical, released into it by man-made or natural means."@en ;
    skos:prefLabel "pollution load"@en .

<http://www.eionet.europa.eu/gemet/concept/6602> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "The amount of money paid per unit for a good or service."@en ;
    skos:prefLabel "price"@en .

<http://www.eionet.europa.eu/gemet/concept/661> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/100> ;
    skos:definition "An organized assemblage of authorized persons or officials empowered to implement and enforce laws, oversee jurisdictions, settle disputes, adjudicate or make some other legal determination."@en ;
    skos:prefLabel "authority body"@en .

<http://www.eionet.europa.eu/gemet/concept/6660> a skos:Concept ;
    skos:definition "Something produced by human or mechanical effort or by a natural process."@en ;
    skos:prefLabel "product"@en .

<http://www.eionet.europa.eu/gemet/concept/7175> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "A conscious process of decision-making whereby natural and cultural resources are allocated over time and space to optimize the attainment of stated objectives of a society, within the framework of its technology, political and social institutions, and legal and administrative arrangements. An important objective is the conservation of resources, implying a close and integrated relationship between the ecological basis and the socio-economic system."@en ;
    skos:prefLabel "resources management"@en .

<http://www.eionet.europa.eu/gemet/concept/7272> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11277> ;
    skos:definition "A long piece of hard ground that people can drive along from one place to another."@en ;
    skos:prefLabel "road"@en .

<http://www.eionet.europa.eu/gemet/concept/7622> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "The distribution or total amount of communities, villages and houses within a specified geographic area."@en ;
    skos:prefLabel "settlement concentration"@en .

<http://www.eionet.europa.eu/gemet/concept/7784> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7781> ;
    skos:definition "An existing circumstance, situation or state affecting the life, welfare and relations of human beings in community."@en ;
    skos:prefLabel "social condition"@en .

<http://www.eionet.europa.eu/gemet/concept/7982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "A taxonomic category ranking immediately below a genus and including closely related, morphologically similar individuals which actually or potentially inbreed."@en ;
    skos:prefLabel "species"@en .

<http://www.eionet.europa.eu/gemet/concept/8538> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3872> ;
    skos:definition "The degree of danger posed by a substance to animal or plant life."@en ;
    skos:prefLabel "toxicity"@en .

<http://www.eionet.europa.eu/gemet/concept/8804> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "Any physical extension of, or changes to, the uses of land in metropolitan areas, often involving subdivision into zones; construction or modification of buildings, roads, utilities and other facilities; removal of trees and other obstructions; and population growth and related economic, social and political changes."@en ;
    skos:prefLabel "urban development"@en .

<http://www.eionet.europa.eu/gemet/concept/8946> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1798> ;
    skos:definition "Any chordate animal of the subphylum Vertebrata, characterized by a bony or cartilaginous skeleton and a well-developed brain: the group contains fishes, amphibians, reptiles, birds, and mammals."@en ;
    skos:prefLabel "vertebrate"@en .

<http://www.eionet.europa.eu/gemet/concept/912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "Any of the warm-blooded vertebrates which make up the class Aves."@en ;
    skos:prefLabel "bird"@en .

<http://www.eionet.europa.eu/gemet/concept/9246> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Purification of water to make it suitable for drinking or for any other use."@en ;
    skos:prefLabel "water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/103> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:definition "The skill, knowledge, qualification, capacity or authority to manage or direct the affairs of a public or private office, business or organization."@en ;
    skos:prefLabel "administrative competence"@en .

<http://www.eionet.europa.eu/gemet/concept/13225> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Equipment related to the production of heat."@en ;
    skos:prefLabel "thermal equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/1673> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1322> ;
    skos:definition "In solutions, the mass, volume, or number of moles of solute present in proportion to the amount of solvent or total solution."@en ;
    skos:prefLabel "concentration (value)"@en .

<http://www.eionet.europa.eu/gemet/concept/1912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1921> ;
    skos:definition "The inherited body of beliefs, customs, artistic activity and knowledge that has been transmitted by ancestors."@en ;
    skos:prefLabel "cultural heritage"@en .

<http://www.eionet.europa.eu/gemet/concept/219> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:prefLabel "agricultural production"@en .

<http://www.eionet.europa.eu/gemet/concept/2232> a skos:Concept ;
    skos:definition "A definite pathological process having a characteristic set of signs and symptoms which are detrimental to the well-being of the individual."@en ;
    skos:prefLabel "disease"@en .

<http://www.eionet.europa.eu/gemet/concept/2889> a skos:Concept ;
    skos:definition "The identification of desirable objectives for the physical environment, including social and economic objectives, and the creation of administrative procedures and programmes to meet those objectives."@en ;
    skos:prefLabel "environmental planning"@en .

<http://www.eionet.europa.eu/gemet/concept/3011> a skos:Concept ;
    skos:prefLabel "evaluation"@en .

<http://www.eionet.europa.eu/gemet/concept/3439> a skos:Concept ;
    skos:definition "The management of forest lands for wood, forages, water, wildlife, and recreation."@en ;
    skos:prefLabel "forestry"@en .

<http://www.eionet.europa.eu/gemet/concept/3866> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3865> ;
    skos:prefLabel "health care"@en .

<http://www.eionet.europa.eu/gemet/concept/4311> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4303> ;
    skos:definition "Any coordinated assemblage of persons, devices and institutions used for communicating or exchanging knowledge or data, such as by simple verbal communication, or by completely computerized methods of storing, searching and retrieving information."@en ;
    skos:prefLabel "information system"@en .

<http://www.eionet.europa.eu/gemet/concept/4749> a skos:Concept ;
    skos:definition "The act or process of making laws."@en ;
    skos:prefLabel "legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/4805> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5524> ;
    skos:definition "A science based on living organisms collectively."@en ;
    skos:prefLabel "life science"@en .

<http://www.eionet.europa.eu/gemet/concept/5510> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5086> ;
    skos:prefLabel "natural material"@en .

<http://www.eionet.europa.eu/gemet/concept/5658> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5624> ;
    skos:prefLabel "noise type"@en .

<http://www.eionet.europa.eu/gemet/concept/6230> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The sciences concerned with nonliving matter, energy, and the physical properties of the universe, such as physics, chemistry, astronomy, and geology."@en ;
    skos:prefLabel "physical science"@en .

<http://www.eionet.europa.eu/gemet/concept/6291> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "A procedure or course of action taken to design, organize or prepare for the future."@en ;
    skos:prefLabel "planning measure"@en .

<http://www.eionet.europa.eu/gemet/concept/7127> a skos:Concept ;
    skos:definition "Scientific investigation aimed at discovering and applying new facts, techniques and natural laws."@en ;
    skos:prefLabel "research"@en .

<http://www.eionet.europa.eu/gemet/concept/7362> a skos:Concept ;
    skos:definition "The state of being secure from harm, injury, danger or risk, often as a result of planned measures or preparations."@en ;
    skos:prefLabel "safety"@en .

<http://www.eionet.europa.eu/gemet/concept/8047> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11433> ;
    skos:definition """1) Something considered by an authority or by general consent as a basis of comparison.
2) An object regarded as the most common size or form of its kind.
3) A rule or principle that is used as a basis for judgment.
4) An average or normal quality, quantity, or level."""@en ;
    skos:prefLabel "standard"@en .

<http://www.eionet.europa.eu/gemet/concept/8229> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9232> ;
    skos:definition "All waters on the surface of the Earth found in streams, rivers, ponds, lakes, marshes or wetlands, and as ice and snow."@en ;
    skos:prefLabel "surface water"@en .

<http://www.eionet.europa.eu/gemet/concept/8405> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3050> ;
    skos:definition "To carry out an examination on (a substance, material, or system) by applying some chemical or physical procedure designed to indicate the presence of a substance or the possession of a property."@en ;
    skos:prefLabel "test"@en .

<http://www.eionet.europa.eu/gemet/concept/8841> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4062> ;
    skos:definition "A collection of dwellings located in an urban area."@en ;
    skos:prefLabel "urban settlement"@en .

<http://www.eionet.europa.eu/gemet/concept/8879> a skos:Concept ;
    skos:prefLabel "resource utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/9195> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "Measures taken to ensure an adequate supply of water and a responsible utilization of water resources."@en ;
    skos:prefLabel "water management"@en .

<http://www.eionet.europa.eu/gemet/concept/9242> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5510> ;
    skos:definition "Common liquid (H2O) which forms rain, rivers, the sea, etc., and which makes up a large part of the bodies of organisms."@en ;
    skos:prefLabel "water (substance)"@en .

<http://www.eionet.europa.eu/gemet/concept/9297> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "Areas that are inundated by surface or ground water with frequency sufficient to support a prevalence of vegetative or aquatic life that requires saturated or seasonally saturated soil conditions for growth or reproduction."@en ;
    skos:prefLabel "wetland"@en .

<http://www.eionet.europa.eu/gemet/concept/994> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/429> ;
    skos:definition "The application of genetic principles to the improvement of farm animals and cultivated plants."@en ;
    skos:prefLabel "breeding"@en .

<http://www.eionet.europa.eu/gemet/concept/1029> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1063> ;
    skos:definition "Something built with a roof and walls, such as a house or factory."@en ;
    skos:prefLabel "building"@en .

<http://www.eionet.europa.eu/gemet/concept/1042> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5086> ;
    skos:definition "Any material used in construction, such as steel, concrete, brick, masonry, glass, wood, etc."@en ;
    skos:prefLabel "building material"@en .

<http://www.eionet.europa.eu/gemet/concept/10851> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Buildings, equipment and services provided for a community."@en ;
    skos:prefLabel "community facility"@en .

<http://www.eionet.europa.eu/gemet/concept/11433> a skos:Concept ;
    skos:definition "A government or management prescribed rule that provides detailed or stringent requirements, either directly or by referring to or incorporating the content of a standard, technical specification or code of practice."@en ;
    skos:prefLabel "technical regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/13289> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:prefLabel "administrative organisation"@en .

<http://www.eionet.europa.eu/gemet/concept/1348> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The scientific study of the properties, composition, and structure of matter, the changes in structure and composition of matter, and accompanying energy changes."@en ;
    skos:prefLabel "chemistry"@en .

<http://www.eionet.europa.eu/gemet/concept/1462> a skos:Concept ;
    skos:definition "The average weather condition in a region of the world. Many aspects of the Earth's geography affect the climate. Equatorial, or low, latitudes are hotter than the polar latitudes because of the angle at which the rays of sunlight arrive at the Earth's surface. The difference in temperature at the equator and at the poles has an influence on the global circulation of huge masses of air. Cool air at the poles sinks and spreads along the surface of the Earth towards the equator. Cool air forces its way under the lower density warmer air in the lower regions, pushing the lighter air up and toward the poles, where it will cool and descend."@en ;
    skos:prefLabel "climate"@en .

<http://www.eionet.europa.eu/gemet/concept/1824> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3194> ;
    skos:definition "In economics, the value of the factors of production used by a firm in producing or distributing goods and services or engaging in both activities."@en ;
    skos:prefLabel "cost"@en .

<http://www.eionet.europa.eu/gemet/concept/2478> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2516> ;
    skos:definition "The quantitative and qualitative identification, study, and evaluation of the nature of an economy or a system of organization or operation."@en ;
    skos:prefLabel "economic analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/2519> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8262> ;
    skos:definition "A community of organisms and their physical environment interacting as an ecological unit."@en ;
    skos:prefLabel "ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/2643> a skos:Concept ;
    skos:definition "A substance made up of atoms with the same atomic number; common examples are hydrogen, gold, and iron."@en ;
    skos:prefLabel "chemical element"@en .

<http://www.eionet.europa.eu/gemet/concept/2884> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5650> ;
    skos:definition "The sound and the characteristics of sounds from all sources in the surrounding environment."@en ;
    skos:prefLabel "environmental noise"@en .

<http://www.eionet.europa.eu/gemet/concept/2892> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15097> ;
    skos:definition "Official statements of principles, intentions, values, and objective which are based on legislation and the governing authority of a state and which serve as a guide for the operations of governmental and private activities in environmental affairs."@en ;
    skos:prefLabel "environmental policy"@en .

<http://www.eionet.europa.eu/gemet/concept/3232> a skos:Concept ;
    skos:definition "A commercial partnership of two or more persons, especially when incorporated."@en ;
    skos:prefLabel "firm"@en .

<http://www.eionet.europa.eu/gemet/concept/3237> a skos:Concept ;
    skos:definition "The industry of catching, processing and selling fish."@en ;
    skos:prefLabel "fishery"@en .

<http://www.eionet.europa.eu/gemet/concept/3646> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The study of the natural features of the earth's surface, comprising topography, climate, soil, vegetation, etc. and man's response to them."@en ;
    skos:prefLabel "geography"@en .

<http://www.eionet.europa.eu/gemet/concept/4255> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6370> ;
    skos:definition "Course of action adopted by national government to support and promote industrial activities."@en ;
    skos:prefLabel "industrial policy"@en .

<http://www.eionet.europa.eu/gemet/concept/4438> a skos:Concept ;
    skos:definition "The political or diplomatic interaction or dealings between independent nations."@en ;
    skos:prefLabel "international relations"@en .

<http://www.eionet.europa.eu/gemet/concept/4574> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5203> ;
    skos:prefLabel "laboratory technique"@en .

<http://www.eionet.europa.eu/gemet/concept/4621> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5667> ;
    skos:definition "The oldest method of waste disposal for the solid matter discarded in the domestic dustbin, along with the packaging material and paper from high street shops and offices. Landfill sites are usually disused quarries and gravel pits. When they were filled, previous practice was to cover them up with soil and forget about them. Housing estates have been built, often with disastrous consequences, on old landfill dumps. Waste burial has now become a serious technology and a potential source of energy. Landfill sites can be designed to be bioreactors, which deliberately produce methane, gas as a source of biofuel or alternative energy. Traditionally, waste tips remained exposed to air and aerobic microbes - those which thrive in air - in order to turn some of the waste into compost. However, open tips also encourage vermin, smell in hot weather and disfigure the landscape. In the 1960s, as a tidier and safer option, landfill operators began to seal each day's waste in a clay cell. While excluding vermin, the clay also excluded air. Decomposition relied on anaerobic microbes, which die in air. However, the process produced methane (natural gas), which was a safety hazard. The methane is now extracted by sinking a network of perforated pipes into the site."@en ;
    skos:prefLabel "landfill"@en .

<http://www.eionet.europa.eu/gemet/concept/4982> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8946> ;
    skos:definition "Any animal of the Mammalia, a large class of warm-blooded vertebrates having mammary glands in the female, a thoracic diaphragm, and a four-chambered heart. The class includes the whales, carnivores, rodents, bats, primates, etc."@en ;
    skos:prefLabel "mammal"@en .

<http://www.eionet.europa.eu/gemet/concept/7233> a skos:Concept ;
    skos:definition "The expected number of lives lost, persons injured, damage to property and disruption of economic activity due to a particular natural phenomenon, and consequently the product of the probability of occurrence and the expected magnitude of damage."@en ;
    skos:prefLabel "risk"@en .

<http://www.eionet.europa.eu/gemet/concept/7843> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6094> ;
    skos:definition "The top layer of the land surface of the earth that is composed of disintegrated rock particles, humus, water and air."@en ;
    skos:prefLabel "soil"@en .

<http://www.eionet.europa.eu/gemet/concept/7881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6094> ;
    skos:definition "The major processes in soils are gains, losses, transfers, and transformations of organic matter, soluble salts, carbonates, silicate clay minerals, sesquioxides, and silica. Gains consist normally of additions of organic matter, and of oxygen and water through oxidation and hydration, but in some sites slow continuous additions of new mineral materials take place at the surface or soluble materials are deposited from groundwater. Losses are chiefly of materials dissolved or suspended in water percolating through the profile or running off the surface."@en ;
    skos:prefLabel "soil process"@en .

<http://www.eionet.europa.eu/gemet/concept/813> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Chemical substances that occur in animals, microorganisms, and plants."@en ;
    skos:prefLabel "biochemical substance"@en .

<http://www.eionet.europa.eu/gemet/concept/8412> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8405> ;
    skos:prefLabel "testing method"@en .

<http://www.eionet.europa.eu/gemet/concept/8525> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "All the services connected with tourism, especially when regarded as an industry."@en ;
    skos:prefLabel "tourist facility"@en .

<http://www.eionet.europa.eu/gemet/concept/8926> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5116> ;
    skos:definition "Any conveyance in or by which people or objects are transported."@en ;
    skos:prefLabel "vehicle"@en .

<http://www.eionet.europa.eu/gemet/concept/12606> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Processes that separate components of a waste stream or change the physical form of the waste without altering the chemical structure of the constituent materials. Physical treatment techniques are often used to separate the materials within the waste stream so that they can be reused or detoxified by chemical or biological treatment or destroyed by high-temperature incineration."@en ;
    skos:prefLabel "physical treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/14924> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5354> ;
    skos:definition "The transformation to digital form of data collected by remote sensing, traditional field and documentary methods and of existing historical data such as paper maps, charts, and publications."@en ;
    skos:prefLabel "GIS digital technique"@en .

<http://www.eionet.europa.eu/gemet/concept/1745> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7811> ;
    skos:definition "The combination of qualities, quantities, acts and tendencies characterizing a community or human group's use of resources for survival, comfort and enjoyment."@en ;
    skos:prefLabel "consumption pattern"@en .

<http://www.eionet.europa.eu/gemet/concept/2606> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6561> ;
    skos:definition "A stationary plant containing apparatus for large-scale conversion of some form of energy (such as hydraulic, steam, chemical, or nuclear energy) into electrical energy."@en ;
    skos:prefLabel "electric power plant"@en .

<http://www.eionet.europa.eu/gemet/concept/2749> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2712> ;
    skos:prefLabel "energy utilisation"@en .

<http://www.eionet.europa.eu/gemet/concept/3313> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/411> ;
    skos:definition "Plants capable of producing conspicuous flowers."@en ;
    skos:prefLabel "flowering plant"@en .

<http://www.eionet.europa.eu/gemet/concept/450> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Any living organism characterized by voluntary movement, the possession of cells with noncellulose cell walls and specialized sense organs enabling rapid response to stimuli, and the ingestion of complex organic substances such as plants and other animals."@en ;
    skos:prefLabel "animal"@en .

<http://www.eionet.europa.eu/gemet/concept/4767> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7001> ;
    skos:definition "Sports and recreational activities carried out in the time free from work or other duties."@en ;
    skos:prefLabel "leisure activity"@en .

<http://www.eionet.europa.eu/gemet/concept/4985> a skos:Concept ;
    skos:definition "Government, control, superintendence, physical or manual handling or guidance; act of managing by direction or regulation, or administration, as management of family, or of household, etc."@en ;
    skos:prefLabel "management"@en .

<http://www.eionet.europa.eu/gemet/concept/5203> a skos:Concept ;
    skos:definition "The system of methods and principles used in a particular discipline."@en ;
    skos:prefLabel "methodology"@en .

<http://www.eionet.europa.eu/gemet/concept/6124> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/111> ;
    skos:definition "The license, formal consent or authorization to act on some matter, frequently validating the action as lawful or procedurally correct."@en ;
    skos:prefLabel "permission"@en .

<http://www.eionet.europa.eu/gemet/concept/6445> a skos:Concept ;
    skos:definition "The indirect or direct alteration of the biological, thermal, physical, or radioactive properties of any medium in such a way as to create a hazard or potential hazard to human health or to the health, safety or welfare of any living species."@en ;
    skos:prefLabel "pollution"@en .

<http://www.eionet.europa.eu/gemet/concept/664> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2470> ;
    skos:definition "That part of ecology which deals with individual species and their reactions to environmental factors."@en ;
    skos:prefLabel "autoecology"@en .

<http://www.eionet.europa.eu/gemet/concept/7796> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7791> ;
    skos:definition "A collection of people who interact with one another and share a certain feeling of unity."@en ;
    skos:prefLabel "social group"@en .

<http://www.eionet.europa.eu/gemet/concept/7823> a skos:Concept ;
    skos:definition "Human group of people, more or less large and complex, associated for some common interest and characterized by distinctive hierarchical relationships."@en ;
    skos:prefLabel "society"@en .

<http://www.eionet.europa.eu/gemet/concept/8641> a skos:Concept ;
    skos:definition "The act or means of moving tangible objects (persons or goods) from place to place. Often involves the use of some type of vehicle."@en ;
    skos:prefLabel "transportation"@en .

<http://www.eionet.europa.eu/gemet/concept/883> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2457> ;
    skos:definition "Biomass refers strictly speaking to the total weight of all the living things in an ecosystem. However, it has come to refer to the amount of plant and crop material that could be produced in an ecosystem for making biofuels and other raw materials used in industry, for example."@en ;
    skos:prefLabel "biomass"@en .

<http://www.eionet.europa.eu/gemet/concept/9092> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2877> ;
    skos:definition "The total supervision of waste production, handling, processing, storage, and transport from its point of generation to its final acceptable disposal."@en ;
    skos:prefLabel "waste management"@en .

<http://www.eionet.europa.eu/gemet/concept/9121> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5956> ;
    skos:definition "Any process or combination of processes that changes the chemical, physical or biological composition or character of any waste or reduces or removes its harmful properties or characteristics for any purpose."@en ;
    skos:prefLabel "waste treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/9143> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15327>,
        <http://www.eionet.europa.eu/gemet/concept/9121> ;
    skos:definition "Any process to which wastewater is subjected which would remove, or otherwise render harmless to human health and the environment, its constituent wastes."@en ;
    skos:prefLabel "waste water treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/11148> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7127> ;
    skos:definition "Systematic investigation to establish facts or principles concerning a specific scientific subject."@en ;
    skos:prefLabel "scientific research"@en .

<http://www.eionet.europa.eu/gemet/concept/13292> a skos:Concept ;
    skos:definition "An organization's complex system of mutually connected and dependent elements or parts, which make up a definite manner of arrangement."@en ;
    skos:prefLabel "institutional structure"@en .

<http://www.eionet.europa.eu/gemet/concept/2233> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3869> ;
    skos:prefLabel "disease cause"@en .

<http://www.eionet.europa.eu/gemet/concept/2422> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2212> ;
    skos:definition "A type of legislation issued by the European Union which is binding on Member States in terms of the results to be achieved but which leaves to Member States the choice of methods."@en ;
    skos:prefLabel "EC directive"@en .

<http://www.eionet.europa.eu/gemet/concept/2803> a skos:Concept ;
    skos:definition "Information concerning the state or condition of the environment."@en ;
    skos:prefLabel "environmental data"@en .

<http://www.eionet.europa.eu/gemet/concept/2862> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "Branch of law relating to pollution control; national parks, wildlife, fauna and flora, wilderness and biodiversity; environmental and occupational health; environmental planning; heritage conservation and a large number of international conventions relating to the environment."@en ;
    skos:prefLabel "environmental legislation"@en .

<http://www.eionet.europa.eu/gemet/concept/2932> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8339> ;
    skos:prefLabel "environmental technology"@en .

<http://www.eionet.europa.eu/gemet/concept/3006> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4434> ;
    skos:definition "."@en ;
    skos:prefLabel "European Union"@en .

<http://www.eionet.europa.eu/gemet/concept/3757> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2810> ;
    skos:definition "An amount of money demanded by a government to finance clean-up, prevention, reduction, enforcement or educational efforts intended to promote ecological integrity and the conservation of natural resources."@en ;
    skos:prefLabel "environmental tax"@en .

<http://www.eionet.europa.eu/gemet/concept/4116> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4124> ;
    skos:definition "The movement of water between the oceans, ground surface and atmosphere by evaporation, precipitation and the activity of living organisms, as one of the mayor biogeochemical cycles. Each day water evaporates from the oceans and is carried in the air from the sea over the land, which receives it as precipitation, and finally returns from the land to the sea through rivers, thus completing the cycle."@en ;
    skos:prefLabel "hydrologic cycle"@en .

<http://www.eionet.europa.eu/gemet/concept/4358> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/571> ;
    skos:definition "A class of the Arthropoda typically having a segmented body with an external, chitinous covering, a pair of compound eyes, a pair of antennae, three pairs of mouthparts, and two pairs of wings."@en ;
    skos:prefLabel "insect"@en .

<http://www.eionet.europa.eu/gemet/concept/5305> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:prefLabel "miscellaneous product"@en .

<http://www.eionet.europa.eu/gemet/concept/6817> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7621> ;
    skos:definition "An enterprise concerned with the provision to the public of essentials, such as electricity or water."@en ;
    skos:prefLabel "public service"@en .

<http://www.eionet.europa.eu/gemet/concept/8262> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2470> ;
    skos:definition "Study of the ecology of organisms, populations, communities or systems."@en ;
    skos:prefLabel "synecology"@en .

<http://www.eionet.europa.eu/gemet/concept/8339> a skos:Concept ;
    skos:definition "Systematic knowledge of and its application to industrial processes; closely related to engineering and science."@en ;
    skos:prefLabel "technology"@en .

<http://www.eionet.europa.eu/gemet/concept/9062> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5956> ;
    skos:definition "The orderly process of discarding unwanted or useless material."@en ;
    skos:prefLabel "waste disposal"@en .

<http://www.eionet.europa.eu/gemet/concept/10084> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "A subdivision of the body of principles and regulations established by a government or other authority, generally defined by its scope or application."@en ;
    skos:prefLabel "law branch"@en .

<http://www.eionet.europa.eu/gemet/concept/10833> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:definition "Activity carried out for the benefit of the community."@en ;
    skos:prefLabel "public function"@en .

<http://www.eionet.europa.eu/gemet/concept/12605> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4257> ;
    skos:definition "Any processing of wastewater, toxic substances or other materials involving a combination of physical and chemical methods, such as physical processes including air-stripping or filtration and chemical processes including coagulation, chlorination or ozonation."@en ;
    skos:prefLabel "physicochemical treatment"@en .

<http://www.eionet.europa.eu/gemet/concept/14837> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/3087> ;
    skos:definition "The act, process or industry of extracting coal, ores, etc. from the earth."@en ;
    skos:prefLabel "mining"@en .

<http://www.eionet.europa.eu/gemet/concept/2790> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2900> ;
    skos:definition "Efforts and activities to maintain and sustain those attributes in natural and urban environments which are essential both to human physical and mental health and to enjoyment of life."@en ;
    skos:prefLabel "environmental conservation"@en .

<http://www.eionet.europa.eu/gemet/concept/406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "The science concerned with the physical structure of animals and plants."@en ;
    skos:prefLabel "anatomy"@en .

<http://www.eionet.europa.eu/gemet/concept/5354> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5346> ;
    skos:definition "Techniques employed in the process of checking, observing and measuring events, processes or physical, chemical, biological and environmental phenomena."@en ;
    skos:prefLabel "monitoring technique"@en .

<http://www.eionet.europa.eu/gemet/concept/6884> a skos:Concept ;
    skos:definition "Emission of any rays from either natural or man-made origins, such as radio waves, the sun's rays, medical X-rays and the fall-out and nuclear wastes produced by nuclear weapons and nuclear energy production. Radiation is usually divided between non-ionizing radiation, such as thermal radiation (heat) and light, and nuclear radiation. Non-ionizing radiation includes ultraviolet radiation from the sun which, although it can damage cells and tissues, does not involve the ionization events of nuclear radiation."@en ;
    skos:prefLabel "radiation"@en .

<http://www.eionet.europa.eu/gemet/concept/8582> a skos:Concept ;
    skos:definition """1) The movement of vehicles, ships, aircraft, persons, etc., in an area or over a route.
2) The vehicles, persons, etc., moving in an area or over a route."""@en ;
    skos:prefLabel "traffic"@en .

<http://www.eionet.europa.eu/gemet/concept/11170> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/210> ;
    skos:definition "The business, art, or skill of agriculture."@en ;
    skos:prefLabel "farming technique"@en .

<http://www.eionet.europa.eu/gemet/concept/12586> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/496>,
        <http://www.eionet.europa.eu/gemet/concept/5093> ;
    skos:definition "The science by which the properties of matter and the sources of power in nature are made useful to humans in structures, machines, and products."@en ;
    skos:prefLabel "engineering"@en .

<http://www.eionet.europa.eu/gemet/concept/13307> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2547> ;
    skos:definition "A position along a scale of increasingly advanced training marking the degree or grade of instruction either obtained by an individual, offered by a some entity or necessary for a particular job or task."@en ;
    skos:prefLabel "level of education"@en .

<http://www.eionet.europa.eu/gemet/concept/263> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6395> ;
    skos:definition "Any pollutant agent or combination of such agents, including any physical, chemical, biological, radioactive substance or matter which is emitted into or otherwise enters the ambient air and can, in high enough concentrations, harm humans, animals, vegetation or material."@en ;
    skos:prefLabel "air pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/2829> a skos:Concept ;
    skos:definition "Any alteration of environmental conditions or creation of a new set of environmental conditions, adverse or beneficial, caused or induced by the action or set of actions under consideration."@en ;
    skos:prefLabel "environmental impact"@en .

<http://www.eionet.europa.eu/gemet/concept/4629> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "Any physical, recognizable form or feature of the Earth's surface, having a characteristic shape and produced by natural causes; it includes major forms such as plane, plateau and mountain, and minor forms such as hill, valley, slope, esker, and dune. Taken together the landforms make up the surface configuration of the Earth's."@en ;
    skos:prefLabel "landform"@en .

<http://www.eionet.europa.eu/gemet/concept/5346> a skos:Concept ;
    skos:definition "To check regularly in order to perceive change in some quality or quantity."@en ;
    skos:prefLabel "monitoring"@en .

<http://www.eionet.europa.eu/gemet/concept/5912> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Chemical compounds, based on carbon chains or rings and also containing hydrogen with or without oxygen, nitrogen, or other elements."@en ;
    skos:prefLabel "organic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/5914> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "An individual constituted to carry out all life functions."@en ;
    skos:prefLabel "organism"@en .

<http://www.eionet.europa.eu/gemet/concept/8563> a skos:Concept ;
    skos:definition "The act or process of buying, selling or exchanging goods and services at either wholesale or retail, within a country or between countries."@en ;
    skos:prefLabel "trade (services)"@en .

<http://www.eionet.europa.eu/gemet/concept/8629> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/15311>,
        <http://www.eionet.europa.eu/gemet/concept/2643> ;
    skos:definition "One of a group of metallic elements in which the members have the filling of the outermost shell to 8 electrons interrupted to bring the penultimate shell from 8 to 18 or 32 electrons; includes elements 21 through 29 (scandium through copper), 39 through 47 (yttrium through silver), 57 through 79 (lanthanum through gold), and all known elements from 89 (actinium) on."@en ;
    skos:prefLabel "transition element"@en .

<http://www.eionet.europa.eu/gemet/concept/881> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "A division of the natural sciences concerned with the study of life and living organisms."@en ;
    skos:prefLabel "biology"@en .

<http://www.eionet.europa.eu/gemet/concept/1322> a skos:Concept ;
    skos:definition "Properties of a substance depending on the arrangement of the atoms in the molecule, e.g. bio-availability, degradability, persistence, etc."@en ;
    skos:prefLabel "chemical property"@en .

<http://www.eionet.europa.eu/gemet/concept/3406> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/8386> ;
    skos:definition "A vegetation community dominated by trees and other woody shrubs, growing close enough together that the tree tops touch or overlap, creating various degrees of shade on the forest floor. It may produce benefits such as timber, recreation, wildlife habitat, etc."@en ;
    skos:prefLabel "forest"@en .

<http://www.eionet.europa.eu/gemet/concept/4321> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1063> ;
    skos:definition "The basic network or foundation of capital facilities or community investments which are necessary to support economic and community activities."@en ;
    skos:prefLabel "infrastructure"@en .

<http://www.eionet.europa.eu/gemet/concept/4599> a skos:Concept ;
    skos:definition "A specified geographical tract of the Earth's surface including all its attributes, comprising its geology, superficial deposits, topography, hydrology, soils, flora and fauna, together with the results of past and present human activity, to the extent that these attributes exert a significant influence on the present and future land utilization."@en ;
    skos:prefLabel "land"@en .

<http://www.eionet.europa.eu/gemet/concept/4666> a skos:Concept ;
    skos:definition "The formulation of regional objectives, plans and programmes and the harmonization of the regional effects of sectorial planning."@en ;
    skos:prefLabel "land setup"@en .

<http://www.eionet.europa.eu/gemet/concept/6279> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2889> ;
    skos:definition "A scheme of action, a method of proceeding thought out in advance."@en ;
    skos:prefLabel "plan"@en .

<http://www.eionet.europa.eu/gemet/concept/6323> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5914> ;
    skos:definition "Any living organism that typically synthesizes its food from inorganic substances, possesses cellulose cell walls, responds slowly and often permanently to a stimulus, lacks specialized sense organs and nervous system, and has no powers of locomotion."@en ;
    skos:prefLabel "plant (biology)"@en .

<http://www.eionet.europa.eu/gemet/concept/6373> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4985> ;
    skos:definition "The method or mechanism used by government, political parties, business or individuals to achieve a desired effect, through legal or economic means."@en ;
    skos:prefLabel "policy instrument"@en .

<http://www.eionet.europa.eu/gemet/concept/7236> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "The qualitative and quantitative evaluation performed in an effort to define the risk posed to human health and/or the environment by an action or by the presence or use of a specific substance or pollutant."@en ;
    skos:prefLabel "risk assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/9127> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9051> ;
    skos:definition "Used water, or water that is not needed, which is permitted to escape, or unavoidably escapes from canals, ditches, reservoirs or other bodies of water, for which the owners of these structures are legally responsible."@en ;
    skos:prefLabel "waste water"@en .

<http://www.eionet.europa.eu/gemet/concept/9380> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "The Earth with all its inhabitants and all things upon it."@en ;
    skos:prefLabel "world"@en .

<http://www.eionet.europa.eu/gemet/concept/10129> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4805> ;
    skos:definition "The study of the interrelationship among living organisms and between organisms and their environment, utilizing the methods or theories of science."@en ;
    skos:prefLabel "scientific ecology"@en .

<http://www.eionet.europa.eu/gemet/concept/2562> a skos:Concept ;
    skos:definition "Effects include: a) direct effects, which are caused by the action and occur at the same time and place, b) indirect effects, which are caused by the action and are later in time or farther removed in distance, that are still reasonably foreseeable."@en ;
    skos:prefLabel "effect"@en .

<http://www.eionet.europa.eu/gemet/concept/5135> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7472> ;
    skos:definition "The science and art of treating and healing."@en ;
    skos:prefLabel "medical science"@en .

<http://www.eionet.europa.eu/gemet/concept/7472> a skos:Concept ;
    skos:definition "The study of the physical universe and its contents by means of reproducible observations, measurements, and experiments to establish, verify, or modify general laws to explain its nature and behaviour."@en ;
    skos:prefLabel "science"@en .

<http://www.eionet.europa.eu/gemet/concept/8590> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "The fundamental facilities and systems used for the movement of vehicles, often provided through public funding."@en ;
    skos:prefLabel "traffic infrastructure"@en .

<http://www.eionet.europa.eu/gemet/concept/867> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/892> ;
    skos:definition "Processes concerning living organisms."@en ;
    skos:prefLabel "biological process"@en .

<http://www.eionet.europa.eu/gemet/concept/11514> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/11499> ;
    skos:definition "The act of regulating; a rule or order prescribed for management or government; a regulating principle; a precept. Rule of order prescribed by superior or competent authority relating to action on those under its control."@en ;
    skos:prefLabel "regulation"@en .

<http://www.eionet.europa.eu/gemet/concept/1324> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1320> ;
    skos:definition "A change in which a substance is transformed into one or more new substances."@en ;
    skos:prefLabel "chemical reaction"@en .

<http://www.eionet.europa.eu/gemet/concept/1911> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4321> ;
    skos:definition "Any building or structure used for programs or activities involving the arts or other endeavors that encourage refinement or development of the mind."@en ;
    skos:prefLabel "cultural facility"@en .

<http://www.eionet.europa.eu/gemet/concept/2774> a skos:Concept ;
    skos:definition "The evaluation or appraisal of ecological or natural resources."@en ;
    skos:prefLabel "environmental assessment"@en .

<http://www.eionet.europa.eu/gemet/concept/2810> a skos:Concept ;
    skos:definition "A matter of public importance involving both a community's or a country's management of financial resources and its protection of natural resources."@en ;
    skos:prefLabel "environmental economy issue"@en .

<http://www.eionet.europa.eu/gemet/concept/3388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:definition "A substance that can be used or prepared for use as food."@en ;
    skos:prefLabel "foodstuff"@en .

<http://www.eionet.europa.eu/gemet/concept/4234> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2956> ;
    skos:definition "Equipment related to industrial activities."@en ;
    skos:prefLabel "industrial equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/5196> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1462> ;
    skos:definition "Phenomena which occur in the troposphere and stratosphere, such as precipitations, wind, temperature, etc."@en ;
    skos:prefLabel "meteorological phenomenon"@en .

<http://www.eionet.europa.eu/gemet/concept/6724> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5086> ;
    skos:definition "The physical and chemical characteristics of the substances or parts of  which a thing or object is made."@en ;
    skos:prefLabel "properties of materials"@en .

<http://www.eionet.europa.eu/gemet/concept/7781> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7823> ;
    skos:definition "A person or community's general treatment, manner of conduct or action toward others as individuals or as members of variously identified groups."@en ;
    skos:prefLabel "social behaviour"@en .

<http://www.eionet.europa.eu/gemet/concept/78> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13187> ;
    skos:definition "Stepping in or participating in problem solving efforts for troublesome or perplexing situations involving ground areas or the earth's surface."@en ;
    skos:prefLabel "intervention on land"@en .

<http://www.eionet.europa.eu/gemet/concept/8388> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2525> ;
    skos:definition "Any terrestrial environment, from small to large, in which plants and animals interact with the chemical and physical features of the environment."@en ;
    skos:prefLabel "terrestrial ecosystem"@en .

<http://www.eionet.europa.eu/gemet/concept/397> a skos:Concept ;
    skos:definition "Examination or determination."@en ;
    skos:prefLabel "analysis"@en .

<http://www.eionet.europa.eu/gemet/concept/4350> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/1327> ;
    skos:definition "Chemical compounds that do not contain carbon as the principal element (excepting carbonates, cyanides, and cyanates), that is, matter other than plant or animal."@en ;
    skos:prefLabel "inorganic substance"@en .

<http://www.eionet.europa.eu/gemet/concept/6395> a skos:Concept ;
    skos:definition "Any substance, usually a residue of human activity, which has an undesirable effect upon the environment."@en ;
    skos:prefLabel "pollutant"@en .

<http://www.eionet.europa.eu/gemet/concept/6740> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4599> ;
    skos:definition "Portions of land protected by special restrictions and laws for the conservation of the natural environment. They include large tracts of land set aside for the protection of wildlife and its habitat; areas of great natural beauty or unique interest; areas containing rare forms of plant and animal life; areas representing unusual geologic formation; places of historic and prehistoric interest; areas containing ecosystems of special importance for scientific investigation and study; and areas which safeguard the needs of the biosphere."@en ;
    skos:prefLabel "protected area"@en .

<http://www.eionet.europa.eu/gemet/concept/8386> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/5494> ;
    skos:definition "Subdivisions of the continental surfaces distinguished from one another on the basis of the form, roughness, and surface composition of the land."@en ;
    skos:prefLabel "terrestrial area"@en .

<http://www.eionet.europa.eu/gemet/concept/2286> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2282> ;
    skos:definition "Any one of a number of diverse classes of written, printed or digitized items furnishing information or evidence, and distinguished by content, form or function."@en ;
    skos:prefLabel "document type"@en .

<http://www.eionet.europa.eu/gemet/concept/4254> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/4267> ;
    skos:definition "Buildings where the operations related to industrial productive processes are carried out."@en ;
    skos:prefLabel "industrial plant (building)"@en .

<http://www.eionet.europa.eu/gemet/concept/4303> a skos:Concept ;
    skos:definition "All facts, ideas or imaginative works of the mind which have been communicated, published or distributed formally or informally in any format, or the knowledge that is  communicated or received."@en ;
    skos:prefLabel "information"@en .

<http://www.eionet.europa.eu/gemet/concept/10048> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:prefLabel "pollution type"@en .

<http://www.eionet.europa.eu/gemet/concept/3505> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:definition "Solid, liquid, or gaseous material such as gas, gasoline, oil, coal or wood, used to produce heat or power by burning."@en ;
    skos:prefLabel "fuel"@en .

<http://www.eionet.europa.eu/gemet/concept/7364> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/7362> ;
    skos:definition "An action, procedure or contrivance designed to lower the occurrence or risk of injury, loss and danger to persons, property or the environment."@en ;
    skos:prefLabel "safety measure"@en .

<http://www.eionet.europa.eu/gemet/concept/7621> a skos:Concept ;
    skos:definition "The carrying out of work for which there is a constant public demand by the provision of labor and the utilization of tools."@en ;
    skos:prefLabel "services"@en .

<http://www.eionet.europa.eu/gemet/concept/210> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/232> ;
    skos:definition "Practices and techniques employed in agriculture to improve yields and productivity. Over the last few decades they have undergone big changes: tilling, sowing and harvesting have become increasingly mechanised, and the methods of applying fertilisers and pesticides have become more sophisticated. Many changes within the agricultural system can be summed up by \"intensification\". The result and aim of intensification has been to achieve increases in production, yields and labour productivity in agriculture."@en ;
    skos:prefLabel "agricultural method"@en .

<http://www.eionet.europa.eu/gemet/concept/2877> a skos:Concept ;
    skos:definition "Measures and controls which are directed at environmental conservation, the rational and sustainable allocation and utilization of natural resources, the optimization of interrelations between society and the environment, and the improvement of human welfare for present and future generations."@en ;
    skos:prefLabel "environmental management"@en .

<http://www.eionet.europa.eu/gemet/concept/3194> a skos:Concept ;
    skos:definition "The monetary resources or revenue of a government, company, organization or individual."@en ;
    skos:prefLabel "finances"@en .

<http://www.eionet.europa.eu/gemet/concept/6233> a skos:Concept ;
    skos:definition "Processes involving changes in the physical properties and chemical structure of substances."@en ;
    skos:prefLabel "physicochemical process"@en .

<http://www.eionet.europa.eu/gemet/concept/2663> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/625>,
        <http://www.eionet.europa.eu/gemet/concept/6445> ;
    skos:definition "The release of greenhouse gases or air pollutants and/or their precursors into the atmosphere over a specified area and period of time"@en ;
    skos:prefLabel "emission"@en .

<http://www.eionet.europa.eu/gemet/concept/4046> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2232> ;
    skos:definition "An interruption, cessation or disorder of human bodily functions, systems or organs resulting from genetic or developmental errors, infection, nutritional deficiency, toxicity, illness or unfavorable environmental factors."@en ;
    skos:prefLabel "human disease"@en .

<http://www.eionet.europa.eu/gemet/concept/10085> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/13146> ;
    skos:definition "Entire network of courts in a particular jurisdiction."@en ;
    skos:prefLabel "judicial system"@en .

<http://www.eionet.europa.eu/gemet/concept/1327> a skos:Concept ;
    skos:definition "Any substance used in or resulting from a reaction involving changes to atoms or molecules."@en ;
    skos:prefLabel "chemical"@en .

<http://www.eionet.europa.eu/gemet/concept/2457> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/2470> ;
    skos:definition "A variable, measurable property whose value is a determinant of the characteristics of an ecosystem."@en ;
    skos:prefLabel "ecological parameter"@en .

<http://www.eionet.europa.eu/gemet/concept/6370> a skos:Concept ;
    skos:prefLabel "policy"@en .

<http://www.eionet.europa.eu/gemet/concept/2956> a skos:Concept ;
    skos:definition "Any collection of materials, supplies or apparatuses stored, furnished or provided for an undertaking or activity."@en ;
    skos:prefLabel "equipment"@en .

<http://www.eionet.europa.eu/gemet/concept/111> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/95> ;
    skos:prefLabel "administrative procedure"@en .

<http://www.eionet.europa.eu/gemet/concept/6228> a skos:Concept ;
    skos:definition "A continuous action or series of changes which alters the material form of matter."@en ;
    skos:prefLabel "physical process"@en .

<http://www.eionet.europa.eu/gemet/concept/11813> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:definition "A substance characterized by definite molecular composition."@en ;
    skos:prefLabel "chemical product"@en .

<http://www.eionet.europa.eu/gemet/concept/4260> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/6660> ;
    skos:prefLabel "industrial product"@en .

<http://www.eionet.europa.eu/gemet/concept/6229> a skos:Concept ;
    skos:definition "Property of a compound that can change without involving a change in chemical composition."@en ;
    skos:prefLabel "physical property"@en .

<http://www.eionet.europa.eu/gemet/concept/2516> a skos:Concept ;
    skos:definition "The system of activities and administration through which a society uses its resources to produce wealth."@en ;
    skos:prefLabel "economy"@en .

<http://www.eionet.europa.eu/gemet/concept/11499> a skos:Concept ;
    skos:definition "A body of rules of action or conduct prescribed by controlling authority, and having binding legal force."@en ;
    skos:prefLabel "law (corpus of rules)"@en .

<http://www.eionet.europa.eu/gemet/concept/4279> a skos:Concept ;
    skos:definition "An industry is a group of establishments engaged in the same or similar kinds of economic activities. Industries produce commodities that are sold with the expectation of recovering the total cost of production. A single industry can produce many different commodities."@en ;
    skos:prefLabel "industry"@en .

<http://www.eionet.europa.eu/gemet/concept/6033> a skos:Concept ;
    skos:definition """1) A quantity in an equation which must be specified beside the independent variables to obtain the solution for the dependent variables. 
2) A quantity which is constant under a given set of conditions, but may be different under other conditions."""@en ;
    skos:prefLabel "parameter"@en .

<http://www.eionet.europa.eu/gemet/concept/9051> a skos:Concept ;
    skos:broader <http://www.eionet.europa.eu/gemet/concept/9041> ;
    skos:definition "A grouping by type of unusable material left over from any process."@en ;
    skos:prefLabel "type of waste"@en .

<http://www.eionet.europa.eu/gemet/concept/4257> a skos:Concept ;
    skos:prefLabel "industrial process"@en .

